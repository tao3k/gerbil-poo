;;; Optional owned publication study. Run through the existing Just test entry.
(import :std/test :std/iter :clan/poo/object :clan/poo/brace :clan/poo/mop
        :clan/poo/support/option
        (only-in :std/error Error-message)
        (only-in :clan/poo/component-closure component-group-builder)
        (only-in :clan/poo/feedback-graph publish-owned-feedback-graph graph-cache-partition)
        (only-in :clan/poo/benchmarks/closure-measure measure qualified-metrics)
        (prefix-in :clan/poo/generalized-graph graph.)
        (prefix-in :clan/poo/strong-components scc.)
        (prefix-in :clan/poo/dependency-analysis code.)
        (prefix-in :clan/poo/component-publication pub.)
        (prefix-in :clan/poo/component-revision revision.))
(export membership-preflight-test)
(extern namespace: #f random-source-pseudo-randomize!)

(def membership-preflight-test
  (test-suite "owned component membership preflight"
    (test-case "public submission with rejected and accepted member edits"
      (def size 10000)
      (def names (cons 'anchor (for/collect (i (in-range (- size 1)))
                  (string->symbol (string-append "member-" (number->string i))))))
      (def source (graph.declaration names [] [(cons 'anchor (some (code.make-success 0)))]))
      (def anchor-build (component-group-builder '(anchor) (lambda (_) (.lens)) 0 0 8))
      (def approvals 0)
      (def (build _members _source _resolve) (anchor-build '(anchor) source void))
      (def (accept _ __) (set! approvals (1+ approvals)) #t)
      (defvalues (graph failure) (publish-owned-feedback-graph source build accept))
      (check-equal? failure #f)
      (def refused-edits (list (revision.fragment [] '(unknown) [])))
      (def removal (car (cdr names)))
      (def accepted-edits (list (revision.fragment [] (list removal) [])))
      (def (submit edits)
        (def owner (pub.publication graph))
        (def before (pub.snapshot owner))
        (def request (pub.stage owner edits build accept))
        (defvalues (outcome clocks)
          (measure (lambda () (call-with-values (lambda () (pub.submit-snapshot! owner request)) cons)) 1))
        (def held (car outcome))
        (def error (cdr outcome))
        (values before held error clocks))
      (for (sample (in-range 16))
        (when (zero? sample) (random-source-pseudo-randomize! default-random-source 0 20261113))
        (defvalues (before held refused clocks) (submit refused-edits))
        (check-equal? (eq? before held) #t)
        (check-equal? (Error-message refused) "conflicting or stale component membership contributions")
        (when (zero? sample)
          (displayln (list 'MEMBER-RNG (random-integer 1000000000))))
        (displayln (list 'MEMBER-PREFLIGHT size 'refused sample (qualified-metrics clocks))))
      (check-equal? approvals 1)
      (for (sample (in-range 3))
        (defvalues (before held refused clocks) (submit accepted-edits))
        (check-equal? refused #f)
        (check-equal? (scc.partition-group-size (graph-cache-partition (pub.snapshot-graph held)) removal) #f)
        (check-equal? (scc.partition-group-size (graph-cache-partition (pub.snapshot-graph before)) removal) 1)
        (displayln (list 'MEMBER-PREFLIGHT size 'accepted sample (qualified-metrics clocks))))
      (check-equal? approvals 4))))
