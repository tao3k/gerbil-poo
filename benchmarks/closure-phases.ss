;;; Fixed cases and columns; no duplicated field dictionaries or JSON versions.
(export main)
(import :gerbil/runtime/gambit :std/iter :clan/poo/closure "closure-measure.ss" "closure-cases.ss"
        (only-in "closure-scale-benchmark.ss" workload))
(def phases '(compile-append compile-cold compile-auto prepare prepare-cached solve refresh construct))
(def (main output)
  (def rows [])
  (for (spec focus-cases)
    (match spec ([family size width]
      (def source (workload family size width #t))
      (def cold (compile-closure source 'cold))
      (def prepared (prepare-closure cold))
      (def opposite (compile-closure (workload family size width #f) 'cold))
      (def actions (vector (lambda () (compile-closure source 'append))
                           (lambda () (compile-closure source 'cold))
                           (lambda () (compile-closure source 'auto))
                           (lambda () (prepare-closure cold))
                           (lambda () (prepare-closure prepared))
                           (lambda () (solve-closure cold))
                           (lambda () (reconfigure-closure opposite source))
                           (lambda () (construct-closure source))))
      (for* ((gc '(natural collected)) (round (in-range 8)) (position (in-range (length phases))))
        (def index (modulo (+ round position) (length phases)))
        (def phase (list-ref phases index))
        (def repetitions (if (equal? family "dense") 32 256))
        (defvalues (result costs) (measure (vector-ref actions index) repetitions (eq? gc 'collected)))
        (def closed (if (memq phase '(solve construct)) result (solve-closure result)))
        (unless (andmap identity (closure->list closed)) (error "phase oracle" family phase))
        (set! rows (cons (vector family size gc round phase repetitions costs) rows))))))
  (write-datum output
    `(closure-phases
       (toolchain ,(gerbil-version-string) ,(system-version-string))
       (sources ,@(source-digests '("closure.ss" "benchmarks/closure-measure.ss" "benchmarks/closure-cases.ss" "benchmarks/closure-phases.ss" "benchmarks/closure-scale-benchmark.ss")))
       (columns family size gc round phase repetitions #(cpu wall gc-cpu collections bytes))
       (rows ,@(reverse rows))))
  (displayln "CLOSURE-PHASES-OK rows=" (length rows)))
