;;; Native matched controls: same full setup, different explicit memo lifetimes.
(export main workload)
(import :std/iter
        (only-in :std/values first-value)
        :clan/poo/object
        (only-in "closure-measure.ss" run-child)
        (prefix-in "recursive-cases.ss" study.)
        (runtime: :clan/poo/recursive)
        (prefix-in (only-in :clan/poo/recursive value-result) recursive.)
        (runtime: :clan/poo/recursive-cache)
        (prefix-in (only-in :clan/poo/recursive-cache empty receipt-result receipt? run) cached.)
        (runtime: :clan/poo/recursive-handling)
        (prefix-in (only-in :clan/poo/recursive-handling call-batch call-slot failure-stage
                   result-failure result-next result-value session) handling.)
        (prefix-in :clan/poo/examples/recursive-catalog catalog.)
        (runtime: :clan/poo/examples/cyclic-access)
        (prefix-in (only-in :clan/poo/examples/cyclic-access attestation attested-closure
                   config rebase-attested revise-attested start-attested) access.)
        (runtime: :clan/poo/cyclic-publication)
        (prefix-in (only-in :clan/poo/cyclic-publication version-view) publication.))
;; Each control constructs both programs/sessions/publication in identical order.
;; Completed errors/output refusals are expected observations, never timing failures.
(def (workload scenario)
  (map (lambda (mode)
    (def retain? (memq mode '(memo memo-aa)))
    (def original (cached.empty access.attestation))
    (defvalues (_ attested) (cached.run access.attestation '(8 . active) 200 original))
    (def initial (handling.session catalog.program))
    (def broad (catalog.registry 20))
    (def narrow (catalog.registry 3))
    (def root (handling.call-slot initial broad 'chain 4 300))
    (unless (and (not (handling.result-failure root)) (equal? (handling.result-value root) (catalog.expected 4)))
      (error "recursive setup oracle"))
    (def current (handling.result-next root))
    (defvalues (old issue) (access.start-attested access.attestation '(8 . active) 200 (access.config) #t))
    (when issue (error "recursive publication setup refused"))
    (case scenario
      ((attestation)
       (lambda ()
         (defvalues (receipt next) (cached.run access.attestation '(8 . active) 200
           (if retain? attested original)))
         (when retain? (set! attested next))
         (and (cached.receipt? receipt) (eq? (recursive.value-result (cached.receipt-result receipt)) #t))))
      ((publication)
       (lambda ()
         (defvalues (next failure)
           (if retain? (access.revise-attested old '(8 . active) 200 (access.config #f))
             (access.rebase-attested old access.attestation '(8 . active) 200 (access.config #f))))
         (and (not failure) (not (.@ (publication.version-view (access.attested-closure next)) release)))))
      ((batch-resume)
       (lambda ()
         (def partial (handling.call-batch (if retain? current initial) narrow '((chain . 1) (chain . 2) (chain . 0)) 300))
         (def next (handling.call-slot (handling.result-next partial) broad 'chain 2 300))
         (when retain? (set! current (handling.result-next next)))
         (and (handling.result-failure partial) (eq? (handling.failure-stage (handling.result-failure partial)) 'result)
           (not (handling.result-failure next)) (equal? (handling.result-value next) (catalog.expected 2)))))
      (else
       (lambda ()
         (def result (handling.call-slot (if retain? current initial)
           (if (eq? scenario 'output-refusal) narrow broad) (if (eq? scenario 'source-error) 'fail 'chain) 4 300))
         (when retain? (set! current (handling.result-next result)))
         (case scenario
           ((source-error) (and (handling.result-failure result) (eq? (handling.failure-stage (handling.result-failure result)) 'source)))
           ((output-refusal) (and (handling.result-failure result) (eq? (handling.failure-stage (handling.result-failure result)) 'result)))
           (else (and (not (handling.result-failure result)) (equal? (handling.result-value result) (catalog.expected 4)))))))))
    study.strategies))
;; Reuse identical native timing, signed byte admission, GC/prefix and child format.
(def (main scenario-text regime-text side-text)
  (def scenario (string->symbol scenario-text)) (def regime (string->symbol regime-text))
  (def side (string->number side-text))
  (unless (and (memq scenario study.scenarios) (memq regime '(natural collected)) (memv side '(0 1 2 3)))
    (error "invalid recursive paired request"))
  (run-child scenario regime side (workload scenario) (study.repetitions scenario) 4))
