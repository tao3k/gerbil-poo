;;; Optional phase study. No addition to default build or CI.
(export quotient-routes-test)
(import :std/test :std/iter
        (only-in :std/list/list delete-duplicates/hash)
        (only-in :std/list/list-builder with-list-builder)
        (only-in :gerbil/runtime/gambit default-random-source)
        :clan/poo/object
        :clan/poo/mop :clan/poo/support/option
        (prefix-in :clan/poo/dependency-analysis code.)
        (prefix-in :clan/poo/generalized-graph graph.)
        (prefix-in :clan/poo/strong-components scc.)
        (only-in :clan/poo/feedback-graph graph-cache?)
        (only-in :clan/poo/benchmarks/closure-measure measure qualified-metrics))
(extern namespace: #f random-source-state-ref random-source-state-set!)
(extern namespace: clan/poo/feedback-graph dependencies group-code)

(def (old-routes partition members)
  (def deps (dependencies partition members))
  (def allowed (make-hash-table-eq))
  (for (member members)
    (for (node ((scc.partition-reads partition) member))
      (unless (eq? ((scc.partition-owner partition) node) (car members))
        (hash-put! allowed node #t))))
  (cons deps allowed))

;; Frozen former body, including its normal Computation construction. The
;; phase helper only factors out exactly the original two traversals.
(def (old-group-code partition members source build)
  (def routes (old-routes partition members))
  (def deps (car routes))
  (def allowed (cdr routes))
  (.cc code.Computation. reads: deps .evaluate: (lambda (provider)
    (code.make-success (build members source (lambda (node)
      (def owner ((scc.partition-owner partition) node))
      (unless (hash-key? allowed node) (error "undeclared external SCC read" node))
      (def found (provider owner))
      (unless (and (some? found) (code.success? (some-value found)))
        (error "external feedback group unavailable" node))
      (code.success-value (some-value found))))))))

(def (fused-routes partition members)
  (def observations #f)
  (def nodes (with-list-builder (add-node)
    (set! observations (with-list-builder (add)
      (for (member members)
        (for (node ((scc.partition-reads partition) member))
          (def owner ((scc.partition-owner partition) node))
          (unless (eq? owner (car members))
            (add owner)
            (add-node node))))))))
  (def deps (delete-duplicates/hash observations))
  (def allowed (make-hash-table-eq))
  (for (node nodes) (hash-put! allowed node #t))
  (cons deps allowed))

(def (fixture external? owned?)
  (def members (for/collect (i (in-range 32))
    (string->symbol (string-append "route-member-" (number->string i)))))
  (def providers (for/collect (i (in-range 32))
    (string->symbol (string-append "route-provider-" (number->string i)))))
  (def (cycle nodes external)
    (for/collect ((node nodes) (next (append (cdr nodes) (list (car nodes)))))
      (cons node (.o reads: (cons next external)))))
  (def source (graph.declaration (append members providers)
    (append (cycle members (if external? providers [])) (cycle providers []))))
  (values ((if owned? scc.partition-owned scc.partition) source) members providers))

(def (check-routes result expected providers external?)
  (check-equal? (car result) (car expected))
  (check-equal? (hash-length (cdr result)) (if external? (length providers) 0))
  (for (node providers) (check-eq? (hash-ref (cdr result) node #f) (and external? #t)))
  (check-eq? (hash-ref (cdr result) 'missing-route #f) #f))

(def quotient-routes-test
  (test-suite "captured quotient route preparation"
    (test-case "ordered providers distinct allowed nodes and native constructor effects"
      (for* ((owned? '(#f #t)) (external? '(#f #t)))
        (defvalues (partition members providers) (fixture external? owned?))
        (def state (random-source-state-ref default-random-source))
        (def original (old-routes partition members))
        (def after (random-source-state-ref default-random-source))
        (random-source-state-set! default-random-source state)
        (def candidate (fused-routes partition members))
        (check-routes candidate original providers external?)
        (check-equal? (random-source-state-ref default-random-source) after)))
    (test-case "same-partition interleaving including native tables and natural GC"
      (for (external? '(#f #t))
        (defvalues (partition members providers) (fixture external? #t))
        (def expected (old-routes partition members))
        (for* ((schedule '((paired old fused fused old fused old old fused)
                          (aa old old) (bb fused fused)))
               (side (cdr schedule)))
          (defvalues (result clocks)
            (measure (lambda () ((if (eq? side 'old) old-routes fused-routes) partition members)) 512))
          (check-routes result expected providers external?)
          (displayln (list 'QUOTIENT-ROUTES external? (car schedule) side
            'iterations 512 (qualified-metrics clocks) 'raw-allocation (vector-ref clocks 4))))))
    (test-case "complete original and production group-code construction"
      (for (external? '(#f #t))
        (defvalues (partition members providers) (fixture external? #t))
        (def (no-business _ __ ___) (error "business evaluation during group construction"))
        (def expected (dependencies partition members))
        (for* ((schedule '((paired old production production old production old old production)
                          (aa old old) (bb production production)))
               (side (cdr schedule)))
          (defvalues (result clocks)
            (measure (lambda ()
              ((if (eq? side 'old) old-group-code group-code) partition members #f no-business)) 512))
          (check-equal? (.get result reads) expected)
          (displayln (list 'QUOTIENT-GROUP-CODE external? (car schedule) side
            'iterations 512 (qualified-metrics clocks) 'raw-allocation (vector-ref clocks 4))))))))
