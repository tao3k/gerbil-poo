;;; Balanced same-process controls. One vector per sample, no JSON dictionaries.
(export main)
(import :gerbil/runtime/gambit :std/iter :clan/poo/closure "closure-cases.ss" "closure-measure.ss"
        (only-in "closure-scale-benchmark.ss" workload))
(def (main family size-text width-text)
  (def size (string->number size-text))
  (def width (string->number width-text))
  (unless (and (member (list family size width) cases) (> size 0)) (error "paired case"))
  (def source (workload family size width #t))
  (def revoked (workload family size width #f))
  (def plans (list->hash-table (map (lambda (queue) (cons queue (compile-closure source queue))) queues)))
  (def old-plans (list->hash-table (map (lambda (queue) (cons queue (compile-closure revoked queue))) queues)))
  (for-each (lambda (queue) (solve-closure (hash-ref plans queue) queue)) queues)
  (def rows [])
  (for* ((scope scopes) (round (in-range 8)) (position (in-range (length queues))))
    (def queue (list-ref queues (modulo (+ round position) (length queues))))
    (def repetitions (if (eq? scope 'warm) 200 32))
    (defvalues (result costs)
      (measure (lambda ()
                 (def plan (case scope
                             ((cold) (compile-closure source (if (eq? queue 'auto) 'cold queue)))
                             ((refresh) (reconfigure-closure (hash-ref old-plans queue) source))
                             (else (hash-ref plans queue))))
                 (solve-closure plan queue)) repetitions))
    (unless (andmap identity (closure->list result)) (error "paired scalar oracle"))
    (set! rows (cons (vector scope round queue repetitions costs) rows)))
  (write (reverse rows))
  (newline))
