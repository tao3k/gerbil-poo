;;; Independent metadata prototype. Gerbil still owns package installation.
(export versioned-catalog-test)
(import :std/test :std/iter (only-in :std/error Error-message)
        (only-in :std/list/list length<=n?)
        (only-in :std/list/list-builder with-list-builder)
        (only-in :gerbil/runtime/thread with-lock)
        (only-in :clan/poo/support/index %index %index-ref %index-fork %index-write!)
        (only-in :clan/poo/benchmarks/closure-measure measure qualified-metrics))

(defstruct row (version source) final: #t)
(defstruct indexed-bucket (order versions) final: #t)
(defstruct version-change (key expected replacement) final: #t)
(defstruct catalog (rows) final: #t)
(defstruct publication (lock head) final: #t)
(defstruct proposal (owner base candidate) final: #t)

(def (own-bucket rows)
  ;; Common two-version buckets retain only their ordered row spine.
  (if (length<=n? rows 8) rows
    (let (versions (make-hash-table-eq size: (length rows)))
      (def order
        (with-list-builder (add)
          (for (row rows)
            (def version (row-version row))
            (hash-put! versions version
              (if (hash-key? versions version) 'conflict row))
            (add version))))
      (make-indexed-bucket order (%index versions)))))
(def (build-catalog names bucket)
  (def base (make-hash-table-symbolic size: (vector-length names)))
  (for (name (in-vector names)) (hash-put! base name (own-bucket (bucket name))))
  (make-catalog (%index base)))
(def (find-bucket view name) (%index-ref (catalog-rows view) name []))
(def (versions view name)
  (let (bucket (find-bucket view name))
    (if (indexed-bucket? bucket)
      (list-copy (indexed-bucket-order bucket))
      (map row-version bucket))))
(def (resolve-linear rows name version)
  (let loop ((rest rows) (match #f))
    (cond ((null? rest) (or match (error "missing exact catalog version" name version)))
          ((not (eq? (row-version (car rest)) version)) (loop (cdr rest) match))
          (match (error "conflicting exact catalog version" name version))
          (else (loop (cdr rest) (car rest))))))
(def (resolve view name version)
  (let (bucket (find-bucket view name))
    (if (indexed-bucket? bucket)
      (let (found (%index-ref (indexed-bucket-versions bucket) version #f))
        (cond ((not found) (error "missing exact catalog version" name version))
              ((eq? found 'conflict) (error "conflicting exact catalog version" name version))
              (else found)))
      (resolve-linear bucket name version))))
(def (dependencies view name version reader)
  (reader (row-source (resolve view name version))))
(def (resolve-plan view requests)
  (def pins (make-hash-table-symbolic))
  (def unique
    (with-list-builder (add)
      (for (request requests)
        (def name (car request)) (def version (cdr request))
        (def previous (hash-ref pins name #f))
        (cond ((not previous) (hash-put! pins name version) (add request))
              ((not (eq? version previous))
               (error "incompatible exact catalog requirements" name previous version))))))
  ;; This entire phase is pure metadata selection. Even a missing final row
  ;; must refuse before the first dependency reader can execute.
  (map (lambda (pin) (row-source (resolve view (car pin) (cdr pin)))) unique))
(def (demand-plan view requests reader)
  (map reader (resolve-plan view requests)))
(def (replace-indexed-version bucket change)
  (def key (version-change-key change))
  (unless (and (indexed-bucket? bucket) (symbol? key))
    (error "catalog point replacement requires an indexed symbolic version" key))
  (def versions (indexed-bucket-versions bucket))
  (def actual (%index-ref versions key #f))
  (unless (and (row? actual) (eq? (row-source actual) (version-change-expected change)))
    (error "catalog version has no matching unique predecessor" key))
  (def next (%index-fork versions))
  (%index-write! next key (make-row key (version-change-replacement change)))
  (make-indexed-bucket (indexed-bucket-order bucket) next))
(def (prepare base edits)
  (def rows (%index-fork (catalog-rows base)))
  (for (edit edits)
    ;; The writer owns both the list spine and the row fields after staging.
    ;; Version and source are opaque identities, shared without copying.
    (def name (car edit))
    (def change (cdr edit))
    (%index-write! rows name
      (if (version-change? change)
        (replace-indexed-version (%index-ref rows name []) change)
        (own-bucket (map (lambda (row) (make-row (row-version row) (row-source row))) change)))))
  (make-catalog rows))
(def (snapshot owner) (with-lock (publication-lock owner) (lambda () (publication-head owner))))
(def (stage owner base edits)
  (make-proposal owner base (prepare base edits)))
(def (install! owner edit)
  (with-lock (publication-lock owner) (lambda ()
    (and (eq? (proposal-owner edit) owner)
         (eq? (publication-head owner) (proposal-base edit))
         (begin (publication-head-set! owner (proposal-candidate edit)) #t)))))

(def (catalog-error? message)
  (lambda (cause) (equal? (Error-message cause) message)))
(def (qualification size)
  (def names (make-vector (quotient size 2)))
  (for (i (in-range (vector-length names)))
    (vector-set! names i (string->symbol (string-append "catalog/example/" (number->string i)))))
  (def target (vector-ref names 0))
  (def retired (vector-ref names 1))
  (def unaffected (vector-ref names (1- (vector-length names))))
  (def (base-bucket name) (list (make-row 'v1 name) (make-row 'v2 name)))
  (def reads 0)
  (def (read source) (set! reads (1+ reads)) (list source))
  (def replacement (list (make-row 'v2 'pinned-revision) (make-row 'v3 target)))
  (def edits (list (cons target replacement) (cons retired [])))
  (def (report phase timing)
    (displayln (list 'MODULE-CATALOG size phase (qualified-metrics timing))))
  (defvalues (before cold) (measure (lambda () (build-catalog names base-bucket)) 1))
  (report 'cold cold)
  (defvalues (listed lookup) (measure (lambda () (versions before target)) 1024))
  (check-equal? listed '(v1 v2))
  (check-equal? reads 0)
  (report 'version-enumeration-1024 lookup)
  (defvalues (selected dependency) (measure (lambda () (dependencies before target 'v2 read)) 1))
  (check-equal? selected (list target))
  (check-equal? reads 1)
  (report 'demand-one dependency)
  (def owner (make-publication (make-mutex 'catalog-publication) before))
  (def other (make-publication (make-mutex 'catalog-publication) before))
  (def stale (stage owner before []))
  (defvalues (next delta) (measure (lambda ()
    (def edit (stage owner before edits))
    (unless (install! owner edit) (error "catalog install refused"))
    (proposal-candidate edit)) 1))
  (report 'two-name-publication delta)
  (check-eq? (snapshot owner) next)
  (check (install! owner stale) => #f)
  (check (install! other stale) => #f)
  (check-eq? (snapshot other) before)
  (check-eq? (find-bucket before unaffected) (find-bucket next unaffected))
  (check-equal? (versions before retired) '(v1 v2))
  (check-equal? (versions next retired) [])
  (check-equal? (versions before target) '(v1 v2))
  (check-equal? (versions next target) '(v2 v3))
  (check-equal? (dependencies next target 'v2 read) '(pinned-revision))
  ;; Same name/version but different source must refuse before the read effect.
  (def conflict (prepare next (list (cons target (cons (make-row 'v2 'other-revision) replacement)))))
  (check-exception (dependencies conflict target 'v2 read) (catalog-error? "conflicting exact catalog version"))
  (check-exception (dependencies next target 'v1 read) (catalog-error? "missing exact catalog version"))
  (check-equal? reads 2)
  (def plan-reads 0)
  (def (read-plan source) (set! plan-reads (1+ plan-reads)) source)
  (def requests (list (cons target 'v2) (cons unaffected 'v1) (cons target 'v2)))
  (defvalues (selected-plan plan-time) (measure (lambda () (demand-plan next requests read-plan)) 1))
  (check-equal? selected-plan (list 'pinned-revision unaffected))
  (check-equal? plan-reads 2)
  (report 'two-name-demand plan-time)
  (check-eq? (snapshot owner) next)
  ;; Cold oracle: enumerate the metadata rows independently, after timing.
  (for (name (in-vector names))
    (def expected (cond ((eq? name target) replacement) ((eq? name retired) [])
                        (else (base-bucket name))))
    (def (identity row) (cons (row-version row) (row-source row)))
    (unless (equal? (map identity (find-bucket next name)) (map identity expected))
      (error "incremental catalog differs from cold rows" name)))
  (displayln (list 'MODULE-CATALOG-WORK size 'names (vector-length names) 'edited 2 'reads reads)))

(def (wide-qualification count)
  (def last-version #f)
  (def rows
    (with-list-builder (add)
      (for (index (in-range count))
        (set! last-version (string->symbol (string-append "v" (number->string index))))
        (add (make-row last-version index)))))
  (defvalues (view cold) (measure (lambda () (build-catalog '#(hub) (lambda (_) rows))) 1))
  (check (indexed-bucket? (find-bucket view 'hub)) => #t)
  (def (report phase timing)
    (displayln (list 'MODULE-CATALOG-WIDE count phase (qualified-metrics timing))))
  (report 'cold cold)
  (for (lane '(linear indexed indexed linear))
    (defvalues (resolved timing)
      (measure
        (if (eq? lane 'linear)
          (lambda () (resolve-linear rows 'hub last-version))
          (lambda () (resolve view 'hub last-version)))
        16))
    (check-equal? (row-source resolved) (1- count))
    (report lane timing))
  (def next (prepare view (list (cons 'other (list (make-row 'v1 'other))))))
  (check-eq? (find-bucket view 'hub) (find-bucket next 'hub))
  (check-equal? (dependencies next 'hub last-version values) (1- count))
  (def owner (make-publication (make-mutex 'catalog-publication) next))
  (def edit (cons 'hub (make-version-change last-version (1- count) 'replacement)))
  (defvalues (updated delta) (measure
    (lambda ()
      (def pending (stage owner next (list edit)))
      (unless (install! owner pending) (error "catalog install refused"))
      (snapshot owner)) 1))
  (report 'one-version-publication delta)
  (check-eq? (indexed-bucket-order (find-bucket next 'hub))
             (indexed-bucket-order (find-bucket updated 'hub)))
  (check-eq? (find-bucket next 'other) (find-bucket updated 'other))
  (check-equal? (dependencies next 'hub last-version values) (1- count))
  (check-eq? (dependencies updated 'hub last-version values) 'replacement)
  (check-exception (stage owner updated (list edit))
    (catalog-error? "catalog version has no matching unique predecessor"))
  (check-eq? (snapshot owner) updated)
  (displayln (list 'MODULE-CATALOG-WIDE-WORK count 'linear-version-visits (* 16 count)
                   'indexed-version-lookups 16 'unrelated-index-retained #t 'changed-versions 1)))

(def versioned-catalog-test
  (test-suite "versioned module metadata independent of evaluation"
    (test-case "pin conflicts and late row refusal precede every dependency read"
      (def (fixture name) (list (make-row 'v1 name) (make-row 'v2 name)))
      (def view (build-catalog '#(lab/governance weaver/governance) fixture))
      (def reached [])
      (def (read source) (set! reached (cons source reached)) source)
      (check-exception
        (demand-plan view '((lab/governance . v1) (weaver/governance . v2) (lab/governance . v2)) read)
        (catalog-error? "incompatible exact catalog requirements"))
      (check-exception
        (demand-plan view '((lab/governance . v1) (weaver/governance . missing)) read)
        (catalog-error? "missing exact catalog version"))
      (check-equal? reached [])
      (check-equal? (demand-plan view '((lab/governance . v1) (weaver/governance . v2) (lab/governance . v1)) read)
        '(lab/governance weaver/governance))
      (check-equal? (reverse reached) '(lab/governance weaver/governance)))
    (test-case "staged edits own their bucket spines and row fields"
      (def before (build-catalog '#(lab/governance)
                    (lambda (name) (list (make-row 'v1 name)))))
      (def owner (make-publication (make-mutex 'catalog-publication) before))
      (def first (make-row 'v2 'admitted-v2))
      (def borrowed (list first (make-row 'v3 'admitted-v3)))
      (def edit (stage owner before (list (cons 'lab/governance borrowed))))
      (row-source-set! first 'changed-v2)
      (set-car! (cdr borrowed) (make-row 'v4 'changed-v4))
      (check (install! owner edit) => #t)
      (def after (snapshot owner))
      (set-cdr! borrowed [])
      (check-equal? (versions before 'lab/governance) '(v1))
      (check-equal? (versions after 'lab/governance) '(v2 v3))
      (check-eq? (dependencies after 'lab/governance 'v2 values) 'admitted-v2)
      (check-eq? (dependencies after 'lab/governance 'v3 values) 'admitted-v3))
    (test-case "indexed versions preserve order, absence and equal-source conflict"
      (def names '(v1 v2 v3 v4 v5 v6 v7 v8 v9 v1))
      (def view (build-catalog '#(hub) (lambda (_name) (map (cut make-row <> 'source) names))))
      (def reads 0)
      (def (read source) (set! reads (1+ reads)) source)
      (check-equal? (versions view 'hub) names)
      (set-car! (versions view 'hub) 'external-edit)
      (check-equal? (versions view 'hub) names)
      (check-exception (dependencies view 'hub 'v1 read) (catalog-error? "conflicting exact catalog version"))
      (check-exception (dependencies view 'hub 'absent read) (catalog-error? "missing exact catalog version"))
      (check-exception (prepare view (list (cons 'hub (make-version-change 'v1 'source 'other))))
        (catalog-error? "catalog version has no matching unique predecessor"))
      (check-equal? reads 0)
      (check-eq? (dependencies view 'hub 'v9 read) 'source)
      (check-equal? reads 1))
    (test-case "100K and 1M metadata rows, exact resolution and persistent publication"
      (qualification 100000)
      (qualification 1000000))
    (test-case "100K and 1M versions under one name"
      (wide-qualification 100000)
      (wide-qualification 1000000))))
