;;; Native Scheme controls for signature checking, candidate caching and watches.
(export main sources phases widths rounds phase-repetitions)
(import :gerbil/runtime/gambit :std/iter
        (only-in :clan/poo/object .o)
        (prefix-in :clan/poo/closure closure.)
        (prefix-in :clan/poo/cyclic-publication cyclic-publication.) (only-in :std/values first-value)
        "closure-measure.ss"
        (prefix-in :clan/poo/multimethod multimethod.)
        (prefix-in :clan/poo/dispatch-extension dispatch-extension.)
        (prefix-in :clan/poo/examples/protected-dispatch protected-dispatch.))
(def sources '("multimethod.ss" "dispatch-extension.ss" "cyclic-publication.ss" "closure.ss" "object.ss" "mop.ss"
               "number.ss" "type.ss" "justfile" "examples/protected-dispatch.ss" "benchmarks/closure-measure.ss" "benchmarks/dispatch-benchmark.ss"))
(def widths '(0 64 256))
(def rounds 4)
(def (phase-repetitions phase)
  (cond ((memq phase '(construct family-prepare)) 4) ((memq phase '(cold warm guard-values family-cold family-warm)) 2000) (else 128)))
(def phases '(construct cold warm check accept refuse cancel guard-values family-prepare family-cold family-warm))
(def (main output binary)
  ;; A failed/aborted run must never leave an earlier accepted study in place.
  (write-datum output '(dispatch-benchmarks (status incomplete)))
  (def binary-identity (source-digests (list binary)))
  (def identities (source-digests sources))
  (def rows [])
  (for (width widths)
    (def base (protected-dispatch.make-dispatch width))
    (def previous (dispatch-extension.check base (protected-dispatch.watches)))
    (defvalues (initial-fee warm) (multimethod.call base protected-dispatch.invoice protected-dispatch.card 10))
    (def protected-high (dispatch-extension.check warm
      (append (protected-dispatch.watches) (list (dispatch-extension.call protected-dispatch.invoice protected-dispatch.bank 150)))))
    (def risk (dispatch-extension.register-when (protected-dispatch.path 'Invoice 'Bank)
                 (lambda (_ __ amount) (> amount 100)) (lambda (_ __ amount) (+ amount 7))))
    (defvalues (guarded issue) (dispatch-extension.publish previous (list risk)))
    (when issue (error "guarded baseline refused"))
    (defvalues (initial-low guarded-warm) (dispatch-extension.invoke guarded protected-dispatch.invoice protected-dispatch.bank 10))
    (unless (and (equal? initial-fee '(13)) (null? initial-low)) (error "baseline oracle"))
    (def (fee generic)
      (defvalues (result next) (multimethod.call generic protected-dispatch.invoice protected-dispatch.card 10))
      (unless (equal? result '(13)) (error "typed fee oracle"))
      (multimethod.cache-size next))
    (def equations (vector (closure.literal #t)))
    (def (cook _) (.o (release #t)))
    (def (family) (cyclic-publication.prepare equations cook (cut protected-dispatch.release-family <> width) (lambda (_) #t)))
    (defvalues (cold-family family-issue) (family))
    (when family-issue (error "family baseline refused"))
    (defvalues (initial-family-fee warm-family)
      (cyclic-publication.invoke cold-family 'fee protected-dispatch.invoice protected-dispatch.card 10))
    (unless (equal? initial-family-fee '(13)) (error "family oracle"))
    (def (family-fee previous reuse?)
      (def untouched (cyclic-publication.version-service previous 'enabled))
      (defvalues (result next) (cyclic-publication.invoke previous 'fee protected-dispatch.invoice protected-dispatch.card 10))
      (and (equal? result '(13)) (eq? untouched (cyclic-publication.version-service next 'enabled))
           (eq? (eq? previous next) reuse?)))
    (def actions
      (vector (lambda () (multimethod.cache-size (protected-dispatch.make-dispatch width)))
              (lambda () (fee base))
              (lambda () (fee warm))
              (lambda () (dispatch-extension.certificate? (dispatch-extension.check base (protected-dispatch.watches))))
              (lambda () (let-values (((next issue) (dispatch-extension.publish previous (list risk))))
                           (and (not issue) (= (multimethod.cache-size (dispatch-extension.snapshot next)) 0))))
              (lambda () (let-values (((next issue) (dispatch-extension.publish protected-high (list risk))))
                           (and (eq? next protected-high) (dispatch-extension.failure? issue)
                                (eq? (dispatch-extension.failure-stage issue) 'negative))))
              (lambda () (let-values (((next issue) (dispatch-extension.publish protected-high
                             (list risk (dispatch-extension.erase (protected-dispatch.path 'Invoice 'Bank))))))
                           (and (not issue) (= (multimethod.cache-size (dispatch-extension.snapshot next)) 0))))
              (lambda ()
                (def low (first-value (dispatch-extension.invoke guarded-warm protected-dispatch.invoice protected-dispatch.bank 10)))
                (def high (first-value (dispatch-extension.invoke guarded-warm protected-dispatch.invoice protected-dispatch.bank 150)))
                (and (null? low) (equal? high '(157))))
              (lambda () (let-values (((version issue) (family))) (and (not issue) (cyclic-publication.version? version))))
              (lambda () (family-fee cold-family #f))
              (lambda () (family-fee warm-family #t))))
    (for* ((gc '(natural collected)) (round (in-range rounds)) (position (in-range (length phases))))
      (def index (modulo (+ round position) (length phases)))
      (def phase (list-ref phases index))
      (def repetitions (phase-repetitions phase))
      (defvalues (result metrics) (measure (vector-ref actions index) repetitions (eq? gc 'collected)))
      (unless (equal? result (case phase ((construct) 0) ((cold warm) 1) (else #t)))
        (error "benchmark phase oracle" width phase result))
      ;; This runtime's allocation counter can decrease across GC. Preserve the
      ;; signed diagnostic; never present it as allocated bytes or clamp it.
      (def raw-bytes (vector-ref metrics 4))
      (unless (and (= (vector-ref metrics 3) 0) (>= raw-bytes 0)) (vector-set! metrics 4 #f))
      (set! rows (cons (vector width gc round phase repetitions metrics raw-bytes) rows))))
  (unless (equal? identities (source-digests sources)) (error "benchmark sources changed"))
  (unless (equal? binary-identity (source-digests (list binary))) (error "benchmark binary changed"))
  (write-datum output
    `(dispatch-benchmarks
       (toolchain ,(gerbil-version-string) ,(system-version-string))
       (sources ,@identities) (binary ,@binary-identity) (widths ,@widths) (rounds ,rounds) (phases ,@phases)
       (cache-capacity ,multimethod.cache-capacity) (columns width gc round phase repetitions #(cpu wall gc-cpu collections bytes-or-false) raw-allocation-delta)
       (notes "C4/type descriptors primed before timed calls; construct includes signature/registration, not compiler startup."
              "guard-values performs two calls per repetition. Pure callbacks and stable type/C4 graph are premises."
              "Allocation is unavailable for every GC-crossing interval or negative counter delta; signed raw deltas are retained.")
       (rows ,@(reverse rows))))
  (displayln "DISPATCH-BENCHMARKS-OK rows=" (length rows)))
