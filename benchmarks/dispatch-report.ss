(export main read-study)
(import :std/iter "closure-measure.ss"
        (only-in "dispatch-benchmark.ss" sources phases widths rounds phase-repetitions))
(def (read-study path (check-current? #t))
  (def data (read-datum path))
  (unless (and (pair? data) (eq? (car data) 'dispatch-benchmarks)) (error "dispatch benchmark header"))
  (def (field name) (cdr (assq name (cdr data))))
  (unless (and (equal? (field 'widths) widths) (equal? (field 'phases) phases) (equal? (field 'rounds) (list rounds))
               (equal? (map car (field 'sources)) sources)) (error "dispatch benchmark definition changed"))
  (when check-current?
    (unless (equal? (field 'sources) (source-digests sources)) (error "dispatch benchmark source changed")))
  (def rows (field 'rows))
  (unless (= (length rows) (* (length widths) 2 rounds (length phases))) (error "incomplete dispatch matrix"))
  (def seen (make-hash-table))
  (for (row rows)
    (unless (and (vector? row) (= (vector-length row) 7)) (error "dispatch row"))
    (def width (vector-ref row 0))
    (def gc (vector-ref row 1))
    (def round (vector-ref row 2))
    (def phase (vector-ref row 3))
    (unless (and (member width widths) (memq gc '(natural collected))
                 (exact-integer? round) (<= 0 round) (< round rounds) (memq phase phases)
                 (= (vector-ref row 4) (phase-repetitions phase))
                 (vector? (vector-ref row 5)) (= (vector-length (vector-ref row 5)) 5)
                 (andmap (lambda (n) (and (real? n) (>= n 0))) (take (vector->list (vector-ref row 5)) 4))
                 (real? (vector-ref row 6)))
      (error "dispatch row outside definition"))
    (def metrics (vector-ref row 5))
    (def raw-bytes (vector-ref row 6))
    (unless (equal? (vector-ref metrics 4)
                   (if (and (= (vector-ref metrics 3) 0) (>= raw-bytes 0)) raw-bytes #f))
      (error "invalid allocation admission"))
    (def key (vector width gc round phase))
    (when (hash-key? seen key) (error "duplicate dispatch row" key))
    (hash-put! seen key #t))
  rows)
(def (main path)
  (def rows (read-study path))
  (for* ((width widths) (gc '(natural collected)) (phase phases))
    (def selected (filter (lambda (row) (and (= width (vector-ref row 0))
                         (eq? gc (vector-ref row 1)) (eq? phase (vector-ref row 3)))) rows))
    (def (cost row index) (/ (vector-ref (vector-ref row 5) index) (vector-ref row 4)))
    (displayln width "/" gc "/" phase " us=" (* 1e6 (median (map (cut cost <> 0) selected)))
               " bytes=" (if (andmap (lambda (row) (vector-ref (vector-ref row 5) 4)) selected)
                            (median (map (cut cost <> 4) selected)) 'unavailable)))
  (displayln "DISPATCH-REPORT-OK rows=" (length rows)))
