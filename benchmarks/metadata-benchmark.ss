;;; Bound wrappers, refusals and cooked-family preparation, measured by Scheme.
(export main sources phases rounds repetitions)
(import :gerbil/runtime/gambit
        :std/iter
        (only-in :clan/poo/object .cc .@ .o .call)
        :clan/poo/support/option
        (only-in :std/values first-value)
        "closure-measure.ss"
        (runtime: :clan/poo/declarative-metadata)
        (prefix-in (only-in :clan/poo/declarative-metadata atom both contract contract?
                   failure-phase failure? invoke predicate publish wrap) metadata.)
        (only-in :clan/poo/mop element?)
        (only-in :clan/poo/number IntegerRange)
        (prefix-in :clan/poo/examples/service-metadata service.)
        (runtime: :clan/poo/examples/cyclic-access)
        (prefix-in (only-in :clan/poo/examples/cyclic-access config equations) access.)
        (runtime: :clan/poo/cyclic-publication)
        (prefix-in (only-in :clan/poo/cyclic-publication failure-cause failure-stage
                   failure? invoke version-cache version-contract-family
                   version-contract-invoker version-family version-service
                   version-source version-view version?) publication.)
        (prefix-in :clan/poo/examples/service-bundle bundle.)
        (prefix-in :clan/poo/examples/protected-dispatch protected.)
        (runtime: :clan/poo/contract-family)
        (prefix-in (only-in :clan/poo/contract-family choose-preparation family-bound
                   family-built family-invoker family-prepared? family-ref prepare
                   refresh) contracts.)
        (runtime: :clan/poo/examples/shared-contracts)
        (prefix-in (only-in :clan/poo/examples/shared-contracts construct independent-source
                   model prepare-shared project-direct project-shared selected-model
                   selected-source shared-input source workflow-model) shared.)
        (runtime: :clan/poo/generic-family)
        (prefix-in (only-in :clan/poo/generic-family failure-stage family-built family-reused
                   prepare refresh) family.)
        (prefix-in :clan/poo/staged-publication staged.)
        (runtime: :clan/poo/multimethod)
        (prefix-in (only-in :clan/poo/multimethod cache-size) multimethod.)
        (runtime: :clan/poo/dispatch-extension)
        (prefix-in (only-in :clan/poo/dispatch-extension snapshot) dispatch.)
        (prefix-in :clan/poo/construction-cache cache.)
        (runtime: :clan/poo/generalized-graph)
        (prefix-in (only-in :clan/poo/generalized-graph define reschedule schedule
                   schedule-order set-base) graph.)
        (runtime: :clan/poo/dependency-analysis)
        (prefix-in (only-in :clan/poo/dependency-analysis make-success need) code.)
        (prefix-in :clan/poo/examples/construction-workflow workflow.))
(def sources '("contract-family.ss" "build.ss" "dependency-analysis.ss" "generalized-graph.ss" "construction-cache.ss" "declarative-metadata.ss" "generic-family.ss" "staged-publication.ss" "cyclic-publication.ss" "dispatch-extension.ss" "multimethod.ss"
               "closure.ss" "object.ss" "mop.ss" "type.ss" "number.ss" "justfile"
               "examples/shared-contracts.ss" "examples/construction-workflow.ss" "examples/service-metadata.ss" "examples/service-bundle.ss" "examples/protected-dispatch.ss" "examples/cyclic-access.ss"
               "benchmarks/closure-measure.ss" "benchmarks/metadata-benchmark.ss" "benchmarks/metadata-report.ss"))
(def phases '(raw bound invoke wrap-build input-refuse output-refuse logic-refuse family-build family-warm revise refused-revise
              protected-build protected-cold protected-warm guarded-low guarded-high protected-refuse protected-cancelled metadata-refuse call-refuse
              component-start component-refresh component-reuse component-root component-presence
              selective-release policy-release selective-negative-refuse selective-admission-refuse
              schedule-full schedule-retained component-recapture protected-full-cold protected-full-warm
              service-reuse service-cold service-price service-price-cold service-invoice service-invoice-cold
              service-budget-refuse service-negative-refuse
              contract-prepare contract-retain contract-change contract-rebind
              contract-release-reuse contract-release-cold contract-price-reuse contract-price-cold
              shared-input-retain independent-input-retain shared-price independent-price shared-joint independent-joint
              joint-input-shared joint-input-independent joint-construct joint-bind joint-family-shared joint-family-independent joint-generics joint-approval joint-cook
              selected-price selected-joint joint-family-selected joint-input-direct joint-selection joint-unfactored-construct unfactored-joint unfactored-price
              workflow-selected-joint workflow-unfactored-joint))
(def rounds 4)
(def (repetitions phase)
  ;; Release-only follow-up: initial 8-op natural-GC price comparison regressed.
  ;; Increase both matched sides equally; keep the same fixed time/heap bounds.
  (cond ((memq phase '(workflow-selected-joint workflow-unfactored-joint)) 128)
        ((memq phase '(selected-price selected-joint joint-family-selected joint-input-direct joint-selection joint-unfactored-construct unfactored-joint unfactored-price)) 128)
        ((memq phase '(joint-input-shared joint-input-independent joint-construct joint-bind joint-family-shared joint-family-independent joint-generics joint-approval joint-cook)) 128)
        ((memq phase '(shared-input-retain independent-input-retain shared-price independent-price shared-joint independent-joint)) 128)
        ((memq phase '(contract-release-reuse contract-release-cold contract-price-reuse contract-price-cold)) 128)
        ((memq phase '(family-build revise refused-revise protected-build protected-refuse protected-cancelled metadata-refuse
                         component-start component-refresh component-reuse component-root component-presence
                         selective-release policy-release selective-negative-refuse selective-admission-refuse
                         schedule-full schedule-retained component-recapture
                         service-reuse service-cold service-price service-price-cold service-invoice service-invoice-cold
                         service-budget-refuse service-negative-refuse
                         contract-prepare contract-retain contract-change contract-rebind
                         contract-release-reuse contract-release-cold contract-price-reuse contract-price-cold)) 8)
        ((memq phase '(protected-cold protected-warm guarded-low guarded-high call-refuse protected-full-cold protected-full-warm)) 512)
        (else 4000)))
;; Matched unfactored control: the previous public constructor semantics.
;; This intentionally reconstructs invariant Types/Formula; it is not a runtime API.
(def reference-units-type (IntegerRange min: 0))
(def (unfactored-construct key input)
  (case key
    ((reserve)
     (metadata.contract
       (metadata.predicate "positive-units" (match <> ([units] (and (element? reference-units-type units) (> units 0))) (else #f)))
       (metadata.predicate "successful-reservation"
         (match <> (['ok remaining permitted] (and (integer? remaining) (>= remaining 0) (boolean? permitted))) (else #f)))
       (lambda (atom args result)
         (case atom ((permission) (<= (car args) input))
                   ((conservation) (equal? result (list 'ok (- input (car args)) #t)))))
       (metadata.both (metadata.atom 'permission) (metadata.atom 'conservation))))
    ((cancel)
     (metadata.contract
       (metadata.predicate "consent" (match <> ([customer #t] (string? customer)) (else #f)))
       (metadata.predicate "invoice-event" (match <> ([customer tag] (and (string? customer) (string? tag))) (else #f)))
       (lambda (_ args result) (equal? result (list (car args) input))) (metadata.atom 'invoice)))))
(def (main output binary)
  (write-datum output '(metadata-benchmarks (status incomplete)))
  (def identities (source-digests sources))
  (def binary-identity (source-digests (list binary)))
  (def config (access.config))
  (def contract (service.reservation 10))
  (def (raw args) (values (list 'ok (- 10 (car args)) #t) 'state))
  (def bound (metadata.wrap contract raw))
  (def (failure-phase execute args)
    (defvalues (value state issue) (metadata.publish contract 'old execute args))
    (unless (and (not value) (eq? state 'old) (metadata.failure? issue)) (error "refusal oracle"))
    (metadata.failure-phase issue))
  (defvalues (old issue) (service.start config #t 10 3 "invoice:1" 10))
  (when issue (error "family refused" issue))
  (defvalues (value warm) (publication.invoke old 'reserve 2))
  (unless (equal? value '(ok 8 #t)) (error "family oracle"))
  (def (revision available price)
    (defvalues (next issue) (service.revise warm config #t available price "invoice:2" 10))
    (if issue (and (eq? next warm) (eq? (publication.failure-stage issue) 'admission))
      (equal? (first-value (publication.invoke next 'reserve 12)) '(ok 8 #t))))
  (def policy (.cc bundle.Policy. capacity: 10 price: 3 invoice: "invoice:1"))
  (defvalues (composed composed-issue) (bundle.start policy))
  (when composed-issue (error "protected family baseline" composed-issue))
  (defvalues (quote-result composed-warm) (publication.invoke composed 'quote protected.invoice protected.card 10))
  (unless (equal? quote-result '(13 13)) (error "protected quote oracle"))
  (defvalues (low bank-warm) (publication.invoke composed-warm 'quote protected.invoice protected.bank 10))
  (unless (null? low) (error "guarded baseline"))
  (defvalues (limited limited-issue) (bundle.start (.cc policy cache-limit: 1)))
  (when limited-issue (error "limited baseline"))
  (defvalues (_ limited-warm) (publication.invoke limited 'quote protected.invoice protected.card 10))
  ;; Matched control retains full joint admission, with identical service code.
  (defvalues (full full-issue)
    (staged.prepare (.cc bundle.model .readmit: bundle.admit) (access.equations config #t) policy))
  (when full-issue (error "full admission control refused"))
  (defvalues (full-value full-warm) (publication.invoke full 'quote protected.invoice protected.card 10))
  (def (quote-call current channel amount expected same?)
    (defvalues (result next) (publication.invoke current 'quote protected.invoice channel amount))
    (and (equal? result expected) (eq? (eq? next current) same?)))
  (def (refuse-revision changed stage)
    (defvalues (retained issue) (bundle.revise composed-warm changed))
    (and (eq? retained composed-warm) (publication.failure? issue)
         (if (eq? stage 'negative)
           (and (eq? (publication.failure-stage issue) 'services)
                (eq? (family.failure-stage (publication.failure-cause issue)) 'negative))
           (eq? (publication.failure-stage issue) stage))))
  (defvalues (settled settlement-issue) (workflow.start (workflow.graph 30) policy))
  (when settlement-issue (error "selective baseline" settlement-issue))
  (defvalues (initial-reservation settlement-warm) (publication.invoke settled 'reserve 2))
  (def baseline (publication.version-cache settlement-warm))
  (def source (cache.cache-source baseline))
  (def changed (graph.define source 'invoice (code.need 'settlement (cut + <> 9))))
  (def prior-schedule (graph.schedule source))
  (def expected-order (graph.schedule-order prior-schedule))
  ;; Equal immutable fields, different source identity: forces capture/scan.
  (def recaptured (.cc source))
  (def allowed (.cc cache.Builder. allow: (cut memq <> '(invoice release total))))
  (def reject (.cc cache.Builder. allow: (lambda (_) #f)))
  (def (cache-oracle next count total)
    (and (= (length (cache.cache-evaluated next)) count)
         (= (+ count (length (cache.cache-reused next))) 15)
         (= (workflow.value next 'total) total)))
  (def (selective changed policy builder expected-stage)
    (defvalues (next issue) (workflow.revise settlement-warm changed policy builder))
    (if expected-stage
      (and (eq? next settlement-warm) issue (eq? (publication.failure-stage issue) expected-stage)
           (= (multimethod.cache-size (dispatch.snapshot (publication.version-service next 'reserve))) 1))
      (and (not issue) (cache-oracle (publication.version-cache next) 3 41)
           (equal? (first-value (publication.invoke next 'reserve 2)) '(ok 39 #t)))))
  (defvalues (reserve-value service-held) (publication.invoke composed-warm 'reserve 2))
  (defvalues (cancel-value service-warm) (publication.invoke service-held 'cancel "customer" #t))
  (unless (and (equal? reserve-value '(ok 8 #t)) (equal? cancel-value '("customer" "invoice:1")))
    (error "warm service baseline"))
  (def generics (.@ bundle.model generics))
  (def cold-model
    (.cc bundle.model
      generics: (.cc generics .refresh: (lambda (_ policy view) (family.prepare generics policy view)))
      .admit-refresh: (lambda (_ policy candidate) (bundle.admit policy candidate))))
  (def (service-revision model changed expected expected-reused)
    (defvalues (next issue) (staged.publish model service-warm (access.equations config #t) changed))
    (and (not issue)
      (equal? (family.family-built (publication.version-family next)) expected)
      (equal? (family.family-reused (publication.version-family next)) expected-reused)
      (andmap (lambda (key) (eq? (publication.version-service next key) (publication.version-service service-warm key))) expected-reused)
      (equal? (first-value (publication.invoke next 'quote protected.invoice protected.card 10)) (list 13 (+ 10 (.@ changed price))))
      (equal? (first-value (publication.invoke next 'reserve 2)) (list 'ok (- (.@ changed capacity) 2) #t))
      (equal? (first-value (publication.invoke next 'cancel "customer" #t)) (list "customer" (.@ changed invoice)))))
  (def (service-refusal changed)
    (defvalues (retained issue) (bundle.revise service-warm changed))
    (and issue (eq? retained service-warm)
      (equal? (map (lambda (key) (multimethod.cache-size (dispatch.snapshot (publication.version-service retained key))))
                   '(quote reserve cancel)) '(1 1 1))))
  (def contract-source (.@ bundle.model contract-source))
  (def contract-view (publication.version-view service-warm))
  (def larger-view (.o (capacity 20)))
  (def (contract-execute _ args current)
    (values (list 'ok (- (.@ current capacity) (car args)) #t) current))
  (def (other-execute key args current) (contract-execute key args current))
  (def prepared-contracts (contracts.prepare contract-source policy contract-view contract-execute))
  (def contract-cold-model
    (.cc bundle.model .contracts: (lambda (_ policy view execute available) (contracts.prepare contract-source policy view execute available))))
  (def (contract-oracle current built bound shared? view)
    (defvalues (result returned) ((contracts.family-invoker current 'reserve) '(2) view))
    (and (equal? (contracts.family-built current) built) (equal? (contracts.family-bound current) bound)
         (eq? (eq? (contracts.family-ref current 'reserve) (contracts.family-ref prepared-contracts 'reserve)) shared?)
         (equal? result (list 'ok (- (.@ view capacity) 2) #t)) (eq? returned view)))
  (def (contract-release model changed cold? expected expected-reused)
    (defvalues (next issue) (staged.publish model service-warm (access.equations config #t) changed))
    (and (not issue)
      (equal? (family.family-built (publication.version-family next)) expected)
      (equal? (family.family-reused (publication.version-family next)) expected-reused)
      (equal? (contracts.family-built (publication.version-contract-family next)) (if cold? '(reserve) []))
      (equal? (contracts.family-bound (publication.version-contract-family next)) (if cold? '(reserve) []))
      (eq? (eq? (publication.version-contract-invoker next 'reserve)
                (publication.version-contract-invoker service-warm 'reserve)) (not cold?))
      (equal? (first-value (publication.invoke next 'reserve 2)) '(ok 8 #t))
      (equal? (first-value (publication.invoke next 'quote protected.invoice protected.card 10)) (list 13 (+ 10 (.@ changed price))))))
  (def shared-view (publication.version-view service-warm))
  (def prepared-shared (contracts.prepare shared.source policy shared-view contract-execute))
  (def prepared-independent (contracts.prepare shared.independent-source policy shared-view contract-execute))
  (def independent-model (.cc shared.model contract-source: shared.independent-source))
  (defvalues (shared-old shared-issue) (staged.prepare shared.model (access.equations config #t) policy))
  (defvalues (independent-old independent-issue) (staged.prepare independent-model (access.equations config #t) policy))
  (when (or shared-issue independent-issue) (error "shared initial publication refused"))
  (def (retain-inputs source previous)
    (def next (contracts.refresh source previous policy shared-view contract-execute))
    (and (not (contracts.family-prepared? next))
      (equal? (contracts.family-built next) []) (equal? (contracts.family-bound next) [])
      (andmap (lambda (key) (eq? (contracts.family-invoker next key) (contracts.family-invoker previous key))) '(reserve cancel))))
  (def (shared-release model previous joint? shared?)
    (def changed (if joint? (.cc policy capacity: 20 invoice: "invoice:2") (.cc policy price: 4)))
    (defvalues (next issue) (staged.publish model previous (access.equations config #t) changed))
    (and (not issue)
      (eq? (contracts.family-prepared? (publication.version-contract-family next)) (and shared? joint?))
      (equal? (contracts.family-built (publication.version-contract-family next)) (if joint? '(reserve cancel) []))
      (equal? (contracts.family-bound (publication.version-contract-family next)) (if joint? '(reserve cancel) []))
      (equal? (family.family-built (publication.version-family next)) (if joint? '(quote reserve cancel) '(quote)))
      (equal? (first-value (publication.invoke next 'reserve 2)) (list 'ok (- (.@ changed capacity) 2) #t))
      (equal? (first-value (publication.invoke next 'cancel "customer" #t)) (list "customer" (.@ changed invoice)))))
  ;; Stage isolation uses the same real closed inputs, constructors and candidate.
  ;; Measure whole batches, never put timers into production callbacks.
  (def joint-policy (.cc policy capacity: 20 invoice: "invoice:2"))
  (defvalues (joint-candidate joint-issue) (staged.publish shared.model shared-old (access.equations config #t) joint-policy))
  (when joint-issue (error "joint profiling candidate refused"))
  (def joint-view (publication.version-view joint-candidate))
  (def reserve-descriptor (shared.construct 'reserve 20))
  (def cancel-descriptor (shared.construct 'cancel "invoice:2"))
  (def (joint-input shared?)
    (def context (shared.shared-input joint-policy joint-view))
    (def lookup (and shared? (shared.prepare-shared context)))
    (equal? (map (lambda (key) (shared.project-shared key (or lookup (shared.prepare-shared context)))) '(reserve cancel))
            '(20 "invoice:2")))
  (def (joint-family source previous)
    (def next (contracts.refresh source previous joint-policy joint-view contract-execute))
    (and (equal? (contracts.family-built next) '(reserve cancel))
         (equal? (contracts.family-bound next) '(reserve cancel))))
  (def selected-source shared.selected-source)
  (def selected-costs (.@ selected-source preparation-costs))
  (def prepared-selected (contracts.prepare selected-source policy shared-view contract-execute))
  (defvalues (selected-old selected-issue) (staged.prepare shared.selected-model (access.equations config #t) policy))
  (def unfactored-model (.cc shared.model contract-source: (.cc shared.source construct: unfactored-construct)))
  (defvalues (unfactored-old unfactored-issue) (staged.prepare unfactored-model (access.equations config #t) policy))
  (when (or selected-issue unfactored-issue) (error "strategy/control baseline refused"))
  ;; Admit the reference semantics before measuring constructor-only batches.
  (for* ((key '(reserve cancel)) (constructor (list shared.construct unfactored-construct)))
    (def descriptor (constructor key (if (eq? key 'reserve) 20 "invoice:2")))
    (def args (if (eq? key 'reserve) '(2) '("customer" #t)))
    (def expected-result (if (eq? key 'reserve) '(ok 18 #t) '("customer" "invoice:2")))
    (unless (equal? (first-value (metadata.invoke descriptor (lambda (_) (values expected-result 'state)) args)) expected-result)
      (error "constructor control result" key))
    (def invalid (if (eq? key 'reserve) '(0) '("customer" #f)))
    (def refused (try (metadata.invoke descriptor (lambda (_) (error "invalid input executed")) invalid) #f
                     (catch (cause) (and (metadata.failure? cause) (eq? (metadata.failure-phase cause) 'input)))))
    (unless refused (error "constructor control input" key)))
  (def workflow-unfactored (.cc shared.workflow-model contract-source: (.cc shared.source construct: unfactored-construct)))
  (defvalues (selected-workflow selected-workflow-issue) (staged.prepare shared.workflow-model (workflow.graph 30) policy))
  (defvalues (unfactored-workflow unfactored-workflow-issue) (staged.prepare workflow-unfactored (workflow.graph 30) policy))
  (when (or selected-workflow-issue unfactored-workflow-issue) (error "workflow control baseline"))
  (def selected-revision (graph.define (publication.version-source selected-workflow) 'invoice (code.need 'settlement (cut + <> 9))))
  (def unfactored-revision (graph.define (publication.version-source unfactored-workflow) 'invoice (code.need 'settlement (cut + <> 9))))
  (def (workflow-joint model old source)
    (defvalues (next issue) (staged.publish model old source policy))
    (and (not issue)
      (equal? (cache.cache-evaluated (publication.version-cache next)) '(invoice release total))
      (= (length (cache.cache-reused (publication.version-cache next))) 12)
      (equal? (contracts.family-built (publication.version-contract-family next)) '(reserve cancel))
      (equal? (contracts.family-bound (publication.version-contract-family next)) '(reserve cancel))
      (equal? (first-value (publication.invoke next 'reserve 2)) '(ok 39 #t))
      (equal? (first-value (publication.invoke next 'cancel "customer" #t)) '("customer" "invoice:33"))))
  (def binding-descriptors (list reserve-descriptor cancel-descriptor))
  (def actions
    (list (lambda () (first-value (raw '(2))))
          (lambda () (first-value (bound '(2))))
          (lambda () (first-value (metadata.invoke contract raw '(2))))
          (lambda () (procedure? (metadata.wrap contract raw)))
          (lambda () (failure-phase raw '(0)))
          (lambda () (failure-phase raw '(11)))
          (lambda () (failure-phase (lambda (_) (values '(ok 9 #t) 'state)) '(2)))
          (lambda () (let-values (((next issue) (service.start config #t 10 3 "invoice:1" 10)))
                       (and (not issue) (publication.version? next))))
          (lambda () (first-value (publication.invoke warm 'reserve 2)))
          (lambda () (revision 20 4))
          (lambda () (revision 20 8))
          (lambda () (let-values (((next issue) (bundle.start policy))) (and (not issue) (publication.version? next))))
          (lambda () (quote-call composed protected.card 10 '(13 13) #f))
          (lambda () (quote-call composed-warm protected.card 10 '(13 13) #t))
          (lambda () (quote-call bank-warm protected.bank 10 [] #t))
          (lambda () (quote-call bank-warm protected.bank 150 '(160) #t))
          (lambda () (refuse-revision (.cc policy forbidden-quote: #t) 'negative))
          (lambda ()
            (defvalues (next issue) (bundle.revise composed-warm (.cc policy forbidden-quote: #t cancelled-extension: #t)))
            (and (not issue) (quote-call next protected.bank 150 '(160) #f)))
          (lambda () (refuse-revision (.cc policy reserve-shift: 1) 'admission))
          (lambda ()
            (try
              (let-values (((value next) (publication.invoke limited-warm 'reserve 2))) #f)
              (catch (cause)
                (and (publication.failure? cause) (eq? (publication.failure-stage cause) 'admission)
                     (= (multimethod.cache-size (dispatch.snapshot (publication.version-service limited-warm 'reserve))) 0)))))
          (lambda () (cache-oracle (cache.start source) 15 32))
          (lambda () (cache-oracle (cache.refresh baseline changed allowed) 3 41))
          (lambda () (cache-oracle (cache.refresh baseline source reject) 0 32))
          (lambda () (cache-oracle (cache.refresh baseline (graph.set-base source 'input (some (code.make-success 60)))) 11 58))
          (lambda () (cache-oracle (cache.refresh baseline (graph.set-base source 'discount (some (code.make-success 5)))) 6 37))
          (lambda () (selective changed policy allowed #f))
          (lambda ()
            (defvalues (next issue) (workflow.revise settlement-warm source (.cc policy price: 4) reject))
            (and (not issue) (cache-oracle (publication.version-cache next) 0 32)
                 (equal? (first-value (publication.invoke next 'quote protected.invoice protected.card 10)) '(13 14))))
          (lambda () (selective changed (.cc policy forbidden-cancel: #t) allowed 'services))
          (lambda () (selective changed (.cc policy reserve-shift: 1) allowed 'admission))
          (lambda () (equal? (graph.schedule-order (graph.schedule changed)) expected-order))
          (lambda () (equal? (graph.schedule-order (graph.reschedule prior-schedule changed)) expected-order))
          (lambda () (cache-oracle (cache.refresh baseline recaptured reject) 0 32))
          (lambda () (quote-call full protected.card 10 '(13 13) #f))
          (lambda () (quote-call full-warm protected.card 10 '(13 13) #t))
          (lambda () (service-revision bundle.model policy [] '(quote reserve cancel)))
          (lambda () (service-revision cold-model policy '(quote reserve cancel) []))
          (lambda () (service-revision bundle.model (.cc policy price: 4) '(quote) '(reserve cancel)))
          (lambda () (service-revision cold-model (.cc policy price: 4) '(quote reserve cancel) []))
          (lambda () (service-revision bundle.model (.cc policy invoice: "invoice:2") '(cancel) '(quote reserve)))
          (lambda () (service-revision cold-model (.cc policy invoice: "invoice:2") '(quote reserve cancel) []))
          (lambda () (service-refusal (.cc policy cache-limit: 2)))
          (lambda () (service-refusal (.cc policy forbidden-cancel: #t)))
          (lambda () (contract-oracle (contracts.prepare contract-source policy contract-view contract-execute) '(reserve) '(reserve) #f contract-view))
          (lambda () (let (next (contracts.refresh contract-source prepared-contracts policy contract-view contract-execute))
            (and (contract-oracle next [] [] #t contract-view)
                 (eq? (contracts.family-invoker next 'reserve) (contracts.family-invoker prepared-contracts 'reserve)))))
          (lambda () (contract-oracle (contracts.refresh contract-source prepared-contracts policy larger-view contract-execute) '(reserve) '(reserve) #f larger-view))
          (lambda () (let (next (contracts.refresh contract-source prepared-contracts policy contract-view other-execute))
            (and (contract-oracle next [] '(reserve) #t contract-view)
                 (not (eq? (contracts.family-invoker next 'reserve) (contracts.family-invoker prepared-contracts 'reserve))))))
          (lambda () (contract-release bundle.model policy #f [] '(quote reserve cancel)))
          (lambda () (contract-release contract-cold-model policy #t [] '(quote reserve cancel)))
          (lambda () (contract-release bundle.model (.cc policy price: 4) #f '(quote) '(reserve cancel)))
          (lambda () (contract-release contract-cold-model (.cc policy price: 4) #t '(quote) '(reserve cancel)))
          (lambda () (retain-inputs shared.source prepared-shared))
          (lambda () (retain-inputs shared.independent-source prepared-independent))
          (lambda () (shared-release shared.model shared-old #f #t))
          (lambda () (shared-release independent-model independent-old #f #f))
          (lambda () (shared-release shared.model shared-old #t #t))
          (lambda () (shared-release independent-model independent-old #t #f))
          (lambda () (joint-input #t))
          (lambda () (joint-input #f))
          (lambda () (and (metadata.contract? (shared.construct 'reserve 20))
                          (metadata.contract? (shared.construct 'cancel "invoice:2"))))
          (lambda () (for/fold (valid #t) ((key '(reserve cancel)) (descriptor binding-descriptors))
            (and valid (procedure? (metadata.wrap descriptor
              (lambda (args current) (contract-execute key args current)))))))
          (lambda () (joint-family shared.source prepared-shared))
          (lambda () (joint-family shared.independent-source prepared-independent))
          (lambda () (equal? (family.family-built
            (family.refresh (.@ shared.model generics) (publication.version-family shared-old) joint-policy joint-view)) '(quote reserve cancel)))
          (lambda () (bundle.admit joint-policy joint-candidate shared-old))
          (lambda () (let (view (.call shared.model cook joint-policy (publication.version-cache shared-old)))
            (and (= (.@ view capacity) 20) (equal? (.@ view invoice) "invoice:2"))))
          (lambda () (shared-release shared.selected-model selected-old #f #f))
          (lambda () (shared-release shared.selected-model selected-old #t #f))
          (lambda () (joint-family selected-source prepared-selected))
          (lambda () (equal? (map (cut shared.project-direct <> (shared.shared-input joint-policy joint-view)) '(reserve cancel)) '(20 "invoice:2")))
          (lambda () (eq? (contracts.choose-preparation selected-costs 2) 'direct))
          (lambda () (and (metadata.contract? (unfactored-construct 'reserve 20))
                          (metadata.contract? (unfactored-construct 'cancel "invoice:2"))))
          (lambda () (shared-release unfactored-model unfactored-old #t #t))
          (lambda () (shared-release unfactored-model unfactored-old #f #f))
          (lambda () (workflow-joint shared.workflow-model selected-workflow selected-revision))
          (lambda () (workflow-joint workflow-unfactored unfactored-workflow unfactored-revision))))
  (def expected (append (list '(ok 8 #t) '(ok 8 #t) '(ok 8 #t) #t 'input 'output 'logic #t '(ok 8 #t) #t #t)
                        (make-list 64 #t)))
  (def rows [])
  (for* ((gc '(natural collected)) (round (in-range rounds)) (position (in-range (length phases))))
    (def index (modulo (+ round position) (length phases)))
    (def phase (list-ref phases index))
    (def count (repetitions phase))
    (defvalues (value metrics) (measure (list-ref actions index) count (eq? gc 'collected)))
    (unless (equal? value (list-ref expected index)) (error "metadata phase oracle" phase value))
    (def raw-bytes (vector-ref metrics 4))
    (unless (and (= (vector-ref metrics 3) 0) (>= raw-bytes 0)) (vector-set! metrics 4 #f))
    (set! rows (cons (vector gc round phase count metrics raw-bytes) rows)))
  (unless (equal? identities (source-digests sources)) (error "metadata sources changed"))
  (unless (equal? binary-identity (source-digests (list binary))) (error "metadata binary changed"))
  (write-datum output
    `(metadata-benchmarks (status complete)
       (toolchain ,(gerbil-version-string) ,(system-version-string)) (sources ,@identities) (binary ,@binary-identity)
       (rounds ,rounds) (phases ,@phases)
       (columns gc round phase repetitions #(cpu wall gc-cpu collections bytes-or-false) raw-allocation-delta)
       (notes "Raw/bound/invoke include identical result allocation; bound wrapper prepared outside timed region."
              "Family preparation includes cooking, declarations, contract binding and admission probes."
              "Protected phases include actual C4 dispatch, negative watches, metadata and exact-successor joint admission."
              "Component phases include source capture, scheduling, invalidation and cache preparation; releases include fresh services/contracts/admission."
              "Allocation unavailable across GC or negative counter delta; raw signed delta retained.")
       (rows ,@(reverse rows))))
  (displayln "METADATA-BENCHMARKS-OK rows=" (length rows)))
