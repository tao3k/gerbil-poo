(export main workload)
(import :gerbil/runtime/gambit :std/iter "closure-measure.ss" :clan/poo/closure)

(def (workload family size width seed)
  (let ((equations (make-vector size)))
    (for (index (in-range size))
        (vector-set! equations index
          (cond
            ((= index 0) (if (equal? family "ring")
                           (either (literal seed) (fact (- size 1))) (literal seed)))
            ((equal? family "dense")
             (for/fold (expression (literal #f)) (earlier (in-range index))
               (either expression (fact earlier))))
            ((equal? family "diamond")
             (if (= (modulo index 3) 0) (both (fact (- index 1)) (fact (- index 2)))
               (fact (- index (modulo index 3)))))
            ((equal? family "hubchain")
             (if (= (modulo index 16) 0) (either (fact 0) (fact (- index 1)))
               (fact (- index 1))))
            ((equal? family "bursts")
             (if (= (modulo index 32) 0) (fact (- index 1))
               (fact (- index (modulo index 32)))))
            ((equal? family "skewed")
             (for/fold (expression (literal #f)) (_ (in-range width))
               (either expression (fact (- index 1)))))
            ((equal? family "gated") (both (fact 0) (literal (= (modulo index 2) 0))))
            ((equal? family "quorum")
             (let ((a (fact (- index 1))) (b (fact (- index 1))) (c (fact 0)))
               (either (both a b) (either (both a c) (both b c)))))
            (else (fact (- index 1)))))
        )
    equations))

(def (main queue-text state-text family size-text width-text seed-text repetitions-text (scope "cold"))
  (def queue (string->symbol queue-text))
  (def state (string->symbol state-text))
  (def size (string->number size-text))
  (def width (string->number width-text))
  (def repetitions (string->number repetitions-text))
  (unless (and (exact-integer? size) (> size 0) (exact-integer? width) (> width 0)
               (exact-integer? repetitions) (> repetitions 0) (member seed-text '("true" "false"))
               (member scope '("cold" "warm" "refresh"))) (error "workload parameters"))
  (def seed (equal? seed-text "true"))
  (def source (workload family size width seed))
  (def mode (if (eq? queue 'auto) (if (equal? scope "cold") 'cold 'auto) queue))
  (defvalues (prior setup)
    (if (equal? scope "cold") (values #f #(0 0 0 0 0))
      (measure (lambda () (compile-closure
                 (if (equal? scope "refresh") (workload family size width (not seed)) source) mode)) 1)))
  (def plan #f)
  (defvalues (last costs)
    (measure (lambda ()
               (set! plan (cond ((equal? scope "cold") (compile-closure source mode))
                               ((equal? scope "refresh") (reconfigure-closure prior source)) (else prior)))
               (solve-closure plan queue state)) repetitions))
  (def counts (closure-counts last))
  (def engine (if (eq? queue 'auto) (closure-plan-queue plan) queue))
  (def copies (if (eq? engine 'append) (vector-ref counts 4) (vector-ref counts 13)))
  (def charge (+ (* 4 copies) (* 32 (vector-ref counts 5)) (if (eq? engine 'hybrid) (vector-ref counts 3) 0)))
  (for (index (in-range size))
    (unless (eq? (closure-ref last index) (and seed (or (not (equal? family "gated")) (even? index))))
      (error "independent scalar oracle" index)))
  (unless (and (<= (vector-ref counts 0) (+ size (closure-plan-edges plan))) (<= (vector-ref counts 3) size)
               (= (vector-ref counts 2) (+ (vector-ref counts 7) (vector-ref counts 8) (vector-ref counts 9)))
               (= (vector-ref counts 10) (+ size copies (vector-ref counts 5))))
    (error "primitive/representation model mismatch"))
  (unless (and (<= (vector-ref counts 12) size) (= (vector-ref counts 11) (if (eq? state 'owned) 0 (* size (vector-ref counts 3))))
               (or (eq? engine 'append) (= (vector-ref counts 5) (vector-ref counts 6))))
    (error "publication/peak/frame model mismatch"))
  (when (eq? queue 'auto)
    (unless (and (<= charge (* 4 (closure-plan-edges plan))) (<= charge (* 32 size))
                 (<= charge (closure-plan-hybrid-ceiling plan))) (error "selected ceiling")))
  ;; Case identity and column names are owned by the Scheme driver, once.
  (write (vector
    (vector (vector-ref counts 0) (vector-ref counts 1) (vector-ref counts 2)
            (vector-ref counts 3) (vector-ref counts 4) (closure-plan-edges plan)
            copies (vector-ref counts 5) (vector-ref counts 10)
            (vector-ref counts 14) (vector-ref counts 15) (vector-ref counts 16)
            (+ copies (* 8 (vector-ref counts 5))) engine charge
            (* 4 (closure-plan-edges plan)) (* 32 size) (closure-plan-hybrid-ceiling plan)
            mode (closure-plan-nodes plan) (if (equal? scope "cold") (closure-plan-edges plan) 0)
            (if (equal? scope "warm") 0 (closure-plan-selector-visits plan))
            (if prior (closure-plan-selector-visits prior) 0))
    repetitions costs setup))
  (newline))
