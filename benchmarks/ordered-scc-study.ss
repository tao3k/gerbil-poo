;;; Compiled, fixed-input structural study; ordinary gxtest owns execution.
(export run-ordered-scc-study run-component-stable-study)
(import :std/iter :clan/poo/object
        (prefix-in :clan/poo/strong-components scc.)
        (only-in ./closure-measure measure qualified-metrics))

(def (fixture count shape)
  (def keys (list->vector (for/collect (i (in-range count))
                (string->symbol (string-append "ordered-scc-" (number->string i))))))
  (def middle (quotient count 2))
  (def pivot (vector-ref keys (if (eq? shape 'skew) (1+ middle) middle)))
  (def rows (make-hash-table-symbolic size: count))
  (for (i (in-range count))
    (hash-put! rows (vector-ref keys i)
      (cond ((zero? i) [])
            ((eq? shape 'chain) (list (vector-ref keys (1- i))))
            ((eq? shape 'hub) (list (vector-ref keys (if (<= i middle) 0 middle))))
            ((= i middle) (for/collect (j (in-range middle)) (vector-ref keys j)))
            (else (list (vector-ref keys (if (< i middle) 0 middle)))))))
  (vector (vector->list keys) rows pivot (vector-ref keys (if (eq? shape 'hub) 1 0))))

(def (same-partition? names left right)
  (and (equal? (scc.partition-groups left) (scc.partition-groups right))
       (andmap (lambda (key)
         (and (eq? ((scc.partition-owner left) key) ((scc.partition-owner right) key))
              (equal? ((scc.partition-reads left) key) ((scc.partition-reads right) key))
              (equal? (scc.partition-group-of left key) (scc.partition-group-of right key)))) names)))

(def (run-ordered-scc-study)
  (def all-fast? #t)
  (for* ((count '(100000 1000000)) (shape '(chain hub skew)))
    (let-values (((input input-time) (measure (lambda () (fixture count shape)) 1)))
      (let* ((names (vector-ref input 0)) (rows (vector-ref input 1))
             (pivot (vector-ref input 2)) (authors 0)
             (source (.o keys: names .code: (lambda (key)
                        (set! authors (1+ authors))
                        (let (row (hash-ref rows key []))
                          (and (pair? row) (.o reads: row)))))))
        (let-values (((prior setup) (measure (lambda () (scc.partition-owned source)) 1)))
          (unless (= authors count) (error "cold owner validation count" count shape authors))
          (let* ((before (hash-ref rows pivot)) (provider (vector-ref input 3))
                 (after (append before (list provider)))
                 (patch (list (cons pivot after))))
            (unless (and (not (eq? pivot provider)) (not (memq provider before)))
              (error "ordered SCC fixture did not add a distinct dependency" count shape))
            (hash-put! rows pivot after)
            (set! authors 0)
            (let-values (((cold cold-time) (measure (lambda () (scc.partition-owned source)) 1)))
              (unless (= authors count) (error "edited cold validation count" count shape authors))
              (displayln (list 'ORDERED-SCC-PREPARE count shape
                'input (qualified-metrics input-time) 'prior (qualified-metrics setup)
                'cold-next (qualified-metrics cold-time) 'cold-authors authors))
              (set! authors 0)
              (for (round (in-range 4))
                (let-values (((next timing) (measure (lambda () (scc.revise-partition prior patch)) 1)))
                  (unless (= authors 0) (error "incremental SCC called an author" count shape authors))
                  (unless (equal? ((scc.partition-reads prior) pivot) before)
                    (error "incremental SCC changed old snapshot" count shape))
                  (when (zero? round)
                    ;; Charge complete equivalence/output separately from update.
                    (let-values (((same output-time)
                                  (measure (lambda () (same-partition? names next cold)) 1)))
                      (unless same (error "ordered SCC cold/incremental mismatch" count shape))
                      (displayln (list 'ORDERED-SCC-OUTPUT count shape (qualified-metrics output-time)))))
                  (let* ((work (scc.partition-work next))
                         (direction (and (.slot? work 'retained-direction)
                                         (.get work retained-direction))))
                    (unless direction (set! all-fast? #f))
                    (when direction
                      (for (field '(forward-buckets reverse-buckets forward-edges reverse-edges
                                    region-owners region-edge-visits owner-writes member-writes rebased-owners))
                        (unless (= (.ref work field) 0)
                          (error "certified SCC edit traversed old support" count shape field)))
                      (unless (= (.get work rank-checks) (length after))
                        (error "rank admission omitted replacement edges" count shape)))
                    (displayln (list 'ORDERED-SCC-UPDATE count shape round
                      'authors authors 'metrics (qualified-metrics timing)
                      'direction direction
                      'rank-checks (and direction (.get work rank-checks))
                      'work (for/collect (field '(edited-rows changed-rows forward-buckets forward-edges
                                   reverse-buckets reverse-edges reverse-writes reverse-removals
                                   reverse-rewrite-edges region-owners region-edge-visits owner-writes
                                   member-writes rebased-owners quotient-reader-edges))
                              (cons field (.ref work field))))))))
              (let-values (((size warm) (measure (lambda () (scc.partition-group-size prior pivot)) 1000)))
                (unless (= size 1) (error "ordered SCC warm membership" count shape size))
                (displayln (list 'ORDERED-SCC-WARM count shape 'queries 1000 (qualified-metrics warm))))))))))
  ;; An old implementation still records the COMPLETE matched matrix, then
  ;; fails the missing work contract; no failed observation is dropped.
  (unless all-fast? (error "ordered SCC edits did not reuse admitted directions"))
  (displayln "ORDERED-SCC-OK cases=6 updates=24"))

;; Unlike the ordered DAG study, every vertex here belongs to one giant SCC.
;; Full output is linear: never copy a million-member group once per vertex.
(def (run-component-stable-study)
  (def all-fast? #t)
  (for* ((count '(100000 1000000)) (shape '(cycle hub)))
    (defvalues (fixture setup)
      (measure (lambda ()
        (def names (list->vector (for/collect (i (in-range count))
          (string->symbol (string-append "stable-scc-" (symbol->string shape) "-" (number->string i))))))
        (def rows (make-hash-table-symbolic size: count))
        (for (i (in-range count))
          (hash-put! rows (vector-ref names i)
            (if (eq? shape 'cycle)
              (list (vector-ref names (if (= i (1- count)) 0 (1+ i))))
              (if (zero? i) (cdr (vector->list names)) (list (vector-ref names 0))))))
        (vector (vector->list names) rows (vector-ref names (quotient count 2))
          (vector-ref names (if (eq? shape 'cycle) 0 (1+ (quotient count 2)))))) 1))
    (def names (vector-ref fixture 0))
    (def rows (vector-ref fixture 1))
    (def pivot (vector-ref fixture 2))
    (def authors 0)
    (def source (.o keys: names .code: (lambda (key)
      (set! authors (1+ authors)) (.o reads: (hash-ref rows key)))))
    (defvalues (prior cold) (measure (lambda () (scc.partition-owned source)) 1))
    (unless (= authors count) (error "stable SCC cold author count" count shape authors))
    (def before (hash-ref rows pivot))
    (def after (append before (list (vector-ref fixture 3))))
    (hash-put! rows pivot after)
    (set! authors 0)
    (defvalues (expected cold-next) (measure (lambda () (scc.partition-owned source)) 1))
    (unless (= authors count) (error "stable SCC successor author count" count shape authors))
    (displayln (list 'STABLE-SCC-PREPARE count shape 'fixture (qualified-metrics setup)
      'prior (qualified-metrics cold) 'cold-next (qualified-metrics cold-next)))
    (set! authors 0)
    (for (round (in-range 4))
      (defvalues (next timing)
        (measure (lambda () (scc.revise-partition prior (list (cons pivot after)))) 1))
      (when (zero? round)
        (let ()
        (defvalues (same output)
          (measure (lambda ()
            (and (equal? (scc.partition-groups next) (scc.partition-groups expected))
              (andmap (lambda (key)
                (and (eq? ((scc.partition-owner next) key) ((scc.partition-owner expected) key))
                     (equal? ((scc.partition-reads next) key) ((scc.partition-reads expected) key)))) names))) 1))
        (unless same (error "stable SCC cold/incremental mismatch" count shape))
        (displayln (list 'STABLE-SCC-OUTPUT count shape (qualified-metrics output)))))
      (unless (and (zero? authors) (equal? ((scc.partition-reads prior) pivot) before)
                   (= (scc.partition-group-size next pivot) count))
        (error "stable SCC update changed old snapshot or invoked author" count shape))
      (def work (scc.partition-work next))
      (def retained (and (.slot? work 'retained-components) (.get work retained-components)))
      (unless retained (set! all-fast? #f))
      (when retained
        (for (field '(forward-buckets reverse-buckets forward-edges reverse-edges
                      region-owners region-edge-visits owner-writes member-writes rebased-owners))
          (unless (zero? (.ref work field)) (error "stable SCC traversed old support" count shape field)))
        (unless (= (.get work component-checks) 1) (error "stable SCC edge classification count")))
      (displayln (list 'STABLE-SCC-UPDATE count shape round (qualified-metrics timing)
        'retained retained 'authors authors 'work
        (for/collect (field '(edited-rows changed-rows forward-buckets reverse-buckets region-owners
                             region-edge-visits owner-writes member-writes reverse-writes))
          (cons field (.ref work field)))))
      (force-output)))
  (unless all-fast? (error "stable SCC edits did not retain certified components"))
  (displayln "STABLE-SCC-OK cases=4 updates=16"))
