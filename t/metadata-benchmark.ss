;;; Bound wrappers, refusals and cooked-family preparation, measured by Scheme.
(export main sources phases rounds repetitions)
(import :gerbil/runtime/gambit :std/iter (only-in ../object .cc .@) ../support/option (only-in :std/values first-value)
        "closure-measure.ss"
        (prefix-in ../declarative-metadata metadata.)
        (prefix-in ../examples/service-metadata service.)
        (prefix-in ../examples/cyclic-access access.)
        (prefix-in ../cyclic-publication publication.)
        (prefix-in ../examples/service-bundle bundle.)
        (prefix-in ../examples/protected-dispatch protected.)
        (prefix-in ../generic-family family.) (prefix-in ../staged-publication staged.)
        (prefix-in ../multimethod multimethod.)
        (prefix-in ../dispatch-extension dispatch.)
        (prefix-in ../construction-cache cache.) (prefix-in ../generalized-graph graph.)
        (prefix-in ../dependency-analysis code.) (prefix-in ../examples/construction-workflow workflow.))
(def sources '("dependency-analysis.ss" "generalized-graph.ss" "construction-cache.ss" "declarative-metadata.ss" "generic-family.ss" "staged-publication.ss" "cyclic-publication.ss" "dispatch-extension.ss" "multimethod.ss"
               "closure.ss" "object.ss" "mop.ss" "type.ss" "number.ss" "justfile"
               "examples/construction-workflow.ss" "examples/service-metadata.ss" "examples/service-bundle.ss" "examples/protected-dispatch.ss" "examples/cyclic-access.ss"
               "t/closure-measure.ss" "t/metadata-benchmark.ss" "t/metadata-report.ss"))
(def phases '(raw bound invoke wrap-build input-refuse output-refuse logic-refuse family-build family-warm revise refused-revise
              protected-build protected-cold protected-warm guarded-low guarded-high protected-refuse protected-cancelled metadata-refuse call-refuse
              component-start component-refresh component-reuse component-root component-presence
              selective-release policy-release selective-negative-refuse selective-admission-refuse
              schedule-full schedule-retained component-recapture protected-full-cold protected-full-warm
              service-reuse service-cold service-price service-price-cold service-invoice service-invoice-cold
              service-budget-refuse service-negative-refuse))
(def rounds 4)
(def (repetitions phase)
  (cond ((memq phase '(family-build revise refused-revise protected-build protected-refuse protected-cancelled metadata-refuse
                         component-start component-refresh component-reuse component-root component-presence
                         selective-release policy-release selective-negative-refuse selective-admission-refuse
                         schedule-full schedule-retained component-recapture
                         service-reuse service-cold service-price service-price-cold service-invoice service-invoice-cold
                         service-budget-refuse service-negative-refuse)) 8)
        ((memq phase '(protected-cold protected-warm guarded-low guarded-high call-refuse protected-full-cold protected-full-warm)) 512)
        (else 4000)))
(def (main output binary)
  (write-datum output '(metadata-benchmarks (status incomplete)))
  (def identities (source-digests sources))
  (def binary-identity (source-digests (list binary)))
  (def config (access.config))
  (def contract (service.reservation 10))
  (def (raw args) (values (list 'ok (- 10 (car args)) #t) 'state))
  (def bound (metadata.wrap contract raw))
  (def (failure-phase execute args)
    (defvalues (value state issue) (metadata.publish contract 'old execute args))
    (unless (and (not value) (eq? state 'old) (metadata.failure? issue)) (error "refusal oracle"))
    (metadata.failure-phase issue))
  (defvalues (old issue) (service.start config #t 10 3 "invoice:1" 10))
  (when issue (error "family refused" issue))
  (defvalues (value warm) (publication.invoke old 'reserve 2))
  (unless (equal? value '(ok 8 #t)) (error "family oracle"))
  (def (revision available price)
    (defvalues (next issue) (service.revise warm config #t available price "invoice:2" 10))
    (if issue (and (eq? next warm) (eq? (publication.failure-stage issue) 'admission))
      (equal? (first-value (publication.invoke next 'reserve 12)) '(ok 8 #t))))
  (def policy (.cc bundle.Policy. capacity: 10 price: 3 invoice: "invoice:1"))
  (defvalues (composed composed-issue) (bundle.start policy))
  (when composed-issue (error "protected family baseline" composed-issue))
  (defvalues (quote-result composed-warm) (publication.invoke composed 'quote protected.invoice protected.card 10))
  (unless (equal? quote-result '(13 13)) (error "protected quote oracle"))
  (defvalues (low bank-warm) (publication.invoke composed-warm 'quote protected.invoice protected.bank 10))
  (unless (null? low) (error "guarded baseline"))
  (defvalues (limited limited-issue) (bundle.start (.cc policy cache-limit: 1)))
  (when limited-issue (error "limited baseline"))
  (defvalues (_ limited-warm) (publication.invoke limited 'quote protected.invoice protected.card 10))
  ;; Matched control retains full joint admission, with identical service code.
  (defvalues (full full-issue)
    (staged.prepare (.cc bundle.model .readmit: bundle.admit) (access.equations config #t) policy))
  (when full-issue (error "full admission control refused"))
  (defvalues (full-value full-warm) (publication.invoke full 'quote protected.invoice protected.card 10))
  (def (quote-call current channel amount expected same?)
    (defvalues (result next) (publication.invoke current 'quote protected.invoice channel amount))
    (and (equal? result expected) (eq? (eq? next current) same?)))
  (def (refuse-revision changed stage)
    (defvalues (retained issue) (bundle.revise composed-warm changed))
    (and (eq? retained composed-warm) (publication.failure? issue)
         (if (eq? stage 'negative)
           (and (eq? (publication.failure-stage issue) 'services)
                (eq? (family.failure-stage (publication.failure-cause issue)) 'negative))
           (eq? (publication.failure-stage issue) stage))))
  (defvalues (settled settlement-issue) (workflow.start (workflow.graph 30) policy))
  (when settlement-issue (error "selective baseline" settlement-issue))
  (defvalues (initial-reservation settlement-warm) (publication.invoke settled 'reserve 2))
  (def baseline (publication.version-cache settlement-warm))
  (def source (cache.cache-source baseline))
  (def changed (graph.define source 'invoice (code.need 'settlement (cut + <> 9))))
  (def prior-schedule (graph.schedule source))
  (def expected-order (graph.schedule-order prior-schedule))
  ;; Equal immutable fields, different source identity: forces capture/scan.
  (def recaptured (.cc source))
  (def allowed (.cc cache.Builder. allow: (cut memq <> '(invoice release total))))
  (def reject (.cc cache.Builder. allow: (lambda (_) #f)))
  (def (cache-oracle next count total)
    (and (= (length (cache.cache-evaluated next)) count)
         (= (+ count (length (cache.cache-reused next))) 15)
         (= (workflow.value next 'total) total)))
  (def (selective changed policy builder expected-stage)
    (defvalues (next issue) (workflow.revise settlement-warm changed policy builder))
    (if expected-stage
      (and (eq? next settlement-warm) issue (eq? (publication.failure-stage issue) expected-stage)
           (= (multimethod.cache-size (dispatch.snapshot (publication.version-service next 'reserve))) 1))
      (and (not issue) (cache-oracle (publication.version-cache next) 3 41)
           (equal? (first-value (publication.invoke next 'reserve 2)) '(ok 39 #t)))))
  (defvalues (reserve-value service-held) (publication.invoke composed-warm 'reserve 2))
  (defvalues (cancel-value service-warm) (publication.invoke service-held 'cancel "customer" #t))
  (unless (and (equal? reserve-value '(ok 8 #t)) (equal? cancel-value '("customer" "invoice:1")))
    (error "warm service baseline"))
  (def generics (.@ bundle.model generics))
  (def cold-model
    (.cc bundle.model
      generics: (.cc generics .refresh: (lambda (_ policy view) (family.prepare generics policy view)))
      .admit-refresh: (lambda (_ policy candidate) (bundle.admit policy candidate))))
  (def (service-revision model changed expected expected-reused)
    (defvalues (next issue) (staged.publish model service-warm (access.equations config #t) changed))
    (and (not issue)
      (equal? (family.family-built (publication.version-family next)) expected)
      (equal? (family.family-reused (publication.version-family next)) expected-reused)
      (andmap (lambda (key) (eq? (publication.version-service next key) (publication.version-service service-warm key))) expected-reused)
      (equal? (first-value (publication.invoke next 'quote protected.invoice protected.card 10)) (list 13 (+ 10 (.@ changed price))))
      (equal? (first-value (publication.invoke next 'reserve 2)) (list 'ok (- (.@ changed capacity) 2) #t))
      (equal? (first-value (publication.invoke next 'cancel "customer" #t)) (list "customer" (.@ changed invoice)))))
  (def (service-refusal changed)
    (defvalues (retained issue) (bundle.revise service-warm changed))
    (and issue (eq? retained service-warm)
      (equal? (map (lambda (key) (multimethod.cache-size (dispatch.snapshot (publication.version-service retained key))))
                   '(quote reserve cancel)) '(1 1 1))))
  (def actions
    (list (lambda () (first-value (raw '(2))))
          (lambda () (first-value (bound '(2))))
          (lambda () (first-value (metadata.invoke contract raw '(2))))
          (lambda () (procedure? (metadata.wrap contract raw)))
          (lambda () (failure-phase raw '(0)))
          (lambda () (failure-phase raw '(11)))
          (lambda () (failure-phase (lambda (_) (values '(ok 9 #t) 'state)) '(2)))
          (lambda () (let-values (((next issue) (service.start config #t 10 3 "invoice:1" 10)))
                       (and (not issue) (publication.version? next))))
          (lambda () (first-value (publication.invoke warm 'reserve 2)))
          (lambda () (revision 20 4))
          (lambda () (revision 20 8))
          (lambda () (let-values (((next issue) (bundle.start policy))) (and (not issue) (publication.version? next))))
          (lambda () (quote-call composed protected.card 10 '(13 13) #f))
          (lambda () (quote-call composed-warm protected.card 10 '(13 13) #t))
          (lambda () (quote-call bank-warm protected.bank 10 [] #t))
          (lambda () (quote-call bank-warm protected.bank 150 '(160) #t))
          (lambda () (refuse-revision (.cc policy forbidden-quote: #t) 'negative))
          (lambda ()
            (defvalues (next issue) (bundle.revise composed-warm (.cc policy forbidden-quote: #t cancelled-extension: #t)))
            (and (not issue) (quote-call next protected.bank 150 '(160) #f)))
          (lambda () (refuse-revision (.cc policy reserve-shift: 1) 'admission))
          (lambda ()
            (try
              (let-values (((value next) (publication.invoke limited-warm 'reserve 2))) #f)
              (catch (cause)
                (and (publication.failure? cause) (eq? (publication.failure-stage cause) 'admission)
                     (= (multimethod.cache-size (dispatch.snapshot (publication.version-service limited-warm 'reserve))) 0)))))
          (lambda () (cache-oracle (cache.start source) 15 32))
          (lambda () (cache-oracle (cache.refresh baseline changed allowed) 3 41))
          (lambda () (cache-oracle (cache.refresh baseline source reject) 0 32))
          (lambda () (cache-oracle (cache.refresh baseline (graph.set-base source 'input (some (code.make-success 60)))) 11 58))
          (lambda () (cache-oracle (cache.refresh baseline (graph.set-base source 'discount (some (code.make-success 5)))) 6 37))
          (lambda () (selective changed policy allowed #f))
          (lambda ()
            (defvalues (next issue) (workflow.revise settlement-warm source (.cc policy price: 4) reject))
            (and (not issue) (cache-oracle (publication.version-cache next) 0 32)
                 (equal? (first-value (publication.invoke next 'quote protected.invoice protected.card 10)) '(13 14))))
          (lambda () (selective changed (.cc policy forbidden-cancel: #t) allowed 'services))
          (lambda () (selective changed (.cc policy reserve-shift: 1) allowed 'admission))
          (lambda () (equal? (graph.schedule-order (graph.schedule changed)) expected-order))
          (lambda () (equal? (graph.schedule-order (graph.reschedule prior-schedule changed)) expected-order))
          (lambda () (cache-oracle (cache.refresh baseline recaptured reject) 0 32))
          (lambda () (quote-call full protected.card 10 '(13 13) #f))
          (lambda () (quote-call full-warm protected.card 10 '(13 13) #t))
          (lambda () (service-revision bundle.model policy [] '(quote reserve cancel)))
          (lambda () (service-revision cold-model policy '(quote reserve cancel) []))
          (lambda () (service-revision bundle.model (.cc policy price: 4) '(quote) '(reserve cancel)))
          (lambda () (service-revision cold-model (.cc policy price: 4) '(quote reserve cancel) []))
          (lambda () (service-revision bundle.model (.cc policy invoice: "invoice:2") '(cancel) '(quote reserve)))
          (lambda () (service-revision cold-model (.cc policy invoice: "invoice:2") '(quote reserve cancel) []))
          (lambda () (service-refusal (.cc policy cache-limit: 2)))
          (lambda () (service-refusal (.cc policy forbidden-cancel: #t)))))
  (def expected (append (list '(ok 8 #t) '(ok 8 #t) '(ok 8 #t) #t 'input 'output 'logic #t '(ok 8 #t) #t #t)
                        (make-list 31 #t)))
  (def rows [])
  (for* ((gc '(natural collected)) (round (in-range rounds)) (position (in-range (length phases))))
    (def index (modulo (+ round position) (length phases)))
    (def phase (list-ref phases index))
    (def count (repetitions phase))
    (defvalues (value metrics) (measure (list-ref actions index) count (eq? gc 'collected)))
    (unless (equal? value (list-ref expected index)) (error "metadata phase oracle" phase value))
    (def raw-bytes (vector-ref metrics 4))
    (unless (and (= (vector-ref metrics 3) 0) (>= raw-bytes 0)) (vector-set! metrics 4 #f))
    (set! rows (cons (vector gc round phase count metrics raw-bytes) rows)))
  (unless (equal? identities (source-digests sources)) (error "metadata sources changed"))
  (unless (equal? binary-identity (source-digests (list binary))) (error "metadata binary changed"))
  (write-datum output
    `(metadata-benchmarks (status complete)
       (toolchain ,(gerbil-version-string) ,(system-version-string)) (sources ,@identities) (binary ,@binary-identity)
       (rounds ,rounds) (phases ,@phases)
       (columns gc round phase repetitions #(cpu wall gc-cpu collections bytes-or-false) raw-allocation-delta)
       (notes "Raw/bound/invoke include identical result allocation; bound wrapper prepared outside timed region."
              "Family preparation includes cooking, declarations, contract binding and admission probes."
              "Protected phases include actual C4 dispatch, negative watches, metadata and exact-successor joint admission."
              "Component phases include source capture, scheduling, invalidation and cache preparation; releases include fresh services/contracts/admission."
              "Allocation unavailable across GC or negative counter delta; raw signed delta retained.")
       (rows ,@(reverse rows))))
  (displayln "METADATA-BENCHMARKS-OK rows=" (length rows)))
