;;; Snapshot-guarded requests over actual SCC revisions and effect evidence.
(export recursive-staging-test)
(import :std/test ../object ../mop ../number (only-in ../type Record)
        (prefix-in ../recursive-validation graph.)
        (prefix-in ../recursive-staging staging.)
        (prefix-in ../recursive-topology topology.)
        (prefix-in ../examples/recursive-topology service.)
        (prefix-in ../examples/recursive-staging workflow.)
        (prefix-in ../examples/recursive-migration migration.)
        (prefix-in ../declarative-metadata metadata.)
        (prefix-in ../examples/contract-publication publication.))

;; Require the lifecycle phase so an unrelated callback error cannot pass a test.
(def (phase? expected)
  (lambda (cause) (and (graph.validation-failure? cause)
    (eq? expected (graph.validation-failure-kind cause)))))

;; Independent invocation policy retains the existing exact bound-evidence gate.
(def Call (metadata.contract (metadata.predicate "object" object?)
  (metadata.predicate "evidence" object?) (lambda (_ _request _result) #t) metadata.truth))

;; Interleave independently staged requests, then retry only against current heads.
(def recursive-staging-test
  (test-suite "staged recursive graph revisions"
    (test-case "competing rounds merge split migrate refuse and re-stage"
      (def first (service.initial))
      (def first-root (graph.closed-ref first 'report))
      (def first-type (graph.closed-type first 'report))
      (def idle (graph.closed-ref first 'idle))
      (def idle-type (graph.closed-type first 'idle))
      (def all-primary (make-vector 8 'primary))
      (def mixed '#(secondary secondary secondary secondary primary primary primary primary))
      (def all-secondary (make-vector 8 'secondary))
      (def merge (workflow.stage-transition first service.merged mixed 'notify [service.secondary] []))
      (def loser (workflow.stage-transition first service.original all-primary 'delivery [] [] []))
      ;; Staging neither retires nor replaces the current canonical graph.
      (check (eq? first-root (validate first-type first-root)) => #t)
      (defvalues (merged evidence state refusal)
        ((workflow.publication-action merge 108 service.merged mixed 'notify Call (.o commits: 0)) first))
      (check refusal => #f)
      (check-equal? (.get evidence total) 108)
      (check-equal? (.get state commits) 1)
      (check-exception (loser merged) (phase? 'stale))
      (check-exception (merge merged) (phase? 'stale))
      (check-exception (validate first-type first-root) (phase? 'stale))
      (def split (workflow.stage-transition merged service.split all-secondary 'auth [] '(primary)))
      (def merged-loser (workflow.stage-transition merged service.merged mixed 'cache [] [] []))
      (def second (split merged))
      (check-equal? (.get (graph.closed-ref second 'report) total) 128)
      (check-exception (merged-loser second) (phase? 'stale))
      (check-exception (loser second) (phase? 'stale))
      (def before (topology.partition second))
      (def root (graph.closed-ref second 'report))
      (def root-type (graph.closed-type second 'report))
      (def failed (workflow.stage-transition second service.crossed all-secondary 'cache [] []
        '(billing ledger notify delivery) #f))
      (def sibling (workflow.stage-transition second service.original all-secondary 'ingress [] []))
      (check-exception (failed second) (phase? 'admission))
      (check (eq? root (validate root-type root)) => #t)
      (check-equal? (topology.changed-members before (topology.partition second)) [])
      (def retry (workflow.stage-transition second service.crossed all-secondary 'cache [] []
        '(billing ledger notify delivery)))
      (def third (retry second))
      (check-equal? (.get (graph.closed-ref third 'report) total) 132)
      (check-exception (sibling third) (phase? 'stale))
      (check-exception (failed third) (phase? 'stale))
      (check-exception (validate root-type root) (phase? 'stale))
      (def restored ((workflow.stage-transition third service.original all-secondary 'ingress [] []) third))
      (check-equal? (.get (graph.closed-ref restored 'report) total) 127)
      (check-exception (loser restored) (phase? 'stale))
      (def computed (workflow.stage-transition restored service.original all-secondary 'delivery [] [] []))
      (def obsolete (workflow.stage-transition restored service.original all-secondary 'auth [] [] []))
      (def fourth (computed restored))
      (check-equal? (graph.closed-evaluated fourth) '(summary report meter))
      (check-equal? (.get (graph.closed-ref fourth 'report) total) 134)
      (check-exception (obsolete fourth) (phase? 'stale))
      (def fifth ((staging.stage-reconfiguration fourth [] []
        (service.peer-recipes service.original all-secondary 3 '(ingress))) fourth))
      (check-equal? (graph.closed-evaluated fifth) '(ingress auth report meter))
      (check (eq? idle (validate idle-type idle)) => #t)
      (check-exception (loser fifth) (phase? 'stale))
      (def context-value (.o commits: 5))
      (def descriptor (service.envelope fifth 135 service.original all-secondary 'delivery))
      (def bad-evidence (publication.publication-action descriptor Call context-value
        (lambda (checked) (values (.o subject: checked descriptor: descriptor context: (.o commits: 4))
          (.o commits: 6)))))
      (defvalues (_ kept rejected) (bad-evidence (.o report: (graph.closed-ref fifth 'report))))
      (check (eq? kept context-value) => #t)
      (check-equal? (metadata.failure-phase rejected) 'logic)
      (defvalues (accepted next-state final-refusal)
        ((service.publish-action fifth 135 service.original all-secondary 'delivery Call context-value)
          (.o report: (graph.closed-ref fifth 'report))))
      (check final-refusal => #f)
      (check-equal? (.get accepted total) 135)
      (check-equal? (.get next-state commits) 6))
    (test-case "proposed watch drift refuses before builder and fresh staging retries"
      (def current (service.initial)) (def settings (.o value: 1)) (def calls 0)
      (def added (graph.validation-node 'settings [] [settings] (lambda (_reference _source)
        (set! calls (+ calls 1)) (list (Record value: [Integer]) (.o value: (.get settings value))))))
      (def request (staging.stage-reconfiguration current [added] [] []))
      (check-equal? calls 0)
      (.put! settings 'value 2)
      (check-exception (request current) (phase? 'stale))
      (check-equal? calls 0)
      (def next ((staging.stage-reconfiguration current [added] [] []) current))
      (check-equal? calls 1)
      (check-equal? (.get (graph.closed-ref next 'settings) value) 2))
    (test-case "stale sibling refuses even when all canonical nodes survive"
      (def calls 0)
      (def recipe (graph.validation-node 'root [] [] (lambda (_reference _source)
        (set! calls (+ calls 1)) (list (Record value: [Integer]) (.o value: 1)))))
      (def first (graph.revise-validation #f [recipe]))
      (def node (graph.closed-ref first 'root)) (def type (graph.closed-type first 'root))
      (def request (staging.stage-reconfiguration first [] [] []))
      (def sibling (staging.stage-reconfiguration first [] [] []))
      (def next (request first))
      (check (eq? node (validate type node)) => #t)
      (check-exception (sibling next) (phase? 'stale))
      (check-equal? calls 1))
    (test-case "effect refusal returns installed graph and preserves effect context"
      (def current (service.initial))
      (def context-value (.o commits: 0))
      (def refusing (metadata.contract (metadata.predicate "object" object?)
        (metadata.predicate "evidence" object?) (lambda (_ _request _result) #f) (metadata.atom 'policy)))
      (def request (workflow.stage-transition current service.original (make-vector 8 'primary) 'delivery [] [] []))
      (defvalues (installed _ kept refusal)
        ((workflow.publication-action request 89 service.original (make-vector 8 'primary)
          'delivery refusing context-value) current))
      (check (eq? kept context-value) => #t)
      (check-equal? (metadata.failure-phase refusal) 'logic)
      (check-equal? (.get (graph.closed-ref installed 'report) total) 89)
      (check-exception (request installed) (phase? 'stale)))
    (test-case "edit list spines are captured before caller mutation"
      (def current (service.initial)) (def edits [(migration.summary 'delivery)])
      (def request (staging.stage-reconfiguration current [] [] edits))
      (set-car! edits (migration.summary 'auth))
      (def next (request current))
      (check (eq? (.get (graph.closed-ref next 'summary) reader) (graph.closed-ref next 'delivery)) => #t))))
