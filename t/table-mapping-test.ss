      (def state (.call protocol .ap root)) (set! calls 0)
      (def delta (.call raw .diff root (.call raw .remove root 1)))
      (check-exception (.call protocol .apply-delta state delta) TypeError?)
      (check-equal? calls 0)
      (check (eq? root (.call protocol .unap state)) => #t))
    (test-case "warm projection shares entry admission without reconstruction or callback shell leaks"
      (def source (RationalDict Integer)) (def callback (Fun Integer <- Integer))
      (def f (validate callback (lambda (n) (+ n 1))))
      (def raw (SimpleTrie UInt callback)) (def builds 0)
      (def target (.cc raw .<-list: (lambda (rows)
        (set! builds (+ builds 1)) (.call raw .<-list rows))))
      (def row (cons 0 f)) (def box (some row)) (def invalid? #f)
      (def protocol (table-projection source target (lambda (k v)
        (when (= v 77) (.set! source sexp 'during-callback))
        (set-car! row (+ k v)) (if invalid? 'bad-option box))))
      (def root (.call source .<-list '((1 . 10) (2 . 20))))
      (def state (.call protocol .ap root))
      (def final (.call source .<-list '((1 . 30) (2 . 40))))
      (def delta (.call source .diff root final)) (set! invalid? #t)
      (check-exception (.call protocol .apply-delta state delta) (message? "table update must return Option"))
      (set! invalid? #f)
      (def next (.call protocol .apply-delta state delta))
      (set-car! row 999) (some-value-set! box #f)
      (check-equal? builds 1)
      (check-equal? (map car (.call target .list<- (.call protocol .get next))) '(31 42))
      (check (eq? (.call target .ref (.call protocol .get next) 31) f) => #t)
      (check (eq? (.call target .ref (.call protocol .get state) 11) f) => #t)
      (check-exception (.call protocol .apply-delta state
        (.call source .diff root (.call source .acons 1 77 root))) Error?)
      (check (eq? root (.call protocol .unap state)) => #t))
    (test-case "entry projections change child Types and retain false without a source write"
      (for (source (list (RationalDict Integer) (SimpleTrie UInt Integer)))
        (def target (SimpleTrie UInt Bool))
