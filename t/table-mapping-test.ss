;;; Key-preserving bulk maps retain snapshot order, types and ownership.
(export table-mapping-test)
(import :std/test :std/error :std/iter (only-in ../brace @@method)
        ../object ../mop ../type ../number ../table ../rationaldict ../support/option
        (only-in ../trie SimpleTrie) (only-in ./table-wrapper-test box-table) (only-in ./table-validation-test alist-table)
        (prefix-in ../examples/service-collection service.))

;; Keep protocol refusals separate from arbitrary callback exceptions.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; Compare both backends with an independent original-row oracle and all styles.
(def table-mapping-test
  (test-suite "checked bulk binding maps"
    (test-case "lookup join repairs shared right dependents without projecting unrelated rows and retains stored false"
      (for (trie? '(#f #t))
        (def left ((if trie? (lambda (v) (SimpleTrie UInt v)) RationalDict) UInt))
        (def right ((if trie? (lambda (v) (SimpleTrie UInt v)) RationalDict) Bool))
        (def raw (SimpleTrie UInt Bool))
        (def target (.cc raw .diff: (lambda args (error "unexpected lookup target diff"))))
        (def warm? #f) (def calls 0)
        (def join (table-lookup-join left right target (lambda (_key row) row)
          (lambda (key _row found)
            (when (and warm? (= key 9)) (error "unrelated lookup projected"))
            (set! calls (+ calls 1)) (and (some? found) (some (cons key (some-value found)))))))
        (def l (.call left .<-list '((1 . 10) (2 . 10) (3 . 30) (9 . 90))))
        (def r (.call right .<-list '((10 . #f) (90 . #t))))
        (def input (cons l r))
        (def state (.call join .ap input))
        (set-car! input (.@ left .empty))
        (check-equal? (.call target .ref/opt (.call join .get state) 1) (some #f))
        (check (.call target .key? (.call join .get state) 3) => #f)
        ;; A supplied fallback retains missing left rows, using the same lookup
        ;; engine and presence boundary rather than a separate outer-join wrapper.
        (def outer (table-lookup-join left right target (lambda (_key row) row)
          (lambda (key _row found) (some (cons key (not (some? found)))))))
        (check-equal? (.call target .list<- (.call outer .get (.call outer .ap (cons l r))))
          '((1 . #f) (2 . #f) (3 . #t) (9 . #f)))
        (set! warm? #t)
        (def dr (.call right .delta/opt 10 (lambda (_) (some #t)) r))
        (let (prior calls)
          (defvalues (next output) (.call join .apply-deltas state (.call left .diff l l) dr values))
          (check-equal? (- calls prior) 2)
          (check-equal? (.call target .list<- (.call join .get next)) '((1 . #t) (2 . #t) (9 . #t)))
          (check-equal? (.call target .ref/opt (.call join .get state) 1) (some #f))
          (def pair (.call join .unap next)) (set-cdr! pair (.@ right .empty))
          (check (.call right .key? (cdr (.call join .unap next)) 10) => #t)
          (check-equal? (.call target .list<- (.call target .apply-delta (.call join .get state) output))
            (.call target .list<- (.call join .get next)))
          (def restored (.call join .apply-deltas next (.call left .diff l l) (invert-table-delta dr)))
          (check-equal? (.call target .list<- (.call join .get restored))
            (.call target .list<- (.call join .get state))))))
    (test-case "joint lookup revisions match a full oracle across insertion deletion and shared-key migration"
      (def left (SimpleTrie UInt UInt)) (def right (SimpleTrie UInt Integer))
      (def target (SimpleTrie UInt Integer))
      (def join (table-lookup-join left right target (lambda (_key row) row)
        (lambda (key _row found) (and (some? found) (some (cons key (some-value found)))))))
      (def state (.call join .ap (cons (.@ left .empty) (.@ right .empty))))
      (for (round (in-range 24))
        (def old (.call join .unap state))
        (def l (.call left .acons (modulo round 6) (modulo round 4) (car old)))
        (def r (if (= (modulo round 3) 2) (.call right .remove (cdr old) (modulo round 4))
          (.call right .acons (modulo round 4) (- round 10) (cdr old))))
        (defvalues (next output) (.call join .apply-deltas state
          (.call left .diff (car old) l) (.call right .diff (cdr old) r) values))
        (def expected (.call target .<-list
          (filter-map (lambda (entry)
            (def found (.call right .ref/opt r (cdr entry)))
            (and (some? found) (cons (car entry) (some-value found)))) (.call left .list<- l))))
        (check (.call target .=? (.call join .get next) expected) => #t)
        (check (.call target .=? (.call target .apply-delta (.call join .get state) output) expected) => #t)
        (set! state next)))
    (test-case "both lookup sources admit before classification and right conflicts suppress all projection"
      (def left (SimpleTrie UInt UInt)) (def right (SimpleTrie UInt Integer))
      (def calls 0)
      (def join (table-lookup-join left right right
        (lambda (_key row) (set! calls (+ calls 1)) row)
        (lambda (key _row found) (set! calls (+ calls 1)) (and (some? found) (some (cons key (some-value found)))))))
      (def l (.call left .<-list '((1 . 10)))) (def r (.call right .<-list '((10 . 7))))
      (def state (.call join .ap (cons l r)))
      (def stale (.call right .delta/opt 10 (lambda (_) (some 8)) (.call right .acons 10 6 r)))
      (let (prior calls)
        (check-exception (.call join .apply-deltas state
          (.call left .delta/opt 2 (lambda (_) (some 10)) l) stale) table-conflict?)
        (check-equal? calls prior))
      (check-equal? (.call left .list<- (car (.call join .unap state))) '((1 . 10)))
      (def refined (.cc right .element?: (lambda (root)
        (and (element? right root) (= (.call right .count root) 1)))))
      (def guarded (table-lookup-join left refined right
        (lambda (_key row) (set! calls (+ calls 1)) row)
        (lambda (key _row found) (and (some? found) (some (cons key (some-value found)))))))
      (def initial (.call guarded .ap (cons l r)))
      (let (prior calls)
        (check-exception (.call guarded .apply-deltas initial (.call left .diff l l)
          (.call right .delta/opt 10 (lambda (_) #f) r)) TypeError?)
        (check-equal? calls prior)))
    (test-case "lookup key swaps use shared projection claims and collisions preserve branches for corrected retry"
      (def left (SimpleTrie UInt UInt)) (def right (SimpleTrie UInt UInt))
      (def target (SimpleTrie UInt UInt))
      (def join (table-lookup-join left right target (lambda (_key row) row)
        (lambda (key _row found) (and (some? found) (some (cons (some-value found) key))))))
      (def l (.call left .<-list '((1 . 10) (2 . 20))))
      (def r (.call right .<-list '((10 . 100) (20 . 200))))
      (def state (.call join .ap (cons l r)))
      (def collision (.call right .acons 10 200 r))
      (check-exception (.call join .apply-deltas state (.call left .diff l l)
        (.call right .diff r collision)) table-index-conflict?)
      (check-equal? (.call target .list<- (.call join .get state)) '((100 . 1) (200 . 2)))
      (def swapped (.call right .<-list '((10 . 200) (20 . 100))))
      (defvalues (next edits) (.call join .apply-deltas state (.call left .diff l l) (.call right .diff r swapped) values))
      (check-equal? (.call target .list<- (.call join .get next)) '((100 . 2) (200 . 1)))
      (check (.call target .=? (.call target .apply-delta (.call join .get next) (invert-table-delta edits))
        (.call join .get state)) => #t))
    (test-case "lookup zero-edit successors retain both source origins and refuse foreign states"
      (def left (SimpleTrie UInt UInt)) (def right (SimpleTrie UInt UInt))
      (def origin (.o revision: 1)) (def inherited (.cc right .sources: (list origin)))
      (def join (table-lookup-join left right right (lambda (_key row) row)
        (lambda (key _row found) (and (some? found) (some (cons key (some-value found)))))))
      (def l (.call left .<-list '((1 . 10)))) (def r (.call right .<-list '((10 . 100))))
      (def state (.call join .ap (cons l r)))
      (def other (table-lookup-join left right right (lambda (_key row) row) (lambda args #f)))
      (check-exception (.call other .get state) (message? "incompatible table lookup join"))
      (defvalues (next edits) (.call join .apply-deltas state
        (.call left .diff l l) (.call inherited .diff r r) values))
      (.set! origin revision 2)
      (check-exception (.call join .get next) (message? "stale table lookup join state"))
      (check-exception (.call right .apply-delta (.call join .get state) edits)
        (message? "stale or incompatible table delta")))
    (test-case "service routing joins publish wrapped callbacks through five styles with stale-target retry and inverse"
      (def signature (Fun Integer <- Integer))
      (def f (validate signature (lambda (n) (+ n 1))))
      (def g (validate signature (lambda (n) (+ n 2))))
      (def left (SimpleTrie UInt (Tuple UInt signature)))
      (def right (SimpleTrie UInt UInt)) (def target (SimpleTrie UInt signature))
      (def join (service.make-service-routing-join left right target))
      (def l (.call left .<-list (list (cons 1 (vector 10 f)) (cons 2 (vector 20 g)))))
      (def r (.call right .<-list '((10 . 100) (20 . 200))))
      (def state (.call join .ap (cons l r)))
      (def swapped (.call right .<-list '((10 . 200) (20 . 100))))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles target) name))
        (def calls 0)
        (def action (service.publish-join-action join (.call left .diff l l) (.call right .diff r swapped)
          protocol (lambda (_) (set! calls (+ calls 1)))))
        (def stale (.call protocol .ap (.call target .<-list (list (cons 100 g) (cons 200 g)))))
        (check-exception (action (object<-alist (list (cons 'state state) (cons 'target stale)))) table-conflict?)
        (check-equal? calls 0)
        (def owner (.call protocol .ap (.call join .get state)))
        (def result (action (object<-alist (list (cons 'state state) (cons 'target owner)))))
        (check-equal? calls 1)
        (check (eq? (.call protocol .ref (.@ result target) 200) f) => #t)
        (check ((.call protocol .ref (.@ result target) 100) 5) => 7)
        (def undone (.call protocol .apply-delta (.@ result target) (invert-table-delta (.@ result delta))))
        (check (eq? (.call protocol .ref undone 100) f) => #t)))
    (test-case "lookup join supports distinct left and right key types through declared key spaces"
      (def left (SimpleTrie UInt Symbol))
      (def right (alist-table Symbol Integer))
      (def target (SimpleTrie UInt Integer))
      (def join (table-lookup-join left right target (lambda (_key row) row)
        (lambda (key _row found) (and (some? found) (some (cons key (some-value found)))))))
      (def l (.call left .<-list '((1 . primary) (2 . primary) (3 . secondary))))
      (def r (.call right .<-list '((primary . 7) (secondary . 9))))
      (def state (.call join .ap (cons l r)))
      (def next (.call join .apply-deltas state (.call left .diff l l)
        (.call right .delta/opt 'primary (lambda (_) (some 11)) r)))
      (check-equal? (.call target .list<- (.call join .get next)) '((1 . 11) (2 . 11) (3 . 9))))
    (test-case "joint lookup target refusal and callback failure preserve both source heads for compensated retry"
      (def left (SimpleTrie UInt UInt)) (def right (SimpleTrie UInt UInt))
      (def raw (SimpleTrie UInt UInt))
      (def target (.cc raw .element?: (lambda (root)
        (and (element? raw root) (= (.call raw .count root) 2)))))
      (def fail? #f) (def cause (list 'route-refused))
      (def join (table-lookup-join left right target (lambda (_key row) row)
        (lambda (key _row found)
          (when fail? (raise cause))
          (and (some? found) (some (cons (some-value found) key))))))
      (def l (.call left .<-list '((1 . 10) (2 . 20))))
      (def r (.call right .<-list '((10 . 100) (20 . 200))))
      (def state (.call join .ap (cons l r)))
      (def partial (.call left .remove l 2))
      (def revised (.call right .acons 10 150 r))
      (def delivered 0)
      (check-exception (.call join .apply-deltas state (.call left .diff l partial)
        (.call right .diff r revised) (lambda (next edits) (set! delivered (+ delivered 1)) next)) TypeError?)
      (check-equal? delivered 0)
      (check-equal? (.call right .ref (cdr (.call join .unap state)) 10) 100)
      (def final-left (.call left .acons 2 30 l))
      (def final-right (.call right .acons 30 300 revised))
      (def dl (.call left .diff l final-left)) (def dr (.call right .diff r final-right))
      (set! fail? #t)
      (check (eq? (try (.call join .apply-deltas state dl dr) #f (catch (e) e)) cause) => #t)
      (set! fail? #f)
      (def next (.call join .apply-deltas state dl dr))
      (check-equal? (.call target .list<- (.call join .get next)) '((150 . 1) (300 . 2)))
      (def restored (.call join .apply-deltas next (invert-table-delta dl) (invert-table-delta dr)))
      (check-equal? (.call target .list<- (.call join .get restored)) '((100 . 1) (200 . 2))))
    (test-case "public insertion conflicts and final refinements refuse before linear retirement"
      (def source (RationalDict Integer)) (def raw (SimpleTrie UInt Integer))
      (def root (.call source .<-list '((1 . 10))))
      (def delta (.call source .delta/opt 1 (lambda (_) (some 30)) root))
      (for (migration? '(#t #f))
        (def target (if migration? raw (.cc raw .element?: (lambda (r)
          (and (element? raw r) (<= (.call raw .foldl (lambda (_ v acc) (+ v acc)) 0 r) 100))))))
        (def projection (table-projection source target (lambda (k v)
          (some (cons (if migration? (+ k v) k) v)))))
        (def state (.call projection .ap root)) (def before (.call projection .get state))
        (def protocol (.@ (table-styles target) Linear))
        (def external (.call target .acons (if migration? 31 99) (if migration? 777 80) before))
        (def owner (.call protocol .ap external)) (def effects 0)
        (def action (service.publish-projected-ledger-action projection delta protocol
          (lambda (_) (set! effects (+ effects 1)))))
        (check-exception (action (object<-alist (list (cons 'state state) (cons 'target owner))))
          (if migration? table-conflict? TypeError?))
        (check-equal? effects 0) (check (eq? external (.call protocol .unap owner)) => #t)
        (check (eq? root (.call projection .unap state)) => #t)
        (def retry (action (object<-alist (list (cons 'state state) (cons 'target (.call protocol .ap before))))))
        (check-equal? effects 1)
        (def recovered (.call protocol .apply-delta (.@ retry target) (invert-table-delta (.@ retry delta))))
        (check-equal? (.call target .list<- (.call protocol .unap recovered)) (.call target .list<- before))))
    (test-case "direct delivery returns the exact installed target delta without difference discovery"
      (def source (RationalDict Integer)) (def raw (SimpleTrie UInt Integer))
      (def installed #f) (def calls 0)
      (def target (.cc raw
        .diff: (lambda args (error "unexpected target diff"))
        .for-each-change: (lambda args (error "unexpected difference traversal"))
        .apply-delta: (lambda (root delta)
          (set! installed delta) (.call raw .apply-delta root delta))))
      (def projection (table-projection source target (lambda (k v)
        (set! calls (+ calls 1)) (some (cons (+ k v) v)))))
      (def root (.call source .<-list '((1 . 10) (2 . 20))))
      (def state (.call projection .ap root)) (def before (.call projection .get state))
      (def delta (.call source .delta/opt 1 (lambda (_) (some 30)) root)) (set! calls 0)
      (defvalues (next out) (.call projection .apply-delta state delta
        (lambda (next out) (check (eq? out installed) => #t) (values next out))))
      (check-equal? calls 1) (check-equal? (table-delta-count out) 2)
      (check-equal? (.call target .list<- (.call target .apply-delta before out))
        (.call target .list<- (.call projection .get next)))
      (check-equal? (.call target .list<- (.call target .apply-delta (.call projection .get next)
        (invert-table-delta out))) (.call target .list<- before))
      (defvalues (same empty) (.call projection .apply-delta state
        (.call source .delta/opt 9 (lambda (_) #f) root) values))
      (check-equal? (table-delta-count empty) 0)
      (check (eq? before (.call projection .get same)) => #t))
    (test-case "all target styles publish delivered deltas and recover inverses without scans"
      (def source (RationalDict Integer)) (def raw (SimpleTrie UInt Integer))
      (def target (.cc raw .diff: (lambda args (error "unexpected target diff"))))
      (def projection (table-projection source target (lambda (k v) (some (cons k v)))))
      (def root (.call source .<-list '((1 . 10) (2 . 20))))
      (def state (.call projection .ap root)) (def before (.call projection .get state))
      (def delta (.call source .delta/opt 1 (lambda (_) (some 30)) root))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles target) name)) (def owner (.call protocol .ap before))
        (def effects 0)
        (def action (service.publish-projected-ledger-action projection delta protocol
          (lambda (published) (set! effects (+ effects 1))
            (check-equal? (.call target .ref published 1) 30))))
        (def published (action (object<-alist (list (cons 'state state) (cons 'target owner)))))
        (check-equal? effects 1)
        (check-equal? (.call source .ref (.call projection .unap (.@ published state)) 1) 30)
        (case name
          ((Pure Posh) (check (eq? before (.call protocol .unap owner)) => #t))
          ((Mutable Classy) (check (eq? owner (.@ published target)) => #t))
          ((Linear) (check-exception (.call protocol .unap owner) (message? "consumed table reference"))))
        (def recovered (.call protocol .apply-delta (.@ published target)
          (invert-table-delta (.@ published delta))))
        (check-equal? (.call target .list<- (.call protocol .unap recovered)) (.call target .list<- before))))
    (test-case "publication conflict retains owners and suppresses IO before a corrected retry"
      (def source (RationalDict Integer)) (def target (SimpleTrie UInt Integer))
      (def projection (table-projection source target (lambda (k v) (some (cons k v)))))
      (def root (.call source .<-list '((1 . 10) (2 . 20))))
      (def state (.call projection .ap root)) (def before (.call projection .get state))
      (def delta (.call source .delta/opt 1 (lambda (_) (some 30)) root))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles target) name))
        (def changed (.call target .acons 1 99 before)) (def owner (.call protocol .ap changed))
        (def effects 0)
        (def action (service.publish-projected-ledger-action projection delta protocol
          (lambda (_) (set! effects (+ effects 1)))))
        (check-exception (action (object<-alist (list (cons 'state state) (cons 'target owner)))) table-conflict?)
        (check-equal? effects 0) (check (eq? changed (.call protocol .unap owner)) => #t)
        (check (eq? root (.call projection .unap state)) => #t)
        ;; A changed-key rebase preserves unrelated external rows and inverse frame.
        (def extra (.call target .acons 99 990 before))
        (def retry (action (object<-alist (list (cons 'state state) (cons 'target (.call protocol .ap extra))))))
        (check-equal? effects 1)
        (check-equal? (.call target .ref (.call protocol .unap (.@ retry target)) 99) 990)
        (def undo (.call protocol .apply-delta (.@ retry target) (invert-table-delta (.@ retry delta))))
        (check-equal? (.call target .list<- (.call protocol .unap undo)) (.call target .list<- extra))))
    (test-case "delivery refuses malformed continuations and preserves exact receiver exceptions"
      (def source (RationalDict Integer)) (def target (SimpleTrie UInt Integer)) (def calls 0)
      (def projection (table-projection source target (lambda (k v)
        (set! calls (+ calls 1)) (some (cons k v)))))
      (def root (.call source .<-list '((1 . 10)))) (def state (.call projection .ap root))
      (def delta (.call source .delta/opt 1 (lambda (_) (some 30)) root)) (set! calls 0)
      (check-exception (.call projection .apply-delta state delta 'invalid) ContractViolation?)
      (check-equal? calls 0)
      (def cause (list 'receiver-failed))
      (check (eq? (try (.call projection .apply-delta state delta (lambda (_next _delta) (raise cause)))
        #f (catch (e) e)) cause) => #t)
      (check (eq? root (.call projection .unap state)) => #t)
      (defvalues (next out) (.call projection .apply-delta state delta values))
      (check-equal? (.call target .ref (.call projection .get next) 1) 30)
      (check-equal? (table-delta-count out) 2))
    (test-case "delivered empty deltas retain inherited origins and invalidation"
      (def source (RationalDict Integer)) (def target (SimpleTrie UInt Integer))
      (def origin (.o version: 1)) (def derived (.cc source .sources: (list origin)))
      (def projection (table-projection source target (lambda (k v) (some (cons k v)))))
      (def root (.call source .<-list '((1 . 10)))) (def state (.call projection .ap root))
      (defvalues (_next out) (.call projection .apply-delta state
        (.call derived .delta/opt 9 (lambda (_) #f) root) values))
      (check-equal? (table-delta-count out) 0)
      (.set! origin version 2)
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles target) name))
        (def before (.call projection .get state)) (def owner (.call protocol .ap before))
        (check-exception (.call protocol .apply-delta owner out) (message? "stale or incompatible table delta"))
        (check (eq? before (.call protocol .unap owner)) => #t)))
    (test-case "reentrant style installation preserves the winner and returns no successor to IO"
      (for (name '(Mutable Linear Classy))
        (def source (RationalDict Integer)) (def raw (SimpleTrie UInt Integer))
        (def reenter? #f) (def applications 0) (def winner #f) (def protocol #f) (def owner #f)
        (def target (.cc raw .apply-delta: (lambda (before delta)
          (set! applications (+ applications 1))
          (when (and reenter? (= applications 2))
            (set! reenter? #f) (set! winner (.call protocol .acons 99 990 owner)))
          (.call raw .apply-delta before delta))))
        (def projection (table-projection source target (lambda (k v) (some (cons k v)))))
        (def root (.call source .<-list '((1 . 10)))) (def state (.call projection .ap root))
        (def delta (.call source .delta/opt 1 (lambda (_) (some 30)) root))
        (set! protocol (.ref (table-styles target) name))
        (set! owner (.call protocol .ap (.call projection .get state)))
        (def effects 0)
        ;; The second target installation is public; the first prepares privately.
        (set! reenter? #t)
        (def action (service.publish-projected-ledger-action projection delta protocol
          (lambda (_) (set! effects (+ effects 1)))))
        (check-exception (action (object<-alist (list (cons 'state state) (cons 'target owner)))) (message? "stale table reference"))
        (check-equal? (.call target .ref (.call protocol .unap winner) 99) 990)
        (check-equal? (.call target .ref (.call protocol .unap winner) 1) 10)
        (check (eq? root (.call projection .unap state)) => #t)
        (check-equal? effects 0)))
    (test-case "incremental projection coalesces repeated keys and supports final key swaps"
      (for (source (list (RationalDict Integer) (SimpleTrie UInt Integer)))
        (def target (SimpleTrie UInt Integer)) (def calls [])
        (def project (lambda (k v) (set! calls (cons k calls)) (and (> v 0) (some (cons v k)))))
        (def protocol (table-projection source target project))
        (def root (.call source .<-list '((1 . 10) (2 . 20) (3 . -1) (4 . 40))))
        (def state (.call protocol .ap root)) (set! calls [])
        (def middle (.call source .<-list '((1 . 20) (2 . 10) (3 . 30) (4 . 40))))
        (def final (.call source .<-list '((1 . 20) (2 . 10) (3 . 31) (4 . 40))))
        (def batch (.call source .compose-deltas
          (list (.call source .diff root middle) (.call source .diff middle final))))
        (def next (.call protocol .apply-delta state batch))
        (check-equal? (reverse calls) '(1 2 3))
        (check-equal? (.call target .list<- (.call protocol .get next)) '((10 . 2) (20 . 1) (31 . 3) (40 . 4)))
        (check-equal? (.call source .list<- (.call protocol .unap next)) (.call source .list<- final))
        (check-equal? (.call target .list<- (.call protocol .get state)) '((10 . 1) (20 . 2) (40 . 4)))
        (set! calls [])
        (def restored (.call protocol .apply-delta next (invert-table-delta batch)))
        (check-equal? (reverse calls) '(3 2 1))
        (check-equal? (.call target .list<- (.call protocol .get restored)) (.call target .list<- (.call protocol .get state)))
        (set! calls [])
        (def noop (.call protocol .apply-delta restored (.call source .diff root root)))
        (check-equal? calls [])
        (check (eq? (.call protocol .get noop) (.call protocol .get restored)) => #t)))
    (test-case "incremental projection refuses conflicts before callbacks and preserves retry state"
      (def source (RationalDict Integer)) (def target (SimpleTrie UInt Integer))
      (def calls 0) (def failure? #f) (def cause (list 'project-failed))
      (def protocol (table-projection source target (lambda (k v)
        (set! calls (+ calls 1)) (when failure? (raise cause)) (some (cons v k)))))
      (def root (.call source .<-list '((1 . 10) (2 . 20) (3 . 30))))
      (def state (.call protocol .ap root)) (def before (.call protocol .get state))
      (def conflict (.call source .diff (.call source .acons 1 99 root) (.call source .acons 1 11 root)))
      (set! calls 0)
      (check-exception (.call protocol .apply-delta state conflict) table-conflict?)
      (check-equal? calls 0)
      (def collision (.call source .diff root (.call source .acons 1 20 root)))
      (check-exception (.call protocol .apply-delta state collision) table-index-conflict?)
      (check (eq? before (.call protocol .get state)) => #t)
      (def delta (.call source .diff root (.call source .acons 1 11 root)))
      (set! failure? #t)
      (check (eq? (try (.call protocol .apply-delta state delta) #f (catch (e) e)) cause) => #t)
      (check (eq? before (.call protocol .get state)) => #t)
      (set! failure? #f) (set! calls 0)
      (def next (.call protocol .apply-delta state delta))
      (check-equal? calls 1)
      (check-equal? (.call target .list<- (.call protocol .get next)) '((11 . 1) (20 . 2) (30 . 3)))
      (def removed (.call protocol .apply-delta next
        (.call source .diff (.call protocol .unap next) (.call source .remove (.call protocol .unap next) 2))))
      (check-equal? calls 1)
      (check-equal? (.call target .list<- (.call protocol .get removed)) '((11 . 1) (30 . 3))))
    (test-case "incremental projection retains inherited origins and refuses foreign states"
      (def source (RationalDict Integer)) (def target (SimpleTrie UInt Integer))
      (def origin (.o version: 1)) (def calls 0)
      (def project (lambda (k v) (set! calls (+ calls 1)) (some (cons k v))))
      (def protocol (table-projection source target project))
      (def root (.call source .<-list '((1 . 10)))) (def state (.call protocol .ap root))
      (def foreign (.call (table-projection source target project) .ap root))
      (check-exception (.call protocol .get foreign) (message? "incompatible table projection state"))
      (def derived (.cc source .sources: (list origin)))
      (def delta (.call derived .diff root root))
      (def next (.call protocol .apply-delta state delta))
      (.set! origin version 2) (set! calls 0)
      (check-exception (.call protocol .get next) (message? "stale table projection state"))
      (check-exception (.call protocol .apply-delta state delta) Error?) (check-equal? calls 0)
      (check (eq? root (.call protocol .unap state)) => #t)
      (def recipe (.o version: 1))
      (def bound (table-projection source target project (list recipe)))
      (def bound-state (.call bound .ap root)) (.set! recipe version 2)
      (check-exception (.call bound .get bound-state) (message? "stale table projection state")))
    (test-case "incremental target equality and complete refinements govern migration"
      (def source (SimpleTrie UInt Integer)) (def raw (RationalDict Integer))
      (def target (.cc raw .element?: (lambda (root)
        (and (element? raw root) (= (.call raw .count root) 2)))))
      (def protocol (table-projection source target (lambda (k v) (some (cons v k)))))
      (def root (.call source .<-list '((1 . 10) (2 . 20)))) (def state (.call protocol .ap root))
      (check-exception (.call protocol .apply-delta state
        (.call source .diff root (.call source .remove root 1))) TypeError?)
      (def migrated (.call source .<-list '((2 . 20) (3 . 30))))
      (def next (.call protocol .apply-delta state (.call source .diff root migrated)))
      (check-equal? (.call target .list<- (.call protocol .get next)) '((20 . 2) (30 . 3)))
      (def numeric (table-projection source raw (lambda (k v) (some (cons (if (= v 11) 20.0 v) k)))))
      (def nstate (.call numeric .ap root))
      (check-exception (.call numeric .apply-delta nstate
        (.call source .diff root (.call source .acons 1 11 root))) table-index-conflict?))
    (test-case "incremental service migration keeps Functions shared indexes and IO atomic"
      (def callback (Fun Integer <- Integer))
      (def f (validate callback (lambda (n) (+ n 1))))
      (def g (validate callback (lambda (_) "bad")))
      (def source (SimpleTrie UInt (Tuple UInt UInt UInt UInt callback)))
      (defvalues (raw-target primary _recipes) (service.make-indexed-services))
      (def target (.cc raw-target .diff: (lambda args (error "unexpected target diff"))))
      (def calls []) (def effects 0)
      (def protocol (table-projection source target (lambda (k row)
        (set! calls (cons k calls))
        (some (cons (vector-ref row 0)
          (vector (vector-ref row 1) (vector-ref row 2) (vector-ref row 3) (vector-ref row 4)))))))
      (def root (.call source .<-list (list (cons 1 (vector 11 101 1001 10 f))
        (cons 2 (vector 12 102 1002 10 g)) (cons 3 (vector 13 103 1003 20 f)))))
      (def state (.call protocol .ap root)) (set! calls [])
      (def bad (.call source .acons 1 (vector 12 102 1002 30 f) root))
      (def consume (lambda (_) (set! effects (+ effects 1))))
      (check-exception ((service.revise-projected-ledger-action protocol (.call source .diff root bad) consume) state)
        table-index-conflict?) (check-equal? effects 0)
      (def unique-bad (.call source .acons 1 (vector 11 102 1002 30 f) root))
      (check-exception ((service.revise-projected-ledger-action protocol
        (.call source .diff root unique-bad) consume) state) table-index-conflict?)
      (check-equal? effects 0)
      ;; Both primary keys AND unique badges/endpoints swap in one final revision.
      (def final (.call source .acons 2 (vector 11 101 1001 30 g) bad)) (set! calls [])
      (def delta (.call source .diff root final))
      (def styles (.@ (table-styles target) Linear))
      (def owner (.call styles .ap (.call protocol .get state)))
      (def publication ((service.publish-projected-ledger-action protocol delta styles consume)
        (object<-alist (list (cons 'state state) (cons 'target owner)))))
      (def next (.@ publication state))
      (check-equal? (reverse calls) '(1 2)) (check-equal? effects 1)
      (def output (.call protocol .get next))
      (check-equal? (.call target .index-ref/opt output 'badge 102) (some 12))
      (check-equal? (.call primary .count (some-value (.call target .index-ref/opt output 'team 30))) 2)
      (check (eq? (vector-ref (.call target .ref output 13) 3) f) => #t)
      (check-exception ((vector-ref (.call target .ref output 11) 3) 0) TypeError?)
      (def restored (.call protocol .apply-delta next (invert-table-delta delta)))
      (def old (.call styles .apply-delta (.@ publication target)
        (invert-table-delta (.@ publication delta))))
      (check-equal? (.call target .list<- (.call protocol .get restored))
        (.call target .list<- (.call protocol .get state)))
      (check-equal? (.call target .list<- (.call styles .unap old))
        (.call target .list<- (.call protocol .get state))))
    (test-case "incremental multi-round projection agrees with a full oracle and skips untouched rows"
      (for (source (list (RationalDict Integer) (SimpleTrie UInt Integer)))
        (def target (SimpleTrie UInt Integer)) (def calls 0)
        (def project (lambda (k v)
          (and (>= v 0) (some (cons (+ (* k 100) (modulo v 7)) v)))))
        (def protocol (table-projection source target (lambda (k v)
          (set! calls (+ calls 1)) (project k v))))
        (def state (.call protocol .ap (.call source .<-list '((1 . 10) (2 . 20) (3 . 30) (4 . 40)))))
        (for (round (in-range 32))
          (def before (.call protocol .unap state)) (def key (+ 1 (modulo round 4)))
          (def after (if (zero? (modulo round 5)) (.call source .remove before key)
            (.call source .acons key (if (zero? (modulo round 3)) -1 (+ round 100)) before)))
          (def delta (.call source .diff before after)) (set! calls 0)
          (def next (.call protocol .apply-delta state delta))
          (check-equal? calls (if (and (> (table-delta-count delta) 0) (.call source .key? after key)) 1 0))
          (check-equal? (.call target .list<- (.call protocol .get next))
            (.call target .list<- (.call source .filter-map/into target project after)))
          (def undo (.call protocol .apply-delta next (invert-table-delta delta)))
          (check-equal? (.call target .list<- (.call protocol .get undo))
            (.call target .list<- (.call protocol .get state)))
          (set! state next))))
    (test-case "incremental preparation admits complete source before any new projection"
      (def raw (RationalDict Integer)) (def calls 0)
