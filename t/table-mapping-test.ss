        (def seen [])
        (def result (.call source .map/into target (lambda (key value)
          (set! seen (cons (cons key value) seen)) (cons (+ key 10) (even? value))) root))
        (check-equal? (reverse seen) (.call source .list<- root))
        (check-equal? (.call target .list<- result) '((11 . #t) (12 . #f) (13 . #t)))
        (def selected (.call source .filter-map/into target
          (lambda (key value) (and (odd? value) (some (cons key #f)))) root))
        (check-equal? (.call target .list<- selected) '((2 . #f)))
        (check-equal? (.call source .list<- root) '((1 . 10) (2 . 21) (3 . 30)))))
    (test-case "entry collisions use the target backend equality before construction or later callbacks"
      (def source (SimpleTrie UInt Integer))
      (def raw (RationalDict Integer)) (def builds 0) (def calls 0)
      (def target (.cc raw .<-list: (lambda (rows)
        (set! builds (+ builds 1)) (.call raw .<-list rows))))
      (def root (.call source .<-list '((1 . 10) (2 . 20) (3 . 30))))
      ;; Numeric backend equality identifies 1 and 1.0, unlike host equal?.
      (check (equal? 1 1.0) => #f)
      (def cause (try (.call source .map/into target (lambda (key value)
        (set! calls (+ calls 1)) (cons (if (= key 1) 1 1.0) value)) root)
        #f (catch (cause) cause)))
      (check (table-index-conflict? cause) => #t)
      (check-equal? (table-index-conflict-name cause) 'primary)
      (check-equal? (table-index-conflict-existing cause) 1)
      (check-equal? (table-index-conflict-incoming cause) 2)
      (check-equal? calls 2) (check-equal? builds 0)
      (check-equal? (.call target .list<- (.call source .map/into target cons root)) '((1 . 10) (2 . 20) (3 . 30))))
    (test-case "projection snapshots reused response shells without rewrapping Functions"
      (def callback (Fun Integer <- Integer))
      (def f (validate callback (lambda (x) (+ x 1))))
      (def source (SimpleTrie UInt Integer)) (def target (SimpleTrie UInt callback))
      (def row (cons 0 f)) (def response (some row))
      (def result (.call source .filter-map/into target (lambda (key _)
        (set-car! row (+ key 10)) response) (.call source .<-list '((1 . 10) (2 . 20)))))
      (set-car! row 99) (some-value-set! response #f)
      (check-equal? (map car (.call target .list<- result)) '(11 12))
      (check (eq? (.call target .ref result 11) f) => #t)
      (check (eq? (.call target .ref result 12) f) => #t)
      (check (.call target .ref result 11) => f)
      (check ((.call target .ref result 12) 10) => 11)
      (def mutating-key (.cc UInt .element?: (lambda (key)
        (set-car! row 99) (element? UInt key))))
      (def guarded (.cc (RationalDict callback) Key: mutating-key))
      (some-value-set! response row)
      (def fixed (.call source .filter-map/into guarded (lambda (key _)
        (set-car! row (+ key 10)) response) (.call source .<-list '((1 . 10) (2 . 20)))))
      (check-equal? (map car (.call guarded .list<- fixed)) '(11 12))
      (check (eq? (.call guarded .ref fixed 12) f) => #t))
    (test-case "entry admission rejects bad roots capabilities shells and children before publication"
      (def source (SimpleTrie UInt Integer)) (def target (SimpleTrie UInt Bool))
      (def root (.call source .<-list '((1 . 10) (2 . 20)))) (def calls 0)
      (def project (lambda (key _) (set! calls (+ calls 1)) (cons key #f)))
      (check-exception (.call source .map/into target project 'invalid) TypeError?)
      (check-equal? calls 0)
      (check-exception (.call source .map/into (.cc target .key-table: #f) project root)
        (message? "unsupported table key registry"))
      (check-equal? calls 0)
      (check-exception (.call source .map/into
        (.cc target .key-table: (lambda (_payload) (SimpleTrie UInt Bool))) project root)
        (message? "incompatible table key registry"))
      (check-equal? calls 0)
      (check-exception (.call source .map/into target (lambda (_key _value) #f) root) TypeError?)
      (check-exception (.call source .filter-map/into target (lambda (_key _value) #t) root)
        (message? "table update must return Option"))
      (check-exception (.call source .filter-map/into target (lambda (_key _value) (some #f)) root) TypeError?)
      (check-exception (.call source .map/into target (lambda (_key _value) (cons -1 #t)) root) TypeError?)
      (check-exception (.call source .map/into target (lambda (key _) (cons key "bad")) root) TypeError?)
      (def raw (RationalDict Bool)) (def builds 0)
      (def cohort (.cc raw .element?: (lambda (r)
        (and (element? raw r) (positive? (.call raw .count r)) (even? (.call raw .count r))))
        .<-list: (lambda (rows) (set! builds (+ builds 1)) (.call raw .<-list rows))))
      (check-equal? (.call cohort .count (.call source .map/into cohort project root)) 2)
      (check-equal? builds 1)
      (check-exception (.call source .filter-map/into cohort
        (lambda (key _) (and (= key 1) (some (cons key #t)))) root) TypeError?)
      (check-exception (.call source .map/into cohort project (.@ source .empty)) TypeError?))
    (test-case "one projection guard protects all origins and retains callback exception identity"
      (def source (SimpleTrie UInt Integer)) (def raw (RationalDict Bool))
      (def dependency (.o epoch: 0)) (def failure (list 'projection-refused))
      (def target (.cc raw .sources: (list dependency)))
      (def root (.call source .<-list '((1 . 10) (2 . 20))))
      (check-exception (.call source .map/into target
        (lambda (key _) (.set! dependency epoch 1) (cons key #t)) root)
        (message? "object mutation during computation"))
      (check-equal? (.@ dependency epoch) 0)
      (check (eq? (try (.call source .map/into target (lambda (_key _value) (raise failure)) root)
        #f (catch (cause) cause)) failure) => #t)
      (def late (.o (:: @ target)
        (.<-list (begin (.set! dependency epoch 2) (.@ raw .<-list)))))
      (check-exception (.call source .map/into late (lambda (key _) (cons key #t)) root)
        (message? "object mutation during computation"))
      (check-equal? (.@ dependency epoch) 0))
    (test-case "five source styles and receivers project snapshots without consuming owners"
      (def source (SimpleTrie UInt Integer)) (def target (RationalDict Bool))
      (def root (.call source .<-list '((1 . 10) (2 . 21))))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles source) name))
        (def owner (.call protocol .ap root))
        (def result (.call protocol .map/into target (lambda (key value) (cons (- key) (even? value))) owner))
        (check-equal? (.call target .list<- result) '((-2 . #f) (-1 . #t)))
        (check (eq? (.call protocol .unap owner) root) => #t)
        (check-exception (.call protocol .map/into target (lambda (_key _value) (cons 0 #f)) owner) table-index-conflict?)
        (check (eq? (.call protocol .unap owner) root) => #t)
        (when (memq name '(Posh Classy))
          (check-equal? (.call target .count (@@method owner.map/into target (lambda (key _) (cons key #f)))) 2))
        (def selected (.call protocol .filter-map/into target
          (lambda (key _) (and (= key 2) (some (cons key #f)))) owner))
        (check-equal? (.call target .list<- selected) '((2 . #f)))
        (when (memq name '(Mutable Classy))
          (let ((published? #f))
            (def captured (.call protocol .map/into target (lambda (key value)
              (unless published?
                (set! published? #t) (.call protocol .acons 9 99 owner))
              (cons key (even? value))) owner))
            (check-equal? (.call target .count captured) 2)
            (check-equal? (.call protocol .count owner) 3)))))
    (test-case "heterogeneous indexed service publication composes FUN IO retry and inverse recovery"
      (def callback (Fun Integer <- Integer))
      (def f (validate callback (lambda (x) (+ x 1))))
      (def g (validate callback (lambda (_) "bad")))
      (def source (SimpleTrie UInt (Pair callback (Tuple UInt UInt UInt))))
      (def root (.call source .<-list (list (cons 1 (cons f #(101 1001 10))) (cons 2 (cons g #(102 1002 10))))))
      (defvalues (target primary _declarations) (service.make-indexed-services))
      (def protocol (.@ (table-styles source) Classy)) (def owner (.call protocol .ap root))
      (def calls 0)
      (def project (lambda (key row)
        (cons (+ key 10) (vector (vector-ref (cdr row) 0) (vector-ref (cdr row) 1) (vector-ref (cdr row) 2) (car row)))))
      (def consume (lambda (next) (set! calls (+ calls 1)) next))
      (def bad (service.map-ledger-into-action protocol target (lambda (key row)
        (cons (+ key 10) (vector 101 (vector-ref (cdr row) 1) 10 (car row)))) consume))
      (check-exception (bad owner) table-index-conflict?) (check-equal? calls 0)
      (check (eq? (.call protocol .unap owner) root) => #t)
      (def next ((service.map-ledger-into-action protocol target project consume) owner))
      (check-equal? calls 1)
      (check-equal? (.call target .index-ref/opt next 'badge 101) (some 11))
      (check-equal? (.call primary .count (some-value (.call target .index-ref/opt next 'team 10))) 2)
      (check (eq? (vector-ref (.call target .ref next 11) 3) f) => #t)
      (check-exception ((vector-ref (.call target .ref next 12) 3) 1) TypeError?)
      (def newer (.call source .map/into target (lambda (key row)
        (cons (+ key 10) (vector (if (= key 1) 102 101) (if (= key 1) 1002 1001) 20 (car row)))) root))
      (def target-protocol (.@ (table-styles target) Linear))
      (def target-owner (.call target-protocol .ap next))
      (def delta (.call target .diff next newer))
      (def revised (.call target-protocol .apply-delta target-owner delta))
      (def restored (.call target-protocol .apply-delta revised (invert-table-delta delta)))
      (check-equal? (.call target .list<- next) (.call target .list<- (.call target-protocol .unap restored)))
      (check (eq? (vector-ref (.call target .ref (.call target-protocol .unap restored) 12) 3) g) => #t))
    (test-case "both backends visit original rows once and preserve only selected keys"
      (for* ((table (list (RationalDict Integer) (SimpleTrie UInt Integer))) (mask (in-range 16)))
        (def root (.call table .<-list '((0 . 10) (1 . 20) (2 . 30) (3 . 40))))
        (def original (.call table .list<- root)) (def seen [])
        (def mapped (.call table .filter-map/2 (lambda (key value)
          (set! seen (cons (cons key value) seen))
          (if (zero? (bitwise-and mask (arithmetic-shift 1 key))) #f (some (+ value key)))) root))
        (check-equal? (reverse seen) original)
        (for (key (in-range 4))
          (check-equal? (.call table .ref/opt mapped key)
            (if (zero? (bitwise-and mask (arithmetic-shift 1 key))) #f (some (+ (* 10 (+ key 1)) key)))))
        (check-equal? (.call table .list<- root) original)
        (check (eq? root (.call table .map/2 (lambda (_ v) v) root)) => #t)))
    (test-case "all styles commit one bulk result and retain FUN whole-root mapping"
      (def table (RationalDict Bool)) (def root (.call table .<-list '((1 . #t) (2 . #t))))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles table) name)) (def owner (.call protocol .ap root))
        (def next (if (memq name '(Posh Classy)) (@@method owner.map/2 (lambda (_key _value) #f))
          (.call protocol .map/2 (lambda (_key _value) #f) owner)))
        (check-equal? (.call protocol .list<- next) '((1 . #f) (2 . #f)))
        (case name
          ((Pure Posh) (check (eq? root (.call protocol .unap owner)) => #t))
          ((Mutable Classy) (check (eq? owner next) => #t))
          ((Linear) (check-exception (.call protocol .unap owner) (message? "consumed table reference"))))
        (def reduced (.call protocol .filter-map/2 (lambda (k v) (and (= k 2) (some v))) next))
        (check-equal? (.call protocol .list<- reduced) '((2 . #f)))
        (def final (.call protocol .map identity reduced))
        (check-equal? (.call protocol .list<- final) '((2 . #f)))))
    (test-case "late failure malformed Option and typed refusal preserve owners for retry"
      (for (name '(Pure Mutable Linear Posh Classy))
        (def table (RationalDict Integer)) (def root (.call table .<-list '((1 . 10) (2 . 20) (3 . 30))))
        (def protocol (.ref (table-styles table) name)) (def owner (.call protocol .ap root))
        (def cause (list 'late))
        (check (eq? (try (.call protocol .map/2 (lambda (k v) (if (= k 3) (raise cause) (+ v 1))) owner)
                          #f (catch (e) e)) cause) => #t)
        (check-exception (.call protocol .filter-map/2 (lambda (_key _value) 'invalid) owner)
          (message? "table update must return Option"))
        (check-exception (.call protocol .map/2 (lambda (_key _value) "bad") owner) TypeError?)
        (check (eq? root (.call protocol .unap owner)) => #t)
        (def next (.call protocol .map/2 (lambda (k v) (+ k v)) owner))
        (check-equal? (.call protocol .list<- next) '((1 . 11) (2 . 22) (3 . 33)))))
    (test-case "reentrant publication cannot be overwritten by the older mapped snapshot"
      (for (name '(Mutable Linear Classy))
        (def table (RationalDict Integer)) (def protocol (.ref (table-styles table) name))
        (def owner (.call protocol .ap (.call table .<-list '((1 . 10) (2 . 20)))))
        (def winner #f) (def seen [])
        (check-exception (.call protocol .map/2 (lambda (k v)
          (set! seen (cons (cons k v) seen))
          (unless winner (set! winner (.call protocol .acons 9 90 owner))) (+ v 1)) owner)
          (message? "stale table reference"))
        (check-equal? (reverse seen) '((1 . 10) (2 . 20)))
        (check-equal? (.call protocol .list<- winner) '((1 . 10) (2 . 20) (9 . 90)))))
    (test-case "custom refinement metadata and foreign ownership refuse without partial publication"
      (def base-table (RationalDict Integer))
      (def table (.cc base-table .element?: (lambda (r)
        (and (element? base-table r) (.call base-table .every (lambda (_ v) (<= v 50)) r)))))
      (def root (.call table .<-list '((1 . 10) (2 . 20))))
      (def protocol (.@ (table-styles table) Linear)) (def owner (.call protocol .ap root))
      (check-exception (.call protocol .map/2 (lambda (_key _value) 51) owner) TypeError?)
      (check (eq? root (.call protocol .unap owner)) => #t)
      (def calls 0) (def foreign (.call (.@ (table-styles table) Linear) .ap root))
      (check-exception (.call protocol .map/2 (lambda (_ v) (set! calls (+ calls 1)) v) foreign)
        (message? "incompatible table reference"))
      (check-exception (.call protocol .map/2 (lambda (_ v) (.set! table sexp 'changed) v) owner) Error?)
      (check-equal? calls 0)
      (.set! table sexp 'revised)
      (check-exception (.call protocol .map/2 (lambda (_ v) (set! calls (+ calls 1)) v) owner)
        (message? "stale table styles"))
      (check-equal? calls 0))
    (test-case "reused Option shells and opaque Function keys and values retain exact leaves"
      (def function (Fun Integer <- Integer)) (def table (alist-table function function))
      (def f (validate function (lambda (n) (+ n 1))))
      (def g (validate function (lambda (n) (+ n 2))))
      (def root (.call table .acons f g (.call table .acons g f (.@ table .empty))))
      (def box (some f))
      (def next (.call table .filter-map/2 (lambda (_ v) (some-value-set! box v) box) root))
      (some-value-set! box #f)
      (check (eq? g (.call table .ref next f)) => #t)
      (check (eq? f (.call table .ref next g)) => #t)
      (check-exception ((.call table .ref next f) "bad") TypeError?))
    (test-case "generic fold writes only changed bindings and never calls an empty mapper"
      (def base-table (RationalDict Integer)) (def writes 0)
      (def table (.cc base-table
        .acons: (lambda (k v r) (set! writes (+ writes 1)) (.call base-table .acons k v r))
        .remove: (lambda (r k) (set! writes (+ writes 1)) (.call base-table .remove r k))))
      (def root (.call table .<-list '((1 . 10) (2 . 20) (3 . 30)))) (set! writes 0)
      (check (eq? root (.call table .map/2 (lambda (_ v) v) root)) => #t)
      (check-equal? writes 0)
      (def next (.call table .map/2 (lambda (k v) (if (= k 2) (+ v 1) v)) root))
      (check-equal? writes 1) (check-equal? (.call table .ref next 2) 21)
      (set! writes 0)
      (.call table .filter-map/2 (lambda (k v) (and (not (= k 1)) (some v))) root)
      (check-equal? writes 1)
      (check (eq? (.@ table .empty) (.call table .map/2 (lambda (_k _v) (error "empty callback")) (.@ table .empty))) => #t)
      (check-exception (.call table .map/2 'invalid (.@ table .empty)) ContractViolation?))
    (test-case "final unique swaps compose with multiple indexes representation and five styles"
      (def source (RationalDict Integer))
      (def indexed (table-indexes source (list
        (.cc Type. name: 'unique table: (RationalDict (.@ source Key)) unique?: #t project: (lambda (_ v) v))
        (.cc Type. name: 'group table: (RationalDict source) unique?: #f project: (lambda (_ v) (modulo v 10))))))
      (def state (.call indexed .wrap (.call source .<-list '((1 . 10) (2 . 20)))))
      (defvalues (boxed _carrier _keys) (box-table indexed))
      (for* ((wrapped? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def table (if wrapped? boxed indexed))
        (def root (if wrapped? (.call boxed .wrap state) state))
        (def protocol (.ref (table-styles table) name)) (def owner (.call protocol .ap root))
        (def first (if wrapped? -1 1))
        (def next (.call protocol .map/2 (lambda (k _) (if (= k first) 20 10)) owner))
        (def snapshot (.call protocol .unap next))
        (check-equal? (.call table .ref snapshot first) 20)
        (def raw (if wrapped? (.call boxed .unwrap snapshot) snapshot))
        (check-equal? (.call indexed .index-ref/opt raw 'unique 20) (some 1))
        (check-equal? (.call indexed .index-ref/opt raw 'unique 10) (some 2))
        (check-equal? (.call source .count (some-value (.call indexed .index-ref/opt raw 'group 0))) 2)
        (def before (.call protocol .unap next))
        (check-exception (.call protocol .map/2 (lambda (_k _v) 30) next) table-index-conflict?)
        (check (eq? before (.call protocol .unap next)) => #t)))
    (test-case "Reader IO mapping composes inverse recovery and explicit failure retry"
      (def table (RationalDict Integer)) (def root (.call table .<-list '((1 . 10) (2 . 20))))
      (def calls 0) (def fail? #t)
      (def action (service.map-ledger-action table (lambda (k v)
        (if (and fail? (= k 2)) (error "not ready") (if (= k 1) (some (+ v 1)) #f)))
        (lambda (result) (set! calls (+ calls 1)) result)))
      (check-exception (action root) (message? "not ready")) (check-equal? calls 0)
      (set! fail? #f)
      (def next (action root))
      (check-equal? (.call table .list<- next) '((1 . 11))) (check-equal? calls 1)
      (def delta (.call table .diff root next))
      (check-equal? (.call table .list<- (.call table .apply-delta next (invert-table-delta delta)))
        (.call table .list<- root)))))
