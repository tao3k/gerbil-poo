(export main workload)
(import ../object
        (runtime: :clan/poo/examples/generalized-checkout)
        (prefix-in (only-in ../examples/generalized-checkout base declarations
                   nested-base nested-declarations nested-protocol nested-root
                   prepare-checkout prepare-nested protocol root) checkout.)
        (only-in "closure-measure.ss" run-child)
        (prefix-in "generalized-cases.ss" study.)
        (prefix-in "generalized-observation-reference.ss" reference.)
        (runtime: :clan/poo/generalized-prototype)
        (prefix-in (only-in ../generalized-prototype bind-observer observe
                   prepare-inheritance step) gp.))
;; Use actual old/new public interfaces; phase ablations change one construction
;; choice at a time. Instrumented callback counters are tested outside timed loops.
(def (workload scenario)
  (map (lambda (mode)
    (def optimized? (memq mode '(optimized optimized-aa)))
    (def legacy-protocol (.cc checkout.protocol cook: reference.eager-cook))
    (def snapshot (checkout.prepare-checkout))
    (def old (reference.prepare legacy-protocol checkout.root checkout.declarations))
    (def bound (gp.bind-observer snapshot checkout.base 2))
    (def eager (gp.bind-observer (gp.prepare-inheritance legacy-protocol checkout.root checkout.declarations) checkout.base 2))
    (def nested (checkout.prepare-nested))
    (def nested-bound (gp.bind-observer nested checkout.nested-base 2))
    (def old-lazy-nested (reference.prepare checkout.nested-protocol
      checkout.nested-root checkout.nested-declarations))
    (def old-nested (reference.prepare (.cc checkout.nested-protocol cook: reference.eager-service)
      checkout.nested-root checkout.nested-declarations))
    (case scenario
      ((cold cold-allocation)
       (lambda () (= ((if optimized?
         ((gp.bind-observer (checkout.prepare-checkout) checkout.base 2) checkout.base)
         (reference.observe (reference.prepare legacy-protocol checkout.root checkout.declarations)
           checkout.base checkout.base 2)) 'price) 33)))
      ((observation observation-allocation)
       (lambda () (= ((if optimized? (bound checkout.base)
         (reference.observe old checkout.base checkout.base 2)) 'price) 33)))
      ((reuse)
       (lambda () (= ((if optimized? (bound checkout.base)
         (gp.observe (checkout.prepare-checkout) checkout.base checkout.base 2)) 'price) 33)))
      ((field-cooking)
       (lambda () (= ((if optimized? (bound checkout.base) (eager checkout.base)) 'price) 33)))
      ((binding)
       (lambda () (= ((if optimized? (bound checkout.base)
         (gp.observe snapshot checkout.base checkout.base 2)) 'price) 33)))
      ((hook)
       (lambda ()
         (def raw (if optimized? (gp.step snapshot checkout.base checkout.base)
           (reference.step old checkout.base checkout.base)))
         (and (= (length (car raw)) 3) (= (length (cadr raw)) 1) (eq? (caddr raw) 'audit))))
      ((self-sharing)
       (lambda () (= ((if optimized? (nested-bound checkout.nested-base)
         (reference.observe old-lazy-nested checkout.nested-base checkout.nested-base 2)) 'price) 39)))
      ((nested nested-allocation)
       (lambda ()
         (def view (if optimized? (nested-bound checkout.nested-base)
           (reference.observe old-nested checkout.nested-base checkout.nested-base 2)))
         (equal? (list (view 'price) (view 'rebate) (view 'service)) '(39 3 billing))))
      (else (error "unknown generalized scenario" scenario)))) study.strategies))
;; Reuse signed byte admission, prefix/GC counters, bounded children and exact oracles.
(def (main scenario-text regime-text side-text)
  (def scenario (string->symbol scenario-text)) (def regime (string->symbol regime-text))
  (def side (string->number side-text))
  (unless (and (memq scenario study.scenarios) (memq regime '(natural collected)) (memv side '(0 1 2 3)))
    (error "invalid generalized study request"))
  (run-child scenario regime side (workload scenario) (study.repetitions scenario) 4))
