(export slot-observation-test)
(import :std/test ../object ../slot-observation ../slot-layout
        (only-in :std/error Error? Error-message Error-irritants)
        (only-in ../meta-prototype bootstrap-protocol))
;; Collect exact read identities from one ordinary observer scope.
(def (snapshot action)
  (def records (make-hash-table-eq))
  (def value (call-with-slot-read-observer (cut hash-put! records <> #t) action))
  (values value (hash-keys records)))
;; Match the established stale-read refusal without replacing its original cause.
(def (stale? cause)
  (and (Error? cause) (equal? (Error-message cause) "stale slot dependency")))
;; Distinguish the existing protected replay-write refusal.
(def (write-refused? cause)
  (and (Error? cause) (equal? (Error-message cause) "object mutation during read replay")))
;; Obtain the actual receiver/key read through the normal capture path.
(def (captured-token owner key)
  (defvalues (_value reads) (%call-with-recorded-slot-reads (cut .ref owner key)))
  (car (filter (lambda (read)
                 (and (eq? (slot-read-receiver read) owner)
                      (eq? (slot-read-key read) key))) reads)))
;; Keep storage deduplication and per-observer delivery order independently visible.
(def (collect-events tokens unique?)
  (def events '())
  (def (observe label)
    (lambda (read) (set! events (cons (cons label read) events))))
  (defvalues (_value roots)
    (%call-with-recorded-slot-reads
      (lambda ()
        (call-with-slot-read-observer (observe 'outer)
          (lambda ()
            (call-with-slot-read-observer (observe 'inner)
              (lambda ()
                (for-each (lambda (read) (%deliver-slot-read read #f)) tokens))))))
      unique-roots?: unique?))
  (values roots (reverse events)))
;; Full scope regression, including failure, threads, continuations and replay.
(def slot-observation-test
  (test-suite "MOP slot read records"
    (test-case "disabled observation restores capture observers and prechecks after refusal"
      (.def Source port: 7)
      (def token (captured-token Source 'port)) (def events '()) (def failure (list 'disabled-refused))
      (defvalues (_ roots)
        (%call-with-recorded-slot-reads
          (lambda ()
            (call-with-slot-read-observer (lambda (_) (set! events (cons 'outer events)))
              (lambda ()
                (%slot-read-demand! Source 'port) (%deliver-slot-read token #f)
                (check-exception (without-observation
                  (lambda ()
                    (check-equal? (%slot-read-active?) #f)
                    (%slot-read-demand! Source 'port) (%deliver-slot-read token #f)
                    (call-with-slot-read-observer (lambda (_) (set! events (cons 'inner events)))
                      (lambda () (%slot-read-demand! Source 'port) (%deliver-slot-read token #f))
                      before: (lambda (_receiver _key) (set! events (cons 'inner-before events))))
                    (raise failure))) (lambda (actual) (eq? actual failure)))
                (%slot-read-demand! Source 'port) (%deliver-slot-read token #f))
              before: (lambda (_receiver _key) (set! events (cons 'outer-before events)))))))
      (check-equal? (reverse events) '(outer-before outer inner-before inner outer-before outer))
      (check-equal? (length roots) 2)
      (check (eq? (car roots) token) => #t)
      (check (eq? (cadr roots) token) => #t)
      (check-equal? (%slot-read-active?) #f))
    (test-case "disabled fast path preserves multiple values and exact refusal without replay"
      (def calls 0) (def failure (list 'direct-refused))
      (check-equal? (call-with-values
        (lambda () (without-observation (lambda () (set! calls (+ calls 1)) (values 7 #f)))) list) '(7 #f))
      (check-exception (without-observation (lambda () (set! calls (+ calls 1)) (raise failure)))
        (lambda (actual) (eq? actual failure)))
      (check-equal? calls 2)
      (check-equal? (%slot-read-active?) #f))
    (test-case "observer contexts remain isolated in independently created threads"
      (.def Source port: 7)
      (def token (captured-token Source 'port)) (def parent-events '()) (def child-events '())
      ;; Creation outside the parent observer fixes the standard inherited scope.
      (def worker (make-thread (lambda ()
        (check-equal? (%slot-read-active?) #f)
        (call-with-slot-read-observer (lambda (_) (set! child-events (cons 'child child-events)))
          (lambda () (%deliver-slot-read token #f)))
        (%slot-read-active?))))
      (call-with-slot-read-observer (lambda (_) (set! parent-events (cons 'parent parent-events)))
        (lambda ()
          (thread-start! worker)
          (%deliver-slot-read token #f)
          (check-equal? (thread-join! worker) #f)))
      (check-equal? parent-events '(parent)) (check-equal? child-events '(child))
      (check-equal? (%slot-read-active?) #f))
    (test-case "continuation reentry restores the observer and leaves the caller disabled"
      (.def Source port: 7)
      (def token (captured-token Source 'port)) (def resume #f) (def finish #f) (def events 0)
      (let ((outcome (call/cc (lambda (exit)
        (set! finish exit)
        (call-with-slot-read-observer (lambda (_) (set! events (+ events 1)))
          (lambda ()
            (call/cc (lambda (again) (set! resume again) (exit 'suspended)))
            (%deliver-slot-read token #f)
            (finish 'resumed)))))))
        (check-equal? (%slot-read-active?) #f)
        (case outcome
          ((suspended) (check-equal? events 0) (resume #t))
          ((resumed) (check-equal? events 1))
          (else (error "unexpected continuation outcome" outcome)))))
    (test-case "unique roots preserve original identities and EVERY observer event"
      (.def Source first: 1 second: 1 third: 3)
      (def a (captured-token Source 'first))
      (def b (captured-token Source 'second))
      (def c (captured-token Source 'third))
      (def input (list a b a c b))
      (def dependencies (map slot-read-dependencies (list a b c)))
      (defvalues (raw raw-events) (collect-events input #f))
      (defvalues (roots events) (collect-events input #t))
      (check-equal? (length raw) 5)
      (check-equal? (length roots) 3)
      (for-each (lambda (left right) (check-equal? (eq? left right) #t)) roots (list a b c))
      (check-equal? (map car events) '(inner outer inner outer inner outer inner outer inner outer))
      (for-each (lambda (left right)
                  (check-equal? (car left) (car right))
                  (check-equal? (eq? (cdr left) (cdr right)) #t)) events raw-events)
      (for-each (lambda (read edges) (check-equal? (eq? (slot-read-dependencies read) edges) #t))
        (list a b c) dependencies))
    (test-case "a newer record for the same slot does not replace its stale predecessor"
      (.def Source port: 5432)
      (def old (captured-token Source 'port))
      (.put! Source 'port 5433)
      (def current (captured-token Source 'port))
      (defvalues (roots _events) (collect-events (list old current old) #t))
      (check-equal? (length roots) 2)
      (check-equal? (eq? (car roots) old) #t)
      (check-equal? (eq? (cadr roots) current) #t)
      (check-exception (replay-slot-reads! roots (lambda (_r _k) (void))) stale?))
    (test-case "duplicate callbacks can still fail and the outer frame resumes"
      (.def Source port: 5432 other: 7)
      (def a (captured-token Source 'port))
      (def b (captured-token Source 'other))
      (def failure (with-catch values (lambda () (error "second duplicate delivery"))))
      (def calls 0)
      (defvalues (_value roots)
        (%call-with-recorded-slot-reads
          (lambda ()
            (check-equal?
              (eq? failure
                (with-catch values
                  (lambda ()
                    (call-with-slot-read-observer
                      (lambda (_read)
                        (set! calls (1+ calls))
                        (when (= calls 2) (raise failure)))
                      (lambda () (%deliver-slot-read a #f) (%deliver-slot-read a #f)))))) #t)
            (%deliver-slot-read b #f))
          unique-roots?: #t))
      (check-equal? calls 2)
      (check-equal? (map slot-read-key roots) '(port other)))
    (test-case "dependency capture retains duplicate edges under a compact root frame"
      (.def Source port: 5432)
      (.def Computed answer: (begin (.get Source port) (.get Source port)))
      (defvalues (_value roots)
        (%call-with-recorded-slot-reads (cut .get Computed answer) unique-roots?: #t))
      (def read (car (filter (lambda (r) (eq? (slot-read-key r) 'answer)) roots)))
      (def edges (filter (lambda (r) (and (eq? (slot-read-receiver r) Source)
                                        (eq? (slot-read-key r) 'port)))
                    (slot-read-dependencies read)))
      (check-equal? (length edges) 2)
      (check-equal? (eq? (car edges) (cadr edges)) #t)
      (replay-slot-reads! roots (lambda (_r _k) (void))))
    (test-case "raw and compact roots report the same first stale dependency"
      (.def Source first: 1 second: 2)
      (def a (captured-token Source 'first))
      (def b (captured-token Source 'second))
      (defvalues (raw _raw-events) (collect-events (list b a b a) #f))
      (defvalues (roots _events) (collect-events (list b a b a) #t))
      (.put! Source 'first 3)
      (def (refusal reads)
        (with-catch values (lambda () (replay-slot-reads! reads (lambda (_r _k) (void))))))
      (def old (refusal raw))
      (def current (refusal roots))
      (check-equal? (stale? current) #t)
      (check-equal? (Error-message old) (Error-message current))
      (check-equal? (Error-irritants old) (Error-irritants current))
      (check-equal? (Error-irritants current) '(second)))
    (test-case "reobservation exposes nested cached dependencies without recomputing"
      (def source (.o amount: 7))
      (def calls 0)
      (def owner (.o total: (begin (set! calls (1+ calls)) (.get source amount))))
      (defvalues (_ records) (snapshot (cut .get owner total)))
      (def observed [])
      (call-with-slot-read-observer
        (lambda (read) (set! observed (cons (slot-read-receiver read) observed)))
        (lambda () (reobserve-slot-reads! records)))
      (check-equal? calls 1)
      (check (and (memq owner observed) (memq source observed) #t) => #t)
      (.put! source 'amount 8)
      (check-exception (reobserve-slot-reads! records) stale?)
      (check-equal? calls 1))
    (test-case "reobservation refuses edits made by an enclosing observer"
      (def source (.o amount: 7))
      (defvalues (_ records) (snapshot (cut .get source amount)))
      (def revision (object-revision source))
      (check-exception
        (call-with-slot-read-observer
          (lambda (_) (.put! source 'amount 8))
          (lambda () (reobserve-slot-reads! records))) write-refused?)
      (check-equal? (.get source amount) 7)
      (check-equal? (object-revision source) revision))
    (test-case "cold capture and every warm value route replay dependencies"
      (def calls 0)
      (def source (.o port: 5432))
      (def value (.o port: (begin (set! calls (+ 1 calls)) (.get source port))))
      (def site (make-slot-cache 'port))
      (check-equal? (.ref/inline value site) 5432)
      (for-each
        (lambda (access)
          (defvalues (result records) (snapshot (lambda () (access value))))
          (check-equal? result 5432)
          (def names '())
          (replay-slot-reads! records (lambda (_self key) (set! names (cons key names))))
          (check-equal? (and (memq 'port names) #t) #t)
          (check-equal? calls 1))
        (list (cut .ref <> 'port) (cut .ref/cached <> 'port)
              (cut .ref/inline <> site)
              (lambda (object) (with-slots (port) object port))))
      (defvalues (_result old) (snapshot (cut .ref/inline value site)))
      (.put! source 'port 5433)
      (check-exception (replay-slot-reads! old (lambda (_self _key) (void))) stale?)
      (check-equal? calls 1))
    (test-case "source precheck refuses before a cold getter"
      (def calls 0)
      (def value (.o port: (begin (set! calls (+ 1 calls)) 5432)))
      (check-exception
        (call-with-slot-read-observer (lambda (_) (void)) (cut .get value port)
          before: (lambda (_self key) (when (eq? key 'port) (error "changed source"))))
        Error?)
      (check-equal? calls 0))
    (test-case "cache miss preserves default thunk and rejects later population"
      (def calls 0)
      (def defaults 0)
      (def value (.o port: (begin (set! calls (+ 1 calls)) #f)))
      (defvalues (result records)
        (snapshot (lambda () (.ref/cached value 'port
                              (lambda () (set! defaults (+ 1 defaults)) 'missing)))))
      (check-equal? result 'missing)
      (check-equal? calls 0)
      (check-equal? defaults 1)
      (replay-slot-reads! records (lambda (_self _key) (void)))
      (check-equal? (.get value port) #f)
      (check-equal? (.ref/cached value 'port (lambda () (error "not missing"))) #f)
      (check-exception (replay-slot-reads! records (lambda (_self _key) (void))) stale?))
    (test-case "parent cache and shared inline site never supply child values"
      (.def (Parent @ [] config)
        config: (.o port: 5432)
        plan: (.o configuration: config port: (.get config port)))
      (def parent-plan (.get Parent plan))
      (def site (make-slot-cache 'plan))
      (check-equal? (.get (.ref/inline Parent site) port) 5432)
      (.def (Child @ Parent) config: =>.+ (.o port: 5433))
      (defvalues (child-plan records) (snapshot (cut .ref/inline Child site)))
      (check-equal? (.get child-plan port) 5433)
      (check-equal? (eq? (.get child-plan configuration) (.get Child config)) #t)
      (check-equal? (.get parent-plan port) 5432)
      (replay-slot-reads! records (lambda (_self _key) (void))))
    (test-case "structural observations never force values"
      (def calls 0)
      (def value (.o port: (begin (set! calls (+ 1 calls)) (error "unselected"))))
      (defvalues (_value records)
        (snapshot (lambda () (list (.slot? value 'port) (.all-slots value)))))
      (replay-slot-reads! records (lambda (_self _key) (void)))
      (check-equal? calls 0)
      (.putdefault! value 'other 1)
      (check-exception (replay-slot-reads! records (lambda (_self _key) (void))) stale?)
      (check-equal? calls 0))
    (test-case "nested observers preserve outer reads without a global registry"
      (def outer '())
      (def inner '())
      (def value (.o port: 5432 unused: (error "unselected")))
      (call-with-slot-read-observer (lambda (read) (set! outer (cons read outer)))
        (lambda ()
          (call-with-slot-read-observer (lambda (read) (set! inner (cons read inner)))
            (cut .get value port))))
      (check-equal? (length inner) 1)
      (check-equal? (eq? (car outer) (car inner)) #t))
    (test-case "failed computations do not publish values or read records"
      (def calls 0)
      (def value (.o port: (begin (set! calls (+ 1 calls)) (error "failed"))))
      (check-exception (.get value port) Error?)
      (check-equal? (.ref/cached value 'port (lambda () 'missing)) 'missing)
      (check-exception (.get value port) Error?)
      (check-equal? calls 2))
    (test-case "bootstrap anchors share the observer without demanding construction"
      (def protocol
        (bootstrap-protocol
          (.o compute-slot: (lambda (_self next _name) (next))
              compute-precedence-list: (lambda (_self next) (next)))))
      (def site (make-slot-cache 'compute-slot))
      (.ref/inline protocol site)
      (defvalues (result records)
        (snapshot (lambda ()
          (list (.ref protocol 'compute-slot)
                (.ref/cached protocol 'compute-slot)
                (.slot? protocol 'compute-slot)
                (.ref/inline protocol site)))))
      (check-equal? (eq? (car result) (cadr result)) #t)
      (check-equal? (eq? (car result) (cadddr result)) #t)
      (check-equal? (caddr result) #t)
      (def observed '())
      (replay-slot-reads! records (lambda (_self key) (set! observed (cons key observed))))
      (check-equal? (and (member '(bootstrap compute-slot) observed) #t) #t))
    (test-case "MOP query preparation dependencies survive a warm query"
      (def source (.o port: 5432))
      (def calls 0)
      (def value (.o port: (begin (set! calls (+ 1 calls)) (error "unselected"))))
      (object-protocol-set! value
        (.o compute-slot: (lambda (_self next _slot) (.get source port) (next))))
      (check-equal? (.slot? value 'port) #t)
      (defvalues (result records) (snapshot (cut .slot? value 'port)))
      (check-equal? result #t)
      (check-equal? calls 0)
      (.put! source 'port 5433)
      (check-exception (replay-slot-reads! records (lambda (_self _key) (void))) stale?)
      (check-equal? calls 0))

    (test-case "replay refuses a supported callback write before changing the receiver"
      (def source (.o port: 5432))
      (defvalues (_result records) (snapshot (cut .get source port)))
      (def revision (object-revision source))
      (check-exception
        (replay-slot-reads! records (lambda (receiver key) (.put! receiver 'port 5433)))
        write-refused?)
      (check-equal? (.get source port) 5432)
      (check-equal? (object-revision source) revision))
    (test-case "warm values retain cold MOP slot preparation inputs"
      (def source (.o port: 5432))
      (def value (.o port: 5432))
      (object-protocol-set! value
        (.o compute-slot: (lambda (_self next _slot) (.get source port) (next))))
      (check-equal? (.get value port) 5432)
      (defvalues (result records) (snapshot (cut .get value port)))
      (check-equal? result 5432)
      (.put! source 'port 5433)
      (check-exception (replay-slot-reads! records (lambda (_self _key) (void))) stale?))))
