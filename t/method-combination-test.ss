(export method-combination-test)
(import :std/test :std/iter (only-in :std/values first-value)
        ../object ../support/option (only-in ../mop Any Bool define-type) (only-in ../number Integer)
        (prefix-in ../method-combination combination.) (prefix-in ../multimethod dispatch.)
        (prefix-in ../dispatch-extension extension.) (prefix-in ../declarative-metadata metadata.)
        (prefix-in ../cyclic-publication publication.) (prefix-in ../generic-family family.)
        (prefix-in ../examples/service-combination combined.) (prefix-in ../examples/service-bundle bundle.))
;; Capture only the test's refusal payload; it never becomes successful evidence.
(def (caught thunk) (try (thunk) #f (catch (cause) cause)))
;; The ordinary universal path selects all contributions in explicit insertion order.
(def path (list dispatch.any))
;; A lazy policy fixture detects eager evaluation of an unused empty result.
(define-type (UnusedEmpty. @ combination.sum) empty: (error "unused empty forced"))
;; Complete carrier/qualifier/effect-order/short-circuit and joint revision controls.
(def method-combination-test
  (test-suite "Appendix B native method combination alignment"
    (test-case "homogeneous items share policy order laziness and failure semantics"
      (def effects [])
      (def methods (list (lambda (x) (set! effects (cons 'first effects)) x)
        (lambda (x) (set! effects (cons 'second effects)) (+ x 1))))
      (def prepared (combination.prepare-simple-items combination.sum methods))
      (check-equal? effects []) (check-equal? (prepared '(3)) 7)
      (check-equal? (reverse effects) '(first second))
      (check-equal? ((combination.prepare-simple-items combination.collect methods) '(3)) '(3 4))
      (check-equal? ((combination.prepare-simple-items combination.sum []) []) 0)
      (check-equal? ((combination.prepare-simple-items UnusedEmpty. (list (lambda () 7))) []) 7)
      (check-exception ((combination.prepare-simple-items UnusedEmpty. []) []) true)
      (def later #f)
      (check-equal? ((combination.prepare-simple-items combination.all-policy
        (list (lambda () #f) (lambda () (set! later #t) (error "skipped item")))) []) #f)
      (check-equal? later #f)
      (check-exception ((combination.prepare-simple-items combination.sum
        (list (lambda () (error "item failure")) (lambda () (set! later #t) 2))) []) true)
      (check-equal? later #f))
    (test-case "prepared context binding preserves code caches guards and current typed data"
      (def bodies 0) (def guards 0) (def compilations 0)
      (def generic (dispatch.prepared-context
        (dispatch.make (list Integer) Integer (lambda (_) '((Reserve Object))))
        (lambda (methods)
          (set! compilations (+ compilations 1))
          (lambda (context args) (apply (car methods) context args))) Integer 10))
      (def code (dispatch.prepare-shape
        (dispatch.register generic (list (dispatch.prototype 'Reserve))
          (lambda (context units) (set! bodies (+ bodies 1)) (+ context units))) '((Reserve Object))))
      (def rebound (dispatch.bind-context code 20))
      (def outer (dispatch.register
        (dispatch.nested (list Integer) Any (lambda (_) '((Reserve Object))) code)
        (list (dispatch.prototype 'Reserve))
        (lambda (child units) (values 'invalid (dispatch.bind-context child 99)))))
      (check-exception (dispatch.call outer 2) true)
      (check-equal? compilations 1) (check-equal? bodies 0)
      (check (dispatch.index-shared? code rebound) => #t)
      (check-equal? (dispatch.effective-cache-size rebound) 1)
      (check-equal? (first-value (dispatch.call code 2)) 12)
      (check-equal? (first-value (dispatch.call rebound 3)) 23)
      (check-equal? (dispatch.reference-call rebound 4) 24)
      (check (eq? rebound (dispatch.bind-context rebound 20)) => #t)
      (check-exception (dispatch.bind-context rebound "invalid") true)
      (check-exception (dispatch.call rebound "invalid") true)
      (check-exception (dispatch.bind-context (dispatch.make [] Any (lambda (_) [])) 10) true)
      (def checked (extension.check rebound (list (extension.shape '((Forbidden))))))
      (check (extension.certificate? checked) => #t)
      (def guarded (dispatch.register-when rebound (list (dispatch.prototype 'Reserve))
        (lambda (units) (set! guards (+ guards 1)) (> units 0))
        (lambda (context units) (+ context units))))
      (def guarded-next (dispatch.bind-context guarded 30))
      (check-equal? (first-value (dispatch.call guarded-next 2)) 32)
      (check-equal? (first-value (dispatch.call guarded-next 3)) 33)
      (check-equal? guards 2)
      (check-exception (extension.check (dispatch.register rebound (list (dispatch.prototype 'Forbidden))
        (lambda (context units) (+ context units))) (list (extension.shape '((Forbidden))))) true))
    (test-case "sized and empty storage preserve duplicate support owner refusal and old versions"
      (for (storage (list family.methods.refresh<-sized-projection family.methods.refresh<-empty-storage))
      (def keys (cons 'first (for/collect (i (in-range 24)) (string->symbol (number->string i)))))
      (def model (.mix storage
        (.cc family.Model. keys: (cons 'first keys)
          projection: (.cc family.Projection.
            project: (lambda (key policy _) (list key policy))
            expand: (lambda (_ context) (values (cadr context) #f)))
          seed: (lambda (_ __ ___) (dispatch.make [] Any (lambda (_) [])))
          methods: (lambda (key policy _) (list (extension.register [] (lambda () (list key policy)))))
          watches: (lambda (_) []))))
      (def old (family.prepare model 10 #f))
      (check-equal? (length (family.family-keys old)) 25)
      (check-equal? (first-value (family.invoke old 'first)) '(first 10))
      (def same (family.refresh model old 10 #f))
      (check-equal? (family.family-built same) [])
      (check (eq? (family.family-ref same 'first) (family.family-ref old 'first)) => #t)
      ;; Same cardinality changes support; neither copied/pruned nor empty storage
      ;; may retain old-only keys or skip checking any current replacement.
      (def swapped (family.refresh (.cc model keys: (cons 'replacement (cdr keys))) same 20 #f))
      (check-equal? (length (family.family-built swapped)) 25)
      (check (family.family-has? swapped 'first) => #f)
      (check-equal? (first-value (family.invoke swapped 'replacement)) '(replacement 20))
      (check-equal? (first-value (family.invoke swapped (string->symbol "0"))) (list (string->symbol "0") 20))
      (def subset (family.refresh (.cc model keys: '(first)) same 20 #f))
      (check-equal? (family.family-keys subset) '(first))
      (check-equal? (first-value (family.invoke subset 'first)) '(first 20))
      (def empty (family.refresh (.cc model keys: []) same 20 #f))
      (check-equal? (family.family-keys empty) [])
      (check-exception (family.prepare (.cc model keys: '(first "invalid")) 20 #f) true)
      (check-exception (family.refresh (.cc model watches: (lambda (_) (list (extension.shape [])))) old 20 #f) true)
      (check-equal? (first-value (family.invoke old 'first)) '(first 10))))
    (test-case "binding runs no body and preserves three-level repeated effect order"
      (def trace [])
      ;; Test-only callback records the actual units and immutable bound context.
      (def (record label units view) (set! trace (cons (list label units view) trace)))
      (def methods (for/collect (name '(specific middle general))
        (combination.simula-body (lambda (units view) (record name units view))
          (lambda (units view) (record (list 'after name) units view)))))
      (def bound (combination.bind-simula methods 'current))
      (check-equal? trace [])
      (bound '(2)) (bound '(3))
      (def observed (reverse trace))
      (set! trace [])
      (combination.simula-effective methods '(2 current))
      (combination.simula-effective methods '(3 current))
      (check-equal? (reverse trace) observed))
    (test-case "bound Simula retains current arguments types failures and negative watches"
      (for (view (list (.o (capacity 10) (invoice "invoice:1") (release #t))
                       (.o (capacity 20) (invoice "invoice:2") (release #t))))
        (def bound (combined.bound-preflight view))
        (def reference (combined.context-preflight #t))
        (for (units '(1 2 3))
          (check-equal? (first-value (dispatch.call bound units))
            (first-value (dispatch.call reference units view)))
          (check-equal? (dispatch.reference-call bound units) (dispatch.reference-call reference units view)))
        (check-exception (dispatch.call bound -1) true)
        (check-exception (dispatch.call bound "2") true)
        (check-exception (dispatch.call bound 2 view) true)
        (check-exception (dispatch.call bound 100) true)
        (check-exception (extension.check (dispatch.register bound (list (dispatch.prototype 'Forbidden))
          (combination.simula-body void void)) (list (extension.shape '((Forbidden))))) true))
      (def first (combined.bound-preflight (.o (capacity 10) (invoice "one") (release #t))))
      (def later (combined.bound-preflight (.o (capacity 20) (invoice "two") (release #t))))
      (check (dispatch.index-shared? first later) => #t)
      (check-equal? (dispatch.effective-cache-size later) 1)
      (check-exception (combined.bound-preflight #f) true)
      (check-exception (dispatch.call (combined.bound-preflight (.o (capacity 20) (invoice "ok") (release #f))) 2) true)
      (check-exception (dispatch.call (combined.bound-preflight (.o (capacity 20) (invoice #f) (release #t))) 2) true))
    (test-case "sized and bound handoffs keep full owner checking then exact unchanged reuse"
      (for (model (list combined.sized-simula-model combined.bound-simula-model combined.empty-storage-simula-model))
        (def policy (.cc bundle.Policy. capacity: 10 price: 3 invoice: "invoice:1"))
        (defvalues (old issue) (combined.start model policy))
        (check-equal? issue #f)
        (defvalues (blocked blocked-issue) (combined.revise model old
          (.cc policy capacity: 20 invoice: "invoice:2" forbidden-cancel: #t)))
        (check (eq? blocked old) => #t)
        (check-equal? (publication.failure-stage blocked-issue) 'services)
        (check-equal? (first-value (publication.invoke old 'reserve 2)) '(ok 8 #t))
        (defvalues (next accepted) (combined.revise model old (.cc policy capacity: 20 invoice: "invoice:2")))
        (check-equal? accepted #f)
        (check-equal? (family.family-built (publication.version-family next)) '(quote reserve cancel))
        (check-equal? (first-value (publication.invoke next 'reserve 15)) '(ok 5 #t))
        (check (and (caught (cut publication.invoke old 'reserve 15)) #t) => #t)
        (defvalues (same same-issue) (combined.revise model next (.cc policy capacity: 20 invoice: "invoice:2")))
        (check-equal? same-issue #f)
        (check (eq? (family.family-ref (publication.version-family next) 'reserve)
          (family.family-ref (publication.version-family same) 'reserve)) => #t)
        (defvalues (later later-issue) (combined.revise model next (.cc policy capacity: 30 invoice: "invoice:3")))
        (check-equal? later-issue #f)
        (check-equal? (first-value (publication.invoke later 'reserve 25)) '(ok 5 #t))
        (check-equal? (first-value (publication.invoke next 'reserve 15)) '(ok 5 #t))
        (defvalues (held refused) (combined.revise model next (.cc policy forbidden-cancel: #t)))
        (check (eq? held next) => #t)
        (check-equal? (publication.failure-stage refused) 'services)
        (defvalues (budget-held budget-refused) (combined.revise model next (.cc policy cache-limit: 0)))
        (check (eq? budget-held next) => #t)
        (check-equal? (publication.failure-stage budget-refused) 'admission)))
    (test-case "staged Simula switches owners with full checking then reuses current dependencies"
      (def model (combined.simula-workflow-model))
      (def policy (.cc bundle.Policy. capacity: 10 price: 3 invoice: "invoice:1"))
      (defvalues (old issue) (combined.start model policy))
      (check-equal? issue #f)
      (def first (dispatch.nested-state (extension.snapshot (family.family-ref (publication.version-family old) 'reserve))))
      (check-equal? (dispatch.cache-size first) 0)
      (defvalues (_ warm) (publication.invoke old 'reserve 2))
      (defvalues (same same-issue) (combined.revise model warm policy))
      (check-equal? same-issue #f)
      ;; Different constructor owners require a complete first handoff, even
      ;; for equal contexts. A later unchanged revision uses ordinary reuse.
      (check-equal? (family.family-built (publication.version-family same)) '(quote reserve cancel))
      (defvalues (retained retain-issue) (combined.revise model same policy))
      (check-equal? retain-issue #f)
      (check (eq? (family.family-ref (publication.version-family same) 'reserve)
        (family.family-ref (publication.version-family retained) 'reserve)) => #t)
      (def next-policy (.cc policy capacity: 20 invoice: "invoice:2"))
      (defvalues (next accepted) (combined.revise model same next-policy))
      (check-equal? accepted #f)
      (def child (dispatch.nested-state (extension.snapshot (family.family-ref (publication.version-family next) 'reserve))))
      (check (eq? child first) => #f)
      (check-equal? (dispatch.effective-cache-size child) 1)
      (check-equal? (first-value (publication.invoke next 'reserve 15)) '(ok 5 #t))
      (check (and (caught (cut publication.invoke warm 'reserve 15)) #t) => #t)
      (defvalues (later later-issue) (combined.revise model next (.cc next-policy invoice: "invoice:3")))
      (check-equal? later-issue #f)
      (check (eq? child (dispatch.nested-state (extension.snapshot (family.family-ref (publication.version-family later) 'reserve)))) => #t)
      (check-equal? (first-value (publication.invoke later 'cancel "customer" #t)) '("customer" "invoice:3"))
      (defvalues (held refused) (combined.revise model later (.cc next-policy forbidden-cancel: #t)))
      (check (eq? held later) => #t)
      (check-equal? (publication.failure-stage refused) 'services))
    (test-case "factory binding preserves native projection contracts and actual child"
      (def template (combined.context-simula-template))
      (def first (combined.context-preflight #t))
      (def second (combined.context-preflight #t))
      (def bound (combined.compiled-context-simula-model first template))
      (def other (combined.compiled-context-simula-model second template))
      (def fresh (combined.compiled-context-simula-model first #f))
      (defvalues (initial cold-issue) (combined.start fresh (.cc bundle.Policy. capacity: 10 price: 3 invoice: "invoice:1")))
      (check-equal? cold-issue #f)
      (check-equal? (first-value (publication.invoke initial 'reserve 2)) '(ok 8 #t))
      (defvalues (changed change-issue) (combined.revise fresh initial (.cc bundle.Policy. capacity: 20 price: 3 invoice: "invoice:2")))
      (check-equal? change-issue #f)
      (check-equal? (first-value (publication.invoke changed 'reserve 15)) '(ok 5 #t))
      (check (and (caught (cut publication.invoke initial 'reserve 15)) #t) => #t)
      (check (eq? (.@ (.@ bound generics) projection) (.@ (.@ template generics) projection)) => #t)
      (check (eq? (.@ bound contract-source) (.@ template contract-source)) => #t)
      (check (eq? (.@ bound admit) (.@ template admit)) => #t)
      (def policy (.cc bundle.Policy. capacity: 10 price: 3 invoice: "invoice:1"))
      (defvalues (version issue) (combined.start bound policy))
      (defvalues (another failure) (combined.start other policy))
      (check-equal? issue #f) (check-equal? failure #f)
      (check (eq? (dispatch.nested-state (extension.snapshot (family.family-ref
        (publication.version-family version) 'reserve))) first) => #t)
      (check (eq? (dispatch.nested-state (extension.snapshot (family.family-ref
        (publication.version-family another) 'reserve))) second) => #t)
      (check (eq? first second) => #f)
      (check-equal? (first-value (publication.invoke version 'reserve 2)) '(ok 8 #t)))
    (test-case "compiled Simula sequence preserves repeated current arguments and failure prefix"
      (def trace [])
      (def (record label args) (set! trace (cons (cons label args) trace)))
      (def methods (for/collect (name '(specific middle general))
        (combination.simula-body (lambda args (record name args))
          (lambda args (record (list 'after name) args)))))
      (def compiled (combination.compile-simula methods))
      (check-equal? trace [])
      (compiled '(2 current)) (compiled '(3 revised))
      (def observed (reverse trace))
      (set! trace [])
      (combination.simula-effective methods '(2 current))
      (combination.simula-effective methods '(3 revised))
      (check-equal? (reverse trace) observed)
      (set! trace [])
      (def refusal (combination.compile-simula
        (list (combination.simula-body (lambda _ (error "stop")) (lambda _ (record 'unreachable [])))
          (combination.simula-body (lambda args (record 'general args)) (lambda _ (record 'unreachable []))))))
      (check (and (caught (cut refusal '(4 revoked))) #t) => #t)
      (check-equal? (reverse trace) '((general 4 revoked))))

    (test-case "standard effective ordering next and warm guards"
      (def trace [])
      (def (note value) (set! trace (cons value trace)))
      (def base (dispatch.standard (list Any) Any (lambda (_) '((Child Parent)))))
      (def parent (list (dispatch.prototype 'Parent)))
      (def child (list (dispatch.prototype 'Child)))
      (def generic
        (dispatch.contribute
          (dispatch.contribute
            (dispatch.contribute
              (dispatch.contribute
                (dispatch.contribute
                  (dispatch.register base parent (combination.primary (lambda (_ arg) (note 'base) (list arg))))
                  child (combination.primary (lambda (next _) (note 'primary) (cons 'child (next)))))
                child (combination.before (lambda (_) (note 'before-child))))
              parent (combination.before (lambda (_) (note 'before-parent))))
            child (combination.after (lambda (_) (note 'after-child))))
          parent (combination.after (lambda (_) (note 'after-parent)))))
      (def guarded (dispatch.register-when generic child (lambda (arg) (> arg 10))
        (combination.around (lambda (next _) (note 'around-in) (let (value (next)) (note 'around-out) value)))))
      (defvalues (result warm) (dispatch.call guarded 20))
      (check-equal? result '(child 20))
      (check-equal? (reverse trace) '(around-in before-child before-parent primary base after-parent after-child around-out))
      (set! trace [])
      (check-equal? (first-value (dispatch.call warm 1)) '(child 1))
      (check-equal? (reverse trace) '(before-child before-parent primary base after-parent after-child))
      (check-exception (dispatch.register base child (lambda (_) 1)) true)
      (check-exception (dispatch.register base child (combination.item (lambda (_) 1))) true))
    (test-case "simple policies short circuit empties options and around"
      (for ((policy (list combination.sum combination.collect combination.append-policy
                         combination.all-policy combination.any-policy combination.last-policy combination.maximum combination.minimum))
            (expected (list 0 [] [] #t #f #f #f #f)))
        (check-equal? (combination.simple-effective policy [] []) expected))
      (check-equal? (combination.simple-effective combination.last-policy (list (combination.item (lambda () #f))) []) (some #f))
      (check-equal? (combination.simple-effective combination.maximum
        (map (lambda (n) (combination.item (lambda () n))) '(-9 -2 -8)) []) (some -2))
      (def effects [])
      (def generic (dispatch.simple (list Any) Bool (lambda (_) '((Object))) combination.all-policy))
      (def tail (dispatch.register generic path (combination.item (lambda (_) (error "short circuit suffix ran")))))
      (def stopped (dispatch.contribute tail path (combination.item (lambda (_) (set! effects '(first)) #f))))
      (defvalues (result warm) (dispatch.call stopped 1))
      (check-equal? result #f)
      (check-equal? effects '(first))
      (check-equal? (first-value (dispatch.call warm 1)) #f)
      (check-exception (dispatch.register generic path (combination.before (lambda (_) #t))) true)
      (def with-around (list (combination.around (lambda (next) (+ 10 (next))))
                            (combination.item (lambda () 2)) (combination.item (lambda () 3))))
      (check-equal? (combination.simple-effective combination.sum with-around []) 15)
      (check-exception (combination.simple-effective combination.all-policy (list (combination.item (lambda () 'truthy))) []) true))
    (test-case "forward payload preserves dispatch and guards while checking replacements"
      (def resolutions 0)
      (def guards 0)
      (def trace [])
      (def (note value) (set! trace (cons value trace)))
      (def seed (dispatch.forwarding-standard Any Integer Integer
        (lambda (d) (set! resolutions (+ 1 resolutions)) (check-equal? d 'request) '((Child Parent)))))
      (def child (list (dispatch.prototype 'Child)))
      (def parent (list (dispatch.prototype 'Parent)))
      (def generic (metadata.install seed
        (list
          (metadata.replace "base" parent (combination.forward-primary (lambda (_ d p) (note (list 'base d p)) p)))
          (metadata.guarded "child" child (lambda (_ p) (set! guards (+ 1 guards)) (> p 0))
            (combination.forward-primary (lambda (next d p) (note (list 'primary d p)) (next (some (+ p 1))))))
          (metadata.contribute "before" child (combination.forward-before (lambda (_ p) (note (list 'before p)))))
          (metadata.contribute "after" child (combination.forward-after (lambda (_ p) (note (list 'after p)))))
          (metadata.contribute "around" child (combination.forward-around (lambda (next _ p) (next (some (+ p 10)))))))))
      (defvalues (result warm) (dispatch.call generic 'request 5))
      (check-equal? result 16)
      (check-equal? resolutions 1)
      (check-equal? guards 1)
      (check-equal? (reverse trace) '((before 15) (primary request 15) (base request 16) (after 15)))
      (check-equal? (first-value (dispatch.call warm 'request 0)) 10)
      (check-equal? guards 2)
      (set! trace [])
      (check-exception (extension.check generic (list (extension.shape '((Child Parent))))) true)
      (check-equal? trace [])
      (check-equal? guards 2)
      (def suffix-ran 0)
      (def invalid (dispatch.register
        (dispatch.register seed parent (combination.forward-primary
          (lambda (_ __ p) (set! suffix-ran (+ suffix-ran 1)) p))) child
        (combination.forward-primary (lambda (next _ __) (next (some "invalid"))))))
      (check-exception (dispatch.call invalid 'request 2) true)
      (check-equal? suffix-ran 0)
      (check-exception (dispatch.register seed child (combination.primary (lambda (_ __) 1))) true)
      (for ((replacement (list #f (some #f))) (expected '(#t #f)))
        (def optional (dispatch.forwarding-standard Any Bool Bool (lambda (_) '((Child)))))
        (def selected (dispatch.contribute
          (dispatch.register optional child (combination.forward-primary (lambda (_ __ p) p))) child
          (combination.forward-around (lambda (next _ __) (next replacement)))))
        (check-equal? (first-value (dispatch.call selected 'request #t)) expected)))
    (test-case "inner and Simula order omission failures and negative watches"
      (def trace [])
      (def (note value) (set! trace (cons value trace)))
      (def child (list (dispatch.prototype 'Child)))
      (def parent (list (dispatch.prototype 'Parent)))
      (def seed (dispatch.inner (list Any) Any (lambda (_) '((Child Parent))) (lambda (_) (note 'terminal) 7)))
      (def generic (dispatch.register (dispatch.register seed parent
        (lambda (inner _) (note 'parent-in) (let (value (inner)) (note 'parent-out) value))) child
        (lambda (inner _) (note 'child-in) (let (value (inner)) (note 'child-out) value))))
      (check-equal? (first-value (dispatch.call generic 0)) 7)
      (check-equal? (reverse trace) '(parent-in child-in terminal child-out parent-out))
      (set! trace [])
      (check-equal? (first-value (dispatch.call (dispatch.register generic parent (lambda (_ __) (note 'stop) 9)) 0)) 9)
      (check-equal? trace '(stop))
      (def simulation (dispatch.simula (list Any) (lambda (_) '((Child Parent)))))
      (def bodies (dispatch.register (dispatch.register simulation parent
        (combination.simula-body (lambda (_) (note 'parent-prefix)) (lambda (_) (note 'parent-suffix)))) child
        (combination.simula-body (lambda (_) (note 'child-prefix)) (lambda (_) (note 'child-suffix)))))
      (set! trace [])
      (dispatch.call bodies 0)
      (check-equal? (reverse trace) '(parent-prefix child-prefix child-suffix parent-suffix))
      (set! trace [])
      (check-exception (extension.check bodies (list (extension.shape '((Child Parent))))) true)
      (check-equal? trace [])
      (def failing (dispatch.register bodies child
        (combination.simula-body (lambda (_) (note 'failure) (error "prefix failed")) (lambda (_) (error "suffix ran")))))
      (check-exception (dispatch.call failing 0) true)
      (check-equal? (reverse trace) '(parent-prefix failure)))
    (test-case "prepared resolution reuses only unconditional effective methods"
      (def preparations 0)
      (def bodies 0)
      (def seed (dispatch.make (list Integer) Integer (lambda (_) '((Object)))))
      (def generic (dispatch.prepared
        (dispatch.register seed path (lambda (n) (set! bodies (+ bodies 1)) (+ n 1)))
        (lambda (methods)
          (set! preparations (+ preparations 1))
          (lambda (args) (apply (car methods) args)))))
      (defvalues (first warm) (dispatch.call generic 2))
      (check-equal? first 3)
      (check-equal? preparations 1)
      (check-equal? (dispatch.effective-cache-size warm) 1)
      (defvalues (second hot) (dispatch.call warm 5))
      (check-equal? second 6)
      (check (eq? warm hot) => #t)
      (check-equal? preparations 1)
      (check-equal? bodies 2)
      (check-exception (dispatch.call hot "bad") true)
      (check-equal? bodies 2)
      (def guarded (dispatch.register-when hot path (lambda (n) (> n 10)) (lambda (_) 99)))
      (check-equal? (dispatch.effective-cache-size guarded) 0)
      (defvalues (yes guarded-warm) (dispatch.call guarded 20))
      (check-equal? yes 99)
      (check-equal? (first-value (dispatch.call guarded-warm 1)) 2)
      (check-equal? (dispatch.effective-cache-size guarded-warm) 0)
      (check-equal? preparations 3)
      (def erased (dispatch.erase hot path))
      (check-equal? (dispatch.cache-size erased) 0)
      (check-exception (dispatch.call erased 1) true)
      (check-exception (extension.check hot (list (extension.shape '((Object))))) true))
    (test-case "declared shape preparation executes no bodies guards or invented arguments"
      (def compilations 0)
      (def bodies 0)
      (def resolutions 0)
      (def guards 0)
      (def exact (list (dispatch.prototype 'Object)))
      (def generic (dispatch.prepared
        (dispatch.register (dispatch.make (list Integer) Integer
          (lambda (_) (set! resolutions (+ 1 resolutions)) '((Object)))) exact
          (lambda (n) (set! bodies (+ bodies 1)) (+ n 1)))
        (lambda (methods) (set! compilations (+ 1 compilations)) (lambda (args) (apply (car methods) args)))))
      (def protected (extension.check generic (list (extension.shape '((Forbidden))))))
      (def ready (extension.prepare-shape protected '((Object))))
      (check-equal? (list compilations bodies resolutions guards) '(1 0 0 0))
      (check (eq? (extension.prepare-shape ready '((Object))) ready) => #t)
      (check-exception (extension.invoke ready "invalid") true)
      (check-equal? (list compilations bodies resolutions) '(1 0 0))
      (defvalues (one ignored) (extension.invoke ready 1))
      (defvalues (two ignored-again) (extension.invoke ready 5))
      (check-equal? (list one two compilations bodies resolutions) '(2 6 1 2 2))
      (check (eq? ignored ready) => #t)
      (check (eq? ignored-again ready) => #t)
      ;; Discarded admission probes on an unprepared owner repeat construction.
      (dispatch.call generic 1)
      (dispatch.call generic 2)
      (check-equal? compilations 3)
      (def guarded (dispatch.register-when (extension.snapshot ready) exact
        (lambda (n) (set! guards (+ 1 guards)) (> n 10)) (lambda (_) 99)))
      (check (eq? (dispatch.prepare-shape guarded '((Object))) guarded) => #t)
      (check-equal? guards 0)
      (defvalues (accepted guarded-warm) (dispatch.call guarded 20))
      (check-equal? accepted 99)
      (check-equal? (first-value (dispatch.call guarded-warm 1)) 2)
      (check-equal? guards 2)
      (check-equal? (dispatch.effective-cache-size guarded-warm) 0)
      (check-exception (dispatch.prepare-shape guarded '((Object) (Object))) true)
      (defvalues (held refused) (extension.publish ready
        (list (extension.register (list (dispatch.prototype 'Forbidden)) (lambda (_) 0)))))
      (check (eq? held ready) => #t)
      (check-equal? (extension.failure-stage refused) 'negative))
    (test-case "shape preparation retains bounded caches and actual C4 dispatch"
      (def generic (dispatch.prepared-simula (list Integer) (lambda (_) '((Object)))))
      (def shapes (map (lambda (name) (list (list name))) '(A B C D E F G H I)))
      (def ready (for/fold (current generic) (shape shapes) (dispatch.prepare-shape current shape)))
      (check-equal? (dispatch.cache-size ready) dispatch.cache-capacity)
      (check-equal? (dispatch.effective-cache-size ready) dispatch.cache-capacity)
      ;; An unrelated declaration cannot replace the current argument's C4 lookup.
      (def exact (list (dispatch.prototype 'Object)))
      (def installed (dispatch.register ready exact
        (combination.simula-body (lambda (n) (unless (> n 0) (error "current guard"))) (lambda (_) (void)))))
      (def unrelated (dispatch.prepare-shape installed '((Unrelated))))
      (check-exception (dispatch.call unrelated -1) true)
      (check-exception (extension.check unrelated (list (extension.shape '((Object))))) true))
    (test-case "all prepared combinations preserve current arguments and effects"
      (def reference (dispatch.standard (list Integer) Integer (lambda (_) '((Object)))))
      (def compiled (dispatch.prepared-standard (list Integer) Integer (lambda (_) '((Object)))))
      (def methods (list
        (metadata.replace "primary" path (combination.primary (lambda (_ n) (+ n 1))))
        (metadata.contribute "repeat" path (combination.around (lambda (next _) (+ (next) (next)))))))
      (defvalues (value warm) (dispatch.call (metadata.install compiled methods) 3))
      (check-equal? value 8)
      (check-equal? (first-value (dispatch.call warm 7))
                    (first-value (dispatch.call (metadata.install reference methods) 7)))
      (def short (dispatch.prepared-simple (list Integer) Bool (lambda (_) '((Object))) combination.all-policy))
      (def stop (dispatch.contribute
        (dispatch.register short path (combination.item (lambda (_) (error "suffix executed"))))
        path (combination.item (lambda (_) #f))))
      (defvalues (stopped short-warm) (dispatch.call stop 1))
      (check-equal? stopped #f)
      (check-equal? (first-value (dispatch.call short-warm 2)) #f)
      (def inherited (dispatch.prepared-inner (list Integer) Integer (lambda (_) '((Child Parent))) (lambda (args) (car args))))
      (def descending (dispatch.register (dispatch.register inherited (list (dispatch.prototype 'Child))
        (lambda (inner _) (+ 1 (inner)))) (list (dispatch.prototype 'Parent)) (lambda (inner _) (* 2 (inner)))))
      (defvalues (old-value inherited-warm) (dispatch.call descending 3))
      (check-equal? old-value 8)
      (check-equal? (first-value (dispatch.call inherited-warm 5)) 12)
      (def trace [])
      ;; Test-local observer records exact current values and phase order.
      (def (note value) (set! trace (cons value trace)))
      (def simulation (dispatch.register (dispatch.prepared-simula (list Integer) (lambda (_) '((Object)))) path
        (combination.simula-body (lambda (n) (note (list 'prefix n)) (when (< n 0) (error "prefix refused")))
                                (lambda (n) (note (list 'suffix n))))))
      (defvalues (unit simulation-warm) (dispatch.call simulation 1))
      (dispatch.call simulation-warm 2)
      (check-equal? (reverse trace) '((prefix 1) (suffix 1) (prefix 2) (suffix 2)))
      (set! trace [])
      (check-exception (dispatch.call simulation-warm -1) true)
      (check-equal? trace '((prefix -1)))
      (def forward (dispatch.contribute
        (dispatch.register (dispatch.prepared-forwarding-standard Any Integer Integer (lambda (_) '((Object)))) path
          (combination.forward-primary (lambda (_ __ n) n))) path
        (combination.forward-around (lambda (next _ n) (next (some (+ n 2)))))))
      (defvalues (enriched forward-warm) (dispatch.call forward 'request 3))
      (check-equal? enriched 5)
      (check-equal? (first-value (dispatch.call forward-warm 'request 9)) 11)
      (def invalid (dispatch.contribute forward-warm path
        (combination.forward-around (lambda (next _ __) (next (some "invalid"))))))
      (check-exception (dispatch.call invalid 'request 1) true))
    (test-case "prepared simple policy preserves lazy empty under items and skipped around"
      (def seed (dispatch.prepared-simple (list Integer) Integer (lambda (_) '((Object))) UnusedEmpty.))
      (def one (dispatch.register seed path (combination.item (lambda (n) n))))
      (defvalues (result warm) (dispatch.call one 3))
      (check-equal? result 3)
      (check-equal? (first-value (dispatch.call warm 5)) 5)
      (def skipped (dispatch.register seed path (combination.around (lambda (_ __) 42))))
      (check-equal? (first-value (dispatch.call skipped 3)) 42)
      (check-exception (dispatch.call seed 1) true))
    (test-case "nested successors traverse multiple owners without editing definitions"
      (def exact (list (dispatch.prototype 'Object)))
      (def leaf (dispatch.register (dispatch.prepared-standard (list Integer) Integer (lambda (_) '((Object)))) path
        (combination.primary (lambda (_ n) (+ n 1)))))
      ;; Explicit functional child invocation composes values and cache successors.
      (def (relay child n) (dispatch.call child n))
      (def middle (dispatch.register (dispatch.nested (list Integer) Integer (lambda (_) '((Object))) leaf) exact relay))
      (def outer (dispatch.register (dispatch.nested (list Integer) Integer (lambda (_) '((Object))) middle) exact relay))
      (def protected (extension.check outer (list (extension.shape '((Forbidden))))))
      (defvalues (result warm) (extension.invoke protected 2))
      (def snapshot (extension.snapshot warm))
      (check-equal? result 3)
      (check-equal? (dispatch.effective-cache-size snapshot) 1)
      (check-equal? (dispatch.effective-cache-size (dispatch.nested-state snapshot)) 1)
      (check-equal? (dispatch.effective-cache-size (dispatch.nested-state (dispatch.nested-state snapshot))) 1)
      (check (dispatch.index-shared? outer snapshot) => #t)
      (defvalues (current hot) (extension.invoke warm 8))
      (check-equal? current 9)
      (check (eq? hot warm) => #t)
      (check-equal? (dispatch.cache-size (dispatch.nested-state outer)) 0)
      (def edited (dispatch.register snapshot path
        (lambda (child n) (values n (dispatch.erase child path)))))
      (check-exception (dispatch.call edited 1) true)
      ;; Changing a child's invoker is a definition change even with the same index.
      (def disguised (dispatch.register snapshot path
        (lambda (child n) (values n (dispatch.prepared child (lambda (_) (lambda (_) 99)))))))
      (check-exception (dispatch.call disguised 1) true)
      (check-exception (extension.check snapshot (list (extension.shape '((Object))))) true))
    (test-case "prepared Simula publication probes preserve owners and current revisions"
      (def policy (.cc bundle.Policy. capacity: 10 price: 3 invoice: "invoice:1"))
      ;; Declared entries are real state: zero budget refuses cold publication too.
      (defvalues (cold-zero cold-refusal) (combined.start combined.shape-prepared-simula-model (.cc policy cache-limit: 0)))
      (check-equal? cold-zero #f)
      (check-equal? (publication.failure-stage cold-refusal) 'admission)
      (for (model (list combined.child-prepared-simula-model combined.shape-prepared-simula-model combined.context-prepared-simula-model combined.compiled-context-model))
        (defvalues (old issue) (combined.start model policy))
        (check-equal? issue #f)
        (def generic (extension.snapshot (family.family-ref (publication.version-family old) 'reserve)))
        (check-equal? (dispatch.effective-cache-size (dispatch.nested-state generic)) 1)
        (check-equal? (publication.probe old 'reserve 2) '(ok 8 #t))
        (check-equal? (publication.probe old 'reserve 3) '(ok 7 #t))
        (defvalues (answer next) (publication.invoke old 'reserve 4))
        (check-equal? answer '(ok 6 #t))
        (check (eq? old next) => (and (memq model (list combined.shape-prepared-simula-model combined.context-prepared-simula-model combined.compiled-context-model)) #t))
        (defvalues (revised accepted) (combined.revise model next (.cc policy capacity: 20 invoice: "invoice:2")))
        (check-equal? accepted #f)
        (when (eq? model combined.context-prepared-simula-model)
          (check (eq? (dispatch.nested-state generic)
            (dispatch.nested-state (extension.snapshot (family.family-ref (publication.version-family revised) 'reserve)))) => #t))
        (defvalues (revised-answer warm-revised) (publication.invoke revised 'reserve 15))
        (check-equal? revised-answer '(ok 5 #t))
        (check-equal? (first-value (publication.invoke revised 'cancel "customer" #t)) '("customer" "invoice:2"))
        (check-exception (publication.invoke next 'reserve 15) true)
        (defvalues (held refusal) (combined.revise model warm-revised (.cc policy capacity: 20 invoice: "invoice:2" cache-limit: 0)))
        (check (eq? held warm-revised) => #t)
        (check-equal? (publication.failure-stage refusal) 'admission)))
    (test-case "one Simula definition validates each current typed context"
      (def program (combined.context-preflight))
      (def allowed (.o (capacity 10) (invoice "invoice:1") (release #t)))
      (def smaller (.o (capacity 1) (invoice "invoice:2") (release #t)))
      (def revoked (.o (capacity 20) (invoice "invoice:3") (release #f)))
      (defvalues (unit same) (dispatch.call program 2 allowed))
      (check (eq? program same) => #t)
      (check-exception (dispatch.call same 2 smaller) true)
      (check-exception (dispatch.call same 2 revoked) true)
      (check-exception (dispatch.call same 2 "not a view") true)
      (check-exception (dispatch.call same 2 (.o (capacity 20) (invoice #f) (release #t))) true)
      (check-equal? (dispatch.effective-cache-size program) 1)
      (check-exception (extension.check program (list (extension.shape '((Reserve Object))))) true))
    (test-case "negative checking inspects qualified data without invoking bodies"
      (def executed 0)
      (def generic (dispatch.standard (list Any) Any (lambda (_) '((Object)))))
      (def installed (dispatch.register generic path (combination.primary (lambda (_ arg) (set! executed (+ 1 executed)) arg))))
      (def conflict (caught (cut extension.check installed (list (extension.shape '((Object)))))))
      (check (extension.conflict? conflict) => #t)
      (check-equal? executed 0)
      (check-equal? (first-value (dispatch.call installed 7)) 7))
    (test-case "qualified standard and simple services compose with contract specialization and joint approval"
      (for (model (list combined.standard-model combined.simple-model combined.forwarding-model combined.inner-model combined.simula-model
                    combined.compiled-forwarding-model combined.compiled-simula-model combined.prepared-forwarding-model combined.prepared-simula-model
                    combined.child-prepared-simula-model combined.shape-prepared-simula-model combined.context-prepared-simula-model combined.compiled-context-model))
        (def policy (.cc bundle.Policy. capacity: 10 price: 3 invoice: "invoice:1"))
        (defvalues (old issue) (combined.start model policy))
        (check-equal? issue #f)
        (defvalues (reserved warm) (publication.invoke old 'reserve 2))
        (check-equal? reserved '(ok 8 #t))
        ;; Enrichment and preflight add an invoice dependency to reserve; an
        ;; invoice-only revision must rebuild that generic, retaining quote.
        (defvalues (invoice-only invoice-issue) (combined.revise model warm (.cc policy invoice: "invoice:2")))
        (check-equal? invoice-issue #f)
        (def enriched? (memq model (list combined.forwarding-model combined.simula-model combined.compiled-forwarding-model combined.compiled-simula-model
          combined.prepared-forwarding-model combined.prepared-simula-model
                    combined.child-prepared-simula-model combined.shape-prepared-simula-model combined.context-prepared-simula-model combined.compiled-context-model)))
        (check-equal? (family.family-built (publication.version-family invoice-only))
          (if enriched? '(reserve cancel) '(cancel)))
        (check-equal? (first-value (publication.invoke invoice-only 'reserve 2)) '(ok 8 #t))
        (defvalues (revised accepted) (combined.revise model warm (.cc policy capacity: 20 invoice: "invoice:2")))
        (check-equal? accepted #f)
        (check-equal? (first-value (publication.invoke revised 'reserve 3)) '(ok 17 #t))
        (check-equal? (first-value (publication.invoke revised 'cancel "customer" #t)) '("customer" "invoice:2"))
        (defvalues (held refused) (combined.revise model warm (.cc policy cache-limit: 0)))
        (check (eq? held warm) => #t)
        (check-equal? (publication.failure-stage refused) 'admission)
        (defvalues (protected negative) (combined.revise model warm (.cc policy forbidden-cancel: #t)))
        (check (eq? protected warm) => #t)
        (check-equal? (publication.failure-stage negative) 'services)
        (check-equal? (family.failure-key (publication.failure-cause negative)) 'cancel)
        (check-equal? (family.failure-stage (publication.failure-cause negative)) 'negative)))))
