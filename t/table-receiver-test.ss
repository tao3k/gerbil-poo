;;; Receiver-bound collection styles use the same guarded FUN ownership engine.
(export table-receiver-test)
(import :std/test :std/error :std/iter
        (only-in ../brace @@method) ../object ../mop ../number ../type ../table ../rationaldict
        (prefix-in ../examples/service-collection service.))

;; Check the protocol's refusal cause rather than accepting unrelated exceptions.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; All five style presentations share snapshots and exact Function identities.
(def table-receiver-test
  (test-suite "posh and classy collection derivation"
    (test-case "all twenty-five transfers preserve roots and retire owned aliases"
      (def table (RationalDict (Fun Integer <- Integer)))
      (def f (validate (Fun Integer <- Integer) (lambda (x) (+ x 1))))
      (def base (.call table .acons 1 f (.@ table .empty)))
      (def styles (table-styles table))
      (for (source '(Pure Mutable Linear Posh Classy))
        (for (target '(pure mutable linear posh classy))
          (def from (.ref styles source))
          (def to (.ref styles (case target
            ((pure) 'Pure) ((mutable) 'Mutable) ((linear) 'Linear)
            ((posh) 'Posh) ((classy) 'Classy))))
          (def before (.call from .ap base))
          (def after (.call from .convert before target))
          (check (eq? base (.call to .unap after)) => #t)
          (check (eq? f (.call table .ref (.call to .unap after) 1)) => #t)
          (check-exception ((.call table .ref (.call to .unap after) 1) "bad") TypeError?)
          (if (memq source '(Pure Posh))
            (check (eq? base (.call from .unap before)) => #t)
            (check-exception (.call from .unap before) (message? "consumed table reference"))))))
    (test-case "host method dispatch follows pure successors and mutable identity"
      (def table (RationalDict Integer))
      (def styles (table-styles table))
      (def posh (.call (.@ styles Posh) .ap (.@ table .empty)))
      (def next (@@method posh.acons 1 10))
      (check (eq? posh next) => #f)
      (check-equal? (@@method posh.count) 0)
      (check-equal? (@@method next.ref 1) 10)
      (check-equal? (@@method next.ref 9 (lambda () 'missing)) 'missing)
      (def classy (@@method next.convert 'classy))
      (check (eq? classy (@@method classy.acons 2 20)) => #t)
      (check-equal? (@@method classy.list<-) '((1 . 10) (2 . 20)))
      (check (eq? classy (@@method classy.remove 1)) => #t)
      (check-equal? (@@method classy.count) 1)
      (check-equal? (@@method next.count) 1)
      (check-equal? (@@method classy.bind (cut .call table .count <>)) 1))
    (test-case "failure preserves receivers while reentrant winners invalidate staged writes"
      (def table (RationalDict Integer))
      (def styles (table-styles table))
      (def input (.call (.@ styles Classy) .ap (.@ table .empty)))
      (def before (@@method input.snapshot))
      (check-exception (@@method input.step (lambda (_) 17)) TypeError?)
      (check (eq? before (@@method input.snapshot)) => #t)
      (def cause (list 'callback-failure))
      (check (eq? (try (@@method input.step (lambda (_) (raise cause))) #f
        (catch (error) error)) cause) => #t)
      (check (eq? before (@@method input.snapshot)) => #t)
      (check-exception (@@method input.convert 'unknown) (message? "unknown table style"))
      (check-exception (@@method input.step (lambda (value)
        (@@method input.acons 1 10) (.call table .acons 2 20 value)))
        (message? "stale table reference"))
      (check-equal? (@@method input.list<-) '((1 . 10)))
      (check (eq? input (@@method input.acons 2 20)) => #t)
      (def linear (@@method input.convert 'linear))
      (check-exception (@@method input.snapshot) (message? "consumed table reference"))
      (def successor (.call (.@ styles Linear) .convert linear 'classy))
      (check-equal? (@@method successor.count) 2))
    (test-case "explicit receiver admission wraps raw Functions before observation"
      (def table (RationalDict (Fun Integer <- Integer)))
      (def styles (table-styles table))
      (for (name '(Posh Classy))
        (def input (.call (.ref styles name) .admit
          (.call table .acons 1 (lambda (_) "bad") (.@ table .empty))))
        (def wrapped (@@method input.ref 1))
        (check-exception (wrapped 7) TypeError?)
        (check (eq? wrapped (.call table .ref (@@method input.snapshot) 1)) => #t)))
    (test-case "foreign receiver provenance refuses before callbacks and metadata stays guarded"
      (def table (RationalDict Integer))
      (def family (table-styles table))
      (def input (.call (.@ family Posh) .ap (.@ table .empty)))
      (def calls 0)
      (for (style (list (.@ family Classy) (.@ (table-styles table) Posh)))
        (check-exception (.call style .step input (lambda (value)
          (set! calls (+ calls 1)) value)) (message? "incompatible table receiver")))
      (check-equal? calls 0)
      (.set! table Value Integer)
      (check-exception (@@method input.snapshot) (message? "stale table styles")))
    (test-case "derived Function ledger composes batches failure retry and Reader IO"
      (def table (service.make-mirrored-ledger))
      (def f (validate (Fun Integer <- Integer) (lambda (x) (+ x 1))))
      (def base (.call table .acons -1 (cons 100 f) (.@ table .empty)))
      (def after (.call table .acons -1 (cons 80 f) base))
      (def last (.call table .acons -2 (cons 50 f) after))
      (def batch (list (.call table .diff base after) (.call table .diff after last)))
      (def calls 0)
      (def result (service.revise-ledger-receivers table base batch
        (lambda (snapshot) (set! calls (+ calls 1)) snapshot)))
      (check-equal? calls 1)
      (check (eq? f (cdr (.call table .ref result -1))) => #t)
      (check-equal? (.call table .count result) 2)
      (check-equal? (car (.call table .ref base -1)) 100)
      (check-exception (service.revise-ledger-receivers table base (append batch batch)
        (lambda (_) (set! calls (+ calls 1)))) table-conflict?)
      (check-equal? calls 1)
      (def classy (.call (.@ (table-styles table) Classy) .ap base))
      (check (eq? classy (@@method classy.apply-batch batch)) => #t)
      (def inverse (invert-table-delta (.call table .compose-deltas batch)))
      (@@method classy.apply-delta inverse)
      (check-equal? (.call table .count (@@method classy.snapshot)) 1)
      (check (eq? f (cdr (@@method classy.ref -1))) => #t)
      (check-equal? (car (@@method classy.ref -1)) 100))))
