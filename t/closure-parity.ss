;;; Native source-bound counter comparison; duplicate/failed inputs fail closed.
(export main)
(import :std/iter "closure-benchmark-support.ss")
(def key-fields '("family" "n" "width" "seed" "scope" "trial" "queue"))
(def fields '("pops" "evals" "nodes" "writes" "pushes" "edges" "copied_queue" "frame_allocations"
              "queue_pairs" "empty_schedules" "shared_schedules" "inline_schedules" "selected_fee"
              "engine" "policy_charge" "append_ceiling" "chunk_ceiling" "hybrid_ceiling"
              "cache_mode" "construction_nodes" "index_links" "selector_visits" "setup_selector_visits"))
(def (row-key row) (map (cut hash-ref row <>) key-fields))
(def (admit receipt runtime)
  (unless (and (equal? (hash-ref receipt "runtime") runtime) (= (hash-ref receipt "schema") 4)) (error "runtime/schema"))
  (def rows (hash-ref receipt "rows"))
  (unless (= (length rows) 960) (error "incomplete matrix"))
  (def seen (make-hash-table))
  (for (row rows)
    (unless (equal? (hash-ref row "status") "pass") (error "nonpassing row"))
    (def key (row-key row))
    (when (hash-key? seen key) (error "duplicate key" key))
    (hash-put! seen key row))
  seen)
(def (main lean-path scheme-path output (lean-root #f))
  (def lean (read-receipt lean-path))
  (def scheme (read-receipt scheme-path))
  (def left (admit lean "lean"))
  (def right (admit scheme "scheme"))
  (when lean-root
    (for (pair (list (cons lean lean-root) (cons scheme ".")))
      (hash-for-each (lambda (name digest)
                       (unless (equal? digest (file-sha (string-append (cdr pair) "/" name)))
                         (error "stale source" name))) (hash-ref (car pair) "source_sha256"))))
  (hash-for-each (lambda (key row)
                   (def peer (hash-ref right key))
                   (for (field fields)
                     (unless (equal? (hash-ref row field) (hash-ref peer field)) (error "counter mismatch" key field)))) left)
  (write-receipt output (hash ("schema" 4) ("observations" 960) ("assertions" (* 960 (length fields)))
                              ("fields" fields) ("status" "pass")
                              ("lean_receipt_sha256" (file-sha lean-path)) ("scheme_receipt_sha256" (file-sha scheme-path))
                              ("lean_source_sha256" (hash-ref lean "source_sha256"))
                              ("scheme_source_sha256" (hash-ref scheme "source_sha256"))
                              ("boundary" "Finite source-level controls, not a Scheme translation or machine-time proof.")))
  (displayln "CLOSURE-NATIVE-PARITY-OK observations=960 assertions=" (* 960 (length fields))))
