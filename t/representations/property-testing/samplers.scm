;; Shared typed helpers must honor the caller's active scope at every primitive
;; observation. The standard CLI can focus this suite; full discovery is unchanged.
(def sampler-scope-test
  (test-suite "typed sampler preparation and aggregate scopes"
    (test-case "Map captures Key before Value even when the finite domain is empty"
      (for (keys (list [] '(left right)))
        (def validations 0)
        (def Key (.cc Symbol .validate: (lambda (value) (set! validations (1+ validations)) value)))
        (def descriptor (Map Key -> Integer))
        (.putslot! descriptor 'Value ($self-slot-spec (lambda (_self)
          (.set! Key sexp 'retired-Key) Integer)))
        (check-exception (map-generator descriptor keys (generator Integer)) generation-refusal?)
        (check-equal? validations 0)))
    (test-case "Map roots and declared dependencies precede computed metadata"
      (for (stage '(descriptor dependency))
        (def owner (.o epoch: 0)) (def later 0)
        (def descriptor (Map Symbol -> Integer))
        (.putslot! descriptor 'Key ($self-slot-spec (lambda (_self)
          (if (eq? stage 'descriptor) (.putslot! descriptor 'epoch ($constant-slot-spec 1))
            (.set! owner epoch 1)) Symbol)))
        (.putslot! descriptor 'Value ($self-slot-spec (lambda (_self) (set! later (1+ later)) Integer)))
        ;; The object computation guard already refuses self-mutation. Preserve
        ;; its original error; a different declared owner uses stale admission.
        (check-exception (map-generator descriptor '(left) (generator Integer) dependencies: (list owner))
          (if (eq? stage 'descriptor)
            (lambda (cause) (and (Error? cause) (equal? (Error-message cause) "object mutation during computation")))
            generation-refusal?))
        (check-equal? later 0)))
    (test-case "Map sampler validation cannot retire its request then enter Key"
      (def descriptor (Map Symbol -> Integer)) (def later 0)
      (def supplied (.cc (generator Integer)))
      (.putslot! supplied 'sources ($self-slot-spec (lambda (_self)
        (.putslot! descriptor 'epoch ($constant-slot-spec 1)) [])))
      (.putslot! descriptor 'Key ($self-slot-spec (lambda (_self) (set! later (1+ later)) Symbol)))
      (check-exception (map-generator descriptor '(left) supplied) generation-refusal?)
      (check-equal? later 0))
    (test-case "Map request spines retain original keys and dependency identities"
      (def owner (.o epoch: 0)) (def replacement (.o epoch: 0))
      (def keys (list 'left)) (def dependencies (list owner))
      (def descriptor (Map Symbol -> Integer))
      (.putslot! descriptor 'Key ($self-slot-spec (lambda (_self)
        (set-car! keys 'late) (set-car! dependencies replacement) Symbol)))
      (def maps (map-generator descriptor keys (generator Integer) dependencies: dependencies))
      (def value (core.sample-value (core.generate (generator-core maps) (lambda (_) 0) 3)))
      (check (hash-key? value 'left) => #t)
      (check (hash-key? value 'late) => #f)
      (.set! owner epoch 1)
      (check-exception (core.generate (generator-core maps) (core.random-at 0) 0) core.stale-generation?))
    (test-case "Map metadata exceptions preserve false causes and fresh preparation retries"
      (for (cause (list #f (cons 'metadata 'fault)))
        (def Key (.cc Symbol)) (def descriptor (Map Key -> Integer))
        (def supplied (generator Integer))
        (.putslot! descriptor 'Value ($self-slot-spec (lambda (_self)
          (.set! Key sexp 'changed-before-cause) (raise cause))))
        (check-eq? (with-catch identity (lambda () (map-generator descriptor '(left) supplied) 'missed)) cause)
        (.putslot! descriptor 'Value ($constant-slot-spec Integer))
        (def fresh (map-generator descriptor '(left) supplied))
        (standard.require-property-passed (check-property descriptor (cut element? descriptor <>)
          sampler: fresh seed: 42 cases: 5 size: 3))))
    (test-case "Map transient epoch checking never re-enters its sampler observer"
      (def calls 0)
      (def supplied (.cc (generator Integer) .current?: (lambda ()
        (set! calls (1+ calls))
        (when (> calls 100) (error "recursive sampler observer"))
        (core.with-sources [] #t))))
      (map-generator (Map Symbol -> Integer) '(left) supplied)
      (check (> calls 0) => #t)
      (check (<= calls 100) => #t)
      ;; A true observer result cannot authorize metadata after retiring a root.
      (def later 0) (def descriptor (Map Symbol -> Integer))
      (def retiring (.cc (generator Integer) .current?: (lambda ()
        (.putslot! descriptor 'epoch ($constant-slot-spec 1)) #t)))
      (.putslot! descriptor 'Key ($self-slot-spec (lambda (_self) (set! later (1+ later)) Symbol)))
      (check-exception (map-generator descriptor '(left) retiring) generation-refusal?)
      (check-equal? later 0)
      ;; Post-checking must not coerce a non-Boolean observer result to true.
      (def invalid-descriptor (Map Symbol -> Integer))
      (.putslot! invalid-descriptor 'Key ($self-slot-spec (lambda (_self) (set! later (1+ later)) Symbol)))
      (def invalid (.cc (generator Integer) .current?: (lambda () 'truthy)))
      (check-exception (map-generator invalid-descriptor '(left) invalid)
        (lambda (cause) (and (Error? cause) (equal? (Error-message cause) "source observer must return a boolean"))))
      (check-equal? later 0))
    (test-case "service directory preparation and retained FUN reports share Map authority"
      (def owner (.o epoch: 0)) (def costs 0)
      (def cell (Record amount: [UInt] handler: [(Function [Integer] [Integer])]))
      (def Key (.cc (Enum left right))) (def descriptor (Map Key -> cell))
      (def configuration (make-instance PropertyConfiguration seed: 17 cases: 1 size: 3 shrink-budget: 30))
      (.putslot! descriptor 'Value ($self-slot-spec (lambda (_self) (.set! Key sexp 'retired) cell)))
      (check-exception (collection.map-service-action descriptor cell owner
        (lambda (_) (set! costs (1+ costs))) identity) generation-refusal?)
      (check-equal? costs 0)
      (.putslot! descriptor 'Value ($constant-slot-spec cell))
      (def action (collection.map-service-action descriptor cell owner
        (lambda (_) (set! costs (1+ costs))) identity))
      (def report (action configuration))
      (check-eq? (.get report status) 'failed)
      (def witness (.get report counterexample))
      (check-equal? (map (lambda (key) (.get (hash-ref witness key) amount)) '(left right)) '(0 0))
      (check-exception ((.@ (hash-ref witness 'left) handler) 'bad) TypeError?)
      (check (replay-counterexample report) => #f)
      (check-eq? (.get (replay-property report) status) 'failed)
      (def codec (replay.make-codec '(prepared-services 1)
        (lambda (table) (map (lambda (key) (.get (hash-ref table key) amount)) '(left right)))
        (lambda (amounts) (list->hash-table
          (map (lambda (key amount) (cons key (make-instance cell amount: amount handler: abs)))
            '(left right) amounts) seed: 0))))
      (def output (open-output-string))
      (write-counterexample report codec output)
      (check (read-counterexample (.get report sampler) codec (open-input-string (get-output-string output))
        (property.report-property (.get report execution))) => #f)
      (.set! Key sexp 'second-revision)
      (check-exception (replay-property report) Error?)
      (def retry ((collection.map-service-action descriptor cell owner void identity) configuration))
      (check-eq? (.get retry status) 'failed)
      (check (replay-counterexample retry) => #f))
    (test-case "Map and trace aggregates stop after the first obsolete weight"
      (for (kind '(map trace))
        (def live #t) (def weights 0)
        ;; The caller's authority is independent of the measured scalar descriptor.
        (def (weigh value) (set! weights (1+ weights)) (set! live #f) (abs value))
        (def action (case kind
          ((map)
           (let* ((values (make-generator Integer (lambda (_random _size) 2) (lambda (_) []) weigh))
                  (maps (map-generator (Map Symbol -> Integer) '(left right) values)))
             (lambda () (.call maps measure (list->hash-table '((left . 2) (right . 3)))))))
          ((trace)
           (let* ((model (make-instance TraceGenerator Command: Integer State: UInt Result: Integer Observation: UInt
                     initial: (lambda () 0) enabled?: (lambda (_state _command) #t)
                     advance: (lambda (state _command) (values state 0)) observe: identity
                     draw: (lambda (_state _random _size) #f) shrink: (lambda (_) []) measure: weigh))
                  (sampler (trace-generator Integer model)))
             (lambda () (.call sampler measure '(1 2 3)))))))
        (def parent (core.make-generator (lambda (_random _size) (action)) (lambda (_) []) current?: (lambda () live)))
        (check-exception (core.generate parent (core.random-at 1) 0) core.stale-generation?)
        (check-equal? weights 1)))
    (test-case "typed bridge factories stop before later field binding"
      (def live #t) (def first 0) (def later 0)
      (def left (.cc (make-generator Integer (lambda (_random _size) 1) (lambda (_) []) abs)
        generation: (lambda (_self) (set! first (1+ first)) (set! live #f) (core.generator-unit 1))))
      (def right (.cc (make-generator Integer (lambda (_random _size) 2) (lambda (_) []) abs)
        generation: (lambda (_self) (set! later (1+ later)) (core.generator-unit 2))))
      (def parent (core.make-generator (lambda (_random _size)
        (product-generator (Tuple Integer Integer) (list left right) vector->list list->vector))
        (lambda (_) []) current?: (lambda () live)))
      (check-exception (core.generate parent (core.random-at 1) 0) core.stale-generation?)
      (check-equal? (list first later) '(1 0)))
    (test-case "Map key validation inherits parent scope before the next key"
      (def live #t) (def keys 0)
      (def Key (.cc Symbol .validate: (lambda (key) (set! keys (1+ keys)) (set! live #f) key)))
      (def parent (core.make-generator (lambda (_random _size)
        (map-generator (Map Key -> Integer) '(left right) (generator Integer)))
        (lambda (_) []) current?: (lambda () live)))
      (check-exception (core.generate parent (core.random-at 1) 0) core.stale-generation?)
      (check-equal? keys 1))
    (test-case "bridge weight and key callback exceptions retain their exact cause"
      (for (stage '(bridge weight key))
        (def live #t) (def cause (cons 'typed stage))
        ;; A thrown exception is not replaced by a trailing stale check.
        (def (fail) (set! live #f) (raise cause))
        (def values (make-generator Integer (lambda (_random _size) 2) (lambda (_) [])
          (lambda (_) (if (eq? stage 'weight) (fail) 1))))
        (def Key (.cc Symbol .validate: (lambda (key) (if (eq? stage 'key) (fail) key))))
        (def parent (core.make-generator (lambda (_random _size)
          (case stage
            ((bridge) (generator-core (.cc values generation: (lambda (_) (fail)))))
            ((key) (map-generator (Map Key -> Integer) '(left right) values))
            ((weight) (.call (map-generator (Map Symbol -> Integer) '(left right) values)
              measure (list->hash-table '((left . 1) (right . 2)))))))
          (lambda (_) []) current?: (lambda () live)))
        (check-eq? (with-catch identity (lambda () (core.generate parent (core.random-at 1) 0))) cause)))
    (test-case "fresh totals malformed measures and key identity keep their existing semantics"
      (def calls 0)
      (def values (make-generator Integer (lambda (_random _size) 1) (lambda (_) [])
        (lambda (value) (set! calls (1+ calls)) (abs value))))
      (def maps (map-generator (Map Symbol -> Integer) '(left right) values))
      (check-equal? (.call maps measure (list->hash-table '((left . 2) (right . 3)))) 7)
      (check-equal? calls 2)
      (check-equal? (.call maps measure (make-hash-table)) 0)
      (check-equal? calls 2)
      (for (bad '(-1 1/2))
        (let* ((invalid (make-generator Integer (lambda (_random _size) 1) (lambda (_) []) (lambda (_) bad)))
               (sampler (map-generator (Map Symbol -> Integer) '(left) invalid)))
          (check-exception (.call sampler measure (list->hash-table '((left . 1)))) Error?)))
      (def Key (.cc Symbol .validate: (lambda (_) 'changed)))
      (check-exception (map-generator (Map Key -> Integer) '(left) values) Error?))
    (test-case "two-service Record Map batches refuse obsolete costs then shrink and replay through FUN"
      (def owner (.o epoch: 0)) (def costs 0)
      (def configuration (make-instance PropertyConfiguration seed: 17 cases: 1 size: 3 shrink-budget: 30))
      ;; A fresh action explicitly captures the revised owner rather than renewing
      ;; authority in the old report. Map iteration order is deliberately unobserved.
      (def (run revise?)
        ((collection.map-service-tests owner (lambda (_value)
          (set! costs (1+ costs))
          (when revise? (.putslot! owner 'epoch ($constant-slot-spec (1+ (.get owner epoch)))))) identity) configuration))
      (def old (run #t))
      (check-eq? (.get old status) 'stale)
      (check-equal? (list costs (.get old attempts) (.get old steps)) '(1 1 0))
      (check-exception (replay-property old) Error?)
      (let (fresh (run #f))
        (check-eq? (.get fresh status) 'failed)
        (check-equal? (hash-length (.get fresh counterexample)) 2)
        (for (key '(left right)) (check (hash-key? (.get fresh counterexample) key) => #t))
        (check-equal? (map (lambda (key) (.get (hash-ref (.get fresh counterexample) key) amount)) '(left right)) '(0 0))
        (check-exception ((.@ (hash-ref (.get fresh counterexample) 'left) handler) 'invalid) TypeError?)
        (check (replay-counterexample fresh) => #f)
        (check-eq? (.get (replay-property fresh) status) 'failed))
      (check-exception (replay-property old) Error?))))



;; Shared declaration snapshots must close before bridges, diagnostics or
;; composite factories can bind callbacks. Keep exact causes and explicit retries.
(def snapshot-admission-test
  (test-suite "typed declaration snapshot admission"
    (test-case "all typed entrypoints refuse a Type retired by later sampler sources"
      (for (stage '(bridge inspection check product map))
        (def Descriptor (.cc Integer)) (def draws 0) (def calls 0)
        (def field (make-generator Descriptor
          (lambda (_random _size) (set! draws (1+ draws)) 1) (lambda (_) []) abs))
        (.putslot! field 'sources ($self-slot-spec (lambda (_self)
          (.set! Descriptor sexp 'retired-by-sources) [])))
        (def (prepare)
          (case stage
            ((bridge) (core.generate (generator-core field) (core.random-at 42) 1))
            ((inspection) (inspect-generator field count: 1))
            ((product) (product-generator (Tuple Descriptor) (list field) vector->list list->vector))
            ((map) (map-generator (Map Symbol -> Descriptor) '(left) field))))
        (if (eq? stage 'check)
          (let (report (check-property Descriptor (lambda (_) (set! calls (1+ calls)) #t)
                        sampler: field cases: 1 size: 1))
            (check-eq? (.get report status) 'stale)
            (check (.get report replayable?) => #f))
          (check-exception (prepare) generation-refusal?))
        (check-equal? (list draws calls) '(0 0))))
    (test-case "bound declaration reads cannot retire the observed Type then enter sources"
      (def Descriptor (.cc Integer)) (def later 0)
      (def field (make-generator Descriptor (lambda (_random _size) 1) (lambda (_) []) abs))
      (.putslot! field 'bound-descriptor ($self-slot-spec (lambda (_self)
        (.set! Descriptor sexp 'retired-by-bound) Descriptor)))
      (.putslot! field 'sources ($self-slot-spec (lambda (_self) (set! later (1+ later)) [])))
      (check-exception (generator-core field) generation-refusal?)
      (check-equal? later 0))
    (test-case "explicit run dependency spines keep original owners before sampler metadata"
      (def owner (.o epoch: 0)) (def replacement (.o epoch: 0))
      (def dependencies (list owner)) (def draws 0)
      (def field (make-generator Integer
        (lambda (_random _size) (set! draws (1+ draws)) 1) (lambda (_) []) abs))
      (.putslot! field 'sources ($self-slot-spec (lambda (_self)
        (set-car! dependencies replacement) [])))
      (let (report (check-property Integer (lambda (_) #f) sampler: field dependencies: dependencies
                    cases: 1 size: 1 shrink-budget: 0))
        (check-eq? (.get report status) 'failed)
        (check-eq? (car dependencies) replacement)
        (check (replay-counterexample report) => #f)
        (.set! owner epoch 1)
        (let (draws-before draws)
          (check-exception (replay-property report) Error?)
          (check-equal? draws draws-before))))
    (test-case "source getter exceptions keep original false causes and fresh bridges retry"
      (for (cause (list #f (cons 'source 'cause)))
        (def Descriptor (.cc Integer)) (def draws 0)
        (def field (make-generator Descriptor
          (lambda (_random _size) (set! draws (1+ draws)) 1) (lambda (_) []) abs))
        (.putslot! field 'sources ($self-slot-spec (lambda (_self)
          (.set! Descriptor sexp 'changed-before-exception) (raise cause))))
        (check-eq? (with-catch identity (lambda () (generator-core field) 'missed)) cause)
        (check-equal? draws 0)
        (.putslot! field 'sources ($constant-slot-spec []))
        (check-equal? (core.sample-value (core.generate (generator-core field) (core.random-at 1) 1)) 1)
        (check-equal? draws 1)))
    (test-case "alias and nested declaration reads use pure epoch checks without reentry"
      (def Descriptor (.cc Integer)) (def reads 0)
      (def field (make-generator Descriptor (lambda (_random _size) 1) (lambda (_) []) abs))
      (.putslot! field 'sources ($self-slot-spec (lambda (_self)
        (set! reads (1+ reads)) (when (> reads 20) (error "recursive source metadata"))
        (core.with-sources [] (list Descriptor Descriptor field)))))
      (def generation (generator-core field))
      (check-equal? (core.sample-value (core.generate generation (core.random-at 1) 1)) 1)
      (check-equal? reads 1)
      (.set! Descriptor sexp 'retired-alias)
      (check-exception (core.generate generation (core.random-at 1) 1) core.stale-generation?))
    (test-case "shared Record service snapshots close before FUN bind and keep replay wrappers"
      (def owner (.o epoch: 0)) (def deliveries 0) (def costs 0)
      (def cell (Record amount: [UInt] handler: [(Function [Integer] [Integer])]))
      (def field (collection.service-value-generator cell owner (lambda (_) (set! costs (1+ costs)))))
      (.putslot! field 'sources ($self-slot-spec (lambda (_self) (.set! cell sexp 'retired-cell) (list owner))))
      (check-exception (collection.service-batch-action cell field identity) generation-refusal?)
      (check-equal? costs 0)
      (.putslot! field 'sources ($constant-slot-spec (list owner)))
      (def action (collection.service-batch-action cell field (lambda (report) (set! deliveries (1+ deliveries)) report)))
      (def config (make-instance PropertyConfiguration seed: 42 cases: 1 size: 3 shrink-budget: 50))
      (def report (action config))
      (check-eq? (.get report status) 'failed)
      (check-equal? deliveries 1)
      (def witness (.get report counterexample))
      (check-exception ((.@ (vector-ref witness 0) handler) 'bad) TypeError?)
      (check-equal? (map (lambda (value) (.get value amount)) (vector->list witness)) '(0 0))
      (check (replay-counterexample report) => #f)
      (check-eq? (.get (replay-property report) status) 'failed)
      (def codec (replay.make-codec '(snapshot-services 1)
        (lambda (batch) (map (lambda (value) (.get value amount)) (vector->list batch)))
        (lambda (amounts) (list->vector (map (lambda (amount) (make-instance cell amount: amount handler: abs)) amounts)))))
      (def output (open-output-string))
      (write-counterexample report codec output)
      (check (read-counterexample (.get report sampler) codec (open-input-string (get-output-string output))
        (property.report-property (.get report execution))) => #f)
      (.set! cell sexp 'next-cell-revision)
      (check-exception (replay-property report) Error?)
      (def fresh ((collection.service-batch-action cell field identity) config))
      (check-eq? (.get fresh status) 'failed)
      (check (replay-counterexample fresh) => #f))))

;; Source authority covers metadata binding and owned factory execution, not
;; only later value pulls. Every counter is sequenced at its observation point.
(def bridge-preparation-test
  (test-suite "typed bridge and specification preparation"
    (test-case "check requests capture expected Types and mismatch before later metadata"
      (let* ((Descriptor (.cc Integer)) (later 0) (draws 0)
             (field (make-generator Descriptor (lambda (_random _size) (set! draws (1+ draws)) 1)
                      (lambda (_) []) abs)))
        (.putslot! field 'descriptor ($self-slot-spec (lambda (_self)
          (.set! Descriptor sexp 'retired-before-binding) Descriptor)))
        (.putslot! field 'sources ($self-slot-spec (lambda (_self) (set! later (1+ later)) [])))
        (let (report (check-property Descriptor (lambda (_) #t) sampler: field cases: 1))
          (check-eq? (.get report status) 'stale)
          (check-equal? (list later draws) '(0 0))))
      (let ((later 0) (field (make-generator Integer (lambda (_random _size) 1) (lambda (_) []) abs)))
        (.putslot! field 'sources ($self-slot-spec (lambda (_self) (set! later (1+ later)) [])))
        (let (report (check-property String (lambda (_) #t) sampler: field cases: 1))
          (check-eq? (.get report status) 'error)
          (check-equal? (Error-message (.get report cause)) "sampler descriptor mismatch")
          (check-equal? later 0))
        (check-exception (check-property #f (lambda (_) #t) sampler: field cases: 1) TypeError?)
        (check-equal? later 0)))
    (test-case "retired generation metadata cannot invoke the returned factory"
      (let* ((Descriptor (.cc Integer)) (factories 0)
             (field (make-generator Descriptor (lambda (_random _size) 1) (lambda (_) []) abs)))
        (.putslot! field 'generation ($self-slot-spec (lambda (_self)
          (.set! Descriptor sexp 'retired-getter)
          (lambda (_) (set! factories (1+ factories)) (core.generator-unit 1)))))
        (check-exception (generator-core field) generation-refusal?)
        (check-equal? factories 0)))
    (test-case "retired owned factories cannot bind a fallback or later hook"
      (for (choice '(owned fallback))
        (let* ((Descriptor (.cc Integer)) (later 0)
               (field (make-generator Descriptor (lambda (_random _size) 1) (lambda (_) []) abs)))
          (.putslot! field 'generation ($constant-slot-spec (lambda (_)
            (.set! Descriptor sexp 'retired-factory)
            (if (eq? choice 'owned) (core.generator-unit 1) #f))))
          (.putslot! field (if (eq? choice 'owned) '.current? 'draw)
            ($self-slot-spec (lambda (_self) (set! later (1+ later)) (lambda arguments #t))))
          (check-exception (generator-core field) generation-refusal?)
          (check-equal? later 0))))
    (test-case "retired raw draw binding cannot reach the current hook getter"
      (let* ((Descriptor (.cc Integer)) (later 0)
             (field (make-generator Descriptor (lambda (_random _size) 1) (lambda (_) []) abs)))
        (.putslot! field 'draw ($self-slot-spec (lambda (_self)
          (.set! Descriptor sexp 'retired-draw) (lambda (_random _size) 1))))
        (.putslot! field '.current? ($self-slot-spec (lambda (_self) (set! later (1+ later)) (lambda () #t))))
        (check-exception (generator-core field) generation-refusal?)
        (check-equal? later 0)))
    (test-case "check and inspection share their original snapshot across binding"
      (for (stage '(check inspection))
        (let* ((Descriptor (.cc Integer)) (measures 0) (draws 0)
               (field (make-generator Descriptor (lambda (_random _size) (set! draws (1+ draws)) 1)
                        (lambda (_) []) abs)))
          (.putslot! field 'generation ($constant-slot-spec (lambda (_)
            (.set! Descriptor sexp 'retired-before-domain) (core.generator-unit 1))))
          (.putslot! field 'measure ($self-slot-spec (lambda (_self)
            (set! measures (1+ measures)) abs)))
          (if (eq? stage 'check)
            (let (report (check-property Descriptor (lambda (_) #t) sampler: field cases: 1))
              (check-eq? (.get report status) 'stale)
              (check (.get report replayable?) => #f))
            (check-exception (inspect-generator field count: 1) generation-refusal?))
          (check-equal? (list measures draws) '(0 0)))))
    (test-case "product measure binding refuses before the following hook metadata"
      (let* ((Descriptor (.cc Integer)) (later 0)
             (field (make-generator Descriptor (lambda (_random _size) 1) (lambda (_) []) abs)))
        (.putslot! field 'measure ($self-slot-spec (lambda (_self)
          (.set! Descriptor sexp 'retired-measure) abs)))
        (.putslot! field '.current? ($self-slot-spec (lambda (_self) (set! later (1+ later)) (lambda () #t))))
        (check-exception (product-generator (Tuple Descriptor) (list field) vector->list list->vector) generation-refusal?)
        (check-equal? later 0)))
    (test-case "factory retirement stops nested core pulls before the producer runs"
      (let* ((Descriptor (.cc Integer)) (pulls 0)
             (field (make-generator Descriptor (lambda (_random _size) 1) (lambda (_) []) abs))
             (child (core.make-generator (lambda (_random _size) (set! pulls (1+ pulls)) 1) (lambda (_) []))))
        (.putslot! field 'generation ($constant-slot-spec (lambda (_)
          (.set! Descriptor sexp 'retired-before-pull)
          (core.generate child (core.random-at 42) 1)
          (core.generator-unit 1))))
        (check-exception (generator-core field) generation-refusal?)
        (check-equal? pulls 0)))
    (test-case "stable optional factories preserve fallback false data and scope release"
      (let* ((Descriptor (.cc Integer)) (factories 0) (draws 0)
             (field (make-generator Descriptor (lambda (_random _size) (set! draws (1+ draws)) 7)
                      (lambda (_) []) abs)))
        (.putslot! field 'generation ($constant-slot-spec (lambda (_) (set! factories (1+ factories)) #f)))
        (let (generation (generator-core field))
          (check-equal? factories 1)
          (check-equal? (core.sample-value (core.generate generation (core.random-at 1) 1)) 7)
          (check-equal? draws 1)
          (.set! Descriptor sexp 'later-retirement)
          (check-equal? (core.sample-value (core.generate (core.generator-unit 42) (core.random-at 1) 0)) 42)
          (check-exception (core.generate generation (core.random-at 1) 1) core.stale-generation?)))
      (let (field (make-generator Bool (lambda (_random _size) #t) (lambda (_) []) (lambda (_) 0)))
        (.putslot! field 'generation ($constant-slot-spec (lambda (_) (core.generator-unit #f))))
        (.putslot! field 'draw ($self-slot-spec (lambda (_self) (error "unused raw getter"))))
        (check (core.sample-value (core.generate (generator-core field) (core.random-at 1) 0)) => #f)))
    (test-case "deferred Record factories guard probes then shrink replay and explicitly repair"
      (let* ((owner (make-instance (Record epoch: [UInt]) epoch: 0))
             (cell (Record amount: [UInt] handler: [(Function [Integer] [Integer])]))
             (produced 0) (factories 0) (delivered 0)
             (config (make-instance PropertyConfiguration seed: 42 cases: 1 size: 3 shrink-budget: 40)))
        ;; Generic map retains the integer's shrink tree; Record alone wraps
        ;; the chosen callback. Both faulty and corrected recipes share it.
        (def (generation handler)
          (core.generator-map (core.generator-integer 0 3) (lambda (amount)
            (set! produced (1+ produced)) (make-instance cell amount: amount handler: handler))))
        ;; Preparing a recipe may perform one bounded diagnostic probe. Once
        ;; its declared owner retires, that probe must not enter the producer.
        (def (recipe obsolete? handler)
          (lambda (_field)
            (set! factories (1+ factories))
            (when obsolete? (.set! owner epoch (1+ (.get owner epoch))))
            (let (tree (generation handler))
              (core.generate tree (core.random-at 17) 3) tree)))
        (let (report ((collection.service-factory-action cell owner (recipe #t abs) identity) config))
          (check-eq? (.get report status) 'stale)
          (check-equal? produced 0)
          (check (.get report replayable?) => #f))
        (let (report ((collection.service-factory-action cell owner (recipe #f abs)
                        (lambda (value) (set! delivered (1+ delivered)) value)) config))
          (check-eq? (.get report status) 'failed)
          (check-equal? delivered 1)
          (check-equal? (.get (.get report counterexample) amount) 0)
          (check-exception ((.@ (.get report counterexample) handler) 'bad) TypeError?)
          (check (replay-counterexample report) => #f)
          (check-eq? (.get (replay-property report) status) 'failed)
          (let* ((codec (replay.make-codec '(deferred-services 1)
                   (lambda (value) (.get value amount))
                   (lambda (amount) (make-instance cell amount: amount handler: abs))))
                 (output (open-output-string)))
            (write-counterexample report codec output)
            (check (read-counterexample (.get report sampler) codec (open-input-string (get-output-string output))
              (property.report-property (.get report execution))) => #f))
          (.set! owner epoch (1+ (.get owner epoch)))
          (let ((before-factories factories) (before-produced produced))
            (check-exception (replay-property report) Error?)
            (check-equal? (list factories produced) (list before-factories before-produced))))
        (standard.require-property-passed
          ((collection.service-factory-action cell owner (recipe #f (lambda (_) 0)) identity) config))))
    (test-case "original factory causes survive retirement and fresh preparation retries"
      (for (cause (list #f (cons 'factory 'cause)))
        (let* ((Descriptor (.cc Integer))
               (field (make-generator Descriptor (lambda (_random _size) 3) (lambda (_) []) abs)))
          (.putslot! field 'generation ($constant-slot-spec (lambda (_)
            (.set! Descriptor sexp 'changed-before-cause) (raise cause))))
          (check-eq? (with-catch identity (lambda () (generator-core field) 'missed)) cause)
          (.putslot! field 'generation ($constant-slot-spec #f))
          (check-equal? (core.sample-value (core.generate (generator-core field) (core.random-at 1) 1)) 3))))))

;; Reader admission shares the same source protocol as generated trees. Tests
;; sequence mutations before observations, including compiled Record getters.
(def request-preparation-test
  (test-suite "Reader configuration and initial request authority"
    (test-case "retired known participants stop configuration before seed or draw"
      (for (participant '(descriptor sampler dependency sampler-source))
        (let* ((Descriptor (.cc Integer)) (owner (.o epoch: 0))
               (reads 0) (draws 0) (delivered 0)
               (field (make-generator Descriptor
                 (lambda (_random _size) (set! draws (1+ draws)) 1) (lambda (_) []) abs
                 dependencies: (list owner)))
               (config (make-instance PropertyConfiguration cases: 1 size: 1))
               (target (case participant ((descriptor) Descriptor) ((sampler) field) (else owner))))
          (.putslot! config 'policy ($self-slot-spec (lambda (_self)
            (.set! target retired #t) (property.make-policy))))
          (.putslot! config 'seed ($self-slot-spec (lambda (_self) (set! reads (1+ reads)) 42)))
          (check-exception ((property-action Descriptor (lambda (_) #t)
            (lambda (_) (set! delivered (1+ delivered))) sampler: field
            dependencies: (if (eq? participant 'sampler-source) [] (list owner))) config)
            generation-refusal?)
          (check-equal? (list reads draws delivered) '(0 0 0)))))
    (test-case "configuration causes remain exact and consumer is not entered"
      (for (cause (list #f (cons 'configuration 'cause)))
        (let* ((delivered 0) (Descriptor (.cc Integer))
               (field (make-generator Descriptor (lambda (_random _size) 1) (lambda (_) []) abs))
               (config (make-instance PropertyConfiguration cases: 1)))
          (.putslot! config 'policy ($self-slot-spec (lambda (_self)
            (.set! Descriptor retired #t) (raise cause))))
          (check-eq? (with-catch identity (lambda ()
            ((property-action Descriptor (lambda (_) #t) (lambda (_) (set! delivered 1)) sampler: field) config)
            'missed)) cause)
          (check-equal? delivered 0))))
    (test-case "size is read once and zero is a present size and limit"
      (let* ((reads 0) (config (.o seed: 0 cases: 1 shrink-budget: 0))
             (field (make-generator Integer (lambda (_random size) size) (lambda (_) []) abs)))
        (.putslot! config 'size ($self-slot-spec (lambda (_self) (set! reads (1+ reads)) 0)))
        (let (report ((property-action Integer zero? identity sampler: field) config))
          (check-eq? (.get report status) 'passed)
          (check-equal? reads 1)
          (check-equal? (.get report size-limit) 0))))
    (test-case "scheduled sizes retain explicit limits and false policies refuse"
      (let* ((config (make-instance PropertyConfiguration cases: 2 size: (lambda (_) 1) size-limit: 1))
             (field (make-generator Integer (lambda (_random size) size) (lambda (_) []) abs)))
        (standard.require-property-passed ((property-action Integer (cut = <> 1) identity sampler: field) config))
        (.putslot! config 'policy ($constant-slot-spec #f))
        (check-eq? (.get ((property-action Integer (lambda (_) #t) identity sampler: field) config) status) 'error)))
    (test-case "action recipes freeze dependency identity spines but refresh epochs on invocation"
      (let* ((owner (.o epoch: 0)) (foreign (.o epoch: 0)) (dependencies (list owner))
             (field (make-generator Integer (lambda (_random _size) 1) (lambda (_) []) abs))
             (config (make-instance PropertyConfiguration cases: 1))
             (action (property-action Integer (lambda (_) (.set! owner epoch (1+ (.get owner epoch))) #t)
               identity sampler: field dependencies: dependencies)))
        (set-car! dependencies foreign)
        (check-eq? (.get (action config) status) 'stale)
        (check-eq? (.get (action config) status) 'stale)))
    (test-case "automatic recipes cannot retire a known dependency then probe producers"
      (let* ((Descriptor (.cc Integer)) (owner (.o epoch: 0)) (draws 0) (trials 0)
             (field (make-generator Descriptor (lambda (_random _size) 1) (lambda (_) []) abs)))
        (.putslot! Descriptor '.generator ($constant-slot-spec (lambda ()
          (.set! owner epoch 1)
          (core.generate (core.generator-map (core.generator-unit 1)
            (lambda (value) (set! draws (1+ draws)) value)) (core.random-at 0) 1)
          field)))
        (let (report (check-property Descriptor (lambda (_) (set! trials (1+ trials)) #t)
                      dependencies: (list owner) cases: 1))
          (check-eq? (.get report status) 'stale)
          (check (.get report replayable?) => #f)
          (check-equal? (list draws trials) '(0 0)))))
    (test-case "automatic recipes cannot erase original dependency identities"
      (let* ((Descriptor (.cc Integer)) (owner (.o epoch: 0)) (foreign (.o epoch: 0))
             (dependencies (list owner))
             (field (make-generator Descriptor (lambda (_random _size) 1) (lambda (_) []) abs)))
        (.putslot! Descriptor '.generator ($constant-slot-spec (lambda ()
          (set-car! dependencies foreign) (.set! owner epoch 1) field)))
        (let (report (check-property Descriptor (lambda (_) #t) dependencies: dependencies cases: 1))
          (check-eq? (.get report status) 'stale)
          (check-eq? (car (.get report dependencies)) owner))))
    (test-case "explicit fresh Reader retry restores preparation and releases consumer scope"
      (let* ((Descriptor (.cc Integer)) (draws 0) (delivered 0)
             (config (make-instance PropertyConfiguration cases: 1 size: 1))
             (field (make-generator Descriptor (lambda (_random _size) (set! draws (1+ draws)) 1)
                      (lambda (_) []) abs))
             (action (property-action Descriptor (lambda (_) #t)
               (lambda (report) (set! delivered (1+ delivered)) (.set! config seed 17) report) sampler: field)))
        (.putslot! config 'policy ($self-slot-spec (lambda (_self)
          (.set! Descriptor retired #t) (property.make-policy))))
        (check-exception (action config) generation-refusal?)
        (check-equal? (list draws delivered) '(0 0))
        (.putslot! config 'policy ($constant-slot-spec (property.make-policy)))
        (let (report (action config))
          (check-eq? (.get report status) 'passed)
          (check-equal? (list draws delivered) '(1 1))
          (check-exception (replay-property report) Error?))))))
