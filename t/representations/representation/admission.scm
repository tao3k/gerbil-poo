;;; Symbolic edit and declaration-catalog admission; same module and case order.
    (test-case "symbolic edit grammar retains shared layouts credentials and input roots on refusal"
      (for* ((policy '(tree compact)) (bad (list #f 0 "value" [] '#())))
        (let* ((f identity)
               (source (make-object slots: (prototype-map
                         (list (cons 'value ($constant-slot-spec 7))
                               (cons 'callback ($constant-slot-spec f))) policy: policy)
                        defaults: (prototype-map '((fallback . #f)) policy: policy)))
               (left (.mix source)) (right (.mix source)) (owner (.mix left right))
               (site (make-slot-cache 'value shapes: 2)) (read #f))
          (check-equal? (.ref/inline owner site) 7)
          (set! read (names-token owner))
          (let ((versions (map object-revision (list source left right owner)))
                (layout (object-%layout owner)) (instance (object-%instance owner))
                (slots (object-%slots source)) (defaults (object-%defaults source))
                (overrides (object-%overrides source)))
            (for (edit (list (lambda () (.put! source bad 9))
                            (lambda () (.removeslot! source bad))
                            (lambda () (.removedefault! source bad))))
              (check-exception (edit) contract-violation-error?)
              (check-equal? (map object-revision (list source left right owner)) versions)
              (check-eq? (object-%layout owner) layout)
              (check-eq? (object-%instance owner) instance)
              (check-eq? (object-%slots source) slots)
              (check-eq? (object-%defaults source) defaults)
              (check-eq? (object-%overrides source) overrides)
              (check (object-read-current? read) => #t))
            (check-eq? (.ref owner 'callback) f)
            (check (.ref owner 'fallback) => #f)
            (.put! source 'value 9)
            (check-equal? (map object-revision (list source left right owner)) (map 1+ versions))
            (check (object-read-current? read) => #f)
            (check-equal? (.ref source 'value) 9)
            (check-equal? (.ref/inline owner site) 7)))))
    (test-case "valid symbolic refusal and missing-name operations retain their existing protocol"
      (def source (.o value: #f))
      (def initial (object-revision source))
      (.removeslot! source 'missing)
      (.removedefault! source 'missing)
      (check-equal? (object-revision source) (+ initial 2))
      (seal-object! source)
      (check-exception (.put! source 'value 7) (message? "sealed prototype"))
      (check-exception (.removeslot! source 'value) (message? "sealed prototype"))
      (check-exception (.removedefault! source 'missing) (message? "sealed prototype"))
      (check (.ref source 'value) => #f)
      (check-equal? (service.symbolic-edit-workflow) '#(18 66 4)))
    (test-case "non-symbol removals refuse before shared caches lose their revision"
      (for (policy '(tree compact))
        (let* ((source (make-object slots: (prototype-map
                         (list (cons 'value ($constant-slot-spec 7))) policy: policy)))
               (child (.mix source)) (site (make-slot-cache 'value)))
          (check-equal? (.ref/inline child site) 7)
          (let ((revisions (map object-revision (list source child)))
                (layout (object-%layout child)))
            (check-exception (.removeslot! source #f) contract-violation-error?)
            (check-equal? (map object-revision (list source child)) revisions)
            (check-eq? (object-%layout child) layout)))))
    (test-case "catalog capture and public reflection own pairs while descriptor revisions stay live"
      (let* ((descriptor (.new Slot type: Integer constant: 7))
             (entries (list (cons 'value descriptor)))
             (owner (make-object declarations: entries)))
        ;; Mutate caller input before ANY catalog force or reflection.
        (set-car! (car entries) 'forged)
        (set-cdr! entries (list (cons 'extra descriptor)))
        (check-equal? (read-slot owner 'value) 7)
        (check-equal? (map car (reflect-slots owner)) '(value))
        (let (view (reflect-slots owner))
          (set-cdr! (car view) (.new Slot type: Integer constant: 999)))
        (set-car! (car (object-declarations owner)) 'forged)
        (check-equal? (read-slot owner 'value) 7)
        (let ((clone (.cc owner)) (composed (.+ (.o) owner)))
          (check-eq? (object-%declarations owner) (object-%declarations clone))
          (check-eq? (object-%declarations owner) (object-%declarations composed))
          (for (value (list owner clone composed)) (check-equal? (read-slot value 'value) 7))
          (let (before (object-revision owner))
            (.putslot! descriptor 'constant ($constant-slot-spec 11))
            (check (> (object-revision owner) before) => #t))
          (for (value (list owner clone composed)) (check-equal? (read-slot value 'value) 11))
          (.putslot! descriptor 'hidden ($constant-slot-spec #t))
          (check-equal? (reflect-slots owner) [])
          (check-exception (read-slot owner 'value) error?)
          (.putslot! descriptor 'hidden ($constant-slot-spec #f))
          (check-equal? (read-slot owner 'value) 11))))
    (test-case "empty roots share only immutable storage and retain explicit policy"
      (for (policy '(tree compact))
        (def empty (prototype-map [] policy: policy))
        (check-eq? empty (prototype-map [] policy: policy))
        (check-equal? (prototype-map-length empty) 0)
        (def changed (prototype-map-put empty 'value #f))
        (check-equal? (prototype-map-list empty) [])
        (check-equal? (prototype-map-list changed) '((value . #f)))
        (check-equal? (prototype-map-length changed) 1)
        (check-equal? (prototype-map-policy changed) policy)
        (check-eq? empty (prototype-map-remove empty 'missing)))
      (check-equal? (prototype-map-length (prototype-map '((x . 1) (x . 2)))) 2)
      (check (eq? (prototype-map [] policy: 'tree) (prototype-map [] policy: 'compact)) => #f))
    (test-case "catalog grammar refuses before hooks while descriptor failure stays retryable"
      (def calls 0)
      (def protocol (.o (compute-slot (lambda (_ next name) (set! calls (1+ calls)) (next)))))
      (check-exception (make-object protocol: protocol declarations: '((7 . invalid))) error?)
      (check-equal? calls 0)
      (def descriptor (.new Slot type: Integer constant: 7))
      (def owner (make-object declarations: (list (cons 'value descriptor))))
      (.putslot! descriptor 'constant ($constant-slot-spec "invalid"))
      (check-exception (read-slot owner 'value) true)
      (.putslot! descriptor 'constant ($constant-slot-spec 9))
      (check-equal? (read-slot owner 'value) 9)
      ;; Broken descriptor elaboration must not publish a partial slot-function map.
      (let (metatype (.ref descriptor '.type))
        (.putslot! descriptor '.type ($constant-slot-spec #f))
        (check-exception (.ref owner 'value) true)
        (check (object-%slot-funs owner) => #f)
        (.putslot! descriptor '.type ($constant-slot-spec metatype))
        (check-equal? (read-slot owner 'value) 9)))
    (test-case "catalog composition uses shared module refinement FUN binding and refusal retry"
      (for* ((policy '(tree compact)) (recapture? '(#f #t)))
        (check-equal? (service.catalog-workflow 9 recapture?: recapture? policy: policy) '#(24 30 36 6))))
