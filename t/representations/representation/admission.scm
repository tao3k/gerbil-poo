    (test-case "batch shape revisions agree with full construction and never reuse old values"
      (def pool (for/collect (_ (in-range 128)) (string->uninterned-symbol "same")))
      ;; Assign stable interleaved identity ranks before selecting the old inventory.
      (for-each object->serial-number pool)
      (def old-names (for/collect ((name pool) (i (in-range (length pool)) when (even? i))) name))
      (def added (for/collect ((name pool) (i (in-range (length pool)) when (odd? i))) name))
      (def missing (gensym 'missing)) (def old-value (lambda () 'old))
      (def old-seed (make-hash-table-symbolic))
      (hash-put! old-seed (car old-names) old-value)
      (def old (make-slot-layout old-names old-seed missing))
      (def old-shape (slot-layout-shape old))
      (for (names (list (append old-names (take added 8))
                       (append (drop old-names 8) (take added 4))
                       (append (drop old-names 8) (take added 8))
                       (take added 32) (list (car old-names) (car added))
                       (take old-names 32) (take old-names 1) [] old-names))
        (def request (append (reverse names) names))
        (def current-value (lambda () 'current)) (def seed (make-hash-table-symbolic))
        (when (pair? names) (hash-put! seed (car names) #f))
        (when (and (pair? names) (pair? (cdr names))) (hash-put! seed (cadr names) current-value))
        ;; Extra seed names stay masked by the explicitly requested shape.
        (hash-put! seed 'not-requested 99)
        (def reference (make-slot-layout request seed missing))
        (def actual (make-slot-layout request seed missing previous: old))
        (check-eq? (slot-layout-shape actual) (slot-layout-shape reference))
        (check-equal? (hash-length (HashTable actual)) (hash-length (HashTable reference)))
        (check (slot-layout-index actual 'not-requested) => #f)
        (for (name names)
          (check-eq? (slot-layout-ref actual (slot-layout-index actual name))
                     (slot-layout-ref reference (slot-layout-index reference name))))
        (check-eq? (slot-layout-shape old) old-shape)
        (check-eq? (slot-layout-ref old (slot-layout-index old (car old-names))) old-value)))
    (test-case "batch preparation retains original seed refusal order and explicit retry"
      (def names (for/collect (_ (in-range 32)) (gensym 'old)))
      (def old (make-slot-layout names #f absent-value))
      (def request (append (drop names 4) (for/collect (_ (in-range 6)) (gensym 'new))))
      (for (cause (list #f (cons 'seed 'refused)))
        (def armed? #f) (def reads [])
        (def seed (make-hash-table test: eq? hash: (lambda (name)
          (when armed? (set! reads (cons name reads)) (raise cause)) 0)))
        (hash-put! seed (car request) #f)
        (set! armed? #t)
        (check-eq? (with-catch values (lambda () (make-slot-layout request seed absent-value))) cause)
        ;; Capture after the first call: internal definitions may move before
        ;; test expressions during standard compilation.
        (let (original reads)
          (set! reads [])
          (check-eq? (with-catch values (lambda ()
            (make-slot-layout request seed absent-value previous: old))) cause)
          (check-equal? reads original))
        (check-equal? (hash-length (HashTable old)) 0)
        (set! armed? #f)
        (def fresh (make-slot-layout request seed absent-value previous: old))
        (check (slot-layout-ref fresh (slot-layout-index fresh (car request))) => #f)))

