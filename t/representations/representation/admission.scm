    (test-case "seed source enumeration cannot retarget admitted names or entry rows"
      (for* ((storage '(vector hash)) (phase '(1 2)))
        (def names (list 'declared))
        (def callback (lambda (value) (+ value 7)))
        (def entry (cons 'callback callback))
        (def rows (list entry (cons 'disabled #f)))
        (def calls 0)
        (def source (HashTable (make-seed-input (list->hash-table '((seed . #f)))
          (lambda ()
            (set! calls (1+ calls))
            (when (= calls phase)
              (set-car! names 'late-name)
              (set-car! entry 'late-callback)
              (set-cdr! entry (lambda (_) (error "late callback escaped")))
              (set-cdr! rows []))))))
        (let (values (parameterize ((slot-value-storage storage))
                      (make-slot-values names source rows absent-value)))
          (check-eq? (hash-ref values 'callback #f) callback)
          (check (hash-ref values 'disabled absent-value) => #f)
          (check (hash-ref values 'seed absent-value) => #f)
          (check (hash-length values) => 3)
          (check (hash-ref values 'late-callback absent-value) => absent-value)
          (when (eq? storage 'vector)
            (check (integer? (slot-layout-index (slot-values-layout values) 'declared)) => #t)
            (check (slot-layout-index (slot-values-layout values) 'late-name) => #f))
          (check (car names) => 'late-name)
          (check calls => 2))))

    (test-case "seed source refusals retain exact causes and leave old guards available"
      (for* ((storage '(vector hash)) (phase '(1 2)) (cause (list #f (cons 'seed 'refused))))
        (def names (list 'declared)) (def rows (list (cons 'callback identity)))
        (def calls 0) (def armed? #t)
        (def prior (make-slot-layout '(callback) (list->hash-table (list (cons 'callback 1+))) absent-value))
        (def site (make-slot-cache 'callback))
        (slot-cache-bind! site 'owner 4 prior (slot-layout-index prior 'callback))
        (def source (HashTable (make-seed-input (list->hash-table '((seed . #f)))
          (lambda () (set! calls (1+ calls)) (when (and armed? (= calls phase)) (raise cause))))))
        (check-eq? (with-catch values (lambda ()
          (parameterize ((slot-value-storage storage))
            (make-slot-values names source rows absent-value previous: prior)))) cause)
        (check (slot-cache-hit? site 'owner 4 prior) => 0)
        (check-eq? (slot-layout-ref prior 0) 1+)
        (set! armed? #f)
        (let (retry (parameterize ((slot-value-storage storage))
                     (make-slot-values names source rows absent-value previous: prior)))
          (check-eq? (hash-ref retry 'callback) identity)
          (check (hash-ref retry 'seed absent-value) => #f))))
    (test-case "source failure precedes original invalid key admission and repair cannot hide it"
      (for* ((storage '(vector hash)) (refuse? '(#f #t)))
        (def entry (cons 17 identity)) (def rows (list entry)) (def calls 0)
        (def source (HashTable (make-seed-input (make-hash-table)
          (lambda ()
            (set! calls (1+ calls)) (set-car! entry 'repaired)
            (when refuse? (raise #f))))))
        (let (result (with-catch values (lambda ()
                      (parameterize ((slot-value-storage storage))
                        (make-slot-values '(declared) source rows absent-value)))))
          (if refuse? (check-eq? result #f)
            (check (contract-violation-error? result) => #t)))
        (check calls => 1)))
    (test-case "loaded seed request service retains FUN revisions and exact source recovery"
      (for* ((storage '(vector hash)) (phase '(1 2)))
        (def attempts 0) (def armed? #t)
        ;; Rebuild an independent source/request on each explicit recovery attempt.
        (def (source names rows)
          (set! attempts (1+ attempts))
          (def calls 0)
          (HashTable (make-seed-input (list->hash-table '((seed . #f)))
            (lambda ()
              (set! calls (1+ calls))
              (when (= calls phase)
                (set-car! names 'late-name)
                (set-car! (car rows) 'late-callback)
                (set-cdr! (car rows) (lambda (_) (error "late callback escaped")))
                (set-cdr! rows [])
                (when armed? (raise #f)))))))
        (def action (module-action "clan/poo/examples/representation-service"
                                  'clan/poo/examples/representation-service#seed-request-workflow))
        (parameterize ((slot-value-storage storage))
          (check-equal? (service.entry-recovery-workflow action (list source)
                          (lambda (cause) (check-eq? cause #f) (set! armed? #f)))
            '#(#(#(9 7 #f) #(11 7 #f) #(13 7 #f) 3))))
        (check attempts => 2)))
