;;; Effective metadata indexing preserves source guards and public snapshot ownership.
(export declaration-index-test)
(import (prefix-in (only-in :gerbil/runtime/mop slot-ref) runtime.) :std/test :std/error :std/iter
        (only-in :gerbil/runtime/gambit string->uninterned-symbol)
        :clan/poo/object :clan/poo/mop :clan/poo/number :clan/poo/reflection
        :clan/poo/prototype-map :clan/poo/slot-observation
        (only-in :clan/poo/type List)
        (only-in :clan/poo/slot-layout make-slot-cache)
        (only-in :clan/poo/benchmarks/prototype-map-benchmark reference-reflection reference-read-slot)
        (prefix-in :clan/poo/examples/representation-service service.)
        (prefix-in :clan/poo/examples/inherited-services inherited.))

;; Construct one current typed constant; source edits use the existing Slot protocol.
(def (descriptor n (hidden? #f)) (.new Slot type: Integer constant: n hidden: hidden?))
;; Match a specific metadata failure rather than accepting unrelated exceptions.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (error-message cause) text))))

;; Independent scan observations are compared to private indexing after real edits.
(def declaration-index-test
  (test-suite "effective declarations, visibility and revision guards"
    (test-case "presence name admission precedes cold MOP preparation"
      (def calls 0)
      (def protocol (.o compute-slot: (lambda (_ _next _name)
        (set! calls (1+ calls)) (raise 'preparation-reached))))
      (def owner (make-object protocol: protocol slots: (list (cons 'value ($constant-slot-spec 7)))))
      ;; The sentinel stops old code before its unchecked symbolic HashTable call.
      (check-exception (.slot? owner 17) contract-violation-error?)
      (check-equal? calls 0)
      (check (object-%instance owner) => #f)
      (check-eq? (with-catch identity (cut .slot? owner 'value)) 'preparation-reached)
      (check-equal? calls 1))
    (test-case "reflection name admission precedes visibility callbacks"
      (for (write? '(#f #t))
        (let* ((slot (descriptor 7)) (calls 0)
               (owner (object<-declarations (list (cons 'value slot)))))
          (.putslot! slot 'hidden ($thunk-slot-spec (lambda ()
            (set! calls (1+ calls)) (raise 'visibility-reached))))
          (check-exception (if write? (write-slot! owner 17 8) (read-slot owner 17))
            contract-violation-error?)
          (check-equal? calls 0)
          (check (object-%declaration-index owner) => #f)
          (check-eq? (with-catch identity (cut read-slot owner 'value)) 'visibility-reached)
          (.putslot! slot 'hidden ($constant-slot-spec #f))
          (check-equal? (read-slot owner 'value) 7))))
    (test-case "malformed query names leave warm reads and every observation boundary untouched"
      (def owner (object<-declarations (list
        (cons 'value (.new Slot type: Integer default: 7))
        (cons 'handler (.new Slot type: (Fun Integer <- Integer) default: identity)))))
      (def reads [])
      (call-with-slot-read-observer (lambda (read) (set! reads (cons read reads)))
        (lambda () (.slot? owner 'value) (read-slot owner 'value) (read-slot owner 'handler)))
      (def revision (object-revision owner))
      (def layout (object-%layout owner))
      (def values (object-%instance owner))
      (def index (object-%declaration-index owner))
      (def deliveries 0)
      (def prechecks 0)
      (for* ((bad (list #f 17 "value" value: [] '#()))
             (query (list .slot? read-slot (lambda (receiver name) (write-slot! receiver name 9)))))
        (call-with-slot-read-observer (lambda (_) (set! deliveries (1+ deliveries)))
          (lambda () (check-exception (query owner bad) contract-violation-error?))
          before: (lambda (_ _key) (set! prechecks (1+ prechecks)) (raise 'query-reached))))
      (check-equal? (list deliveries prechecks) '(0 0))
      (check-equal? (object-revision owner) revision)
      (check-eq? (object-%layout owner) layout)
      (check-eq? (object-%instance owner) values)
      (check-eq? (object-%declaration-index owner) index)
      (check (andmap object-read-current? reads) => #t)
      (check (.slot? owner 'missing) => #f)
      (check-exception ((read-slot owner 'handler) #f) TypeError?)
      (write-slot! owner 'value 9)
      (check (andmap object-read-current? reads) => #f)
      (check-equal? (read-slot owner 'value) 9))
    (test-case "shared service FUN queries reject malformed names then publish a fresh revision"
      (check-equal? (inherited.query-workflow) '#(10 20 2 #t)))
    (test-case "reflected nested Functions retain argument and result contracts"
      (def signature (List (Fun Integer <- Integer)))
      (def slot (.new Slot type: signature default: (list (lambda (x) x))))
      (def source (object<-declarations (list (cons 'handlers slot))))
      (def owner (.mix source))
      (def checked (car (read-slot owner 'handlers)))
      (check-equal? (checked 7) 7)
      (check-exception (checked #f) TypeError?)
      (write-slot! source 'handlers (list (lambda (_) #f)))
      (check-exception ((car (.ref source 'handlers)) 7) TypeError?)
      (check-exception ((car (read-slot owner 'handlers)) 7) TypeError?))
    (test-case "checked values still satisfy constants and custom Slot predicates"
      (def slot (.new Slot type: Integer constant: 7))
      (def type (.ref slot '.type))
      (.putslot! slot '.type ($constant-slot-spec
        (.cc type '.slot.validate (lambda (_ _name value _receiver) (1+ value)))))
      (def owner (object<-declarations (list (cons 'value slot))))
      (def revision (object-revision owner))
      (check-exception (read-slot owner 'value) (message? "declared slot value rejected"))
      (check-exception (write-slot! owner 'value 7) (message? "declared slot value rejected"))
      (check-equal? (object-revision owner) revision)
      (check-equal? (.ref owner 'value) 7))
    (test-case "identity constants cannot be silently replaced by Function wrappers"
      (def callback (lambda (n) n))
      (def slot (.new Slot type: (Fun Integer <- Integer) constant: callback))
      (def owner (object<-declarations (list (cons 'handler slot))))
      (check-exception (read-slot owner 'handler) (message? "declared slot value rejected"))
      (check-eq? (.ref owner 'handler) callback))
    (test-case "normalizer causes precede stale revision failures and publication retries"
      (for (raising? '(#f #t))
        (let* ((slot (.new Slot type: Integer default: 7))
               (original (.ref slot '.type))
               (owner (object<-declarations (list (cons 'value slot)))))
          (.putslot! slot '.type ($constant-slot-spec
            (.cc original '.slot.validate (lambda (_ _name value _receiver)
              (.putslot! slot 'hidden ($constant-slot-spec #t))
              (if raising? (raise 'normalizer-refused) value)))))
          (if raising?
            (check-eq? (with-catch identity (cut write-slot! owner 'value 9)) 'normalizer-refused)
            (check-exception (write-slot! owner 'value 9)
              (message? "object changed during declaration reflection")))
          (check-equal? (.ref owner 'value) 7)
          (.putslot! slot '.type ($constant-slot-spec original))
          (.putslot! slot 'hidden ($constant-slot-spec #f))
          (write-slot! owner 'value 9)
          (check-equal? (read-slot owner 'value) 9))))
    (test-case "shared inherited callbacks compose FUN publication refusal and retry"
      (check-equal? (inherited.callback-workflow) '((11 11 11) (22 22 22))))
    (test-case "all resolved declaration types are protected before definition hooks"
      (def original (.ref (descriptor 7) '.type))
      (def later-type (.cc original))
      (def later (.cc (descriptor 7) '.type later-type))
      (def attack? #t)
      (def first-type (.cc original '.slot.define
        (lambda (metadata name target)
          (when attack? (.putslot! later-type '.slot.define
            ($constant-slot-spec (lambda (_metadata key receiver)
              (.putslot! receiver key ($constant-slot-spec 99))))))
          (.call original .slot.define metadata name target))))
      (def first (.cc (descriptor 3) '.type first-type))
      (def owner (make-object declarations: [(cons 'first first) (cons 'later later)]))
      (check-exception (.ref owner 'first) (message? "object mutation during computation"))
      (check-eq? (.ref later-type '.slot.define) (.ref original '.slot.define))
      (check (object-%instance owner) => #f)
      (set! attack? #f)
      (check-equal? (read-slot owner 'later) 7))
    (test-case "type resolution failure precedes definition effects and exact failures can retry"
      (def original (.ref (descriptor 7) '.type))
      (def calls 0)
      (def defining (.cc original '.slot.define (lambda (_ _key _target)
        (set! calls (1+ calls)) (raise 'definition-refused))))
      (def first (.cc (descriptor 3) '.type defining))
      (def later (descriptor 7))
      (.putslot! later '.type ($thunk-slot-spec (lambda () (raise #f))))
      (def owner (make-object declarations: [(cons 'first first) (cons 'later later)]))
      (check-equal? (with-catch (lambda (cause) (list cause)) (cut .ref owner 'first)) '(#f))
      (check-equal? calls 0)
      (check (object-%slot-funs owner) => #f)
      (.putslot! later '.type ($constant-slot-spec original))
      (check-eq? (with-catch identity (cut .ref owner 'first)) 'definition-refused)
      (check-equal? calls 1)
      (.putslot! defining '.slot.define ($constant-slot-spec (.ref original '.slot.define)))
      (check-equal? (read-slot owner 'later) 7))
    (test-case "complete C3 type preparation preserves incremental definitions and shared service retry"
      (def seen [])
      (def original (.ref (descriptor 7) '.type))
      (def recording (.cc original '.slot.define (lambda (metadata name target)
        (set! seen (cons (map car (object-slots target)) seen))
        (.call original .slot.define metadata name target))))
      (def owner (make-object declarations:
        [(cons 'first (.cc (descriptor 3) '.type recording))
         (cons 'second (.cc (descriptor 7) '.type recording))]))
      (check-equal? (.ref owner 'second) 7)
      (check-equal? (reverse seen) '(() (first)))
      (check-equal? (service.declaration-type-workflow) '#(9 11 2)))
    (test-case "construction owns later declaration sources before the first definition hook"
      (def later (descriptor 7))
      (def original (.ref later '.type))
      (def attack? #t)
      (def first-type (.cc original '.slot.define
        (lambda (metadata name target)
          (when attack? (.putslot! later 'constant ($constant-slot-spec 99)))
          (.call original .slot.define metadata name target))))
      (def first (.cc (descriptor 3) '.type first-type))
      (def owner (make-object declarations: (list (cons 'first first) (cons 'later later))))
      (check-exception (.ref owner 'first) (message? "object mutation during computation"))
      (check-equal? (.ref later 'constant) 7)
      (check (object-%instance owner) => #f)
      (set! attack? #f)
      (check-equal? (read-slot owner 'later) 7))
    (test-case "clones own shared catalog sources before inheritance hooks and later edits"
      (for (policy '(tree compact))
        (let* ((slot (descriptor 7)) (attack? #t)
               (protocol (.o (compute-precedence-list (lambda (_ next)
                 (when attack? (.putslot! slot 'constant ($constant-slot-spec 99))) (next)))))
               (recipe (make-object declarations: (prototype-map [(cons 'value slot)] policy: policy)))
               (left (.cc recipe)) (right (.cc recipe)))
          (object-protocol-set! left protocol)
          (check-exception (.ref left 'value) (message? "object mutation during computation"))
          (check-equal? (.ref slot 'constant) 7)
          (check (object-%precedence-list left) => #f)
          (set! attack? #f)
          (check-equal? (read-slot left 'value) 7)
          (check-equal? (read-slot right 'value) 7)
          (let ((a (object-revision left)) (b (object-revision right)))
            (.putslot! slot 'constant ($constant-slot-spec 8))
            (check-equal? (object-revision left) (1+ a))
            (check-equal? (object-revision right) (1+ b))
            (check (object-%layout left) => #f)
            (check-equal? (read-slot left 'value) 8)
            (check-equal? (read-slot right 'value) 8))))
      (check-equal? (service.declaration-source-workflow) '#((9 9) (11 11) 4)))
    (test-case "catalog carriers refuse non-list inputs uniformly before producer effects"
      (for (policy '(tree compact))
        (check-exception (prototype-map (vector (cons 'value #f)) policy: policy) contract-violation-error?)
        (let* ((calls 0) (input (in-coroutine (lambda (yield)
                       (set! calls (1+ calls)) (yield (cons 'value #f))))))
          (check-exception (prototype-map input policy: policy) contract-violation-error?)
          (check-equal? calls 0))))
    (test-case "finite carrier refusal covers malformed spines without affecting retained roots"
      (def cyclic (list (cons 'value #f)))
      (set-cdr! cyclic cyclic)
      (for (policy '(tree compact))
        (for (bad (list #f 7 'not-a-list (cons (cons 'value #f) 'tail) cyclic))
          (check-exception (prototype-map bad policy: policy) contract-violation-error?))
        (let* ((f identity) (root (prototype-map (list (cons 'value #f) (cons 'callback f)) policy: policy))
               (roots (list root)))
          (check-eq? (prototype-map root) root)
          (check-eq? (prototype-map-merge-first roots) root)
          (check-exception (prototype-map-merge-first (vector root)) contract-violation-error?)
          (set-cdr! roots roots)
          (check-exception (prototype-map-merge-first roots) contract-violation-error?)
          (check-equal? (prototype-map-list root) (list (cons 'value #f) (cons 'callback f)))
          (check-eq? (prototype-map-ref (prototype-map root policy: (if (eq? policy 'tree) 'compact 'tree)) 'callback) f))))
    (test-case "object source grammar refuses before hooks and corrected catalog retries through FUN workflow"
      (def calls 0)
      (def protocol (.o (compute-slot (lambda (_ next _name)
                        (set! calls (1+ calls)) (next)))))
      (def bad (vector (cons 'value ($constant-slot-spec 7))))
      (check-exception (make-object slots: bad protocol: protocol) contract-violation-error?)
      (check-exception (make-object defaults: bad protocol: protocol) contract-violation-error?)
      (check-exception (make-object declarations: (vector (cons 'value (descriptor 7)))
                        protocol: protocol) contract-violation-error?)
      (check-equal? calls 0)
      (let (owner (make-object slots: (vector->list bad) protocol: protocol))
        (check-equal? (.ref owner 'value) 7)
        (check-equal? calls 1))
      (for (policy '(tree compact))
        (check-equal? (service.catalog-workflow 9 policy: policy) '#(24 30 36 6))))
    (test-case "rejected source carriers retain warm layouts and credentials before corrected revision"
      (for (policy '(tree compact))
        (let* ((source (make-object slots: (prototype-map
                         (list (cons 'value ($constant-slot-spec 7))) policy: policy)))
               (child (.mix source)) (cache (make-slot-cache 'value)) (reads []))
          (check-equal? (.ref/inline child cache) 7)
          (call-with-slot-read-observer (lambda (read) (set! reads (cons read reads)))
            (lambda () (.ref child 'value)))
          (let ((versions (map object-revision (list source child)))
                (instance (object-%instance child)) (layout (object-%layout child))
                (root (object-%slots source))
                (bad (vector (cons 'value ($constant-slot-spec 99)))))
            (check-exception (object-slots-set! source bad) contract-violation-error?)
            (check-exception (object-defaults-set! source bad) contract-violation-error?)
            (check-equal? (map object-revision (list source child)) versions)
            (check-eq? (object-%instance child) instance)
            (check-eq? (object-%layout child) layout)
            (check-eq? (object-%slots source) root)
            (check (andmap object-read-current? reads) => #t)
            (check-equal? (.ref/inline child cache) 7)
            (object-slots-set! source (list (cons 'value ($constant-slot-spec 9))))
            (check-equal? (map object-revision (list source child)) (map 1+ versions))
            (check (ormap object-read-current? reads) => #f)
            (check-equal? (.ref/inline child cache) 9)))))
    (test-case "multi-root merge preserves duplicate priority owned output and persistent revisions"
      (for* ((policy '(tree compact)) (size '(1 8 9 32)))
        (let* ((f identity) (a (string->uninterned-symbol "same")) (b (string->uninterned-symbol "same"))
               (entries (append (list (cons a #f) (cons b f) (cons 'shared f))
                 (for/collect (n (in-range size)) (cons (make-symbol "merge-" n) n))))
               (left (prototype-map entries policy: policy))
               (right (prototype-map (append (list (cons 'shared #f)) (reverse entries)) policy: policy))
               (sources (list left right left))
               (expected (prototype-map-list (prototype-map-merge-first sources policy: policy)))
               (merged (prototype-map-merge-first sources policy: policy)))
          (check-equal? (prototype-map-policy merged) policy)
          (check-equal? (prototype-map-list merged) entries)
          (check-eq? (prototype-map-ref merged b) f)
          (check (prototype-map-ref merged a) => #f)
          (let (view (prototype-map-list merged)) (set-cdr! (car view) 'client-edit))
          (check-equal? (prototype-map-list merged) expected)
          (check-equal? (prototype-map-list left) entries)
          (let* ((next (prototype-map-remove left 'shared))
                 (revised (prototype-map-merge-first (list next right) policy: policy)))
            (check (prototype-map-ref revised 'shared) => #f)
            (check-eq? (prototype-map-ref merged 'shared) f)))))
    (test-case "overlapping declared diamonds retain hidden priority refusal and repaired FUN publication"
      (for (policy '(tree compact))
        (let* ((hidden (.new Slot type: Integer constant: 1 hidden: #t))
               (visible (.new Slot type: Integer constant: 2))
               (base (make-object declarations: (prototype-map (list (cons 'value visible)) policy: policy)))
               (left (make-object supers: [base] declarations: (prototype-map (list (cons 'value hidden)) policy: policy)))
               (right (.mix base)) (owner (.mix left right)))
          (check-equal? (reflect-slots owner) [])
          (.putslot! hidden 'hidden ($constant-slot-spec #f))
          (check-equal? (read-slot owner 'value) 1)
          (.putslot! hidden 'hidden ($thunk-slot-spec (lambda () (raise 'merge-visibility-refusal))))
          (check-eq? (with-catch identity (cut reflect-slots owner)) 'merge-visibility-refusal)
          (.putslot! hidden 'hidden ($constant-slot-spec #f))
          (check-equal? (read-slot owner 'value) 1))
        (check-equal? (service.catalog-workflow 9 policy: policy shared?: #t) '#(24 30 36 6))))
    (test-case "first catalog projection reuses only distinct sole roots and preserves C3 priority"
      (for (policy '(tree compact))
        (let* ((f identity) (source (prototype-map (list (cons 'a #f) (cons 'b f)) policy: policy))
               (empty (prototype-map []))
               (duplicate (prototype-map (list (cons 'a #f) (cons 'a f)) policy: policy)))
          (check-eq? (prototype-map-merge-first (list empty source empty)) source)
          (check-equal? (prototype-map-list (prototype-map-merge-first (list duplicate))) '((a . #f)))
          (let (merged (prototype-map-merge-first (list source (prototype-map '((a . 9) (c . 3))))))
            (check-equal? (prototype-map-keys merged) '(a b c))
            (check (prototype-map-ref merged 'a) => #f)
            (check-eq? (prototype-map-ref merged 'b) f)))
        (check-equal? (prototype-map-list (prototype-map-merge-first [] policy: policy)) [])))
    (test-case "all-pass filter reuses identity with ordered duplicates failure and partial policy"
      (for (policy '(tree compact))
        (let* ((f identity) (source (prototype-map (list (cons 'a #f) (cons 'a f) (cons 'b f)) policy: policy))
               (events []))
          (check-eq? (prototype-map-filter source (lambda (key _value)
            (set! events (cons key events)) #t)) source)
          (check-equal? (reverse events) '(b a a))
          (let (filtered (prototype-map-filter source (lambda (_key value) value)))
            (check-equal? (prototype-map-policy filtered) policy)
            (check-equal? (prototype-map-keys filtered) '(a b))
            (check-eq? (prototype-map-ref filtered 'a) f))
          (check-eq? (with-catch identity (lambda () (prototype-map-filter source
            (lambda (key _value) (if (eq? key 'b) (raise 'filter-refusal) #t))))) 'filter-refusal)
          (check (prototype-map-ref source 'a) => #f)
          (check-exception (prototype-map-filter source 7) contract-violation-error?))))
    (test-case "private reverse folds preserve sparse order refusals and owned partial results"
      (for* ((policy '(tree compact)) (size '(0 1 8 9 32)))
        (let* ((f identity)
               (root (prototype-map (for/collect (n (in-range size))
                       (cons (make-symbol "fold-" n) (if (odd? n) f #f))) policy: policy))
               (source (prototype-map-remove root 'fold-2))
               (before (prototype-map-list source)) (events []))
          (check-eq? (prototype-map-filter source (lambda (name _value)
            (set! events (cons name events)) #t)) source)
          (check-equal? events (map car before))
          (let* ((kept (prototype-map-filter source (lambda (_name value) value)))
                 (snapshot (prototype-map-list kept)))
            (check-equal? (map car snapshot) (map car (filter cdr before)))
            (for (entry snapshot) (check-eq? (cdr entry) f))
            (when (pair? snapshot) (set-cdr! (car snapshot) 'tampered))
            (check-equal? (prototype-map-list source) before)
            (for (name (prototype-map-keys kept)) (check-eq? (prototype-map-ref kept name) f)))
          (when (> size 1)
            (set! events [])
            (let (last-name (caar (reverse before)))
              (check-eq? (with-catch identity (lambda ()
                (prototype-map-filter source (lambda (name _value)
                  (set! events (cons name events))
                  (if (eq? name last-name) (raise 'reverse-fold-refusal) #t))))) 'reverse-fold-refusal)
              (check-equal? events (list last-name)))))))
    (test-case "large policy conversion preserves sparse positions and persistent successors"
      (let* ((source (prototype-map (for/collect (n (in-range 20)) (cons (make-symbol "k-" n) n))))
             (sparse (prototype-map-remove (prototype-map-remove source 'k-0) 'k-7))
             (converted (prototype-map sparse policy: 'compact))
             (changed (prototype-map-put converted 'new #f)))
        (check-equal? (prototype-map-policy converted) 'compact)
        (check-equal? (prototype-map-list converted) (prototype-map-list sparse))
        (check-equal? (prototype-map-policy (prototype-map converted policy: 'tree)) 'tree)
        (check-equal? (prototype-map-ref changed 'k-19) 19)
        (check-equal? (prototype-map-keys changed) (append (prototype-map-keys sparse) '(new)))
        (check-equal? (prototype-map-length sparse) 18)
        (let (small (prototype-map (for/fold (root sparse) (n (in-range 13))
                       (prototype-map-remove root (make-symbol "k-" n))) policy: 'compact))
          (check-equal? (prototype-map-policy small) 'compact)
          (check-equal? (prototype-map-ref (prototype-map-put small 'next 21) 'k-19) 19))))
    (test-case "whole visible catalogs share roots but retain the source revision fence"
      (let* ((root (prototype-map (for/collect (n (in-range 12))
                     (cons (make-symbol "field-" n) (descriptor n))) policy: 'compact))
             (owner (make-object declarations: root)))
        (check-equal? (read-slot owner 'field-11) 11)
        (let (index (object-%declaration-index owner))
          (check-eq? (runtime.slot-ref index 'all) root)
          (check-eq? (runtime.slot-ref index 'visible) root))
        (.putslot! (prototype-map-ref root 'field-0) 'hidden ($constant-slot-spec #t))
        (check-equal? (length (reflect-slots owner)) 11)
        (check-equal? (length (reflect-slots owner include-hidden?: #t)) 12)
        (check-exception (read-slot owner 'field-0) (message? "slot is hidden or undeclared")))
      (let* ((slot (descriptor 7)) (owner (make-object declarations: (list (cons 'value slot)))))
        ;; Even an all-pass reused root is stale after a getter edits its owner.
        (.putslot! slot 'hidden ($thunk-slot-spec (lambda ()
          (.putslot! owner 'extra ($constant-slot-spec 9)) #f)))
        (check-exception (read-slot owner 'value) (message? "object changed during declaration reflection"))
        (check (object-%declaration-index owner) => #f)
        (check-equal? (read-slot owner 'value) 7)
        (check-equal? (.ref owner 'extra) 9)))
    (test-case "indexed map lookup preserves first duplicates false functions and symbol identity"
      (for (policy '(tree compact))
        (let* ((a (string->uninterned-symbol "same")) (b (string->uninterned-symbol "same"))
               (f identity) (missing (list 'missing))
               (root (prototype-map (append (list (cons a #f) (cons a f) (cons b f))
                 (for/collect (n (in-range 12)) (cons (make-symbol "field-" n) n))) policy: policy))
               (changed (prototype-map-put (prototype-map-remove root 'field-3) 'field-11 99)))
          (let (small (prototype-map (list (cons a #f) (cons a f) (cons b f)) policy: policy))
            (check (prototype-map-ref small a missing) => #f)
            (check-eq? (prototype-map-ref small b missing) f))
          (check (prototype-map-ref root a missing) => #f)
          (check-eq? (prototype-map-ref root b missing) f)
          (check-eq? (prototype-map-ref changed 'field-3 missing) missing)
          (check-equal? (prototype-map-ref changed 'field-11) 99)
          (check-equal? (prototype-map-ref root 'field-11) 11)
          (check-eq? (prototype-map-ref (prototype-map []) 'absent missing) missing)
          (check-exception (prototype-map-ref root 7) error?))))
    (test-case "inherited hidden overrides retain precedence and never fall back to a public ancestor"
      (let* ((base-slot (descriptor 7)) (child-slot (descriptor 11 #t))
             (base (make-object declarations: (list (cons 'value base-slot))))
             (child (make-object supers: [base] declarations: (list (cons 'value child-slot)))))
        (check-equal? (read-slot base 'value) 7)
        (check-exception (read-slot child 'value) (message? "slot is hidden or undeclared"))
        (check-eq? (cdar (reflect-slots child include-hidden?: #t)) child-slot)
        (.putslot! child-slot 'hidden ($constant-slot-spec #f))
        (check (object-%declaration-index child) => #f)
        (check-equal? (read-slot child 'value) 11)
        (let ((saved (object-%declaration-index child)) (view (reflect-slots child)))
          (set-car! (car view) 'forged)
          (set-cdr! (car view) base-slot)
          (check-equal? (read-slot child 'value) 11)
          (check-eq? saved (object-%declaration-index child)))
        (let (clone (.cc child))
          (check (object-%declaration-index clone) => #f)
          (check-equal? (read-slot clone 'value) 11)
          (.putslot! child-slot 'constant ($constant-slot-spec 13))
          (check (object-%declaration-index child) => #f)
          (check (object-%declaration-index clone) => #f)
          (check-equal? (read-slot child 'value) 13)
          (check-equal? (read-slot clone 'value) 13))))
    (test-case "public preparation preserves reverse visibility order refusal identity and corrected retry"
      (let* ((a (descriptor 1)) (b (descriptor 2)) (c (descriptor 3)) (events [])
             (owner (make-object declarations: (list (cons 'a a) (cons 'b b) (cons 'c c)))))
        (.putslot! a 'hidden ($thunk-slot-spec (lambda () (set! events (cons 'a events)) #f)))
        (.putslot! b 'hidden ($thunk-slot-spec (lambda () (set! events (cons 'b events)) (raise 'visibility-refusal))))
        (.putslot! c 'hidden ($thunk-slot-spec (lambda () (set! events (cons 'c events)) #f)))
        (check-equal? (map car (reflect-slots owner include-hidden?: #t)) '(a b c))
        (check-equal? events [])
        (check-eq? (with-catch identity (cut reflect-slots owner)) 'visibility-refusal)
        (check-equal? (reverse events) '(c b))
        (let (before events)
          (check-exception (read-slot owner 7) contract-violation-error?)
          (check-eq? events before))
        (check-eq? (with-catch identity (cut read-slot owner 'missing)) 'visibility-refusal)
        (check-equal? (map car (reflect-slots owner include-hidden?: #t)) '(a b c))
        (.putslot! b 'hidden ($constant-slot-spec #f))
        (check-equal? (map car (reflect-slots owner)) '(a b c))
        (check-equal? (map car (reference-reflection owner)) '(a b c))
        (check-equal? (read-slot owner 'a) 1)
        (check-exception (read-slot owner 7) contract-violation-error?)
        (check-exception (read-slot owner 'missing) (message? "slot is hidden or undeclared"))))
    (test-case "warm observed reflection authenticates owner membership and preserves hidden deliveries"
      (let* ((a (descriptor 1)) (b (descriptor 2)) (reads []) (hidden [])
             (owner (make-object declarations: (list (cons 'a a) (cons 'b b)))))
        (reflect-slots owner)
        (call-with-slot-read-observer
          (lambda (read)
            (set! reads (cons read reads))
            (when (eq? (slot-read-key read) 'hidden)
              (set! hidden (cons (slot-read-receiver read) hidden))))
          (cut reflect-slots owner))
        (check-equal? (reverse hidden) (list b a))
        (check (any (lambda (read) (and (eq? (slot-read-receiver read) owner)
          (equal? (slot-read-key read) '(names)))) reads) => #t)
        (replay-slot-reads! reads (lambda (_owner _key) (void)))
        (replace-object-supers! owner (list (make-object declarations: (list (cons 'c (descriptor 3))))))
        (check-exception (replay-slot-reads! reads (lambda (_owner _key) (void))) error?)
        (check-equal? (map car (reflect-slots owner)) '(a b c))
        (check-equal? (read-slot owner 'c) 3)))
    (test-case "observer source changes refuse stale publication and allow a fresh retry"
      (let* ((slot (descriptor 7)) (owner (make-object declarations: (list (cons 'value slot))))
             (edited? #f) (delivered 0))
        (read-slot owner 'value)
        (check-exception
          (call-with-slot-read-observer
            (lambda (read)
              (when (and (not edited?) (eq? (slot-read-receiver read) slot)
                         (eq? (slot-read-key read) 'hidden))
                (set! edited? #t)
                (.putslot! owner 'extra ($constant-slot-spec 9))))
            (lambda () (reflect-slots owner) (set! delivered (1+ delivered))))
          (message? "object changed during declaration reflection"))
        (check-equal? delivered 0)
        (check (object-%declaration-index owner) => #f)
        (check-equal? (.ref owner 'extra) 9)
        (check-equal? (read-slot owner 'value) 7)))
    (test-case "admission callbacks cannot return or install across shared metadata revisions"
      (for (write? '(#f #t))
        (let* ((slot (descriptor 7)) (armed? #f)
               (checked (.cc (.ref slot '.type) '.slot.check
                 (lambda (_metadata _name _candidate)
                   (when armed? (.putslot! slot 'hidden ($constant-slot-spec #t))) #t)))
               (_ (.putslot! slot '.type ($constant-slot-spec checked)))
               (base (make-object declarations: (list (cons 'value slot))))
               (owner (.mix base)) (peer (.mix base)) (site (make-slot-cache 'value)) (reads []))
          (check-equal? (.ref/inline owner site) 7)
          (check-equal? (read-slot peer 'value) 7)
          (call-with-slot-read-observer (lambda (read) (set! reads (cons read reads)))
            (lambda () (.ref owner 'value)))
          (let (direct (object-%slots owner))
            (set! armed? #t)
            (check-exception (if write? (write-slot! owner 'value 7) (read-slot owner 'value))
              (message? "object changed during declaration reflection"))
            (check-eq? (object-%slots owner) direct)
            (check (andmap object-read-current? reads) => #f)
            (check-exception (read-slot peer 'value) (message? "slot is hidden or undeclared"))
            (set! armed? #f)
            (.putslot! slot 'hidden ($constant-slot-spec #f))
            (when write? (write-slot! owner 'value 7))
            (check-equal? (read-slot owner 'value) 7)
            (check-equal? (.ref/inline owner site) 7)
            (check (andmap object-read-current? reads) => #f)))))
    (test-case "validation refusal outranks stale revisions and complete FUN publication retries"
      (for (raise? '(#f #t))
        (let* ((slot (descriptor 7))
               (checked (.cc (.ref slot '.type) '.slot.check
                 (lambda (_metadata _name _candidate)
                   (.putslot! slot 'hidden ($constant-slot-spec #t))
                   (if raise? (raise 'original-admission-refusal) #f))))
               (_ (.putslot! slot '.type ($constant-slot-spec checked)))
               (owner (make-object declarations: (list (cons 'value slot)))))
          (if raise?
            (check-eq? (with-catch identity (cut read-slot owner 'value)) 'original-admission-refusal)
            (check-exception (read-slot owner 'value) (message? "declared slot value rejected")))))
      (check-equal? (service.admission-workflow) '#(9 9 11 2)))
    (test-case "point lookup never caches concrete value admission or a refused write"
      (let* ((slot (descriptor 7)) (original (.ref slot '.type)) (calls 0)
             (checked (.cc original '.slot.check
               (lambda (metadata name candidate)
                 (set! calls (1+ calls)) (.call original .slot.check metadata name candidate))))
             (owner (make-object declarations: (list (cons 'value slot)))))
        (.putslot! slot '.type ($constant-slot-spec checked))
        (check-equal? (read-slot owner 'value) 7)
        (check-equal? (read-slot owner 'value) 7)
        (check-equal? calls 4)
        (let ((revision (object-revision owner)) (index (object-%declaration-index owner)))
          (check-exception (write-slot! owner 'value 8) (message? "declared slot value rejected"))
          (check-equal? (object-revision owner) revision)
          (check-eq? (object-%declaration-index owner) index))
        (check-equal? calls 5)
        (write-slot! owner 'value 7)
        (check-equal? calls 7)
        (check (object-%declaration-index owner) => #f)
        (check-equal? (reference-read-slot owner 'value) 7)))
    (test-case "shared module publication demands typed fields through both point lookup strategies"
      (for* ((policy '(tree compact)) (read (list read-slot reference-read-slot)))
        (check-equal? (service.catalog-workflow 9 policy: policy inspect:
          (lambda (owner)
            (for (entry (reflect-slots owner)) (read owner (car entry)))
            (.alist owner))) '#(24 30 36 6))))))
