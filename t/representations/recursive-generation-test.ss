;;; Automatic recursive generation, bounded membership, shrinking and replay.
(export recursive-generation-test discovery-test)
(import (only-in :std/list/list take drop) (prefix-in :clan/poo/testing/property/generator core.) :std/test :std/error :std/iter :clan/poo/object :clan/poo/mop :clan/poo/type :clan/poo/number
        :clan/poo/testing/generation-graph :clan/poo/testing/type
        (prefix-in :clan/poo/examples/recursive-trees trees.)
        (prefix-in :clan/poo/testing/property/replay corpus.))

;; Match only a controlled refusal and its precise resource tag.
(def (limited? kind)
  (lambda (cause) (and (generation-refusal? cause) (eq? (generation-refusal-kind cause) kind))))
;; Inspect recorded resource refusals rather than accepting unrelated errors.
(def (reason report)
  (and (generation-refusal? (.get report cause)) (generation-refusal-kind (.get report cause))))
;; Every case checks a complete protocol outcome; no trial count is reduced to
;; make a recursive descriptor pass, and no inconclusive result is a success.
(def recursive-generation-test
  (test-suite "automatic guarded recursive generators"
    (test-case "keyword spelling shrink preserves exact carrier and strict content rank"
      (def sampler (generator Keyword))
      (for (text (list "" "a:" " spaced " (string #\x00 #\x10ffff)))
        (def value (string->keyword text))
        (check (element? Keyword value) => #t)
        (for (smaller (.call sampler shrink value))
          (check (keyword? smaller) => #t)
          (check (< (.call sampler measure smaller) (.call sampler measure value)) => #t)))
      (check-equal? (.call sampler shrink (string->keyword "")) [])
      (check (element? Keyword 'name) => #f)
      (check (element? Keyword "name") => #f))
    (test-case "keyword leaves compose in recursive shared and tagged carriers"
      (def descriptor (Tuple Keyword (List Keyword) (Pair Keyword (OrFalse Keyword))
        (Sum key: Keyword text: String)))
      (def report (check-property descriptor (cut element? descriptor <>)
        seed: 42 cases: 15 size: 8 shrink-budget: 80))
      (check-eq? (.get report status) 'passed))
    (test-case "standard integer carrier families derive within bounds and size windows"
      (for (descriptor (list (IntegerRange min: 8000 max: 8007) (IntegerRange max: -10)
                            (UIntN 8) (IntN 8) (UIntN 0) (UIntN 256) (Z/ 7)))
        (def sampler (generator descriptor))
        (def lower (.get descriptor .most-negative)) (def upper (.get descriptor .most-positive))
        (def anchor (core.integer-range-anchor lower upper))
        (for (seed (in-range 8))
          (def value (.call sampler draw (core.random-at seed) 8))
          (check (element? descriptor value) => #t)
          (check (<= (abs (- value anchor)) 8) => #t)
          (for (smaller (.call sampler shrink value))
            (check (element? descriptor smaller) => #t)
            (check (< (.call sampler measure smaller) (.call sampler measure value)) => #t)))
        (check-equal? (.call sampler draw (core.random-at 1) 0) anchor)))
    (test-case "empty integer domains remain uninhabited alternatives without resampling"
      (def Empty (IntegerRange min: 9 max: 4))
      (check-eq? (.get (check-property Empty (lambda (_) #t)) status) 'exhausted)
      (check-eq? (.get (check-property (Z/ 0) (lambda (_) #t)) status) 'exhausted)
      (check-eq? (.get (check-property (Union Empty (Z/ 1)) zero? cases: 8) status) 'passed)
      (check-eq? (.get (check-property (List Empty) null? cases: 8) status) 'passed))
    (test-case "invalid numeric metadata stays an error and floating carriers remain explicit"
      (for (descriptor (list (IntN 0) (UIntN -1)
        (.cc (IntegerRange min: 0 max: 3) .most-positive: 3.0) Float Real Number))
        (check-exception (generator descriptor) Error?)))
    (test-case "range bound getters cannot revise an earlier Type then reach later metadata"
      (def Early (IntegerRange min: 0 max: 9)) (def later 0)
      (def Range (IntegerRange min: 5 max: 9))
      (.putslot! Range '.most-negative ($self-slot-spec
        (lambda (_self) (.set! Early sexp 'retired) 5)))
      (.putslot! Range '.most-positive ($self-slot-spec
        (lambda (_self) (set! later (1+ later)) 9)))
      (check-exception (generator (Tuple Early Range)) (limited? 'stale))
      (check-equal? later 0))
    (test-case "bound revisions retire numeric samplers while fresh metadata and overrides work"
      (def Range (IntegerRange min: 5 max: 9))
      (def old (generator-core (generator Range)))
      (.set! Range .most-positive 6)
      (check-exception (core.generate old (core.random-at 1) 8) core.stale-generation?)
      (def fresh (generator Range))
      (for (seed (in-range 8))
        (check (<= 5 (.call fresh draw (core.random-at seed) 8) 6) => #t))
      (def Custom (.cc Range .generator: (lambda ()
        (make-generator Custom (lambda (_random _size) 6) (lambda (_) []) (lambda (_) 0)))))
      (check-eq? (.get (check-property Custom (cut = <> 6) cases: 4) status) 'passed))
    (test-case "Sum labels stay distinct when payload descriptors share one graph node"
      (def descriptor (Sum left: UInt right: UInt absent: (Exactly #f)))
      (def sampler (generator descriptor)) (def seen (make-hash-table-eq))
      (for (seed (in-range 48))
        (def value (.call sampler draw (core.random-at seed) 8))
        (hash-put! seen (.get value tag) #t)
        (check (element? descriptor value) => #t))
      (check-equal? (hash-length seen) 3)
      (for (tag '(left right))
        (def value (.call descriptor make tag 8))
        (def candidates (.call sampler shrink value))
        (check (pair? candidates) => #t)
        (for (candidate candidates)
          (check-eq? (.get candidate tag) tag)
          (check (< (.get candidate value) 8) => #t)))
      (check-equal? (.call sampler shrink (.call descriptor make 'absent #f)) []))
    (test-case "Sum recursive carriers use the same depth node and observation guards"
      (def descriptor (Sum leaf: UInt children: (List UInt)))
      (.set! (.get descriptor variants) children (List descriptor))
      (def report (check-property descriptor object? cases: 24 seed: 19 size: 4
        depth: 7 node-budget: 48 search-budget: 8192))
      (check-eq? (.get report status) 'passed)
      (check-eq? (.get (check-property descriptor object? depth: 1) status) 'exhausted)
      (check-eq? (.get (check-property descriptor object? node-budget: 1) status) 'exhausted)
      (check-eq? (.get (check-property (Sum) object?) status) 'exhausted))
    (test-case "Sum rejects unknown labels before payload getters and altered constructors"
      (def descriptor (Sum debit: UInt)) (def sampler (generator descriptor))
      (def reads 0)
      (def invalid (.o tag: 'unknown value: (begin (set! reads (1+ reads)) 8)))
      (check-exception (.call sampler measure invalid) Error?)
      (check-equal? reads 0)
      (def wrong (.cc descriptor make: (lambda (_tag value) (.o tag: 'unknown value: value))))
      (check-eq? (.get (check-property wrong (lambda (_) #f)) status) 'error)
      (def cause (Error "Sum constructor failure"))
      (def broken (.cc descriptor make: (lambda (_tag _value) (raise cause))))
      (check-eq? (.get (check-property broken (lambda (_) #f)) cause) cause)
      (def directory (.get descriptor variants))
      (def changing (.cc descriptor variants: directory make: (lambda (label payload)
        (.o tag: (begin (.set! directory debit UInt) label)
          value: (begin (set! reads (1+ reads)) payload)))))
      (check-eq? (.get (check-property changing (lambda (_) #f)) status) 'stale)
      (check-equal? reads 0))
    (test-case "Sum directory epochs retire old draws and fresh preparation reads effective variants"
      (def descriptor (Sum debit: UInt)) (def directory (.get descriptor variants))
      (def old (generator-core (generator descriptor)))
      (.set! directory debit Bool)
      (check-exception (core.generate old (core.random-at 1) 5) core.stale-generation?)
      (def fresh (generator descriptor))
      (for (seed (in-range 6))
        (check (boolean? (.get (.call fresh draw (core.random-at seed) 5) value)) => #t)))
    (test-case "Sum preparation refuses a changed directory before reading the next branch"
      (def later 0)
      (def directory (.o first: UInt second: (begin (set! later (1+ later)) UInt)))
      ;; Change a distinct captured owner, rather than mutating a receiver during
      ;; its own slot evaluation (which POO already refuses independently).
      (def descriptor (.cc (Sum first: UInt second: UInt) variants: directory))
      (.putslot! descriptor 'variant-names ($self-slot-spec
        (lambda (_self) (.set! directory first Bool) '(first second))))
      (check-exception (generator descriptor) (limited? 'stale))
      (check-equal? later 0))
    (test-case "Sum edge discovery captures early Types and reserves fuel before metadata getters"
      (def Early (.cc UInt)) (def later 0)
      (def directory (.o first: Early
        second: (begin (.set! Early sexp 'retired-early) UInt)
        third: (begin (set! later (1+ later)) UInt)))
      (def descriptor (.cc (Sum first: UInt second: UInt third: UInt) variants: directory))
      (check-exception (generator descriptor) (limited? 'stale))
      (check-equal? later 0)
      (def reads 0)
      (def bounded (.cc (Sum first: UInt)
        variants: (.o first: (begin (set! reads (1+ reads)) UInt))))
      (check-exception (generator bounded descriptor-budget: 1) (limited? 'descriptors))
      (check-equal? reads 0))
    (test-case "Sum composes nested Record Function payloads without replacing their wrappers"
      (def calls 0)
      (def Schema (Record handler: [(Function [Integer] [Integer])]))
      (define-type Leaf (.cc Schema .element?: (cut element? Schema <>)
        .generator: (lambda () (make-generator Leaf
          (lambda (_random _size) (make-instance Schema handler:
            (lambda (value) (set! calls (1+ calls)) (abs value))))
          (lambda (_) []) (lambda (_) 0)))))
      (def descriptor (Sum direct: Leaf nested: (Tuple (Pair Leaf (Maybe Leaf)))))
      (def sampler (generator descriptor)) (def seen (make-hash-table-eq))
      (for (seed (in-range 12))
        (def value (.call sampler draw (core.random-at seed) 3))
        (def payload (.get value value))
        (hash-put! seen (.get value tag) #t)
        (def record (if (eq? (.get value tag) 'direct) payload (car (vector-ref payload 0))))
        (def handler (.get record handler))
        (check-equal? (handler -2) 2)
        (check-exception (handler 'invalid) TypeError?))
      (check-equal? calls 12)
      (check-equal? (hash-length seen) 2))
    (test-case "tagged journal uses Record FUN shrinking portable replay and fresh repair"
      (def deliveries 0)
      (def action (trees.tagged-journal-tests (lambda (report) (set! deliveries (1+ deliveries)) report)))
      (def report (action (.o seed: 43 cases: 30 size: 8 shrink-budget: 150)))
      (check-equal? deliveries 1)
      (check-eq? (.get report status) 'failed)
      (def witness (.get report counterexample))
      (check-equal? (length witness) 1)
      (check-eq? (.get (car witness) tag) 'debit)
      (check-equal? (.get (car witness) value) 1)
      (check-eq? (.get (replay-property report) status) 'failed)
      (def (property commands)
        (def observation (trees.journal-observation commands #t))
        (= (.get observation expected) (.get observation actual)))
      (def codec (corpus.make-codec '(tagged-journal 1)
        (lambda (commands) (map (lambda (command) (cons (.get command tag) (.get command value))) commands))
        (lambda (entries) (map (lambda (entry) (.call trees.JournalCommand make (car entry) (cdr entry))) entries))))
      (def output (open-output-string))
      (write-counterexample report codec output)
      (check (read-counterexample (.get report sampler) codec (open-input-string (get-output-string output)) property) => #f)
      (.set! (.get trees.JournalCommand variants) debit UInt)
      (check-exception (replay-property report) Error?)
      (def repaired ((trees.tagged-journal-tests identity faulty?: #f)
        (.o seed: 43 cases: 30 size: 8 shrink-budget: 150)))
      (check-eq? (.get repaired status) 'passed))
    (test-case "negative hook metadata refuses later own and inherited definitions"
      (for (target '(self parent))
        (def raw #f) (def draws 0) (def hooks 0)
        (def descriptor (.cc Integer .generator: (lambda () raw)))
        (def parent (make-generator descriptor
          (lambda (_random _size) (set! draws (1+ draws)) 1) (lambda (_) []) abs))
        (set! raw (if (eq? target 'self) parent (.o inherit: [parent])))
        (def generation (generator-core (generator descriptor)))
        (check-equal? (core.sample-value (core.generate generation (core.random-at 1) 0)) 1)
        ;; Parent changes must invalidate the sampled child's captured revision.
        (.set! (if (eq? target 'self) raw parent) .current?
          (lambda () (set! hooks (1+ hooks)) #f))
        (check-exception (core.generate generation (core.random-at 2) 0) core.stale-generation?)
        (check-equal? (list draws hooks) '(1 0))))
    (test-case "typed recursive Lists share complete structural deletion and value callbacks"
      (def descriptor (List UInt))
      (def sampler (generator descriptor))
      (def candidates (.call sampler shrink '(11 99 22)))
      (check (and (member '(11 22) candidates) #t) => #t)
      (check (and (member '(11 99) candidates) #t) => #t)
      (def generation (generator-core sampler))
      (def root (let find ((seed 0))
        (when (= seed 100) (error "fixture needs a nontrivial typed list"))
        (def tree (core.generate generation (core.random-at seed) 5))
        (if (>= (length (core.sample-value tree)) 3) tree (find (1+ seed)))))
      (def original (core.sample-value root))
      (def expected (append (take original 1) (drop original 2)))
      ;; Stop at the retained witness without draining the lazy Iterator.
      (def found (let/cc return
        (for (child ((core.sample-children root)))
          (when (and (core.sample? child) (equal? (core.sample-value child) expected))
            (return #t)))
        #f))
      (check-eq? found #t)
      (def callbacks 0)
      (define-type GuardedLeaf (.cc Type. .element?: exact-integer?
        .generator: (lambda () (make-generator GuardedLeaf (lambda (_random _) 1)
          (lambda (_) (set! callbacks (1+ callbacks)) []) abs))))
      (def limited (generator (List GuardedLeaf) search-budget: 6))
      (check-exception (.call limited shrink '(1 2 3 4)) (limited? 'search))
      (check-equal? callbacks 0))
    (test-case "Or reuses bounded alternative generation shrinking and replay"
      (def descriptor (Or (List UInt) (Tuple Bool)))
      (def passed (check-property descriptor (cut element? descriptor <>)
        seed: 39 cases: 20 size: 5 depth: 6 node-budget: 32))
      (check-equal? (.get passed status) 'passed)
      (check-equal? (.get passed trial) 20)
      (def failed (check-property descriptor (lambda (_) #f)
        seed: 39 cases: 20 size: 5 depth: 6 node-budget: 32 shrink-budget: 30))
      (check-equal? (.get failed status) 'failed)
      (check-equal? (.get (replay-property failed) status) 'failed))
    (test-case "mutual recursion and shared children derive without custom callbacks"
      (let (report (check-property trees.Message (cut element? trees.Message <>) seed: 37
                      cases: 150 size: 5 depth: 10 node-budget: 100 search-budget: 20000))
        (check-equal? (.get report status) 'passed)
        (check-equal? (.get report trial) 150)
        (check-equal? (.get report limits depth) 10)))
    (test-case "FUN workflow shrinks a recursive false witness and replays it"
      (let* ((consumed 0)
             (action (trees.tree-tests (lambda (report) (set! consumed (+ consumed 1)) report)))
             (report (action (.o seed: 42 cases: 100 size: 12 shrink-budget: 300
                                depth: 10 node-budget: 100 search-budget: 20000)))
             (replayed (replay-property report)))
        (check-equal? (.get report status) 'failed)
        (check-equal? (abs (trees.tree-total (.get report counterexample) 64)) 4)
        (check-equal? (.get replayed original) (.get report original))
        (check-equal? (.get replayed counterexample) (.get report counterexample))
        (check-equal? (.get replayed attempts) (.get report attempts))
        (check-equal? (.get report node-budget) 100)
        (check-equal? consumed 1)))
    (test-case "zero depth and node exhaustion never call the property"
      (let* ((calls 0) (property (lambda (_) (set! calls (+ calls 1)) #t))
             (depth (check-property trees.Tree property depth: 0 node-budget: 10))
             (nodes (check-property trees.Tree property depth: 10 node-budget: 0)))
        (check-equal? (.get depth status) 'exhausted)
        (check-equal? (reason depth) 'depth)
        (check-equal? (.get nodes status) 'exhausted)
        (check-equal? (reason nodes) 'nodes)
        (check-equal? calls 0)
        (check-equal? (.get (replay-property depth) status) 'exhausted)))
    (test-case "nonproductive carrier cycles exhaust depth, not divergence"
      (let* ((loop (.o self: self inherit: [Pair.] left: Integer right: self sexp: 'Loop))
             (report (check-property loop true depth: 12 node-budget: 100)))
        (check-equal? (.get report status) 'exhausted)
        (check-equal? (reason report) 'depth)))
    (test-case "transparent alias cycles are refused before recursive Type recognition"
      (let* ((loop (.o self: self inherit: [Union.] (types (list self Bool)) sexp: 'Alias))
             (report (check-property loop true)))
        (check-equal? (.get report status) 'unsupported)
        (check-equal? (reason report) 'unguarded)
        (check-equal? (.get report trial) 0)
        (check (.get report replayable?) => #f)
        (check-exception (replay-property report) Error?)))
    (test-case "shared-edge discovery and membership have independent work quotas"
      (let* ((descriptor (Tuple Integer Integer Integer))
             (compiled (check-property descriptor true descriptor-budget: 2))
             (parsed (check-property trees.Tree true search-budget: 1 depth: 8)))
        (check-equal? (reason compiled) 'descriptors)
        (check-equal? (reason parsed) 'search)
        (check-equal? (.get compiled status) 'exhausted)
        (check-equal? (.get parsed status) 'exhausted)))
    (test-case "minimum-cost selection reserves nodes for every mandatory sibling"
      (let* ((descriptor (Tuple (List trees.Tree) trees.Tree (Maybe trees.Tree)))
             (report (check-property descriptor (cut element? descriptor <>) seed: 88
                      cases: 200 depth: 8 node-budget: 5 size: 1000)))
        (check-equal? (.get report status) 'passed)))
    (test-case "empty finite alternatives are excluded without rejection sampling"
      (let* ((descriptor (Union (Enum) Integer))
             (report (check-property descriptor exact-integer? seed: 3 cases: 100)))
        (check-equal? (.get report status) 'passed))
      (check-equal? (.get (check-property (Enum) true) status) 'exhausted))
    (test-case "compiled samplers refuse descriptor changes before testing or replay"
      (let* ((descriptor (.o inherit: [List.] type: Integer sexp: 'Numbers))
             (sampler (generator descriptor 6)))
        (.putslot! descriptor 'type ($constant-slot-spec Bool))
        (let (report (check-property descriptor true sampler: sampler))
          (check-equal? (.get report status) 'stale)
          (check-equal? (.get report trial) 0)
          (check-exception (replay-property report) Error?))))
    (test-case "recursive carrier cycles are bounded refusals without native recursion"
      (let* ((descriptor (.o self: self inherit: [Union.]
                           (types (list Integer (Pair Integer self))) sexp: 'Chain))
             (sampler (generator descriptor 8)) (value (cons 1 #f)))
        (set-cdr! value value)
        (check (.call sampler .accept? value) => #f))
      (let* ((sampler (generator (List Integer) 8)) (value (list 1)))
        (set-cdr! value value)
        (check (.call sampler .accept? value) => #f)))
    (test-case "custom leaf exceptions retain identity and do not switch alternatives"
      (let* ((cause (Error "leaf"))
             (descriptor (.o self: self inherit: [Type.] .element?: exact-integer?
                           .generator: (lambda () (make-generator self
                             (lambda (_random _size) (raise cause)) (lambda (_) []) abs))))
             (report (check-property (Tuple descriptor) true)))
        (check-equal? (.get report status) 'error)
        (check (eq? (.get report cause) cause) => #t)))
    (test-case "bounded membership refuses larger witnesses without declaring the Type empty"
      (let (sampler (generator trees.Tree 8 node-budget: 2))
        (check (.call sampler .accept? 3) => #t)
        (check (element? trees.Tree '(1 2)) => #t)
        (check (.call sampler .accept? '(1 2)) => #f)))
    (test-case "work and candidate exhaustion retain the original false witnesses"
      ;; Keep the six-element workload: root + nine structural reservations + six
      ;; child walks exceed 15. Four elements fit that work but yield >15
      ;; candidates. Both phases retain exact refusal kinds, inputs and replay.
      (for (fixture (list (cons '(8 8 8 8 8 8) 'search)
                         (cons '(8 8 8 8) 'candidates)))
        (let* ((descriptor (List Integer))
               (base (generator descriptor 2 node-budget: 20 search-budget: 15))
               (sampler (.cc base draw: (lambda (_random _size) (car fixture))))
               (report (check-property descriptor false sampler: sampler))
               (again (replay-property report)))
          (check-equal? (.get report status) 'exhausted)
          (check-equal? (reason report) (cdr fixture))
          (check-equal? (.get report original) (car fixture))
          (check (.get report minimal?) => #f)
          (check-equal? (.get report limits search) 15)
          (check-equal? (reason again) (cdr fixture)))))
    (test-case "compilation-time descriptor mutation cannot capture fresh authority"
      (let* ((root #f) (calls 0)
             (child (.o self: self inherit: [Type.] .element?: exact-integer?
               .generator: (lambda ()
                 (.putslot! root 'type ($constant-slot-spec Bool))
                 (make-generator self (lambda (_random _size) 1) (lambda (_) []) abs)))))
        (set! root (List child))
        (let (report (check-property root (lambda (_) (set! calls (+ calls 1)) #t)))
          (check-equal? (.get report status) 'stale)
          (check-equal? calls 0)
          (check-exception (replay-property report) Error?))))
    (test-case "recursive scalar admission refuses before measure or a shared sibling"
      (for (action '(admit measure shrink))
        (def owner (.o epoch: 0)) (def armed #f) (def admissions 0) (def measures 0)
        (define-type Leaf (.cc Type. .element?: (lambda (value)
          (when armed (set! admissions (1+ admissions))
            (.putslot! owner 'epoch ($constant-slot-spec (1+ (.get owner epoch)))))
          (exact-integer? value))
          .generator: (lambda () (make-generator Leaf (lambda (_random _size) 1) (lambda (_) [])
            (lambda (_) (set! measures (1+ measures)) 1) dependencies: (list owner)))))
        (def sampler (generator (Tuple Leaf Leaf)))
        (set! armed #t)
        (check-exception (case action
          ((admit) (.call sampler .accept? #(1 1)))
          ((measure) (.call sampler measure #(1 1)))
          ((shrink) (.call sampler shrink #(1 1)))) (limited? 'stale))
        (check-equal? (list admissions measures) '(1 0))))
    (test-case "recursive scalar measure and shrink preserve causes and stop later work"
      (for (mode '(revise error shrink-error))
        (def owner (.o epoch: 0)) (def armed #f) (def measures 0) (def shrinks 0)
        (def cause (cons 'scalar mode))
        (define-type Leaf (.cc Type. .element?: exact-integer?
          .generator: (lambda () (make-generator Leaf (lambda (_random _size) 1)
            (lambda (_) (set! shrinks (1+ shrinks))
              (when armed (.putslot! owner 'epoch ($constant-slot-spec (1+ (.get owner epoch)))) (raise cause)) [])
            (lambda (_) (set! measures (1+ measures))
              (when (and armed (not (eq? mode 'shrink-error)))
                (.putslot! owner 'epoch ($constant-slot-spec (1+ (.get owner epoch))))
                (when (eq? mode 'error) (raise cause))) 1) dependencies: (list owner)))))
        (def sampler (generator (Tuple Leaf Leaf)))
        (set! armed #t)
        (def result (with-catch identity (lambda ()
          (if (eq? mode 'shrink-error) (.call sampler shrink #(1 1)) (.call sampler measure #(1 1))))))
        (if (eq? mode 'revise) (check ((limited? 'stale) result) => #t) (check-eq? result cause))
        (check-equal? measures (if (eq? mode 'shrink-error) 2 1))
        (check-equal? shrinks (if (eq? mode 'shrink-error) 1 0))))
    (test-case "recursive bridge preparation refuses before binding the next scalar"
      (def owner (.o epoch: 0)) (def bindings 0)
      ;; Distinct scalar Types share one owner; each custom bridge is built once.
      (def (sampler type)
        (.cc (make-generator type (lambda (_random _size) 1) (lambda (_) []) abs dependencies: (list owner))
          generation: (lambda (_self)
            (set! bindings (1+ bindings))
            (.putslot! owner 'epoch ($constant-slot-spec (1+ (.get owner epoch))))
            (core.generator-unit 1))))
      (define-type Left (.cc Type. .element?: exact-integer? .generator: (lambda () (sampler Left))))
      (define-type Right (.cc Type. .element?: exact-integer? .generator: (lambda () (sampler Right))))
      (check-exception (generator (Tuple Left Right)) (limited? 'stale))
      (check-equal? bindings 1))
    (test-case "shared Record leaves stop recursive work and fresh FUN actions shrink and replay"
      (for (target '(admit weight))
        (def owner (.o epoch: 0)) (def armed #t) (def calls [])
        ;; Test metadata stays independent of the private descriptor graph.
        (def (trigger phase)
          (set! calls (append calls (list phase)))
          (when (and armed (eq? phase target))
            (.putslot! owner 'epoch ($constant-slot-spec (1+ (.get owner epoch))))))
        (def configuration (make-instance PropertyConfiguration seed: 31 cases: 1 size: 3 shrink-budget: 30
          depth: 8 node-budget: 128 search-budget: 20000))
        (def old (trees.source-tree-tests owner trigger identity))
        (let (report (old configuration))
          (check-eq? (.get report status) 'stale)
          (check-eq? (last calls) target)
          (check-equal? (length (filter (cut eq? <> target) calls)) 1)
          (check-equal? (filter (cut eq? <> 'property) calls) [])
          (check-exception (replay-property report) Error?))
        (set! armed #f) (set! calls [])
        (let (report ((trees.source-tree-tests owner trigger identity) configuration))
          (check-eq? (.get report status) 'failed)
          (check-eq? (.get (replay-property report) status) 'failed)
          (check (replay-counterexample report) => #f)
          (check-exception ((.@ (car (vector-ref (.get report counterexample) 1)) handler) 'invalid) TypeError?)
          (check (and (memq 'property calls) #t) => #t))))
    (test-case "repeated draws use their explicit seed, with no cross-run memo reuse"
      (let* ((first (check-property trees.Tree false seed: 99 cases: 1 size: 5 shrink-budget: 0))
             (_other (check-property trees.Message true seed: 101 cases: 50 size: 5))
             (next (replay-property first)))
        (check-equal? (.get first original) (.get next original))
        (check-equal? (.get first counterexample) (.get next counterexample))))))


;; The standard suite owns complete discovery admission, including its temporary
;; inherited scope and its immutable, deduplicated runtime revision ledger.
(def discovery-test
  (test-suite "recursive graph discovery snapshots"
    (test-case "known unvisited descriptor revisions refuse rather than refresh preparation"
      (for (entry '(direct report))
        (def first 0) (def later 0)
        (def Right (.cc Integer epoch: 0 .generator: (lambda ()
          (set! later (1+ later)) (make-generator Right (lambda (_random _size) 2) (lambda (_) []) abs))))
        (def Left (.cc Integer .generator: (lambda ()
          (set! first (1+ first)) (.putslot! Right 'epoch ($constant-slot-spec 1))
          (make-generator Left (lambda (_random _size) 1) (lambda (_) []) abs))))
        (def descriptor (Tuple Left Right))
        (if (eq? entry 'direct)
          (check-exception (generator descriptor) (limited? 'stale))
          (let (report (check-property descriptor (lambda (_) (error "obsolete property ran")) cases: 1))
            (check-eq? (.get report status) 'stale)
            (check (.get report replayable?) => #f)
            (check-equal? (.get report attempts) 0)))
        (check-equal? (list first later) '(1 0))))
    (test-case "later factories cannot refresh an already declared shared dependency"
      (def owner (.o epoch: 0)) (def later 0)
      (def Left (.cc Integer .generator: (lambda ()
        (make-generator Left (lambda (_random _size) 1) (lambda (_) []) abs dependencies: (list owner)))))
      (def Right (.cc Integer .generator: (lambda ()
        (.putslot! owner 'epoch ($constant-slot-spec 1))
        (make-generator Right (lambda (_random _size) 2) (lambda (_) []) abs)) ))
      (def Tail (.cc Integer .generator: (lambda ()
        (set! later (1+ later)) (make-generator Tail (lambda (_random _size) 3) (lambda (_) []) abs))))
      (check-exception (generator (Tuple Left Right Tail)) (limited? 'stale))
      (check-equal? later 0))
    (test-case "opaque sampler refusal and hook errors stop the next factory"
      (for (mode '(stale error))
        (def later 0) (def cause (cons mode 'hook))
        (def Left (.cc Integer .generator: (lambda ()
          (.cc (make-generator Left (lambda (_random _size) 1) (lambda (_) []) abs)
            .current?: (lambda () (if (eq? mode 'error) (raise cause) #f))))))
        (def Right (.cc Integer .generator: (lambda ()
          (set! later (1+ later)) (error "later factory must not run"))))
        (def result (with-catch identity (lambda () (generator (Tuple Left Right)))))
        (if (eq? mode 'stale) (check ((limited? 'stale) result) => #t) (check-eq? result cause))
        (check-equal? later 0)))
    (test-case "factory exceptions retain their original identity after a known revision"
      (def cause (cons 'factory 'original)) (def later 0)
      (def Right (.cc Integer epoch: 0 .generator: (lambda () (set! later (1+ later)) (error "unreachable"))))
      (def Left (.cc Integer .generator: (lambda ()
        (.putslot! Right 'epoch ($constant-slot-spec 1)) (raise cause))))
      (check-eq? (with-catch identity (lambda () (generator (Tuple Left Right)))) cause)
      (check-equal? later 0)
      (check-equal? (.call (generator Integer) measure 1) 2))
    (test-case "discovery inherits active producers and suppresses obsolete nested maps"
      (def live #t) (def mapped 0)
      (def Leaf (.cc Integer .generator: (lambda ()
        (set! live #f)
        (core.generate (core.generator-map (core.generator-unit 1)
          (lambda (value) (set! mapped (1+ mapped)) value)) (core.random-at 1) 0)
        (make-generator Leaf (lambda (_random _size) 1) (lambda (_) []) abs))))
      (def parent (core.make-generator (lambda (_random _size) (generator (Tuple Leaf)))
        (lambda (_) []) current?: (lambda () live)))
      (check-exception (core.generate parent (core.random-at 1) 0) core.stale-generation?)
      (check-equal? mapped 0))
    (test-case "shared graph identities are captured once and retained for runtime admission"
      (def owner (.o epoch: 0)) (def factories 0)
      (def Leaf (.cc Integer .generator: (lambda ()
        (set! factories (1+ factories))
        (make-generator Leaf (lambda (_random _size) 2) (lambda (_) []) abs dependencies: (list owner owner)))))
      (def descriptor (Tuple Leaf (Pair Leaf Leaf)))
      (def graph (compile-graph descriptor 8 128 64 1000 (lambda (type) (.call type .generator))))
      (check-equal? factories 1)
      (check-equal? (length (filter (cut eq? <> owner) (graph-sources graph))) 1)
      (check-equal? (length (graph-stamps graph)) (length (graph-sources graph)))
      (def sampler (generator descriptor))
      (check-equal? factories 2)
      (check (element? descriptor (core.sample-value (core.generate (generator-core sampler) (core.random-at 5) 3))) => #t)
      (.putslot! owner 'epoch ($constant-slot-spec 1))
      (check-exception (core.generate (generator-core sampler) (core.random-at 5) 3) core.stale-generation?)
      (check-equal? factories 2))
    (test-case "automatic shared Record graph preparation refuses mixed epochs then retries through FUN"
      (for (fault '(left right))
        (def owner (.o epoch: 0)) (def armed #t) (def calls [])
        ;; A known sibling or an earlier factory dependency changes during discovery.
        (def (trigger phase target)
          (set! calls (append calls (list phase)))
          (when (and armed (eq? phase fault))
            (.putslot! target 'epoch ($constant-slot-spec (1+ (.get target epoch))))))
        (def action (trees.preparation-tree-tests owner trigger identity))
        (def configuration (make-instance PropertyConfiguration seed: 37 cases: 1 size: 3 shrink-budget: 30))
        (def old (action configuration))
        (check-eq? (.get old status) 'stale)
        (check (.get old replayable?) => #f)
        (check-equal? calls (if (eq? fault 'left) '(left) '(left right)))
        (check-exception (replay-property old) Error?)
        (set! armed #f) (set! calls [])
        (def fresh (action configuration))
        (check-eq? (.get fresh status) 'failed)
        (check-equal? (filter (lambda (phase) (not (eq? phase 'property))) calls) '(left right tail))
        (def value (.get fresh counterexample))
        (check-equal? (.get (vector-ref value 0) key) 0)
        (check-equal? (.get (vector-ref value 1) key) 0)
        (check-exception ((.@ (car (vector-ref value 2)) handler) 'invalid) TypeError?)
        (check (replay-counterexample fresh) => #f)
        (check-eq? (.get (replay-property fresh) status) 'failed)
        (.putslot! owner 'epoch ($constant-slot-spec (1+ (.get owner epoch))))
        (check-exception (replay-property fresh) Error?)
        (check-exception (replay-property old) Error?)
        (check-eq? (.get (action configuration) status) 'failed)))))
