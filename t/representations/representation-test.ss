;;; Persistent storage and guarded layouts are exercised through real object APIs.
(export representation-test)
(import :std/test :std/error :std/iter (only-in :gerbil/runtime/gambit string->uninterned-symbol unbound-global-exception? type-exception?)
        (only-in :std/list/list find)
        (only-in :gerbil/runtime/loader load-module reload-module! list-modules module-load-order)
        (only-in :std/io/tempfile call-with-temporary-directory)
        (only-in :clan/poo/io module-action)
        (only-in :clan/poo/read-route make-read-issuer)
        (prefix-in (only-in :clan/poo/generalized-prototype Observation.) gp.)
        (only-in :clan/poo/mop validate TypeError? Fun Slot .new) (only-in :clan/poo/number Integer)
        :clan/poo/object :clan/poo/prototype-map :clan/poo/slot-layout :clan/poo/slot-observation :clan/poo/meta-prototype
        (prefix-in :clan/poo/examples/representation-service service.))

;; Match protocol refusal rather than accepting unrelated arithmetic exceptions.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (error-message cause) text))))

;; Obtain only the actual structural read without using raw receiver accessors.
(def (names-token owner)
  (def token #f)
  (call-with-slot-read-observer
    (lambda (read)
      (when (and (eq? (slot-read-receiver read) owner) (equal? (slot-read-key read) '(names)))
        (set! token read)))
    (cut .all-slots owner))
  token)

;; A genuine standard source module exercises initialization and reload without
;; an alternate loader, patched runtime, global test registry or compiled fixture.
;; A closure counter detects repeated initialization; business refusal is separate.
(def (write-entry-fixture module binding initial)
  (call-with-output-file (list path: (string-append module ".scm") truncate: #t)
    (lambda (port)
      (write (if initial
        `(define ,binding (let ((calls ,initial))
          (lambda arguments
            (set! calls (+ calls 1))
            (case (car arguments)
              ((deny) (raise 'entry-business-refusal))
              ((scalar) calls)
              (else (values calls #f))))))
        `(begin (define ,binding (lambda arguments 'partial))
                (error "entry initialization refused"))) port)
      (newline port))))

;; Every case composes storage, inheritance and invalidation instead of testing an
;; independent cache model that the object engine does not actually use.
(def representation-test
  (test-suite "persistent prototype maps and coherent access sites"
    (test-case "private traversal preserves ordered duplicate payloads through sparse persistent edits"
      (for* ((policy '(tree compact)) (width '(0 9)))
        (let* ((f (lambda (x) x)) (a (string->uninterned-symbol "same"))
               (b (string->uninterned-symbol "same"))
               (entries (append (list (cons a #f) (cons b f) (cons a f))
                 (for/collect (n (in-range width)) (cons (make-symbol "field-" n) n))))
               (root (prototype-map entries policy: policy))
               (source (prototype-map-remove root 'field-4)) (next source) (seen '()))
          (prototype-map-for-each source (lambda (key value)
            (set! seen (cons (cons key value) seen))
            (set! next (prototype-map-put next 'later #t))))
          (check-equal? (reverse seen) (prototype-map-list source))
          (check-equal? (prototype-map-keys source) (map car (prototype-map-list source)))
          (check-eq? (cdar (prototype-map-list source)) #f)
          (check-eq? (cdr (cadr (prototype-map-list source))) f)
          (check (memq 'later (prototype-map-keys source)) => #f)
          (check (memq 'later (prototype-map-keys next)) ? pair?)
          (let (names (prototype-map-keys source))
            (set-car! names 'forged)
            (check-eq? (car (prototype-map-keys source)) a)))))
    (test-case "traversal rejects bad consumers and preserves original false refusals"
      (check-exception (prototype-map-for-each (prototype-map []) #f) contract-violation-error?)
      (let (calls 0)
        (prototype-map-for-each (prototype-map [] policy: 'compact) (lambda _ (set! calls (1+ calls))))
        (check-equal? calls 0))
      (let ((source (prototype-map '((a . 1) (b . 2) (c . 3)))) (seen '()))
        (check-equal? (with-catch (lambda (cause) (list 'caught cause))
          (lambda () (prototype-map-for-each source (lambda (key _value)
            (set! seen (cons key seen)) (when (eq? key 'b) (raise #f)))))) '(caught #f))
        (check-equal? (reverse seen) '(a b))
        (check-equal? (prototype-map-keys source) '(a b c))))
    (test-case "composition shares direct maps while preserving policy and isolating warmed caches"
      (for (policy '(tree compact))
        (let* ((f (lambda (x) x)) (base (.o seed: 3))
               (override (make-object slots: (prototype-map
                 (list (cons 'total ($self-slot-spec (lambda (self) (+ 1 (.get self seed)))))) policy: policy)
                 defaults: (prototype-map (list (cons 'callback f) (cons 'enabled #f)) policy: policy)))
               (_ (.put! override 'total -99)) (child (.+ base override)))
          (check-eq? (object-%slots child) (object-%slots override))
          (check-eq? (object-%defaults child) (object-%defaults override))
          (check-eq? (prototype-map-policy (object-%slots child)) policy)
          (check (object-%instance child) => #f)
          (check-equal? (.get child total) 4)
          (check-eq? (.get child callback) f)
          (check (.get child enabled) => #f)
          (let (revision (object-revision child))
            (.putslot! override 'total ($constant-slot-spec 100))
            (check-equal? (object-revision child) revision))
          (.putdefault! child 'enabled #t)
          (check-equal? (.get child total) 4)
          (check (.get override enabled) => #f)
          (.put! base 'seed 8)
          (check-equal? (.get child total) 4)
          (.putslot! base 'seed ($constant-slot-spec 8))
          (check-equal? (.get child total) 9))))
    (test-case "persistent composition uses the shared checked module lifecycle for both policies"
      (let (run (module-action "clan/poo/examples/representation-service"
                  'clan/poo/examples/representation-service#composition-workflow))
        (for* ((width '(0 16)) (policy '(tree compact)))
          (check-equal? (run (list width policy: policy)) '#(24 30 36 6)))))
    (test-case "declaration scratch maps retain admission and shared descriptor invalidation"
      (check-exception (.ref (make-object declarations: 'malformed
        slots: (list (cons 'value ($constant-slot-spec 7)))) 'value) true)
      (let* ((descriptor (.new Slot type: Integer constant: 7))
             (source (make-object declarations: (list (cons 'value descriptor))))
             (child (.+ (.o seed: 1) source)))
        (check-equal? (.get source value) 7)
        (check-equal? (.get child value) 7)
        (.put! descriptor 'constant 9)
        (check-equal? (.get source value) 9)
        (check-equal? (.get child value) 9)))
    (test-case "explicit overrides retain final self false Functions and computed suffix order"
      (for (policy '(tree compact))
        (let* ((f (lambda (x) x)) (events '())
               (source (make-object slots: (prototype-map
                 (list (cons 'value ($thunk-slot-spec (lambda () (error "discarded body"))))
                       (cons 'value ($computed-slot-spec (lambda (_ next) (next))))
                       (cons 'value ($self-slot-spec (lambda (self) (.get self payload))))
                       (cons 'value ($computed-slot-spec (lambda (_ next)
                         (set! events (cons 'outer events)) (next))))) policy: policy)
                 defaults: (list (cons 'payload f)))))
          (check-eq? (.ref source 'value) f)
          (check-equal? events '(outer))
          (check-eq? (.ref/inline source (make-slot-cache 'value)) f)
          (check (.ref (.cc source payload: #f) 'value) => #f))))
    (test-case "mixed constructors agree with the original chronological SlotSpec fold"
      (let* ((events '()) (owner (.o seed: 9))
             (specs (list ($constant-slot-spec 1)
               ($computed-slot-spec (lambda (_ next) (+ 1 (next))))
               ($thunk-slot-spec (lambda () 4))
               ($computed-slot-spec (lambda (_ next) (* 2 (next))))
               ($self-slot-spec (lambda (self) (.get self seed)))
               ($computed-slot-spec (lambda (_ next)
                 (set! events (cons 'suffix events)) (+ 5 (next))))))
             (reference (foldl (cut apply-slot-spec owner <> <>) (lambda () -1) specs))
             (actual (make-object supers: (list owner)
               slots: (map (lambda (spec) (cons 'value spec)) specs))))
        (check-equal? (reference) 14)
        (check-equal? (.ref actual 'value) 14)
        (check-equal? events '(suffix suffix))))
    (test-case "malformed shadowed specifications still refuse before hook installation"
      ;; Tag admission must not invent eager body/procedure validation either.
      (check-equal? (.ref (make-object slots:
        (list (cons 'value ($thunk-slot-spec 42))
              (cons 'value ($self-slot-spec 42))
              (cons 'value ($constant-slot-spec 7)))) 'value) 7)
      (let ((calls 0) (bad (make-object slots:
              (list (cons 'value 'invalid) (cons 'value ($constant-slot-spec 7))))))
        (object-protocol-set! bad (.o compute-slot: (lambda (_ next _name) (set! calls (1+ calls)) (next))))
        (check-exception (.ref bad 'value) (message? "No clause matching"))
        (check-equal? calls 0)
        (check (object-%instance bad) => #f)
        (object-slots-set! bad (list (cons 'value ($constant-slot-spec 7))))
        (check-equal? (.ref bad 'value) 7)
        (check-equal? calls 1)))
    (test-case "all slot payloads are captured before compute hooks run"
      (let* ((spec ($constant-slot-spec 7))
             (source (make-object slots: (list (cons 'a spec) (cons 'b spec)))))
        (object-protocol-set! source (.o compute-slot: (lambda (_ next _name)
          (set! ($constant-slot-spec-value spec) 99) (next))))
        (check-equal? (.ref source 'a) 7)
        (check-equal? (.ref source 'b) 7)))
    (test-case "retained computed refusal is retryable and missing super stays lazy"
      (let* ((calls 0) (cause (list 'body-refused))
             (source (make-object slots: (list (cons 'value ($computed-slot-spec
               (lambda (_ _next) (set! calls (1+ calls))
                 (if (= calls 1) (raise cause) #f))))))))
        (check-eq? (with-catch identity (cut .ref source 'value)) cause)
        (check (.ref source 'value) => #f)
        (check-equal? calls 2)))
    (test-case "override construction composes the shared module and checked revision workflow"
      (let (run (module-action "clan/poo/examples/representation-service"
                  'clan/poo/examples/representation-service#override-workflow))
        (for* ((depth '(0 64)) (opaque? '(#f #t)))
          (check-equal? (run (list depth opaque?: opaque?)) '#(24 30 36 6)))))
    (test-case "public names snapshots cannot corrupt canonical reflection or static cells"
      (let* ((f (lambda (x) x)) (payload (list #f f))
             (source (.o enabled: #f callback: f names: payload))
             (site (make-slot-cache 'callback))
             (expected (.all-slots source)) (client (.all-slots source)))
        (check-eq? (.ref/inline source site) f)
        (seal-object! source)
        (set-car! client 'client-only) (set-cdr! client client)
        (check-equal? (.all-slots source) expected)
        (check-equal? (map car (.alist source)) expected)
        (check-eq? (.ref/inline source site) f)
        ;; A list-valued ordinary field called names is USER DATA, not metadata.
        (check-eq? (.get source names) payload)
        (set-car! payload 9)
        (check-eq? (.get source names) payload)
        (check-equal? (car (.get source names)) 9)))
    (test-case "tampered structural spines refuse and repair only the read credential"
      (let* ((a (string->uninterned-symbol "same")) (b (string->uninterned-symbol "same"))
             (source (object<-alist (list (cons a #f)))) (site (make-slot-cache a))
             (token (names-token source)))
        (check (.ref/inline source site) => #f)
        (let ((layout (slot-cache-layout site)) (revision (object-revision source)))
          (set-car! (slot-read-value token) b)
          (check (object-read-issued? token) => #f)
          (let ((calls 0))
            (check-exception (replay-slot-reads! (list token) (lambda _ (set! calls (1+ calls))))
              (message? "unissued slot dependency"))
            (check-equal? calls 0))
          (let (fresh (names-token source))
            (check (object-read-issued? fresh) => #t)
            (check (object-read-current? fresh) => #t)
            (check (object-read-current? token) => #f)
            (check-equal? (.all-slots source) (list a))
            (check-equal? (object-revision source) revision)
            (check-eq? (slot-cache-layout site) layout)
            (check-equal? (slot-cache-hit? site source revision layout) 0)
            ;; Restoring old contents cannot revive a replaced record (ABA).
            (set-car! (slot-read-value token) a)
            (check (object-read-issued? token) => #t)
            (check (object-read-current? token) => #f)
            (check-exception (replay-slot-reads! (list token) (lambda _ (void)))
              (message? "stale slot dependency"))
            ;; A cycle is rejected in work bounded by the private finite names.
            (set-cdr! (slot-read-value fresh) (slot-read-value fresh))
            (check (object-read-issued? fresh) => #f)
            (let (repaired (names-token source))
              (check (object-read-current? repaired) => #t)
              (set-cdr! (slot-read-value repaired) 'improper-tail)
              (check (object-read-issued? repaired) => #f)
              (let (last (names-token source))
                (.putslot! source 'added ($constant-slot-spec 7))
                (check (object-read-current? last) => #f)
                (check-equal? (length (.all-slots source)) 2)))))))
    (test-case "names repair retains cold preparation edges and isolates issuer authorities"
      (let* ((policy (.o port: 1)) (source (.o value: #f)))
        (object-protocol-set! source (.o compute-slot:
          (lambda (_self next _slot) (.get policy port) (next))))
        (let (old (names-token source))
          (set-car! (slot-read-value old) 'forged)
          (let (fresh (names-token source))
            (check (object-read-issued? fresh) => #t)
            (.put! policy 'port 2)
            (check-exception (replay-slot-reads! (list fresh) (lambda _ (void)))
              (message? "stale slot dependency")))))
      (let-values (((issue issued? _inspect) (make-read-issuer)))
        (let* ((source (.o value: #f)) (instance (object-instance source))
               (foreign (issue source 'value (object-revision source) instance #f '() object-read-current?)))
          (check (issued? foreign) => #t)
          (check (object-read-issued? foreign) => #f))))
    (test-case "repair never blesses a cached derived graph containing an old names record"
      (let* ((source (.o self: self enabled: #f count: (length (.all-slots self)))))
        (let-values (((value roots) (%call-with-recorded-slot-reads (cut .get source count))))
          (check-equal? value 2)
          (reobserve-slot-reads! roots)
          (let (token (names-token source))
            (set-car! (slot-read-value token) 'forged)
            (names-token source)
            (let (calls 0)
              (check-exception (reobserve-slot-reads! roots (lambda () (set! calls (1+ calls))))
                (message? "unissued slot dependency"))
              (check-equal? calls 0))
            ;; Use the existing explicit flush for evidence depending on damage;
            ;; retaining unrelated values is not authority to rewrite old parents.
            (uninstantiate-object! source)
            (let-values (((fresh current) (%call-with-recorded-slot-reads (cut .get source count))))
              (check-equal? fresh 2)
              (reobserve-slot-reads! current))))))
    (test-case "names copies preserve observer refusals and shared checked module workflows"
      (let* ((source (.o enabled: #f)) (cause (list 'observer-refused)))
        (check-eq? (with-catch identity
          (lambda () (call-with-slot-read-observer (lambda (_) (raise cause)) (cut .all-slots source)))) cause)
        (check-equal? (.all-slots source) '(enabled)))
      (let (run (module-action "clan/poo/examples/representation-service"
                  'clan/poo/examples/representation-service#reflection-workflow))
        (for (width '(0 16))
          (check-equal? (run (list width)) '#(24 30 36 6)))))
    (test-case "indexed persistent deletion preserves sparse append first-method replacement and snapshots"
      (for (policy '(tree compact))
        (let* ((callback (lambda (x) x))
               (entries (append '((a . 1) (b . #f) (a . 2) (c . 3))
                 (for/collect (n (in-range 16)) (cons (string->symbol (number->string n)) n))
                 (list (cons 'callback callback))))
               (source (prototype-map entries policy: policy))
               (removed (prototype-map-remove source 'a))
               (added (prototype-map-put removed 'new 19))
               (replaced (prototype-map-put added 'b 23)))
          (check-equal? (prototype-map-list source) entries)
          (check-equal? (prototype-map-list removed) (filter (lambda (e) (not (eq? (car e) 'a))) entries))
          (check-equal? (prototype-map-list added) (append (prototype-map-list removed) '((new . 19))))
          (check-equal? (car (prototype-map-list replaced)) '(b . 23))
          (check-eq? (prototype-map-remove removed 'a) removed)
          (let loop ((current replaced) (n 0))
            (when (< n 16)
              (let* ((name (string->symbol (number->string n)))
                     (next (prototype-map-put (prototype-map-remove current name) name (+ n 100))))
                (check-equal? (car (reverse (prototype-map-list next))) (cons name (+ n 100)))
                (check-eq? (cdr (assq 'callback (prototype-map-list next))) callback)
                (loop next (1+ n))))))))
    (test-case "indexed removal composes shared invalidation refinement failure retry and compact demotion"
      (def run (module-action "clan/poo/examples/representation-service"
        'clan/poo/examples/representation-service#removal-workflow))
      (for* ((policy '(tree compact)) (width '(0 5 32)))
        (check-equal? (run (list width policy: policy)) '#(54 24 30 24 54 10)))
      (let* ((parent (.o value: 1)) (child (.o inherit: [parent])) (site (make-slot-cache 'value)))
        (.ref/inline child site)
        (seal-object! parent)
        (let (before (object-revision child))
          (check-exception (.removeslot! parent 'value) (message? "sealed prototype"))
          (check-equal? (object-revision child) before)
          (check-equal? (.ref/inline child site) 1))))
    (test-case "indexed removal distinguishes equal-spelling names and supports empty sparse roots"
      (let* ((a (string->uninterned-symbol "same")) (b (string->uninterned-symbol "same"))
             (source (prototype-map (list (cons a 1) (cons b #f) (cons a 2))))
             (removed (prototype-map-remove source a))
             (empty (prototype-map-remove removed b)))
        (check-equal? (prototype-map-list removed) (list (cons b #f)))
        (check-equal? (prototype-map-list source) (list (cons a 1) (cons b #f) (cons a 2)))
        (check-equal? (prototype-map-list empty) '())
        (check-equal? (prototype-map-list (prototype-map-put empty a 9)) (list (cons a 9))))
      ;; More than eight duplicate contributions test deletion order independently
      ;; of surviving cardinality, including direct tree-to-vector demotion.
      (for (policy '(tree compact))
        (let* ((entries (append (for/collect (n (in-range 12)) (cons 'method n)) '((left . #f) (right . 7))))
               (source (prototype-map entries policy: policy))
               (removed (prototype-map-remove source 'method)))
          (check-equal? (prototype-map-list removed) '((left . #f) (right . 7)))
          (check-equal? (prototype-map-list source) entries)
          (check-equal? (prototype-map-list (prototype-map-put removed 'new 9)) '((left . #f) (right . 7) (new . 9)))
          (check-equal? (prototype-map-policy removed) policy))))
    (test-case "module IO actions delay discovery preserve failures and resolve the current binding"
      (call-with-temporary-directory "poo-module-entry-" (lambda (directory)
        (def module (path-expand "service" directory))
        (def supplied (string-copy module))
        (def binding (make-symbol "poo-entry-" (object->serial-number supplied)))
        (def action (module-action supplied binding))
        (string-set! supplied 0 #\x)
        (check (assoc module (list-modules)) => #f)
        (write-entry-fixture module binding #f)
        (let (cause (with-catch identity (cut action '(ok))))
          (check ((message? "entry initialization refused") cause) => #t)
          ;; A partially published binding is not successful module admission.
          (check (procedure? (eval binding)) => #t)
          (write-entry-fixture module binding 0)
          ;; Standard loader errors remain cached until standard explicit reload.
          (check (eq? (with-catch identity (cut action '(ok))) cause) => #t))
        (reload-module! module)
        (let ((first (eval binding)) (order (module-load-order module)))
          (check-equal? (call-with-values (cut action '(ok)) list) '(1 #f))
          (check-equal? (call-with-values (cut action '(ok)) list) '(2 #f))
          (check (eq? first (eval binding)) => #t)
          (check-equal? (module-load-order module) order)
          (check (eq? (with-catch identity (cut action '(deny))) 'entry-business-refusal) => #t)
          (check-equal? (call-with-values (cut action '(ok)) list) '(4 #f))
          (let (observe (.call gp.Observation. .map (cut + <> 10) action))
            (check-equal? (observe '(scalar)) 15))
          (write-entry-fixture module binding 100)
          (reload-module! module)
          (check (eq? first (eval binding)) => #f)
          (check-equal? (call-with-values (cut action '(ok)) list) '(101 #f))
          (eval `(define ,binding 17))
          (check-exception (action '(ok)) type-exception?))
        (check-exception ((module-action module 'poo-missing-entry) '(ok)) unbound-global-exception?)
        (check-exception (module-action #f binding) contract-violation-error?)
        (check-exception (module-action module "entry") contract-violation-error?))))
    (test-case "runtime entries compose existing shared-service and generalized FUN workflows"
      (def service (module-action "clan/poo/examples/representation-service"
        'clan/poo/examples/representation-service#service-workflow))
      (check-equal? (service '(4 layout: #t reshape?: #t)) '#(30 36 42 12))
      (def prepare (module-action "clan/poo/examples/generalized-checkout"
        'clan/poo/examples/generalized-checkout#prepare-checkout))
      (def report (module-action "clan/poo/examples/generalized-checkout"
        'clan/poo/examples/generalized-checkout#report))
      (let (action (.call gp.Observation. .bind prepare
        (lambda (snapshot) (lambda (_request) (report (list snapshot))))))
        (check-equal? (action []) '(30 33 3)))
      (check-equal? (service.entry-workflow 4 layout: #t) '#(#(30 36 42 12) (30 33 3)))
      (check-exception (service.entry-workflow -1) contract-violation-error?))
    (test-case "two-shape offsets retain no foreign cells and refuse unknown capacities"
      (for (bad '(0 3 -1 2.0 arbitrary))
        (check-exception (make-slot-cache 'value shapes: bad) contract-violation-error?))
      ;; Equal spelling must not collapse symbol identities; deliberately select a
      ;; target which has physical offset zero alone and offset one beside its peer.
      (def ordered (list-sort (lambda (a b) (< (object->serial-number a) (object->serial-number b)))
        (list (string->uninterned-symbol "same") (string->uninterned-symbol "same"))))
      (def name (cadr ordered))
      (def layouts (list (make-slot-layout (list name) #f absent-value)
        (make-slot-layout ordered #f absent-value)
        (make-slot-layout (list name 'third) #f absent-value)))
      (check-equal? (slot-layout-index (car layouts) name) 0)
      (check-equal? (slot-layout-index (cadr layouts) name) 1)
      (def site (make-slot-cache name shapes: 2))
      (def single (make-slot-cache name))
      (for ((layout layouts) (owner '(11 22 33)))
        (slot-layout-set! layout (slot-layout-index layout name) owner))
      ;; Successful indexed binding is the production offset-history boundary.
      (def (bind cache layout owner)
        (slot-cache-bind! cache owner 0 layout (slot-cache-index cache layout)))
      (bind site (car layouts) 11) (bind site (cadr layouts) 22)
      (bind single (car layouts) 11) (bind single (cadr layouts) 22)
      (check-equal? (slot-cache-offset site (car layouts)) (slot-layout-index (car layouts) name))
      (check (slot-cache-offset single (car layouts)) => #f)
      (check (slot-cache-offset site (caddr layouts)) => #f)
      (for (_ (in-range 8))
        (bind site (car layouts) 11) (check-equal? (slot-cache-read site) 11)
        (bind site (cadr layouts) 22) (check-equal? (slot-cache-read site) 22))
      (bind site (caddr layouts) 33)
      (check (slot-cache-offset site (car layouts)) => #f)
      (check (slot-cache-offset site (cadr layouts)) ? number?)
      (def missing (make-slot-layout '(absent) #f absent-value))
      (slot-cache-bind! site 44 1 missing #f)
      (check (slot-cache-hit? site 44 1 missing) => #f)
      (check (slot-cache-offset site (cadr layouts)) ? number?))
    (test-case "alternating guarded shapes preserve false Function refusal observation and revision"
      (def root (.o value: #f))
      (def a (.o inherit: [root] audit: #f))
      (def b (.o inherit: [root] policy: identity))
      (def site (make-slot-cache 'value eager?: #f shapes: 2))
      (check (.ref/inline a site) => #f)
      (check (.ref/inline b site) => #f)
      ;; A lexical boundary captures the guard after BOTH preceding checks have
      ;; run; interleaved internal definitions may be lifted by the test macro.
      (let (before (slot-cache-layout site))
        (.putslot! root 'value ($thunk-slot-spec (lambda () (raise 'shape-refusal))))
        (check-eq? (with-catch identity (cut .ref/inline a site)) 'shape-refusal)
        (check-eq? (slot-cache-layout site) before))
      (def f (validate (Fun Integer <- Integer) (lambda (x) (+ x 7))))
      (.putslot! root 'value ($constant-slot-spec f))
      (check-eq? (.ref/inline a site) f) (check-eq? (.ref/inline b site) f)
      (check-equal? ((.ref/inline a site) 2) 9)
      (check-exception ((.ref/inline b site) #f) TypeError?)
      (def observed [])
      (call-with-slot-read-observer
        (lambda (read) (set! observed (cons (slot-read-key read) observed)))
        (cut .ref/inline b site))
      (check (and (member 'value observed) #t) => #t)
      (.putslot! root 'approval ($constant-slot-spec #f))
      (check-eq? (.ref/inline a site) f)
      (.removeslot! root 'approval)
      (check-eq? (.ref/inline b site) f))
    (test-case "standard module actions compose heterogeneous checked revisions with two shapes"
      (def action (module-action "clan/poo/examples/representation-service"
        'clan/poo/examples/representation-service#service-workflow))
      (def variants (list (.o audit: #f) (.o policy: identity)))
      (check-equal? (action (list 4 layout: #t shapes: 2 variants: variants reshape?: #t)) '#(30 36 42 12))
      (check-equal? (action (list 4 layout: #t shapes: 1 variants: variants reshape?: #t)) '#(30 36 42 12))
      (check-exception (action (list -1 layout: #t shapes: 2 variants: variants)) contract-violation-error?))
    (test-case "shape hints check the complete identity set and never seed foreign cells"
      (def a (string->uninterned-symbol "same")) (def b (string->uninterned-symbol "same"))
      (def original (make-slot-layout (list a 'off a) (list->hash-table (list (cons a 7) (cons 'off 9))) absent-value))
      (def current (make-slot-layout (list 'off a 'off) (list->hash-table (list (cons a #f))) absent-value previous: original))
      (check (eq? (slot-layout-shape current) (slot-layout-shape original)) => #t)
      (check (slot-layout-ref current (slot-layout-index current a)) => #f)
      (check (eq? (slot-layout-ref current (slot-layout-index current 'off)) absent-value) => #t)
      (slot-layout-set! current (slot-layout-index current a) 11)
      (check-equal? (slot-layout-ref original (slot-layout-index original a)) 7)
      ;; Equal lengths and spellings cannot certify a different uninterned name.
      (def replacement (make-slot-layout (list b 'off) #f absent-value previous: original))
      (check (eq? (slot-layout-shape replacement) (slot-layout-shape original)) => #f)
      (check (slot-layout-index replacement a) => #f)
      (for (names (list (list a) (list a 'off 'extra)))
        (let (changed (make-slot-layout names #f absent-value previous: original))
          (check (eq? (slot-layout-shape changed) (slot-layout-shape original)) => #f)))
      (def empty (make-slot-layout [] #f absent-value))
      (check (eq? (slot-layout-shape empty)
        (slot-layout-shape (make-slot-layout [] #f absent-value previous: empty))) => #t))
    (test-case "standard cached service clones reuse shapes across refinement refusal and structural revision"
      (load-module "clan/poo/examples/representation-service")
      (def source (.o inherit: [service.Service] tariff: 3))
      (def a (.o inherit: [source] capacity: 2)) (def b (.o inherit: [source] capacity: 4))
      (def delivered 0) (def layouts [])
      (def action (service.checked-total-action (lambda (owner total)
        (set! layouts (cons (object-%layout owner) layouts)) (set! delivered (1+ delivered)) total)))
      (check-equal? (action a) 9) (check-equal? (action b) 15)
      ;; Refinement owns the admitted receiver; source layouts cannot stand in
      ;; for the freshly validated candidate used by the checked Reader action.
      (let (first (car layouts))
      (check (eq? (slot-layout-shape first) (slot-layout-shape (cadr layouts))) => #t)
      (.putslot! source 'tariff ($constant-slot-spec -1))
      (check-exception (action a) TypeError?) (check-equal? delivered 2)
      (check (object-%layout a) => #f)
      (.putslot! source 'tariff ($constant-slot-spec 5))
      (.putslot! source 'approval ($constant-slot-spec #f))
      (check-equal? (action b) 23) (check-equal? (action a) 13)
      (check (eq? (slot-layout-shape first) (slot-layout-shape (car layouts))) => #f)
      (check (eq? (slot-layout-shape (car layouts)) (slot-layout-shape (cadr layouts))) => #t)
      (.removeslot! source 'approval)
      (check-equal? (action a) 13)
      (check (eq? (slot-layout-shape first) (slot-layout-shape (car layouts))) => #t)
      (check-equal? delivered 5)))
    (test-case "prepared layouts promote only demanded warmed false and checked Function values"
      (def signature (Fun Integer <- Integer))
      (def checked (validate signature (lambda (n) (+ n 1))))
      (def calls 0)
      (def owner (.o
        (off (begin (set! calls (1+ calls)) #f))
        (handler (begin (set! calls (1+ calls)) checked))
        (unused (error "unrelated body forced"))))
      (check (.ref owner 'off) => #f)
      (check (eq? (.ref owner 'handler) checked) => #t)
      (let* ((layout (object-layout owner eager?: #f)) (off (slot-layout-index layout 'off))
             (handler (slot-layout-index layout 'handler)) (site (make-slot-cache 'off eager?: #f)))
        (check (eq? (slot-layout-ref layout off) absent-value) => #t)
        (check (eq? (slot-layout-ref layout handler) absent-value) => #t)
        (check (.ref/inline owner site) => #f)
        (check (slot-layout-ref layout off) => #f)
        (check (eq? (slot-layout-ref layout handler) absent-value) => #t)
        (check (eq? (.ref/inline owner (make-slot-cache 'handler)) checked) => #t)
        (check (eq? (slot-layout-ref layout handler) checked) => #t)
        (check-exception ((.ref/inline owner (make-slot-cache 'handler)) #f) TypeError?)
        (check-equal? calls 2)
        (check (slot-cache-eager? site) => #f)
        (check (slot-cache-eager? (make-slot-cache 'off)) => #t)
        (check-exception (make-slot-cache 'off eager?: 'unknown) contract-violation-error?)))
    (test-case "deferred cells follow shared revisions and retain successful guards on refusal"
      (def base (.o seed: 1)) (def denied? #f) (def cause (list 'original-refusal))
      (def calls 0)
      (def recipe (.o self: self inherit: [base]
        (value (begin (set! calls (1+ calls)) (when denied? (raise cause)) (.get self seed)))
        (unread (error "unrelated dependent body forced"))))
      (def a (.o inherit: [recipe])) (def b (.o inherit: [recipe]))
      (def site (make-slot-cache 'value eager?: #f))
      (check-equal? (.ref a 'value) 1) (check-equal? (.ref b 'value) 1)
      (check-equal? (.ref/inline a site) 1) (check-equal? (.ref/inline b site) 1)
      (check-equal? calls 2)
      (for (owner (list a b))
        (let (layout (object-%layout owner))
          (check (eq? (slot-layout-ref layout (slot-layout-index layout 'seed)) absent-value) => #t)))
      (defvalues (_ reads) (%call-with-recorded-slot-reads (cut .ref/inline a site)))
      (.putslot! base 'seed ($constant-slot-spec #f))
      (check (object-%layout a) => #f) (check (object-%layout b) => #f)
      (check-exception (replay-slot-reads! reads (lambda (_owner _key) (void)))
        (message? "stale slot dependency"))
      (check (.ref/inline a site) => #f)
      (set! denied? #t)
      (check (eq? (with-catch identity (cut .ref/inline b site)) cause) => #t)
      (check (and (slot-cache-hit? site a (object-revision a) (object-layout a)) #t) => #t)
      (set! denied? #f)
      (check (.ref/inline b site) => #f)
      (check (.ref/inline a site) => #f)
      (check-equal? calls 5))
    (test-case "downstream entry retains lazy cold admission and every revision retry across access policies"
      (for (width '(0 1 4))
        (let (expected (vector (+ (* 3 width) (* 3 (/ (* width (1- width)) 2)))
                              (+ (* 3 width) (* 4 (/ (* width (1- width)) 2)))
                              (+ (* 3 width) (* 5 (/ (* width (1- width)) 2)))
                              (* 3 width)))
          (check-equal? (service.service-workflow width) expected)
          (check-equal? (service.service-workflow width layout: #t) expected)
          (check-equal? (service.service-workflow width layout: #t reshape?: #t) expected)))
      (check-exception (service.service-workflow -1) contract-violation-error?)
      (check-exception (service.main "4" "invented") contract-violation-error?))
    (test-case "cold pinned hooks do not initialize unrelated metadata or bind a layout"
      (def denied? #f) (def calls 0) (def cause (list 'preparation-refused))
      (def source (.o
        (compute-precedence-list (lambda (_ next)
          (set! calls (1+ calls)) (when denied? (raise cause)) (next)))
        (compute-slot (lambda (_ next name) (next)))
        (payload 7)))
      (def root (bootstrap-protocol source))
      (def expected (.ref root 'compute-slot))
      (def site (make-slot-cache 'compute-slot))
      (def payload-site (make-slot-cache 'payload))
      (uninstantiate-object! root) (set! denied? #t)
      (let (before calls)
        (check (eq? (.ref/inline root site) expected) => #t)
        (check-equal? calls before)
        (def consumed 0)
        (def inspect (service.checked-kernel-action (lambda (owner hook)
          (set! consumed (1+ consumed)) (check (eq? owner root) => #t) hook)))
        (check (eq? (inspect root) expected) => #t)
        (check-equal? consumed 1) (check-equal? calls before)
        (check (object-%instance root) => #f) (check (object-%layout root) => #f)
        (check (slot-cache-hit? site root (object-revision root) #f) => #f)
        ;; A non-anchor still prepares, preserves the exact cause and can retry.
        (check (eq? (with-catch identity (cut .ref/inline root payload-site)) cause) => #t)
        (check (object-%layout root) => #f)
        (set! denied? #f)
        (check-equal? (.ref/inline root payload-site) 7)
        (check (eq? (.ref/inline root site) expected) => #t)
        (let (retired (object-%layout root))
          ;; A source revision clears prepared state even for a sealed bootstrap root.
          (.putslot! source 'payload ($constant-slot-spec 9))
          (check (object-%layout root) => #f)
          (check (eq? (.ref/inline root site) expected) => #t)
          (check (object-%layout root) => #f)
          (check-equal? (.ref/inline root payload-site) 9)
          (check (eq? retired (object-%layout root)) => #f)
          (check-equal? (active-object-constructions) []))))
    (test-case "shared shape reuses only offsets while false and Function cells stay receiver-local"
      (def signature (Fun Integer <- Integer))
      (def f (validate signature (lambda (n) (+ n 1))))
      (def g (validate signature (lambda (n) (+ n 2))))
      (def a (.o value: f)) (def b (.o value: g)) (def off (.o value: #f))
      (def site (make-slot-cache 'value))
      (check (eq? (.ref/inline a site) f) => #t)
      (check-equal? (slot-cache-index site (object-layout b)) 0)
      (check (slot-cache-hit? site b (object-revision b) (object-layout b)) => #f)
      (check (eq? (.ref/inline b site) g) => #t)
      (check (.ref/inline off site) => #f)
      (check (eq? (.ref/inline a site) f) => #t)
      (check-exception ((.ref/inline b site) #f) TypeError?)
      (def foreign (.o other: 9))
      (check (slot-cache-index site (object-layout foreign)) => #f)
      (check-exception (.ref/inline foreign site) NoApplicableMethod?)
      (check (slot-cache-hit? site b (object-revision b) (object-layout b)) => 0))
    (test-case "shape preparation never forces lazy bodies and switched reads evaluate each owner once"
      (def calls 0) (def unused 0)
      (def recipe (.o self: self seed: 1
        (value (begin (set! calls (+ calls 1)) (.get self seed)))
        (unused-body (begin (set! unused (+ unused 1)) (error "unused lazy body")))))
      (def a (.cc recipe seed: 10)) (def b (.cc recipe seed: 20))
      (def site (make-slot-cache 'value))
      (object-layout a) (object-layout b)
      (check-equal? calls 0)
      (check-equal? (.ref/inline a site) 10)
      (check-equal? (.ref/inline b site) 20)
      (for-each (lambda (owner) (.ref/inline owner site)) (list a b a b))
      (check-equal? calls 2) (check-equal? unused 0)
      (.set! b seed 30)
      (check-equal? (.ref/inline b site) 30)
      (check-equal? calls 3) (check-equal? (.ref/inline a site) 10))
    (test-case "failed lazy switches retain the previous successful guard and retry does not cache refusal"
      (def cause (list 'lazy-refused)) (def denied? #f)
      (def recipe (.o self: self seed: 1
        (value (begin (when denied? (raise cause)) (.get self seed)))))
      (def a (.cc recipe seed: 10)) (def b (.cc recipe seed: 20))
      (def site (make-slot-cache 'value))
      (check-equal? (.ref/inline a site) 10)
      (set! denied? #t)
      (check (eq? (with-catch identity (lambda () (.ref/inline b site))) cause) => #t)
      (check (and (slot-cache-hit? site a (object-revision a) (object-layout a)) #t) => #t)
      (set! denied? #f)
      (check-equal? (.ref/inline b site) 20)
      (.set! b seed #f)
      (check (.ref/inline b site) => #f))
    (test-case "tracked switched vector reads preserve receiver dependencies and reject retired generations"
      (def root (.o amount: 3))
