      (def b (.cc a offset: 2)) (def site (make-slot-cache 'value))
      (check-equal? (.ref/inline b site) 5)
      (check-equal? (.ref/inline a site) 4)
      (defvalues (observed reads) (%call-with-recorded-slot-reads (cut .ref/inline b site)))
      (check-equal? observed 5)
      (check (and (find (lambda (read) (and (eq? (slot-read-receiver read) b)
        (eq? (slot-read-key read) 'value))) reads) #t) => #t)
      (replay-slot-reads! reads (lambda (_owner _key) (void)))
      (.putslot! root 'amount ($constant-slot-spec 7))
      (check-exception (replay-slot-reads! reads (lambda (_owner _key) (void)))
        (message? "stale slot dependency"))
      (check-equal? (.ref/inline b site) 9)
      (check-equal? (.ref/inline a site) 8))
    (test-case "observed access reuses ordinary evaluation without preparing a vector layout"
      (def source (.o value: 11 (unused (error "unrelated slot forced"))))
      (def site (make-slot-cache 'value))
      (check (object-%layout source) => #f)
      (defvalues (value reads) (%call-with-recorded-slot-reads (cut .ref/inline source site)))
      (check-equal? value 11)
      (check (object-%layout source) => #f)
      (check (slot-cache-hit? site source (object-revision source) #f) => #f)
      (replay-slot-reads! reads (lambda (_owner _key) (void))))
    (test-case "standard cached module load keeps recipes lazy across a checked multi-service workflow"
      (def original service.Service)
      (load-module "clan/poo/examples/representation-service")
      (load-module "clan/poo/examples/representation-service")
      (check (eq? original service.Service) => #t)
      (def a (.cc service.Service capacity: 10)) (def b (.cc service.Service capacity: 20))
      (def missing (list 'not-evaluated))
      (check (eq? (.ref/cached a 'total (lambda () missing)) missing) => #t)
      (def action (service.checked-total-action (lambda (_owner amount) amount) eager?: #f))
      (check-equal? (action a) 33) (check-equal? (action b) 63)
      (.set! a capacity -1)
      (check-exception (action a) Error?)
      (.set! a capacity 11)
      (check-equal? (action a) 36) (check-equal? (action b) 63))
    (test-case "persistent replacement keeps repeated contributions and caller ownership"
      (let* ((input (list (cons 'a 1) (cons 'b #f) (cons 'a 2)))
             (old (prototype-map input)) (next (prototype-map-put old 'a 3)))
        (set-cdr! (car input) 99)
        (check-equal? (prototype-map-list old) '((a . 1) (b . #f) (a . 2)))
        (check-equal? (prototype-map-list next) '((a . 3) (b . #f) (a . 2)))
        (check-equal? (prototype-map-list (prototype-map-remove next 'a)) '((b . #f)))
        (let (view (prototype-map-list old)) (set-cdr! (car view) 50))
        (check-equal? (prototype-map-list old) '((a . 1) (b . #f) (a . 2)))))
    (test-case "explicit policies survive conversion and revisions without changing defaults"
      (def initial (prototype-map '((a . #f) (a . 2))))
      (def compact (prototype-map initial policy: 'compact))
      (check-equal? (prototype-map-policy initial) 'tree)
      (check-equal? (prototype-map-policy compact) 'compact)
      (check (eq? (prototype-map compact) compact) => #t)
      (for-each (lambda (source)
        (check-equal? (prototype-map-policy (prototype-map-put source 'b 3)) (prototype-map-policy source))
        (check-equal? (prototype-map-policy (prototype-map-remove source 'a)) (prototype-map-policy source)))
        (list initial compact))
      (check-equal? (prototype-map-list (prototype-map compact policy: 'tree)) (prototype-map-list initial))
      (check-exception (prototype-map [] policy: 'unknown) ContractViolation?))
    (test-case "promotion and demotion preserve complete ordered contribution snapshots"
      (def entries (map (lambda (index) (cons (string->symbol (string-append "k" (number->string index))) index)) (iota 8)))
      (def compact (prototype-map entries policy: 'compact))
      (def large (prototype-map-put compact 'extra #f))
      (def replaced (prototype-map-put large 'k0 99))
      (def small (prototype-map-remove replaced 'extra))
      (for-each (lambda (source) (check-equal? (prototype-map-policy source) 'compact))
        (list compact large replaced small))
      (check-equal? (prototype-map-list compact) entries)
      (check-equal? (prototype-map-list large) (append entries '((extra . #f))))
      (check-equal? (prototype-map-list small) (cons '(k0 . 99) (cdr entries)))
      (check (eq? (prototype-map-remove small 'absent) small) => #t)
      (check (eq? (prototype-map-remove large 'absent) large) => #t)
      ;; Eight repeated contributions remain eight cells, with one FIRST write.
      (def repeated (prototype-map (make-list 8 '(same . #f)) policy: 'compact))
      (def promoted (prototype-map-put repeated 'other 9))
      (check-equal? (prototype-map-list (prototype-map-put promoted 'same 7))
        (append (cons '(same . 7) (make-list 7 '(same . #f))) '((other . 9))))
      (check-equal? (prototype-map-list (prototype-map-remove promoted 'same)) '((other . 9)))
      (check-equal? (prototype-map-list repeated) (make-list 8 '(same . #f))))
    (test-case "mixed persistent revisions agree with an independent ordered list oracle"
      ;; A simple specification deliberately uses neither vectors nor tree indices.
      (def (put entries name value)
        (cond ((null? entries) (list (cons name value)))
              ((eq? name (caar entries)) (cons (cons name value) (cdr entries)))
              (else (cons (car entries) (put (cdr entries) name value)))))
      (let loop ((round 0) (source (prototype-map [] policy: 'compact)) (expected []) (history []))
        (when (< round 96)
          (let* ((name (string->symbol (number->string (modulo round 13))))
                 (delete? (= (modulo round 5) 4))
                 (next (if delete? (prototype-map-remove source name) (prototype-map-put source name round)))
                 (oracle (if delete? (filter (lambda (entry) (not (eq? (car entry) name))) expected)
                           (put expected name round))))
            (check-equal? (prototype-map-list next) oracle)
            (for-each (lambda (snapshot) (check-equal? (prototype-map-list (car snapshot)) (cdr snapshot))) history)
            (loop (1+ round) next oracle (cons (cons source expected) history))))))
    (test-case "service promotion and contraction keep FUN admission and live inherited reads"
      (def source (service.expanded-service 20))
      (def snapshot (object-%slots source))
      (def child (.cc source capacity: 30))
      (def effects 0)
      (def action (service.checked-total-action (lambda (_ amount) (set! effects (1+ effects)) amount)))
      (check-equal? (action source) 63)
      (check-equal? (action child) 93)
      (for-each (cut .removeslot! source <>) '(region approval audit enabled revision))
      (check-equal? (action source) 63)
      (check-equal? (action child) 93)
      (.putslot! source 'tariff ($constant-slot-spec 4))
      ;; The child's explicit tariff still overrides the revised parent.
      (check-equal? (action source) 83)
      (check-equal? (action child) 93)
      (check-equal? (length (prototype-map-list snapshot)) 10)
      (.putslot! source 'capacity ($constant-slot-spec -1))
      (check-exception (action source) error?)
      (check-equal? effects 6)
      (.putslot! source 'capacity ($constant-slot-spec 10))
      (check-equal? (action source) 43))
    (test-case "compact defaults preserve false fallback and guarded retry across expansion"
      (let* ((source (make-object defaults: (prototype-map '((x . #f)) policy: 'compact)))
             (site (make-slot-cache 'x)))
        (check (.ref/inline source site) => #f)
        (for-each (lambda (index)
          (.putdefault! source (string->symbol (number->string index)) index)) (iota 8))
        (check-equal? (prototype-map-policy (object-%defaults source)) 'compact)
        (check-equal? (length (object-defaults source)) 9)
        (.putdefault! source 'x 7)
        (check-equal? (.ref/inline source site) 7)
        (for-each (lambda (index) (.removedefault! source (string->symbol (number->string index)))) (iota 8))
        (check-equal? (object-defaults source) '((x . 7)))
        (.removedefault! source 'x)
        (check-exception (.ref/inline source site) NoApplicableMethod?)
        (.putdefault! source 'x #f)
        (check (.ref/inline source site) => #f)
        (check-equal? (prototype-map-policy (object-%defaults source)) 'compact)))
    (test-case "uninterned identities do not collapse to printed names"
      (let* ((a (string->uninterned-symbol "same")) (b (string->uninterned-symbol "same"))
             (source (prototype-map (append (list (cons a 1) (cons b 2)) (make-list 7 '(padding . 0))) policy: 'compact))
             (next (prototype-map-put source a 3))
             (small (prototype-map-remove next 'padding)))
        (check (eq? a b) => #f)
        (check-equal? (map cdr (prototype-map-list small)) '(3 2))
        (check-equal? (map cdr (prototype-map-list (prototype-map-remove small a))) '(2))
        (let (view (prototype-map-list next)) (set-cdr! (car view) 999))
        (check-equal? (map cdr (prototype-map-list (prototype-map-remove next 'padding))) '(3 2))))
    (test-case "live equal shapes share mapping but never receiver values"
      (let ((a (.o x: 1 disabled: #f)) (b (.o disabled: #f x: 2)) (site (make-slot-cache 'x)))
        (check-equal? (.ref/inline a site) 1)
        (check (and (slot-cache-hit? site a (object-revision a) (object-layout a)) #t) => #t)
        (check (slot-cache-hit? site b (object-revision b) (object-layout b)) => #f)
        (check-equal? (.ref/inline b site) 2)
        (check (eq? (slot-layout-shape (object-layout a)) (slot-layout-shape (object-layout b))) => #t)
        (check-equal? (.ref/inline a site) 1)
        (check (.ref/inline a (make-slot-cache 'disabled)) => #f)))
    (test-case "shared-parent diamond invalidates vector and ordinary computed caches once"
      (let* ((root (.o x: 2)) (left (.o inherit: [root] left: 1))
             (right (.o inherit: [root] right: 2))
             (child (.o self: self inherit: [left right] (sum (+ (.get self x) (.get self left) (.get self right)))))
             (site (make-slot-cache 'sum)) (before (object-revision child)))
        (check-equal? (.ref/inline child site) 5)
        (.putslot! root 'x ($constant-slot-spec 7))
        (check-equal? (object-revision child) (+ before 1))
        (check (slot-cache-hit? site child (object-revision child) (object-layout child)) => #f)
        (check-equal? (.ref/inline child site) 10)
        (check-equal? (.get child sum) 10)
        (.putslot! root 'x ($constant-slot-spec 2))
        (check-equal? (.ref/inline child site) 5)))
    (test-case "slot removal, defaults and topology replacement change effective layout"
      (let* ((parent (.o x: 4)) (child (.o inherit: [parent] x: 8)) (site (make-slot-cache 'x)))
        (check-equal? (.ref/inline child site) 8)
        (.removeslot! child 'x)
        (check-equal? (.ref/inline child site) 4)
        (.removeslot! parent 'x)
        (check-exception (.ref/inline child site) NoApplicableMethod?)
        (.putdefault! parent 'x #f)
        (check (.ref/inline child site) => #f)
        (.removedefault! parent 'x)
        (check-exception (.ref/inline child site) NoApplicableMethod?)
        (replace-object-supers! child [(.o x: 11 y: 9)])
        (check-equal? (.ref/inline child site) 11)
        (check-equal? (.get child y) 9)))
    (test-case "rejected edits retain revision and warmed guards"
      (let* ((obj (.o x: 5)) (site (make-slot-cache 'x)) (before (object-revision obj)))
        (check-equal? (.ref/inline obj site) 5)
        (check-exception (object-slots-set! obj '(("bad" . 1))) (message? "symbolic specification required"))
        (check-equal? (object-revision obj) before)
        (check-exception (object-slots-set! obj (append (make-list 8 '(valid . 1)) '(("bad" . 1))))
          (message? "symbolic specification required"))
        (check-equal? (object-revision obj) before)
        (check-equal? (.ref/inline obj site) 5)
        (seal-object! obj)
        (check-exception (.putslot! obj 'x ($constant-slot-spec 9)) (message? "sealed prototype"))
        (check-equal? (object-revision obj) before)
        (check-equal? (.ref/inline obj site) 5)))
    (test-case "persistent clones rebind computed fields and keep checked FUN effects gated"
      (let* ((source (.cc service.Service capacity: 20)) (old (object-%slots source))
             (changed (.cc source capacity: 30)) (calls 0)
             (action (service.checked-total-action
               (lambda (_ amount) (set! calls (+ calls 1)) amount))))
        (check-equal? (action source) 63)
        (check-equal? (action changed) 93)
        (check-equal? (action source) 63)
        (check-equal? (prototype-map-list old) (object-slots source))
        (check-exception (action (.cc source capacity: -1)) error?)
        (check-equal? calls 3)))
    (test-case "cycle refusal leaves no successful value and permits a corrected retry"
      (let* ((obj (.o self: self (x (.get self x)))) (site (make-slot-cache 'x)))
        (check-exception (.ref/inline obj site) CyclicSlot?)
        (.putslot! obj 'x ($constant-slot-spec #f))
        (check (.ref/inline obj site) => #f)
        (.put! obj 'x 9)
        (check-equal? (.ref/inline obj site) 9)))))
