;;; Finite container inference composes actual runtime validators and declarations.


;; Typed refusal categories distinguish syntax, kind, quota and rejected bounds.
(def (refusal kind) (lambda (cause) (and (type-refusal? cause) (eq? (type-refusal-kind cause) kind))))
;; This exact observed signature fixes both residual variables through positive
;; count/output positions and contravariant callback inputs, after Key is bound.
(def routes-type '(Map (Sum active: (Function (UInt) (Integer)) count: UInt) <- UInt))
;; Both input and expected result constrain one shared assignment, not two solves.
(def observations
  (list (list [] (list routes-type)
    (list `(Pair ,routes-type (Union (Function (UInt) (Integer)) Bool))))))
;; Function-bearing route values exercise the existing tagged-object carrier.
(def (routes)
  (hash (1 (.o tag: 'active value: abs)) (2 (.o tag: 'count value: 3))))
;; The protocol tests rules, normalization, failure and complete executable flow.
(def container-inference-test
  (test-suite "Pair Map Sum Union inference and declaration closure"
    (test-case "tagged objects share one finite readable row protocol"
      (def callback '(Function (UInt) (Integer)))
      (def source `(Sum primary: (Function ((UIntN 8)) (Integer)) backup: ,callback))
      (def view `(Object ((tag (Enum primary backup)) (value ,callback)) open))
      (def record `(Record ((value ,callback required) (tag Symbol required)) open))
      (check (subtype-expression? source view) => #t)
      (check (subtype-expression? source record) => #t)
      (check (subtype-expression? source `(Object ((value ,callback)) open)) => #t)
      (check (subtype-expression? source `(Record ((value ,callback optional)) open)) => #t)
      (check (subtype-expression? `(List ,source) `(List ,view)) => #t)
      (for-each (lambda (target) (check (subtype-expression? source target) => #f))
        (list `(Object ((tag (Enum primary backup)) (value ,callback)) closed)
          `(Object ((tag (Exactly primary)) (value ,callback)) open)
          `(Record ((value ,callback required) (audit UInt optional)) open)
          `(Object ((tag Keyword)) open) `(Object ((value (Function (UInt) (Bool)))) open)))
      (check (subtype-expression? `(Sum primary: ,callback backup: Bool) view) => #f)
      (check (subtype-expression? `(Sum primary: ,callback rogue: ,callback) view) => #f)
      (check (subtype-expression? `(Sum primary: ,callback backup: ,callback)
        `(Sum backup: ,callback primary: ,callback)) => #f)
      (check (subtype-expression? view source) => #f)
      (check (subtype-expression? `(Map UInt <- ,source) `(Map UInt <- ,view)) => #f)
      (check (subtype-expression? '(Sum) view) => #t)
      (check-exception (validate (expression-type '(Sum)) (.o tag: 'primary value: abs)) TypeError?)
      (check-exception (subtype-expression? '(Sum primary: UInt backup: (Unknown)) view) (refusal 'unsupported))
      (check-exception (subtype-expression? source view 1) (refusal 'exhausted)))
    (test-case "impossible Sum payloads discharge only readable branch obligations"
      (def callback '(Function (UInt) (Integer)))
      (def view `(Object ((tag (Exactly primary)) (value ,callback)) open))
      (for-each (lambda (payload)
        (def source `(Sum retired: ,payload primary: ,callback))
        (check (subtype-expression? source view) => #t)
        (check (subtype-expression? source `(Record ((tag (Exactly primary) required)
          (value ,callback required)) open)) => #t)
        (check (subtype-expression? source `(Object ((value ,callback)) closed)) => #f)
        (check (subtype-expression? source `(Sum primary: ,callback)) => #f)
        (check-exception (validate (expression-type source) (.o tag: 'retired value: abs)) TypeError?))
        '(Never (Enum) (Pair Never (Function (UInt) (Integer)))
          (Object ((missing (TypeValuePair))) open)))
      ;; Empty collections and optional sentinels are inhabited, so their tag
      ;; cannot disappear from a consumer's actual readable interface.
      (for-each (lambda (payload)
        (check (subtype-expression? `(Sum retired: ,payload primary: ,callback) view) => #f))
        '(Bool (List Never) (Tuple) (Map Never <- UInt) (Maybe Never) (OrFalse Never)))
      (check-exception (subtype-expression? '(Sum retired: Never active: (Unknown)) view)
        (refusal 'unsupported))
      (check-exception (subtype-expression? `(Sum retired: Never primary: ,callback) view 1)
        (refusal 'exhausted)))
    (test-case "tagged worker rows compose inference declarations wrappers refinement and evidence"
      (def callback '(Function (UInt) (Integer)))
      (def variants `(Sum primary: (Function ((UIntN 8)) (Integer))
        retired: (Pair Never ,callback) backup: ,callback))
      (def selected `(Pair (Map (List ,variants) <- UInt) ,callback))
      (def wrong `(Pair (Map (List (Sum primary: ,callback rogue: ,callback)) <- UInt) ,callback))
      (def events []) (def consumed 0) (def observed #f)
      (def report (service.infer-tagged-worker-service (list wrong selected)
        (lambda (packet) (values packet identity))
        (lambda (event) (set! events (cons event events)))))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) (list (list selected)))
      (def source (.o tag: 'primary value: abs audit: 'retained))
      (def backup (.o tag: 'backup value: abs))
      (def raw (cons (hash (1 (list source backup))) abs))
      (def context (.o approved: #t))
      (def action (service.descriptor-service-action (.get report instance) raw context
        (lambda (subject)
          (set! observed subject) (set! consumed (1+ consumed))
          (def answer (.get subject answer))
          (def workers (hash-ref (car answer) 1))
          (check-equal? (.get (car workers) tag) 'primary)
          (check-equal? (.get (car workers) audit) 'retained)
          (check-equal? ((.get (car workers) value) -8) 8)
          (check-exception ((.get (car workers) value) -300) TypeError?)
          (check-equal? ((.get (cadr workers) value) -300) 300)
          (check-exception ((.get (cadr workers) value) #f) TypeError?)
          (def again ((.get subject callback) raw))
          (check-exception ((.get (car (hash-ref (car again) 1)) value) -300) TypeError?))))
      (defvalues (evidence next failed) (action context))
      (check-equal? failed #f) (check-equal? consumed 1)
      (check (eq? next context) => #t)
      (check (eq? (.get evidence subject) observed) => #t)
      (check (eq? (.get source value) abs) => #t)
      (check-equal? (reverse events) '(around before after))
      (check-exception ((service.descriptor-service-action (.get report instance) raw context
        (lambda (_) (set! consumed 99)) #f) context) TypeError?)
      (check-equal? consumed 1)
      (defvalues (_evidence _next retry) (action context))
      (check-equal? retry #f) (check-equal? consumed 2)
      (for-each (lambda (worker)
        (check-exception (validate (expression-type selected) (cons (hash (1 (list worker))) abs)) TypeError?))
        (list (.o tag: 'rogue value: abs) (.o tag: 'primary value: #f)
          (.o tag: 'retired value: (cons 0 abs))))
      (check-equal? (.get (service.infer-tagged-worker-service (list wrong)
        (lambda (packet) (values packet identity))) status) 'no-solution)
      (def reordered `(Pair (Map (List (Sum backup: ,callback retired: (Pair Never ,callback)
        primary: (Function ((UIntN 8)) (Integer)))) <- UInt) ,callback))
      (check-equal? (.get (service.infer-tagged-worker-service (list selected reordered)
        (lambda (packet) (values packet identity))) status) 'ambiguous)
      (check-equal? (.get (service.infer-tagged-worker-service (list selected)
        (lambda (packet) (values packet identity))) status) 'unique))
    (test-case "necessarily empty Maps share a carrier without widening live keys"
      (for-each (lambda (source)
        (check (subtype-expression? source '(Map (Function (UInt) (Integer)) <- UInt)) => #t)
        (check (subtype-expression? `(Pair UInt ,source)
          '(Pair Integer (Map (Function (UInt) (Integer)) <- UInt))) => #t)
        (check (subtype-expression? source 'String) => #f)
        (check (subtype-expression? `(List ,source) 'Null) => #f)
        (check (eq? (validate (expression-type source) (make-hash-table-eq)) #f) => #f)
        (check-exception (validate (expression-type source) (hash (1 abs))) TypeError?))
        '((Map Bool <- (Enum)) (Map (TypeValuePair) <- Symbol)
          (Map UInt <- (Pair UInt Never)) (Map (Tuple Never) <- Keyword)))
      (for-each (lambda (source)
        (check (subtype-expression? source '(Map Integer <- UInt)) => #f))
        '((Map UInt <- Integer) (Map (List Never) <- Symbol)
          (Map (Maybe Never) <- Symbol) (Map (OrFalse Never) <- Symbol)
          (Map (Map UInt <- Never) <- Symbol)))
      (check (subtype-expression? '(Union (Map UInt <- Never)) '(Union (Map Bool <- UInt))) => #f)
      (check-exception (subtype-expression? '(Map Never <- Unknown) '(Map UInt <- UInt)) (refusal 'unsupported))
      (check-exception (subtype-expression? '(Map Never <- Symbol) '(Map UInt <- UInt) 1) (refusal 'exhausted)))
    (test-case "empty Map validation preserves hash policy and bypasses callbacks"
      (def calls 0)
      (def opaque (.cc Type. sexp: 'opaque
        .element?: (lambda (_) (set! calls (1+ calls)) #f)
        .validate: (lambda (_) (set! calls (1+ calls)) (error "opaque payload ran"))))
      (def empty (make-hash-table-eq))
      (def descriptor (Map opaque <- opaque))
      (check (eq? (validate descriptor empty) empty) => #t)
      (check (element? descriptor empty) => #t)
      (check-equal? calls 0)
      (check-exception (validate descriptor []) TypeError?)
      (check-equal? calls 0)
      ;; Nonempty opaque directory semantics cannot become an emptiness witness.
      (def token (agetq 'Opaque (capture-type-catalog (.o Opaque: opaque) '(Opaque))))
      (check (subtype-expression? `(Map UInt <- (TypeValuePair ,token)) '(Map UInt <- UInt)) => #f)
      (check-equal? calls 0))
    (test-case "retired route inference retains callback wrappers and original empty layout"
      (def handler '(Function (UInt) (Integer)))
      (def selected `(Pair ,handler (Map (Function (Bool) (Bool)) <- (Enum))))
      (def wrong `(Pair ,handler (Map Bool <- Symbol)))
      (def events []) (def consumed 0) (def observed #f)
      (def report (service.infer-retired-route-service (list wrong selected)
        (lambda (packet) (values packet identity))
        (lambda (event) (set! events (cons event events)))))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) (list (list selected)))
      (def empty (make-hash-table-eq))
      (def raw (cons abs empty))
      (def context (.o approved: #t revision: 1))
      (def action (service.descriptor-service-action (.get report instance) raw context
        (lambda (subject)
          (set! observed subject) (set! consumed (1+ consumed))
          (check-equal? ((car (.get subject answer)) -8) 8)
          (check-exception ((car (.get subject answer)) #f) TypeError?)
          (check (eq? (cdr (.get subject answer)) empty) => #t)
          (def again ((.get subject callback) raw))
          (check-exception ((car again) #f) TypeError?))))
      (defvalues (evidence returned issue) (action context))
      (check-equal? issue #f) (check (eq? returned context) => #t)
      (check (eq? (.get evidence subject) observed) => #t)
      (check (eq? (car raw) abs) => #t)
      (check-equal? (reverse events) '(around before after))
      (check-exception ((service.descriptor-service-action (.get report instance) raw context void #f) context) TypeError?)
      (check-equal? consumed 1)
      (hash-put! empty 1 abs)
      (check-exception (action context) TypeError?)
      (check-equal? consumed 1)
      (hash-remove! empty 1)
      (defvalues (_ _context retried) (action context))
      (check-equal? retried #f) (check-equal? consumed 2)
      (check-equal? (.get (service.infer-retired-route-service (list wrong)
        (lambda (_) (error "rejected builder ran"))) status) 'no-solution)
      (check-equal? (.get (service.infer-retired-route-service
        (list selected `(Pair ,handler (Map (Enum) <- Symbol)))
        (lambda (_) (error "ambiguous builder ran"))) status) 'ambiguous))
    (test-case "Pair covariance is positional and observational"
      (check (subtype-expression? '(Pair UInt (Function (UInt) (Integer)))
                                  '(Pair Integer (Function (Integer) (UInt)))) => #t)
      (check (subtype-expression? '(Pair Integer UInt) '(Pair UInt Integer)) => #f))
    (test-case "Map values vary but normalized key syntax remains invariant"
      (check (subtype-expression? '(Map UInt <- UInt) '(Map UInt -> Integer)) => #t)
      (check (subtype-expression? '(Map UInt <- UInt) '(Map UInt <- Integer)) => #f)
      (check (subtype-expression? '(Map UInt <- (Function (UInt) (Integer)))
                                  '(Map Integer <- (Function (Integer) (UInt)))) => #f))
    (test-case "Sum retains exact ordered tag skeleton with covariant payloads"
      (check-equal? (.get (expression-type '(Sum active: UInt count: Integer)) sexp)
                    '(Sum active: UInt count: Integer))
      (check (subtype-expression? '(Sum active: UInt count: (Pair UInt Bool))
                                  '(Sum active: Integer count: (Pair Integer Bool))) => #t)
      (check (subtype-expression? '(Sum active: UInt count: UInt)
                                  '(Sum count: Integer active: Integer)) => #f)
      (check (subtype-expression? '(Sum active: UInt) '(Sum count: UInt)) => #f)
      (check (subtype-expression? '(Sum) '(Sum)) => #t))
    (test-case "Union preserves first-match order duplicates and normalization"
      (check (subtype-expression? '(Union UInt Integer) '(Union Integer UInt)) => #f)
      (check (subtype-expression? '(Union UInt) '(Union Integer)) => #f)
      (check (subtype-expression? '(Union UInt UInt) '(Union UInt)) => #f)
      (check (subtype-expression? '(Union (Map UInt <- UInt)) '(Union (Map UInt -> UInt))) => #t)
      (check-exception (validate (expression-type '(Union)) 1) TypeError?))
    (test-case "literal arrows and Sum labels survive partial specialization"
      (def schema (prototype-type (.o .parameters: '(Self Super)) '(Self Super)
        '(Pair (Map Self <- Super) (Sum Self: Super Super: Self)) []))
      (def partial (specialize-prototype-type schema '(UInt)))
      (check-equal? (.get partial expression) '(Pair (Map UInt <- Super) (Sum Self: Super Super: UInt)))
      (check-equal? (.get (instantiate-prototype partial '(Integer)) expression)
                    '(Pair (Map UInt <- Integer) (Sum Self: Integer Super: UInt))))
    (test-case "constructor names are reserved and malformed kinds refuse"
      (for-each (lambda (term) (check-exception (expression-type term) (refusal 'malformed)))
        '((Pair UInt) (Map UInt UInt) (Map UInt => Integer) (Sum active: UInt active: Integer)
          (Sum active:) (Sum active UInt)))
      (for-each (lambda (name)
        (check-exception (prototype-type (.o .parameters: (list name)) (list name) name [])
          (refusal 'malformed))) '(Pair Map Sum Union))
      (check-exception (expression-type '(Object () (Row (Map UInt <- UInt)))) (refusal 'bounds)))
    (test-case "recursive payloads close while invariant recursive keys refuse"
      (def descriptor (expression-type '(Mu X 1 (Map (Sum end: UInt next: X) <- UInt))))
      (check (element? descriptor (hash (1 (.o tag: 'end value: 2)))) => #t)
      (check-exception (validate descriptor (hash (1 (.o tag: 'next value: 2)))) TypeError?)
      (check-exception (expression-type '(Mu X 2 (Map UInt <- X))) (refusal 'unsupported))
      (check-exception (expression-type '(Mu X 2 (Map X -> UInt))) (refusal 'unsupported)))
    (test-case "candidate aliases normalize before uniqueness classification"
      (check-equal? (canonical-type '(Mu X 1 (Map UInt -> X)) (type-work 8192))
                    '(Mu X 1 (Map X <- UInt)))
      (def schema (prototype-type (.o .parameters: '(Self)) '(Self) 'Self []))
      (def report (infer-prototype schema '((Map UInt <- Integer) (Map Integer -> UInt)) []))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) '(((Map UInt <- Integer)))))
    (test-case "nested Union callback keeps committed first Function wrapper"
      (def checked (validate (expression-type '(Pair (Union (Function (Bool) (Bool))
                                                             (Function (Integer) (Integer))) UInt))
                            (cons values 1)))
      (check-equal? ((car checked) #t) #t)
      (check-exception ((car checked) 1) TypeError?))
    (test-case "Map Function keys and values retain independent wrappers"
      (def raw values) (def source (make-hash-table-eq))
      (hash-put! source raw raw)
      (def checked (validate (expression-type '(Map (Function (UInt) (UInt)) <- (Function (UInt) (UInt)))) source))
      (def key (car (hash-keys checked)))
      (check (eq? key raw) => #f)
      (check-exception (key -1) TypeError?)
      (check-exception ((hash-ref checked key) -1) TypeError?)
      (check (eq? (hash-ref source raw) raw) => #t))
    (test-case "shared inferred catalog executes full qualified declaration"
      (def audit [])
      (def report (service.infer-routing-service '(UInt) '(UInt Integer) observations
                    (lambda (event) (set! audit (cons event audit)))))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) '((UInt Integer)))
      (check-equal? audit [])
      (defvalues (answer owner) (service.route-service (.get report instance prototype) (routes)))
      (check-equal? audit '(routes))
      (check-equal? ((.get (hash-ref (car answer) 1) value) -4) 4)
      (check-exception ((.get (hash-ref (car answer) 1) value) #f) TypeError?)
      (check-exception ((cdr answer) #f) TypeError?)
      (check (begin (declared-snapshot owner) #t) => #t))
    (test-case "FUN refinement evidence binding and IO consume only wrapped roots"
      (def report (service.infer-routing-service '(UInt) '(UInt Integer) observations))
      (def instance (.get report instance)) (def context (.o approved: #t)) (def consumed 0)
      (def action (service.routing-service-action instance (routes) context
                    (lambda (answer)
                      (set! consumed (+ consumed 1))
                      (check-exception ((cdr answer) #f) TypeError?))))
      (defvalues (evidence next refused) (action context))
      (check-equal? refused #f)
      (check-equal? consumed 1)
      (check (eq? (.get evidence context) context) => #t)
      (check (begin (declared-snapshot (.get next owner)) #t) => #t)
      (def denied (service.routing-service-action instance (hash) context (lambda (_) (set! consumed 99))))
      (check-exception (denied context) TypeError?)
      (check-equal? consumed 1))
    (test-case "conflict and exhaustion never run declaration builder and retry succeeds"
      (def builds 0)
      ;; A failed inference cannot publish even a partially compiled generic.
      (def (builder instance) (set! builds (+ builds 1)) (service.routing-declarations instance void))
      (def schema (specialize-prototype-type service.RoutingServiceType '(UInt)))
      (def contradictory
        (append observations (list (list [] (list '(Map UInt <- Integer)) #f))))
      (check-equal? (.get (infer-declared-calls schema '(UInt Integer) contradictory builder) status) 'no-solution)
      (check-equal? builds 0)
      (check-exception (infer-declared-calls schema '(UInt Integer) observations builder 16) (refusal 'exhausted))
      (check-equal? builds 0)
      (check-equal? (.get (infer-declared-calls schema '(UInt Integer) observations builder) status) 'unique)
      (check-equal? builds 1))))

;; Return the original suites from this lexical scope.
(values container-inference-test)
