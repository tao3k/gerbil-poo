;;; Typed binary combination shares source traversals, deltas and style ownership.
(export table-merge-test)
(import :std/test :std/error :std/iter (only-in ../brace @@method)
        ../object ../mop ../type ../number ../table ../rationaldict ../support/option
        (only-in ../trie SimpleTrie) (only-in ./table-validation-test alist-table)
        (only-in ./table-wrapper-test box-table)
        (prefix-in ../examples/service-collection service.))

;; Keep protocol failures distinct from arbitrary resolver exceptions.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; Independent point observations check union-domain visitation and final roots.
(def table-merge-test
  (test-suite "checked binary table combination"
    (test-case "incremental heterogeneous merge retains Functions through all five publications"
      (def signature (Fun Integer <- Integer))
      (def f (validate signature (lambda (n) (+ n 1))))
      (def g (validate signature (lambda (n) (+ n 7))))
      (def left (SimpleTrie UInt signature))
      (def right (SimpleTrie UInt (Tuple Bool signature)))
      (def target (.cc left .diff: (lambda args (error "unexpected target scan"))))
      (def view (service.make-service-override-view left right target))
      (def l (.call left .<-list (list (cons 1 f) (cons 2 f))))
      (def r (.call right .<-list (list (cons 1 (vector #f g)))))
      (def state (.call view .ap (cons l r)))
      (def dl (.call left .diff l l))
      (def dr (.call right .delta/opt 1 (lambda (_) (some (vector #t g))) r))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles target) name)) (def effects 0)
        (def result ((service.publish-join-action view dl dr protocol
          (lambda (_) (set! effects (+ effects 1))))
          (object<-alist (list (cons 'state state) (cons 'target (.call protocol .ap (.call view .get state)))))))
        (def output (.call protocol .unap (.@ result target)))
        (check-equal? effects 1) (check-equal? (table-delta-count (.@ result delta)) 1)
        (check (eq? (.call target .ref output 1) g) => #t)
        (check (eq? (.call target .ref output 2) f) => #t)
        (def undo (.call target .apply-delta output (invert-table-delta (.@ result delta))))
        (check (eq? (.call target .ref undo 1) f) => #t)))
    (test-case "incremental merge matches full merge under mixed revisions and coalesces keys"
      (for (table (list (RationalDict Integer) (SimpleTrie UInt Integer)))
        (def calls [])
        ;; Ordinary snapshot merge is an independent whole-root reference.
        (def (choose key a b)
          (set! calls (cons key calls))
          (some (+ (if a (some-value a) 0) (if b (some-value b) 0))))
        (def view (table-combination table table table choose))
        (def state (.call view .ap (cons (.@ table .empty) (.@ table .empty))))
        (for (round (in-range 32))
          (def roots (.call view .unap state))
          (def key (modulo round 5))
          (def l (if (= (modulo round 4) 3) (.call table .remove (car roots) key)
            (.call table .acons key round (car roots))))
          (def r (.call table .acons key (- round) (cdr roots)))
          (def dl (.call table .diff (car roots) l)) (def dr (.call table .diff (cdr roots) r))
          (set! calls [])
          (defvalues (next delta) (.call view .apply-deltas state dl dr values))
          (check (<= (length calls) 1) => #t)
          (check-equal? (.call table .list<- (.call view .get next))
            (.call table .list<- (.call table .merge choose l r)))
          (def undo (.call view .apply-deltas next (invert-table-delta dl) (invert-table-delta dr)))
          (check-equal? (.call table .list<- (.call view .get undo)) (.call table .list<- (.call view .get state)))
          (set! state next))))
    (test-case "source conflicts precede resolution and target refusal preserves explicit retry"
      (def raw (SimpleTrie UInt Integer))
      (def target (.cc raw .element?: (lambda (root)
        (and (element? raw root) (.call raw .every (lambda (_ value) (>= value 0)) root)))))
      (def calls 0) (def effects 0) (def origin (.o epoch: 0))
      (def view (table-combination raw raw target (lambda (_ a b)
        (set! calls (+ calls 1)) (or b a)) (list origin)))
      (def l (.call raw .<-list '((1 . 3)))) (def r (.call raw .<-list '((1 . 4))))
      (def state (.call view .ap (cons l r)))
      (def dl (.call raw .diff l l))
      (def bad (.call raw .delta/opt 1 (lambda (_) (some -1)) r))
      (check-exception (.call view .apply-deltas state dl bad
        (lambda args (set! effects (+ effects 1)))) TypeError?)
      (check-equal? effects 0)
      (check-equal? (.call raw .list<- (.call view .get state)) '((1 . 4)))
      (def dr (.call raw .delta/opt 1 (lambda (_) (some 9)) r))
      (def next (.call view .apply-deltas state dl dr)) (set! calls 0)
      (check-exception (.call view .apply-deltas next dl bad) table-conflict?)
      (check-equal? calls 0)
      (check-equal? (.call raw .list<- (.call view .get next)) '((1 . 9)))
      (.set! origin epoch 1)
      (check-exception (.call view .get next) Error?))
    (test-case "deleting the last source skips resolver and malformed Options refuse without delivery"
      (def table (SimpleTrie UInt Bool)) (def calls 0) (def bad? #f) (def effects 0)
      (def view (table-combination table table table (lambda (_ a b)
        (set! calls (+ calls 1)) (if bad? 'invalid (or b a)))))
      (def l (.call table .<-list '((1 . #f)))) (def r (.@ table .empty))
      (def state (.call view .ap (cons l r)))
      (def dr (.call table .diff r r))
      (set! calls 0)
      (defvalues (removed delta) (.call view .apply-deltas state
        (.call table .diff l r) dr values))
      (check-equal? calls 0) (check-equal? (table-delta-count delta) 1)
      (check-equal? (.call table .list<- (.call view .get removed)) [])
      (set! bad? #t)
      (check-exception (.call view .apply-deltas state
        (.call table .delta/opt 1 (lambda (_) (some #t)) l) dr
        (lambda args (set! effects (+ effects 1)))) true)
      (check-equal? effects 0)
      (check-equal? (.call table .ref/opt (.call view .get state) 1) (some #f)))
    (test-case "composed merges deliver exact middle deltas to grouped aggregation"
      (def table (SimpleTrie UInt Integer))
      (def merge (table-combination table table table (lambda (_ a b) (or b a))))
      (def folding (table-group-fold table table Integer (lambda (key _) (modulo key 2)) (lambda (_ value) value)))
      (def view (table-projection-compose merge folding))
      (def l (.call table .<-list '((1 . 3) (2 . 4)))) (def r (.call table .<-list '((1 . 7))))
      (def state (.call view .ap (cons l r)))
      (def dl (.call table .delta/opt 3 (lambda (_) (some 5)) l))
      (def dr (.call table .delta/opt 1 (lambda (_) #f) r))
      (def next (.call view .apply-deltas state dl dr))
      (check-equal? (.call table .list<- (.call view .get next)) '((0 . 4) (1 . 8)))
      (check-equal? (.call table .list<- (.call view .get
        (.call view .apply-deltas next (invert-table-delta dl) (invert-table-delta dr))))
        '((0 . 4) (1 . 7))))
    (test-case "resolver exceptions retain cause and incompatible key Types refuse construction"
      (def table (SimpleTrie UInt Integer)) (def cause (list 'resolver-failure)) (def refuse? #f)
      (def view (table-combination table table table (lambda (_ a b)
        (if refuse? (raise cause) (or b a)))))
      (def l (.call table .<-list '((1 . 3)))) (def r (.@ table .empty))
      (def state (.call view .ap (cons l r)))
      (set! refuse? #t)
      (check-exception (.call view .apply-deltas state
        (.call table .delta/opt 1 (lambda (_) (some 4)) l) (.call table .diff r r))
        (lambda (actual) (eq? actual cause)))
      (set! refuse? #f)
      (def next (.call view .apply-deltas state
        (.call table .delta/opt 1 (lambda (_) (some 4)) l) (.call table .diff r r)))
      (check-equal? (.call table .ref (.call view .get next) 1) 4)
      (check-exception (table-combination table (RationalDict Integer) table
        (lambda (_ a b) (or b a))) (message? "incompatible table combination keys")))
    (test-case "all finite keep decisions agree across generic and Trie traversals"
      (for* ((table (list (RationalDict Integer) (SimpleTrie UInt Integer))) (mask (in-range 64)))
        (def left (.call table .<-list '((0 . 10) (2 . 20) (4 . 40))))
        (def right (.call table .<-list '((1 . 1) (2 . 2) (5 . 5)))) (def calls [])
        (def result (.call table .merge (lambda (key a b)
          (set! calls (cons key calls))
          (and (bit-set? key mask) (some (+ (if a (some-value a) 0) (if b (some-value b) 0))))) left right))
        (check-equal? (length calls) 5)
        (check-equal? (reverse calls) (if (.has? table .merge/key/opt) '(0 1 2 4 5) '(0 2 4 1 5)))
        (for (key (in-range 6))
          (def a (.call table .ref/opt left key)) (def b (.call table .ref/opt right key))
          (check-equal? (.call table .ref/opt result key)
            (and (or a b) (bit-set? key mask)
              (some (+ (if a (some-value a) 0) (if b (some-value b) 0))))))
        (check-equal? (.call table .list<- left) '((0 . 10) (2 . 20) (4 . 40)))
        (check-equal? (.call table .list<- right) '((1 . 1) (2 . 2) (5 . 5)))))
    (test-case "typed refusal malformed options and empty callbacks never leak roots"
      (for (table (list (RationalDict Integer) (SimpleTrie UInt Integer)))
        (def root (.call table .acons 1 10 (.@ table .empty)))
        (check-exception (.call table .merge (lambda args (some "bad")) root root) TypeError?)
        (check-exception (.call table .merge (lambda args 'invalid) root root)
          (message? "table update must return Option"))
        (check-exception (.call table .merge #f (.@ table .empty) (.@ table .empty)) ContractViolation?)
        (check-exception (.call table .union #f (.@ table .empty) (.@ table .empty)) ContractViolation?)
        (def calls 0)
        (def malformed (.call table .acons 2 "invalid child" (.@ table .empty)))
        (check-exception (.call table .merge (lambda args (set! calls (+ calls 1)) #f) root malformed) TypeError?)
        (check-equal? calls 0)))
    (test-case "union join and batches preserve presence and existing batch precedence"
      (for (table (list (RationalDict Bool) (SimpleTrie UInt Bool)))
        (def left (.call table .<-list '((1 . #f) (2 . #t))))
        (def right (.call table .<-list '((1 . #t) (3 . #f)))) (def overlap [])
        (def merged (.call table .union (lambda (key a b)
          (set! overlap (cons (list key a b) overlap)) #f) left right))
        (check-equal? overlap '((1 #f #t)))
        (check-equal? (.call table .list<- merged) '((2 . #t) (3 . #f)))
        (check-equal? (.call table .list<- (.call table .join left right)) '((1 . #f) (2 . #t) (3 . #f)))
        (check-equal? (.call table .list<- (.call table .join/list (list left right right)))
          '((1 . #t) (2 . #t) (3 . #f)))
        (check (.call table .empty? (.call table .join/list [])) => #t)))
    (test-case "five styles commit only the left and support ordinary receiver calls"
      (for (name '(Pure Mutable Linear Posh Classy))
        (def table (RationalDict Integer)) (def protocol (.ref (table-styles table) name))
        (def left-root (.call table .<-list '((1 . 10) (2 . 20))))
        (def right-root (.call table .<-list '((2 . 2) (3 . 3))))
        (def left (.call protocol .ap left-root)) (def right (.call protocol .ap right-root))
        (def choose (lambda (_ a b) (some (+ (if a (some-value a) 0) (if b (some-value b) 0)))))
        (def result (if (memq name '(Posh Classy)) (@@method left.merge choose right)
          (.call protocol .merge choose left right)))
        (check-equal? (.call protocol .list<- result) '((1 . 10) (2 . 22) (3 . 3)))
        (check (eq? right-root (.call protocol .unap right)) => #t)
        (case name
          ((Pure Posh) (check (eq? left-root (.call protocol .unap left)) => #t))
          ((Mutable Classy) (check (eq? left result) => #t))
          ((Linear) (check-exception (.call protocol .unap left) (message? "consumed table reference"))))
        (def united (if (memq name '(Posh Classy)) (@@method result.union (lambda (_ a b) (some (+ a b))) right)
          (.call protocol .union (lambda (_ a b) (some (+ a b))) result right)))
        (def joined (if (memq name '(Posh Classy)) (@@method united.join right)
          (.call protocol .join united right)))
        (def final (if (memq name '(Posh Classy)) (@@method joined.join/list (list joined right right))
          (.call protocol .join/list joined (list joined right right))))
        (check-equal? (.call protocol .list<- final) '((1 . 10) (2 . 2) (3 . 3)))
        (check (eq? right-root (.call protocol .unap right)) => #t)))
    (test-case "indexed swaps are installed once through ordinary and boxed carriers"
      (def source (RationalDict Integer))
      (def indexed (table-indexes source (list
        (.cc Type. name: 'unique table: (RationalDict (.@ source Key)) unique?: #t project: (lambda (_ v) v))
        (.cc Type. name: 'group table: (RationalDict source) unique?: #f project: (lambda (_ v) (modulo v 10))))))
      (def root (.call indexed .wrap (.call source .<-list '((1 . 10) (2 . 20)))))
      (defvalues (boxed _carrier _keys) (box-table indexed))
      (for* ((wrapped? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def table (if wrapped? boxed indexed))
        (def before (if wrapped? (.call boxed .wrap root) root))
        (def protocol (.ref (table-styles table) name))
        (def left (.call protocol .ap before)) (def right (.call protocol .ap (.@ table .empty)))
        (check-exception (.call protocol .merge (lambda args (some 30)) left right) table-index-conflict?)
        (check (eq? before (.call protocol .unap left)) => #t)
        (def first (if wrapped? -1 1))
        (def next (.call protocol .merge (lambda (key a b) (some (if (= key first) 20 10))) left right))
        (def after (.call protocol .unap next))
        (def raw (if wrapped? (.call boxed .unwrap after) after))
        (check-equal? (.call indexed .index-ref/opt raw 'unique 20) (some 1))
        (check-equal? (.call source .list<- (some-value (.call indexed .index-ref/opt raw 'group 0))) '((1 . 20) (2 . 10)))
        (check-equal? (.call protocol .list<- right) [])))
    (test-case "option shells cannot rewrite decisions or old-value expectations"
      (def table (RationalDict Integer))
      (def before (.call table .<-list '((1 . 10) (2 . 20) (3 . 30))))
      (def shell (some 0))
      (def after (.call table .merge (lambda (key a b)
        (def old (some-value a))
        (some-value-set! a 999)
        (some-value-set! shell (+ key old)) shell) before (.@ table .empty)))
      (some-value-set! shell -1)
      (check-equal? (.call table .list<- after) '((1 . 11) (2 . 22) (3 . 33)))
      (check-equal? (.call table .list<- before) '((1 . 10) (2 . 20) (3 . 30)))
      (def function (Fun Integer <- Integer)) (def callback (validate function (lambda (n) (+ n 1))))
      (def functions (alist-table function function))
      (def root (.call functions .acons callback callback (.@ functions .empty)))
      (def result (.call functions .merge (lambda (_ a b) (or a b)) root root))
      (check (eq? callback (.call functions .ref result callback)) => #t)
      (check-exception ((.call functions .ref result callback) "bad") TypeError?))
    (test-case "late failure reentrant winners foreign owners and stale origins are guarded"
      (def table (.cc (RationalDict Integer))) (def family (table-styles table))
      (def protocol (.@ family Mutable))
      (def before (.call table .<-list '((1 . 10) (2 . 20))))
      (def left (.call protocol .ap before)) (def right (.call protocol .ap before))
      (def cause (list 'late-refusal))
      (check (eq? (try (.call protocol .merge (lambda (key a b)
        (if (= key 2) (raise cause) a)) left right) #f (catch (e) e)) cause) => #t)
      (check (eq? before (.call protocol .unap left)) => #t)
      (def seen []) (def fired? #f)
      (check-exception (.call protocol .merge (lambda (key a b)
        (set! seen (cons key seen))
        (unless fired? (set! fired? #t) (.call protocol .acons 9 90 left)) a) left right)
        (message? "stale table reference"))
      (check-equal? (reverse seen) '(1 2))
      (check-equal? (.call protocol .ref left 9) 90)
      (check (eq? before (.call protocol .unap right)) => #t)
      (def calls 0)
      (def foreign (.call (.@ (table-styles table) Mutable) .ap before))
      (check-exception (.call protocol .merge (lambda args (set! calls (+ calls 1)) #f) left foreign)
        (message? "incompatible table reference"))
      (check-equal? calls 0)
      (check-exception (.call protocol .join/list left (list right foreign))
        (message? "incompatible table reference"))
      (check-equal? (.call protocol .ref left 9) 90)
      (check-exception (.call protocol .merge (lambda args (.set! table sexp 'forbidden) #f) left right) Error?)
      (.set! table sexp 'revised)
      (check-exception (.call protocol .join left right) (message? "stale table styles")))
    (test-case "refined roots are compared and batch-joined without a fabricated empty seed"
      (def base (RationalDict Integer))
      (def table (.cc base .element?: (lambda (root)
        (and (element? base root) (not (.call base .empty? root))))))
      (def a (.call table .<-list '((1 . 10)))) (def b (.call table .<-list '((2 . 20))))
      (check (.call table .=? a a) => #t)
      (check (.call table .=? a b) => #f)
      (check-equal? (.call table .list<- (.call table .join/list (list a b))) '((1 . 10) (2 . 20)))
      (check-exception (.call table .join/list []) TypeError?)
      (def protocol (.@ (table-styles table) Linear)) (def left (.call protocol .ap a))
      (def right (.call protocol .ap b))
      (check-exception (.call protocol .merge (lambda args #f) left right) TypeError?)
      (check (eq? a (.call protocol .unap left)) => #t)
      (check-equal? (.call protocol .list<- (.call protocol .join/list left (list right))) '((1 . 10) (2 . 20))))
    (test-case "FUN IO stages indexed Function services before publication and inverse recovery"
      (def function (Fun Integer <- Integer)) (def callback (validate function (lambda (n) (+ n 1))))
      (def source (RationalDict (Tuple Integer function)))
      (def table (table-indexes source (list (.cc Type. name: 'rank table: (RationalDict (.@ source Key))
        unique?: #t project: (lambda (_ row) (vector-ref row 0))))))
      (def left (.call table .<-list (list (cons 1 (vector 10 callback)))))
      (def right (.call table .<-list (list (cons 2 (vector 20 callback)))))
      (def refuse? #t) (def calls 0)
      (def action (service.merge-ledger-action table (lambda (_ a b)
        (when refuse? (error "approval pending")) (or a b)) (lambda (result)
          (set! calls (+ calls 1))
          (check (eq? callback (vector-ref (.call table .ref result 2) 1)) => #t)
          (check-equal? (.call table .index-ref/opt result 'rank 20) (some 2))
          (def delta (.call table .diff left result))
          (check-equal? (.call table .list<- (.call table .apply-delta result (invert-table-delta delta)))
            (.call table .list<- left))
          ((vector-ref (.call table .ref result 2) 1) 7))))
      (check-exception (action (cons left right)) (message? "approval pending"))
      (check-equal? calls 0) (set! refuse? #f)
      (check-equal? (action (cons left right)) 8) (check-equal? calls 1))))
