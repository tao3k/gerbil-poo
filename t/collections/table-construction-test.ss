;;; Complete checked bulk/singleton construction over existing backend strategies.
(export table-construction-test)
(import :std/test :std/error :std/iter
        :clan/poo/object :clan/poo/mop :clan/poo/type :clan/poo/number :clan/poo/table :clan/poo/rationaldict :clan/poo/support/option
        (only-in :clan/poo/trie SimpleTrie) (only-in :clan/poo/fun Wrapper.) (only-in :clan/poo/t/table-testing box-table alist-table borrowing-table)
        (only-in :clan/poo/support/base number-comparer)
        (prefix-in :clan/poo/examples/service-collection service.))

;; Observe the exact cause without accepting another failure family as equivalent.
(def (caught action) (with-catch identity action))

 ;; Exercise the existing derivations independently and in a nested chain.
;; Every indexed view uses its own declared cache, never an eager empty source.
(def (constructor-views source)
  (defvalues (boxed _carrier _keys) (box-table source))
  (def (indexed table)
    (table-indexes table (list (.cc Type. name: 'key unique?: #t
      table: (RationalDict (.@ table Key)) project: (lambda (key _) key)))))
  (def index (indexed source))
  (list source (table-order source (table-comparer (.@ source Key) number-comparer))
    index boxed (table-order (indexed boxed)
      (table-comparer (.@ boxed Key) number-comparer))))

;; Constructor contracts retain leaf identity, backend precedence and final admission.
(def table-construction-test
  (test-suite "checked complete collection construction"
    (test-case "nonempty cohort constructors build only complete grouped buckets in all five styles"
      (defvalues (indexed source _declarations) (service.make-cohort-services #t))
      (def callback (validate (Fun Integer <- Integer) (lambda (n) (+ n 1))))
      (def rows (list (cons 1 (vector 101 10 callback)) (cons 2 (vector 102 10 callback))
        (cons 3 (vector 103 20 callback)) (cons 4 (vector 104 20 callback))
        (cons 9 (vector 109 90 callback)) (cons 10 (vector 110 90 callback))))
      (check-exception (.@ source .empty) Error?)
      (for (style '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles indexed) style))
        (def owner (.call protocol .<-list rows))
        (def state (.call protocol .unap owner))
        (for (team '(10 20 90))
          (def bucket (option-ref (.call indexed .index-ref/opt state 'team team)))
          (check-equal? (.call source .count bucket) 2)
          (check-eq? (vector-ref (.call source .ref bucket (if (= team 10) 1 (if (= team 20) 3 9))) 2) callback))))
    (test-case "group migration split merge deletion inverse and failed retry retain final cohort laws"
      (defvalues (indexed source _declarations) (service.make-cohort-services #t))
      (def callback (validate (Fun Integer <- Integer) (lambda (n) (+ n 2))))
      (def primary (.call source .<-list (list
        (cons 1 (vector 101 10 callback)) (cons 2 (vector 102 10 callback))
        (cons 3 (vector 103 20 callback)) (cons 4 (vector 104 20 callback))
        (cons 9 (vector 109 90 callback)) (cons 10 (vector 110 90 callback)))))
      (def state (.call indexed .wrap primary))
      (def untouched (option-ref (.call indexed .index-ref/opt state 'team 90)))
      (def one (.call source .acons 1 (vector 101 20 callback) primary))
      (def both (.call source .acons 2 (vector 102 20 callback) one))
      (def bad (.call source .diff primary one)) (def delta (.call source .diff primary both))
      (for (style '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles indexed) style)) (def owner (.call protocol .ap state))
        (check-exception (.call protocol .apply-delta owner bad) TypeError?)
        (check-eq? (.call protocol .unap owner) state)
        (def merged (.call protocol .apply-delta owner delta))
        (def next (.call protocol .unap merged))
        (check-equal? (.call indexed .index-ref/opt next 'team 10) #f)
        (check-equal? (.call source .count (option-ref (.call indexed .index-ref/opt next 'team 20))) 4)
        (check-eq? (option-ref (.call indexed .index-ref/opt next 'team 90)) untouched)
        (def restored (.call protocol .apply-delta merged (invert-table-delta delta)))
        (check-equal? (.call indexed .list<- (.call protocol .unap restored)) (.call source .list<- primary))
        (check-eq? (vector-ref (.call protocol .ref restored 1) 2) callback))
      (def effects 0)
      (check-exception (service.apply-indexed-revision indexed state bad
        (lambda (_) (set! effects (+ effects 1)))) TypeError?)
      (check-equal? effects 0)
      (def published (service.apply-indexed-revision indexed state delta
        (lambda (result) (set! effects (+ effects 1)) result)))
      (check-equal? effects 1)
      (check-equal? (.call indexed .index-ref/opt published 'team 10) #f))
    (test-case "grouped buckets use finite constructors with their own carrier and preserve original refusal"
      (def raw (.cc (RationalDict Integer) Key: Integer)) (def refuse? #t) (def builds 0)
      (def cause (list 'original-bucket-constructor-refusal))
      (def source (.o (:: @ raw)
        (.empty (error "unexpected business empty"))
        .<-list/key: (lambda (rows)
          (set! builds (+ builds 1)) (when refuse? (raise cause))
          (.call raw .<-list/key rows))))
      (defvalues (boxed _carrier _keys) (box-table source
        key: (.cc Wrapper. Domain: Integer Codomain: Integer .ap: identity .unap: identity)))
      (for (table (list source boxed))
        (def indexed (table-indexes table (list (.cc Type. name: 'group unique?: #f
          table: (RationalDict table) project: (lambda (_ row) row)))))
        (def primary (if (eq? table source) (.call raw .<-list '((1 . 10) (2 . 20)))
          (.call table .wrap (.call raw .<-list '((1 . 10) (2 . 20))))))
        (set! refuse? #t)
        (check-eq? (caught (lambda () (.call indexed .wrap primary))) cause)
        (set! refuse? #f)
        (def state (.call indexed .wrap primary))
        (def retained (option-ref (.call indexed .index-ref/opt state 'group 20)))
        (check-equal? (.call table .ref retained 2) 20)
        (def delta (.call table .delta/opt 1 (lambda (_) (some 30)) primary))
        (set! refuse? #t)
        (check-eq? (caught (lambda () (.call indexed .apply-delta state delta))) cause)
        (check-eq? (option-ref (.call indexed .index-ref/opt state 'group 20)) retained)
        (set! refuse? #f)
        (def next (.call indexed .apply-delta state delta))
        (check-equal? (.call indexed .index-ref/opt next 'group 10) #f)
        (check-equal? (.call table .ref (option-ref (.call indexed .index-ref/opt next 'group 30)) 1) 30)
        (def undo (.call indexed .apply-delta next (invert-table-delta delta)))
        (check-equal? (.call table .ref (option-ref (.call indexed .index-ref/opt undo 'group 10)) 1) 10))
      (check-equal? (> builds 0) #t))
    (test-case "cold grouped projection cannot rewrite later borrowed source bindings"
      (def raw (.cc (RationalDict Integer) Key: Integer)) (def borrowed #f)
      (def source (.cc raw .list/key: (lambda (root)
        (set! borrowed (.call raw .list<- root)) borrowed)))
      (def index (table-indexes source (list (.cc Type. name: 'group unique?: #f
        table: (RationalDict source) project: (lambda (key row)
          (when (and borrowed (= key 1))
            (set-car! (cadr borrowed) 3) (set-cdr! (cadr borrowed) 99)) row)))))
      (def root (.call raw .<-list '((1 . 10) (2 . 20))))
      (def state (.call index .wrap root))
      (check-equal? (.call source .ref (option-ref (.call index .index-ref/opt state 'group 20)) 2) 20)
      (check-equal? (.call index .index-ref/opt state 'group 99) #f)
      (check-equal? (.call raw .list<- root) '((1 . 10) (2 . 20))))
    (test-case "scratch constructor lookup cannot replace a borrowed existing bucket Option"
      (def shell (some #f)) (def raw (.cc (RationalDict Integer) Key: Integer))
      (def unrelated (.call raw .singleton 9 90))
      (def source (.o (:: @ raw)
        (.<-list (begin (some-value-set! shell unrelated) (.@ raw .<-list)))))
      (def table (borrowing-table (RationalDict source) shell))
      (def indexed (table-indexes source (list (.cc Type. name: 'group unique?: #f
        table: table project: (lambda (_ row) 0)))))
      (def root (.call raw .<-list '((1 . 10) (2 . 20))))
      (def state (.call indexed .wrap root))
      (def delta (.call source .delta/opt 1 (lambda (_) (some 30)) root))
      (def next (.call indexed .apply-delta state delta))
      (def bucket (option-ref (.call indexed .index-ref/opt next 'group 0)))
      (check-equal? (.call raw .list<- bucket) '((1 . 30) (2 . 20)))
      (check-equal? (.call raw .list<- root) '((1 . 10) (2 . 20))))
    (test-case "finite multimembership buckets deduplicate backend-equivalent keys and admit only final groups"
      (def raw (.cc (RationalDict (Tuple (List Rational) Integer)) Key: Integer))
      (def source (.o (:: @ raw) (.empty (error "unexpected source empty"))
        .element?: (lambda (root) (and (element? raw root) (positive? (.call raw .count root))))))
      (def indexed (table-indexes source (list (.cc Type. name: 'groups unique?: #f multiple?: #t
        table: (RationalDict source) project: (lambda (_ row) (vector-ref row 0))))))
      (def primary (.call source .<-list '((1 . #((10 10.0 20) 7)) (2 . #((20) 8)) (3 . #(() 9)))))
      (def state (.call indexed .wrap primary))
      (check-equal? (.call source .count (option-ref (.call indexed .index-ref/opt state 'groups 10))) 1)
      (def after (.call source .acons 1 '#((30 30.0) 7) primary))
      (def delta (.call source .diff primary after))
      (def next (.call indexed .apply-delta state delta))
      (check-equal? (.call indexed .index-ref/opt next 'groups 10) #f)
      (check-equal? (.call source .count (option-ref (.call indexed .index-ref/opt next 'groups 20))) 1)
      (check-equal? (.call source .count (option-ref (.call indexed .index-ref/opt next 'groups 30))) 1)
      (check-equal? (.call indexed .list<- (.call indexed .apply-delta next (invert-table-delta delta)))
        (.call indexed .list<- state)))
    (test-case "derived singleton refusal cannot fall through to successful bulk"
      (def raw (RationalDict Unit)) (def cause (Error "single denied"))
      (def singles 0) (def batches 0)
      (def source (.cc raw
        .singleton/key: (lambda (_key _value) (set! singles (+ singles 1)) (raise cause))
        .<-list/key: (lambda (rows) (set! batches (+ batches 1)) (.call raw .<-list/key rows))))
      (for (view (constructor-views source))
        (check-eq? (caught (lambda () (.call view .singleton 1 (void)))) cause)
        (def set (.cc Set<-Table. Table: view))
        (check-eq? (caught (lambda () (.call set .singleton 1))) cause)
        (for (style '(Pure Mutable Linear Posh Classy))
          (def protocol (.ref (set-styles set) style))
          (check-eq? (caught (lambda () (.call protocol .singleton 1))) cause)))
      (check-equal? singles 35) (check-equal? batches 0))
    (test-case "singleton remains available when independent empty and bulk policies refuse"
      (def raw (RationalDict Unit))
      (def empty-cause (Error "empty denied")) (def bulk-cause (Error "bulk denied"))
      (def source (.o (:: @ raw)
        (.empty (raise empty-cause))
        .singleton/key: (lambda (key value) (.call raw .singleton key value))
        .<-list/key: (lambda (_) (raise bulk-cause))))
      (for (view (constructor-views source))
        (check-equal? (.call view .count (.call view .singleton 1 (void))) 1)
        (check-eq? (caught (lambda () (.call view .<-list (list (cons 1 (void)))))) bulk-cause)
        (check-eq? (caught (lambda () (.@ view .empty))) empty-cause)
        (def set (.cc Set<-Table. Table: view))
        (check-equal? (.call set .count (.call set .singleton 1)) 1)
        (check-eq? (caught (lambda () (.@ set .empty))) empty-cause)
        (for (style '(Pure Mutable Linear Posh Classy))
          (def protocol (.ref (set-styles set) style))
          (check-equal? (.call protocol .count (.call protocol .singleton 1)) 1)
          (check-eq? (caught (lambda () (.call protocol .<-list '(1)))) bulk-cause))))
    (test-case "singleton views preserve admission and Function leaves before FUN IO"
      (def signature (Fun Integer <- Integer))
      (def callback (validate signature (lambda (n) (+ n 1))))
      (def raw (RationalDict signature)) (def calls 0) (def effects 0)
      (def cause (Error "temporarily refused")) (def refuse? #t)
      (def source (.cc raw .singleton/key: (lambda (key value)
        (set! calls (+ calls 1))
        (if refuse? (raise cause) (.call raw .singleton key value)))))
      (for (view (constructor-views source))
        (def action (service.singleton-ledger-action view (lambda (root)
          (set! effects (+ effects 1)) root)))
        (set! refuse? #t)
        (check-eq? (caught (lambda () (action (cons 1 callback)))) cause)
        (let (previous calls)
          (check-exception (action (cons 'bad callback)) TypeError?)
          (check-equal? calls previous))
        (set! refuse? #f)
        (let (root (action (cons 1 callback)))
          (check-eq? (.call view .ref root 1) callback)
          (check-equal? ((.call view .ref root 1) 5) 6)))
      (check-equal? effects 5) (check-equal? calls 10))
    (test-case "metadata discovery cannot rewrite captured constructor rows or Pair fields"
      (def raw (RationalDict Integer))
      (def second (cons 2 20)) (def rows (list (cons 1 10) second))
      (def table (.o (:: @ raw) (Key (begin
        (set-cdr! second 90) (set-car! (cdr rows) (cons 9 99)) Rational))))
      (check-equal? (.call raw .list<- (.call table .<-list rows)) '((1 . 10) (2 . 20)))
      (check-equal? (cdr second) 90) (check-equal? (caadr rows) 9))
    (test-case "metadata repair cannot admit an invalid original constructor occurrence"
      (def raw (RationalDict Integer)) (def builds 0)
      (def invalid (cons 2 'bad)) (def rows (list (cons 1 10) invalid))
      (def table (.o (:: @ raw)
        (Key (begin (set-cdr! invalid 20) Rational))
        .<-list/key: (lambda (entries) (set! builds (+ builds 1)) (.call raw .<-list/key entries))))
      (check-exception (.call table .<-list rows) TypeError?)
      (check-equal? builds 0)
      (check-equal? (.call raw .list<- (.call table .<-list rows)) '((1 . 10) (2 . 20)))
      (check-equal? builds 1))
    (test-case "five Table factories capture rows before custom public delegates and retain Function leaves"
      (def signature (Fun Integer <- Integer))
      (def callback (validate signature (lambda (n) (+ n 1))))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def raw (RationalDict signature))
        (def second (cons 2 callback)) (def rows (list (cons 1 callback) second))
        (def table (.cc raw .<-list: (lambda (entries)
          (set-cdr! second 'bad) (set-car! (cdr rows) 'bad)
          (.call raw .<-list entries))))
        (def protocol (.ref (table-styles table) name))
        (def owner (.call protocol .<-list rows))
        (check-eq? (.call protocol .ref owner 2) callback)
        (check-equal? ((.call protocol .ref owner 1) 7) 8)
        (check-equal? (cdr second) 'bad)))
    (test-case "five Set factories capture outer requests without copying pair-valued elements"
      (def element (Pair Integer Integer))
      (def backing (alist-table element Unit))
      (def raw (.cc Set<-Table. Table: backing))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def first (cons 1 10)) (def second (cons 2 20)) (def rows (list first second))
        (def set (.cc raw .<-list: (lambda (elements)
          (set-car! (cdr rows) (cons 9 90)) (.call raw .<-list elements))))
        (def protocol (.ref (set-styles set) name))
        (def owner (.call protocol .<-list rows))
        (def elements (.call protocol .list<- owner))
        (check-eq? (car elements) first) (check-eq? (cadr elements) second)
        (check-equal? elements '((1 . 10) (2 . 20)))))
    (test-case "factory delegates cannot repair an original malformed binding before admission"
      (def raw (RationalDict Integer))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def second (cons 2 'bad)) (def rows (list (cons 1 10) second))
        (def table (.cc raw .<-list: (lambda (entries)
          (set-cdr! second 20) (.call raw .<-list entries))))
        (def protocol (.ref (table-styles table) name))
        (check-exception (.call protocol .<-list rows) TypeError?)
        (check-equal? (.call protocol .list<- (.call protocol .<-list rows)) '((1 . 10) (2 . 20)))))
    (test-case "captured indexed constructors compose FUN IO revision inverse and retry"
      (def signature (Fun Integer <- Integer))
      (def callback (validate signature (lambda (n) (+ n 1))))
      (def source (RationalDict (Tuple Integer signature)))
      (def indexed (table-indexes source (list (.cc Type. name: 'rank
        table: (RationalDict Rational) unique?: #t project: (lambda (_ row) (vector-ref row 0))))))
      (def second (cons 2 (vector 20 callback)))
      (def rows (list (cons 1 (vector 10 callback)) second))
      (def table (.o (:: @ indexed) (Key (begin (set-cdr! second (vector 10 callback)) Rational))))
      (def effects 0)
      (def action (service.construct-ledger-action table (lambda (root)
        (set! effects (+ effects 1)) root)))
      (def root (action rows))
      (check-equal? effects 1) (check-equal? (.call indexed .index-ref/opt root 'rank 20) (some 2))
      (check-exception (action rows) table-index-conflict?) (check-equal? effects 1)
      (set-cdr! second (vector 20 callback))
      (def retry (action rows)) (check-equal? effects 2)
      (check-eq? (vector-ref (.call indexed .ref retry 2) 1) callback)
      (def primary (.call source .<-list (list (cons 1 (vector 10 callback)) (cons 2 (vector 20 callback)))))
      (def swapped (.call source .<-list (list (cons 1 (vector 20 callback)) (cons 2 (vector 10 callback)))))
      (def delta (.call source .diff primary swapped))
      (def next (.call indexed .apply-delta retry delta))
      (def restored (.call indexed .apply-delta next (invert-table-delta delta)))
      (check-equal? (.call indexed .index-ref/opt restored 'rank 20) (some 2))
      (check-eq? (vector-ref (.call indexed .ref restored 2) 1) callback))
    (test-case "stale factories retain priority over malformed outer constructor requests"
      (for* ((set? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def key (.cc Rational)) (def table (.cc (RationalDict Integer) Key: key))
        (def descriptor (if set? (.cc Set<-Table. Table: (.cc table Value: Unit)) table))
        (def protocol (.ref ((if set? set-styles table-styles) descriptor) name))
        (.set! key sexp 'changed)
        (check-exception (.call protocol .<-list 'malformed)
          (lambda (cause) (and (Error? cause) (equal? (Error-message cause) "stale table styles"))))))
    (test-case "public list constructors validate every entry before backend construction"
      (for (base (list (RationalDict Integer) (SimpleTrie UInt Integer)))
        (def builds 0)
        (def table (.cc base .<-list/key: (lambda (rows)
          (set! builds (+ builds 1)) (.call base .<-list/key rows))))
        (for (rows (list 'bad '((1 . 10) bad) '((1 . 10) (2 . bad)) '((bad . 10))))
          (check-exception (.call table .<-list rows)
            (lambda (cause) (or (TypeError? cause) (ContractViolation? cause)))))
        (check-equal? builds 0)
        (let (root (.call table .<-list '((1 . 10) (2 . 20))))
          (check-equal? builds 1)
          (check-equal? (.call table .list<- root) '((1 . 10) (2 . 20))))))
    (test-case "backend duplicate precedence and invalid superseded values are retained"
      (def rational (RationalDict Integer)) (def trie (SimpleTrie UInt Integer))
      (for (table (list rational trie))
        (def rows '((1 . 10) (2 . 20) (1 . 30)))
        (check-equal? (.call table .list<- (.call table .<-list rows))
          (.call table .list<- (.call table .<-list/key rows)))
        (check-exception (.call table .<-list '((1 . bad) (1 . 30))) TypeError?))
      (check-equal? (.call rational .ref (.call rational .<-list '((1 . 10) (1 . 30))) 1) 30)
      (check-equal? (.call trie .ref (.call trie .<-list '((1 . 10) (1 . 30))) 1) 10))
    (test-case "caller spines and Pair shells are captured before child predicates"
      (def first (cons 1 10)) (def second (cons 2 20))
      (def rows (list first second))
      (def key (.cc UInt .element?: (lambda (value)
        (when (= value 1) (set-cdr! second 'bad) (set-car! (cdr rows) 'bad))
        (element? UInt value))))
      (def table (SimpleTrie key Integer))
      (def root (.call table .<-list rows))
      (check-equal? (.call table .list<- root) '((1 . 10) (2 . 20)))
      (check-equal? (cdr second) 'bad)
      (check-equal? (cadr rows) 'bad))
    (test-case "partial refinements admit only complete roots and keep Trie singleton strategy"
      (for (base (list (RationalDict Integer) (SimpleTrie UInt Integer)))
        (def paired (.cc base .element?: (lambda (root)
          (and (element? base root) (= (.call base .count root) 2)))))
        (check-equal? (.call paired .list<- (.call paired .<-list '((1 . 10) (2 . 20))))
          '((1 . 10) (2 . 20)))
        (check-exception (.call paired .<-list []) TypeError?)
        (check-exception (.call paired .singleton 1 10) TypeError?))
      (def base (SimpleTrie UInt Integer)) (def leaves 0)
      (def one (.cc base .<-list/key: (lambda _ (error "unexpected bulk fallback"))
        .singleton/key: (lambda (key value) (set! leaves (+ leaves 1)) (.call base .singleton/key key value))
        .element?: (lambda (root) (and (element? base root) (= (.call base .count root) 1)))))
      (check-exception (.call one .singleton -1 10) TypeError?)
      (check-equal? leaves 0)
      (check-equal? (.call one .ref (.call one .singleton 1 10) 1) 10)
      (check-equal? leaves 1))
    (test-case "ordered represented and indexed constructors share final-state admission"
      (def raw (RationalDict Integer))
      (def ordered (table-order raw (table-comparer (.@ raw Key) number-comparer)))
      (defvalues (boxed _carrier _keys) (box-table ordered))
      (def indexed (table-indexes ordered (list
        (.cc Type. name: 'value table: (RationalDict (.@ raw Key)) unique?: #t project: (lambda (_ row) row)))))
      (for (table (list ordered boxed indexed))
        (check-exception (.call table .<-list '((1 . bad))) TypeError?)
        (check-exception (.call table .singleton 1 'bad) TypeError?)
        (check-equal? (.call table .count (.call table .<-list '((1 . 10) (2 . 20)))) 2))
      (check-exception (.call indexed .<-list '((1 . 10) (2 . 10))) table-index-conflict?)
      (check-equal? (.call indexed .index-ref/opt (.call indexed .singleton 1 10) 'value 10) (some 1)))
    (test-case "fresh construction exposes all five Table and Set presentations"
      (for* ((set? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def descriptor (if set? RationalSet (RationalDict Integer)))
        (def protocol (.ref ((if set? set-styles table-styles) descriptor) name))
        (def one (if set? (.call protocol .singleton 1) (.call protocol .singleton 1 10)))
        (def many (.call protocol .<-list (if set? '(1 2 1) '((1 . 10) (2 . 20)))))
        (check-equal? (.call protocol .count one) 1)
        (check-equal? (.call protocol .count many) 2)
        (check-exception (.call protocol .<-list (if set? '(1 bad) '((1 . 10) (2 . bad)))) TypeError?)
        (check-equal? (.call protocol .count many) 2)
        (when (eq? name 'Linear)
          (.call protocol .step many identity)
          (check-exception (.call protocol .unap many) true))))
    (test-case "constructor failures retain their cause and suppress Reader FUN IO"
      (def signature (Fun Integer <- Integer))
      (def callback (validate signature (lambda (n) (+ n 1))))
      (def table (RationalDict (Tuple Integer signature)))
      (def effects 0)
      (def action (service.construct-ledger-action table (lambda (root)
        (set! effects (+ effects 1)) (vector-ref (.call table .ref root 1) 1))))
      (check-exception (action (list (cons 1 (vector 'bad callback)))) TypeError?)
      (check-equal? effects 0)
      (check (eq? (action (list (cons 1 (vector 10 callback)))) callback) => #t)
      (check-equal? effects 1)
      (check-exception ((action (list (cons 1 (vector 10 callback)))) "bad") TypeError?)
      (def cause (caught (lambda () (error "original builder cause"))))
      (def broken (.cc table .<-list/key: (lambda _ (raise cause))))
      (check (eq? (caught (lambda () (.call broken .<-list (list (cons 1 (vector 10 callback)))))) cause) => #t))))
