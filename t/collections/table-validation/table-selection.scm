;;; Checked selection and atomic multi-result ownership over existing backends.



;; Match ownership refusals without swallowing callback/type errors.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; One independent list oracle checks complete bindings and both partition sides.
(def table-selection-test
  (test-suite "checked selection and atomic partition"
    (test-case "predicate queries follow traversal for every nonmonotone finite mask"
      (for (base (list (RationalDict Integer) (SimpleTrie UInt Integer)))
        (defvalues (boxed _carrier _keys) (box-table base key:
          (.cc Wrapper. Domain: (.@ base Key) Codomain: (.@ base Key) .ap: identity .unap: identity)))
        (for* ((table (list base boxed)) (mask (in-range 16)))
          (def raw (.call base .<-list '((0 . 10) (1 . 11) (2 . 12) (3 . 13))))
          (def root (if (eq? table base) raw (.call table .wrap raw)))
          (def rows (.call table .list<- root))
          (def visits [])
          ;; Depend on both arguments: Trie may not substitute its key-only search.
          (def (chosen? k v) (and (= v (+ k 10))
            (not (zero? (bitwise-and mask (arithmetic-shift 1 k))))))
          (for (method '(.find-first/opt .find-last/opt .any .every))
            (def reverse? (eq? method '.find-last/opt))
            (def ordered (if reverse? (reverse rows) rows))
            (def wanted (not (eq? method '.every)))
            (def matching (filter (lambda (row) (eq? wanted (chosen? (car row) (cdr row)))) ordered))
            (def first (and (pair? matching) (car matching)))
            (set! visits [])
            (let (result ((.ref table method) (lambda (k v)
              (set! visits (cons k visits)) (chosen? k v)) root))
            (check-equal? result (case method
              ((.every) (not first)) ((.any) (and first #t)) (else (and first (some first)))))
            ;; No user predicate after the deciding binding, including reverse search.
            (def expected (let loop ((todo ordered))
              (if (null? todo) [] (cons (caar todo)
                (if (equal? (car todo) first) [] (loop (cdr todo)))))))
            (check-equal? (reverse visits) expected))))))
    (test-case "query admission and Boolean failures precede observable results"
      (def base (RationalDict Integer))
      (def root (.call base .<-list '((1 . 10) (2 . 20))))
      (def denied (.cc base .element?: (lambda (_) #f)))
      (def calls 0)
      (for (method '(.find-first/opt .find-last/opt .any .every))
        (check-exception ((.ref denied method) (lambda _ (set! calls (+ calls 1)) #t) root) TypeError?)
        (check-exception ((.ref base method) (lambda _ 'truthy) root) TypeError?)
        (check-exception ((.ref base method) 7 (.@ base .empty)) ContractViolation?))
      (check-equal? calls 0)
      (check-equal? (.call base .find-first/opt (lambda _ #t) (.@ base .empty)) #f)
      (check-equal? (.call base .every (lambda _ (error "must not run")) (.@ base .empty)) #t)
      (check-equal? (.call base .any (lambda _ (error "must not run")) (.@ base .empty)) #f)
      (check-exception (.call base .find-first (lambda _ #f) root) true)
      (check-exception (.call base .find-last (lambda _ #f) root) true)
      (def cause (with-catch identity (lambda () (error "original query cause"))))
      (check (eq? (with-catch identity (lambda ()
        (.call base .find-first/opt (lambda _ (raise cause)) root))) cause) => #t)
      (check-equal? (.call base .find-first (lambda (k _) (if (= k 1) #t (raise cause))) root) '(1 . 10))
      ;; Recognition is complete: an early match cannot hide an invalid tail.
      (check-exception (.call (alist-table Integer Integer) .any (lambda _ #t) '((1 . 10) (2 . "bad"))) TypeError?))
    (test-case "all styles and receivers observe without consuming table or Set owners"
      (for* ((set? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def descriptor (if set? RationalSet (RationalDict Integer)))
        (def protocol (.ref ((if set? set-styles table-styles) descriptor) name))
        (def root (.call descriptor .<-list (if set? '(1 2 3) '((1 . 10) (2 . 20) (3 . 30)))))
        (def owner (.call protocol .ap root))
        (def predicate (if set? odd? (lambda (k v) (and (odd? k) (= v (* k 10))))))
        (check-equal? (.call protocol .find-first predicate owner) (if set? 1 '(1 . 10)))
        (check-equal? (.call protocol .find-last predicate owner) (if set? 3 '(3 . 30)))
        (check-equal? (.call protocol .any predicate owner) #t)
        (check-equal? (.call protocol .every predicate owner) #f)
        (when (memq name '(Posh Classy))
          (check-equal? (@@method owner.find-first/opt predicate) (some (if set? 1 '(1 . 10))))
          (check-equal? (@@method owner.find-first predicate) (if set? 1 '(1 . 10)))
          (check-equal? (@@method owner.find-last/opt predicate) (some (if set? 3 '(3 . 30))))
          (check-equal? (@@method owner.find-last predicate) (if set? 3 '(3 . 30)))
          (check-equal? (@@method owner.any predicate) #t)
          (check-equal? (@@method owner.every predicate) #f))
        (check-exception (.call protocol .find-first (lambda _ 'bad) owner) TypeError?)
        (check (eq? root (.call protocol .unap owner)) => #t)
        (when (eq? name 'Linear)
          (.call protocol .step owner identity)
          (check-exception (.call protocol .any predicate owner) true))))
    (test-case "Set refinements and false elements retain exact observation semantics"
      (def descriptor (.cc Set<-Table. Table: (alist-table Bool Unit)))
      (def bools (.call descriptor .<-list '(#f #t)))
      (check-equal? (.call descriptor .find-first/opt not bools) (some #f))
      (check-equal? (.call descriptor .find-first not bools) #f)
      (check-equal? (.call descriptor .find-last/opt not bools) (some #f))
      (check-equal? (.call descriptor .any not bools) #t)
      (check-equal? (.call descriptor .every not bools) #f)
      (def denied (.cc RationalSet .element?: (lambda (_) #f)))
      (def root (.call RationalSet .<-list '(1 2)))
      (def calls 0)
      (check-exception (.call denied .any (lambda (_) (set! calls (+ calls 1)) #t) root) TypeError?)
      (check-equal? calls 0))
    (test-case "search snapshot survives reentrant publication and rejects stale policy writes"
      (def base (RationalDict Integer))
      (def root (.call base .<-list '((1 . 10) (2 . 20))))
      (def protocol (.@ (table-styles base) Mutable))
      (def owner (.call protocol .ap root))
      (def observed (.call protocol .find-first (lambda (k _)
        (.call protocol .acons 3 30 owner) (= k 1)) owner))
      (check-equal? observed '(1 . 10))
      (check-equal? (.call protocol .count owner) 3)
      (check-exception (.call base .any (lambda _ (.set! base sexp 'changed) #t) root) true)
      (check-equal? (.call base .find-first (lambda _ #t) root) '(1 . 10))
      (.set! base sexp 'revised)
      (check-exception (.call protocol .any (lambda _ #t) owner) true)
      (let (fresh (.@ (table-styles base) Mutable))
        (check-equal? (.call fresh .any (lambda _ #t) (.call fresh .ap root)) #t)))
    (test-case "checked Function lookup composes with Reader FUN IO and failure retry"
      (def function (.cc Function. inputs: [Integer] outputs: [Integer]))
      (def callback (validate function (lambda (n) (+ n 1))))
      (def descriptor (RationalDict (Tuple Integer function)))
      (def root (.call descriptor .<-list (list (cons 1 (vector 10 callback)) (cons 2 (vector 20 callback)))))
      (def calls 0)
      (def action (service.find-ledger-action descriptor (lambda (k row)
        (and (= k 2) (= (vector-ref row 0) 20)))
        (lambda (found) (set! calls (+ calls 1)) (vector-ref (cdr (some-value found)) 1))))
      (check (eq? (action root) callback) => #t)
      (check-equal? calls 1) (check-equal? ((action root) 4) 5)
      (check-exception ((action root) "bad") TypeError?)
      (def bad (service.find-ledger-action descriptor (lambda _ 'bad) (lambda (_) (set! calls (+ calls 1)))))
      (let (before calls)
        (check-exception (bad root) TypeError?) (check-equal? calls before))
      (check (eq? (action root) callback) => #t))
    (test-case "all finite decisions preserve exact selected bindings across backends"
      (for* ((table (list (RationalDict Integer) (SimpleTrie UInt Integer))) (mask (in-range 16)))
        (def input (.call table .<-list '((0 . 10) (1 . 11) (2 . 12) (3 . 13))))
        (def calls [])
        (def (selected? k v)
          (set! calls (cons k calls))
          (not (zero? (bitwise-and mask (arithmetic-shift 1 k)))))
        (defvalues (yes no) (.call table .partition selected? input))
        (check-equal? (length calls) 4)
        (check-equal? (reverse calls) (map car (.call table .list<- input)))
        (for (k (in-range 4))
          (def chosen? (not (zero? (bitwise-and mask (arithmetic-shift 1 k)))))
          (check (.call table .key? yes k) => chosen?)
          (check (.call table .key? no k) => (not chosen?))
          (check-equal? (.call table .ref (if chosen? yes no) k) (+ k 10)))
        (check-equal? (.call table .list<- (.call table .filter selected? input)) (.call table .list<- yes))))
    (test-case "declared structural selection obeys strict callback and root admission"
      (for (base (list (RationalDict Integer) (SimpleTrie UInt Integer)))
        (def root (.call base .<-list '((1 . 10) (2 . 20) (3 . 30))))
        (for (method '(.filter .partition))
          (check-exception ((.ref base method) #f (.@ base .empty)) ContractViolation?)
          (def calls [])
          (check-exception ((.ref base method) (lambda (k _)
            (set! calls (cons k calls)) (if (= k 2) 'truthy #t)) root) ContractViolation?)
          (check-equal? (reverse calls) '(1 2))
          (set! calls [])
          (def malformed (.call base .acons 4 "bad child" root))
          (check-exception ((.ref base method) (lambda (k _) (set! calls (cons k calls)) #t)
            malformed) TypeError?)
          (check-equal? calls []))
        (def restricted (.cc base .element?: (lambda (r)
          (and (element? base r) (not (equal? (.call base .list<- r) '((1 . 10) (3 . 30))))))))
        (check-exception (.call restricted .filter (lambda (k _) (odd? k)) root) TypeError?)
        (check-exception (.call restricted .partition (lambda (k _) (even? k)) root) TypeError?)))
    (test-case "generic selection stages removals without rebuilding or replaying predicates"
      (def base (RationalDict Integer)) (def writes 0)
      (def table (.cc base .acons: (lambda _ (error "unexpected insertion"))
        .remove: (lambda (root key) (set! writes (+ writes 1)) (.call base .remove root key))))
      (def root (.call base .<-list '((1 . 10) (2 . 20) (3 . 30) (4 . 40))))
      (check (eq? root (.call table .filter (lambda _ #t) root)) => #t)
      (check-equal? writes 0)
      (def calls 0)
      (defvalues (yes no) (.call table .partition (lambda (k _)
        (set! calls (+ calls 1)) (even? k)) root))
      (check-equal? writes 4) (check-equal? calls 4)
      (check-equal? (.call table .list<- yes) '((2 . 20) (4 . 40)))
      (check-equal? (.call table .list<- no) '((1 . 10) (3 . 30))))
    (test-case "atomic deletions preserve indexed refinements through Wrappers and every style"
      (def base (RationalDict Integer))
      ;; Every observable root has even cardinality. Odd intermediate deletions
      ;; must remain inside the persistent installer's final-state boundary.
      (def source (.cc base .element?: (lambda (r)
        (and (element? base r) (even? (.call base .count r))))))
      (def indexed (table-indexes source (list
        (.cc Type. name: 'unique table: (RationalDict (.@ source Key)) unique?: #t project: (lambda (_ v) v))
        (.cc Type. name: 'group table: (RationalDict source) unique?: #f project: (lambda (_ v) (modulo v 20))))))
      (def state (.call indexed .wrap (.call base .<-list '((1 . 10) (2 . 20) (3 . 30) (4 . 40)))))
      (check-exception (.call indexed .remove state 1) TypeError?)
      (check-equal? (.call indexed .count state) 4)
      (defvalues (boxed carrier keys) (box-table indexed))
      (for* ((wrapped? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def table (if wrapped? boxed indexed))
        (def initial (if wrapped? (.call boxed .wrap state) state))
        (def protocol (.ref (table-styles table) name))
        (def owner (.call protocol .ap initial)) (def calls [])
        (defvalues (yes no) (.call protocol .partition (lambda (k _)
          (set! calls (cons k calls)) (even? k)) owner))
        (check-equal? (length calls) 4)
        (check-equal? (.call protocol .count yes) 2)
        (check-equal? (.call protocol .count no) 2)
        (def selected (if wrapped? (.call boxed .unwrap (.call protocol .unap yes)) (.call protocol .unap yes)))
        (check-equal? (.call indexed .index-ref/opt selected 'unique 20) (some 2))
        (check-equal? (.call indexed .index-ref/opt selected 'unique 10) #f)
        (check-equal? (.call source .count (some-value (.call indexed .index-ref/opt selected 'group 0))) 2)))
    (test-case "late branch refusal keeps every structural owner live for a fresh selection"
      (def base (SimpleTrie UInt Integer))
      (def table (.cc base .element?: (lambda (r)
        (and (element? base r) (not (equal? (.call base .list<- r) '((1 . 10) (3 . 30))))))))
      (def root (.call base .<-list '((1 . 10) (2 . 20) (3 . 30))))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles table) name))
        (def owner (.call protocol .ap root))
        (check-exception (.call protocol .partition (lambda (k _) (even? k)) owner) TypeError?)
        (check (eq? root (.call protocol .unap owner)) => #t)
        (defvalues (yes no) (.call protocol .partition (lambda _ #t) owner))
        (check-equal? (.call protocol .list<- yes) (.call base .list<- root))
        (check-equal? (.call protocol .count no) 0)))
    (test-case "table and set partition cover five styles with one owner commit"
      (for* ((set? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def descriptor (if set? RationalSet (RationalDict Integer)))
        (def family ((if set? set-styles table-styles) descriptor))
        (def protocol (.ref family name))
        (def root (.call descriptor .<-list (if set? '(1 2 3 4) '((1 . 10) (2 . 20) (3 . 30) (4 . 40)))))
        (def owner (.call protocol .ap root))
        (def predicate (if set? even? (lambda (k _) (even? k))))
        (defvalues (yes no)
          (if (memq name '(Posh Classy)) (@@method owner.partition predicate)
            (.call protocol .partition predicate owner)))
        (check-equal? (.call protocol .list<- yes) (if set? '(2 4) '((2 . 20) (4 . 40))))
        (check-equal? (.call protocol .list<- no) (if set? '(1 3) '((1 . 10) (3 . 30))))
        (check-equal? (.call protocol .list<- (.call protocol .filter (if set? odd? (lambda (k _) (odd? k))) no))
          (if set? '(1 3) '((1 . 10) (3 . 30))))
        (case name
          ((Pure Posh) (check (eq? root (.call protocol .unap owner)) => #t))
          ((Mutable Classy) (check (eq? owner yes) => #t) (check (eq? yes no) => #f))
          ((Linear) (check-exception (.call protocol .unap owner) (message? "consumed table reference"))))))
    (test-case "late predicate refusal and non Boolean results preserve owners for retry"
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (set-styles RationalSet) name))
        (def root (.call RationalSet .<-list '(1 2 3)))
        (def owner (.call protocol .ap root))
        (def failure (list 'late))
        (check (eq? (try (.call protocol .partition (lambda (k) (if (= k 3) (raise failure) #t)) owner)
                      #f (catch (e) e)) failure) => #t)
        (check-exception (.call protocol .partition (lambda (_) 'truthy) owner) ContractViolation?)
        (check (eq? root (.call protocol .unap owner)) => #t)
        (defvalues (yes no) (.call protocol .partition even? owner))
        (check-equal? (.call protocol .list<- yes) '(2))
        (check-equal? (.call protocol .list<- no) '(1 3))))
    (test-case "second branch recognition fails before either owner is published"
      (def descriptor (.cc RationalSet
        .element?: (lambda (root) (and (element? RationalSet root)
          (not (equal? (.call RationalSet .list<- root) '(1 3)))))))
      (for (name '(Mutable Linear Classy))
        (def protocol (.ref (set-styles descriptor) name))
        (def root (.call descriptor .<-list '(1 2 3)))
        (def owner (.call protocol .ap root))
        (check-exception (.call protocol .partition even? owner) TypeError?)
        (check (eq? root (.call protocol .unap owner)) => #t)
        (check-equal? (.call protocol .list<- (.call protocol .filter even? owner)) '(2))))
    (test-case "direct sets protect refinements empty input and declared origins"
      (check-exception (.call RationalSet .partition 'not-a-procedure (.@ RationalSet .empty)) ContractViolation?)
      (check-exception (.call RationalSet .filter 'not-a-procedure (.@ RationalSet .empty)) ContractViolation?)
      (def origin (.o revision: 0))
      (def descriptor (.cc RationalSet .sources: (list origin)
        .element?: (lambda (root) (and (element? RationalSet root)
          (not (equal? (.call RationalSet .list<- root) '(1 3)))))))
      (def root (.call RationalSet .<-list '(1 2 3)))
      (check-exception (.call descriptor .partition even? root) TypeError?)
      (check-exception (.call descriptor .filter odd? root) TypeError?)
      (check-equal? (.call descriptor .list<- (.call descriptor .filter even? root)) '(2))
      (check-exception (.call descriptor .partition (lambda (_) (.set! origin revision 1) #t) root) Error?)
      (check-equal? (.@ origin revision) 0))
    (test-case "reentrant winner stale rejection and metadata guards cover all results"
      (def descriptor (.cc RationalSet))
      (def protocol (.@ (set-styles descriptor) Classy))
      (def owner (.call protocol .ap (.call descriptor .<-list '(1 2 3))))
      (def entered? #f)
      (check-exception (.call protocol .partition (lambda (k)
        (unless entered? (set! entered? #t) (@@method owner.cons 9)) (even? k)) owner)
        (message? "stale table reference"))
      (check-equal? (@@method owner.list<-) '(1 2 3 9))
      (check-exception (@@method owner.partition (lambda (_) (.set! descriptor sexp 'changed) #t)) Error?)
      (check-equal? (@@method owner.list<-) '(1 2 3 9)))
    (test-case "Function identity and FUN IO delta inverse retry compose with partition"
      (def function (Fun Integer <- Integer))
      (def table (alist-table Integer function))
      (def f (validate function (lambda (n) (+ n 1))))
      (def root (.call table .acons 1 f (.call table .acons 2 f (.@ table .empty))))
      (def styles (table-styles table)) (def protocol (.@ styles Linear))
      (def owner (.call protocol .ap root))
      (defvalues (yes no) (.call protocol .partition (lambda (k _) (odd? k)) owner))
      (check (eq? f (.call protocol .ref yes 1)) => #t)
      (check (eq? f (.call protocol .ref no 2)) => #t)
      (check-exception ((.call protocol .ref no 2) "bad") TypeError?)
      (def delta (.call table .diff root (.call protocol .unap yes)))
      (def restored (.call table .apply-delta (.call protocol .unap yes) (invert-table-delta delta)))
      (check (eq? f (.call table .ref restored 2)) => #t)
      (def seen []) (def refuse? #t) (def calls 0)
      (def action (service.partition-access-action RationalSet
        (lambda (element) (if (and refuse? (= element 3)) (error "policy not ready") (even? element)))
        (lambda (accepted rejected) (set! calls (+ calls 1)) (set! seen (list accepted rejected)) seen)))
      (def policy (.call RationalSet .<-list '(1 2 3)))
      (check-exception (action policy) (message? "policy not ready"))
      (check-equal? calls 0) (check-equal? seen [])
      (set! refuse? #f)
      (check-equal? (action policy) '((2) (1 3)))
      (check-equal? calls 1)
      (check-equal? seen '((2) (1 3))))
    (test-case "indexed service routing preserves Functions and suppresses IO until both branches admit"
      (def function (Fun Integer <- Integer))
      (def callback (validate function (lambda (n) (+ n 1))))
      (def row (Tuple Integer function)) (def base (SimpleTrie UInt row))
      (def source (.cc base .element?: (lambda (r)
        (and (element? base r) (even? (.call base .count r))))))
      (def table (table-indexes source (list
        (.cc Type. name: 'priority table: (RationalDict UInt) unique?: #t
          project: (lambda (_ v) (vector-ref v 0))))))
      (def root (.call table .wrap (.call base .<-list
        (map (lambda (k) (cons k (vector (* 10 k) callback))) '(1 2 3 4)))))
      (def calls 0) (def boundary 20) (def visits [])
      (def action (service.partition-ledger-action table (lambda (k v)
        (set! visits (cons k visits)) (< (vector-ref v 0) boundary))
        (lambda (accepted rejected) (set! calls (+ calls 1)) (list accepted rejected))))
      (check-exception (action root) TypeError?)
      (check-equal? calls 0) (check-equal? (reverse visits) '(1 2 3 4))
      (set! boundary 25) (set! visits [])
      (def result (action root))
      (check-equal? calls 1) (check-equal? (reverse visits) '(1 2 3 4))
      (check-equal? (map car (car result)) '(1 2))
      (check-equal? (map car (cadr result)) '(3 4))
      (for (entry (append (car result) (cadr result)))
        (check (eq? callback (vector-ref (cdr entry) 1)) => #t))
      (check-exception ((vector-ref (cdar (car result)) 1) "bad") TypeError?))
    (test-case "endpoint queries admit the full source before short-circuit observation"
