    (test-case "five styles and receivers observe endpoints without consuming owners"
      (for* ((set? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def descriptor (if set? RationalSet (RationalDict Integer)))
        (def protocol (.ref ((if set? set-styles table-styles) descriptor) name))
        (def input (.call protocol .<-list (if set? '(1 2) '((1 . 10) (2 . 20)))))
        (def first (if set? 1 '(1 . 10))) (def last (if set? 2 '(2 . 20)))
        (check-equal? (.call protocol .choose/opt input) (some first))
        (check-equal? (.call protocol .choose input) first)
        (if set?
          (begin
            (check-equal? (.call protocol .min-elt/opt input) (some first))
            (check-equal? (.call protocol .max-elt input) last))
          (begin
            (check-equal? (.call protocol .min-binding/opt input) (some first))
            (check-equal? (.call protocol .max-binding input) last)))
        (when (memq name '(Posh Classy))
          (check-equal? (@@method input.choose/opt) (some first))
          (check-equal? (@@method input.choose) first)
          (if set?
            (begin (check-equal? (@@method input.min-elt) first)
              (check-equal? (@@method input.max-elt/opt) (some last)))
            (begin (check-equal? (@@method input.min-binding) first)
              (check-equal? (@@method input.max-binding/opt) (some last)))))
        (check-equal? (.call protocol .count input) 2)
        (def empty (.call protocol .<-list []))
        (check (.call protocol .choose/opt empty) => #f)
        (check-exception (.call protocol .choose empty) (message? "no value"))
        (check-equal? (.call protocol .count empty) 0)))
    (test-case "endpoint refusal preserves causes and rejects protected or stale metadata"
      (def origin (.o revision: 0))
      (def base (RationalDict Integer)) (def root (.call base .singleton 1 10))
      (def cause (with-catch identity (lambda () (error "endpoint backend refusal"))))
      (def failing (.cc base .element?: (lambda (value) (element? base value))
        .for-each: (lambda _ (raise cause))))
      (check (eq? (with-catch identity (lambda () (.call failing .choose/opt root))) cause) => #t)
      (def table (.cc base .sources: (list origin) .element?: (lambda (value) (element? base value))
        .for-each: (lambda (f value) (.set! origin revision 1) (.call base .for-each f value))))
      (check-exception (.call table .min-binding/opt root) (message? "object mutation during computation"))
      (check-equal? (.@ origin revision) 0)
      (def source (.cc base .sources: (list origin)))
      (def protocol (.@ (table-styles source) Linear)) (def owner (.call protocol .ap root))
      (.set! origin revision 1)
      (check-exception (.call protocol .choose/opt owner) (message? "stale table styles")))
    (test-case "represented indexed Function endpoints compose nonconsuming FUN IO retry"
      (def signature (Fun Integer <- Integer))
      (def f (validate signature (lambda (n) (+ n 1))))
      (def approved? #t)
      (def raw (RationalDict (Tuple Integer signature)))
      (def indexed (table-indexes raw (list (.cc Type. name: 'rank unique?: #t
        table: (RationalDict (.@ raw Key)) project: (lambda (_ row) (vector-ref row 0))))))
      (defvalues (represented _carrier _keys) (box-table indexed key:
        (.cc Wrapper. Domain: (.@ indexed Key) Codomain: (.@ indexed Key) .ap: identity .unap: identity)))
      (def bounded (.cc represented .element?: (lambda (root)
        (and approved? (element? represented root) (= (.call represented .count root) 2)))))
      (def protocol (.@ (table-styles bounded) Linear))
      (def input (.call protocol .<-list (list (cons 1 (vector 10 f)) (cons 2 (vector 20 f)))))
      (def effects 0)
      (def action (service.choose-ledger-action protocol (lambda (selected)
        (set! effects (+ effects 1))
        (check (eq? (vector-ref (cdr (some-value selected)) 1) f) => #t)
        ((vector-ref (cdr (some-value selected)) 1) 7))))
      (set! approved? #f)
      (check-exception (action input) TypeError?)
      (check-equal? effects 0)
      (set! approved? #t)
      (check-equal? (action input) 8)
      (def selected (.call protocol .choose/opt input))
      (set-car! (some-value selected) 99)
      (check (eq? (vector-ref (.call protocol .ref input 1) 1) f) => #t)
      (check-equal? (.call protocol .count input) 2)
      (check-equal? effects 1))

    (test-case "generic emptiness observes contents without evaluating an empty constructor"
      (def base (RationalDict Integer))
      ;; Delegate the declared primitives; do not supply an emptiness capability.
      (def generic (.o (:: @ methods.table) Key: (.@ base Key) Value: Integer
        (.empty (error "empty constructor must not run"))
        .validate-shape: (.@ base .validate-shape) .ref: (.@ base .ref)
        .acons: (.@ base .acons) .remove: (.@ base .remove)
        .foldl: (.@ base .foldl) .foldr: (.@ base .foldr)))
      (def root (.call base .singleton 1 10))
      (def removed (.call base .remove root 1))
      (check (.call generic .empty? removed) => #t)
      (check (.call generic .empty? root) => #f)
      (check-equal? (.call generic .count removed) 0))
    (test-case "public emptiness admits every child before backend shortcuts"
      (for (base (list (RationalDict Integer) (SimpleTrie UInt Integer)))
        (def decisions 0)
        (def table (.cc base .empty/key?: (lambda (root)
          (set! decisions (+ decisions 1)) (.call base .empty/key? root))))
        (def invalid (.call base .<-list/key '((1 . 10) (2 . bad))))
        (check-exception (.call table .empty? invalid) TypeError?)
        (check-exception (.call table .empty? 'bad) TypeError?)
        (check-equal? decisions 0)
        (check (.call table .empty? (.@ base .empty)) => #t)
        (check-equal? decisions 1))
      (for (base (list RationalSet (SimpleTrieSet UInt)))
        (def nonempty (.cc base .element?: (lambda (root)
          (and (element? base root) (> (.call base .count root) 0)))))
        (check-exception (.call nonempty .empty? (.@ base .empty)) TypeError?)))
    (test-case "emptiness capabilities require Boolean decisions and preserve failure causes"
      (def origin (.o revision: 0))
      (def base (RationalDict Integer)) (def root (.call base .singleton 1 10))
      (def wrong (.cc base .empty/key?: (lambda _ 'truthy)))
      (check-exception (.call wrong .empty? root) ContractViolation?)
      (def cause (with-catch identity (lambda () (error "emptiness backend refusal"))))
      (def failing (.cc base .empty/key?: (lambda _ (raise cause))))
      (check (eq? (with-catch identity (lambda () (.call failing .empty? root))) cause) => #t)
      (def guarded (.cc base .sources: (list origin)
        .empty/key?: (lambda (_) (.set! origin revision 1) #f)))
      (check-exception (.call guarded .empty? root) (message? "object mutation during computation"))
      (check-equal? (.@ origin revision) 0))
    (test-case "generic emptiness short-circuits only after complete admission"
      (def base (alist-table UInt Integer)) (def visits 0)
      (def table (.cc base .element?: (lambda (root) (element? base root))
        .for-each: (lambda (f root) (.call base .for-each (lambda (k v)
          (set! visits (+ visits 1)) (f k v)) root))))
      (check (.call table .empty? []) => #t)
      (check-equal? visits 0)
      (check (.call table .empty? '((1 . 10) (2 . 20))) => #f)
      (check-equal? visits 1))
    (test-case "all styles and receivers distinguish empty values from consumed owners"
      (for* ((set? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def descriptor (if set? RationalSet (RationalDict Bool)))
        (def protocol (.ref ((if set? set-styles table-styles) descriptor) name))
        (def empty (.call protocol .<-list []))
        (def full (.call protocol .<-list (if set? '(1) '((1 . #f)))))
        (check (.call protocol .empty? empty) => #t)
        (check (.call protocol .empty? full) => #f)
        (when (memq name '(Posh Classy))
          (check (@@method empty.empty?) => #t)
          (check (@@method full.empty?) => #f))
        (check-equal? (.call protocol .count full) 1)
        (check-equal? (.call protocol .count empty) 0)
        (when (eq? name 'Linear)
          (.call protocol .step empty identity)
          (check-exception (.call protocol .empty? empty) (message? "consumed table reference")))))
    (test-case "private Trie and grouped bucket emptiness permit temporary partial roots"
      (def base (SimpleTrie UInt Symbol))
      (def paired (.cc base .element?: (lambda (root)
        (and (element? base root) (= (.call base .count root) 2)))))
      (def before (.call paired .<-list '((1 . old) (2 . old))))
      (def after (.call paired .<-list '((1 . new) (2 . new))))
      (def indexed (table-indexes paired (list (.cc Type. name: 'team unique?: #f
        table: (alist-table Symbol paired) project: (lambda (_ row) row)))))
      (def state (.call indexed .wrap before))
      (def delta (.call paired .diff before after))
      (def next (.call indexed .apply-delta state delta))
      (check (.call indexed .empty? next) => #f)
      (check (.call indexed .index-ref/opt next 'team 'old) => #f)
      (check-equal? (.call paired .count (some-value (.call indexed .index-ref/opt next 'team 'new))) 2)
      (def restored (.call indexed .apply-delta next (invert-table-delta delta)))
      (check-equal? (.call indexed .list<- restored) (.call paired .list<- before)))
    (test-case "represented indexed partial ledgers compose nonconsuming empty FUN IO retry"
      (def signature (Fun Integer <- Integer))
      (def callback (validate signature (lambda (n) (+ n 1))))
      (def approved? #t)
      (def raw (RationalDict (Tuple Integer signature)))
      (def indexed (table-indexes raw (list (.cc Type. name: 'rank unique?: #t
        table: (RationalDict (.@ raw Key)) project: (lambda (_ row) (vector-ref row 0))))))
      (defvalues (boxed _carrier _keys) (box-table indexed))
      (def table (.o (:: @ boxed) (.empty (error "forbidden business empty"))
        .element?: (lambda (root) (and approved? (element? boxed root) (> (.call boxed .count root) 0)))))
      (def protocol (.@ (table-styles table) Linear))
      (def owner (.call protocol .singleton 1 (vector 10 callback)))
      (def effects 0)
      (def action (service.empty-ledger-action protocol (lambda (empty?)
        (set! effects (+ effects 1)) empty?)))
      (set! approved? #f)
      (check-exception (action owner) TypeError?)
      (check-equal? effects 0)
      (set! approved? #t)
      (check (action owner) => #f)
      (check-equal? effects 1)
      (check (eq? (vector-ref (.call protocol .ref owner 1) 1) callback) => #t)
      (check-equal? (.call protocol .count owner) 1))
))

