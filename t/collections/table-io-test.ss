;;; Collection codecs retain complete admission and the standard IO formats.
(export table-io-test)
(import :std/test :std/error :std/iter :std/misc/ports
        :clan/poo/object :clan/poo/mop :clan/poo/type :clan/poo/number :clan/poo/table :clan/poo/rationaldict :clan/poo/support/option
        (only-in :clan/poo/trie SimpleTrie SimpleTrieSet) (only-in :clan/poo/brace @@method)
        (only-in :clan/poo/t/table-testing box-table alist-table)
        (prefix-in :clan/poo/examples/service-collection service.))

;; Preserve exact codec causes instead of accepting unrelated failure families.
(def (cause-of action) (with-catch identity action))

;; Produce an initially faithful observation, then recycle only its carrier shells
;; during child encoding. Root data and all element/payload leaves stay unchanged.
(def (encoder-buffer-fixture set? inspect)
  (def borrowed #f)
  (def (prepare n)
    (when (and borrowed (= n 1))
      (if set? (set-car! (cdr borrowed) 99)
        (begin (set-cdr! (car borrowed) 99)
          (set-car! (cadr borrowed) 3) (set-cdr! (cadr borrowed) 88))))
    (inspect n)
    n)
  (def key (.cc Integer
    .json<-: (lambda (n) (.call Integer .json<- (prepare n)))
    .marshal: (lambda (n port) (.call Integer .marshal (prepare n) port))))
  (def raw (.cc (RationalDict (if set? Unit Integer)) Key: Integer))
  (def base (if set? (.cc Set<-Table. Table: raw) raw))
  (def descriptor (if set?
    (.cc Set<-Table. Table: (.cc raw Key: key) Elt: key .list<-: (lambda (root)
      (set! borrowed (.call base .list<- root)) borrowed))
    (.cc raw Key: key .list/key: (lambda (root)
      (set! borrowed (.call raw .list<- root)) borrowed))))
  (def root (.call base .<-list (if set? '(1 2) '((1 . 10) (2 . 20)))))
  (values descriptor base root (lambda () borrowed)))

;; Exercise the three existing encoder formats through their declared signatures.
(def (encode-observation protocol format root)
  (case format
    ((json) (.call protocol .json<- root))
    ((bytes) (.call protocol .bytes<- root))
    ((port) (call-with-output-u8vector (lambda (port) (.call protocol .marshal root port))))))

;; Compare public observations; serialization never implies carrier identity.
(def table-io-test
  (test-suite "checked collection IO"
    (test-case "Table encoding captures original binding shells before key codecs can rewrite values and later rows"
      (for (format '(json bytes port))
        (def seen [])
        (defvalues (descriptor base root borrowed)
          (encoder-buffer-fixture #f (lambda (n) (set! seen (cons n seen)))))
        (def expected (encode-observation base format root))
        (check-equal? (encode-observation descriptor format root) expected)
        (check-equal? (reverse seen) '(1 2))
        (check-equal? (borrowed) '((1 . 99) (3 . 88)))
        (check-equal? (.call base .list<- root) '((1 . 10) (2 . 20)))))
    (test-case "Set encoders own their element spine and preserve present false elements"
      (for (format '(json bytes port))
        (defvalues (descriptor base root borrowed) (encoder-buffer-fixture #t (lambda (_) (void))))
        (check-equal? (encode-observation descriptor format root) (encode-observation base format root))
        (check-equal? (borrowed) '(1 99))
        (check-equal? (.call base .list<- root) '(1 2)))
      (def borrowed #f)
      (def plain (.cc Set<-Table. Table: (alist-table Bool Unit)))
      (def bit (.cc Bool .json<-: (lambda (value)
        (when borrowed (set-car! (cdr borrowed) #f)) value)))
      (def descriptor (.cc Set<-Table. Table: (alist-table bit Unit) Elt: bit
        .list<-: (lambda (root) (set! borrowed (.call plain .list<- root)) borrowed)))
      (def root (list (cons #f (void)) (cons #t (void))))
      (check-equal? (.call descriptor .json<- root) '(#f #t))
      (check-equal? borrowed '(#f #f)))
    (test-case "all five Table and Set presentations encode frozen observations without consuming any owner"
      (for* ((set? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (defvalues (descriptor base root _borrowed) (encoder-buffer-fixture set? (lambda (_) (void))))
        (def protocol (.ref ((if set? set-styles table-styles) descriptor) name))
        (def owner (.call protocol .ap root))
        (for (format '(json bytes port))
          (def actual (if (memq name '(Posh Classy))
            (case format
              ((json) (@@method owner.json<-))
              ((bytes) (@@method owner.bytes<-))
              ((port) (call-with-output-u8vector (lambda (port) (@@method owner.marshal port)))))
            (encode-observation protocol format owner)))
          (check-equal? actual (encode-observation base format root))
          (check-eq? (.call protocol .unap owner) root)
          (check-equal? (.call protocol .count owner) 2))))
    (test-case "original late codec refusal retains cause port prefix and a fresh snapshot retry"
      (def cause (list 'original-second-key-refused))
      (for (format '(json bytes port))
        (def fail? #t) (def seen [])
        (defvalues (descriptor base root _borrowed)
          (encoder-buffer-fixture #f (lambda (n)
            (set! seen (cons n seen)) (when (and fail? (= n 2)) (raise cause)))))
        (if (eq? format 'port)
          (let ()
            (def actual #f)
            (def emitted (call-with-output-u8vector (lambda (port)
              (set! actual (cause-of (lambda () (.call descriptor .marshal root port)))))))
            (check-eq? actual cause)
            (def prefix (call-with-output-u8vector (lambda (port)
              (.call UInt .marshal 2 port) (.call Integer .marshal 1 port) (.call Integer .marshal 10 port))))
            (check-equal? emitted prefix))
          (check-eq? (cause-of (lambda () (encode-observation descriptor format root))) cause))
        (check-equal? (reverse seen) '(1 2))
        (set! fail? #f) (set! seen [])
        (check-equal? (encode-observation descriptor format root) (encode-observation base format root))
        (check-equal? (reverse seen) '(1 2))
        (check-equal? (.call base .list<- root) '((1 . 10) (2 . 20)))))
    (test-case "encoder method lookup retains its priority before enumeration and original lookup failures"
      (def base (.cc (RationalDict Integer) Key: Integer))
      (def root (.call base .singleton 1 10)) (def enumerations 0) (def lookups 0)
      (def cause (list 'codec-getter-refused))
      (def schema (.o (:: @ (.@ base .Bindings))
        (.json<- (begin (set! lookups (+ lookups 1)) (raise cause)))))
      (def descriptor (.cc base .Bindings: schema .list<-: (lambda (value)
        (set! enumerations (+ enumerations 1)) (.call base .list<- value))))
      (check-eq? (cause-of (lambda () (.call descriptor .json<- root))) cause)
      (check-equal? lookups 1) (check-equal? enumerations 0)
      (def invalid (.call base .<-list/key '((1 . invalid))))
      (check-exception (.call descriptor .json<- invalid) TypeError?)
      (check-equal? lookups 1) (check-equal? enumerations 0))
    (test-case "Function handle snapshots compose FUN IO encoding indexed decode refusal retry and inverse recovery"
      (def signature (Fun Integer <- Integer))
      (def f (validate signature (lambda (n) (+ n 1))))
      (def g (validate signature (lambda (n) (+ n 2))))
      (def handles (.cc signature
        .json<-: (lambda (proc) (cond ((eq? proc f) 7) ((eq? proc g) 8) (else (error "unknown handle"))))
        .<-json: (lambda (code) (case code ((7) f) ((8) g) (else (error "unknown handle"))))))
      (def row (Tuple Integer handles)) (def raw (.cc (RationalDict row) Key: Integer))
      (def root (.call raw .<-list (list (cons 1 (vector 10 f)) (cons 2 (vector 20 g)))))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def borrowed #f) (def fail? #t) (def effects 0)
        (def cause (list 'original-codec-refused))
        (def key (.cc Integer .json<-: (lambda (n)
          (when (and borrowed (= n 1))
            (set-cdr! (car borrowed) (vector 99 g)) (set-car! (cadr borrowed) 3))
          (when (and fail? (= n 2)) (raise cause))
          (.call Integer .json<- n))))
        (def source (.cc raw Key: key .list/key: (lambda (value)
          (set! borrowed (.call raw .list<- value)) borrowed)))
        (def protocol (.ref (table-styles source) name)) (def owner (.call protocol .ap root))
        (def encode (service.encode-ledger-action protocol (lambda (wire) (set! effects (+ effects 1)) wire)))
        (check-eq? (cause-of (lambda () (encode owner))) cause)
        (check-equal? effects 0) (check-eq? (.call protocol .unap owner) root)
        (set! fail? #f)
        (def wire (encode owner))
        (check-equal? effects 1) (check-equal? wire (.call raw .json<- root))
        (def indexed (table-indexes raw (list (.cc Type. name: 'rank unique?: #t
          table: (RationalDict Integer) project: (lambda (_ value) (vector-ref value 0))))))
        (def target (.@ (table-styles indexed) Linear)) (def deliveries 0)
        (def decode (service.decode-ledger-action target (lambda (fresh)
          (set! deliveries (+ deliveries 1)) fresh)))
        (def duplicate (.call raw .json<- (.call raw .<-list
          (list (cons 1 (vector 10 f)) (cons 2 (vector 10 g))))))
        (check-exception (decode duplicate) table-index-conflict?)
        (check-equal? deliveries 0)
        (def accepted (decode wire))
        (check-equal? deliveries 1)
        (check-eq? (vector-ref (.call target .ref accepted 1) 1) f)
        (check-eq? (vector-ref (.call target .ref accepted 2) 1) g)
        (check-equal? (.call indexed .index-ref/opt (.call target .unap accepted) 'rank 20) (some 2))
        (def primary (.call indexed .unwrap (.call target .unap accepted)))
        (def delta (.call raw .diff primary (.call raw .acons 2 (vector 30 g) primary)))
        (def updated (.call target .apply-delta accepted delta))
        (def restored (.call target .apply-delta updated (invert-table-delta delta)))
        (check-eq? (vector-ref (.call target .ref restored 2) 1) g)
        (check-equal? (.call indexed .index-ref/opt (.call target .unap restored) 'rank 20) (some 2))
        (check-eq? (.call protocol .unap owner) root)))
    (test-case "Table and Set codecs retain JSON binary and port roundtrips"
      (for (descriptor (list (RationalDict Integer) (SimpleTrie UInt Integer)
                            RationalSet (SimpleTrieSet UInt)))
        (def set? (.has? descriptor Elt))
        (def root (.call descriptor .<-list (if set? '(1 2) '((1 . 10) (2 . 20)))))
        (def json (.call descriptor .json<- root))
        (def bytes (.call descriptor .bytes<- root))
        (def emitted (call-with-output-u8vector (lambda (port) (.call descriptor .marshal root port))))
        (for (recovered (list (.call descriptor .<-json json) (.call descriptor .<-bytes bytes)
               (call-with-input-u8vector emitted (lambda (port) (.call descriptor .unmarshal port)))))
          (check-equal? (.call descriptor .list<- recovered) (.call descriptor .list<- root)))
        (check-equal? bytes emitted)
        (check-exception (.call descriptor .<-bytes (u8vector-append bytes #u8(0))) Error?)))
    (test-case "all encoder formats admit complete roots before child codec effects"
      (def calls 0)
      (def value (.cc Integer .json<-: (lambda (n) (set! calls (+ calls 1)) n)
        .marshal: (lambda (n port) (set! calls (+ calls 1)) (.call Integer .marshal n port))))
      (def table (RationalDict value))
      (def invalid (.call table .<-list/key '((1 . 10) (2 . bad))))
      (check-exception (.call table .json<- invalid) TypeError?)
      (check-exception (.call table .bytes<- invalid) TypeError?)
      (def written (call-with-output-u8vector (lambda (port)
        (check-exception (.call table .marshal invalid port) TypeError?))))
      (check-equal? written #u8())
      (check-equal? calls 0)
      (def set (.cc RationalSet .element?: (lambda (root) (= (.call RationalSet .count root) 2))))
      (def one (.call RationalSet .singleton 1))
      (check-exception (.call set .json<- one) TypeError?)
      (check-exception (.call set .bytes<- one) TypeError?))
    (test-case "decoded children are recognized before any complete root escapes"
      (def base (RationalDict Integer))
      (def root (.call base .singleton 1 10))
      (def value (.cc Integer .<-json: (lambda (_) 'bad)
        .unmarshal: (lambda (port) (.call Integer .unmarshal port) 'bad)))
      (def table (RationalDict value))
      (check-exception (.call table .<-json (.call base .json<- root)) TypeError?)
      (def bytes (.call base .bytes<- root))
      (check-exception (.call table .<-bytes bytes) TypeError?)
      (check-exception (call-with-input-u8vector bytes
        (lambda (port) (.call table .unmarshal port))) TypeError?))
    (test-case "child codecs cannot revise protected origins and can retry after refusal"
      (def origin (.o revision: 0)) (def armed? #f)
      (def value (.cc Integer
        .json<-: (lambda (n) (when armed? (.set! origin revision 1)) (.call Integer .json<- n))
        .<-json: (lambda (n) (when armed? (.set! origin revision 1)) (.call Integer .<-json n))))
      (def table (.cc (RationalDict value) .sources: (list origin)))
      (def root (.call table .singleton 1 10))
      (def json (.call table .json<- root))
      (set! armed? #t)
      (check-exception (.call table .json<- root) Error?)
      (check-exception (.call table .<-json json) Error?)
      (check-equal? (.@ origin revision) 0)
      (set! armed? #f)
      (check-equal? (.call table .list<- (.call table .<-json json)) '((1 . 10))))
    (test-case "Pair and List codec declarations remain protected during child calls"
      (for (kind '(Binding Bindings SetList))
        (def schema #f) (def armed? #f)
        (def child (.cc Integer .json<-: (lambda (n)
          (when armed? (.set! schema sexp 'changed)) (.call Integer .json<- n))))
        (def table (.cc (RationalDict Integer) Key: child Value: child))
        (def base (if (eq? kind 'SetList) (.cc Set<-Table. Table: (.cc table Value: Unit)) table))
        ;; Hold one exact schema: a later getter may legitimately allocate another.
        (def declared (.ref base (if (eq? kind 'SetList) '.List '.Bindings)))
        (def descriptor (if (eq? kind 'SetList) (.cc base .List: declared)
          (.cc base .Bindings: declared .Binding: (.@ declared type))))
        (def root (.call descriptor .<-list (if (eq? kind 'SetList) '(1) '((1 . 10)))))
        (set! schema (if (eq? kind 'Binding) (.@ declared type) declared))
        (.call descriptor .json<- root)
        (def revision (object-revision schema))
        (set! armed? #t)
        (check-exception (.call descriptor .json<- root) Error?)
        (check-equal? (object-revision schema) revision)))
    (test-case "late codec failure preserves its cause and prior port effects"
      (def cause (cause-of (lambda () (error "late codec refusal"))))
      (def value (.cc Integer
        .marshal: (lambda (n port) (when (= n 20) (raise cause)) (.call Integer .marshal n port))
        .unmarshal: (lambda (port) (def n (.call Integer .unmarshal port))
          (when (= n 20) (raise cause)) n)))
      (def table (RationalDict value))
      (def root (.call table .<-list '((1 . 10) (2 . 20))))
      (def actual #f)
      (def written (call-with-output-u8vector (lambda (port)
        (set! actual (cause-of (lambda () (.call table .marshal root port)))))))
      (check (eq? actual cause) => #t)
      (check (> (u8vector-length written) 0) => #t)
      (check (eq? (cause-of (lambda () (.call table .bytes<- root))) cause) => #t)
      (def bytes (.call (RationalDict Integer) .bytes<- root))
      (call-with-input-u8vector bytes (lambda (port)
        (check (eq? (cause-of (lambda () (.call table .unmarshal port))) cause) => #t)
        (check (eof-object? (read-u8 port)) => #t)))
      (check-equal? (.call table .list<- root) '((1 . 10) (2 . 20))))
    (test-case "five styles encode nonconsuming snapshots and decode fresh presentations"
      (for* ((set? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def base (if set? RationalSet (RationalDict Integer)))
        (def descriptor (.cc base .element?: (lambda (root)
          (and (element? base root) (= (.call base .count root) 2)))))
        (def family ((if set? set-styles table-styles) descriptor))
        (def protocol (.ref family name))
        (def input (.call protocol .<-list (if set? '(1 2) '((1 . 10) (2 . 20)))))
        (def json (.call protocol .json<- input))
        (def bytes (.call protocol .bytes<- input))
        (when (memq name '(Posh Classy))
          (check-equal? (@@method input.json<-) json)
          (check-equal? (@@method input.bytes<-) bytes))
        (def emitted (call-with-output-u8vector (lambda (port)
          (if (memq name '(Posh Classy)) (@@method input.marshal port)
            (.call protocol .marshal input port)))))
        (for (fresh (list (.call protocol .<-json json) (.call protocol .<-bytes bytes)
              (call-with-input-u8vector emitted (lambda (port) (.call protocol .unmarshal port)))))
          (check-equal? (.call protocol .list<- fresh) (.call protocol .list<- input)))
        (check-equal? (.call protocol .count input) 2)
        (check-exception (.call protocol .<-json []) TypeError?)))
    (test-case "indexed handle codecs compose fresh decoding failure retry and Reader FUN IO"
      (def signature (Fun Integer <- Integer))
      (def f (validate signature (lambda (n) (+ n 1))))
      (def g (validate signature (lambda (n) (+ n 2))))
      ;; This explicit finite registry restores known handles; closures have no
      ;; inferred wire representation and are never reconstructed from code.
      (def handles (.cc signature
        .json<-: (lambda (proc) (cond ((eq? proc f) 7) ((eq? proc g) 8) (else (error "unknown handle"))))
        .<-json: (lambda (code) (case code ((7) f) ((8) g) (else (error "unknown handle"))))))
      (def raw (RationalDict (Tuple Integer handles)))
      (def indexed (table-indexes raw (list (.cc Type. name: 'rank unique?: #t
        table: (RationalDict (.@ raw Key)) project: (lambda (_ row) (vector-ref row 0))))))
      (defvalues (represented _carrier _keys) (box-table indexed))
      (def protocol (.@ (table-styles represented) Linear))
      (def input (.call protocol .<-list (list (cons 1 (vector 10 f)) (cons 2 (vector 20 g)))))
      (def json (.call protocol .json<- input))
      (def effects 0)
      (def action (service.decode-ledger-action protocol (lambda (fresh)
        (set! effects (+ effects 1))
        (check (eq? (vector-ref (.call protocol .ref fresh 1) 1) f) => #t)
        (check-equal? (.call indexed .index-ref/opt
          (.call _carrier .unap (.call protocol .unap fresh)) 'rank 10) (some -1))
        ((vector-ref (.call protocol .ref fresh 1) 1) 7))))
      (def bad (.call raw .json<- (.call raw .<-list
        (list (cons -1 (vector 10 f)) (cons -2 (vector 10 g))))))
      (check-exception (action bad) table-index-conflict?)
      (check-equal? effects 0)
      (check-equal? (.call protocol .count input) 2)
      (check-equal? (action json) 8)
      (check-equal? effects 1)
      (check-exception (.call protocol .bytes<- input) NoApplicableMethod?))))
