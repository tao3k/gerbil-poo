;;; Literal intrinsic descriptors share finite inference and qualified publication.
(export descriptor-inference-test)
(import (only-in ../number UInt Integer UInt256 JsInt) :std/test :std/error ../object ../mop ../type ../types/relation ../prototype-types
        (only-in ../optional-validation type-value-catalog)
        (only-in ../object-contract ObjectContract. refine)
        (only-in ../slot-observation call-with-slot-read-observer slot-read-receiver slot-read-key)
        ../method-declaration
        (prefix-in ../examples/signature-service signature.)
        (prefix-in ../examples/polymorphic-services service.))
;; Keep syntax/work refusal separate from a completed false judgment.
(def (refusal kind)
  (lambda (cause) (and (type-refusal? cause) (eq? (type-refusal-kind cause) kind))))
;; Boundary, containment, carrier identity and whole workflow have independent controls.
(def descriptor-inference-test
  (test-suite "Singleton width and byte descriptor inference"
    (test-case "public judgments own every operand before live catalog observers"
      (def provider (.o Item: UInt))
      (def token (agetq 'Item (capture-type-catalog provider '(Item))))
      ;; Editing either operand cannot supply evidence for the captured request.
      (for-each (lambda (reverse?)
        (def editable (list 'Tuple 'Bool)) (def changed? #f)
        (def (observe read)
          (when (and (not changed?) (eq? provider (slot-read-receiver read)))
            (set! changed? #t) (set-car! (cdr editable) token)))
        (check (call-with-slot-read-observer observe (lambda ()
          (if reverse? (subtype-expression? editable (list 'Tuple token))
            (subtype-expression? (list 'Tuple token) editable)))) => #f)
        (check-equal? changed? #t)
        ;; An independent request sees the caller's completed edit.
        (check (subtype-expression? editable (list 'Tuple token)) => #t)) '(#f #t))
      (def inputs (list 'Integer 'Integer)) (def changed? #f)
      (def (shorten read)
        (when (and (not changed?) (eq? provider (slot-read-receiver read)))
          (set! changed? #t) (set-cdr! inputs [])))
      (def left (list 'Function (list token) '(Integer)))
      (def right (list 'Function '(UInt) inputs))
      (check (call-with-slot-read-observer shorten (cut function-covers? left right)) => #f)
      (check-equal? changed? #t)
      (check (function-covers? left right) => #t)
      ;; A callback cannot erase an invalid sibling before its grammar admission.
      (def invalid (list 'Tuple 'Unknown))
      (def (repair read)
        (when (eq? provider (slot-read-receiver read)) (set-car! (cdr invalid) token)))
      (check-exception (call-with-slot-read-observer repair
        (cut subtype-expression? (list 'Tuple token) invalid)) (refusal 'unsupported))
      (check (subtype-expression? (list 'Tuple token) invalid) => #t))
    (test-case "public compiler retains nested wrappers errors and one request quota"
      (def provider (.o Item: UInt))
      (def token (agetq 'Item (capture-type-catalog provider '(Item))))
      (def fields (list token '(Function (UInt) (Integer))))
      (def syntax (cons 'Tuple fields)) (def observed 0)
      (def (rewrite read)
        (when (eq? provider (slot-read-receiver read))
          (set! observed (1+ observed)) (set-car! (cdr fields) 'Bool)))
      (check-exception (call-with-slot-read-observer rewrite
        (cut expression-type syntax 1)) (refusal 'exhausted))
      (check-equal? observed 0)
      (def descriptor (call-with-slot-read-observer rewrite (cut expression-type syntax)))
      (check (> observed 0) => #t) (check-equal? (cadr fields) 'Bool)
      (check-exception (validate descriptor (vector 7 #f)) TypeError?)
      (def calls 0)
      ;; Rejected callback inputs never enter the body; bad outputs retain effects.
      (def checked (validate descriptor (vector 7
        (lambda (value) (set! calls (1+ calls)) (if (zero? value) #f (abs value))))))
      (def callback (vector-ref checked 1))
      (check-equal? (callback -7) 7)
      (check-exception (callback #f) TypeError?) (check-equal? calls 1)
      (check-exception (callback 0) TypeError?) (check-equal? calls 2)
      (def cause (list 'catalog-observer-failed))
      (def (fail read)
        (when (eq? provider (slot-read-receiver read))
          (set-car! (cdr fields) 'Unit) (raise cause)))
      (check (try (call-with-slot-read-observer fail (cut expression-type syntax)) #f
        (catch (actual) (eq? actual cause))) => #t)
      (check-equal? (cadr fields) 'Unit)
      ;; Supported source revisions still invalidate old directory tokens.
      (.setslot! provider Item ($constant-slot-spec Bool))
      (check-exception (expression-type syntax) Error?))
    (test-case "compiled operation contracts compose specialization declarations and evidence"
      (def provider (.o Item: UInt))
      (def token (agetq 'Item (capture-type-catalog provider '(Item))))
      (def outputs (list token '(Function (UInt) (Integer))))
      (def syntax (list 'Function outputs '(Integer))) (def changed? #f)
      (def bodies 0) (def consumed 0) (def subject #f)
      (def (observe read)
        (when (and (not changed?) (eq? provider (slot-read-receiver read)))
          (set! changed? #t) (set-car! (cdr outputs) 'Bool)))
      (def (operation value) (set! bodies (1+ bodies)) (values (abs value) abs))
      (def context (.o approved: #t))
      (def (action allowed?)
        (call-with-slot-read-observer observe (lambda ()
          (signature.checked-operation-action syntax service.DescriptorServiceType '(Integer)
            '(UInt Bool) (lambda (_context) '((Output UInt) (UInt Output))) operation
            -7 context (lambda (value) (set! consumed (1+ consumed)) (set! subject value)) allowed?))))
      (def ready (action #t))
      (check-equal? changed? #t) (check-equal? bodies 0)
      (defvalues (evidence next issue) (ready context))
      (check-equal? issue #f) (check-equal? bodies 1) (check-equal? consumed 1)
      (check-equal? (.get subject answer) 7)
      (check-equal? ((.get subject callback) -9) 9)
      (check-exception ((.get subject callback) #f) TypeError?)
      (check (eq? (.get evidence subject) subject) => #t)
      (check (eq? (.get evidence context) context) => #t) (check (eq? next context) => #t)
      ;; Repair only the caller buffer; retry is a new bounded public request.
      (set-car! (cdr outputs) '(Function (UInt) (Integer)))
      (check-exception ((action #f) context) TypeError?)
      (check-equal? bodies 2) (check-equal? consumed 1)
      (defvalues (_ _next retried) ((action #t) context))
      (check-equal? retried #f) (check-equal? bodies 3) (check-equal? consumed 2))
    (test-case "retained bindings stay current through preparation and actual construction"
      (def queries '((U Bool) (Bool U) (V Integer) (Integer V)))
      (def calls '((() ((List UInt) Bool Integer) ((List UInt) Bool Integer))))
      (def builders 0)
      ;; A later declaration refusal cannot hide that a builder ran too early.
      (def (build _) (set! builders (1+ builders)) [])
      (def drivers
        (list
          (cons '(1 2) (cut instantiate-prototype <> '(Bool Integer)))
          (cons '(1) (cut specialize-prototype-type <> []))
          (cons '(1 2) (cut specialize-prototype-type <> '(Bool)))
          (cons '(1 2) (cut specialize-prototype-type <> '(Bool Integer)))
          (cons '(1 2 3) (cut infer-prototype <> '(Bool Integer) queries))
          (cons '(1 2 3) (cut infer-prototype-calls <> '(Bool Integer) calls))
          (cons '(1 2) (cut instantiate-declared <> '(Bool Integer) build))
          (cons '(1 2 3) (cut infer-declared <> '(Bool Integer) queries build))
          (cons '(1 2 3) (cut infer-declared-calls <> '(Bool Integer) calls build))))
      (for-each (lambda (driver)
        (for-each (lambda (phase)
          (for-each (lambda (revise)
            (def original (prototype-type (.o .parameters: '(T U V)) '(T U V)
              '(Function (T U V) (T U V)) []))
            (def residual (specialize-prototype-type original '((List UInt))))
            (def source (.get residual prototype)) (def retained (.get source T))
            (def reads 0) (def edited? #f)
            ;; Only supported edits to this fresh source/composite descriptor;
            ;; no shared intrinsic Type is revised by these controls.
            (def (observe read)
              (when (and (eq? (slot-read-receiver read) source) (eq? (slot-read-key read) '.parameters))
                (set! reads (1+ reads))
                (when (= reads phase) (set! edited? #t) (revise source retained))))
            (check-exception (call-with-slot-read-observer observe
              (lambda () ((cdr driver) residual))) (refusal 'bounds))
            (check-equal? edited? #t))
            (list
              (lambda (source _) (.setslot! source T ($constant-slot-spec Bool)))
              (lambda (_ retained) (.setslot! retained audit ($constant-slot-spec 'changed))))))
          (car driver))) drivers)
      (check-equal? builders 0))
    (test-case "getter errors keep their cause and supported repair permits independent retry"
      (def original (prototype-type (.o .parameters: '(T U)) '(T U) '(Pair T U) []))
      (def residual (specialize-prototype-type original '((List UInt))))
      (def source (.get residual prototype)) (def retained (.get source T))
      (def cause (list 'retained-getter-failed))
      ;; Effects remain visible; a final success fence cannot replace the cause.
      (def (observe read)
        (when (and (eq? (slot-read-receiver read) source) (eq? (slot-read-key read) '.parameters))
          (.setslot! source T ($constant-slot-spec Bool)) (raise cause)))
      (check (try (call-with-slot-read-observer observe
        (cut instantiate-prototype residual '(Bool))) #f (catch (actual) (eq? cause actual))) => #t)
      (check (eq? (.get source T) Bool) => #t)
      (.setslot! source T ($constant-slot-spec retained))
      (def retry (instantiate-prototype residual '(Bool)))
      (check-equal? (.get retry expression) '(Pair (List UInt) Bool))
      (check (eq? (.get retry prototype T) retained) => #t)
      (check-equal? (bound-parameters retry) '(T U))
      (.setslot! retained audit ($constant-slot-spec 'changed))
      (check-exception (instantiate-prototype residual '(Bool)) (refusal 'bounds))
      ;; A revised descriptor requires a new residual, never a lowered revision.
      (def rebuilt (instantiate-prototype (specialize-prototype-type original '((List UInt))) '(Bool)))
      (check-equal? (bound-parameters rebuilt) '(T U))
      (check (eq? (.get rebuilt prototype T) retained) => #f))
    (test-case "retained higher-order failure rebuild and publication preserve all Function layers"
      (def input '(Function (Integer) (UInt)))
      (def output '(Function (UInt) (Integer)))
      (def stale (specialize-prototype-type service.DescriptorServiceType (list input)))
      (def source (.get stale prototype)) (def retained (.get source Input))
      (def reads 0) (def bodies 0) (def consumed 0)
      ;; The converter result is itself a Function and must remain wrapped.
      (def (operation _callback)
        (set! bodies (1+ bodies)) (values abs (lambda (_callback) abs)))
      ;; Invalidate only at the final inferred binding read, after prior checks.
      (def (observe read)
        (when (and (eq? (slot-read-receiver read) source) (eq? (slot-read-key read) '.parameters))
          (set! reads (1+ reads))
          (when (= reads 3) (.setslot! retained audit ($constant-slot-spec 'changed)))))
      (check-exception (call-with-slot-read-observer observe
        (cut infer-prototype stale (list output) `((Output ,output) (,output Output)))) (refusal 'bounds))
      (check-equal? reads 3) (check-equal? bodies 0)
      (def fresh (specialize-prototype-type service.DescriptorServiceType (list input)))
      (def context (.o approved: #t)) (def candidates (list output 'Bool))
      (check-exception ((signature.callback-service-action fresh output candidates operation
        identity context void #f) context) TypeError?)
      (check-equal? bodies 1) (check-equal? consumed 0)
      (def subject #f)
      (def action (signature.callback-service-action fresh output candidates operation identity context
        (lambda (value) (set! consumed (1+ consumed)) (set! subject value))))
      (defvalues (evidence next issue) (action context))
      (check-equal? issue #f) (check-equal? bodies 2) (check-equal? consumed 1)
      (check-equal? ((.get subject answer) -7) 7)
      (check-exception ((.get subject answer) #f) TypeError?)
      (def converted ((.get subject callback) identity))
      (check-equal? (converted -9) 9) (check-exception (converted #f) TypeError?)
      (check-exception ((.get subject callback) #f) TypeError?)
      (check (eq? (.get evidence subject) subject) => #t)
      (check (eq? (.get evidence context) context) => #t)
      (check (eq? next context) => #t))
    (test-case "empty dependent catalogs share finite emptiness and carrier rules"
      (for-each (lambda (dead)
        (check (subtype-expression? dead 'String) => #t)
        (check (subtype-expression? (list 'List dead) 'Null) => #t)
        (check (subtype-expression? `(Pair UInt (List ,dead)) '(Pair Integer Null)) => #t))
        '((TypeValuePair) (Pair UInt (TypeValuePair))
          (Record ((plugin (TypeValuePair) required)) closed)))
      (check (subtype-expression? '(Record ((retired (TypeValuePair) optional)) closed) '(Object () closed)) => #t)
      (check (subtype-expression? '(Record ((retired (TypeValuePair) optional)) closed)
        '(Record ((retired (Function (UInt) (UInt)) optional)) closed)) => #t)
      (check (subtype-expression? '(Record ((retired (TypeValuePair) optional)) closed)
        '(Object ((retired UInt)) closed)) => #f)
      (for-each (lambda (live)
        (check (subtype-expression? live 'String) => #f)
        (check (subtype-expression? `(List ,live) 'Null) => #f))
        '((TypeValuePair Bool) (TypeValuePair Null) (TypeValuePair Unit)
          (List (TypeValuePair)) (Map (TypeValuePair) <- UInt) (Maybe (TypeValuePair)) (OrFalse (TypeValuePair))))
      (validate (expression-type '(List (TypeValuePair))) [])
      (validate (expression-type '(Map (TypeValuePair) <- UInt)) (make-hash-table))
      (validate (expression-type '(Maybe (TypeValuePair))) (void))
      (validate (expression-type '(OrFalse (TypeValuePair))) #f)
      ;; Zero possible entries permit a different key; nonempty directories do not.
      (check (subtype-expression? '(Map UInt <- (TypeValuePair)) '(Map UInt <- Bool)) => #t)
      (check (subtype-expression? '(Map UInt <- (TypeValuePair Bool)) '(Map UInt <- Bool)) => #f)
      (check (subtype-expression? '(Union (TypeValuePair)) '(Union UInt)) => #f)
      (check-exception (subtype-expression? '(TypeValuePair Unknown) 'String) (refusal 'unsupported))
      (check-exception (subtype-expression? '(TypeValuePair) 'String 1) (refusal 'exhausted)))
    (test-case "empty catalog rejects before payload effects without inspecting opaque emptiness"
      (def calls 0)
      (def opaque (.cc Type. sexp: 'opaque
        .element?: (lambda (_) (set! calls (1+ calls)) #f)
        .validate: (lambda (_) (set! calls (1+ calls)) (error "payload was reached"))))
      (def descriptor (expression-type '(TypeValuePair)))
      (check-exception (validate descriptor (cons opaque #f)) TypeError?)
      (check (element? descriptor (cons opaque #f)) => #f)
      (check-equal? (map (lambda (issue) (.get issue kind)) (.call descriptor .diagnose (cons opaque #f) []))
        '(type-outside-catalog))
      (check-equal? (map (lambda (issue) (.get issue kind)) (.call descriptor .diagnose (cons 3 #f) [])) '(invalid-type))
      (check-equal? (map (lambda (issue) (.get issue kind)) (.call descriptor .diagnose #f [])) '(expected-type-value-pair))
      (def token (agetq 'Opaque (capture-type-catalog (.o Opaque: opaque) '(Opaque))))
      (check (subtype-expression? `(Record ((retired (TypeValuePair ,token) optional)) closed) '(Object () closed)) => #f)
      (check-equal? calls 0)
      (for-each (lambda (tag value)
        (def original (cons tag value))
        (check (eq? (validate (expression-type `(TypeValuePair ,(.get tag sexp))) original) original) => #t))
        (list Bool Null Unit) (list #f [] (void))))
    (test-case "active typed plugins compose with retired empty catalogs and sealed publication"
      (def active (expression-type '(Function (UInt) (Integer))))
      (def provider (.o Transform: active))
      (def token (agetq 'Transform (capture-type-catalog provider '(Transform))))
      (def plugins `(Map (TypeValuePair ,token) <- UInt))
      (def selected `(Record ((plugins ,plugins required) (limit UInt required) (retired (TypeValuePair) optional)) closed))
      (def wrong `(Record ((plugins ,plugins required) (limit UInt required) (retired (TypeValuePair Bool) optional)) closed))
      (def events []) (def consumed 0) (def observed #f)
      (def report (service.infer-plugin-service token (list wrong selected)
        (lambda (directory) (values directory identity))
        (lambda (event) (set! events (cons event events)))))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) (list (list selected)))
      (def raw (.o plugins: (hash (1 (cons active abs))) limit: 3))
      (def context (.o approved: #t))
      (def action (service.descriptor-service-action (.get report instance) raw context
        (lambda (subject)
          (set! observed subject) (set! consumed (1+ consumed))
          (def answer (.get subject answer))
          (def plugin (hash-ref (.get answer plugins) 1))
          (check (eq? (car plugin) active) => #t)
          (check-equal? ((cdr plugin) -7) 7)
          (check-exception ((cdr plugin) #f) TypeError?)
          (check (not (.slot? answer 'retired)) => #t)
          (def next ((.get subject callback) raw))
          (check-exception ((cdr (hash-ref (.get next plugins) 1)) #f) TypeError?))))
      (defvalues (evidence returned issue) (action context))
      (check-equal? issue #f) (check (eq? returned context) => #t)
      (check (eq? (.get evidence subject) observed) => #t)
      (check (eq? (cdr (hash-ref (.get raw plugins) 1)) abs) => #t)
      (check-equal? (reverse events) '(around before after))
      (check-exception ((service.descriptor-service-action (.get report instance) raw context void #f) context) TypeError?)
      (check-equal? consumed 1)
      (defvalues (_ _context retried) (action context))
      (check-equal? retried #f) (check-equal? consumed 2)
      (check-equal? (.get (service.infer-plugin-service token (list wrong) (lambda (_) (error "invalid builder ran"))) status) 'no-solution)
      (check-equal? (.get (service.infer-plugin-service token (list selected
        `(Record ((plugins ,plugins required) (limit UInt required)) closed))
        (lambda (_) (error "ambiguous builder ran"))) status) 'ambiguous)
      (.set! provider Transform Bool)
      (check-exception (action context) Error?)
      (check-equal? consumed 2))
    (test-case "proved-absent optional fields do not obstruct closed interfaces"
      (for-each (lambda (dead)
        (def source `(Record ((x UInt required) (retired ,dead optional)) closed))
        (check (subtype-expression? source '(Object ((x Integer)) closed)) => #t)
        (check (subtype-expression? source '(Record ((x Integer required)) closed)) => #t)
        (check (subtype-expression? source '(Record ((x Integer required) (retired (Function (UInt) (UInt)) optional)) closed)) => #t)
        (check (subtype-expression? source '(Object ((x Integer) (retired UInt)) closed)) => #f)
        (validate (expression-type source) (.o x: 3))
        (check-exception (validate (expression-type source) (.o x: 3 retired: #f)) TypeError?))
        '(Never (Union) (Tuple Never) (Pair UInt Never) (IntegerRange min: 2 max: 1)))
      (for-each (lambda (live)
        (check (subtype-expression? `(Record ((x UInt required) (retired ,live optional)) closed)
          '(Object ((x Integer)) closed)) => #f))
        '(Bool (List Never) (Map Never <- UInt) (Maybe Never) (OrFalse Never) (Tuple) (BytesN 0)))
      (check (subtype-expression? '(Record ((x UInt required) (retired Never optional)) open)
        '(Object ((x Integer)) closed)) => #f)
      (check-exception (subtype-expression? '(Record ((retired Never optional)) closed)
        '(Record ((retired Unknown optional)) closed)) (refusal 'unsupported))
      (check-exception (subtype-expression? '(Record ((x UInt required) (retired (Union) optional)) closed)
        '(Object ((x Integer)) closed) 1) (refusal 'exhausted)))
    (test-case "sealed worker publication retains absence wrappers and exact evidence"
      (def handler '(Function (UInt) (Integer)))
      (def jobs `(Map (List ,handler) <- UInt))
      (def selected `(Record ((run ,handler required) (limit UInt required)
        (jobs ,jobs required) (retired (Union) optional)) closed))
      (def wrong `(Record ((run ,handler required) (limit UInt required) (jobs ,jobs required) (retired Bool optional)) closed))
      (def consumed 0) (def events []) (def observed #f)
      (def report (service.infer-worker-service (list wrong selected)
        (lambda (worker) (values worker identity))
        (lambda (event) (set! events (cons event events))) closed?: #t))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) (list (list selected)))
      (def context (.o approved: #t))
      (def raw (.o run: abs limit: 3 jobs: (hash (1 (list abs)))))
      (def action (service.descriptor-service-action (.get report instance) raw context
        (lambda (subject)
          (set! observed subject) (set! consumed (1+ consumed))
          (def answer (.get subject answer))
          (check (not (.slot? answer 'retired)) => #t)
          (check-equal? ((.get answer run) -4) 4)
          (check-exception ((car (hash-ref (.get answer jobs) 1)) #f) TypeError?)
          (check (not (.slot? ((.get subject callback) raw) 'retired)) => #t))))
      (defvalues (evidence returned issue) (action context))
      (check-equal? issue #f) (check (eq? returned context) => #t)
      (check (eq? (.get evidence subject) observed) => #t)
      (check-equal? (reverse events) '(around before after))
      (check-exception ((service.descriptor-service-action (.get report instance) raw context void #f) context) TypeError?)
      (check-equal? consumed 1)
      (defvalues (_ _context retried) (action context))
      (check-equal? retried #f) (check-equal? consumed 2)
      (check-exception ((service.descriptor-service-action (.get report instance) (.cc raw retired: #f) context void) context) TypeError?)
      (check-equal? (.get (service.infer-worker-service (list wrong) (lambda (_) (error "invalid builder ran")) closed?: #t) status) 'no-solution)
      (check-equal? (.get (service.infer-worker-service (list selected
        `(Record ((run ,handler required) (limit UInt required) (jobs ,jobs required)) closed))
        (lambda (_) (error "ambiguous builder ran")) closed?: #t) status) 'ambiguous)
      (check-exception (service.infer-worker-service (list selected) identity closed?: 'bad) ContractViolation?))
    (test-case "Record and Object share named carrier inclusion in both directions"
      (def record '(Record ((x UInt required) (flag Bool optional)) closed))
      (def interface '(Object ((x Integer)) open))
      (check (subtype-expression? record interface) => #t)
      (check (subtype-expression? '(Object ((x UInt)) closed)
        '(Record ((flag Bool optional) (x Integer required)) closed)) => #t)
      (check (subtype-expression? '(Object ((x UInt)) open)
        '(Record ((x Integer required) (flag Bool optional)) open)) => #f)
      (check (subtype-expression? '(Record ((x UInt optional)) closed) interface) => #f)
      (check (subtype-expression? record '(Object ((x Integer)) closed)) => #f)
      (check (subtype-expression? '(Record ((x UInt required)) open) '(Object ((x Integer)) closed)) => #f)
      (check (subtype-expression? '(Object ((x Integer)) closed) '(Record ((x UInt required)) closed)) => #f)
      (check (subtype-expression? `(List ,record) `(List ,interface)) => #t)
      (check (subtype-expression? `(Function (,record) (,interface)) `(Function (,interface) (,record))) => #t)
      (def token (agetq (quote Item) (capture-type-catalog (.o Item: (expression-type record)) (quote (Item)))))
      (check (subtype-expression? token interface) => #f)
      (check (subtype-expression? interface token) => #f)
      (check (subtype-expression? `(Map UInt <- ,record) `(Map UInt <- ,interface)) => #f)
      (check (subtype-expression? `(Union ,record) `(Union ,interface)) => #f)
      (validate (expression-type record) (.o x: 3))
      (validate (expression-type interface) (.o x: 3 flag: #f))
      (validate (expression-type '(Record ((x Integer required) (flag Bool optional)) closed)) (.o x: 3))
      (check-exception (validate (expression-type record) (.o x: 3 flag: 'bad)) TypeError?)
      (check-exception (subtype-expression? record interface 1) (refusal 'exhausted)))
    (test-case "inherited worker Record publishes through a structural interface"
      (def handler '(Function (UInt) (Integer)))
      (def jobs `(Map (List ,handler) <- UInt))
      (def selected `(Record ((run ,handler required) (limit UInt required)
        (jobs ,jobs required) (audit Bool optional)) closed))
      (def wrong `(Record ((run ,handler optional) (limit UInt required) (jobs ,jobs required)) closed))
      (def events []) (def consumed 0) (def observed #f)
      (def report (service.infer-worker-service (list wrong selected)
        (lambda (worker) (values worker identity))
        (lambda (event) (set! events (cons event events)))))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) (list (list selected)))
      (def parent (Record run: [(expression-type handler) default: abs]))
      (def limits (Record limit: [UInt default: 3] jobs: [(expression-type jobs) default: (hash (1 (list abs)))]))
      (def child (Record [parent limits] audit: [Bool optional: #t]))
      (def raw (make-instance child))
      (def context (.o approved: #t))
      (def action (service.descriptor-service-action (.get report instance) raw context
        (lambda (subject)
          (set! observed subject) (set! consumed (1+ consumed))
          (def answer (.get subject answer))
          (check-equal? ((.get answer run) -8) 8)
          (check-exception ((.get answer run) #f) TypeError?)
          (check (not (.slot? answer 'audit)) => #t)
          (check-equal? ((car (hash-ref (.get answer jobs) 1)) -5) 5)
          (check-exception ((car (hash-ref (.get answer jobs) 1)) ready:) TypeError?)
          (def next ((.get subject callback) raw))
          (check-equal? (.get next limit) 3)
          (check-exception ((.get subject callback) (.cc raw limit: #f)) TypeError?))))
      (defvalues (evidence returned issue) (action context))
      (check-equal? issue #f) (check (eq? returned context) => #t)
      (check (eq? (.get evidence subject) observed) => #t)
      (check-equal? (reverse events) '(around before after))
      (check-exception ((service.descriptor-service-action (.get report instance) raw context void #f) context) TypeError?)
      (check-equal? consumed 1)
      (defvalues (_ _context retry) (action context))
      (check-equal? retry #f) (check-equal? consumed 2)
      (check-equal? (.get (service.infer-worker-service (list wrong) (lambda (_) (error "invalid declaration ran"))) status) 'no-solution)
      (check-equal? (.get (service.infer-worker-service
        (list selected `(Object ((run ,handler) (limit UInt) (jobs ,jobs)) closed))
        (lambda (_) (error "ambiguous declaration ran"))) status) 'ambiguous))
    (test-case "Object output satisfies a Record input without fabricating optional fields"
      (def handler '(Function (UInt) (Integer)))
      (def input `(Record ((run ,handler required) (limit Integer required) (audit Bool optional)) open))
      (def output `(Object ((limit UInt) (run ,handler)) closed))
      (def report (service.infer-descriptor-service (list input) (list output)
        (list (list [] (list input) (list input `(Function (,input) (,input)))))
        (lambda (worker) (values worker identity))))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) (list (list output)))
      (def consumed 0) (def context (.o approved: #t))
      (def action (service.descriptor-service-action (.get report instance) (.o run: abs limit: 4) context
        (lambda (subject)
          (set! consumed (1+ consumed))
          (check (not (.slot? (.get subject answer) 'audit)) => #t)
          (check-exception ((.get subject answer run) #f) TypeError?))))
      (defvalues (_ _context issue) (action context))
      (check-equal? issue #f) (check-equal? consumed 1)
      (check-exception
        ((service.descriptor-service-action (.get report instance) (.o run: abs limit: 4 audit: #f) context
          (lambda (_) (set! consumed (1+ consumed)))) context) TypeError?)
      (check-equal? consumed 1))
    (test-case "empty element witnesses prove singleton lists without merging carriers"
      (for-each (lambda (dead)
        (check (subtype-expression? (list 'List dead) 'Null) => #t)
        (check (subtype-expression? (list 'Pair 'UInt (list 'List dead)) '(Pair Integer Null)) => #t)
        (check (element? (expression-type (list 'List dead)) []) => #t)
        (check (eq? (validate (expression-type (list 'List dead)) []) []) => #t))
        '(Never (Enum) (Tuple Never) (Pair UInt Never)
          (Record ((disabled Never required)) closed) (Union Never (Enum))))
      ;; Empty containers and optional sentinels are inhabitants, not empty Types.
      (for-each (lambda (inhabited value)
        (check (subtype-expression? (list 'List inhabited) 'Null) => #f)
        (validate (expression-type (list 'List inhabited)) (list value))
        (check-exception (validate Null (list value)) TypeError?))
        '((Tuple) (List Never) (Map UInt <- Never) (Maybe Never) (OrFalse Never) (BytesN 0))
        (list #() [] (make-hash-table) (void) #f #u8()))
      (check (subtype-expression? '(List Never) 'Unit) => #f)
      (check (subtype-expression? '(List Never) '(Tuple)) => #f)
      (check (subtype-expression? '(Map UInt <- (List Never)) '(Map UInt <- Null)) => #f)
      (check (subtype-expression? '(Union (List Never)) '(Union Null)) => #f)
      (check-exception (subtype-expression? '(List Never) 'Null 1) (refusal 'exhausted)))
    (test-case "singleton handler pipelines retain source shapes and complete publication"
      (def handler '(Function (UInt) (Integer)))
      (def selected (list 'Pair handler '(List (Tuple Never))))
      (def events []) (def calls 0) (def consumed 0) (def observed #f)
      (def report (service.infer-single-handler-service
        (list (list 'Pair handler '(List (Tuple))) selected (list 'Pair handler '(Tuple)))
        (lambda (batch) (set! calls (1+ calls)) (values batch identity))
        (lambda (event) (set! events (cons event events)))))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) (list (list selected)))
      (def context (.o approved: #t))
      (def source (list abs))
      (def action (service.descriptor-service-action (.get report instance) source context
        (lambda (subject)
          (set! observed subject) (set! consumed (1+ consumed))
          (check-equal? ((car (.get subject answer)) -7) 7)
          (check-exception ((car (.get subject answer)) #f) TypeError?)
          (def next ((.get subject callback) (list abs)))
          (check-equal? (cdr next) [])
          (check-equal? ((car next) -8) 8)
          (check-exception ((.get subject callback) (list abs abs)) TypeError?))))
      (defvalues (evidence returned issue) (action context))
      (check-equal? issue #f) (check (eq? returned context) => #t)
      (check (eq? (.get evidence subject) observed) => #t)
      (check (eq? (car source) abs) => #t)
      (check-equal? calls 1) (check-equal? consumed 1)
      (check-equal? (reverse events) '(around before after))
      (check-exception
        ((service.descriptor-service-action (.get report instance) source context void #f) context) TypeError?)
      (check-equal? consumed 1)
      (defvalues (_ _context retried) (action context))
      (check-equal? retried #f) (check-equal? consumed 2)
      ;; Equivalent value sets retain distinct original candidate descriptors.
      (check-equal? (.get (service.infer-single-handler-service
        (list selected (list 'Pair handler 'Null)) (lambda (_) (error "ambiguous builder ran"))) status) 'ambiguous)
      (check-equal? (.get (service.infer-single-handler-service
        (list (list 'Pair handler '(List Bool))) (lambda (_) (error "failed builder ran"))) status) 'no-solution))
    (test-case "proper list inclusion checks every Pair head and the complete tail"
      (check (subtype-expression? 'Null '(List UInt)) => #t)
      (check (subtype-expression? '(Pair UInt Null) '(List Integer)) => #t)
      (check (subtype-expression? '(Pair UInt (Pair UInt (List UInt))) '(List Integer)) => #t)
      (check (subtype-expression? '(Pair Bool Null) '(List Integer)) => #f)
      (check (subtype-expression? '(Pair UInt Bool) '(List Integer)) => #f)
      (check (subtype-expression? '(Pair UInt (Tuple)) '(List Integer)) => #f)
      (check (subtype-expression? '(Tuple UInt) '(List Integer)) => #f)
      (check (subtype-expression? '(List UInt) '(Pair Integer (List Integer))) => #f)
      (check (subtype-expression? '(Map UInt <- Null) '(Map UInt <- (List UInt))) => #f)
      (check (subtype-expression? '(Union Null) '(Union (List UInt))) => #f)
      (check-exception (subtype-expression? '(Pair UInt Null) '(List UInt) 1) (refusal 'exhausted)))
    (test-case "nonempty handler batches share inference declarations and evidence publication"
      (def handler '(Function (UInt) (Integer)))
      (def output (list 'Pair handler (list 'List handler)))
