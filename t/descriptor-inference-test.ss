;;; Literal intrinsic descriptors share finite inference and qualified publication.
(export descriptor-inference-test)
(import (only-in ../number UInt Integer UInt256 JsInt) :std/test :std/error ../object ../mop ../type ../type-relation ../prototype-types
        (only-in ../optional-validation type-value-catalog)
        (only-in ../object-contract ObjectContract. refine)
        (only-in ../slot-observation call-with-slot-read-observer slot-read-receiver)
        (prefix-in ../examples/polymorphic-services service.))
;; Keep syntax/work refusal separate from a completed false judgment.
(def (refusal kind)
  (lambda (cause) (and (type-refusal? cause) (eq? (type-refusal-kind cause) kind))))
;; Boundary, containment, carrier identity and whole workflow have independent controls.
(def descriptor-inference-test
  (test-suite "Singleton width and byte descriptor inference"
    (test-case "proper list inclusion checks every Pair head and the complete tail"
      (check (subtype-expression? 'Null '(List UInt)) => #t)
      (check (subtype-expression? '(Pair UInt Null) '(List Integer)) => #t)
      (check (subtype-expression? '(Pair UInt (Pair UInt (List UInt))) '(List Integer)) => #t)
      (check (subtype-expression? '(Pair Bool Null) '(List Integer)) => #f)
      (check (subtype-expression? '(Pair UInt Bool) '(List Integer)) => #f)
      (check (subtype-expression? '(Pair UInt (Tuple)) '(List Integer)) => #f)
      (check (subtype-expression? '(Tuple UInt) '(List Integer)) => #f)
      (check (subtype-expression? '(List UInt) '(Pair Integer (List Integer))) => #f)
      (check (subtype-expression? '(Map UInt <- Null) '(Map UInt <- (List UInt))) => #f)
      (check (subtype-expression? '(Union Null) '(Union (List UInt))) => #f)
      (check-exception (subtype-expression? '(Pair UInt Null) '(List UInt) 1) (refusal 'exhausted)))
    (test-case "nonempty handler batches share inference declarations and evidence publication"
      (def handler '(Function (UInt) (Integer)))
      (def output (list 'Pair handler (list 'List handler)))
      (def events []) (def consumed 0) (def calls 0) (def observed #f)
      (def report (service.infer-handler-batch-service
        (list 'Null (list 'Tuple handler) output)
        (lambda (batch) (set! calls (1+ calls))
          (values (cons abs batch) (lambda (next) (cons abs next))))
        (lambda (event) (set! events (cons event events)))))
      (check-equal? (.get report status) 'unique)
      (def context (.o approved: #t))
      (def action (service.descriptor-service-action (.get report instance) [] context
        (lambda (subject)
          (set! observed subject)
          (set! consumed (1+ consumed))
          (check-equal? ((car (.get subject answer)) -5) 5)
          (check-exception ((car (.get subject answer)) #f) TypeError?)
          (def next ((.get subject callback) (list abs)))
          (check-equal? ((cadr next) -8) 8)
          (check-exception ((.get subject callback) (list #f)) TypeError?))))
      (defvalues (evidence returned issue) (action context))
      (check-equal? issue #f)
      (check (eq? returned context) => #t)
      (check (eq? (.get evidence subject) observed) => #t)
      (check-equal? (reverse events) '(around before after))
      (check-equal? calls 1) (check-equal? consumed 1)
      (check-exception
        ((service.descriptor-service-action (.get report instance) [] context void #f) context) TypeError?)
      (defvalues (_again _same retried) (action context))
      (check-equal? retried #f) (check-equal? consumed 2))
    (test-case "computed Class catalogs retain private identities and guarded normalization"
      (def record (expression-type '(Record ((run (Function (UInt) (Integer)) required) (limit UInt required)) closed)))
      (def selection (.o current: record))
      (def demanded 0)
      (def provider (.o
        (Account (begin (set! demanded (1+ demanded)) (.get selection current)))
        (Alias (.get selection current))))
      (depend-on-object! provider selection)
      (def directory (capture-type-catalog provider '(Account Alias)))
      (def account (agetq 'Account directory))
      (check (eq? account (agetq 'Alias directory)) => #t)
      (check-equal? demanded 1)
      (def descriptor (expression-type account))
      (def original (.o run: abs limit: 9))
      (def observed [])
      (def checked (call-with-slot-read-observer
        (lambda (read) (set! observed (cons (slot-read-receiver read) observed)))
        (lambda () (validate descriptor original))))
      (check (and (memq provider observed) (memq selection observed) #t) => #t)
      (check-equal? ((.get checked run) -3) 3)
      (check-exception ((.get checked run) #f) TypeError?)
      (check (eq? (.get original run) abs) => #t)
      (check (subtype-expression? account (agetq 'Alias directory)) => #t)
      (check (subtype-expression? account '(Record ((limit UInt required)) open)) => #f)
      (def separate (capture-type-catalog provider '(Account)))
      (check (subtype-expression? account (agetq 'Account separate)) => #f)
      (check-equal? demanded 1)
      (.setslot! selection current ($constant-slot-spec (expression-type '(Record ((run Bool required)) closed))))
      (check-exception (validate descriptor original) Error?)
      (check-exception (instantiate-prototype
        (prototype-type (.o .parameters: '(T)) '(T) 'T []) (list account)) Error?)
      (def fresh (agetq 'Account (capture-type-catalog provider '(Account))))
      (validate (expression-type fresh) (.o run: #f))
      (check-equal? demanded 2))
    (test-case "declared Slot source edits invalidate Class catalogs before old callbacks"
      (def slot (RecordSlot UInt))
      (def record (.cc Class. slots: (.o value: slot) sealed: #t))
      (def provider (.o Item: record))
      (def token (agetq 'Item (capture-type-catalog provider '(Item))))
      (def descriptor (expression-type token))
      (validate descriptor (.o value: 3))
      (.setslot! slot type ($constant-slot-spec Bool))
      (check-exception (validate descriptor (.o value: 3)) Error?)
      ;; Source edits refuse the old capture, rather than reinterpret its token.
      (def fresh (agetq 'Item (capture-type-catalog provider '(Item))))
      (validate (expression-type fresh) (.o value: #f)))
    (test-case "dynamic Schema publication preserves actual validators and explicit dependencies"
      (def policy (.o enabled: #t))
      (def record (expression-type '(Record ((run (Function (UInt) (Integer)) required) (limit UInt required)) closed)))
      (def schema (refine (.cc ObjectContract. extra-fields: 'delegate constraints: (list record))
        (lambda (_value path) (if (.get policy enabled) [] [(.o bind-these: #f kind: 'policy path: path)]))))
      (def provider (.o Account: record Policy: schema))
      (def directory (capture-type-catalog provider '(Account Policy) sources: (list policy)))
      (def account (agetq 'Account directory)) (def selected (agetq 'Policy directory))
      (def input (list 'TypeValuePair account selected))
      (def output (list 'TypeValuePair selected))
      (def events []) (def calls 0) (def consumed 0)
      ;; The operation deliberately constructs a schema-tagged result; the
      ;; inference judgment itself never coerces Account into Policy.
      (def (operation value)
        (set! calls (1+ calls))
        (values (cons schema (cdr value)) (lambda (next) (cons schema (cdr next)))))
      (def observations (list (list [] (list input) (list output `(Function (,output) (,input))))))
      (def report (service.infer-descriptor-service (list input)
        (list (list 'TypeValuePair account) output) observations operation
        (lambda (event) (set! events (cons event events)))))
      (check-equal? (.get report status) 'unique)
      (def instance (.get report instance))
      (def context (.o approved: #t))
      (def raw (.o run: abs limit: 8))
      (def observed #f)
      (def action (service.descriptor-service-action instance (cons record raw) context
        (lambda (subject) (set! observed subject) (set! consumed (1+ consumed)))))
      (defvalues (evidence next issue) (action context))
      (check-equal? issue #f)
      (check (eq? next context) => #t)
      (check (eq? (.get evidence subject) observed) => #t)
      (check (eq? (car (.get observed answer)) schema) => #t)
      (check-equal? ((.get (cdr (.get observed answer)) run) -4) 4)
      (check-exception ((.get (cdr (.get observed answer)) run) #f) TypeError?)
      (check-equal? (reverse events) '(around before after))
      (check-equal? calls 1)
      (.setslot! policy enabled ($constant-slot-spec #f))
      (check-exception (action context) Error?)
      (check-equal? calls 1) (check-equal? consumed 1)
      (check-exception (service.infer-descriptor-service (list input) (list output)
        observations operation) Error?)
      (def renewed (capture-type-catalog provider '(Account Policy) sources: (list policy)))
      (def checked-schema (expression-type (agetq 'Policy renewed)))
      (check-exception (validate checked-schema raw) TypeError?)
      (.setslot! policy enabled ($constant-slot-spec #t))
      (def current (capture-type-catalog provider '(Policy) sources: (list policy)))
      (validate (expression-type (agetq 'Policy current)) raw)
      (def renewed-report (service.infer-schema-service provider '(Account Policy) 'Policy
        operation sources: (list policy)))
      (check-equal? (.get renewed-report status) 'unique)
      (defvalues (_ _next retried)
        ((service.descriptor-service-action (.get renewed-report instance) (cons record raw) context
           (lambda (_) (set! consumed (1+ consumed)))) context))
      (check-equal? retried #f)
      (check-equal? calls 2) (check-equal? consumed 2))
    (test-case "opaque Schema callback errors survive guarded compilation"
      (def schema (.o sexp: 'schema .element?: object?
        .validate: (lambda (_) (error "schema payload failure"))))
      (def token (agetq 'Schema (capture-type-catalog (.o Schema: schema) '(Schema))))
      (check-exception (expression-type token 1) (refusal 'exhausted))
      (check-exception (validate (expression-type token) (.o))
        (lambda (cause) (and (Error? cause) (equal? (error-message cause) "schema payload failure")))))
    (test-case "capture refusal and work exhaustion never publish a partial catalog"
      (check-exception (capture-type-catalog (.o Bad: 3) '(Bad)) TypeError?)
      (check-exception (capture-type-catalog (.o Good: UInt) '(Good Missing)) NoApplicableMethod?)
      (check-exception (capture-type-catalog (.o Good: UInt) '(Good Good)) Error?)
      (check-exception (capture-type-catalog (.o Good: UInt) '(Good) 1) (refusal 'exhausted))
      (def source (.o version: 0))
      (def provider (.o
        (First (begin (.get source version) UInt))
        (Second (begin (.setslot! source version ($constant-slot-spec 1)) Bool))))
      (check-exception (capture-type-catalog provider '(First Second)) Error?))
    (test-case "dependent catalogs compare identities rather than payload subtyping"
      (check (subtype-expression? '(TypeValuePair UInt) '(TypeValuePair Bool UInt)) => #t)
      (check (subtype-expression? '(TypeValuePair UInt) '(TypeValuePair Integer)) => #f)
      (check (subtype-expression? '(TypeValuePair) '(TypeValuePair UInt)) => #t)
      (check (subtype-expression? '(TypeValuePair UInt) '(TypeValuePair)) => #f)
      (check (subtype-expression? '(Map UInt <- (TypeValuePair UInt Bool))
        '(Map UInt <- (TypeValuePair Bool UInt))) => #f)
      (for-each (lambda (term) (check-exception (expression-type term) (refusal 'unsupported)))
        '((TypeValuePair Any) (TypeValuePair Never) (TypeValuePair UInt UInt)
          (TypeValuePair (UIntN 8)) (TypeValuePair (Function (UInt) (UInt))) (TypeValuePair Missing)))
      (check-exception (expression-type '(TypeValuePair UInt Bool) 1) (refusal 'exhausted))
      (check-exception (prototype-type (.o .parameters: '(TypeValuePair)) '(TypeValuePair) 'UInt [])
        (refusal 'malformed)))
    (test-case "typed-value outer pairs preserve keyword and escape transport boundaries"
      (check (function-covers?
        '(Function (UInt) ((TypeValuePair UInt Bool)) keywords: ((mode: . UInt)))
        '(Function (UInt) ((TypeValuePair UInt)))) => #t)
      (check (function-covers?
        '(Function (UInt) ((TypeValuePair Keyword)) keywords: ((mode: . UInt)))
        '(Function (UInt) ((TypeValuePair Keyword)))) => #t)
      (def checked (validate
        (expression-type '(Function (UInt) ((TypeValuePair Keyword)) keywords: ((mode: . UInt))))
        (lambda (value mode: (mode 7)) (if (keyword? (cdr value)) mode 0))))
      (check-equal? (checked (cons Keyword mode:)) 7)
      (check-exception (checked (cons Keyword #!key)) TypeError?)
      (check-exception (checked mode:) TypeError?))
    (test-case "catalog admission preserves carried identity and refuses forged descriptors"
      (def descriptor (expression-type '(TypeValuePair UInt Bool Null)))
      (def source (cons Bool #f))
      (check (eq? (validate descriptor source) source) => #t)
      (validate descriptor (cons Null []))
      (check-exception (validate descriptor (cons UInt -1)) TypeError?)
      (check-exception (validate descriptor (cons Integer 3)) TypeError?)
      (check-exception (validate descriptor (cons 'UInt 3)) TypeError?)
      (def calls 0)
      (def forged (.cc UInt .element?: (lambda (_) (set! calls (1+ calls)) #t)))
      (check-exception (validate descriptor (cons forged 3)) TypeError?)
      (check-equal? calls 0)
      (check-exception (validate (expression-type '(TypeValuePair)) source) TypeError?))
    (test-case "explicit catalog reuses dependent Function wrapping and inherited source invalidation"
      (def parent (.cc Type. .element?: exact-integer?))
      (def child (.o inherit: [parent]))
      (def callback (expression-type '(Function (UInt) (Integer))))
      (def types (list child callback))
      (def descriptor (type-value-catalog TypeValuePair types 'private-catalog))
      (set-car! types Type.)
      (check-exception (validate descriptor (cons Type. 1)) TypeError?)
      (def source (cons callback abs))
      (def checked (validate descriptor source))
      (check (eq? (car checked) callback) => #t)
      (check-equal? ((cdr checked) -3) 3)
      (check-exception ((cdr checked) #f) TypeError?)
      (check (eq? (cdr source) abs) => #t)
      (def observed [])
      (call-with-slot-read-observer
        (lambda (read) (set! observed (cons (slot-read-receiver read) observed)))
        (lambda () (validate descriptor (cons child 1))))
      (check (and (memq child observed) #t) => #t)
      (check (and (memq callback observed) #t) => #t)
      (.setslot! parent .element? ($constant-slot-spec string?))
      (check-exception (validate descriptor (cons child 1))
        (lambda (cause) (and (Error? cause) (equal? (error-message cause) "stale slot dependency"))))
      (def fresh (type-value-catalog TypeValuePair (list child callback) 'private-catalog))
      (validate fresh (cons child "renewed"))
      (check-exception (validate fresh (cons child 1)) TypeError?))
    (test-case "Null and Unit preserve distinct carriers and sentinel semantics"
      (for-each (lambda (name value)
        (check (eq? (expression-type name) (if (eq? name 'Null) Null Unit)) => #t)
        (check (eq? (validate (expression-type name) value) value) => #t)
        (check (subtype-expression? name `(Union (Exactly #f) ,name)) => #t)
        (check (subtype-expression? name '(Union Bool String)) => #f)) '(Null Unit) (list [] (void)))
      (check (subtype-expression? 'Null '(Tuple)) => #f)
      (check (subtype-expression? '(Tuple) 'Null) => #f)
      (check-exception (validate (expression-type '(Tuple)) []) TypeError?)
      (check-exception (validate Null #()) TypeError?)
      (check (subtype-expression? 'Unit '(Maybe (UIntN 8))) => #t)
      (check (subtype-expression? 'Null '(Maybe Null)) => #t)
      (check (subtype-expression? 'Null '(OrFalse Null)) => #t)
      (check (subtype-expression? 'Unit 'Null) => #f)
      (check (subtype-expression? 'Null 'Unit) => #f)
      (check-exception (validate Unit []) TypeError?)
      (check-exception (validate Null (void)) TypeError?)
      (check (subtype-expression? '(Map UInt <- Null) '(Map UInt <- (Tuple))) => #f))
    (test-case "typed-value catalogs complete inference declarations refinement and exact evidence"
      (def input '(TypeValuePair UInt Bool String))
      (def output '(TypeValuePair UInt))
      (def events []) (def calls 0) (def callbacks 0) (def consumed 0)
      ;; Explicit application meaning converts heterogeneous values; readable
      ;; catalog replacement itself never rewrites a carried descriptor token.
      (def (size value)
        (cons UInt (cond ((eq? (car value) UInt) (cdr value))
                        ((eq? (car value) Bool) (if (cdr value) 1 0))
                        (else (string-length (cdr value))))))
      (def report (service.infer-type-value-service
        '((TypeValuePair Bool) (TypeValuePair UInt))
        (list (list [] (list input) (list output `(Function (,output) (,input)))))
        (lambda (value) (set! calls (1+ calls))
          (values (size value) (lambda (next) (set! callbacks (1+ callbacks)) (size next))))
        (lambda (event) (set! events (cons event events)))))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) '(((TypeValuePair UInt))))
      (def instance (.get report instance))
      (def context (.o approved: #t))
      (def observed #f)
      ;; The shared publication action gives IO only the refined wrapped result.
      (def action (service.descriptor-service-action instance (cons Bool #f) context
        (lambda (subject) (set! consumed (1+ consumed)) (set! observed subject))))
      (defvalues (evidence next issue) (action context))
      (check-equal? issue #f)
      (check (eq? next context) => #t)
      (check (eq? (.get evidence subject) observed) => #t)
      (check (eq? (.get evidence context) context) => #t)
      (check-equal? (.get observed answer) (cons UInt 0))
      (check-equal? (reverse events) '(around before after))
      (def callback (.get observed callback))
      (check-equal? (callback (cons String "port")) (cons UInt 4))
      (check-exception (callback (cons Integer 1)) TypeError?)
      (check-exception (callback (cons UInt -1)) TypeError?)
      (check-equal? callbacks 1)
      (check-exception ((service.descriptor-service-action instance (cons Bool #f) context void #f) context) TypeError?)
      (check-equal? consumed 1)
      (defvalues (_ _next retried) (action context))
      (check-equal? retried #f) (check-equal? consumed 2)
      (check-equal? calls 3)
      (check-equal? (.get (service.infer-type-value-service
        '((TypeValuePair UInt Bool) (TypeValuePair Bool UInt))
        (list (list [] (list input) #f)) (lambda (_) (error "must not invoke"))) status) 'ambiguous)
      (check-equal? (.get (service.infer-type-value-service '((TypeValuePair Bool))
        (list (list [] (list input) (list output `(Function (,output) (,input)))))
        (lambda (_) (error "must not invoke"))) status) 'no-solution))
    (test-case "fixed integer inclusion and literal membership reuse intervals"
      (for-each (lambda (bits)
        (def unsigned (list 'UIntN bits)) (def signed (list 'IntN (1+ bits)))
        (def maximum (1- (arithmetic-shift 1 bits)))
        (check (subtype-expression? unsigned signed) => #t)
        (check (subtype-expression? signed unsigned) => #f)
        (check (subtype-expression? unsigned 'UInt) => #t)
        (check (subtype-expression? unsigned `(IntegerRange min: 0 max: ,maximum)) => #t)
        (check (subtype-expression? `(Exactly ,maximum) unsigned) => #t)
        (check (subtype-expression? `(Exactly ,(1+ maximum)) unsigned) => #f)
        (def descriptor (expression-type unsigned))
        (check-equal? (.get descriptor sexp) unsigned)
        (validate descriptor 0) (validate descriptor maximum)
        (check-exception (validate descriptor -1) TypeError?)
        (check-exception (validate descriptor (1+ maximum)) TypeError?)) '(0 1 7 8 31 255))
      (check (subtype-expression? '(UIntN 0) '(Enum 0)) => #t)
      (check (subtype-expression? '(IntN 8) '(Union (IntegerRange max: -1) (UIntN 7))) => #t)
      (check (subtype-expression? '(IntN 8) '(Union (IntegerRange max: -2) (UIntN 7))) => #f)
      (validate (expression-type '(IntN 8)) -128)
      (check-exception (validate (expression-type '(IntN 8)) -129) TypeError?)
      (check (subtype-expression? '(Map UInt <- (UIntN 8)) '(Map UInt <- (IntegerRange min: 0 max: 255))) => #f))
    (test-case "small width oracle independently enumerates membership"
      (for-each (lambda (left)
        (for-each (lambda (right)
          (def source (expression-type left)) (def target (expression-type right))
          (check-equal? (subtype-expression? left right)
            (andmap (lambda (value) (or (not (element? source value)) (element? target value)))
              '(-17 -16 -9 -8 -7 -4 -3 -2 -1 0 1 2 3 4 7 8 9 15 16))))
          '((UIntN 0) (UIntN 1) (UIntN 3) (IntN 1) (IntN 3) (IntN 5))))
        '((UIntN 0) (UIntN 1) (UIntN 3) (IntN 1) (IntN 3) (IntN 5))))
    (test-case "byte carriers retain length and mutable value identity"
      (for-each (lambda (length)
        (def term (list 'BytesN length)) (def bytes (make-u8vector length 7))
        (check (subtype-expression? term 'Bytes) => #t)
        (check (subtype-expression? 'Bytes term) => #f)
        (check (subtype-expression? term `(Union Null (BytesN ,length))) => #t)
        (check (subtype-expression? term `(Union Null (BytesN ,(1+ length)))) => #f)
        (check (eq? (validate (expression-type term) bytes) bytes) => #t)
        (check-exception (validate (expression-type term) (make-u8vector (1+ length))) TypeError?)) '(0 1 32 64))
      (check (subtype-expression? 'Bytes '(Union (BytesN 0) (BytesN 1))) => #f)
      (check (subtype-expression? 'Bytes '(Union Null Bytes)) => #t)
      (check (subtype-expression? '(BytesN 0) 'Null) => #f)
      (check (subtype-expression? '(UIntN 8) 'Bytes) => #f)
      (check (subtype-expression? '(BytesN 1) '(UIntN 8)) => #f)
      (check (subtype-expression? 'Bytes '(Union Bytes (Function (UInt) (UInt)))) => #f))
    (test-case "existing named aliases reuse their descriptors without key collapse"
      (for-each (lambda (name width descriptor)
        (check (eq? (expression-type name) descriptor) => #t)
        (check (subtype-expression? name width) => #t)
        (check (subtype-expression? width name) => #t)
        (check (subtype-expression? `(Map UInt <- ,name) `(Map UInt <- ,width)) => #f)
        (check-equal? (normalize-type name (type-work 1000)) name))
        '(UInt256 JsInt Bytes32 Bytes64)
        '((UIntN 256) (IntN 54) (BytesN 32) (BytesN 64))
        (list UInt256 JsInt Bytes32 Bytes64)))
    (test-case "metadata remains literal bounded captured and distinct"
      (for-each (lambda (term) (check-exception (expression-type term) (refusal 'malformed)))
        '((UIntN -1) (IntN 0) (BytesN -1) (UIntN 1.5) (UIntN 8 9) (BytesN)))
      (for-each (lambda (term) (check-exception (expression-type term) (refusal 'unsupported)))
        '((UIntN 4097) (IntN 4097) (BytesN 65537)))
      (check-exception (expression-type '(BytesN 65536) 30) (refusal 'exhausted))
      (expression-type '(UIntN 4096)) (expression-type '(IntN 4096)) (expression-type '(BytesN 65536))
      (check-exception (expression-type '(Union Unit Unknown)) (refusal 'unsupported))
      (check-exception (expression-type '(UIntN Width)) (refusal 'malformed))
      (check-equal? (substitute-type '(Pair (UIntN 8) (BytesN 32)) '((Width . 16)) (type-work 1000))
        '(Pair (UIntN 8) (BytesN 32))))
    (test-case "descriptor choices pass prefix inference qualifiers refine and evidence"
      (for-each (lambda (input candidates observed value operation bad)
        (def events []) (def calls 0) (def consumed 0)
        (def report (service.infer-descriptor-service (list input) candidates
          (list (list [] (list input) (list observed `(Function (,observed) (,input)))))
          (lambda (n) (values (operation n) (lambda (x) (set! calls (1+ calls)) (operation x))))
          (lambda (event) (set! events (cons event events)))))
        (check-equal? (.get report status) 'unique)
        (check-equal? (.get report solutions) (list (list observed)))
        (def context (.o approved: #t)) (def callback #f)
        ;; IO consumes only the refined result; its callback remains recursively wrapped.
        (def (consume subject) (set! consumed (1+ consumed)) (set! callback (.get subject callback)))
        (def action (service.descriptor-service-action (.get report instance) value context consume))
        (defvalues (evidence next failure) (action context))
        (check-equal? failure #f) (check (eq? (.get evidence context) context) => #t)
        (check-equal? (reverse events) '(around before after))
        (callback value) (check-equal? calls 1)
        (check-exception (callback bad) TypeError?) (check-equal? calls 1)
        ;; An accepted broad input may still produce a narrow-result failure;
        ;; retain its body effect and reject the output instead of truncating it.
        (cond ((eq? input 'Bytes)
               (check-exception (callback (make-u8vector 16)) TypeError?)
               (check-equal? calls 2))
              ((equal? input '(IntN 9))
               (check-exception (callback -256) TypeError?)
               (check-equal? calls 2)))
        (check-exception ((service.descriptor-service-action (.get report instance) value context consume #f) context) TypeError?)
        (check-equal? consumed 1)
        (defvalues (_ _context retried) (action context))
        (check-equal? retried #f) (check-equal? consumed 2))
        '(Null Unit (IntN 9) Bytes)
        '((Unit Null) (Null Unit) ((UIntN 8) (UIntN 9)) ((BytesN 16) (BytesN 32)))
        '(Null Unit (UIntN 8) (BytesN 32))
        (list [] (void) -7 (make-u8vector 32 7))
        (list identity identity abs identity)
        (list (void) [] 256 #f)))
    (test-case "nonunique and failed descriptor inference never build declarations"
      (check-equal? (.get (service.infer-descriptor-service '(Bytes) '((BytesN 16) (BytesN 32))
        '((() (Bytes) #f)) (lambda (_) (error "unexpected invocation"))) status) 'ambiguous)
      (check-equal? (.get (service.infer-descriptor-service '(Null) '(Unit) '((() (Null) #f))
        (lambda (_) (error "unexpected invocation"))) status) 'no-solution))))
