;;; Scheme-native bounded process supervision and JSON performance receipts.
(export main)
(import :gerbil/runtime/gambit :std/iter :std/misc/process :std/misc/ports
        :std/encoding/json :std/encoding/hex :std/crypto/digest :std/string/misc)

(def (record . fields)
  (let ((table (make-hash-table)))
    (let loop ((fields fields))
      (unless (null? fields)
        (hash-put! table (car fields) (cadr fields)) (loop (cddr fields))))
    table))
(def (file-sha path)
  (hex-encode (sha256 (call-with-input-file path read-all-as-u8vector))))
(def (parse-row text row)
  (for (field (string-split (string-trim text) #\space))
    (let ((equal (string-index field #\=)))
      (when equal
        (let* ((key (substring field 0 equal)) (value (substring field (+ equal 1) (string-length field))))
          (hash-put! row key (cond ((equal? value "#t") "true") ((equal? value "#f") "false")
                                  (else (or (string->number value) value))))))))
  row)
(def (save-receipt output receipt rows)
  (hash-put! receipt "rows" (reverse rows))
  (call-with-output-file (list path: output truncate: #t)
    (lambda (port) (write-json port receipt) (newline port))))

(def (main binary timeout output (runtime "scheme") (source-root "."))
  (unless (member runtime '("scheme" "lean")) (error "runtime" runtime))
  (let* ((sources (record)) (rows '()) (failures 0)
         (receipt (record "schema" 3 "runtime" runtime
                    "toolchain" (if (equal? runtime "lean")
                       (string-trim (run-process '("lake" "env" "lean" "--version") directory: source-root))
                       (list (gerbil-version-string) (system-version-string)))
                    "source_base" (string-trim (run-process '("git" "rev-parse" "HEAD") directory: source-root))
                    "platform" (string-trim (run-process '("uname" "-srm")))
                    "driver_sha256" (file-sha "t/closure-suite.ss") "binary_sha256" (file-sha binary) "source_sha256" sources
                    "deadline_seconds" 20 "heap_limit" (if (equal? runtime "scheme") "1G" "not-configured") "trials" 4 "order_policy" "rotate_by_trial"
                    "policy" (record "copy" 4 "suspend" 16 "resume" 16 "decision" 1))))
    (for (path (if (equal? runtime "lean")
                   '("LeanPoo/Functional/QueueSelection.lean" "LeanPoo/Functional/HybridClosure.lean" "LeanPoo/Functional/ClosureScenarios.lean"
                     "LeanPoo/Functional/IncrementalClosure.lean" "LeanPoo/Functional/ChunkedClosure.lean"
                     "LeanPoo/Functional/ClosureCosts.lean" "Benchmarks/HybridClosureScale.lean")
                   '("closure.ss" "t/closure-scale-benchmark.ss" "t/closure-suite.ss" "t/closure-report.ss" "t/closure-parity.ss")))
      (hash-put! sources path (file-sha (string-append source-root "/" path))))
    (for* ((spec '(("diamond" 256 16) ("diamond" 1024 16) ("dense" 64 16) ("dense" 256 16)
                  ("ring" 1024 16) ("skewed" 128 64) ("gated" 1024 16) ("quorum" 256 16)
                  ("hubchain" 1024 16) ("bursts" 1024 16)))
           (seed '("true" "false")) (scope '("cold" "warm")) (trial (in-range 4))
           (position (in-range 4)))
      (let* ((queue (list-ref '("append" "chunked" "hybrid" "auto") (modulo (+ trial position) 4)))
             (family (car spec)) (size (cadr spec)) (width (caddr spec))
             (repetitions (if (equal? scope "cold") 5 400))
             (row (record "family" family "n" size "width" width "seed" seed "scope" scope
                          "trial" trial "execution_order" position "queue" queue "state" "owned"))
             (started (time->seconds (current-time))) (status 0))
        (try
          (let ((text (run-process
                        (append (list timeout "--signal=TERM" "--kill-after=3s" "20s" binary)
                          (if (equal? runtime "lean")
                            (list queue family (number->string size) (number->string width) seed scope)
                            (list "-:max-heap=1G" queue "owned" family (number->string size)
                                  (number->string width) seed (number->string repetitions) scope)))
                        stdin-redirection: #f stderr-redirection: #t
                        check-status: (lambda (result _) (set! status result)))))
            (hash-put! row "stdout" text)
            (hash-put! row "process_status" status)
            (hash-put! row "status" (cond ((= status 0) "pass") ((= status (* 124 256)) "timeout") (else "failed")))
            (when (= status 0)
              (parse-row text row)
              (unless (equal? (hash-get row "oracle_parity") "true") (hash-put! row "status" "failed_oracle_receipt"))))
          (catch (exception)
            (hash-put! row "status" "launch_error") (hash-put! row "error" (object->string exception))))
        (hash-put! row "process_wall_seconds" (- (time->seconds (current-time)) started))
        (unless (equal? (hash-get row "status") "pass") (set! failures (+ failures 1)))
        (set! rows (cons row rows))
        (save-receipt output receipt rows)
        (displayln family "/" size "/" seed "/" scope "/" trial "/" queue ": " (hash-get row "status"))
        (force-output)))
    (unless (= failures 0) (error "nonpassing benchmark rows retained" failures output))
    (displayln "CLOSURE-NATIVE-SUITE-OK rows=" (length rows))))
