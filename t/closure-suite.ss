;;; Four rotated independent processes per case; checkpoint every outcome.
(export main)
(import :gerbil/runtime/gambit :std/iter :std/misc/process :std/string/misc
        "closure-benchmark-support.ss")
(def cases '(("diamond" 256 16) ("diamond" 1024 16) ("dense" 64 16) ("dense" 256 16)
             ("ring" 1024 16) ("skewed" 128 64) ("gated" 1024 16) ("quorum" 256 16)
             ("hubchain" 1024 16) ("bursts" 1024 16)))
(def queues '("append" "chunked" "hybrid" "auto"))
(def (main binary timeout output (runtime "scheme") (source-root "."))
  (unless (member runtime '("scheme" "lean")) (error "runtime" runtime))
  (def sources (if (equal? runtime "lean")
                 '("LeanPoo/Functional/ClosureLifecycle.lean" "LeanPoo/Functional/QueueSelection.lean"
                   "LeanPoo/Functional/HybridClosure.lean" "LeanPoo/Functional/ClosureScenarios.lean"
                   "LeanPoo/Functional/IncrementalClosure.lean" "LeanPoo/Functional/ChunkedClosure.lean"
                   "LeanPoo/Functional/ClosureCosts.lean" "Benchmarks/HybridClosureScale.lean")
                 '("closure.ss" "t/closure-scale-benchmark.ss" "t/closure-suite.ss"
                   "t/closure-benchmark-support.ss" "t/closure-report.ss" "t/closure-parity.ss")))
  (def receipt
    (hash ("schema" 4) ("runtime" runtime)
          ("toolchain" (if (equal? runtime "lean")
                         (string-trim (run-process '("lake" "env" "lean" "--version") directory: source-root))
                         (list (gerbil-version-string) (system-version-string))))
          ("source_base" (string-trim (run-process '("git" "rev-parse" "HEAD") directory: source-root)))
          ("platform" (string-trim (run-process '("uname" "-srm"))))
          ("driver_sha256" (file-sha "t/closure-suite.ss")) ("binary_sha256" (file-sha binary))
          ("source_sha256" (source-digests sources source-root))
          ("deadline_seconds" 20) ("heap_limit" (if (equal? runtime "scheme") "1G" "not-configured"))
          ("trials" 4) ("order_policy" "rotate_by_trial")
          ("policy" (hash ("copy" 4) ("suspend" 16) ("resume" 16) ("decision" 1)))))
  (def rows [])
  (for* ((spec cases) (seed '("true" "false")) (scope '("cold" "warm" "refresh"))
         (trial (in-range 4)) (position (in-range 4)))
    (match spec ([family size width]
      (def queue (list-ref queues (modulo (+ trial position) 4)))
      (def repetitions (if (equal? scope "warm") 400 5))
      (def row (hash ("family" family) ("n" size) ("width" width) ("seed" seed) ("scope" scope)
                    ("trial" trial) ("execution_order" position) ("queue" queue) ("state" "owned")))
      (def started (time->seconds (current-time)))
      (merge! row (run-bounded timeout
                   (if (equal? runtime "lean")
                     (list binary queue family (number->string size) (number->string width) seed scope)
                     (list binary "-:max-heap=1G" queue "owned" family (number->string size)
                           (number->string width) seed (number->string repetitions) scope))))
      (when (equal? (hash-ref row "status") "pass")
        (parse-metrics! (hash-ref row "stdout") row)
        (unless (eq? (hash-get row "oracle_parity") #t) (hash-put! row "status" "failed_oracle_receipt")))
      (hash-put! row "process_wall_seconds" (- (time->seconds (current-time)) started))
      (set! rows (cons row rows))
      (hash-put! receipt "rows" (reverse rows))
      (write-receipt output receipt)
      (displayln family "/" size "/" seed "/" scope "/" trial "/" queue ": " (hash-ref row "status"))
      (force-output))))
  (unless (andmap (lambda (row) (equal? (hash-ref row "status") "pass")) rows)
    (error "nonpassing benchmark rows retained" output))
  (displayln "CLOSURE-NATIVE-SUITE-OK rows=" (length rows)))
