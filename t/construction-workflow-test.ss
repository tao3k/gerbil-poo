(export construction-workflow-test)
(import :std/test :std/iter (only-in :std/values first-value) ../object ../support/option
        (prefix-in ../examples/construction-workflow workflow.) (prefix-in ../examples/service-bundle bundle.)
        (prefix-in ../examples/shared-contracts shared.)
        (prefix-in ../contract-family contracts.) (prefix-in ../staged-publication staged.)
        (prefix-in ../examples/protected-dispatch protected.) (prefix-in ../dependency-analysis code.)
        (prefix-in ../generalized-graph graph.) (prefix-in ../construction-cache cache.)
        (prefix-in ../cyclic-publication publication.) (prefix-in ../dispatch-extension dispatch.)
        (prefix-in ../multimethod multimethod.))
(def policy (.cc bundle.Policy. capacity: 0 price: 3 invoice: "unused"))
(def (size version key) (multimethod.cache-size (dispatch.snapshot (publication.version-service version key))))
(def construction-workflow-test
  (test-suite "selective shared settlement and cross-service publication"
    (test-case "planned multi-level revisions keep current meaning and warm approvals"
      (def model shared.planned-workflow-model)
      (defvalues (old issue) (staged.prepare model (workflow.graph 30) policy))
      (check-equal? issue #f)
      (defvalues (_ warm) (publication.invoke old 'reserve 2))
      (def revised (graph.define (publication.version-source warm) 'invoice (code.need 'settlement (cut + <> 9))))
      (defvalues (next issue2) (staged.publish model warm revised policy))
      (check-equal? issue2 #f)
      (check-equal? (cache.cache-evaluated (publication.version-cache next)) '(invoice release total))
      (check-equal? (length (cache.cache-reused (publication.version-cache next))) 12)
      (check-equal? (contracts.family-preparation (publication.version-contract-family next)) 'direct)
      (defvalues (value joint-warm) (publication.invoke next 'reserve 2))
      (check-equal? value '(ok 39 #t))
      (defvalues (priced issue3) (staged.publish model joint-warm (publication.version-source next) (.cc policy price: 4)))
      (check-equal? issue3 #f)
      (check-equal? (contracts.family-built (publication.version-contract-family priced)) [])
      (check-equal? (size priced 'reserve) 1)
      (check-equal? (first-value (publication.invoke priced 'cancel "customer" #t)) '("customer" "invoice:33"))
      (defvalues (refused failure) (staged.publish model priced (publication.version-source priced) (.cc policy cache-limit: 0)))
      (check (eq? refused priced) => #t)
      (check-equal? (publication.failure-stage failure) 'admission))
    (test-case "shared settlement revisions specialize two contracts atomically"
      (def model shared.workflow-model)
      (defvalues (old issue) (staged.prepare model (workflow.graph 30) policy))
      (check-equal? issue #f)
      (defvalues (_ warm) (publication.invoke old 'reserve 2))
      (def changed (graph.define (publication.version-source warm) 'invoice (code.need 'settlement (cut + <> 9))))
      (defvalues (next accepted) (staged.publish model warm changed policy))
      (check-equal? accepted #f)
      (check-equal? (cache.cache-evaluated (publication.version-cache next)) '(invoice release total))
      (check-equal? (length (cache.cache-reused (publication.version-cache next))) 12)
      (def descriptors (publication.version-contract-family next))
      (check-equal? (contracts.family-preparation descriptors) 'direct)
      (check-equal? (contracts.family-built descriptors) '(reserve cancel))
      (check-equal? (contracts.family-bound descriptors) '(reserve cancel))
      (defvalues (reserved joint-warm) (publication.invoke next 'reserve 2))
      (check-equal? reserved '(ok 39 #t))
      (check-equal? (first-value (publication.invoke next 'cancel "customer" #t)) '("customer" "invoice:33"))
      (defvalues (repriced accepted2) (staged.publish model joint-warm (publication.version-source joint-warm) (.cc policy price: 4)))
      (check-equal? accepted2 #f)
      (check-equal? (cache.cache-evaluated (publication.version-cache repriced)) [])
      (check-equal? (contracts.family-preparation (publication.version-contract-family repriced)) 'retained)
      (check-equal? (contracts.family-built (publication.version-contract-family repriced)) [])
      (for (key '(reserve cancel))
        (check (eq? (publication.version-contract-invoker repriced key) (publication.version-contract-invoker joint-warm key)) => #t))
      (check-equal? (size repriced 'reserve) 1)
      (defvalues (refused failure) (staged.publish model joint-warm (publication.version-source joint-warm) (.cc policy cache-limit: 0)))
      (check (eq? refused joint-warm) => #t)
      (check (eq? (publication.version-cache refused) (publication.version-cache joint-warm)) => #t)
      (check-equal? (publication.failure-stage failure) 'admission))
    (test-case "selective builders and fresh captures across services"
      (defvalues (old issue) (workflow.start (workflow.graph 30) policy))
      (check-equal? issue #f)
      (check-equal? (length (cache.cache-evaluated (publication.version-cache old))) 15)
      (check-equal? (workflow.value (publication.version-cache old) 'total) 32)
      (defvalues (reserved warm) (publication.invoke old 'reserve 2))
      (check-equal? reserved '(ok 30 #t))
      (check (eq? (publication.version-cache warm) (publication.version-cache old)) => #t)
      (def changed (graph.define (publication.version-source warm) 'invoice (code.need 'settlement (cut + <> 9))))
      (defvalues (next accepted) (workflow.revise warm changed policy (.cc cache.Builder. allow: (cut memq <> '(invoice release total)))))
      (check-equal? accepted #f)
      (def materialized (publication.version-cache next))
      (check-equal? (cache.cache-evaluated materialized) '(invoice release total))
      (check-equal? (length (cache.cache-reused materialized)) 12)
      (check (eq? (cache.cache-ref materialized 'settlement) (cache.cache-ref (publication.version-cache warm) 'settlement)) => #t)
      (check-equal? (first-value (publication.invoke next 'reserve 2)) '(ok 39 #t))
      (check-equal? (first-value (publication.invoke next 'cancel "customer" #t)) '("customer" "invoice:33"))
      (check-equal? (first-value (publication.invoke next 'quote protected.invoice protected.bank 150)) '(191))
      (check-equal? (map (cut size next <>) '(quote reserve cancel)) '(0 0 0))
      (defvalues (repriced issue2) (workflow.revise next (publication.version-source next) (.cc policy price: 4) (.cc cache.Builder. allow: (lambda (_) #f))))
      (check-equal? issue2 #f)
      (check-equal? (cache.cache-evaluated (publication.version-cache repriced)) [])
      (check-equal? (first-value (publication.invoke repriced 'quote protected.invoice protected.card 10)) '(13 14))
      (defvalues (larger issue3) (workflow.revise next (graph.set-base (publication.version-source next) 'input (some (code.make-success 60))) policy))
      (check-equal? issue3 #f)
      (check-equal? (length (cache.cache-evaluated (publication.version-cache larger))) 11)
      (check-equal? (length (cache.cache-reused (publication.version-cache larger))) 4)
      (check-equal? (workflow.value (publication.version-cache larger) 'total) 67))
    (test-case "all refusal stages retain the original cache and warm services"
      (defvalues (old issue) (workflow.start (workflow.graph 30) policy))
      (defvalues (value warm) (publication.invoke old 'reserve 2))
      (def source (publication.version-source warm))
      (for ((changed (list source (graph.define source 'invoice (code.need 'settlement (cut + <> 9)))
                          (graph.set-base source 'blocked (some (code.make-success 1)))
                          (graph.define source 'invoice (code.need 'total identity)) source))
            (selected-policy (list (.cc policy forbidden-cancel: #t) (.cc policy reserve-shift: 1) policy policy (.cc policy ceiling: 1)))
            (builder (list (.cc cache.Builder.) (.cc cache.Builder.) (.cc cache.Builder.) (.cc cache.Builder.) (.cc cache.Builder. allow: (lambda (_) #f))))
            (stage '(services admission cooking construction admission)))
        (defvalues (retained refused) (workflow.revise warm changed selected-policy builder))
        (check (eq? retained warm) => #t)
        (check-equal? (publication.failure-stage refused) stage)
        (check (eq? (publication.version-cache retained) (publication.version-cache warm)) => #t)
        (check-equal? (size retained 'reserve) 1)))
    (test-case "presence changes invalidate the shared dependent cone"
      (defvalues (old issue) (workflow.start (workflow.graph 30) policy))
      (def changed (graph.set-base (publication.version-source old) 'discount (some (code.make-success 5))))
      (defvalues (next accepted) (workflow.revise old changed policy))
      (check-equal? accepted #f)
      (check-equal? (cache.cache-evaluated (publication.version-cache next)) '(discount risk settlement invoice release total))
      (check-equal? (workflow.value (publication.version-cache next) 'total) 37))))
