;;; Checked selection and atomic multi-result ownership over existing backends.
(export table-selection-test)
(import :std/test :std/error :std/iter (only-in ../brace @@method)
        ../object ../mop ../type ../number ../table ../rationaldict ../support/option
        (only-in ../trie SimpleTrie) (only-in ./table-validation-test alist-table)
        (prefix-in ../examples/service-collection service.))

;; Match ownership refusals without swallowing callback/type errors.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; One independent list oracle checks complete bindings and both partition sides.
(def table-selection-test
  (test-suite "checked selection and atomic partition"
    (test-case "all finite decisions preserve exact selected bindings across backends"
      (for* ((table (list (RationalDict Integer) (SimpleTrie UInt Integer))) (mask (in-range 16)))
        (def input (.call table .<-list '((0 . 10) (1 . 11) (2 . 12) (3 . 13))))
        (def calls [])
        (def (selected? k v)
          (set! calls (cons k calls))
          (not (zero? (bitwise-and mask (arithmetic-shift 1 k)))))
        (defvalues (yes no) (.call table .partition selected? input))
        (check-equal? (length calls) 4)
        (check-equal? (reverse calls) (map car (.call table .list<- input)))
        (for (k (in-range 4))
          (def chosen? (not (zero? (bitwise-and mask (arithmetic-shift 1 k)))))
          (check (.call table .key? yes k) => chosen?)
          (check (.call table .key? no k) => (not chosen?))
          (check-equal? (.call table .ref (if chosen? yes no) k) (+ k 10)))
        (check-equal? (.call table .list<- (.call table .filter selected? input)) (.call table .list<- yes))))
    (test-case "table and set partition cover five styles with one owner commit"
      (for* ((set? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def descriptor (if set? RationalSet (RationalDict Integer)))
        (def family ((if set? set-styles table-styles) descriptor))
        (def protocol (.ref family name))
        (def root (.call descriptor .<-list (if set? '(1 2 3 4) '((1 . 10) (2 . 20) (3 . 30) (4 . 40)))))
        (def owner (.call protocol .ap root))
        (def predicate (if set? even? (lambda (k _) (even? k))))
        (defvalues (yes no)
          (if (memq name '(Posh Classy)) (@@method owner.partition predicate)
            (.call protocol .partition predicate owner)))
        (check-equal? (.call protocol .list<- yes) (if set? '(2 4) '((2 . 20) (4 . 40))))
        (check-equal? (.call protocol .list<- no) (if set? '(1 3) '((1 . 10) (3 . 30))))
        (check-equal? (.call protocol .list<- (.call protocol .filter (if set? odd? (lambda (k _) (odd? k))) no))
          (if set? '(1 3) '((1 . 10) (3 . 30))))
        (case name
          ((Pure Posh) (check (eq? root (.call protocol .unap owner)) => #t))
          ((Mutable Classy) (check (eq? owner yes) => #t) (check (eq? yes no) => #f))
          ((Linear) (check-exception (.call protocol .unap owner) (message? "consumed table reference"))))))
    (test-case "late predicate refusal and non Boolean results preserve owners for retry"
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (set-styles RationalSet) name))
        (def root (.call RationalSet .<-list '(1 2 3)))
        (def owner (.call protocol .ap root))
        (def failure (list 'late))
        (check (eq? (try (.call protocol .partition (lambda (k) (if (= k 3) (raise failure) #t)) owner)
                      #f (catch (e) e)) failure) => #t)
        (check-exception (.call protocol .partition (lambda (_) 'truthy) owner) ContractViolation?)
        (check (eq? root (.call protocol .unap owner)) => #t)
        (defvalues (yes no) (.call protocol .partition even? owner))
        (check-equal? (.call protocol .list<- yes) '(2))
        (check-equal? (.call protocol .list<- no) '(1 3))))
    (test-case "second branch recognition fails before either owner is published"
      (def descriptor (.cc RationalSet
        .element?: (lambda (root) (and (element? RationalSet root)
          (not (equal? (.call RationalSet .list<- root) '(1 3)))))))
      (for (name '(Mutable Linear Classy))
        (def protocol (.ref (set-styles descriptor) name))
        (def root (.call descriptor .<-list '(1 2 3)))
        (def owner (.call protocol .ap root))
        (check-exception (.call protocol .partition even? owner) TypeError?)
        (check (eq? root (.call protocol .unap owner)) => #t)
        (check-equal? (.call protocol .list<- (.call protocol .filter even? owner)) '(2))))
    (test-case "direct sets protect refinements empty input and declared origins"
      (check-exception (.call RationalSet .partition 'not-a-procedure (.@ RationalSet .empty)) ContractViolation?)
      (check-exception (.call RationalSet .filter 'not-a-procedure (.@ RationalSet .empty)) ContractViolation?)
      (def origin (.o revision: 0))
      (def descriptor (.cc RationalSet .sources: (list origin)
        .element?: (lambda (root) (and (element? RationalSet root)
          (not (equal? (.call RationalSet .list<- root) '(1 3)))))))
      (def root (.call RationalSet .<-list '(1 2 3)))
      (check-exception (.call descriptor .partition even? root) TypeError?)
      (check-exception (.call descriptor .filter odd? root) TypeError?)
      (check-equal? (.call descriptor .list<- (.call descriptor .filter even? root)) '(2))
      (check-exception (.call descriptor .partition (lambda (_) (.set! origin revision 1) #t) root) Error?)
      (check-equal? (.@ origin revision) 0))
    (test-case "reentrant winner stale rejection and metadata guards cover all results"
      (def descriptor (.cc RationalSet))
      (def protocol (.@ (set-styles descriptor) Classy))
      (def owner (.call protocol .ap (.call descriptor .<-list '(1 2 3))))
      (def entered? #f)
      (check-exception (.call protocol .partition (lambda (k)
        (unless entered? (set! entered? #t) (@@method owner.cons 9)) (even? k)) owner)
        (message? "stale table reference"))
      (check-equal? (@@method owner.list<-) '(1 2 3 9))
      (check-exception (@@method owner.partition (lambda (_) (.set! descriptor sexp 'changed) #t)) Error?)
      (check-equal? (@@method owner.list<-) '(1 2 3 9)))
    (test-case "Function identity and FUN IO delta inverse retry compose with partition"
      (def function (Fun Integer <- Integer))
      (def table (alist-table Integer function))
      (def f (validate function (lambda (n) (+ n 1))))
      (def root (.call table .acons 1 f (.call table .acons 2 f (.@ table .empty))))
      (def styles (table-styles table)) (def protocol (.@ styles Linear))
      (def owner (.call protocol .ap root))
      (defvalues (yes no) (.call protocol .partition (lambda (k _) (odd? k)) owner))
      (check (eq? f (.call protocol .ref yes 1)) => #t)
      (check (eq? f (.call protocol .ref no 2)) => #t)
      (check-exception ((.call protocol .ref no 2) "bad") TypeError?)
      (def delta (.call table .diff root (.call protocol .unap yes)))
      (def restored (.call table .apply-delta (.call protocol .unap yes) (invert-table-delta delta)))
      (check (eq? f (.call table .ref restored 2)) => #t)
      (def seen []) (def refuse? #t) (def calls 0)
      (def action (service.partition-access-action RationalSet
        (lambda (element) (if (and refuse? (= element 3)) (error "policy not ready") (even? element)))
        (lambda (accepted rejected) (set! calls (+ calls 1)) (set! seen (list accepted rejected)) seen)))
      (def policy (.call RationalSet .<-list '(1 2 3)))
      (check-exception (action policy) (message? "policy not ready"))
      (check-equal? calls 0) (check-equal? seen [])
      (set! refuse? #f)
      (check-equal? (action policy) '((2) (1 3)))
      (check-equal? calls 1)
      (check-equal? seen '((2) (1 3))))))
