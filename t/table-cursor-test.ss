;;; Standard Iterator capabilities survive composed collection protocols.
(export table-cursor-test)
(import :std/test :std/error :std/iter
        ../object ../mop ../type ../number ../table ../rationaldict ../support/option
        (only-in ../fun Wrapper.) (only-in ../trie SimpleTrie)
        (only-in ../support/base number-comparer)
        (only-in ./table-testing box-table)
        (prefix-in ../examples/service-collection service.))

;; Match metadata refusal without accepting unrelated backend/type failures.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; A typed involution shares the existing Wrapper contract and inverse checks.
(def (key-wrapper source forward backward)
  (.cc Wrapper. Domain: (.@ source Key) Codomain: (.@ source Key)
    .ap: forward .unap: backward))

;; Expose mutation during source admission or computed query discovery, never
;; inside comparison. Fresh descriptors prevent memoized recognition hiding it.
(def (bound-query-fixture mode (value Integer))
  (def raw (RationalDict value)) (def lower (some 2)) (def upper (some 4))
  ;; Alter only caller-owned Option shells; stored keys and Function leaves stay stable.
  (def (rewrite!) (some-value-set! lower 4) (some-value-set! upper 5))
  (def source (if (eq? mode 'shape)
    (.cc raw .validate-shape: (lambda (root) (rewrite!) (.call raw .validate-shape root))) raw))
  (def ordered (table-order source (.@ raw Comparer)))
  (def view (if (eq? mode 'getter)
    (.o (:: @ ordered)
      (.range (begin (rewrite!) (.@ ordered .range)))
      (.range<- (begin (rewrite!) (.@ ordered .range<-)))
      (.seek (begin (rewrite!) (.@ ordered .seek)))
      (.seek<- (begin (rewrite!) (.@ ordered .seek<-)))) ordered))
  (def payload (cond ((eq? value Unit) (void)) ((element? value 10) 10)
    (else (validate value (lambda (n) (+ n 1))))))
  (def root (.call raw .<-list (map (lambda (key) (cons key payload)) '(1 2 3 4 5))))
  (values raw view root lower upper rewrite!))

;; Normalize eager/streaming observations to keys through their standard interfaces.
(def (run-bound-query descriptor root method lower upper)
  (def result (apply (.ref descriptor method) root
    (if (memq method '(.seek .seek<-)) (list lower #t) (list lower upper))))
  (case method
    ((.seek) (if result (list (car (some-value result))) []))
    ((.range) (map car result))
    (else (for/collect (entry result) (car entry)))))

;; Observe demand, failures, EOF and snapshots through the actual Gerbil interface.
(def table-cursor-test
  (test-suite "composed collection iterators"
    (test-case "range and seek capture request cells before source shape recognition"
      (for (method '(.range .range<- .seek .seek<-))
        (defvalues (raw view root lower upper rewrite!) (bound-query-fixture 'shape))
        (def result (run-bound-query view root method lower upper))
        (check-equal? result (case method ((.seek) '(2)) ((.seek<-) '(2 3 4 5)) (else '(2 3 4))))
        (check-equal? (list (some-value lower) (some-value upper)) '(4 5))))
    (test-case "five styles capture before computed query discovery without consuming ownership"
      (for* ((style '(Pure Mutable Linear Posh Classy)) (method '(.range .range<- .seek .seek<-)))
        (defvalues (raw view root lower upper rewrite!) (bound-query-fixture 'getter))
        (def protocol (.ref (table-styles view) style))
        (def owner (.call protocol .ap root))
        (check-equal? (run-bound-query protocol owner method lower upper)
          (case method ((.seek) '(2)) ((.seek<-) '(2 3 4 5)) (else '(2 3 4))))
        (check (eq? root (.call protocol .unap owner)) => #t)))
    (test-case "Set style projections capture endpoints before backing method discovery"
      (for* ((style '(Pure Mutable Linear Posh Classy)) (method '(.range .range<- .seek .seek<-)))
        (defvalues (raw view root lower upper rewrite!) (bound-query-fixture 'getter Unit))
        (def protocol (.ref (set-styles (.cc Set<-Table. Table: view)) style))
        (def owner (.call protocol .ap root))
        (def result (apply (.ref protocol method) owner
          (if (memq method '(.seek .seek<-)) (list lower #t) (list lower upper))))
        (def keys (case method ((.seek) (list (some-value result))) ((.range) result)
          (else (for/collect (key result) key))))
        (check-equal? keys (case method ((.seek) '(2)) ((.seek<-) '(2 3 4 5)) (else '(2 3 4))))
        (check (eq? root (.call protocol .unap owner)) => #t)))
    (test-case "named index queries own bounds before backend discovery across all styles"
      (for* ((style '(Direct Pure Mutable Linear Posh Classy))
             (method '(.index-range .index-range<- .index-seek<-)))
        (def source (RationalDict Integer))
        (defvalues (raw backend ignored lower upper rewrite!) (bound-query-fixture 'getter (.@ source Key)))
        (def indexed (table-indexes source (list
          (.cc Type. name: 'rank table: backend unique?: #t project: (lambda (key _) key)))))
        (def root (.call indexed .wrap (.call source .<-list '((1 . 10) (2 . 20) (3 . 30) (4 . 40) (5 . 50)))))
        (def protocol (if (eq? style 'Direct) indexed (.ref (table-styles indexed) style)))
        (def owner (if (eq? style 'Direct) root (.call protocol .ap root)))
        (def args (if (eq? method '.index-seek<-) (list 'rank lower) (list 'rank lower upper)))
        (def result (apply (.ref protocol method) owner args))
        (check-equal? (map car (if (eq? method '.index-range) result (for/collect (entry result) entry)))
          (if (eq? method '.index-seek<-) '(2 3 4 5) '(2 3 4)))))
    (test-case "captured invalid bounds cannot be repaired by admission and stale errors keep priority"
      (defvalues (raw view root lower upper rewrite!) (bound-query-fixture 'shape))
      (some-value-set! lower 'invalid)
      (check-exception (.call view .range root lower upper) TypeError?)
      (check-equal? (some-value lower) 4)
      (check-equal? (map car (.call view .range root (some 2) (some 4))) '(2 3 4))
      (check-exception (.call view .range root 'invalid #f) (message? "table range bound must be Option"))
      (.set! (.@ view Comparer) sexp 'revised)
      (check-exception (.call view .range root 'invalid #f) (message? "stale table order")))
    (test-case "delayed bounds remain owned after return while EOF still checks origin changes"
      (defvalues (raw view root lower upper rewrite!) (bound-query-fixture 'plain))
      (def stream (.call view .range<- root lower upper))
      (some-value-set! lower 99) (some-value-set! upper -99)
      (using (stream :- Iterator)
        (check-equal? (stream.next!) '(2 . 10))
        (check-equal? (stream.next!) '(3 . 10))
        (check-equal? (stream.next!) '(4 . 10))
        (check (eq? (stream.next!) #!eof) => #t)
        (.set! raw sexp 'revised)
        (check-exception (stream.next!) (message? "stale table order"))))
    (test-case "Reader range inspection retains Function identity through revision retry and inverse"
      (def signature (Fun Integer <- Integer))
      (defvalues (raw view root lower upper rewrite!) (bound-query-fixture 'getter signature))
      (def callback (.call raw .ref root 2))
      (def protocol (.@ (table-styles view) Classy))
      (def owner (.call protocol .ap root))
      (def effects 0)
      (def action (service.observe-ledger-range protocol lower upper
        (lambda (cursor) (for/collect (entry cursor) (cons (car entry) ((cdr entry) 7))))
        (lambda (rows) (set! effects (+ effects 1)) rows)))
      (check-equal? (action owner) '((2 . 8) (3 . 8) (4 . 8)))
      (check-equal? effects 1)
      (check (eq? callback (.call raw .ref (.call protocol .unap owner) 2)) => #t)
      (def after (.call raw .remove root 3))
      (def delta (.call raw .diff root after))
      (def conflict (.call raw .diff (.call raw .remove root 2) after))
      (check-exception (.call protocol .apply-delta owner conflict) table-conflict?)
      (check (eq? root (.call protocol .unap owner)) => #t)
      (def next (.call protocol .apply-delta owner delta))
      (some-value-set! lower 2) (some-value-set! upper 4)
      (check-equal? (action next) '((2 . 8) (4 . 8)))
      (def restored (.call protocol .apply-delta next (invert-table-delta delta)))
      (check-equal? (action restored) '((2 . 8) (3 . 8) (4 . 8)))
      (check-equal? effects 3))
    (test-case "ordered indexed and represented views preserve the declared streaming backend"
      (def raw (SimpleTrie UInt Integer)) (def blocked? #f) (def starts 0) (def pulls 0)
      (def source (.cc raw
        .foldr: (lambda (f seed root) (when blocked? (error "unexpected fold materialization"))
          (.call raw .foldr f seed root))
        .list<-: (lambda (root) (when blocked? (error "unexpected list materialization"))
          (.call raw .list<- root))
        .iter<-: (lambda (root (from 0)) (set! starts (+ starts 1))
          (iterator-map identity (.call raw .iter<- root from)
            (lambda (action) (set! pulls (+ pulls 1)) (action))))))
      (def ordered (table-order source (.@ source Comparer)))
      (def indexed (table-indexes ordered (list
        (.cc Type. name: 'value table: (RationalDict UInt) unique?: #t project: (lambda (_ v) v)))))
      (def root (.call raw .<-list '((0 . 10) (1 . 20) (2 . 30))))
      (def state (.call indexed .wrap root))
      (def keys (key-wrapper indexed (cut bitwise-xor <> 1) (cut bitwise-xor <> 1)))
      (defvalues (view carrier _) (box-table indexed key: keys))
      (def boxed (.call view .wrap state))
      (set! blocked? #t)
      (for (request (list (cons ordered root) (cons indexed state) (cons view boxed)))
        (set! starts 0) (set! pulls 0)
        (def cursor (.call (car request) .iter<- (cdr request)))
        (check-equal? starts 1) (check-equal? pulls 0)
        (using (cursor :- Iterator)
          (check-equal? (cursor.next!) (if (eq? (car request) view) '(1 . 10) '(0 . 10)))
          (check-equal? pulls 1)
          (cursor.next!) (cursor.next!)
          (check (eq? (cursor.next!) #!eof) => #t)
          (check (eq? (cursor.next!) #!eof) => #t)
          (check-equal? pulls 5))))
    (test-case "typed key and value conversions are demanded per row and preserve stored false"
      (def source (RationalDict Bool)) (def trace [])
      (def keys (key-wrapper source (lambda (key) (set! trace (cons 'key trace)) (- key)) -))
      (def values (.cc Wrapper. Domain: Bool Codomain: Bool
        .ap: (lambda (value) (set! trace (cons 'value trace)) value) .unap: identity))
      (defvalues (view carrier _) (box-table source key: keys value: values))
      (def root (.call view .wrap (.call source .<-list '((1 . #f) (2 . #t) (3 . #f)))))
      (def cursor (.call view .iter<- root))
      (check-equal? trace [])
      (using (cursor :- Iterator)
        (check-equal? (cursor.next!) '(-1 . #f))
        (check-equal? (reverse trace) '(key key value value)))
      (.set! keys sexp 'changed)
      (using (cursor :- Iterator)
        (check-exception (cursor.next!) (message? "stale table wrapper")))
      (check-equal? (reverse trace) '(key key value value)))
    (test-case "every derived layer refuses before active or repeated EOF pulls after invalidation"
      (for* ((kind '(order index wrapper)) (empty? '(#f #t)))
        (def raw (SimpleTrie UInt Integer)) (def pulls 0)
        (def source (.cc raw .iter<-: (lambda (root (from 0))
          (iterator-map identity (.call raw .iter<- root from)
            (lambda (action) (set! pulls (+ pulls 1)) (action))))))
        (def root (if empty? (.@ raw .empty) (.call raw .singleton 1 10)))
        (def declaration (.cc Type. name: 'value table: (RationalDict UInt) unique?: #t
          project: (lambda (_ value) value)))
        (def comparer (.@ source Comparer))
        (def keys (key-wrapper source identity identity))
        (defvalues (table state origin expected)
          (case kind
            ((order) (values (table-order source comparer) root comparer "stale table order"))
            ((index) (let (indexed (table-indexes source (list declaration)))
              (values indexed (.call indexed .wrap root) declaration "stale indexed table")))
            (else (let-values (((view carrier _) (box-table source key: keys)))
              (values view (.call view .wrap root) keys "stale table wrapper")))))
        (def active (.call table .iter<- state))
        (def exhausted (.call table .iter<- state))
        (using (cursor exhausted :- Iterator)
          (unless empty? (cursor.next!))
          (check (eq? (cursor.next!) #!eof) => #t)
          (check (eq? (cursor.next!) #!eof) => #t))
        (let (before pulls)
          (.set! origin sexp 'changed)
          (for (iterator (list active exhausted))
            (using (cursor iterator :- Iterator)
              (check-exception (cursor.next!) (message? expected))))
          (check-equal? pulls before))))
    (test-case "conversion failure follows one source pull and fresh retry restarts the original snapshot"
      (def source (RationalDict Integer)) (def failure (list 'key-refused))
      (def fail? #t) (def values 0)
      (def keys (key-wrapper source (lambda (key)
        (when (and fail? (= key 2)) (raise failure)) (- key)) -))
      (def payloads (.cc Wrapper. Domain: Integer Codomain: Integer
        .ap: (lambda (value) (set! values (+ values 1)) value) .unap: identity))
      (defvalues (view carrier _) (box-table source key: keys value: payloads))
      (def root (.call view .wrap (.call source .<-list '((1 . 10) (2 . 20) (3 . 30)))))
      (def cursor (.call view .iter<- root))
      (using (cursor :- Iterator)
        (check-equal? (cursor.next!) '(-1 . 10))
        (check (eq? (try (cursor.next!) #f (catch (cause) cause)) failure) => #t)
        (check-equal? values 2)
        (check-equal? (cursor.next!) '(-3 . 30))
        (check (eq? (cursor.next!) #!eof) => #t))
      (set! fail? #f)
      (check-equal? (for/collect (entry (.call view .iter<- root)) entry)
        '((-1 . 10) (-2 . 20) (-3 . 30))))
    (test-case "all five styles retain issued snapshots after revisions and ownership transfer"
      (def source (RationalDict Integer))
      (def indexed (table-indexes source (list
        (.cc Type. name: 'value table: (RationalDict (.@ source Key)) unique?: #t
          project: (lambda (_ value) value)))))
      (def root (.call indexed .wrap (.call source .<-list '((1 . 10) (2 . 20)))))
      (defvalues (view carrier keys) (box-table indexed))
      (def before (.call view .wrap root))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles view) name))
        (def owner (.call protocol .ap before))
        (def cursor (.call protocol .iter<- owner))
        (def next (.call protocol .map/2 (lambda (_ value) (+ value 1)) owner))
        (def pure (.call protocol .convert next 'pure))
        (check-equal? (for/collect (entry cursor) entry) '((-1 . 10) (-2 . 20)))
        (check-equal? (for/collect (entry (.call view .iter<- pure)) entry) '((-1 . 11) (-2 . 21)))))
    (test-case "cohort publication composes lazy reads checked callbacks failure retry and inverse"
      (defvalues (indexed source declarations) (service.make-cohort-services))
      (def callback (validate (Fun Integer <- Integer) (lambda (n) (+ n 1))))
      (def base (.call source .<-list
        (list (cons 1 (vector 101 10 callback)) (cons 2 (vector 102 10 callback))
              (cons 3 (vector 103 20 callback)) (cons 4 (vector 104 20 callback)))))
      (def state (.call indexed .wrap base))
      (def ordered (table-order indexed (table-comparer (.@ indexed Key) number-comparer)))
      (defvalues (view carrier keys) (box-table ordered))
      (def before (.call view .wrap state))
      (def protocol (.@ (table-styles view) Classy))
      (def owner (.call protocol .ap before))
      (def cursor (.call protocol .iter<- owner))
      (check-exception (.call protocol .map/2 (lambda (key row)
        (if (= key -1) (vector 101 20 callback) row)) owner) TypeError?)
      (check (eq? before (.call protocol .unap owner)) => #t)
      ;; Reuse the indexed final-state batch rather than publishing partial teams.
      (def after (.call indexed .apply-delta state (.call source .diff base
        (.call source .acons 3 (vector 101 10 callback)
          (.call source .acons 1 (vector 103 20 callback) base)))))
      (.call protocol .map (lambda (_) (.call view .wrap after)) owner)
      (check-equal? (map (lambda (entry) (vector-ref (cdr entry) 0))
        (for/collect (entry cursor) entry)) '(101 102 103 104))
      (def consumed 0)
      (def action (service.observe-ledger-first protocol
        (lambda (_ row) (cons (vector-ref row 0) ((vector-ref row 2) 7)))
        (lambda (result) (set! consumed (+ consumed 1)) result)))
      (check-equal? (action owner) (some (cons -1 (cons 103 8))))
      (check-equal? consumed 1)
      (check-exception ((service.observe-ledger-first protocol
        (lambda (_ row) ((vector-ref row 2) "bad"))
        (lambda (_) (set! consumed (+ consumed 1)))) owner) TypeError?)
      (check-equal? consumed 1)
      (def undo (invert-table-delta (.call source .diff base (.call indexed .unwrap after))))
      (.call protocol .map (lambda (_) (.call view .wrap (.call indexed .apply-delta after undo))) owner)
      (check-equal? (action owner) (some (cons -1 (cons 101 8))))
      (check-equal? consumed 2)
      (using (fresh (.call protocol .iter<- owner) :- Iterator)
        (check (eq? callback (vector-ref (cdr (fresh.next!)) 2)) => #t)))))
