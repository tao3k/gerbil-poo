(export shared-approvals-test)
(import :std/test :std/sync/channel ../object ../mop ../brace ../support/option ../feedback-graph
        (prefix-in ../component-publication publication.) (prefix-in ../construction-cache cache.)
        (prefix-in ../examples/component-requests single.) (prefix-in ../examples/shared-approvals service.))
;; Topology changes must skip untouched inputs and independent feedback receipts.
(def builder (.cc cache.Builder. allow: (lambda (key) (not (memq key '(quota spare stable))))))
;; All policy records use the original native object revision discipline.
(def (policy) (.o (allowed #t) (limit 30)))
;; Pause after both approvals using fixed standard channel bounds, not busy waits.
(def (pause owner approvals ready resume result)
  (def request (service.stage owner 'merge [] approvals builder extra-admit: (lambda (_ __)
    (channel-put ready 'ready)
    (unless (eq? (channel-get resume 5 'timeout) 'go) (error "shared approval resume timeout")) #t)))
  (thread-start! (make-thread (lambda ()
    (defvalues (head failure) (publication.submit! owner request))
    (channel-put result (list owner head failure))))))
;; Shared invalidation is dependency-based; sharing a lock alone never invalidates
;; sibling heads or policies that do not appear in a request's registered guards.
(def shared-approvals-test
  (test-suite "shared approval domains across independent publication heads"
    (test-case "shared revision invalidates both owners while an unrelated domain remains usable"
      (def shared (policy)) (def left (policy)) (def right (policy))
      (def owners (service.start shared [left right]))
      (def a (car owners)) (def b (cadr owners))
      (def old-a (publication.current a)) (def old-b (publication.current b))
      (def reached? #f)
      (def reject-builder (.cc cache.Builder. allow: (lambda (_) (set! reached? #t) #f)))
      (def pending-a (service.stage a 'merge [] [shared left] reject-builder))
      (def pending-b (service.stage b 'merge [] [shared right] reject-builder))
      (def private-policies (single.policies))
      (def independent (single.start private-policies))
      (def unaffected (single.stage independent 'merge [] private-policies builder))
      (publication.revise-approval! a shared 'limit 24)
      (for-each (lambda (entry)
        (defvalues (head failure) (publication.submit! (car entry) (cadr entry)))
        (check (eq? head (caddr entry)) => #t) (check (not (not failure)) => #t))
        [[a pending-a old-a] [b pending-b old-b]])
      (check-equal? reached? #f)
      (defvalues (other ok) (publication.submit! independent unaffected))
      (check-equal? ok #f) (check-equal? (single.value other 'settlement) 24)
      (def fresh-a (service.stage a 'merge [] [shared left] builder))
      (def fresh-b (service.stage b 'merge [] [shared right] builder))
      (defvalues (next-a fine-a) (publication.submit! a fresh-a))
      (defvalues (next-b fine-b) (publication.submit! b fresh-b))
      (check-equal? fine-a #f) (check-equal? fine-b #f)
      (check-equal? (service.value next-a 'settlement) 24) (check-equal? (service.value next-b 'settlement) 24))
    (test-case "local approval revision invalidates only observing endpoint inside one shared domain"
      (def shared (policy)) (def left (policy)) (def right (policy))
      (def owners (service.start shared [left right]))
      (def a (car owners)) (def b (cadr owners))
      (def request-a (service.stage a 'merge [] [shared left] builder))
      (def request-b (service.stage b 'merge [] [shared right] builder))
      (publication.revise-approval! b left 'limit 24)
      (defvalues (held stale) (publication.submit! a request-a))
      (check (eq? held (publication.current a)) => #t) (check (not (not stale)) => #t)
      (defvalues (next ok) (publication.submit! b request-b))
      (check-equal? ok #f) (check-equal? (service.value next 'settlement) 24)
      (defvalues (restaged fine) (service.submit-current! a 'merge [] [shared left] builder))
      (check-equal? fine #f) (check-equal? (service.value restaged 'settlement) 24))
    (test-case "two owners pause approval and related policy revisions refuse both before fresh restaging"
      (def shared (policy)) (def left (policy)) (def right (policy))
      (def owners (service.start shared [left right]))
      (def a (car owners)) (def b (cadr owners))
      (def ready (make-channel)) (def resume (make-channel)) (def result (make-channel))
      (def first (pause a [shared left] ready resume result))
      (def second (pause b [shared right] ready resume result))
      (check-equal? (channel-get ready 5 'timeout) 'ready)
      (check-equal? (channel-get ready 5 'timeout) 'ready)
      (publication.revise-approval! b shared 'allowed #f)
      (publication.revise-approval! a left 'limit 12)
      (channel-put resume 'go) (channel-put resume 'go)
      (for-each (lambda (_)
        (def outcome (channel-get result 5 'timeout))
        (check (list? outcome) => #t)
        (check (eq? (cadr outcome) (publication.current (car outcome))) => #t)
        (check (not (not (caddr outcome))) => #t)) '(one two))
      (thread-join! first 5) (thread-join! second 5)
      (publication.revise-approval! a shared 'allowed #t)
      (defvalues (held denied) (service.submit-current! a 'merge [] [shared left] builder))
      (check (eq? held (publication.current a)) => #t) (check (not (not denied)) => #t)
      (defvalues (next-b ok-b) (service.submit-current! b 'merge [] [shared right] builder))
      (check-equal? ok-b #f)
      (publication.revise-approval! b left 'limit 30)
      (defvalues (next-a ok-a) (service.submit-current! a 'merge [] [shared left] builder))
      (check-equal? ok-a #f)
      (check-equal? (service.value next-a 'settlement) (service.value next-b 'settlement)))
    (test-case "shared change-back propagates across different topology heads then each endpoint restages locally"
      (def shared (policy)) (def left (policy)) (def right (policy))
      (def owners (service.start shared [left right]))
      (def a (car owners)) (def b (cadr owners))
      (defvalues (merged ok) (service.submit-current! a 'merge [] [shared left] builder))
      (check-equal? ok #f)
      (def pending-a (service.stage a 'replace [] [shared left] builder))
      (def pending-b (service.stage b 'merge [] [shared right] builder))
      (publication.revise-approval! b shared 'allowed #f)
      (publication.revise-approval! a shared 'allowed #t)
      (defvalues (_ stale-a) (publication.submit! a pending-a))
      (defvalues (__ stale-b) (publication.submit! b pending-b))
      (check (not (not stale-a)) => #t) (check (not (not stale-b)) => #t)
      (defvalues (split good-a) (service.submit-current! a 'replace [] [shared left] builder))
      (defvalues (joined good-b) (service.submit-current! b 'merge [] [shared right] builder))
      (check-equal? good-a #f) (check-equal? good-b #f)
      (check-equal? (service.value split 'settlement) 16)
      (check-equal? (service.value joined 'settlement) 24)
      (check (eq? (graph-cache-ref merged 'stable) (graph-cache-ref split 'stable)) => #t))))
