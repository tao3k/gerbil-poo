;;; Shared bounded process/JSON helpers retain failed and timed-out cases.
(export main)
(import :std/iter "closure-benchmark-support.ss")
(def (main binary timeout output)
  (def receipt (hash ("schema" 2) ("deadline_seconds" 20) ("heap_limit" "1G")
                     ("binary_sha256" (file-sha binary)) ("runner_sha256" (file-sha "t/closure-paired-suite.ss"))))
  (def cases [])
  (for (spec '(("diamond" 1024) ("hubchain" 1024) ("ring" 1024) ("bursts" 1024) ("dense" 256)))
    (match spec ([family size]
      (def path (string-append output "." family ".json"))
      (def entry (merge! (hash ("family" family))
                         (run-bounded timeout (list binary "-:max-heap=1G" family (number->string size) "16" path))))
      (when (equal? (hash-ref entry "status") "pass")
        (try
          (def child (read-receipt path))
          (unless (= (length (hash-ref child "rows")) 96) (error "incomplete paired case"))
          (hash-put! entry "receipt" child)
          (catch (exception) (hash-put! entry "status" "invalid_receipt") (hash-put! entry "error" (object->string exception)))))
      (set! cases (cons entry cases))
      (hash-put! receipt "cases" (reverse cases))
      (write-receipt output receipt)
      (displayln "PAIRED-CASE family=" family " status=" (hash-ref entry "status"))
      (force-output))))
  (unless (andmap (lambda (entry) (equal? (hash-ref entry "status") "pass")) cases) (error "paired failures retained"))
  (for* ((entry (reverse cases)) (scope '("cold" "warm" "refresh")) (queue '("append" "chunked" "hybrid" "auto")))
    (def matches (filter (lambda (row) (and (equal? (hash-ref row "queue") queue) (equal? (hash-ref row "scope") scope)))
                        (hash-ref (hash-ref entry "receipt") "rows")))
    (unless (= (length matches) 8) (error "paired coverage"))
    (displayln (hash-ref entry "family") " scope=" scope " queue=" queue " mean_cpu_ms="
      (mean (map (lambda (row) (* 1000 (/ (hash-ref row "cpu_seconds") (hash-ref row "repetitions")))) matches))))
  (displayln "CLOSURE-PAIRED-SUITE-OK observations=480"))
