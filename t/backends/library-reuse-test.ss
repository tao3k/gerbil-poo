;;; Actual Gerbil interfaces and containers under POO source/validation discipline.
(export library-reuse-test)
(import (prefix-in (only-in :clan/poo/examples/representation-service value-storage-workflow value-store-observation-workflow value-store-redemand-workflow) representation.)
        :std/test :std/iter :std/error (only-in :gerbil/runtime/hash HashTable)
        (for-syntax :gerbil/expander)
        (only-in :gerbil/runtime/gambit string->uninterned-symbol)
        (only-in :gerbil/runtime/c3 c4-linearize c4-linearize*)
        (prefix-in :clan/poo/reflection reflection.)
        (only-in :clan/poo/brace @method @@method)
        (rename-in (only-in :clan/poo/brace @method) (@method object-form))
        (prefix-in :clan/poo/examples/declared-methods declared.)
        (prefix-in :clan/poo/method-combination method.)
        (prefix-in :clan/poo/multimethod dispatch.)
        (prefix-in :clan/poo/dispatch-extension extension.)
        (only-in :std/hash/misc hash-ref/default hash-ensure-ref)
        (only-in :std/list/plist alist->plist)
        (only-in :std/list/alist plist->alist aremq arem)
        :clan/poo/object :clan/poo/mop :clan/poo/number :clan/poo/object-contract :clan/poo/support/option :clan/poo/slot-layout
        (only-in :clan/poo/type Record List Tuple)
        (prefix-in :clan/poo/types/validation containers.)
        (prefix-in :clan/poo/examples/service-collection service.)
        (prefix-in :clan/poo/dependency-analysis code.)
        (prefix-in :clan/poo/generalized-graph graph.)
        (prefix-in :clan/poo/construction-cache cache.))

;; Exercise actual scoped expansion rather than serializing identifier names.
(defsyntax (rejects? stx)
  (syntax-case stx ()
    ((_ form) (try (core-expand #'form) #'#f (catch (_cause) #'#t)))))
;; Inspect actual resolved bindings; equality of printed macro names is insufficient.
(defsyntax (same-binding? stx)
  (syntax-case stx ()
    ((_ left right) (if (free-identifier=? #'left #'right) #'#t #'#f))))
;; A host class stays on the explicit Gerbil method escape, independent of braces.
(defstruct host-reading (value) final: #t)
;; Core defmethod and @@method retain their original binding and dispatch semantics.
(defmethod (@@method read host-reading) (lambda (self) (host-reading-value self)))
;; The two value identifiers have the same spelling and distinct lexical bindings.
(defrule (two-scopes outer)
  (let (value 99) (with-slots (value outer) (.o value: 7) (+ value outer))))

;; Decode only completed successes, retaining the difference between absence and false.
(def (cached-value snapshot key) (code.success-value (some-value (cache.cache-ref snapshot key))))
;; Capture the original exception object without changing its family or payload.
(def (caught thunk) (try (thunk) #f (catch (cause) cause)))
;; Use actual ordered callbacks, not only final container equality, as acceptance evidence.
(def library-reuse-test
  (test-suite "Gerbil classes containers and lazy caches"
    (test-case "cold inline binding refreshes offsets after a dynamic dependency grows the shape"
      (def early (string->uninterned-symbol "early"))
      (def target (string->uninterned-symbol "target"))
      (object->serial-number early) (object->serial-number target)
      (def calls 0)
      (def owner (make-object slots:
        (list (cons target ($self-slot-spec (lambda (self)
          (set! calls (1+ calls)) (.ref self early) #f)))
          (cons 'no-applicable-method ($constant-slot-spec
            (lambda (_self key) (if (eq? key early) 17 (error "unexpected missing key"))))))))
      (def site (make-slot-cache target shapes: 2))
      (check (.ref/inline owner site) => #f)
      (check (.ref/inline owner site) => #f)
      (check-equal? calls 1)
      (check-equal? (.ref owner early) 17)
      (check (hash-key? (object-instance owner) target) => #t))
    (test-case "evicted warm inline demand rebinds the final dynamic shape"
      (def early (string->uninterned-symbol "evicted-dependency"))
      (def target (string->uninterned-symbol "evicted-target"))
      (object->serial-number early) (object->serial-number target)
      (def grow? #f)
      (def calls 0)
      (def owner (make-object slots:
        (list (cons target ($self-slot-spec (lambda (self)
                (set! calls (1+ calls)) (when grow? (.ref self early)) identity)))
              (cons 'no-applicable-method ($constant-slot-spec
                (lambda (_ key) (if (eq? key early) #f (error "unexpected dependency"))))))))
      (def site (make-slot-cache target shapes: 2))
      (check-eq? (.ref/inline owner site) identity)
      (let* ((table (object-instance owner)) (layout (object-layout owner)))
        (hash-remove! table target)
        (set! grow? #t)
        (check-eq? (.ref/inline owner site) identity)
        (check-equal? calls 2)
        (check-equal? (slot-cache-hit? site owner (object-revision owner) layout)
          (slot-layout-index layout target))
        (check-eq? (slot-cache-read site) identity))
      (for ((storage '(hash vector)))
        (check-equal? (representation.value-store-redemand-workflow storage) '#(6 #t #t))))
    (test-case "ordinary inline and HashTable operations share one lazy value store"
      (def calls 0) (def failure (list 'refused)) (def refuse? #t)
      (def owner (.o (value (begin (set! calls (1+ calls)) #f))
        (retry (if refuse? (raise failure) identity)) (unused (error "unrelated value forced"))))
      (def table (object-instance owner))
      (def layout (object-layout owner))
      (check-eq? (slot-values-layout table) layout)
      (check-equal? (hash-length table) 0)
      (def site (make-slot-cache 'value shapes: 2))
      (check (.ref owner 'value) => #f)
      (check (.ref/inline owner site) => #f)
      (check-equal? calls 1)
      (hash-remove! table 'value)
      (check (.ref/inline owner site) => #f)
      (check-equal? calls 2)
      (check-eq? (with-catch identity (cut .ref owner 'retry)) failure)
      (check (hash-key? table 'retry) => #f)
      (set! refuse? #f)
      (check-eq? (.ref/inline owner (make-slot-cache 'retry)) identity)
      (def old-shape (slot-layout-shape layout))
      (hash-put! table 'new-field 19)
      (check (eq? old-shape (slot-layout-shape layout)) => #f)
      (check (.ref/inline owner site) => #f)
      (check-equal? (.ref owner 'new-field) 19)
      (check-eq? (object-instance owner) table)
      (def copied (hash-copy table))
      (hash-put! copied 'new-field 23)
      (check-equal? (hash-ref table 'new-field) 19)
      ;; Standard update callbacks may extend the shape before committing their result.
      (hash-update! table 'new-field (lambda (value)
        (hash-put! table 'during-update #f) (1+ value)))
      (check-equal? (hash-ref table 'new-field) 20)
      (check (hash-ref table 'during-update) => #f)
      (def empty (hash-new table))
      (hash-put! empty 'isolated 29)
      (check (hash-key? table 'isolated) => #f)
      (check-equal? (hash-ref empty 'isolated) 29)
      (hash-clear! table)
      (check-equal? (hash-length table) 0)
      (check (.ref/inline owner site) => #f)
      (check-equal? calls 3)
      (.put! owner 'value identity)
      (check-eq? (.ref/inline owner site) identity)
      (check (eq? (object-instance owner) table) => #f)
      (check-equal? (representation.value-storage-workflow 4 'vector)
                    (representation.value-storage-workflow 4 'hash)))
    (test-case "seed preparation preserves source values precedence and failure retry"
      (def missing (list 'uncomputed))
      (def initial (make-hash-table-symbolic))
      (hash-put! initial 'flag #f)
      (hash-put! initial 'callback identity)
      (hash-put! initial 'replaced 17)
      (for ((storage '(hash vector)))
        (parameterize ((slot-value-storage storage))
          (let* ((table (make-slot-values '(unused flag callback replaced) initial
                         (list (cons 'replaced #f) (cons 'replaced identity)) missing))
                 (layout (slot-values-layout table)))
            (check-equal? (hash-length table) 3)
            (check (hash-ref table 'flag) => #f)
            (check-eq? (hash-ref table 'callback) identity)
            (check-eq? (hash-ref table 'replaced) identity)
            (check-equal? (hash-ref initial 'replaced) 17)
            (check (hash-key? table 'unused) => #f)
            (when layout
              (let (seeded (make-slot-layout '(callback unused flag replaced) table missing))
                (check-eq? (slot-layout-shape seeded) (slot-layout-shape layout))
                (check-equal? (hash-length (HashTable seeded)) 3)
                (check-eq? (slot-layout-ref seeded (slot-layout-index seeded 'callback)) identity)
                (slot-layout-put! seeded 'new #f)
                (check-equal? (hash-length (HashTable seeded)) 4)
                (check-equal? (hash-length table) 3)))
            ;; A type refusal cannot replace the caller's existing value authority.
            (check-exception (make-slot-layout '(flag) 17 missing) Error?)
            (check-equal? (hash-length table) 3)
            (check-equal? (hash-length (make-slot-values '(flag) initial [] missing)) 3)))))
    (test-case "named indexed and standard writes preserve exact lazy occupancy"
      (def missing (list 'uncomputed))
      (def layout (make-slot-layout '(value pending) #f missing))
      (def table (HashTable layout))
      (check-equal? (hash-length table) 0)
      (slot-layout-put! layout 'value #f)
      (check-equal? (hash-length table) 1)
      (slot-layout-set! layout (slot-layout-index layout 'value) identity)
      (check-equal? (hash-length table) 1)
      ;; Named insertion must grow, just like the standard interface, rather than
      ;; silently dropping a field not declared by the original descriptor.
      (slot-layout-put! layout 'extra #f)
      (check-equal? (hash-length table) 2)
      (check (hash-ref table 'extra) => #f)
      (check-eq? (hash-ref table 'value) identity)
      (hash-remove! table 'pending) (hash-remove! table 'absent)
      (check-equal? (hash-length table) (length (hash-keys table)))
      (slot-layout-set! layout (slot-layout-index layout 'value) missing)
      (check-equal? (hash-length table) 1)
      (let (copy (hash-copy table))
        (hash-clear! table)
        (check-equal? (hash-length table) 0)
        (check-equal? (hash-length copy) 1)
        (let (empty (hash-new copy))
          (hash-put! empty 'independent identity)
          (check-equal? (hash-length empty) 1)
          (check (hash-key? copy 'independent) => #f)))
      (for ((storage '(hash vector)))
        (check-equal? (representation.value-store-observation-workflow storage)
          '#(#(1 2 3 1 0) #(1 2 3 1 0) 2))))
    (test-case "brace aliases preserve the complete match binding and host escape"
      (check (same-binding? @method .o) => #t)
      (check (same-binding? object-form .o) => #t)
      (check (same-binding? @@method .o) => #f)
      (check-equal? (@@method read (make-host-reading #f)) #f)
      (let ((value 13))
        (def first {value})
        (def second (object-form value: 7 child: first))
        (check-equal? (match second ((object-form value: own child: {value: captured})
                                    (list own captured))) '(7 13))
        (check-equal? (match second ({absent: _} 'unexpected) (_ 'missing)) 'missing)
        (check-equal? (match #f ({value: _} 'unexpected) (_ 'non-object)) 'non-object))
      (check (rejects? {value: 1 change: (lambda () (set! value 2))}) => #t))
    (test-case "brace FUN method workflow rechecks current reflection and retries"
      (def events [])
      (def family (declared.make-reporting-family (lambda (event) (set! events (cons event events)))))
      (def action (declared.inspected-action family 2))
      (check-equal? events [])
      (check-equal? (call/values (lambda () (action {rate: 10})) list)
        '((.summary .charge) 10 7 (10 7 46)))
      (def descriptor (cdr (assq '.charge (reflection.reflect-slots family))))
      (.putslot! descriptor 'hidden ($constant-slot-spec #t))
      (set! events [])
      (check-exception (action {rate: 20}) Error?)
      (check-equal? events [])
      (.putslot! descriptor 'hidden ($constant-slot-spec #f))
      (check-equal? (call/values (lambda () (action {rate: 20})) list)
        '((.summary .charge) 20 7 (20 7 86)))
      (check-equal? (reverse events)
        '(around-enter billing-before risk-before billing-primary base risk-after billing-after around-exit)))
    (test-case "complete reflected catalog precedes a front slot and preserves metadata failure"
      (def events [])
      (def cause (list 'metadata-refused))
      (def first (.o (:: @ (instance Slot))
        (hidden #f)
        (compute (lambda (_ __) (set! events (cons 'first-value events)) 5))))
      (def last (.o (:: @ (instance Slot))
        (hidden #f)
        (compute (lambda (_ __) (error "unreachable value")))))
      (def receiver (reflection.object<-declarations (list (cons 'first first) (cons 'last last))))
      ;; Initial Slot admission precedes these supported metadata revisions;
      ;; the following observations must use fresh descriptor computations.
      (.putslot! first 'hidden ($thunk-slot-spec
        (lambda () (set! events (cons 'first-metadata events)) #f)))
      (.putslot! last 'hidden ($thunk-slot-spec
        (lambda () (set! events (cons 'last-metadata events)) (raise cause))))
      (set! events [])
      (check-exception (reflection.read-slot receiver 'first) (lambda (actual) (eq? actual cause)))
      (check-equal? (reverse events) '(last-metadata))
      (.putslot! last 'hidden ($constant-slot-spec #t))
      (set! events [])
      (check-equal? (reflection.read-slot receiver 'first) 5)
      (check-equal? (reverse events) '(first-metadata first-value)))
    (test-case "core receiver scopes preserve nested and inherited method ownership through FUN"
      (let* ((events []) (family (declared.make-reporting-family
                          (lambda (event) (set! events (cons event events)))))
             (action (declared.scoped-action family 2)))
        (check-equal? events [])
        (check-equal? (call/values (lambda () (action (.o rate: 10))) list) '(10 7 46))
        (check-equal? (reverse events)
          '(around-enter billing-before risk-before billing-primary base risk-after billing-after around-exit))
        (set! events [])
        (check-equal? (call/values (lambda () (action (.o rate: 20))) list) '(20 7 86))
        (check-equal? (length (filter (cut eq? <> 'base) events)) 1)
        (check-exception (reflection.read-slot family 'label) Error?)))
    (test-case "retained nested readers keep owners across clones revisions and independent local changes"
      (let* ((family (declared.make-family (lambda (_) (void))))
             (first (declared.make-scoped-account family 10))
             (copy (.cc first rate: 20))
             (old-nested (.@ first nested)) (copy-nested (.@ copy nested))
             (old-reader (.@ old-nested outer)))
        (check-equal? (old-reader) 10)
        (check-equal? (call/values (lambda () (.call copy-nested run 2)) list) '(20 7 86))
        (.putslot! first 'rate ($constant-slot-spec 30))
        (check-equal? (old-reader) 30)
        (check-equal? (call/values (lambda () (.call old-nested run 2)) list) '(30 7 126))
        (.putslot! old-nested 'rate ($constant-slot-spec 9))
        (check-equal? (call/values (lambda () (.call old-nested run 2)) list) '(30 9 126))
        (check-equal? (call/values (lambda () (.call copy-nested run 2)) list) '(20 7 86))))
    (test-case "standard receiver parameter rejects unbound scope and field assignment during expansion"
      (check (rejects? (%with-shared-slot-bindings (field) (parameter) field)) => #t)
      (check (rejects? (.o (field 1) (change (lambda () (set! field 2))))) => #t)
      (check (rejects? (.o (field 1) (read (lambda () field)))) => #f)
      (check-equal? (.get (.o (receiver 3) (field 7) (read (+ receiver field))) read) 10))
    (test-case "standard alternating lists preserve order false and payload identity"
      (let* ((payload (list 'shared)) (entries (list (cons label: #f) (cons callback: payload)))
             (encoded (alist->plist entries)) (decoded (plist->alist encoded)))
        (check-equal? encoded (list label: #f callback: payload))
        (check-equal? (map car decoded) '(label: callback:))
        (check (eq? (cdadr decoded) payload) => #t)
        (check-equal? (alist->plist []) [])
        (check-exception (plist->alist '(label:)) Error?)))
    (test-case "standard first-key removal needs distinct-key protocol invariants"
      (let* ((payload (list 'shared)) (kept (cons 'keep payload))
             (entries (list (cons 'first #f) kept (cons 'last 7))))
        (check-equal? (aremq 'first entries) (cdr entries))
        (check (eq? (car (aremq 'first entries)) kept) => #t)
        (check (eq? (aremq 'absent entries) entries) => #t)
        (check (eq? (cdr (car (arem '(shape) (list (cons '(shape) 1) kept)))) payload) => #t)
        ;; Deliberate negative control: standard removal is NOT remove-all.
        (check-equal? (aremq 'first '((first . 1) (first . 2))) '((first . 2)))))
    (test-case "checked FUN generic preserves escaped rest across both validation and dispatch"
      (let* ((events []) (family (declared.make-reporting-family
                         (lambda (event) (set! events (cons event events)))))
             (action (declared.checked-summary-action family 2)))
        (check-equal? (action (.o rate: 10)) '((10 2 #f review (payload: #f))))
        (check-equal? (action (.o rate: 20)) '((20 2 #f review (payload: #f))))
        (check-equal? (reverse events) '(summary summary))
        (check-exception (reflection.read-slot family 'label) Error?)))
    (test-case "standard lazy defaults preserve false and call fallback only on absence"
      (let ((table (make-hash-table-eq)) (calls 0))
        (hash-put! table 'false #f)
        (check-equal? (hash-ref/default table 'false (lambda () (set! calls (+ calls 1)) 'wrong)) #f)
        (check-equal? calls 0)
        (check-equal? (hash-ref/default table 'missing (lambda () (set! calls (+ calls 1)) 9)) 9)
        (check-equal? calls 1)
        (check (hash-key? table 'missing) => #f)))
    (test-case "standard ensure constructs once and does not retain a failed construction"
      (let ((table (make-hash-table-eq)) (calls 0) (cause (list 'failure)))
        (let (make (lambda () (set! calls (+ calls 1)) (list 'shape)))
          (let (first (hash-ensure-ref table 'shape make))
            (check (eq? first (hash-ensure-ref table 'shape make)) => #t)))
        (check-equal? calls 1)
        (check-exception (hash-ensure-ref table 'bad (lambda () (raise cause)))
                         (lambda (actual) (eq? actual cause)))
        (check (hash-key? table 'bad) => #f)
        (check-equal? (hash-ensure-ref table 'bad (lambda () #f)) #f)
        (check-equal? (hash-ensure-ref table 'bad (lambda () (error "false lost"))) #f)))
    (test-case "construction snapshots retain materialized absence and lazy unknown fallback"
      (let* ((calls 0)
             (source (.cc (graph.declaration '(present absent) []
                             (list (cons 'present (some (code.make-success #f)))))
                       .base: (lambda (key)
                         (set! calls (+ calls 1))
                         (if (eq? key 'present) (some (code.make-success #f)) #f))))
             (snapshot (cache.start source)))
        (set! calls 0)
        (check-equal? (cached-value snapshot 'present) #f)
        (check-equal? (cache.cache-ref snapshot 'absent) #f)
        (check-equal? (.call (cache.cache-source snapshot) .base 'absent) #f)
        (check-equal? (.call (cache.cache-source snapshot) .code 'absent) #f)
        (check-equal? calls 0)
        (check-equal? (cache.cache-ref snapshot 'unknown) #f)
        (check-equal? calls 1)))
    (test-case "generated class fields retain receiver revision layout and zero index guards"
      (let* ((initial (make-hash-table-eq)) (owner (list 'owner)) (site (make-slot-cache 'value)))
        (hash-put! initial 'value #f)
        (let* ((left (make-slot-layout '(value) initial 'missing))
               (right (make-slot-layout '(value value) initial 'missing)))
          (check (eq? (slot-layout-shape left) (slot-layout-shape right)) => #t)
          (slot-cache-bind! site owner 1 left 0)
          (check-equal? (slot-cache-hit? site owner 1 left) 0)
          (check-equal? (slot-cache-read site) #f)
          (check-equal? (slot-cache-hit? site owner 2 left) #f)
          (check-equal? (slot-cache-hit? site owner 1 right) #f)
          (slot-layout-put! left 'value 7)
          (check-equal? (slot-cache-read site) 7))))
    (test-case "ordered list builders preserve paths and every diagnostic per child"
      (let* ((calls []) (field (lambda (_type value path)
                      (set! calls (cons value calls))
                      (list (.o bind-these: #f kind: 'first path: path) (.o bind-these: #f kind: 'second path: path))))
             (issues (containers.list-shape Any Integer '(3 4) '(rows) field)))
        (check-equal? (reverse calls) '(3 4))
        (check-equal? (map (lambda (issue) (.get issue kind)) issues) '(first second first second))
        (check-equal? (map (lambda (issue) (.get issue path)) issues) '((rows 0) (rows 0) (rows 1) (rows 1))))
      (let (calls [])
        (containers.tuple-shape Any (vector Integer Integer) (vector 3 4) []
          (lambda (_type value _path) (set! calls (cons value calls)) []))
        (check-equal? (reverse calls) '(3 4))))
    (test-case "malformed container and class shapes never invoke normalization"
      (let* ((calls 0) (child (.cc Type. .element?: (lambda (_) #t)
                               .validate: (lambda (value) (set! calls (+ calls 1)) value))))
        (check-exception (validate (Tuple child child) (vector 1)) TypeError?)
        (check-exception (validate (List child) '(1 . 2)) TypeError?)
        (check-exception (validate (Record first: [child] required: [Integer]) (.o first: 1)) TypeError?)
        (check-equal? calls 0)))
    (test-case "std instance Iterable binds inherited Record descriptors and wraps lazily"
      (let* ((calls 0) (method (Fun UInt <- Integer))
             (tracked (.cc method .validate: (lambda (value) (set! calls (+ calls 1)) (validate method value))))
             (base (Record run: [tracked default: abs]))
             (left (Record [base] left: [Integer default: 1]))
             (right (Record [base] right: [Integer default: 2]))
             (diamond (Record [left right]))
             (rows (list (instance diamond) (instance diamond)))
             (collection (service.make-services diamond rows)) (cursor (iter collection)))
        (check-equal? calls 0)
        (using (cursor :- Iterator)
          (let (first (cursor.next!))
            (check-equal? calls 1)
            (check-equal? ((.get first run) -3) 3)
            (check-exception ((.get first run) #f) TypeError?))
          (cursor.next!) (check-equal? calls 2)
          (check-equal? (cursor.next!) #!eof) (check-equal? calls 2))))
    (test-case "cached inherited rows are rechecked after selective source revision"
      (let* ((descriptor (Record run: [(Fun UInt <- Integer)]))
             (raw (list (.o run: abs)))
             (source (graph.declaration '(rows source) (list (cons 'rows (code.need 'source identity)))
                       (list (cons 'source (some (code.make-success raw))))))
             (old (cache.start source)) (calls 0)
             (consume (lambda (checked) (set! calls (+ calls 1)) ((.get checked run) -4))))
        (check-equal? (service.observe-cached-services old 'rows descriptor consume) '(4))
        (let* ((edited (graph.set-base (cache.cache-source old) 'source
                         (some (code.make-success (list (.o run: #f))))))
               (next (cache.refresh old edited)))
          (check-exception (service.observe-cached-services next 'rows descriptor consume) TypeError?)
          (check-equal? calls 1)
          (check-equal? (service.observe-cached-services old 'rows descriptor consume) '(4))
          (check-equal? calls 2))))
    (test-case "iterator consumer errors retain identity and previous effects"
      (let* ((cause (list 'consumer)) (calls 0) (descriptor (Record value: [Integer])))
        (check-exception
          (service.observe-services descriptor (list (.o value: 1) (.o value: 2))
            (lambda (checked) (set! calls (+ calls 1))
              (if (= (.get checked value) 2) (raise cause) (.get checked value))))
          (lambda (actual) (eq? actual cause)))
        (check-equal? calls 2)))
    (test-case "direct core C4 retains the shared diamond and hook order"
      (let* ((root (.o base: 1)) (left (.o inherit: [root] left: 2))
             (right (.o inherit: [root] right: 3)) (child (.o inherit: [left right] leaf: 4)))
        (let-values (((native suffix) (c4-linearize* [child] (list (object-supers child))
                       suffix: (lambda (_) #f) get-precedence-list: compute-precedence-list!))
                     ((wrapper _) (c4-linearize [child] (object-supers child)
                       get-precedence-list: compute-precedence-list!)))
          (check-equal? suffix #f)
          (check-equal? native (list child left right root))
          (check-equal? wrapper native)
          (check-equal? (compute-precedence-list! child) native))
        (check-equal? (.all-slots child) '(base right left leaf))))
    (test-case "standard first-occurrence merge retains slot order and symbol identity"
      (let* ((a (string->uninterned-symbol "same")) (b (string->uninterned-symbol "same"))
             (groups (list (list 'child a) (list 'base b 'child) (list 'base a))))
        (check-equal? (merge-super-slots groups) (list 'base a b 'child))
        (check (eq? a b) => #f)
        (check-equal? (merge-super-slots []) [])))
    (test-case "private child declaration shadows public ancestor before visibility filtering"
      (let* ((forced 0)
             (root (reflection.object<-declarations
                     (list (cons 'label (instance Slot constant: 'public)))))
             (metadata (instance Slot hidden: #t compute: (lambda (_ _next) (set! forced (+ forced 1)) 'private)))
             (child (reflection.object<-declarations (list (cons 'label metadata)) supers: [root])))
        (check-equal? (reflection.reflect-slots child) [])
        (check-equal? forced 0)
        (check-equal? (length (reflection.reflect-slots child include-hidden?: #t)) 1)
        (check-exception (reflection.read-slot child 'label) Error?)
        (check-equal? forced 0)
        (.putslot! metadata 'hidden ($constant-slot-spec #f))
        (check (eq? (cdr (car (reflection.reflect-slots child))) metadata) => #t)
        (check-equal? (reflection.read-slot child 'label) 'private)
        (check-equal? forced 1)))
    (test-case "lexical identifiers deduplicate by binding rather than printed datum"
      (let (value 3) (check-equal? (two-scopes value) 14))
      (check-equal? (with-slots (value value) (.o value: 8) (+ value value)) 16))
    (test-case "standard identifier-list admission rejects malformed bind syntax"
      (check (rejects? (.o bind: () value: 1)) => #f)
      (check (rejects? (.o bind: (x x) value: 1)) => #f)
      (check (rejects? (.o bind: (x . rest) value: 1)) => #t)
      (check (rejects? (.o bind: (x 1) value: 1)) => #t))
    (test-case "method constructor and Boolean refusals retain the original error family"
      (for-each (lambda (action)
                  (let (cause (caught action))
                    (check (Error? cause) => #t)
                    (check (contract-violation-error? cause) => #f)))
        (list (lambda () (method.primary #f)) (lambda () (method.forward-primary #f))
              (lambda () (method.simula-body values #f))
              (lambda () (method.simple-effective method.all-policy [(method.item (lambda () 'truthy))] []))))
      (let (cause (caught (lambda () (method.simple-effective method.all-policy
                                      [(method.item (lambda () 'truthy))] []))))
        (check-equal? (error-message cause) "simple Boolean item required")))
    (test-case "cached dispatch rechecks Boolean guards and negative assumptions per invocation"
      (let* ((calls 0) (path (list (dispatch.prototype 'Service)))
             (generic (dispatch.register-when
                        (dispatch.make [Any] Any (lambda (_) '((Service)))
                          (lambda (methods args) (map (lambda (body) (apply body args)) methods)))
                        path (lambda (value) (set! calls (+ calls 1)) (> value 0)) identity)))
        (let-values (((low warm) (dispatch.call generic 0)))
          (let-values (((high _warmer) (dispatch.call warm 2)))
            (check-equal? low []) (check-equal? high '(2)) (check-equal? calls 2))
          (extension.check warm [(extension.call 0)])
          (check-exception (extension.check warm [(extension.call 2)]) extension.conflict?)
          (check-equal? calls 4))))
    (test-case "guard exceptions retain identity and do not invoke a method body"
      (let* ((cause (caught (lambda () (using (x #f :~ procedure?) x)))) (bodies 0)
             (generic (dispatch.register-when
                        (dispatch.make [Any] Any (lambda (_) '((Service))))
                        [(dispatch.prototype 'Service)] (lambda (_) (raise cause))
                        (lambda (value) (set! bodies (+ bodies 1)) value))))
        (check-exception (dispatch.call generic 1) (lambda (actual) (eq? actual cause)))
        (check-equal? bodies 0)))
    (test-case "inherited reflection keyword forwarding and FUN observations compose"
      (let* ((events []) (family (declared.make-reporting-family (lambda (event) (set! events (cons event events)))))
             (action (declared.summary-action family 2)))
        (check (memq 'label (.get family .public-slots)) => #f)
        (check (not (not (memq 'label (.get family .private-slots)))) => #t)
        (check-equal? events [])
        (let-values (((charge rows) (action (.o rate: 10))))
          (check-equal? charge 46)
          (check-equal? rows '((10 2 #f review (audit)))))
        (let-values (((charge rows) (action (.o rate: 20))))
          (check-equal? charge 86)
          (check-equal? rows '((20 2 #f review (audit)))))
        (check-equal? (length (filter (lambda (event) (eq? event 'base)) events)) 2)))))
