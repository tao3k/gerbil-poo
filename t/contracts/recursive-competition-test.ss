;;; Repeated drift and competing joint requests with lossless per-attempt receipts.
(export recursive-competition-test)
(import :std/test :std/error (only-in :std/list/list take drop) :clan/poo/object :clan/poo/mop
        (prefix-in :clan/poo/recursive-validation graph.)
        (prefix-in :clan/poo/recursive-publication publication.)
        (prefix-in :clan/poo/recursive-approvals approvals.)
        (prefix-in :clan/poo/examples/recursive-approvals service.)
        (prefix-in :clan/poo/examples/recursive-competition workflow.)
        (prefix-in :clan/poo/examples/recursive-topology topology.)
        (prefix-in :clan/poo/declarative-metadata metadata.))

;; Preserve the exact phase; a callback error must not masquerade as graph refusal.
(def (phase? expected)
  (lambda (cause) (and (graph.validation-failure? cause)
    (eq? expected (graph.validation-failure-kind cause)))))

;; Compare existing guard messages separately from admission and observer failures.
(def (message? expected)
  (lambda (cause) (and (Error? cause) (equal? (error-message cause) expected))))

;; Independent input/output policies compose with exact per-entry evidence binding.
(def Call (metadata.contract (metadata.predicate "object" object?)
  (metadata.predicate "evidence" object?) (lambda (_ _request _result) #t) metadata.truth))

;; A normal observer return can contain refusal; it is not an exception receipt.
(def Refusing (metadata.contract (metadata.predicate "object" object?)
  (metadata.predicate "evidence" object?) (lambda (_ _request _result) #f) (metadata.atom 'policy)))

;; Verify association, actual observed head and the original exception together.
(def (check-refusal receipt request expected predicate)
  (check (eq? request (approvals.attempt-request receipt)) => #t)
  (check (eq? expected (approvals.attempt-snapshot receipt)) => #t)
  (check (approvals.attempt-failed? receipt) => #t)
  (check-equal? (approvals.attempt-values receipt) [])
  (check (predicate (approvals.attempt-failure receipt)) => #t))

;; Every round reuses the previously losing future proposal, then subjects its
;; explicitly refreshed requests to two separate drift windows before publication.
(def recursive-competition-test
  (test-suite "competing recursive joint revisions"
    (test-case "two restaging windows and competing future proposals across eight rounds"
      (let* ((first (topology.initial))
             (initial-policy (service.policy topology.original (make-vector 8 'primary) 'ingress 82))
             (owner (publication.publication first metadata: initial-policy))
             (idle (graph.closed-ref first 'idle)) (idle-type (graph.closed-type first 'idle))
             (initial-root (graph.closed-ref first 'report)) (initial-type (graph.closed-type first 'report))
             (contexts (vector (.o entry: 'deploy commits: 0) (.o entry: 'audit commits: 0)
                               (.o entry: 'repair commits: 0))))
        (let loop ((policies (workflow.transitions)) (history []) (round 0))
          (if (null? policies)
            (begin
              (check-equal? (map (lambda (context) (.get context commits)) (vector->list contexts)) '(3 3 2))
              (check (eq? idle (validate idle-type idle)) => #t)
              (check-exception (validate initial-type initial-root) (phase? 'stale)))
            (let* ((proposed (car policies)) (future (if (pair? (cdr policies)) (cadr policies) proposed))
                   (before (publication.snapshot owner)) (old-graph (publication.snapshot-graph before))
                   (old-policy (publication.snapshot-metadata before))
                   (root (graph.closed-ref old-graph 'report)) (type (graph.closed-type old-graph 'report))
                   (p0 (service.stage-transition owner proposed)) (same-policy (service.stage-transition owner proposed))
                   (q0 (service.stage-transition owner future)) (observations 0) (joint-checks 0)
                   (entry (modulo round 3)) (other (modulo (+ entry 1) 3))
                   (context (vector-ref contexts entry)) (other-context (vector-ref contexts other))
                   (observer (lambda (state)
                     (set! observations (+ observations 1)) ((service.entry-action Refusing context) state))))
              (.put! proposed 'budget 201)
              (.put! proposed 'budget 200)
              (for-each (lambda (receipt request)
                (check-refusal receipt request before (message? "stale or invalid lens checks")))
                (approvals.submit-sequence! owner (map (lambda (request) (cons request observer)) (list p0 same-policy)))
                (list p0 same-policy))
              (let* ((p1 (service.stage-transition owner proposed)) (q1 (service.stage-transition owner future)))
                (.put! old-policy 'budget 201)
                (.put! old-policy 'budget 200)
                (for-each (lambda (receipt request)
                  (check-refusal receipt request before (message? "stale or invalid lens checks")))
                  (approvals.submit-sequence! owner (map (lambda (request) (cons request observer)) (list p1 q1 q0)))
                  (list p1 q1 q0))
                (let* ((bad (.cc proposed budget: (- (.get proposed expected) 1)))
                       (refused (service.stage-transition owner bad admit: (lambda (old next candidate)
                         (set! joint-checks (+ joint-checks 1))
                         (check (service.local-admit? next candidate) => #t)
                         (service.joint-admit? old next candidate))))
                       (winner (service.stage-transition owner proposed))
                       (challenger (service.stage-transition owner future)))
                  (check-refusal (car (approvals.submit-sequence! owner [(cons refused observer)]))
                    refused before (phase? 'joint-admission))
                  (check (eq? root (validate type root)) => #t)
                  (check-equal? observations 0)
                  (let* ((pending (append history (list p0 same-policy q0 p1 q1)))
                         (trace (workflow.compete! owner pending refused winner challenger observer))
                         (installed (publication.snapshot owner))
                         (offset (length pending)) (won (list-ref trace (+ offset 1))))
                    (check-equal? (length trace) (+ offset 4))
                    (for-each (lambda (receipt request)
                      (check-refusal receipt request before (message? "stale recursive approval snapshot")))
                      (take trace (length history)) history)
                    (for-each (lambda (receipt request)
                      (check-refusal receipt request before (message? "stale or invalid lens checks")))
                      (take (drop trace (length history)) 5) (list p0 same-policy q0 p1 q1))
                    (check-refusal (list-ref trace offset) refused before (phase? 'joint-admission))
                    (check (eq? winner (approvals.attempt-request won)) => #t)
                    (check (eq? installed (approvals.attempt-snapshot won)) => #t)
                    (check (approvals.attempt-failed? won) => #f)
                    (check (approvals.attempt-failure won) => #f)
                    (check-equal? (length (approvals.attempt-values won)) 3)
                    (check (eq? context (cadr (approvals.attempt-values won))) => #t)
                    (check-equal? (metadata.failure-phase (caddr (approvals.attempt-values won))) 'logic)
                    (check-refusal (list-ref trace (+ offset 2)) challenger installed (message? "stale recursive approval snapshot"))
                    (check-refusal (list-ref trace (+ offset 3)) winner installed (message? "stale recursive approval snapshot"))
                    (check-equal? joint-checks 2)
                    (check-equal? observations 1)
                    (check (eq? proposed (publication.snapshot-metadata installed)) => #t)
                    (check-exception (validate type root) (phase? 'stale))
                    (let-values (((accepted next refusal) (approvals.observe! owner (service.entry-action Call context))))
                      (check refusal => #f)
                      (check-equal? (.get accepted total) (.get proposed expected))
                      (vector-set! contexts entry next))
                    (check (eq? other-context (vector-ref contexts other)) => #t)
                    (loop (cdr policies) (append (list winner challenger refused) history) (+ round 1))))))))))
    (test-case "observer exception keeps its installed head and later attempts still run"
      (let* ((owner (publication.publication (topology.initial)
                     metadata: (service.policy topology.original (make-vector 8 'primary) 'ingress 82)))
             (proposed (service.policy topology.original (make-vector 8 'primary) 'delivery 89))
             (first (service.stage-transition owner proposed)) (later (service.stage-transition owner proposed))
             (trace (approvals.submit-sequence! owner
               (list (cons first (lambda (_) (raise 'observer-failed))) (cons later values))))
             (installed (publication.snapshot owner)))
        (check-refusal (car trace) first installed (lambda (cause) (eq? cause 'observer-failed)))
        (check-refusal (cadr trace) later installed (message? "stale recursive approval snapshot"))
        (check-equal? (.get (graph.closed-ref (publication.current owner) 'report) total) 89)
        (let-values (((accepted next refusal) (approvals.observe! owner (service.entry-action Call (.o commits: 0)))))
          (check refusal => #f) (check-equal? (.get accepted total) 89) (check-equal? (.get next commits) 1))))
    (test-case "preflight is complete and original queue mutation cannot rewrite later attempts"
      (let* ((owner (publication.publication (topology.initial)
                     metadata: (service.policy topology.original (make-vector 8 'primary) 'ingress 82)))
             (before (publication.snapshot owner))
             (proposed (service.policy topology.original (make-vector 8 'primary) 'delivery 89))
             (first (service.stage-transition owner proposed)) (later (service.stage-transition owner proposed))
             (second (cons later values)))
        (check-exception (approvals.submit-sequence! owner (list (cons first values) 'invalid))
          (message? "recursive submission requires request and observer procedures"))
        (check (eq? before (publication.snapshot owner)) => #t)
        (let* ((trace (approvals.submit-sequence! owner
            (list (cons first (lambda (_) (set-car! second (lambda (_) (raise 'rewritten))) (values #f 'saved))) second))))
          (check-equal? (approvals.attempt-values (car trace)) '(#f saved))
          (check (approvals.attempt-failure (car trace)) => #f)
          (check-refusal (cadr trace) later (publication.snapshot owner) (message? "stale recursive approval snapshot")))))
    (test-case "a raised false remains distinct from a normal zero-value return"
      (let* ((owner (publication.publication (topology.initial)
                     metadata: (service.policy topology.original (make-vector 8 'primary) 'ingress 82)))
             (proposed (service.policy topology.original (make-vector 8 'primary) 'delivery 89))
             (request (service.stage-transition owner proposed))
             (raised (car (approvals.submit-sequence! owner [(cons request (lambda (_) (raise #f)))]))))
        (check (approvals.attempt-failed? raised) => #t)
        (check (approvals.attempt-failure raised) => #f)
        (check-equal? (approvals.attempt-values raised) [])
        (check (eq? (approvals.attempt-snapshot raised) (publication.snapshot owner)) => #t)
        (let* ((fresh (service.stage-transition owner proposed))
               (normal (car (approvals.submit-sequence! owner [(cons fresh (lambda (_) (values)))]))))
          (check (approvals.attempt-failed? normal) => #f)
          (check (approvals.attempt-failure normal) => #f)
          (check-equal? (approvals.attempt-values normal) []))))))
