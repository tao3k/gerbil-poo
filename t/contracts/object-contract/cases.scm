;;; Public value contracts: POO Type, object slots and checked invocation.



(define-type (Port @ Type.)
  .element?: (lambda (value) (and (exact-integer? value) (<= 1 value 65535))))

(def object-contract-test
  (test-suite "Structural object contracts without a consuming framework"
    (test-case "Type membership and validation are adapted, not redefined"
      (def type (as-value-contract String))
      (check-equal? (element? type "web") #t)
      (check-equal? (diagnose type "web") '())
      (check-equal? (validate type "web") "web")
      (check-equal? (element? type 7) #f)
      (check-equal? (.get (car (diagnose type 7 '(name))) kind) 'type-rejected)
      (check-equal? (.get (car (diagnose type 7 '(name))) path) '(name))
      (check-exception (validate type 7) TypeError?)
      (check-exception (as-value-contract 7) TypeError?))
    (test-case "Function validation retains the upstream checked wrapper"
      (def contract (as-value-contract (Fun Bool <- Bool)))
      (def calls 0)
      (def checked (validate contract (lambda (value) (set! calls (+ calls 1)) value)))
      (check-equal? (checked #t) #t)
      (check-equal? calls 1)
      (check-exception (checked "wrong input") TypeError?)
      (check-equal? calls 1)
      (def bad-output (validate contract (lambda (_value) "wrong output")))
      (check-exception (bad-output #t) TypeError?))
    (test-case "structural fields accept independent objects and retain identity"
      (def contract (.cc ObjectContract. responsibilities: (.o name: String port: Port)))
      (def value (.o name: "api" port: 8080))
      (check-equal? (diagnose contract value) '())
      (check-equal? (element? contract value) #t)
      (check-equal? (eq? (validate contract value) value) #t)
      (check-equal? (as-value-contract contract) contract)
      (check-equal? (.get (car (diagnose contract (.o name: "api"))) kind) 'missing-field)
      (check-equal? (.get (car (diagnose contract (.o name: "api"))) path) '(port)))
    (test-case "spelling rejection does not demand the unknown field"
      (def demanded 0)
      (def contract (.cc ObjectContract. responsibilities: (.o port: Port)))
      (def value (.o port: 8080 prot: (begin (set! demanded (+ demanded 1)) 80)))
      (def failures (diagnose contract value '(service)))
      (check-equal? (.get (car failures) kind) 'unknown-field)
      (check-equal? (.get (car failures) path) '(service prot))
      (check-equal? demanded 0)
      (check-equal? (element? contract value) #f))
    (test-case "nested responsibility paths compose without another object representation"
      (def service-type (.cc ObjectContract. responsibilities: (.o port: Port)))
      (def root (.cc ObjectContract. responsibilities: (.o service: service-type)))
      (check-equal? (element? root (.o service: (.o port: 80))) #t)
      (def failures (diagnose root (.o service: (.o port: "bad")) '(config)))
      (check-equal? (.get (car failures) path) '(config service port))
      (check-equal? (eq? (.get root prepared-responsibilities service) service-type) #t))
    (test-case "ancestry is optional and checked before candidate slot demand"
      (def base (.o name: "base"))
      (def structural (.cc ObjectContract. responsibilities: (.o name: String)))
      (def nominal (.cc structural required-prototype: base))
      (.def (derived @ base) name: "derived")
      (check-equal? (element? structural (.o name: "independent")) #t)
      (check-equal? (element? nominal (.o name: "independent")) #f)
      (check-equal? (element? nominal derived) #t)
      (def unrelated (.o name: (error "Rejected prototype must not demand this field")))
      (check-equal? (.get (car (diagnose nominal unrelated)) kind) 'prototype-mismatch)
      (check-equal? (.get (car (diagnose structural 7)) kind) 'expected-object))
    (test-case "parent prepared map does not mask derived responsibilities"
      (def parent (.cc ObjectContract. responsibilities: (.o value: String)))
      (def prepared (.get parent prepared-responsibilities))
      (.def (child @ parent) responsibilities: =>.+ (.o value: Bool))
      (check-equal? (element? parent (.o value: "text")) #t)
      (check-equal? (element? child (.o value: #t)) #t)
      (check-equal? (element? child (.o value: "text")) #f)
      (check-equal? (eq? prepared (.get child prepared-responsibilities)) #f)
      (def copied (.cc child responsibilities: (.o value: Port)))
      (check-equal? (element? copied (.o value: 80)) #t)
      (check-equal? (element? copied (.o value: #t)) #f))
    (test-case "derived constraints are prepared for the effective descriptor"
      (def first (.cc Type. .element?: (lambda (value) (= (.get value port) 80))))
      (def second (.cc Type. .element?: (lambda (value) (= (.get value port) 443))))
      (def parent (.cc ObjectContract. extra-fields: 'delegate constraints: (list first)))
      (def prepared (.get parent prepared-constraints))
      (def child (.cc parent constraints: (list second)))
      (check-equal? (element? parent (.o port: 80)) #t)
      (check-equal? (element? child (.o port: 443)) #t)
      (check-equal? (element? child (.o port: 80)) #f)
      (check-equal? (eq? prepared (.get child prepared-constraints)) #f))
    (test-case "external diagnostic Types are reused and may own optional fields"
      (def external
        (.cc Type.
          .element?: (lambda (value) (and (object? value) (.slot? value 'port)
                                        (element? Port (.get value port))))
          .diagnose: (lambda (value location)
                       (if (and (object? value) (.slot? value 'port)
                                (element? Port (.get value port)))
                         '() (list (.o kind: 'external-rejected path: location))))))
      (def contract (.cc ObjectContract. extra-fields: 'delegate constraints: (list external)))
      (check-equal? (eq? (as-value-contract external) external) #t)
      (check-equal? (element? contract (.o port: 443)) #t)
      (check-equal? (.get (car (diagnose contract (.o port: "bad"))) kind) 'external-rejected))
    (test-case "plain Types also adapt as whole-object constraints"
      (def port-bearing
        (.cc Type. .element?: (lambda (value) (and (.slot? value 'port)
                                                  (element? Port (.get value port))))))
      (def contract (.cc ObjectContract. extra-fields: 'delegate constraints: (list port-bearing)))
      (check-equal? (element? contract (.o port: 80)) #t)
      (check-equal? (.get (car (diagnose contract (.o port: 0))) kind) 'type-rejected))
    (test-case "obligations run only after structural and constraint checks"
      (def calls 0)
      (def contract
        (.cc ObjectContract. responsibilities: (.o port: Port)
          obligations: (lambda (value location)
                         (set! calls (+ calls 1))
                         (if (= (.get value port) 443) '()
                           (list (.o kind: 'requires-tls path: location))))))
      (check-equal? (element? contract (.o port: "bad")) #f)
      (check-equal? calls 0)
      (check-equal? (.get (car (diagnose contract (.o port: 80))) kind) 'requires-tls)
      (check-equal? calls 1)
      (check-equal? (diagnose contract (.o port: 443)) '())
      (check-equal? calls 2))
    (test-case "bad declarations and callbacks remain programming errors"
      (check-exception (diagnose (.cc ObjectContract. responsibilities: 7) (.o)) error?)
      (check-exception (diagnose (.cc ObjectContract. responsibilities: (.o port: 7)) (.o port: 80)) TypeError?)
      (check-exception (diagnose (.cc ObjectContract. extra-fields: 'allow) (.o)) error?)
      (check-exception (diagnose (.cc ObjectContract. extra-fields: 'delegate) (.o)) error?)
      (check-exception (diagnose (.cc ObjectContract. constraints: 7) (.o)) error?)
      (check-exception (diagnose (.cc ObjectContract. required-prototype: 7) (.o)) error?)
      (check-exception (diagnose ObjectContract. (.o) 'bad-path) error?)
      (check-exception (as-value-contract (.cc Type. .element?: object? .diagnose: 7)) error?)
      (check-exception (diagnose (.cc ObjectContract. obligations: 7) (.o)) error?)
      (check-exception (diagnose (.cc ObjectContract. obligations: (lambda (_v _p) #t)) (.o)) error?)
      (check-exception (diagnose (.cc ObjectContract. obligations: (lambda (_v _p) (list 7))) (.o)) error?)
      (def cause (list 'callback-error))
      (def broken (.cc ObjectContract. obligations: (lambda (_v _p) (raise cause))))
      (def actual (try (diagnose broken (.o)) #f (catch (value) value)))
      (check-equal? (eq? actual cause) #t))
    (test-case "existing invocation Contract checks structural input and output"
      (def object-type (.cc ObjectContract. responsibilities: (.o port: Port)))
      (def contract
        (metadata.contract (metadata.typed "service input" object-type)
                           (metadata.typed "boolean output" Bool)
                           (lambda (_atom _args _result) #t) metadata.truth))
      (def calls 0)
      (def (execute _value) (set! calls (+ calls 1)) (values #t 'current-state))
      (defvalues (result state) (metadata.invoke contract execute (.o port: 443)))
      (check-equal? result #t)
      (check-equal? state 'current-state)
      (check-exception (metadata.invoke contract execute (.o port: "bad")) metadata.failure?)
      (check-equal? calls 1)
      (check-exception
        (metadata.invoke contract (lambda (_value) (values "bad output" 'state)) (.o port: 443))
        metadata.failure?))
    (test-case "parent resource cache retains the child's effective configuration"
      (.def (parent @ [] config)
        config: (.o port: 80)
        resource: (.o target-port: (.get config port)))
      (def cached (.get parent resource target-port))
      (.def (child @ parent) config: =>.+ (.o port: 443))
      (def contract (.cc ObjectContract. responsibilities: (.o port: Port)))
      (check-equal? cached 80)
      (check-equal? (.get child resource target-port) 443)
      (check-equal? (.get parent resource target-port) 80)
      (check-equal? (diagnose contract (.get child config)) '()))))

;; Return the original suites from this lexical scope.
(values object-contract-test)
