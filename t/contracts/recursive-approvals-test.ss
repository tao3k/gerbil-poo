;;; One authoritative graph/approval pair across entry points and revision rounds.
(export recursive-approvals-test)
(import :std/test :std/error :clan/poo/object :clan/poo/mop :clan/poo/number (only-in :clan/poo/type Record)
        (prefix-in :clan/poo/recursive-validation graph.)
        (prefix-in :clan/poo/recursive-staging staging.)
        (prefix-in :clan/poo/recursive-publication publication.)
        (prefix-in :clan/poo/recursive-approvals approvals.)
        (prefix-in :clan/poo/examples/recursive-approvals service.)
        (prefix-in :clan/poo/examples/recursive-topology topology.)
        (prefix-in :clan/poo/declarative-metadata metadata.))

;; Match the actual closure phase, retaining admission versus stale distinctions.
(def (phase? expected)
  (lambda (cause) (and (graph.validation-failure? cause)
    (eq? expected (graph.validation-failure-kind cause)))))

;; Match only the existing snapshot/version guard errors, not arbitrary callbacks.
(def (message? expected)
  (lambda (cause) (and (Error? cause) (equal? (error-message cause) expected))))

;; Admission remains independent of exact subject/descriptor/entry-context binding.
(def Call (metadata.contract (metadata.predicate "object" object?)
  (metadata.predicate "evidence" object?) (lambda (_ _request _result) #t) metadata.truth))

;; Isolate late effect refusal after successful joint graph/metadata publication.
(def Refusing (metadata.contract (metadata.predicate "object" object?)
  (metadata.predicate "evidence" object?) (lambda (_ _request _result) #f) (metadata.atom 'policy)))

;; A metadata-only request still uses complete graph admission and selective reuse.
(def (metadata-request owner proposed)
  (approvals.stage-with owner proposed
    (lambda (current admit)
      ((staging.restaging-action (lambda (_) (values [] [] [])) admit: admit) current))
    service.joint-admit?))

;; Three entries share installed/proposed metadata across eight SCC/provider/reader
;; revisions, then an approval-only round. All retries capture the actual whole head.
(def recursive-approvals-test
  (test-suite "recursive graph and shared approvals"
    (test-case "joint refusal ABA invalidation restaging and entry retries across rounds"
      (let* ((providers (make-vector 8 'primary))
             (initial-policy (service.policy topology.original providers 'ingress 82))
             (first (topology.initial))
             (owner (publication.publication first metadata: initial-policy))
             (initial-root (graph.closed-ref first 'report)) (initial-type (graph.closed-type first 'report))
             (idle (graph.closed-ref first 'idle)) (idle-type (graph.closed-type first 'idle))
             (contexts (vector (.o entry: 'deploy commits: 0) (.o entry: 'audit commits: 0)
                               (.o entry: 'repair commits: 0)))
             (secondary (make-vector 8 'secondary))
             (mixed '#(secondary secondary secondary secondary primary primary primary primary))
             (rows (list (list topology.merged mixed 'notify 108 2)
               (list topology.split secondary 'auth 128 2)
               (list topology.crossed secondary 'cache 132 2)
               (list topology.original providers 'ingress 82 2)
               (list topology.merged mixed 'notify 108 2)
               (list topology.split secondary 'auth 128 2)
               (list topology.original secondary 'delivery 134 2)
               (list topology.original secondary 'delivery 135 3))))
        (let loop ((rows rows) (history []) (round 0))
          (if (null? rows)
            (let* ((before (publication.snapshot owner)) (graph (publication.snapshot-graph before))
                   (old-policy (publication.snapshot-metadata before))
                   (proposed (.cc old-policy budget: 999))
                   (pending (metadata-request owner old-policy))
                   (request (metadata-request owner proposed))
                   (root (graph.closed-ref graph 'report)) (type (graph.closed-type graph 'report)))
              (approvals.submit! owner request values)
              (check (eq? proposed (publication.snapshot-metadata (publication.snapshot owner))) => #t)
              (check-equal? (graph.closed-evaluated (publication.current owner)) [])
              (check (eq? root (validate type root)) => #t)
              (check-exception (approvals.submit! owner pending values)
                (message? "stale recursive approval snapshot"))
              (check (eq? idle (validate idle-type idle)) => #t)
              (check-exception (validate initial-type initial-root) (phase? 'stale))
              (check-equal? (map (lambda (value) (.get value commits)) (vector->list contexts)) '(3 3 2)))
            (let* ((row (car rows)) (expected (cadddr row))
                   (proposed (service.policy (car row) (cadr row) (caddr row) expected 200 (car (cddddr row))))
                   (bad (.cc proposed budget: (- expected 1)))
                   (before (publication.snapshot owner)) (graph (publication.snapshot-graph before))
                   (root (graph.closed-ref graph 'report)) (type (graph.closed-type graph 'report))
                   (calls 0) (observations 0) (local-pass #f) (leaked #f) (leaked-root #f) (leaked-type #f)
                   (pending (service.stage-transition owner proposed admit: (lambda (old next candidate)
                     (set! calls (+ calls 1)) (service.joint-admit? old next candidate))))
                   (failed (service.stage-transition owner bad admit: (lambda (old next candidate)
                     (set! local-pass (service.local-admit? next candidate))
                     (set! leaked candidate)
                     (set! leaked-root (graph.closed-ref candidate 'report))
                     (set! leaked-type (graph.closed-type candidate 'report))
                     (service.joint-admit? old next candidate))))
                   (selected (modulo round 3)) (other (modulo (+ selected 1) 3))
                   (context (vector-ref contexts selected)) (other-context (vector-ref contexts other))
                   (unreachable (lambda (_) (set! observations (+ observations 1)) (raise 'observer-ran))))
              (for-each (lambda (request)
                (check-exception (approvals.submit! owner request unreachable)
                  (message? "stale recursive approval snapshot"))) history)
              (check-exception (approvals.submit! owner failed unreachable) (phase? 'joint-admission))
              (check local-pass => #t)
              (check (eq? before (publication.snapshot owner)) => #t)
              (check (eq? root (validate type root)) => #t)
              (check-exception (graph.closed-ref leaked 'report) (phase? 'stale))
              (check-exception (validate leaked-type leaked-root) (phase? 'reference))
              (.put! proposed 'budget 201)
              (.put! proposed 'budget 200)
              (check-exception (approvals.submit! owner pending unreachable)
                (message? "stale or invalid lens checks"))
              (check-equal? calls 0)
              (check-equal? observations 0)
              ;; Capture a fresh proposal version, then invalidate ONLY installed
              ;; metadata. Equal restored values must not authorize this request.
              (let* ((installed-drift (service.stage-transition owner proposed))
                     (installed-policy (publication.snapshot-metadata before)))
                (.put! installed-policy 'budget 201)
                (.put! installed-policy 'budget 200)
                (check-exception (approvals.submit! owner installed-drift unreachable)
                  (message? "stale or invalid lens checks")))
              (check (eq? before (publication.snapshot owner)) => #t)
              (let* ((retry (service.stage-transition owner proposed)))
                (let-values (((_ kept refusal) (approvals.submit! owner retry (service.entry-action Refusing context))))
                  (check (eq? kept context) => #t)
                  (check-equal? (metadata.failure-phase refusal) 'logic)
                  (check (eq? proposed (publication.snapshot-metadata (publication.snapshot owner))) => #t)
                  (check-equal? (.get (graph.closed-ref (publication.current owner) 'report) total) expected)
                  (check-exception (validate type root) (phase? 'stale))
                  (check-exception (approvals.submit! owner pending unreachable)
                    (message? "stale recursive approval snapshot"))
                  (let-values (((accepted next refusal) (approvals.observe! owner (service.entry-action Call context))))
                    (check refusal => #f)
                    (check-equal? (.get accepted total) expected)
                    (vector-set! contexts selected next))
                  (check (eq? other-context (vector-ref contexts other)) => #t)
                  (loop (cdr rows) (cons failed (cons pending history)) (+ round 1)))))))))
    (test-case "guarded approval writes refuse before mutation or old graph retirement"
      (let* ((providers (make-vector 8 'primary))
             (old (service.policy topology.original providers 'ingress 82))
             (owner (publication.publication (topology.initial) metadata: old))
             (before (publication.snapshot owner))
             (proposed (service.policy topology.original providers 'delivery 89))
             (called #f)
             (request (service.stage-transition owner proposed admit: (lambda (_old _proposed _candidate)
               (set! called #t) (.put! proposed 'budget 999) #t))))
        (check-exception (approvals.submit! owner request values) Error?)
        (check called => #t)
        (check-equal? (.get proposed budget) 200)
        (check (eq? before (publication.snapshot owner)) => #t)
        (check-equal? (.get (graph.closed-ref (publication.current owner) 'report) total) 82)))
    (test-case "final admission watch drift refuses before retirement and permits fresh retry"
      (let* ((providers (make-vector 8 'primary)) (first (topology.initial))
             (root (graph.closed-ref first 'report)) (type (graph.closed-type first 'report))
             (settings (.o value: 1))
             (recipe (graph.validation-node 'settings [] [settings]
               (lambda (_reference _source) (list (Record value: [Integer]) (.o value: 99)))))
             (request (staging.stage-reconfiguration first [recipe] [] []
               admit: (lambda (_) (.put! settings 'value 2) #t))))
        (check-exception (request first) (phase? 'stale))
        (check (eq? root (validate type root)) => #t)
        (check-equal? (.get settings value) 2)
        (let* ((next ((staging.stage-reconfiguration first [recipe] [] []) first)))
          (check-equal? (.get (graph.closed-ref next 'settings) value) 99))))))
