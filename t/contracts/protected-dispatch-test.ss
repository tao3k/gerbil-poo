(export protected-dispatch-test)
(import :std/test :std/iter (only-in :std/values first-value)
        (only-in :clan/poo/object .o)
        (prefix-in :clan/poo/closure closure.)
        (prefix-in :clan/poo/multimethod multimethod.)
        (prefix-in :clan/poo/dispatch-extension dispatch-extension.)
        (prefix-in :clan/poo/cyclic-publication cyclic-publication.)
        (prefix-in :clan/poo/examples/protected-dispatch protected-dispatch.))
(def (cook facts) (.o (release (closure.closure-ref facts 0))))
(def (equations flag) (vector (closure.literal flag)))
(def (caught thunk) (try (thunk) #f (catch (cause) cause)))
(def protected-dispatch-test
  (test-suite "C4 typed generic family with protected cyclic publication"
    (test-case "real C4 inheritance and current guarded arguments"
      (def previous (protected-dispatch.protected 32))
      (def risk (dispatch-extension.register-when (protected-dispatch.path 'Invoice 'Bank)
                   (lambda (_ __ amount) (> amount 100)) (lambda (_ __ amount) (+ amount 7))))
      (defvalues (accepted failure) (dispatch-extension.publish previous (list risk)))
      (check-equal? failure #f)
      (defvalues (low warm) (dispatch-extension.invoke accepted protected-dispatch.invoice protected-dispatch.bank 10))
      (defvalues (high warmer) (dispatch-extension.invoke warm protected-dispatch.invoice protected-dispatch.bank 150))
      (check-equal? low [])
      (check-equal? high '(157))
      (check-exception (dispatch-extension.invoke warmer protected-dispatch.invoice protected-dispatch.bank 'wrong-type) true)
      (check-exception (dispatch-extension.invoke warmer protected-dispatch.invoice protected-dispatch.bank -1) true)
      (def watched (dispatch-extension.check (dispatch-extension.snapshot previous)
                    (append (protected-dispatch.watches)
                            (list (dispatch-extension.call protected-dispatch.invoice protected-dispatch.bank 150)))))
      (defvalues (retained refused) (dispatch-extension.publish watched (list risk)))
      (check (eq? retained watched) => #t)
      (check-equal? (dispatch-extension.conflict-position (dispatch-extension.failure-cause refused)) 2)
      (def conflict (caught (lambda () (dispatch-extension.check (dispatch-extension.snapshot warmer)
                          (list (dispatch-extension.shape '((Invoice Document) (Bank Channel))))))))
      (check (dispatch-extension.conflict? conflict) => #t))
    (test-case "diamond ancestor contributions preserve lexicographic priority"
      (def previous (protected-dispatch.protected))
      (defvalues (accepted issue) (dispatch-extension.publish previous
        (list (dispatch-extension.contribute (protected-dispatch.path 'Financial 'Card) (lambda (_ __ amount) (+ amount 2))))))
      (check-equal? issue #f)
      (check-equal? (first-value (dispatch-extension.invoke accepted protected-dispatch.invoice protected-dispatch.card 10)) '(13 12))
      (check-equal? (first-value (dispatch-extension.invoke previous protected-dispatch.invoice protected-dispatch.card 10)) '(13)))
    (test-case "heterogeneous signatures warm independently and publish atomically"
      (defvalues (old issue) (cyclic-publication.prepare (equations #t) cook protected-dispatch.release-family (lambda (_) #t)))
      (check-equal? issue #f)
      (def untouched (cyclic-publication.version-service old 'enabled))
      (defvalues (fee warm) (cyclic-publication.invoke old 'fee protected-dispatch.invoice protected-dispatch.card 10))
      (check-equal? fee '(13))
      (check (eq? untouched (cyclic-publication.version-service warm 'enabled)) => #t)
      (check-equal? (multimethod.cache-size (dispatch-extension.snapshot (cyclic-publication.version-service old 'fee))) 0)
      (check-equal? (multimethod.cache-size (dispatch-extension.snapshot (cyclic-publication.version-service warm 'fee))) 1)
      (defvalues (enabled both-warm) (cyclic-publication.invoke warm 'enabled))
      (check-equal? enabled #t)
      (check (eq? (cyclic-publication.version-service warm 'fee) (cyclic-publication.version-service both-warm 'fee)) => #t)
      (def (bad-family view)
        (def bad (multimethod.register (protected-dispatch.make-dispatch) (protected-dispatch.path 'Document 'Bank)
                      (lambda (_ __ amount) amount)))
        (cons (cons 'fee (dispatch-extension.check bad (protected-dispatch.watches))) (cdr (protected-dispatch.release-family view))))
      (defvalues (retained refused) (cyclic-publication.publish both-warm (equations #f) cook bad-family (lambda (_) #t)))
      (check (eq? retained both-warm) => #t)
      (check-equal? (cyclic-publication.failure-stage refused) 'services)
      (check (dispatch-extension.conflict? (cyclic-publication.failure-cause refused)) => #t)
      (check-equal? (first-value (cyclic-publication.invoke retained 'enabled)) #t)
      (defvalues (revoked accepted) (cyclic-publication.publish both-warm (equations #f) cook protected-dispatch.release-family (lambda (_) #t)))
      (check-equal? accepted #f)
      (check-equal? (first-value (cyclic-publication.invoke revoked 'enabled)) #f)
      (check-equal? (first-value (cyclic-publication.invoke both-warm 'enabled)) #t))
    (test-case "shape and watch spines are copied and arity conflicts are explicit"
      (def order (list (list 'Report 'Document) (list 'Bank 'Channel)))
      (def query (dispatch-extension.shape order))
      (set-car! (car order) 'Invoice)
      (dispatch-extension.check (protected-dispatch.make-dispatch) (list query))
      (def conflict (caught (lambda () (dispatch-extension.check (protected-dispatch.make-dispatch)
                       (list (dispatch-extension.shape []))))))
      (check (dispatch-extension.conflict? conflict) => #t)
      (check-equal? (dispatch-extension.conflict-kind conflict) 'arity))))
