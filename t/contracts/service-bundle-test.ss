(export service-bundle-test)
(import :std/test :std/iter (only-in :std/values first-value)
        :clan/poo/object (only-in :clan/poo/mop Any Bool)
        (prefix-in :clan/poo/examples/service-bundle bundle.)
        (prefix-in :clan/poo/examples/cyclic-access access.)
        (prefix-in :clan/poo/examples/protected-dispatch protected.)
        (prefix-in :clan/poo/generic-family family.)
        (prefix-in :clan/poo/staged-publication staged.)
        (prefix-in :clan/poo/cyclic-publication publication.)
        (prefix-in :clan/poo/declarative-metadata metadata.)
        (prefix-in :clan/poo/dispatch-extension dispatch.)
        (prefix-in :clan/poo/multimethod multimethod.))
;; Baseline policy for checked heterogeneous services and cache/approval refusal cases.
(def policy (.cc bundle.Policy. capacity: 10 price: 3 invoice: "invoice:1"))
;; Capture a raised condition for refusal assertions; never turn it into acceptance.
(def (caught thunk) (try (thunk) #f (catch (cause) cause)))
;; Inspect the actual checked-dispatch cache for one published service.
(def (size version key) (multimethod.cache-size (dispatch.snapshot (publication.version-service version key))))
;; Exercise native composition, exact-candidate approval, shared-expansion work counts,
;; current-state invocation and keyed registration/negative failures.
(def service-bundle-test
  (test-suite "native composed family and exact-candidate admission"
    (test-case "shared expansion counts actual changed generics and retains warm siblings"
      (def original (.@ (.@ bundle.model generics) projection))
      (def expansions 0)
      (def expand (.@ original expand))
      ;; Matched default executes the same immutable reconstruction twice per key.
      (def baseline-calls 0)
      (def reference (.cc bundle.model generics:
        (.cc (.@ bundle.model generics) projection:
          (.cc original expand: (lambda (key inputs)
            (set! baseline-calls (+ baseline-calls 1)) (expand key inputs))))))
      (defvalues (reference-cold reference-issue)
        (staged.prepare reference (access.equations (access.config) #t) policy))
      (check-equal? reference-issue #f)
      (check-equal? baseline-calls 6)
      (def counted (.mix family.methods.instantiate<-shared-expansion
        (.cc original expand: (lambda (key inputs)
          (set! expansions (+ 1 expansions)) (expand key inputs)))))
      (def model (.cc bundle.model generics: (.cc (.@ bundle.model generics) projection: counted)))
      (def equations (access.equations (access.config) #t))
      (defvalues (cold issue) (staged.prepare model equations policy))
      (check-equal? issue #f)
      (check-equal? expansions 3)
      (defvalues (_ warm) (publication.invoke cold 'reserve 2))
      (set! expansions 0)
      (defvalues (cancelled cancel-issue) (staged.publish model warm equations (.cc policy invoice: "invoice:2")))
      (check-equal? cancel-issue #f)
      (check-equal? expansions 1)
      (check (eq? (publication.version-service cancelled 'reserve) (publication.version-service warm 'reserve)) => #t)
      (check-equal? (size cancelled 'reserve) 1)
      (check-equal? (first-value (publication.invoke cancelled 'cancel "customer" #t)) '("customer" "invoice:2"))
      (set! expansions 0)
      (def changed (.cc policy capacity: 20 price: 4 invoice: "invoice:3"))
      (defvalues (joint accepted) (staged.publish model cancelled equations changed))
      (check-equal? accepted #f)
      (check-equal? expansions 3)
      (check-equal? (first-value (publication.invoke joint 'reserve 2)) '(ok 18 #t))
      (check-equal? (first-value (publication.invoke joint 'quote protected.invoice protected.card 10)) '(13 14))
      (check-equal? (first-value (publication.invoke joint 'cancel "customer" #t)) '("customer" "invoice:3"))
      (defvalues (warm-result joint-warm) (publication.invoke joint 'reserve 2))
      (defvalues (held refused) (staged.publish model joint-warm equations (.cc changed cache-limit: 0)))
      (check (eq? held joint-warm) => #t)
      (check-equal? (publication.failure-stage refused) 'admission)
      (defvalues (same negative) (staged.publish model joint-warm equations (.cc changed forbidden-quote: #t)))
      (check (eq? same joint-warm) => #t)
      (check-equal? (family.failure-stage (publication.failure-cause negative)) 'negative))
    (test-case "shared expansion preserves keyed registration failure"
      (def failing (.mix family.methods.instantiate<-shared-expansion
        (.cc (.@ (.@ bundle.model generics) projection) expand: (lambda (_ __) (error "expansion refused")))))
      (def model (.cc bundle.model generics: (.cc (.@ bundle.model generics) projection: failing)))
      (defvalues (none issue) (staged.prepare model (access.equations (access.config) #t) policy))
      (check-equal? none #f)
      (check-equal? (publication.failure-stage issue) 'services)
      (check-equal? (family.failure-key (publication.failure-cause issue)) 'quote)
      (check-equal? (family.failure-stage (publication.failure-cause issue)) 'registration))
    (test-case "C4 contributions guards and heterogeneous metadata remain connected"
      (defvalues (old issue) (bundle.start policy))
      (check-equal? issue #f)
      (check-equal? (map (cut size old <>) '(quote reserve cancel)) '(0 0 0))
      (check-equal? (call-with-values (cut publication.probe old 'quote protected.invoice protected.card 10) list) '((13 13)))
      (check-equal? (size old 'quote) 0)
      (defvalues (quote-result warm) (publication.invoke old 'quote protected.invoice protected.card 10))
      (check-equal? quote-result '(13 13))
      (defvalues (bank-result warmer) (publication.invoke warm 'quote protected.invoice protected.bank 150))
      (check-equal? bank-result '(160))
      (check-equal? (first-value (publication.invoke warmer 'quote protected.invoice protected.bank 10)) [])
      (defvalues (reserved next) (publication.invoke warmer 'reserve 2))
      (check-equal? reserved '(ok 8 #t))
      (check (eq? (publication.version-service warmer 'quote) (publication.version-service next 'quote)) => #t)
      (check-equal? (first-value (publication.invoke next 'cancel "customer" #f)) '(error consent))
      (check-equal? (first-value (publication.invoke next 'cancel "forbidden" #t)) '(error missing))
      (defvalues (revised accepted) (bundle.revise next (.cc policy capacity: 20 price: 4 invoice: "invoice:2")))
      (check-equal? accepted #f)
      (check-equal? (map (cut size revised <>) '(quote reserve cancel)) '(0 0 0))
      (check-equal? (first-value (publication.invoke revised 'reserve 12)) '(ok 8 #t))
      (check-equal? (first-value (publication.invoke revised 'quote protected.invoice protected.card 10)) '(13 14))
      (check-equal? (first-value (publication.invoke revised 'quote protected.invoice protected.bank 150)) '(170))
      (check-equal? (first-value (publication.invoke revised 'cancel "customer" #t)) '("customer" "invoice:2")))
    (test-case "joint cache approval can refuse a successful call without leaking its state"
      (defvalues (old issue) (bundle.start (.cc policy cache-limit: 1)))
      (check-equal? issue #f)
      (defvalues (value warm) (publication.invoke old 'quote protected.invoice protected.card 10))
      (def failed (caught (cut publication.invoke warm 'reserve 2)))
      (check-equal? (publication.failure-stage failed) 'admission)
      (check-equal? (map (cut size warm <>) '(quote reserve cancel)) '(1 0 0))
      (defvalues (again same) (publication.invoke warm 'quote protected.invoice protected.card 10))
      (check (eq? same warm) => #t)
      (check-equal? again value)
      (def invalid (caught (cut publication.invoke warm 'reserve 0)))
      (check-equal? (metadata.failure-phase invalid) 'input)
      (check-equal? (size warm 'reserve) 0))
    (test-case "completed declarations negative assumptions and joint release priority"
      (defvalues (old issue) (bundle.start policy))
      (for ((change (list (.cc policy forbidden-quote: #t) (.cc policy broken-reserve: #t)
                         (.cc policy forbidden-cancel: #t) (.cc policy reserve-shift: 1)
                         (.cc policy cancel-shift: "wrong") (.cc policy ceiling: 1)))
            (stage '(negative registration negative admission admission admission))
            (key '(quote reserve cancel #f #f #f)))
        (defvalues (retained refused) (bundle.revise old change))
        (check (eq? retained old) => #t)
        (if key
          (let (cause (publication.failure-cause refused))
            (check-equal? (publication.failure-stage refused) 'services)
            (check-equal? (family.failure-key cause) key)
            (check-equal? (family.failure-stage cause) stage))
          (check-equal? (publication.failure-stage refused) stage)))
      (defvalues (accepted cancelled) (bundle.revise old (.cc policy forbidden-quote: #t cancelled-extension: #t)))
      (check-equal? cancelled #f)
      (check-equal? (first-value (publication.invoke accepted 'quote protected.invoice protected.bank 150)) '(160))
      (defvalues (retained revoked) (bundle.revise accepted policy (access.config) #f))
      (check (eq? retained accepted) => #t)
      (check-equal? (publication.failure-stage revoked) 'admission))
    (test-case "closed projected scopes match direct full constructors"
      (def native (.@ bundle.model generics))
      (def direct (.cc family.Model. keys: (.@ native keys) seed: (.@ native seed)
                       methods: (.@ native methods) watches: (.@ native watches)))
      (for* ((capacity '(0 10 20)) (price '(0 3 8)) (invoice '("invoice:1" "invoice:2")) (released '(#f #t)))
        (def selected-policy (.cc policy capacity: capacity price: price invoice: invoice
                                 reserve-shift: 1 cancel-shift: ":suffix"))
        (def capacity-value capacity)
        (def price-value price)
        (def invoice-value invoice)
        (def view (.o (capacity capacity-value) (price price-value) (invoice invoice-value) (release released)))
        (def projected (family.prepare native selected-policy view))
        (def reference (family.prepare direct selected-policy view))
        (for (call (list (list 'quote protected.invoice protected.card 10)
                        (list 'quote protected.invoice protected.bank 150)
                        (list 'quote protected.invoice protected.bank 10)
                        (list 'reserve 2) (list 'cancel "customer" #t) (list 'cancel "customer" #f)))
          (check-equal? (first-value (apply family.invoke projected call))
                        (first-value (apply family.invoke reference call))))))
    (test-case "projected revisions retain exact warm siblings and enforce new approval"
      (defvalues (old issue) (bundle.start policy))
      (defvalues (quote-result quoted) (publication.invoke old 'quote protected.invoice protected.card 10))
      (defvalues (reserved held) (publication.invoke quoted 'reserve 2))
      (defvalues (cancelled warm) (publication.invoke held 'cancel "customer" #t))
      (check-equal? (map (cut size warm <>) '(quote reserve cancel)) '(1 1 1))
      (defvalues (repriced accepted) (bundle.revise warm (.cc policy price: 4)))
      (check-equal? accepted #f)
      (check-equal? (family.family-built (publication.version-family repriced)) '(quote))
      (check-equal? (family.family-reused (publication.version-family repriced)) '(reserve cancel))
      (for (key '(reserve cancel))
        (check (eq? (publication.version-service warm key) (publication.version-service repriced key)) => #t))
      (check-equal? (map (cut size repriced <>) '(quote reserve cancel)) '(0 1 1))
      (check-equal? (first-value (publication.invoke repriced 'quote protected.invoice protected.card 10)) '(13 14))
      (defvalues (same permitted) (bundle.revise warm policy))
      (check-equal? permitted #f)
      (check-equal? (family.family-built (publication.version-family same)) [])
      (check-equal? (family.family-reused (publication.version-family same)) '(quote reserve cancel))
      (for (key '(quote reserve cancel))
        (check (eq? (publication.version-service same key) (publication.version-service warm key)) => #t))
      (for (changed (list (.cc policy ceiling: 1) (.cc policy cache-limit: 2)
                          (.cc policy forbidden-cancel: #t) (.cc policy cancel-shift: "stale")))
        (defvalues (retained refused) (bundle.revise warm changed))
        (check (eq? retained warm) => #t)
        (check (publication.failure? refused) => #t)
        (check-equal? (map (cut size warm <>) '(quote reserve cancel)) '(1 1 1)))
      ;; New model/source identity must reconstruct even equal projected inputs.
      (def revised-model (.cc bundle.model generics: (.cc (.@ bundle.model generics))))
      (defvalues (rebuilt rebound) (staged.publish revised-model warm (access.equations (access.config) #t) policy))
      (check-equal? rebound #f)
      (check-equal? (family.family-built (publication.version-family rebuilt)) '(quote reserve cancel))
      (check-equal? (map (cut size rebuilt <>) '(quote reserve cancel)) '(0 0 0))
      (def changed-admission (.cc bundle.model admit: (lambda (_ __) #f)))
      (defvalues (retained denied) (staged.publish changed-admission warm (access.equations (access.config) #t) policy))
      (check (eq? retained warm) => #t)
      (check-equal? (publication.failure-stage denied) 'admission))
    (test-case "retained generics skip real constructors; projection failure is atomic"
      (def inherited (.@ bundle.model generics))
      (def seed-source (.@ inherited seed))
      (def calls [])
      (def counted (.cc inherited seed: (lambda (key policy view)
                      (set! calls (cons key calls)) (seed-source key policy view))))
      (def current (.cc bundle.model generics: counted))
      (def equations (access.equations (access.config) #t))
      (defvalues (old issue) (staged.prepare current equations policy))
      (check-equal? issue #f)
      (check-equal? (reverse calls) '(quote reserve cancel))
      (set! calls [])
      (defvalues (repriced accepted) (staged.publish current old equations (.cc policy price: 4)))
      (check-equal? accepted #f)
      (check-equal? calls '(quote))
      (set! calls [])
      (defvalues (same permitted) (staged.publish current repriced equations (.cc policy price: 4)))
      (check-equal? permitted #f)
      (check-equal? calls [])
      (def refused-projection (.cc (.@ inherited projection) project: (lambda (_ __ ___) (error "projection refused"))))
      (def rejecting (.cc current generics: (.cc counted projection: refused-projection)))
      (defvalues (retained refused) (staged.publish rejecting same equations policy))
      (check (eq? retained same) => #t)
      (check-equal? (publication.failure-stage refused) 'services)
      (check-equal? (family.failure-stage (publication.failure-cause refused)) 'projection))
    (test-case "factored approval matches full approval across cold and warm calls"
      (def full-model (.cc bundle.model .readmit: bundle.admit))
      (for (current-policy (list policy (.cc policy capacity: 20 price: 4 invoice: "invoice:2" cache-limit: 2)))
        (defvalues (fast issue) (bundle.start current-policy))
        (defvalues (full full-issue) (staged.prepare full-model (access.equations (access.config) #t) current-policy))
        (check-equal? issue full-issue)
        (for (call (list (list 'quote protected.invoice protected.card 10)
                        (list 'quote protected.invoice protected.card 10)
                        (list 'reserve 2) (list 'cancel "customer" #t)))
          (def (advance old)
            (try (let-values (((value next) (apply publication.invoke old call))) (values value next #f))
              (catch (cause) (values #f old (publication.failure-stage cause)))))
          (defvalues (value next refused) (advance fast))
          (defvalues (full-value full-next full-refused) (advance full))
          (check-equal? value full-value)
          (check-equal? refused full-refused)
          (check-equal? (map (cut size next <>) '(quote reserve cancel))
                        (map (cut size full-next <>) '(quote reserve cancel)))
          (set! fast next) (set! full full-next))))
    (test-case "native model derivation preserves registration and watch protocols"
      (def inherited (.@ bundle.model generics))
      (def duplicate (.cc inherited keys: '(quote reserve quote cancel)))
      (check-equal? (map car (family.build duplicate policy (.o (capacity 10) (price 3) (invoice "invoice:1") (release #t))))
                    '(quote reserve cancel))
      (def invalid-admission (.cc bundle.model admit: (lambda (_ __) 'not-boolean)))
      (defvalues (value invalid) (staged.prepare invalid-admission (access.equations (access.config) #t) policy))
      (check-equal? value #f)
      (check-equal? (publication.failure-stage invalid) 'admission)
      (defvalues (_ warm-generic) (multimethod.call (protected.make-dispatch) protected.invoice protected.card 10))
      (def invalid-seed (.cc inherited seed: (lambda (_ __ ___) warm-generic)))
      (def invalid-family (caught (cut family.build invalid-seed policy
        (.o (capacity 10) (price 3) (invoice "invoice:1") (release #t)))))
      (check-equal? (family.failure-key invalid-family) 'quote)
      (check-equal? (family.failure-stage invalid-family) 'registration)
      (def checked (.cc metadata.Formula. .holds: (lambda (_) 'not-boolean)))
      (check-exception (metadata.check checked (lambda (_) #t)) true)
      (check-exception (metadata.holds (metadata.both metadata.truth checked) (lambda (_) #t)) true))))
