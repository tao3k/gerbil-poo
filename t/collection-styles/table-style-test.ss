;;; Complete ownership/observation and failure controls for all generated styles.
(export table-style-test)
(import :std/test :std/error :std/iter :std/sync/channel
        :clan/poo/object :clan/poo/mop :clan/poo/number :clan/poo/type :clan/poo/table :clan/poo/rationaldict :clan/poo/support/option
        (prefix-in :clan/poo/examples/service-collection service.))

;; Check protocol refusals without swallowing a different implementation exception.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))


;; Both workers finish staging against one head before release. Official channels
;; bound the rendezvous; every exit joins or terminates all workers in this scope.
(def (race style input table)
  (def ready (make-channel)) (def release (make-channel))
  (def workers (map (lambda (key) (make-thread (lambda ()
    (try (cons 'ok (.call style .step input (lambda (before)
      (channel-put ready 'ready)
      (unless (eq? (channel-get release 5 'timeout) 'go) (error "style race release timeout"))
      (.call table .acons key key before))))
      (catch (cause) (cons 'error cause)))))) '(1 2)))
  (try
    (for-each thread-start! workers)
    (for-each (lambda (_) (unless (eq? (channel-get ready 5 'timeout) 'ready)
      (error "style race readiness timeout"))) workers)
    (for-each (lambda (_) (channel-put release 'go)) workers)
    (map (lambda (worker)
      (def result (thread-join! worker 5 'timeout))
      (when (eq? result 'timeout) (error "style race join timeout")) result) workers)
    (finally (for-each thread-terminate! workers))))

;; Every style delegates to one original persistent backend and ordered batch.
(def table-style-test
  (test-suite "pure mutable and linear table styles"
    (test-case "all nine conversions preserve observations and transfer owned aliases"
      (def table (RationalDict Integer))
      (def styles (table-styles table))
      (def base (.call table .<-list '((1 . 10) (2 . 20))))
      (for (from '(Pure Mutable Linear))
        (def source (.ref styles from))
        (for (to '(Pure Mutable Linear))
          (def target (.ref styles to))
          (def input (.call source .ap base))
          (def snapshot (.call source .unap input))
          (def result (.call source .convert input (case to ((Pure) 'pure) ((Mutable) 'mutable) (else 'linear))))
          (check (eq? snapshot (.call target .unap result)) => #t)
          (if (eq? from 'Pure)
            (check-equal? (.call table .list<- input) '((1 . 10) (2 . 20)))
            (check-exception (.call source .unap input) (message? "consumed table reference"))))))
    (test-case "step preserves pure roots mutable identity and consumes every old linear alias"
      (def table (RationalDict Integer))
      (def styles (table-styles table))
      (def base (.call table .acons 1 10 (.@ table .empty)))
      (for (name '(Pure Mutable Linear))
        (def style (.ref styles name))
        (def input (.call style .ap base))
        (def snapshot (.call style .unap input))
        (def output (.call style .map (cut .call table .acons 1 20 <>) input))
        (check-equal? (.call table .ref (.call style .unap output) 1) 20)
        (check-equal? (.call table .ref snapshot 1) 10)
        (case name
          ((Pure) (check-equal? (.call table .ref input 1) 10))
          ((Mutable) (check (eq? input output) => #t))
          ((Linear) (check-exception (.call style .unap input) (message? "consumed table reference"))))))
    (test-case "first conflict bad result and arbitrary exceptions retain old ownership for retry"
      (def table (RationalDict Integer))
      (def styles (table-styles table))
      (def base (.call table .acons 1 10 (.@ table .empty)))
      (def after (.call table .acons 1 20 base))
      (def delta (.call table .diff base after))
      (def conflict (.call table .diff (.call table .acons 1 99 base) after))
      (for (name '(Pure Mutable Linear))
        (def style (.ref styles name))
        (def input (.call style .ap base))
        (def snapshot (.call style .unap input))
        (check-exception (.call style .apply-batch input (list delta conflict)) table-conflict?)
        (check (eq? snapshot (.call style .unap input)) => #t)
        (check-exception (.call style .step input (lambda (_) 17)) TypeError?)
        (def cause (list 'callback-failure))
        (check (eq? (try (.call style .step input (lambda (_) (raise cause))) #f (catch (e) e)) cause) => #t)
        (check (eq? snapshot (.call style .unap input)) => #t)
        (check-exception (.call style .convert input 'invalid) (message? "unknown table style"))
        (check (eq? snapshot (.call style .unap input)) => #t)
        (check-equal? (.call table .ref (.call style .unap (.call style .apply-delta input delta)) 1) 20)))
    (test-case "reentrant updates cannot overwrite a winner or resurrect consumed ownership"
      (def table (RationalDict Integer))
      (def styles (table-styles table))
      (def mutable (.@ styles Mutable))
      (def linear (.@ styles Linear))
      (def base (.@ table .empty))
      (def input (.call mutable .ap base))
      (check-exception (.call mutable .step input (lambda (before)
        (.call mutable .step input (cut .call table .acons 1 11 <>))
        (.call table .acons 2 22 before))) (message? "stale table reference"))
      (check-equal? (.call table .list<- (.call mutable .unap input)) '((1 . 11)))
      (def owned (.call linear .ap base))
      (def winner #f)
      (check-exception (.call linear .step owned (lambda (before)
        (set! winner (.call linear .convert owned 'mutable)) before)) (message? "stale table reference"))
      (check-exception (.call linear .unap owned) (message? "consumed table reference"))
      (check (.call table .empty? (.call mutable .unap winner)) => #t))
    (test-case "concurrent staging has one winner and one refusal in every owned presentation"
      (def table (RationalDict Integer))
      (def styles (table-styles table))
      (for (name '(Mutable Linear Classy))
        (def style (.ref styles name))
        (def input (.call style .ap (.@ table .empty)))
        (def outcomes (race style input table))
        (def won (filter (lambda (result) (eq? (car result) 'ok)) outcomes))
        (def lost (filter (lambda (result) (eq? (car result) 'error)) outcomes))
        (check-equal? (length won) 1) (check-equal? (length lost) 1)
        (check ((message? "stale table reference") (cdar lost)) => #t)
        (def winner (cdar won))
        (check-equal? (.call table .count (.call style .unap winner)) 1)
        (when (eq? name 'Linear)
          (check-exception (.call style .unap input) (message? "consumed table reference")))
        (def retried (.call style .step winner (cut .call table .acons 3 3 <>)))
        (check-equal? (.call table .count (.call style .unap retried)) 2)))
    (test-case "ABA equality cannot admit an older staged update"
      (def table (RationalDict Integer))
      (def style (.@ (table-styles table) Mutable))
      (def base (.call table .acons 1 10 (.@ table .empty)))
      (def input (.call style .ap base))
      (check-exception (.call style .step input (lambda (before)
        (.call style .step input (cut .call table .acons 1 20 <>))
        (.call style .step input (lambda (_) before))
        (.call table .acons 2 30 before))) (message? "stale table reference"))
      (check (eq? base (.call style .unap input)) => #t))
    (test-case "explicit admission wraps raw Functions once and FUN binding guards metadata"
      (def table (RationalDict (Fun Integer <- Integer)))
      (def style (.@ (table-styles table) Linear))
      (def input (.call style .admit (.call table .acons 1 (lambda (_) "bad") (.@ table .empty))))
      (def snapshot (.call style .unap input))
      (check-exception ((.call table .ref snapshot 1) 7) TypeError?)
      (check-exception (.call style .bind input (lambda (_) (.set! table sexp 'changed))) Error?)
      (check (eq? snapshot (.call style .unap input)) => #t)
      (def next (.call style .convert input 'linear))
      (check (eq? snapshot (.call style .unap next)) => #t))
    (test-case "cross-factory and cross-style references refuse before callbacks"
      (def table (RationalDict Integer))
      (def a (table-styles table)) (def b (table-styles table))
      (def input (.call (.@ a Mutable) .ap (.@ table .empty)))
      (def calls 0)
      (for (style (list (.@ b Mutable) (.@ a Linear)))
        (check-exception (.call style .step input (lambda (value) (set! calls (+ calls 1)) value))
          (message? "incompatible table reference")))
      (check-equal? calls 0)
      (check (.call table .empty? (.call (.@ a Mutable) .unap input)) => #t))
    (test-case "derived carriers retain shared Function wrappers through batches and IO"
      (def table (service.make-mirrored-ledger))
      (def f (validate (Fun Integer <- Integer) (lambda (v) (+ v 1))))
      (def base (.call table .acons -1 (cons 100 f) (.@ table .empty)))
      (def after (.call table .acons -1 (cons 80 f) base))
      (def batch (list (.call table .diff base after)))
      (def observed #f)
      (def result (service.revise-ledger-styles table base batch (lambda (next) (set! observed next) next)))
      (check (eq? result observed) => #t)
      (check (eq? (cdr (.call table .ref result -1)) f) => #t)
      (check-exception ((cdr (.call table .ref result -1)) "bad") TypeError?)
      (check-equal? (car (.call table .ref result -1)) 80)
      (check-equal? (car (.call table .ref base -1)) 100))
    (test-case "supported metadata revision invalidates snapshots through old style protocols"
      (def table (RationalDict Integer))
      (def styles (table-styles table))
      (def mutable (.@ styles Mutable))
      (def input (.call mutable .ap (.@ table .empty)))
      (.set! table Value Integer)
      (check-exception (.call mutable .unap input) (message? "stale table styles")))))
