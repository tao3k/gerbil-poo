;; Exercise real source elaboration, lens compilation, cooking and method invocation.
(def generalized-declaration-test
  (test-suite "non-record generalized declaration protocol"
    (test-case "nested vectors combine heterogeneous lenses methods and final self"
      (def prepared (generalized-declaration.service.prepare-service (.o (approved #t))))
      (check-equal? (fragment-names prepared) '(rate fee around primary))
      (check-equal? (generalized-declaration.service.report (observe-fragments prepared generalized-declaration.service.base generalized-declaration.service.base 2) 2) '(10 13 46 audit))
      (def action (bind-fragments prepared generalized-declaration.service.base 3))
      (def view (action generalized-declaration.service.base))
      (check-equal? (generalized-declaration.service.report view 2) '(10 13 66 audit))
      (check-equal? (generalized-declaration.service.report (action (vector (vector 99 88 []) 'seed)) 2) '(10 13 66 audit))
      (check-equal? generalized-declaration.service.base (vector (vector 0 0 []) 'audit))
      (check-exception (observe-fragments prepared generalized-declaration.service.base generalized-declaration.service.base -1) true))
    (test-case "the same macro constructs a procedure carrier without record slots"
      (def prepared (generalized-declaration.service.callable-service))
      (def seed (lambda (input) 7))
      (check-equal? ((observe-fragments prepared seed seed 1) 4) 27)
      (check-equal? ((observe-fragments prepared seed seed 0) 4) 7))
    (test-case "source revisions reject stale observations and new preparation recovers"
      (def part (.cc generalized-declaration.service.rate-part))
      (def context (.o (approved #t)))
      (def prepared (generalized-declaration.service.prepare-service context part))
      (def action (bind-fragments prepared generalized-declaration.service.base 3))
      (def view (observe-fragments prepared generalized-declaration.service.base generalized-declaration.service.base 3))
      (.putslot! part 'method ($constant-slot-spec 20))
      (check-exception (observe-fragments prepared generalized-declaration.service.base generalized-declaration.service.base 0) true)
      (check-exception (action generalized-declaration.service.base) true)
      (check-equal? (generalized-declaration.service.report view 2) '(10 13 66 audit))
      (def revised (generalized-declaration.service.prepare-service context part))
      (check-equal? (generalized-declaration.service.report (observe-fragments revised generalized-declaration.service.base generalized-declaration.service.base 3) 2) '(20 23 126 audit))
      (.putslot! context 'approved ($constant-slot-spec #f))
      (check-exception (observe-fragments revised generalized-declaration.service.base generalized-declaration.service.base 3) true)
      (check-exception (generalized-declaration.service.prepare-service context part) true))
    (test-case "complete elaboration refuses malformed duplicate and failing final sources"
      (def focus (lens-of-get-set identity (lambda (value _) value)))
      (def part (lens-fragment focus (lambda (value _ inherited) value) 7))
      (check-exception (.prototype GeneralizedDeclaration. (.o) identity
        (fragment repeated part) (fragment repeated part)) true)
      (check-exception (.prototype GeneralizedDeclaration. (.o) identity (fragment broken (.o))) true)
      (check-exception (.prototype GeneralizedDeclaration. (.o) identity
        (fragment bad (.cc part .compile: 7))) true)
      (check-exception (.prototype GeneralizedDeclaration. (.o) identity (public record (.o (default 4)))) true)
      (check-equal? (active-object-constructions) []))
    (test-case "empty declarations and ignored focused getters retain laziness"
      (def called? #f)
      (def focus (lens-of-get-set (lambda (_) (set! called? #t) (error "unused getter"))
        (lambda (value _) value)))
      (def prepared (.prototype GeneralizedDeclaration. (.o) identity
        (fragment overwrite (lens-fragment focus (lambda (value _ inherited) value) 7))))
      (check-equal? called? #f)
      (check-equal? (observe-fragments prepared 0 99 1) 7)
      (check-equal? called? #f)
      (def empty (.prototype GeneralizedDeclaration. (.o) identity))
      (check-equal? (observe-fragments empty 4 99 0) 99)
      (check-equal? (observe-fragments empty 4 99 1) 4))
    (test-case "registered callback metadata cannot change during observation"
      (def source (.o (value 1)))
      (def focus (lens-of-get-set identity (lambda (value _) value)))
      (def part (lens-fragment focus (lambda (value _ inherited)
        (.putslot! source 'value ($constant-slot-spec 2)) value) 7 sources: [source]))
      (def prepared (.prototype GeneralizedDeclaration. (.o) identity (fragment guarded part)))
      (check-exception (observe-fragments prepared 0 0 1) true)
      (check-equal? (.@ source value) 1)
      (def cooking (.prototype GeneralizedDeclaration. (.o)
        (lambda (raw) (.putslot! source 'value ($constant-slot-spec 3)) raw) (fragment guarded part)))
      (check-exception (observe-fragments cooking 0 0 0) true)
      (check-equal? (.@ source value) 1)
      (check-equal? (active-object-constructions) []))
    (test-case "an inherited form emits multiple overlapping targets before nonlocal finalization"
      (def focus (lens-of-get-set identity (lambda (value _) value)))
      (def wrapper (lambda (digit _ inherited) (+ (* 10 (inherited)) digit)))
      (def part (lens-fragment focus wrapper 2))
      (def expander (.o (:: @ GeneralizedDeclaration.)
        (expand-declaration (inherited) (lambda (context form)
          (if (eq? (.@ form kind) 'bundle)
            (list (cons 'first (.@ form descriptor)) (cons 'second (.@ form descriptor)))
            ((inherited) context form))))
        (finalize-declarations (inherited) (lambda (context entries)
          (append ((inherited) context entries) [(cons 'last (lens-fragment focus wrapper 4))])))))
      (def prepared (.prototype expander (.o) identity (bundle source part)))
      (check-equal? (fragment-names prepared) '(first second last))
      (check-equal? (observe-fragments prepared 1 0 1) 1422))))

;; Return the original suites from this lexical scope.
(values generalized-declaration-test)
