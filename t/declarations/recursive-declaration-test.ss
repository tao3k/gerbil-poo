(export recursive-declaration-test)
(import :std/test :clan/poo/object :clan/poo/mop :clan/poo/brace :clan/poo/closure :clan/poo/meta-prototype :clan/poo/declaration
        :clan/poo/recursive-declaration :clan/poo/reflection
        (prefix-in :clan/poo/recursive recursive.) (prefix-in :clan/poo/examples/recursive-metaprotocol service.))
;; Functional receipts for recursive metadata, forward declarations and publication.
(def recursive-declaration-test
  (test-suite "recursive metalevel and nonlocal declaration closure"
    (test-case "positive metalevel closure cannot invent or retain unsupported metadata"
      (def active (service.make-expander #t void))
      (def revoked (service.make-expander #f void))
      (check-equal? (closure->list (.@ active facts)) '(#t #t #t))
      (check-equal? (closure->list (.@ revoked facts)) '(#f #f #f))
      (check (bootstrap-protocol? active) => #t)
      (check (bootstrap-protocol? revoked) => #t)
      (check-equal? (.@ active level) 8)
      (check-equal? (.@ revoked level) 7)
      (check-exception (service.build-service revoked (.o (approved #t) (limit 5) (revision 2))) true)
      (check-exception (close-protocol (.o (equations (vector (fact 7))) (cook void))) true)
      (check-exception (close-protocol (.o (equations (vector)) (cook (lambda (_) #f)))) true))
    (test-case "forward shared requests finalize a whole family with current approval"
      (def visits [])
      (def expander (service.make-expander #t (lambda (name) (set! visits (cons name visits)))))
      (def first (service.build-service expander (.o (approved #t) (limit 10) (revision 1))))
      (check-equal? (reverse visits) '(family billing limit revision risk))
      (check-equal? (read-slot first 'total) 20)
      (check-equal? (.@ first .public-slots) '(billing risk total))
      (check-equal? (.@ first .private-slots) '(billing-revision risk-revision))
      (check-exception (read-slot first 'billing-revision) true)
      (set! visits [])
      (check-exception (service.build-service expander (.o (approved #f) (limit 20) (revision 2))) true)
      (check-equal? visits '(family))
      (check-equal? (read-slot first 'total) 20)
      (def next (service.build-service expander (.o (approved #t) (limit 30) (revision 3))))
      (check-equal? (read-slot next 'total) 60)
      (check-equal? (.@ next billing-revision) 3)
      (check-equal? (.@ first billing-revision) 1))
    (test-case "cycles missing sources and exhausted budgets never publish prefixes"
      (def seen [])
      (def expander (.o (:: @ RecursiveDeclaration.)
        (expand-recursive-declaration (lambda (_ form)
          (set! seen (cons (.@ form name) seen))
          (recursive.request (.@ form name))))))
      (def forms [(cons 'loop (declaration-form 'loop 'loop (.o)))])
      (check-exception (object<-recursive-declarations expander (.o) forms '(loop) 100) true)
      (check-equal? seen '(loop))
      (check-exception (object<-recursive-declarations expander (.o) forms '(missing) 100) true)
      (check-exception (object<-recursive-declarations expander (.o) forms '(loop) 0) true)
      (check-equal? (active-object-constructions) []))
    (test-case "compiled actions detect changed fragments and descriptor sources"
      (def form (declaration-form 'public 'amount (.o (default 4))))
      (def forms [(cons 'amount form)])
      (def action (recursive-declaration-action RecursiveDeclaration. forms '(amount) 50))
      (check-equal? (map car (action (.o))) '(amount))
      (.putslot! (.@ form descriptor) 'default ($constant-slot-spec 5))
      (check-exception (action (.o)) true)
      (def value (object<-recursive-declarations RecursiveDeclaration. (.o) forms '(amount) 50))
      (check-equal? (read-slot value 'amount) 5)
      (check-exception (object<-recursive-declarations RecursiveDeclaration. (.o)
        (append forms forms) '(amount) 50) true)
      (check-exception (object<-recursive-declarations RecursiveDeclaration. (.o)
        forms '(amount amount) 50) true))
    (test-case "final checks reject nonlocal collisions and protected source mutation"
      (def form (declaration-form 'public 'amount (.o (default 4))))
      (def expander (.o (:: @ RecursiveDeclaration.)
        (finalize-declarations (lambda (_ entries) (append entries entries)))))
      (check-exception (object<-recursive-declarations expander (.o) [(cons 'amount form)] '(amount) 50) true)
      (def mutating (.o (:: @ RecursiveDeclaration.)
        (expand-recursive-declaration (lambda (context form)
          (.putslot! context 'revision ($constant-slot-spec 9)) (recursive.value [])))))
      (def context (.o (revision 1)))
      (check-exception (object<-recursive-declarations mutating context [(cons 'amount form)] '(amount) 50) true)
      (check-equal? (.@ context revision) 1)
      (def cold-context (make-object
        protocol: (.o (compute-slot (lambda (_ next name)
          (.putslot! expander 'revision ($constant-slot-spec 9)) (next))))
        slots: [(cons 'revision ($constant-slot-spec 1))]))
      (def revision (object-revision expander))
      (check-exception (object<-recursive-declarations expander cold-context
        [(cons 'amount form)] '(amount) 50) true)
      (check-equal? (object-revision expander) revision)
      (check-equal? (active-object-constructions) []))
    (test-case "a failed later root skips suffix and whole-object finalization"
      (def seen [])
      (def finalized? #f)
      (def expander (.o (:: @ RecursiveDeclaration.)
        (expand-recursive-declaration (inherited)
          (lambda (context form)
            (set! seen (cons (.@ form name) seen))
            (if (eq? (.@ form name) 'refused) (recursive.source-error "refused fragment")
              ((inherited) context form))))
        (finalize-declarations (lambda (_ entries) (set! finalized? #t) entries))))
      (def forms (map (lambda (name) (cons name (declaration-form 'public name (.o (default 4)))))
        '(first refused last)))
      (check-exception (object<-recursive-declarations expander (.o) forms '(first refused last) 50) true)
      (check-equal? (reverse seen) '(first refused))
      (check-equal? finalized? #f)
      (check-equal? (active-object-constructions) []))
    (test-case "one Reader action cannot reuse another context's recursive receipts"
      (def seen [])
      (def expander (service.make-expander #t (lambda (name) (set! seen (cons name seen)))))
      (def action (recursive-declaration-action expander service.fragments '(family) 100))
      (def first (action (.o (approved #t) (limit 10) (revision 1))))
      (check-equal? (.@ (cdr (assq 'billing first)) constant) 10)
      (set! seen [])
      (def next (action (.o (approved #t) (limit 30) (revision 3))))
      (check-equal? (.@ (cdr (assq 'billing next)) constant) 30)
      (check-equal? (.@ (cdr (assq 'billing first)) constant) 10)
      (check-equal? (reverse seen) '(family billing limit revision risk))
      (check-exception (action (.o (approved #f) (limit 30) (revision 4))) true))))
