(export meta-prototype-test)
(import :std/test :std/iter :std/error :clan/poo/object :clan/poo/mop :clan/poo/number :clan/poo/brace :clan/poo/meta-prototype
        :clan/poo/declaration :clan/poo/reflection :clan/poo/inheritance-hooks
        (prefix-in :clan/poo/examples/metaprotocol-services service.))
;; Actual self-hosted objects, inherited expanders and nonlocal metadata controls.
(def meta-prototype-test
  (test-suite "constant-base metalevel bootstrap and nonlocal declarations"
    (test-case "ordered traversal captures form bindings and reuses the current Reader context"
      (def events [])
      (def expander (.o (:: @ Declaration.)
        (expand-declaration (lambda (context form)
          (set! events (cons form events)) [(cons form (.@ context revision))]))
        (finalize-declarations (lambda (_ entries) (set! events (cons 'finalize events)) entries))))
      (def forms (list 'first 'second))
      (def action (declaration-action expander forms))
      (check-equal? events [])
      (set-car! forms 'replaced) (set-cdr! forms [])
      (check-equal? (action (.o revision: 1)) '((first . 1) (second . 1)))
      (check-equal? (reverse events) '(first second finalize))
      (set! events [])
      (check-equal? (action (.o revision: 2)) '((first . 2) (second . 2)))
      (check-equal? (reverse events) '(first second finalize)))
    (test-case "each fragment is admitted before the suffix and original errors propagate"
      (for (mode '(malformed raised))
        (def events [])
        (def cause (list 'expansion-refused))
        (def expander (.o (:: @ Declaration.)
          (expand-declaration (lambda (_ form)
            (set! events (cons form events))
            (if (eq? form 'stop) (if (eq? mode 'raised) (raise cause) #f) [form])))
          (finalize-declarations (lambda (_ entries) (set! events (cons 'unreachable events)) entries))))
        (def action (declaration-action expander '(first stop last)))
        (if (eq? mode 'raised)
          (check-exception (action (.o)) (lambda (actual) (eq? actual cause)))
          (check-exception (action (.o)) Error?))
        (check-equal? (reverse events) '(first stop))
        (check-equal? (active-object-constructions) [])))
    (test-case "flattening waits for every callback and copies the complete fragment spine"
      (def front (list 'old))
      (def back (list 'last))
      (def expander (.o (:: @ Declaration.)
        (expand-declaration (lambda (_ form)
          (if (eq? form 'first) front (begin (set-car! front 'revised) back))))))
      (def result ((declaration-action expander '(first last)) (.o)))
      (check-equal? result '(revised last))
      (check (eq? result front) => #f)
      (check (eq? (cdr result) back) => #f)
      (set-car! result 'consumer)
      (check-equal? front '(revised))
      (check-equal? back '(last)))
    (test-case "finalization observes the complete current batch and supports retry including empty input"
      (def events [])
      (def cause (list 'finalizer-refused))
      (def expander (.o (:: @ Declaration.)
        (expand-declaration (lambda (_ form) (set! events (cons form events)) [form]))
        (finalize-declarations (lambda (context entries)
          (set! events (cons (cons 'finalize entries) events))
          (unless (.@ context approved) (raise cause)) entries))))
      (def action (declaration-action expander '(first last)))
      (check-exception (action (.o approved: #f)) (lambda (actual) (eq? actual cause)))
      (check-equal? (reverse events) '(first last (finalize first last)))
      (set! events [])
      (check-equal? (action (.o approved: #t)) '(first last))
      (check-equal? (reverse events) '(first last (finalize first last)))
      (set! events [])
      (check-equal? ((declaration-action expander []) (.o approved: #t)) [])
      (check-equal? events '((finalize)))
      (check-equal? (active-object-constructions) []))
    (test-case "a self-hosted root reflects anchors while compiling its own metadata"
      (def governed [])
      (def source (.o
        (compute-precedence-list (lambda (self next) (next)))
        (compute-slot (lambda (self next name)
          (when (eq? (object-protocol self) self)
            (check (procedure? (.ref self 'compute-slot)) => #t)
            (check (.slot? self 'compute-precedence-list) => #t))
          (set! governed (cons name governed)) (next)))
        (level 7)))
      (def root (bootstrap-protocol source))
      (check (bootstrap-protocol? root) => #t)
      (check (eq? (object-protocol root) root) => #t)
      (check-equal? (.@ root level) 7)
      (check (eq? (.ref/cached root 'compute-slot) (.@ root compute-slot)) => #t)
      (check (eq? (hash-ref (hash<-object root) 'compute-slot) (.@ root compute-slot)) => #t)
      (check (memq 'level governed) => '(level))
      (check (eq? (.@ root compute-slot) (.@ source compute-slot)) => #t)
      (check-exception (.putslot! root 'compute-slot ($constant-slot-spec #f)) true)
      (def derived (with-inheritance-hooks root (.o (compute-slot (lambda (_ next name) (next))))))
      (def value (with-inheritance-hooks derived (.o (amount 10))))
      (check-equal? (.@ value amount) 10)
      (check (eq? (object-protocol derived) root) => #t)
      (.putslot! source 'level ($constant-slot-spec 9))
      (check-equal? (.@ root level) 9)
      (def captured (.@ root compute-slot))
      (.putslot! source 'compute-slot ($constant-slot-spec (lambda (_ next name)
        (def body (next))
        (if (eq? name 'level) (lambda () (+ 100 (body))) body))))
      (check (eq? (.@ root compute-slot) captured) => #t)
      (check-equal? (.@ root level) 9)
      (def revised (bootstrap-protocol source))
      (check-equal? (.@ revised level) 109))
    (test-case "ordinary cycles and non-anchor recursive reads remain errors"
      (def cycle (.o (compute-precedence-list (lambda (_ next) (next)))
        (compute-slot (lambda (_ next slot) (next)))))
      (object-protocol-set! cycle cycle)
      (check-exception (.@ cycle compute-slot) true)
      (check-exception (bootstrap-protocol (.o (compute-slot 7))) true)
      (def recursive (.o
        (compute-precedence-list (lambda (_ next) (next)))
        (compute-slot (lambda (self next name) (.ref self 'payload) (next)))
        (payload 7)))
      (check-exception (bootstrap-protocol recursive) true)
      (check-equal? (active-object-constructions) []))
    (test-case "nonlocal static and computed declarations share current visibility catalogs"
      (def context (.o (tenant 'eu)))
      (def private-calls 0)
      (def dynamic [(declaration-form 'public 'computed (.o (constant #f)))])
      (def result (.declare Declaration. context
        (public amount (.o (type Integer) (default 10)))
        (private secret (.o (compute (lambda (_ parent)
          (set! private-calls (+ 1 private-calls)) 'token))))
        ,@dynamic))
      (check-equal? (read-slot result 'amount) 10)
      (check-equal? (read-slot result 'computed) #f)
      (check-equal? (.@ result .public-slots) '(amount computed))
      (check-equal? (.@ result .private-slots) '(secret))
      (check-exception (read-slot result 'secret) true)
      (def metadata (cdr (assq 'amount (reflect-slots result include-hidden?: #t))))
      (.putslot! metadata 'hidden ($constant-slot-spec #t))
      (check-equal? (.@ result .public-slots) '(computed))
      (check-equal? (.@ result .private-slots) '(amount secret))
      (check-exception (read-slot result 'amount) true)
      (check-equal? private-calls 0))
    (test-case "inherited expanders emit multiple checked slots in source order"
      (def seen [])
      (def expander (.o (:: @ Declaration.)
        (expand-declaration (inherited)
          (lambda (context form)
            (set! seen (cons (.@ form name) seen))
            (if (eq? (.@ form kind) 'property)
              (append ((inherited) context (declaration-form 'public (.@ form name) (.@ form descriptor)))
                [(cons 'revision (instance Slot hidden: #t constant: (.@ context revision)))])
              ((inherited) context form))))))
      (def value (.declare expander (.o (revision 3))
        (property amount (.o (type Integer) (default 10)))
        (private secret (.o (constant 'token)))))
      (check-equal? (reverse seen) '(amount secret))
      (check-equal? (.@ value .public-slots) '(amount))
      (check-equal? (.@ value .private-slots) '(revision secret))
      (check-equal? (.@ value revision) 3)
      (check-exception (.declare expander (.o (revision 3))
        (property amount (.o (default 1))) (public revision (.o (default 0)))) true))
    (test-case "Reader expansion is current ordered and refuses stale compiled methods"
      (def seen [])
      (def expander (.o (:: @ Declaration.)
        (expand-declaration (inherited)
          (lambda (context form)
            (set! seen (cons (.@ form name) seen))
            ((inherited) context form)))))
      (def forms [(declaration-form 'public 'first (.o (default 1)))
                  (declaration-form 'unknown 'stop (.o))
                  (declaration-form 'public 'last (.o (default 2)))])
      (check-exception ((declaration-action expander forms) (.o)) true)
      (check-equal? (reverse seen) '(first stop))
      (def action (declaration-action expander []))
      (check-equal? (action (.o)) [])
      (.putslot! expander 'finalize-declarations
        ($constant-slot-spec (lambda (_ entries) [])))
      (check-exception (action (.o)) true)
      (check-equal? ((declaration-action expander []) (.o)) []))
    (test-case "self-hosted expansion drives shared branches refusal and recovery"
      (def events [])
      (def expander (service.make-service-expander (lambda (kind) (set! events (cons kind events)))))
      (def action (service.service-action expander 10))
      (def first (action (.o (revision 1) (approved #t))))
      (check-equal? (car first) '(10 10 10))
      (check-equal? (reverse events) '(require property private))
      (def old (cdr first))
      (check-equal? (.@ (.@ old join) .public-slots) '(amount read-amount))
      (check-equal? (.@ (.@ old join) .private-slots) '(amount-revision secret))
      (check-equal? (.@ (.@ old join) amount-revision) 1)
      (set! events [])
      (check-exception (action (.o (revision 2) (approved #f))) true)
      (check-equal? events '(require))
      (check-equal? (service.report old) '(10 10 10))
      (def recovered (cdr (action (.o (revision 3) (approved #t)))))
      (check-equal? (.@ (.@ recovered join) amount-revision) 3)
      (check-equal? (.@ (.@ old join) amount-revision) 1)
      (write-slot! (.@ recovered source) 'amount 20)
      (check-equal? (service.report recovered) '(20 20 20))
      (check-equal? (service.report old) '(10 10 10)))
    (test-case "unknown forms collisions and source edits refuse before receiver publication"
      (def context (.o (revision 1)))
      (check-exception (.declare Declaration. context (unknown value (.o (default 1)))) true)
      (check-exception (.declare Declaration. context
        (public .public-slots (.o (default 1)))) true)
      (def mutating (.o (:: @ Declaration.)
        (expand-declaration (inherited)
          (lambda (current form)
            (.putslot! current 'revision ($constant-slot-spec 2))
            ((inherited) current form)))))
      (check-exception (.declare mutating context (public value (.o (default 1)))) true)
      (check-equal? (.@ context revision) 1)
      (check-equal? (active-object-constructions) []))))
