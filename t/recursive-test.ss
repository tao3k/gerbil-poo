(export recursive-test)
(import :std/test :std/iter (only-in :std/values first-value) ../object
        (only-in ../mop Any Bool) (prefix-in ../recursive recursive.)
        (prefix-in ../recursive-cache cached.) (prefix-in ../recursive-handling handling.)
        (prefix-in ../examples/cyclic-access access.) (prefix-in ../examples/recursive-catalog catalog.)
        (prefix-in ../cyclic-publication publication.) (prefix-in ../multimethod dispatch.))
;; Test helper reads a completed source result and checks its exact expected value.
(def (answer receipt) (recursive.value-result (cached.receipt-result receipt)))
;; Every suite control exercises real public APIs, never injected memo entries.
(def recursive-test
  (test-suite "safe recursive requests memo and current checked publication"
    (test-case "shared attestation memo false source error cycle and budget are distinct"
      (def empty (cached.empty access.attestation))
      (defvalues (first memo) (cached.run access.attestation '(4 . active) 200 empty))
      (check-equal? (answer first) #t)
      (check-equal? (cached.memo-size memo) 5)
      (check-equal? (cached.memo-misses memo) 5)
      (check-equal? (cached.memo-hits memo) 4)
      (check-equal? (cached.memo-size empty) 0)
      (defvalues (warm same) (cached.run access.attestation '(4 . active) 1 memo))
      (check (eq? warm first) => #t)
      (check-equal? (cached.memo-hits same) 5)
      (check-equal? (cached.memo-steps same) (cached.memo-steps memo))
      (defvalues (revoked next) (cached.run access.attestation '(4 . revoked) 200 same))
      (check-equal? (answer revoked) #f)
      (check-equal? (cached.memo-size next) 10)
      (defvalues (failed errors) (cached.run access.attestation '(0 . failed) 200 next))
      (check-equal? (recursive.source-error-message (cached.receipt-result failed)) "attestation-source")
      (defvalues (error-hit retained) (cached.run access.attestation '(0 . failed) 1 errors))
      (check (eq? error-hit failed) => #t)
      (defvalues (cycle held) (cached.run access.attestation '(0 . cycle) 50 retained))
      (check-equal? (cached.diagnostic-kind cycle) 'cycle)
      (check-equal? (cached.diagnostic-path cycle) '((0 . cycle) (0 . cycle)))
      (check (eq? held retained) => #t)
      (defvalues (budget unchanged) (cached.run access.attestation '(20 . active) 6 retained))
      (check-equal? (cached.diagnostic-kind budget) 'budget-exhausted)
      (check (eq? unchanged retained) => #t)
      (check-exception (cached.run (.cc access.attestation) '(4 . active) 1 retained) true)
      (for (depth (in-range 5))
        (defvalues (receipt _) (cached.run access.attestation (cons depth 'active) 200))
        (check-equal? (answer receipt) (recursive.value-result (recursive.solve access.attestation (+ depth 1) (cons depth 'active)))))
      (check (recursive.pending? (recursive.solve access.attestation 0 '(0 . active))) => #t))
    (test-case "partial child completion cannot escape a later machine diagnostic"
      (def branch (.cc recursive.Generator. input: Any output: Bool generate:
        (lambda (input) (case input
          ((leaf) (recursive.value #t))
          ((loop) (recursive.request 'loop))
          (else (recursive.bind (recursive.request 'leaf) (lambda (_) (recursive.request 'loop))))))))
      (def empty (cached.empty branch))
      (defvalues (diagnostic retained) (cached.run branch 'root 100 empty))
      (check-equal? (cached.diagnostic-kind diagnostic) 'cycle)
      (check (eq? empty retained) => #t)
      (check-equal? (cached.memo-size retained) 0)
      (check-equal? (cached.memo-misses retained) 0)
      (defvalues (zero same) (cached.run access.attestation '(4 . active) 0))
      (check-equal? (cached.diagnostic-kind zero) 'budget-exhausted)
      (check-equal? (cached.memo-size same) 0)
      (check-exception (cached.run access.attestation '(bad . active) 10) true))
    (test-case "warm catalog repeats current schema input output and callback admission"
      (def initial (handling.session catalog.program))
      (def broad (catalog.registry 12))
      (def first (handling.call-slot initial broad 'chain 3 200))
      (check-equal? (handling.result-failure first) #f)
      (check-equal? (handling.result-value first) (catalog.expected 3))
      (check-equal? (handling.result-reused first) #f)
      (def warm (handling.result-next first))
      (check-equal? (cached.memo-size (handling.session-memo warm)) 8)
      (def narrowed (handling.call-slot warm (catalog.registry 3) 'chain 3 1))
      (check-equal? (handling.failure-stage (handling.result-failure narrowed)) 'result)
      (check (handling.result-reused narrowed) => #t)
      (def removed (handling.call-slot (handling.result-next narrowed) (catalog.registry 12 #f) 'chain 3 1))
      (check-equal? (handling.failure-stage (handling.result-failure removed)) 'result)
      (def invalid (handling.call-slot (handling.result-next removed) (catalog.registry 12 #t 1) 'chain 3 1))
      (check-equal? (handling.failure-stage (handling.result-failure invalid)) 'argument)
      (check-equal? (handling.result-reused invalid) 'unknown)
      (check (eq? (handling.result-next invalid) (handling.result-next removed)) => #t)
      (def absent (handling.call-slot warm (.o) 'chain 3 1))
      (check-equal? (handling.failure-stage (handling.result-failure absent)) 'schema)
      (check (eq? (handling.result-next absent) warm) => #t)
      (def malformed (handling.call-slot warm (.o (chain (.o (name 'chain) (input #f) (output Any)))) 'chain 3 1))
      (check-equal? (handling.failure-stage (handling.result-failure malformed)) 'signature)
      (check (eq? (handling.result-next malformed) warm) => #t)
      (def exhausted (handling.call-slot warm broad 'chain 3 0))
      (check-equal? (handling.failure-stage (handling.result-failure exhausted)) 'evaluation)
      (check (handling.result-reused exhausted) => #t)
      (check (eq? (handling.result-next exhausted) warm) => #t)
      (def restored (handling.call-slot (handling.result-next removed) broad 'chain 3 1))
      (check-equal? (handling.result-value restored) (catalog.expected 3))
      (check (handling.result-reused restored) => #t)
      (def partial (handling.call-batch initial (catalog.registry 3) '((chain . 1) (chain . 2) (chain . 0)) 200))
      (check-equal? (handling.failure-stage (handling.result-failure partial)) 'result)
      (check-equal? (cached.memo-size (handling.session-memo (handling.result-next partial))) 6)
      (def resumed (handling.call-slot (handling.result-next partial) broad 'chain 2 1))
      (check-equal? (handling.result-value resumed) (catalog.expected 2))
      (check-equal? (cached.memo-size (handling.session-memo initial)) 0)
      (def failed (handling.call-slot initial broad 'fail 'unit 100))
      (check-equal? (handling.failure-stage (handling.result-failure failed)) 'source)
      (def failed-again (handling.call-slot (handling.result-next failed) broad 'fail 'unit 1))
      (check (handling.result-reused failed-again) => #t)
      (check-equal? (cached.memo-size (handling.session-memo (handling.result-next failed-again))) 1)
      (def state (.o (session initial) (ledger '(invoice reserve cancel))))
      (def workflow (first-value (dispatch.call catalog.run-service state broad 3)))
      (check-equal? (.@ workflow ledger) (.@ state ledger))
      (check-equal? (handling.result-failure (.@ workflow result)) #f)
      (check-equal? (cached.memo-size (handling.session-memo (.@ workflow session))) 8))
    (test-case "attestation seeds least closure and publication refusal retains exact memo"
      (defvalues (initial issue) (access.start-attested access.attestation '(4 . active) 200 (access.config) #t))
      (check-equal? issue #f)
      (check-equal? (first-value (access.invoke-attested initial 'grant "customer" #t)) '(ok "release:customer"))
      (defvalues (changed changed-issue) (access.revise-attested initial '(4 . active) 1 (access.config #f)))
      (check-equal? changed-issue #f)
      (check (.@ (publication.version-view (access.attested-closure changed)) release) => #f)
      (check-equal? (cached.memo-hits (access.attested-memo changed)) 5)
      (defvalues (revoked _) (access.revise-attested initial '(4 . revoked) 200 (access.config)))
      (check-equal? (.@ (publication.version-view (access.attested-closure revoked)) active) '(3))
      (defvalues (held refusal) (access.revise-attested initial '(4 . revoked) 200 (access.config) #t))
      (check (eq? held initial) => #t)
      (check-equal? (access.attestation-failure-stage refusal) 'publication)
      (defvalues (cyclic cycle) (access.revise-attested initial '(0 . cycle) 50 (access.config)))
      (check (eq? cyclic initial) => #t)
      (check-equal? (access.attestation-failure-stage cycle) 'recursive)
      (defvalues (failed source) (access.revise-attested initial '(0 . failed) 50 (access.config)))
      (check (eq? failed initial) => #t)
      (check-equal? (access.attestation-failure-stage source) 'source)
      (def replacement (.cc access.attestation generate: (lambda (_) (recursive.value #f))))
      (defvalues (rebased accepted) (access.rebase-attested initial replacement '(4 . active) 20 (access.config)))
      (check-equal? accepted #f)
      (check (access.attested-enabled rebased) => #f)
      (check-equal? (cached.memo-size (access.attested-memo rebased)) 1)
      (check (access.attested-enabled initial) => #t))))
