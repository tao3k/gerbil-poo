;;; Shared native IO; use Gerbil hash syntax and standard list/process libraries.
(export read-receipt write-receipt file-sha source-digests run-bounded
        merge! parse-metrics! median mean)
(import :std/encoding/json :std/encoding/hex :std/crypto/digest :std/misc/ports
        :std/misc/process :std/string/misc :std/iter)
(def (read-receipt path)
  (parameterize ((current-json-read-options (JSONReadOptions object-as-hash: #t)))
    (call-with-input-file path read-json)))
(def (write-receipt path value)
  (call-with-output-file (list path: path truncate: #t)
    (lambda (port) (write-json port value) (newline port))))
(def (file-sha path) (hex-encode (sha256 (call-with-input-file path read-all-as-u8vector))))
(def (source-digests paths (root "."))
  (list->hash-table (map (lambda (path) (cons path (file-sha (string-append root "/" path)))) paths)))
(def (merge! target source) (hash-for-each (cut hash-put! target <> <>) source) target)
(def (run-bounded timeout arguments)
  (def status 0)
  (try
    (let ((stdout (run-process (append (list timeout "--signal=TERM" "--kill-after=3s" "20s") arguments)
                    stdin-redirection: #f stderr-redirection: #t
                    check-status: (lambda (value _) (set! status value)))))
      (hash ("stdout" stdout) ("process_status" status)
            ("status" (cond ((= status 0) "pass") ((= status (* 124 256)) "timeout") (else "failed")))))
    (catch (exception) (hash ("status" "launch_error") ("error" (object->string exception))))))
(def (parse-metrics! text row)
  (parameterize ((current-json-read-options (JSONReadOptions object-as-hash: #t)))
    (merge! row (string->json text))))
(def (median values)
  (unless (pair? values) (error "empty median"))
  (def sorted (list-sort < values))
  (def middle (quotient (length sorted) 2))
  (if (odd? (length sorted)) (list-ref sorted middle)
    (/ (+ (list-ref sorted (1- middle)) (list-ref sorted middle)) 2)))
(def (mean values) (unless (pair? values) (error "empty mean")) (/ (apply + values) (length values)))
