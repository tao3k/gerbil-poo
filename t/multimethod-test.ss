(export multimethod-test)
(import (only-in :std/values first-value) (only-in :std/list/list-builder with-list-builder) :std/test :std/iter (only-in ../mop Any Bool)
        (prefix-in ../multimethod multimethod.)
        (prefix-in ../dispatch-extension dispatch-extension.))
(def (precedence args) (list (list (car args) 'Object) (list (cadr args) 'Object)))
(def (combine methods args) (map (lambda (method) (apply method args)) methods))
(def (base) (multimethod.make (list Any Any Any) Any precedence combine 2))
(def exact (list (multimethod.prototype 'Secret) (multimethod.prototype 'Email)))
(def fallback (list multimethod.any multimethod.any))
(def (label name) (lambda args name))
(def (answer generic . args) (first-value (apply multimethod.call generic args)))
(def (caught thunk) (try (thunk) #f (catch (cause) cause)))
(def multimethod-test
  (test-suite "typed multi-dispatch and protected immutable extension"
    (test-case "lexicographic order, contributions and guarded warm calls"
      (def g (multimethod.register (base) fallback (label 'fallback)))
      (def g1 (multimethod.register g exact (label 'exact)))
      (def g2 (multimethod.contribute g1 exact (label 'contribution)))
      (def g3 (multimethod.register-when g2 exact (lambda (_ __ amount) (> amount 10)) (label 'high)))
      (defvalues (low warm) (multimethod.call g3 'Secret 'Email 1))
      (check-equal? low '(contribution exact fallback))
      (check-equal? (answer warm 'Secret 'Email 20) '(high contribution exact fallback))
      (check-equal? (answer warm 'Secret 'Email 1) low)
      (check-equal? (multimethod.cache-size g3) 0)
      (check-equal? (multimethod.cache-size warm) 1)
      (check-equal? (multimethod.cache-size (multimethod.erase warm exact)) 0)
      (check-equal? (answer warm 'Secret 'Email 20) '(high contribution exact fallback))
      (for* ((left '(Secret Public Other)) (right '(Email Queue Other)) (amount '(0 20)))
        (check-equal? (answer warm left right amount) (multimethod.reference-call g3 left right amount))))
    (test-case "sparse order agrees with independent Cartesian association oracle"
      (def specifications '(((Secret Email) . exact) ((Document Email) . inherited)
                            ((Secret *) . left) ((* Email) . right) ((* *) . universal)
                            ((Document Object) . document-object)))
      (def (orders args)
        (list (if (eq? (car args) 'Secret) '(Secret Document Object) (list (car args) 'Object))
              (list (cadr args) 'Object)))
      (def generic
        (for/fold (current (multimethod.make (list Any Any) Any orders combine)) (spec specifications)
          (multimethod.register current
            (map (lambda (name) (if (eq? name '*) multimethod.any (multimethod.prototype name))) (car spec))
            (label (cdr spec)))))
      (def (oracle left right)
        (def shape (orders (list left right)))
        (with-list-builder (add)
          (for* ((a (append (car shape) '(*))) (b (append (cadr shape) '(*))))
            (def entry (assoc (list a b) specifications))
            (when entry (add (cdr entry))))))
      (for* ((left '(Secret Document Other)) (right '(Email Queue Other)))
        (defvalues (cold warm) (multimethod.call generic left right))
        (check-equal? cold (oracle left right))
        (check-equal? (answer warm left right) (oracle left right))))
    (test-case "bounded cache eviction preserves every independent version"
      (def g (multimethod.register (base) fallback (label 'all)))
      (def warm (for/fold (current g) (name '(a b c d e f g h i j k))
                  (let-values (((result next) (multimethod.call current name 'Email 0))) next)))
      (check-equal? (multimethod.cache-size warm) 8)
      (check-equal? (multimethod.cache-size g) 0)
      (check-equal? (answer warm 'a 'Email 0) '(all)))
    (test-case "negative call versus shape, completed batch and exact refusal"
      (def checked (dispatch-extension.check (base) (list (dispatch-extension.call 'Secret 'Email 1))))
      (def edited (list (dispatch-extension.register-when exact (lambda (_ __ n) (> n 10)) (label 'high))))
      (defvalues (accepted issue) (dispatch-extension.publish checked edited))
      (check-equal? issue #f)
      (defvalues (low warm) (dispatch-extension.invoke accepted 'Secret 'Email 1))
      (check-equal? low [])
      (defvalues (high hotter) (dispatch-extension.invoke warm 'Secret 'Email 20))
      (check-equal? high '(high))
      (def structural (caught (lambda () (dispatch-extension.check (dispatch-extension.snapshot hotter)
                              (list (dispatch-extension.shape '((Secret Object) (Email Object))))))))
      (check (dispatch-extension.conflict? structural) => #t)
      (check-equal? (dispatch-extension.conflict-position structural) 0)
      (defvalues (retained refused) (dispatch-extension.publish hotter (list (dispatch-extension.register exact (label 'bad)))))
      (check (eq? retained hotter) => #t)
      (check-equal? (dispatch-extension.failure-stage refused) 'negative)
      (defvalues (removed no-error) (dispatch-extension.publish hotter
        (list (dispatch-extension.register exact (label 'temporary)) (dispatch-extension.erase exact))))
      (check-equal? no-error #f)
      (check-equal? (multimethod.cache-size (dispatch-extension.snapshot removed)) 0)
      (defvalues (old bad-arity) (dispatch-extension.publish hotter (list (dispatch-extension.erase []))))
      (check (eq? old hotter) => #t)
      (check-equal? (dispatch-extension.failure-stage bad-arity) 'registration)
      (defvalues (kept prioritized) (dispatch-extension.publish hotter
        (list (dispatch-extension.register exact (label 'would-conflict)) (dispatch-extension.erase []))))
      (check (eq? kept hotter) => #t)
      (check-equal? (dispatch-extension.failure-stage prioritized) 'registration))
    (test-case "typing fails before dispatch; output rejection returns no cache"
      (def executions 0)
      (def g (multimethod.register (multimethod.make (list Bool) Bool (lambda (_) '((Boolean))))
                 (list multimethod.any) (lambda (flag) (set! executions (1+ executions)) flag)))
      (check-exception (multimethod.call g 'not-bool) true)
      (check-equal? executions 0)
      (check-exception (multimethod.call g #t #f) true)
      (check-equal? executions 0)
      (def bad (multimethod.register g (list multimethod.any) (lambda (_) 'not-bool)))
      (check-exception (multimethod.call bad #t) true)
      (check-equal? (multimethod.cache-size bad) 0)
      (check-exception (multimethod.register g (list multimethod.any) #f) true)
      (def invalid-guard (multimethod.register-when g (list multimethod.any) (lambda (_) 'truthy) (lambda (flag) flag)))
      (check-exception (multimethod.call invalid-guard #t) true))
    (test-case "checking never runs combination or method bodies"
      (def count 0)
      (def g (multimethod.make (list Any) Any (lambda (_) '((A))) (lambda (_ __) (error "combine called"))))
      (def m (lambda (_) (set! count (1+ count))))
      (def g1 (multimethod.register-when g (list multimethod.any) (lambda (_) #f) m))
      (dispatch-extension.check g1 (list (dispatch-extension.call 'a)))
      (check (dispatch-extension.conflict? (caught (lambda () (dispatch-extension.check g1 (list (dispatch-extension.shape '((A)))))))) => #t)
      (check-equal? count 0))))
