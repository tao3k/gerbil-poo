;;; Complete checked bulk/singleton construction over existing backend strategies.
(export table-construction-test)
(import :std/test :std/error :std/iter
        ../object ../mop ../type ../number ../table ../rationaldict ../support/option
        (only-in ../trie SimpleTrie) (only-in ./table-testing box-table alist-table)
        (only-in ../support/base number-comparer)
        (prefix-in ../examples/service-collection service.))

;; Observe the exact cause without accepting another failure family as equivalent.
(def (caught action) (with-catch identity action))

;; Constructor contracts retain leaf identity, backend precedence and final admission.
(def table-construction-test
  (test-suite "checked complete collection construction"
    (test-case "metadata discovery cannot rewrite captured constructor rows or Pair fields"
      (def raw (RationalDict Integer))
      (def second (cons 2 20)) (def rows (list (cons 1 10) second))
      (def table (.o (:: @ raw) (Key (begin
        (set-cdr! second 90) (set-car! (cdr rows) (cons 9 99)) Rational))))
      (check-equal? (.call raw .list<- (.call table .<-list rows)) '((1 . 10) (2 . 20)))
      (check-equal? (cdr second) 90) (check-equal? (caadr rows) 9))
    (test-case "metadata repair cannot admit an invalid original constructor occurrence"
      (def raw (RationalDict Integer)) (def builds 0)
      (def invalid (cons 2 'bad)) (def rows (list (cons 1 10) invalid))
      (def table (.o (:: @ raw)
        (Key (begin (set-cdr! invalid 20) Rational))
        .<-list/key: (lambda (entries) (set! builds (+ builds 1)) (.call raw .<-list/key entries))))
      (check-exception (.call table .<-list rows) TypeError?)
      (check-equal? builds 0)
      (check-equal? (.call raw .list<- (.call table .<-list rows)) '((1 . 10) (2 . 20)))
      (check-equal? builds 1))
    (test-case "five Table factories capture rows before custom public delegates and retain Function leaves"
      (def signature (Fun Integer <- Integer))
      (def callback (validate signature (lambda (n) (+ n 1))))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def raw (RationalDict signature))
        (def second (cons 2 callback)) (def rows (list (cons 1 callback) second))
        (def table (.cc raw .<-list: (lambda (entries)
          (set-cdr! second 'bad) (set-car! (cdr rows) 'bad)
          (.call raw .<-list entries))))
        (def protocol (.ref (table-styles table) name))
        (def owner (.call protocol .<-list rows))
        (check-eq? (.call protocol .ref owner 2) callback)
        (check-equal? ((.call protocol .ref owner 1) 7) 8)
        (check-equal? (cdr second) 'bad)))
    (test-case "five Set factories capture outer requests without copying pair-valued elements"
      (def element (Pair Integer Integer))
      (def backing (alist-table element Unit))
      (def raw (.cc Set<-Table. Table: backing))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def first (cons 1 10)) (def second (cons 2 20)) (def rows (list first second))
        (def set (.cc raw .<-list: (lambda (elements)
          (set-car! (cdr rows) (cons 9 90)) (.call raw .<-list elements))))
        (def protocol (.ref (set-styles set) name))
        (def owner (.call protocol .<-list rows))
        (def elements (.call protocol .list<- owner))
        (check-eq? (car elements) first) (check-eq? (cadr elements) second)
        (check-equal? elements '((1 . 10) (2 . 20)))))
    (test-case "factory delegates cannot repair an original malformed binding before admission"
      (def raw (RationalDict Integer))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def second (cons 2 'bad)) (def rows (list (cons 1 10) second))
        (def table (.cc raw .<-list: (lambda (entries)
          (set-cdr! second 20) (.call raw .<-list entries))))
        (def protocol (.ref (table-styles table) name))
        (check-exception (.call protocol .<-list rows) TypeError?)
        (check-equal? (.call protocol .list<- (.call protocol .<-list rows)) '((1 . 10) (2 . 20)))))
    (test-case "captured indexed constructors compose FUN IO revision inverse and retry"
      (def signature (Fun Integer <- Integer))
      (def callback (validate signature (lambda (n) (+ n 1))))
      (def source (RationalDict (Tuple Integer signature)))
      (def indexed (table-indexes source (list (.cc Type. name: 'rank
        table: (RationalDict Rational) unique?: #t project: (lambda (_ row) (vector-ref row 0))))))
      (def second (cons 2 (vector 20 callback)))
      (def rows (list (cons 1 (vector 10 callback)) second))
      (def table (.o (:: @ indexed) (Key (begin (set-cdr! second (vector 10 callback)) Rational))))
      (def effects 0)
      (def action (service.construct-ledger-action table (lambda (root)
        (set! effects (+ effects 1)) root)))
      (def root (action rows))
      (check-equal? effects 1) (check-equal? (.call indexed .index-ref/opt root 'rank 20) (some 2))
      (check-exception (action rows) table-index-conflict?) (check-equal? effects 1)
      (set-cdr! second (vector 20 callback))
      (def retry (action rows)) (check-equal? effects 2)
      (check-eq? (vector-ref (.call indexed .ref retry 2) 1) callback)
      (def primary (.call source .<-list (list (cons 1 (vector 10 callback)) (cons 2 (vector 20 callback)))))
      (def swapped (.call source .<-list (list (cons 1 (vector 20 callback)) (cons 2 (vector 10 callback)))))
      (def delta (.call source .diff primary swapped))
      (def next (.call indexed .apply-delta retry delta))
      (def restored (.call indexed .apply-delta next (invert-table-delta delta)))
      (check-equal? (.call indexed .index-ref/opt restored 'rank 20) (some 2))
      (check-eq? (vector-ref (.call indexed .ref restored 2) 1) callback))
    (test-case "stale factories retain priority over malformed outer constructor requests"
      (for* ((set? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def key (.cc Rational)) (def table (.cc (RationalDict Integer) Key: key))
        (def descriptor (if set? (.cc Set<-Table. Table: (.cc table Value: Unit)) table))
        (def protocol (.ref ((if set? set-styles table-styles) descriptor) name))
        (.set! key sexp 'changed)
        (check-exception (.call protocol .<-list 'malformed)
          (lambda (cause) (and (Error? cause) (equal? (Error-message cause) "stale table styles"))))))
    (test-case "public list constructors validate every entry before backend construction"
      (for (base (list (RationalDict Integer) (SimpleTrie UInt Integer)))
        (def builds 0)
        (def table (.cc base .<-list/key: (lambda (rows)
          (set! builds (+ builds 1)) (.call base .<-list/key rows))))
        (for (rows (list 'bad '((1 . 10) bad) '((1 . 10) (2 . bad)) '((bad . 10))))
          (check-exception (.call table .<-list rows)
            (lambda (cause) (or (TypeError? cause) (ContractViolation? cause)))))
        (check-equal? builds 0)
        (let (root (.call table .<-list '((1 . 10) (2 . 20))))
          (check-equal? builds 1)
          (check-equal? (.call table .list<- root) '((1 . 10) (2 . 20))))))
    (test-case "backend duplicate precedence and invalid superseded values are retained"
      (def rational (RationalDict Integer)) (def trie (SimpleTrie UInt Integer))
      (for (table (list rational trie))
        (def rows '((1 . 10) (2 . 20) (1 . 30)))
        (check-equal? (.call table .list<- (.call table .<-list rows))
          (.call table .list<- (.call table .<-list/key rows)))
        (check-exception (.call table .<-list '((1 . bad) (1 . 30))) TypeError?))
      (check-equal? (.call rational .ref (.call rational .<-list '((1 . 10) (1 . 30))) 1) 30)
      (check-equal? (.call trie .ref (.call trie .<-list '((1 . 10) (1 . 30))) 1) 10))
    (test-case "caller spines and Pair shells are captured before child predicates"
      (def first (cons 1 10)) (def second (cons 2 20))
      (def rows (list first second))
      (def key (.cc UInt .element?: (lambda (value)
        (when (= value 1) (set-cdr! second 'bad) (set-car! (cdr rows) 'bad))
        (element? UInt value))))
      (def table (SimpleTrie key Integer))
      (def root (.call table .<-list rows))
      (check-equal? (.call table .list<- root) '((1 . 10) (2 . 20)))
      (check-equal? (cdr second) 'bad)
      (check-equal? (cadr rows) 'bad))
    (test-case "partial refinements admit only complete roots and keep Trie singleton strategy"
      (for (base (list (RationalDict Integer) (SimpleTrie UInt Integer)))
        (def paired (.cc base .element?: (lambda (root)
          (and (element? base root) (= (.call base .count root) 2)))))
        (check-equal? (.call paired .list<- (.call paired .<-list '((1 . 10) (2 . 20))))
          '((1 . 10) (2 . 20)))
        (check-exception (.call paired .<-list []) TypeError?)
        (check-exception (.call paired .singleton 1 10) TypeError?))
      (def base (SimpleTrie UInt Integer)) (def leaves 0)
      (def one (.cc base .<-list/key: (lambda _ (error "unexpected bulk fallback"))
        .singleton/key: (lambda (key value) (set! leaves (+ leaves 1)) (.call base .singleton/key key value))
        .element?: (lambda (root) (and (element? base root) (= (.call base .count root) 1)))))
      (check-exception (.call one .singleton -1 10) TypeError?)
      (check-equal? leaves 0)
      (check-equal? (.call one .ref (.call one .singleton 1 10) 1) 10)
      (check-equal? leaves 1))
    (test-case "ordered represented and indexed constructors share final-state admission"
      (def raw (RationalDict Integer))
      (def ordered (table-order raw (table-comparer (.@ raw Key) number-comparer)))
      (defvalues (boxed _carrier _keys) (box-table ordered))
      (def indexed (table-indexes ordered (list
        (.cc Type. name: 'value table: (RationalDict (.@ raw Key)) unique?: #t project: (lambda (_ row) row)))))
      (for (table (list ordered boxed indexed))
        (check-exception (.call table .<-list '((1 . bad))) TypeError?)
        (check-exception (.call table .singleton 1 'bad) TypeError?)
        (check-equal? (.call table .count (.call table .<-list '((1 . 10) (2 . 20)))) 2))
      (check-exception (.call indexed .<-list '((1 . 10) (2 . 10))) table-index-conflict?)
      (check-equal? (.call indexed .index-ref/opt (.call indexed .singleton 1 10) 'value 10) (some 1)))
    (test-case "fresh construction exposes all five Table and Set presentations"
      (for* ((set? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def descriptor (if set? RationalSet (RationalDict Integer)))
        (def protocol (.ref ((if set? set-styles table-styles) descriptor) name))
        (def one (if set? (.call protocol .singleton 1) (.call protocol .singleton 1 10)))
        (def many (.call protocol .<-list (if set? '(1 2 1) '((1 . 10) (2 . 20)))))
        (check-equal? (.call protocol .count one) 1)
        (check-equal? (.call protocol .count many) 2)
        (check-exception (.call protocol .<-list (if set? '(1 bad) '((1 . 10) (2 . bad)))) TypeError?)
        (check-equal? (.call protocol .count many) 2)
        (when (eq? name 'Linear)
          (.call protocol .step many identity)
          (check-exception (.call protocol .unap many) true))))
    (test-case "constructor failures retain their cause and suppress Reader FUN IO"
      (def signature (Fun Integer <- Integer))
      (def callback (validate signature (lambda (n) (+ n 1))))
      (def table (RationalDict (Tuple Integer signature)))
      (def effects 0)
      (def action (service.construct-ledger-action table (lambda (root)
        (set! effects (+ effects 1)) (vector-ref (.call table .ref root 1) 1))))
      (check-exception (action (list (cons 1 (vector 'bad callback)))) TypeError?)
      (check-equal? effects 0)
      (check (eq? (action (list (cons 1 (vector 10 callback)))) callback) => #t)
      (check-equal? effects 1)
      (check-exception ((action (list (cons 1 (vector 10 callback)))) "bad") TypeError?)
      (def cause (caught (lambda () (error "original builder cause"))))
      (def broken (.cc table .<-list/key: (lambda _ (raise cause))))
      (check (eq? (caught (lambda () (.call broken .<-list (list (cons 1 (vector 10 callback)))))) cause) => #t))))
