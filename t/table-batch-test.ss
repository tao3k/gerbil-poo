;;; Ordered table batches retain intermediate conflict checks and origin lineage.
(export table-batch-test)
(import :std/test :std/iter :std/error
        ../object ../mop ../number ../type ../table ../rationaldict ../support/option
        (only-in ../fun Wrapper.) (only-in ../brace @@method) (only-in ../trie SimpleTrie)
        (prefix-in ../examples/service-collection service.))

;; Match protocol failures without accepting unrelated backend exceptions.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; Explicit typed identity conversion retains admitted values, including procedures.
(def (identity-wrapper descriptor)
  (.cc Wrapper. Domain: descriptor Codomain: descriptor .ap: identity .unap: identity))

;; Exercise public installation, conversion, folds and FUN rather than private edits.
(def table-batch-test
  (test-suite "ordered persistent revision batches"
    (test-case "finite iterable import coalesces last values and preserves false across backends"
      (for (table (list (RationalDict Bool) (SimpleTrie UInt Bool)))
        (def input '((1 . #t) (2 . #t) (1 . #f)))
        (def pulls 0)
        (def stream (iterator-map identity (iter input)
          (lambda (pull) (set! pulls (+ pulls 1)) (pull))))
        (def root (.call table .<-iter stream))
        (check-equal? pulls 4)
        (check-equal? (.call table .count root) 2)
        (check-equal? (.call table .ref/opt root 1) (some #f))
        (check-equal? (.call table .ref root 2) #t)))
    (test-case "seed and explicit key-space admission precede every Iterator pull"
      (def base (RationalDict Integer)) (def pulls 0)
      (def stream (iterator-map identity (iter '((1 . 10)))
        (lambda (pull) (set! pulls (+ pulls 1)) (pull))))
      (check-exception (.call base .<-iter stream 'invalid-root) TypeError?)
      (check-equal? pulls 0)
      (let (unsupported (.cc base .key-table: #f))
        (check-exception (.call unsupported .<-iter stream) (message? "unsupported table key registry")))
      (check-equal? pulls 0)
      (check-exception (.call base .<-iter '((1 . 10) bad)) TypeError?)
      (check-equal? (.call base .list<- (.call base .<-iter stream)) '((1 . 10)))
      (check-equal? pulls 2))
    (test-case "seedless construction admits only the final refined root and captured Pair shells"
      (def base (SimpleTrie UInt Integer))
      (def refined (.cc base .element?: (lambda (root)
        (and (element? base root) (= (.call base .count root) 2)))))
      (def shell (cons 0 0))
      (def input (in-coroutine (lambda (yield) (for (key '(1 2 1))
        (set-car! shell key) (set-cdr! shell (* key 10)) (yield shell)))))
      (def root (.call refined .<-iter input))
      (check-equal? (.call refined .list<- root) '((1 . 10) (2 . 20)))
      (check-exception (.call refined .<-iter []) TypeError?)
      (check-exception (.call refined .<-iter '((1 . 10) (2 . "bad"))) TypeError?)
      (check-equal? (.call refined .list<- (.call refined .<-iter '((1 . 10) (2 . 20))))
        '((1 . 10) (2 . 20))))
    (test-case "seeded imports install one final indexed swap and inverse without snapshot diff"
      (def base (SimpleTrie UInt Integer))
      (def source (table-indexes base (list
        (.cc Type. name: 'priority table: (RationalDict UInt) unique?: #t project: (lambda (_ value) value)))))
      (def original (.call source .<-list '((1 . 10) (2 . 20) (9 . 90))))
      (def calls 0)
      (def table (.cc source
        .apply-delta: (lambda (before delta) (set! calls (+ calls 1)) (.call source .apply-delta before delta))
        .for-each-change: (lambda _ (error "unexpected snapshot diff"))))
      (def result (.call table .<-iter '((1 . 30) (1 . 20) (2 . 10)) original))
      (check-equal? calls 1)
      (check-equal? (.call table .ref result 1) 20)
      (check-equal? (.call table .ref result 2) 10)
      (check-equal? (.call table .index-ref/opt result 'priority 20) (some 1))
      (let (inverse (invert-table-delta (.call source .diff original result)))
        (check-equal? (.call source .list<- (.call source .apply-delta result inverse))
          '((1 . 10) (2 . 20) (9 . 90))))
      (check-exception (.call table .<-iter '((1 . 20)) original) table-index-conflict?)
      (check-equal? (.call table .ref original 1) 10))
    (test-case "Set seeded import preserves its refinement without listing the old snapshot"
      (def descriptor (.cc RationalSet .list<-: (lambda _ (error "unexpected seed scan"))))
      (def seed (.call RationalSet .<-list '(1 2)))
      (def result (.call descriptor .<-iter '(2 3 3) seed))
      (check-equal? (.call RationalSet .list<- result) '(1 2 3))
      (def denied (.cc descriptor .element?: (lambda (root) (< (.call RationalSet .count root) 3))))
      (check-exception (.call denied .<-iter '(3) seed) TypeError?)
      (check-equal? (.call RationalSet .list<- seed) '(1 2)))
    (test-case "all styles and receivers publish once and retain failed owners for fresh stream retry"
      (for* ((set? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def descriptor (if set? RationalSet (RationalDict Integer)))
        (def protocol (.ref ((if set? set-styles table-styles) descriptor) name))
        (def owner (.call protocol .<-iter (if set? '(1 2) '((1 . 10) (2 . 20)))))
        (def input (if set? '(2 3) '((2 . 25) (3 . 30))))
        (check-exception (.call protocol .<-iter (if set? '(3 bad) '((3 . 30) (4 . bad))) owner) TypeError?)
        (check-equal? (.call protocol .count owner) 2)
        (let (result (if (memq name '(Posh Classy)) (@@method owner.<-iter input)
                        (.call protocol .<-iter input owner)))
          (check-equal? (.call protocol .list<- result) (if set? '(1 2 3) '((1 . 10) (2 . 25) (3 . 30))))
          (when (memq name '(Mutable Classy)) (check (eq? result owner) => #t))
          (when (eq? name 'Linear) (check-exception (.call protocol .unap owner) true)))))
    (test-case "stream refusal and reentrant publication never expose a losing owner"
      (def table (RationalDict Integer))
      (def protocol (.@ (table-styles table) Mutable))
      (def owner (.call protocol .<-iter '((1 . 10))))
      (def cause (with-catch identity (lambda () (error "stream failed"))))
      (def broken (in-coroutine (lambda (yield) (yield '(2 . 20)) (raise cause))))
      (check (eq? (with-catch identity (lambda () (.call protocol .<-iter broken owner))) cause) => #t)
      (check-equal? (.call protocol .list<- owner) '((1 . 10)))
      (let (competing (in-coroutine (lambda (yield)
        (.call protocol .acons 9 90 owner) (yield '(2 . 20)))))
        (check-exception (.call protocol .<-iter competing owner) (message? "stale table reference")))
      (check-equal? (.call protocol .list<- owner) '((1 . 10) (9 . 90)))
      (check-equal? (.call protocol .list<- (.call protocol .<-iter '((2 . 20)) owner))
        '((1 . 10) (2 . 20) (9 . 90))))
    (test-case "Function stream import composes with linear Reader FUN IO and corrected retry"
      (def signature (.cc Function. inputs: [Integer] outputs: [Integer]))
      (def callback (validate signature (lambda (n) (+ n 1))))
      (def table (RationalDict signature))
      (def root (.call table .<-iter (list (cons 1 callback))))
      (def calls 0)
      (def action (service.import-ledger-action table (lambda (next)
        (set! calls (+ calls 1)) (.call table .ref next 2))))
      (check-exception ((action '((2 . bad))) root) TypeError?)
      (check-equal? calls 0)
      (check (eq? ((action (list (cons 2 callback))) root) callback) => #t)
      (check-equal? calls 1)
      (check-exception (((action (list (cons 2 callback))) root) "bad") TypeError?))
    (test-case "point requests defer writes and compose transport inverse and aggregate updates"
      (def writes 0) (def calls 0)
      (def backend (RationalDict Integer))
      (def table (.cc backend
        .acons: (lambda (k v root) (set! writes (+ writes 1)) (.call backend .acons k v root))
        .for-each-change: (lambda _ (error "unexpected difference scan"))))
      (def base (.call table .<-list '((1 . 10) (9 . 90))))
      (set! writes 0)
      (def one (.call table .delta/opt 1 (lambda (old)
        (set! calls (+ calls 1)) (some (+ (option-ref old) 5))) base))
      (check-equal? writes 0)
      (check-equal? (table-delta-count one) 1)
      (def middle (.call table .apply-delta base one))
      (check-equal? writes 1)
      (def two (.call table .delta/opt 1 (lambda (_) #f) middle))
      (def batch (.call table .compose-deltas (list one two)))
      (def folding (table-fold table Integer (lambda (_ value) value)))
      (def initial (.call folding .ap base))
      (def final (.call folding .apply-delta initial batch))
      (check-equal? (.call folding .get final) 90)
      (check-equal? (.call folding .get (.call folding .apply-delta final (invert-table-delta batch))) 100)
      (def target (SimpleTrie UInt Integer))
      (def mapping (table-isomorphism table target
        (.cc Wrapper. Domain: (.@ table Key) Codomain: UInt .ap: identity .unap: identity)
        (identity-wrapper Integer)))
      (def mapped (.call (.@ mapping Delta) .ap (cons base batch)))
      (def installed (.call target .apply-delta (car mapped) (cdr mapped)))
      (check-equal? (.call target .list<- installed) '((9 . 90)))
      (check-equal? (.call target .list<- (.call target .apply-delta installed
        (invert-table-delta (cdr mapped)))) '((1 . 10) (9 . 90)))
      (check-equal? calls 1)
      (check-exception (.call table .apply-delta middle one) table-conflict?))
    (test-case "point requests reject bad types before writing and no-op origins still expire"
      (def table (RationalDict (.cc Bool)))
      (def base (.call table .<-list '((1 . #f))))
      (def calls 0)
      (check-exception (.call table .delta/opt "bad" (lambda (_) (set! calls (+ calls 1)) #f) base) TypeError?)
      (check-equal? calls 0)
      (check-exception (.call table .delta/opt 1 (lambda (_) (some 10)) base) TypeError?)
      (check-exception (.call table .delta/opt 1 (lambda (_) 'not-option) base) Error?)
      (def cause (list 'callback-failure))
      (check (try (.call table .delta/opt 1 (lambda (_) (raise cause)) base) #f
        (catch (e) (eq? e cause))) => #t)
      (def noop (.call table .delta/opt 1 identity base))
      (def absent (.call table .delta/opt 2 (lambda (_) #f) base))
      (check-equal? (table-delta-count noop) 0)
      (check-equal? (table-delta-count absent) 0)
      (check (eq? (.call table .apply-delta base noop) base) => #t)
      (def deleted (.call table .delta/opt 1 (lambda (_) #f) base))
      (check-equal? (table-delta-count deleted) 1)
      (.set! (.@ table Value) sexp 'changed)
      (check-exception (.call table .apply-delta base noop) Error?))
    (test-case "captured point expectations and replacements own their Option shells"
      (def table (RationalDict Bool))
      (def base (.call table .<-list '((1 . #f))))
      (def response (some #t))
      (def delta (.call table .delta/opt 1 (lambda (argument)
        (some-value-set! argument #t) response) base))
      (some-value-set! response #f)
      (def installed (.call table .apply-delta base delta))
      (check (.call table .ref installed 1) => #t)
      (check (.call table .ref (.call table .apply-delta installed (invert-table-delta delta)) 1) => #f))
    (test-case "ordered repeated-key batches compose associate and undo on both carriers"
      (for (table (list (RationalDict Integer) (SimpleTrie UInt Integer)))
        (def base (.call table .<-list '((1 . 10) (9 . 90))))
        (def middle (.call table .acons 1 20 base))
        (def deleted (.call table .remove middle 1))
        (def final (.call table .acons 1 30 deleted))
        (def one (.call table .diff base middle))
        (def two (.call table .diff middle deleted))
        (def three (.call table .diff deleted final))
        (def batch (.call table .compose-deltas (list one two three)))
        (check-equal? (table-delta-count batch) 3)
        (check-equal? (.call table .list<- (.call table .apply-delta base batch)) (.call table .list<- final))
        (for (grouped (list (.call table .compose-deltas
                              (list (.call table .compose-deltas (list one two)) three))
                            (.call table .compose-deltas
                              (list one (.call table .compose-deltas (list two three))))))
          (check-equal? (.call table .list<- (.call table .apply-delta base grouped)) (.call table .list<- final)))
        (check-equal? (.call table .list<- (.call table .apply-delta final (invert-table-delta batch)))
                      (.call table .list<- base))
        (check (eq? (.call table .apply-delta base (.call table .compose-deltas [])) base) => #t)))
    (test-case "stored false remains distinct from absence through batch undo"
      (for (table (list (RationalDict Bool) (SimpleTrie UInt Bool)))
        (def base (.call table .<-list '((1 . #f))))
        (def absent (.call table .remove base 1))
        (def batch (.call table .compose-deltas
          (list (.call table .diff base absent) (.call table .diff absent base))))
        (def installed (.call table .apply-delta base batch))
        (check (.call table .key? installed 1) => #t)
        (check (.call table .ref installed 1) => #f)
        (check-equal? (.call table .list<- (.call table .apply-delta installed (invert-table-delta batch)))
                      (.call table .list<- base))))
    (test-case "cancelling edits retain old-value checks and late failure suppresses fold IO"
      (def table (RationalDict Integer))
      (def base (.call table .<-list '((1 . 10) (2 . 20))))
      (def middle (.call table .acons 1 11 base))
      (def one (.call table .diff base middle))
      (def undo (invert-table-delta one))
      (def cancelled (.call table .compose-deltas (list one undo)))
      (check-equal? (table-delta-count cancelled) 2)
      (check-exception (.call table .apply-delta (.call table .acons 1 99 base) cancelled) table-conflict?)
      (def calls 0) (def consumed 0)
      (def folding (table-fold table Integer (lambda (_ v) (set! calls (+ calls 1)) v)))
      (def state (.call folding .ap base))
      (def action (service.batch-ledger-action table folding state
        (lambda (v) (set! consumed (+ consumed 1)) v)))
      (def wrong (.call table .diff base (.call table .acons 1 12 base)))
      (set! calls 0)
      (check-exception (action (list one wrong)) table-conflict?)
      (check-equal? calls 0) (check-equal? consumed 0)
      (check-equal? (.call folding .get state) 30)
      (def retried (action (list one undo)))
      (check-equal? (.call folding .get retried) 30)
      (check-equal? calls 4) (check-equal? consumed 1))
    (test-case "composition neither enumerates snapshots nor forgets empty origin revisions"
      (def source (RationalDict Integer))
      (def base (.call source .<-list '((1 . 10))))
      (def delta (.call source .diff base (.call source .acons 1 11 base)))
      (def empty (.call source .diff base base))
      (def receiver (.cc source
        .foldl: (lambda _ (error "snapshot scan"))
        .validate-shape: (lambda _ (error "snapshot admission"))))
      (def batch (.call receiver .compose-deltas (list empty delta)))
      (check-equal? (table-delta-count batch) 1)
      (check-exception (.call (RationalDict String) .compose-deltas (list delta))
        (message? "stale or incompatible table delta"))
      (.set! source sexp 'revised)
      (check-exception (.call receiver .compose-deltas (list empty))
        (message? "stale or incompatible table delta"))
      (check-exception (.call receiver .apply-delta base batch)
        (message? "stale or incompatible table delta")))
    (test-case "isomorphic transport preserves each intermediate value and inverse"
      (def source (RationalDict Integer))
      (def target (SimpleTrie UInt Integer))
      (def keys (.cc Wrapper. Domain: (.@ source Key) Codomain: UInt
        .ap: (cut + <> 1) .unap: (cut - <> 1)))
      (def mapping (table-isomorphism source target keys (identity-wrapper Integer)))
      (def base (.call source .<-list '((1 . 10))))
      (def middle (.call source .acons 1 20 base))
      (def final (.call source .acons 1 30 middle))
      (def batch (.call source .compose-deltas
        (list (.call source .diff base middle) (.call source .diff middle final))))
      (def staged (.call (.@ mapping Delta) .ap (cons base batch)))
      (def installed (.call target .apply-delta (car staged) (cdr staged)))
      (check-equal? (.call target .ref installed 2) 30)
      (check-equal? (.call target .ref
        (.call target .apply-delta installed (invert-table-delta (cdr staged))) 2) 10)
      (def recovered (.call (.@ mapping Delta) .unap staged))
      (check-equal? (.call source .ref (.call source .apply-delta (car recovered) (cdr recovered)) 1) 30))
    (test-case "temporary keys and admitted Function leaves survive transport and undo"
      (def callback (Fun Integer <- Integer))
      (def source (RationalDict callback))
      (def target (SimpleTrie UInt callback))
      (def base (validate source (.call source .<-list (list (cons 1 (lambda (x) (+ x 1)))))))
      (def f (.call source .ref base 1))
      (def temporary (.call source .acons 2 f base))
      (def batch (.call source .compose-deltas
        (list (.call source .diff base temporary) (.call source .diff temporary base))))
      (def mapping (table-isomorphism source target
        (.cc Wrapper. Domain: (.@ source Key) Codomain: UInt .ap: identity .unap: identity)
        (identity-wrapper callback)))
      (def staged (.call (.@ mapping Delta) .ap (cons base batch)))
      (check-equal? (table-delta-count (cdr staged)) 2)
      (def installed (.call target .apply-delta (car staged) (cdr staged)))
      (check (eq? (.call target .ref installed 1) f) => #t)
      (check (.call target .key? installed 2) => #f)
      (check-exception (f "wrong") TypeError?)
      (check-equal? (.call target .list<-
        (.call target .apply-delta installed (invert-table-delta (cdr staged))))
        (.call target .list<- (car staged))))
    (test-case "fold transport retains ownership after a deletion followed by reinsertion"
      (def source (.cc (RationalDict Integer) Key: UInt))
      (def target (SimpleTrie UInt Integer))
      (def keys (.cc Wrapper. Domain: UInt Codomain: UInt
        .ap: (lambda (k) (if (= k 2) 0 k)) .unap: identity))
      (def folding (table-fold source Integer (lambda (_ v) v)))
      (def mapping (.call folding .isomorphism target keys (identity-wrapper Integer)))
      (def target-fold (.@ mapping Codomain))
      (def base (.call source .<-list '((0 . 10))))
      (def state (.call folding .ap base))
      (def absent (.call source .remove base 0))
      (def final (.call source .acons 0 30 absent))
      (def batch (.call source .compose-deltas
        (list (.call source .diff base absent) (.call source .diff absent final))))
      (def installed (.call mapping .apply-delta state batch))
      (check-equal? (.call target-fold .get installed) 30)
      (def updated (.call mapping .unap installed))
      (def collision (.call source .diff final (.call source .acons 2 40 final)))
      (def cause (try (.call mapping .apply-delta updated collision) #f (catch (e) e)))
      (check (table-isomorphism-failure? cause) => #t)
      (check-equal? (table-isomorphism-failure-kind cause) 'collision)
      ;; Failed translation retains the last accepted pair for a valid retry.
      (check (eq? (.call mapping .ap updated) installed) => #t)
      (def retry (.call source .diff final (.call source .acons 3 40 final)))
      (check-equal? (.call target-fold .get (.call mapping .apply-delta updated retry)) 70))))
