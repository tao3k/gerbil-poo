(export component-rounds-test)
(import :std/test (only-in :std/list/list foldl find filter) ../object ../mop ../brace ../support/option ../feedback-graph
        (prefix-in ../construction-cache cache.) (prefix-in ../strong-components scc.)
        (prefix-in ../component-revision revision.) (prefix-in ../dependency-analysis code.)
        (prefix-in ../examples/component-rounds service.) (prefix-in ../examples/component-membership initial.))
;; Real constructor accounting distinguishes skipped groups from equal values.
(def (evaluated current) (cache.cache-evaluated (graph-cache-values current)))
;; Compare membership independent of historical support enumeration order.
(def (members current key) (find (lambda (group) (memq key group)) (scc.partition-groups (graph-cache-partition current))))
;; Stable feedback must never reconstruct in any later round.
(def topology-builder (.cc cache.Builder. allow: (lambda (key) (not (memq key '(quota spare stable))))))
;; Refused staged actions retain the caller's exact publication, with no partial state.
(def (attempt current action)
  (try (values (action current) #f) (catch (failure) (values current failure))))
;; Full multi-round scenarios exercise both current service policies after every closure.
(def component-rounds-test
  (test-suite "interleaved component rounds and snapshot-bound joint revision"
    (test-case "six rounds interleave insertion replacement restoration and repeated merge split"
      (def policies [(.o (allowed #t) (limit 30)) (.o (allowed #t) (limit 30))])
      (defvalues (old failure) (initial.publish #f (service.source 3 4) (car policies) (.cc cache.Builder.)))
      (check-equal? failure #f)
      (def stale (service.revision-action old 'merge [] policies topology-builder))
      (def merged (stale old))
      (check-equal? (length (members merged 'shared)) 7)
      (check-equal? (evaluated merged) '(shared monitor settlement))
      (def replaced ((service.revision-action merged 'replace [] policies topology-builder) merged))
      (check-equal? (members replaced 'shared) '(shared a e))
      (check-equal? (members replaced 'c) '(c f))
      (check-equal? (evaluated replaced) '(shared c monitor settlement))
      (check-exception (graph-cache-ref replaced 'b) true)
      (def restored ((service.revision-action replaced 'restore [] policies topology-builder) replaced))
      (check-equal? (members restored 'shared) '(shared a b))
      (check-equal? (members restored 'c) '(c d))
      (for-each (lambda (key) (check-equal? (service.value restored key) (service.value old key)))
        '(quota spare shared a b c d monitor settlement stable))
      (check-exception (stale restored) true)
      (def next ((service.revision-action restored 'merge [(cons 'spare (some (code.make-success 5)))] policies
        (.cc cache.Builder. allow: (lambda (key) (not (memq key '(quota stable)))))) restored))
      (check-equal? (service.value next 'settlement) 30)
      (def split ((service.revision-action next 'replace [] policies topology-builder) next))
      (check-equal? (service.value split 'settlement) 20)
      (def final ((service.revision-action split 'restore [(cons 'quota (some (code.make-success 2)))] policies
        (.cc cache.Builder. allow: (lambda (key) (not (memq key '(spare stable)))))) split))
      (check-equal? (service.value final 'settlement) 8)
      (check-equal? (service.value final 'shared) 2)
      (for-each (lambda (current)
        (check (eq? (graph-cache-ref old 'stable) (graph-cache-ref current 'stable)) => #t))
        [merged replaced restored next split final])
      (for-each (lambda (key)
        (check-exception (graph-cache-ref final key) true)
        (check-equal? (.call (graph-cache-source final) .code key) #f)
        (check-equal? (.call (graph-cache-source final) .base key) #f)) '(e f)))
    (test-case "snapshot check rejects stale requests before preparation builders or approval"
      (def policies [(.o (allowed #t) (limit 30)) (.o (allowed #t) (limit 30))])
      (defvalues (old _) (initial.publish #f (service.source 3 4) (car policies) (.cc cache.Builder.)))
      (def reached? #f)
      (def action (revision.revision-action old [] service.build-group
        (lambda (_ __) (set! reached? #t) #t)
        builder: (.cc cache.Builder. allow: (lambda (_) (set! reached? #t) #f))))
      (def merged ((service.revision-action old 'merge [] policies topology-builder) old))
      (def replaced ((service.revision-action merged 'replace [] policies topology-builder) merged))
      (def restored ((service.revision-action replaced 'restore [] policies topology-builder) replaced))
      (defvalues (held refused) (attempt restored action))
      (check (eq? held restored) => #t) (check (not (not refused)) => #t) (check-equal? reached? #f)
      (def fresh (revision.revision-action restored [] service.build-group (lambda (_ __) #t)
        builder: (.cc cache.Builder. allow: (lambda (_) #f))))
      (def accepted (fresh restored))
      (check-equal? (evaluated accepted) [])
      (check-exception (fresh accepted) true))
    (test-case "one service refuses a later split and refreshed approval retries unchanged old"
      (def policies [(.o (allowed #t) (limit 30)) (.o (allowed #t) (limit 30))])
      (defvalues (old _) (initial.publish #f (service.source 3 4) (car policies) (.cc cache.Builder.)))
      (def merged ((service.revision-action old 'merge [] policies topology-builder) old))
      (.putslot! (cadr policies) 'allowed ($constant-slot-spec #f))
      (def request (service.revision-action merged 'replace [] policies topology-builder))
      (defvalues (held refused) (attempt merged request))
      (check (eq? held merged) => #t) (check (not (not refused)) => #t)
      (check-equal? (length (members held 'shared)) 7)
      (.putslot! (cadr policies) 'allowed ($constant-slot-spec #t))
      (check-exception (request held) true)
      (def split ((service.revision-action held 'replace [] policies topology-builder) held))
      (check-equal? (members split 'c) '(c f))
      (check-equal? (evaluated split) '(shared c monitor settlement))
      (check-exception (request split) true))
    (test-case "partial restoration refuses before construction when a survivor still reads deleted E"
      (def policies [(.o (allowed #t) (limit 30)) (.o (allowed #t) (limit 30))])
      (defvalues (old _) (initial.publish #f (service.source 3 4) (car policies) (.cc cache.Builder.)))
      (def merged ((service.revision-action old 'merge [] policies topology-builder) old))
      (def replaced ((service.revision-action merged 'replace [] policies topology-builder) merged))
      (def part (car (service.contributions 'restore)))
      (def incomplete (.cc part codes: (filter (lambda (entry) (not (eq? (car entry) 'a))) (.@ part codes))))
      (def reached? #f)
      (def action (revision.revision-action replaced [incomplete] service.build-group
        (lambda (_ __) (set! reached? #t) #t)
        builder: (.cc cache.Builder. allow: (lambda (_) (set! reached? #t) #f))))
      (defvalues (held refused) (attempt replaced action))
      (check (eq? held replaced) => #t) (check (not (not refused)) => #t) (check-equal? reached? #f))
    (test-case "fresh no-op approval observes both policies and guarded writes cannot publish"
      (def policies [(.o (allowed #t) (limit 30)) (.o (allowed #t) (limit 30))])
      (defvalues (old _) (initial.publish #f (service.source 3 4) (car policies) (.cc cache.Builder.)))
      (def action (revision.revision-action old [] service.build-group (service.admit policies)
        builder: (.cc cache.Builder. allow: (lambda (_) #f))))
      (.putslot! (cadr policies) 'allowed ($constant-slot-spec #f))
      (defvalues (held refused) (attempt old action))
      (check (eq? held old) => #t) (check (not (not refused)) => #t)
      (.putslot! (cadr policies) 'allowed ($constant-slot-spec #t))
      (check-equal? (evaluated (action old)) [])
      (def corrupt (.cc cache.Builder. allow: (lambda (_)
        (.putslot! (cadr policies) 'allowed ($constant-slot-spec #f)) #t)))
      (defvalues (same denied) (attempt old (service.revision-action old 'merge [] policies corrupt)))
      (check (eq? same old) => #t) (check (not (not denied)) => #t)
      (check-equal? (.@ (cadr policies) allowed) #t))
    (test-case "repeated cycles preserve untouched receipts and require a new expected snapshot each round"
      (def policies [(.o (allowed #t) (limit 30)) (.o (allowed #t) (limit 30))])
      (defvalues (old _) (initial.publish #f (service.source 3 4) (car policies) (.cc cache.Builder.)))
      (def final (foldl (lambda (phase current)
        (def next ((service.revision-action current phase [] policies topology-builder) current))
        (check (eq? (graph-cache-ref old 'stable) (graph-cache-ref next 'stable)) => #t)
        (check-equal? (service.value next 'shared) (if (eq? phase 'restore) 3 4)) next)
        old '(merge replace restore merge replace restore merge replace restore)))
      (check-equal? (members final 'shared) '(shared a b))
      (check-equal? (service.value final 'settlement) 12))))
