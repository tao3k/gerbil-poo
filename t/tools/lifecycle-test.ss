(export lifecycle-test)
(import :std/test :clan/poo/object :clan/poo/mop :clan/poo/number :clan/poo/brace (prefix-in :clan/poo/examples/lifecycle lifecycle.))
;; Functional TODO controls: explicit admission, optics, lazy fallback and cycles.
(def lifecycle-test
  (test-suite "native object lifecycle and delegation"
    (test-case "checked constructors validate before hooks and validate replacements"
      (def hooks 0)
      (define-type (Account @ Class.)
        slots: =>.+ {capacity: {type: Integer} used: {type: Integer}}
        .instantiate: (lambda (value)
          (set! hooks (+ hooks 1))
          (unless (<= (.@ value used) (.@ value capacity)) (error "capacity exceeded")) value))
      (def account (make-instance Account capacity: 10 used: 3))
      (check-equal? (.@ account used) 3) (check-equal? hooks 1)
      (check-exception (make-instance Account capacity: "bad" used: 0) true)
      (check-equal? hooks 1)
      (check-exception (.new/checked Account capacity: 2 used: 3) true)
      (check-equal? hooks 2)
      (def partial (.new Account capacity: 10))
      (check-equal? (element? Account partial) #f) (check-equal? hooks 2)
      (def classes 0)
      (def full (.new/checked (begin (set! classes (+ classes 1)) Account)
        capacity: 8 used: 4))
      (check-equal? classes 1) (check-equal? (.@ full capacity) 8)
      (define-type (Broken @ Account)
        .instantiate: (lambda (value) (.cc value used: "invalid replacement")))
      (check-exception (make-instance Broken capacity: 10 used: 1) true))
    (test-case "static and dynamic lens paths compose persistent updates"
      (def raw (.o (billing (.o (capacity 10) (audit 'keep))) (tenant 'eu)))
      (def focus (.lens billing capacity))
      (check-equal? (.call focus .get raw) 10)
      (def revised (.call focus .set 20 raw))
      (check-equal? (.call (slots-lens '(billing capacity)) .get revised) 20)
      (check-equal? (.@ (.@ revised billing) audit) 'keep)
      (check-equal? (.@ revised tenant) 'eu)
      (check-equal? (.call focus .get raw) 10)
      (check (eq? (.call (.lens) .get raw) raw) => #t)
      (check (eq? (.call (.lens) .set raw revised) raw) => #t)
      (check-exception (slots-lens '(billing 3)) true))
    (test-case "lazy delegation is receiver-local and direct slots bypass it"
      (def forced 0)
      (def source (fallback-to (lambda ()
        (set! forced (+ forced 1)) (.o (capacity 10) (approved #f)))))
      (def first (.o (:: @ source) (local 7)))
      (def second (.o (:: @ source) (local 9)))
      (check-equal? (.@ first local) 7) (check-equal? forced 0)
      (check-equal? (.@ first capacity) 10) (check-equal? (.@ first approved) #f)
      (check-equal? (.@ first capacity) 10) (check-equal? forced 1)
      (check-equal? (.@ second capacity) 10) (check-equal? forced 2)
      (check-exception (.@ first absent) NoApplicableMethod?))
    (test-case "checked revision optics and FUN compose without stale tenant admission"
      (def sources 0) (def calls 0)
      (def service (lifecycle.make-service 10 4 'eu (lambda ()
        (set! sources (+ sources 1))
        (.o (quota (lambda (tenant) (set! calls (+ calls 1))
          (case tenant ((eu) 100) ((us) 200) (else (error "tenant refused")))))))))
      (check-equal? sources 0)
      (check-exception ((lifecycle.revision-action 3 'us) service) true)
      (check-equal? sources 0) (check-equal? calls 0)
      (check-equal? ((lifecycle.revision-action 20 'us) service) '(20 4 us 200))
      (check-equal? (lifecycle.report service) '(10 4 eu 100))
      (check-equal? ((lifecycle.revision-action 30 'eu) service) '(30 4 eu 100))
      (check-exception ((lifecycle.revision-action 20 0) service) true)
      (check-equal? calls 3)
      (check-exception ((lifecycle.revision-action 20 'revoked) service) true)
      (check-equal? (lifecycle.report service) '(10 4 eu 100)))
    (test-case "slot and delegation cycles fail finitely and unwind the active path"
      (def circular (.o (:: self []) (a (.@ self b)) (b (.@ self a))))
      (def cycle (try (.@ circular a) #f (catch (cause) cause)))
      (check (CyclicSlot? cycle) => #t)
      (check-equal? (map cdr (CyclicSlot-path cycle)) '(a b a))
      (def broken-hook (.o (:: self [])
        (no-applicable-method (.@ self no-applicable-method))))
      (check-exception (.@ broken-hook absent) CyclicSlot?)
      (check-equal? (active-slot-computations) [])
      (def delegate #f)
      (set! delegate (fallback-to (lambda () delegate)))
      (check-exception (.@ delegate absent) CyclicSlot?)
      (check-equal? (active-slot-computations) [])
      (def attempts 0)
      (def retried (.o (value (begin (set! attempts (+ attempts 1))
        (when (= attempts 1) (error "retryable source error")) #f))))
      (check-exception (.@ retried value) true)
      (check-equal? (.@ retried value) #f) (check-equal? (.@ retried value) #f)
      (check-equal? attempts 2) (check-equal? (active-slot-computations) []))))
