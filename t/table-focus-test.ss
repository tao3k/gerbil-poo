;;; Key focuses retain typed admission, ownership and compositional modification.
(export table-focus-test)
(import :std/test :std/error :std/iter (only-in ../brace @@method)
        ../object ../mop ../type ../number ../table ../rationaldict ../support/option
        (only-in ../trie SimpleTrie)
        (prefix-in ../examples/service-collection service.))

;; Distinguish documented protocol failures from unrelated backend exceptions.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; Exercise public Lens and receiver APIs rather than private capability fields.
(def table-focus-test
  (test-suite "typed table key focus"
    (test-case "required and optional raw focuses obey value-before-state and preserve frames"
      (for (table (list (RationalDict Integer) (SimpleTrie UInt Integer)))
        (def root (.call table .<-list '((1 . 10) (2 . 20))))
        (def required (.call table .lens 1)) (def optional (.call table .lens/opt 3))
        (check-equal? (.call required .get root) 10)
        (def changed (.call required .set 11 root))
        (check-equal? (.call required .get changed) 11)
        (check-equal? (.call table .ref changed 2) 20)
        (check-equal? (.call table .ref root 1) 10)
        (def inserted (.call optional .set (some 30) root))
        (check-equal? (some-value (.call optional .get inserted)) 30)
        (check-equal? (.call table .list<- (.call optional .set #f inserted)) (.call table .list<- root))
        (check-exception (.call required .set "bad" root) TypeError?)
        (check-exception (.call optional .set (some "bad") root) TypeError?)
        (check-exception (.call optional .set '(not-an-option) root) (message? "table update must return Option"))
        (check-exception (.call table .lens/opt "bad-key") TypeError?)))
    (test-case "raw updates typecheck before publication and required absence suppresses modifiers"
      (def table (RationalDict Integer)) (def root (.call table .<-list '((1 . 10))))
      (def calls 0)
      (check-exception (.call table .update/opt 1 (lambda (_) (set! calls (+ calls 1)) (some "bad")) root) TypeError?)
      (check-equal? calls 1) (check-equal? (.call table .ref root 1) 10)
      (check-exception (.call Lens .modify (.call table .lens 9) (lambda (_) (set! calls (+ calls 1)) 1) root) Error?)
      (check-equal? calls 1)
      (check-equal? (.call table .ref (.call table .update 9 (lambda (v) (+ v 1)) root (lambda () 90)) 9) 91)
      (check (eq? root (.call table .update/opt 1 identity root)) => #t))
    (test-case "five styles preserve focus observations and their own identity rules"
      (def table (RationalDict Bool)) (def root (.call table .<-list '((1 . #f))))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles table) name))
        (def owner (.call protocol .ap root))
        (def focus (.call protocol .lens/opt 2))
        (check (.call focus .get owner) => #f)
        (def next (.call focus .set (some #f) owner))
        (check (some? (.call focus .get next)) => #t)
        (check (some-value (.call focus .get next)) => #f)
        (case name
          ((Pure Posh) (check (.call focus .get owner) => #f))
          ((Mutable Classy) (check (eq? next owner) => #t))
          ((Linear) (check-exception (.call focus .get owner) (message? "consumed table reference"))))
        (def removed (.call Lens .modify focus (lambda (_) #f) next))
        (check (.call focus .get removed) => #f)))
    (test-case "composed modification rejects a reentrant winner without overwriting it"
      (for (name '(Mutable Linear Classy))
        (def table (RationalDict Integer)) (def protocol (.ref (table-styles table) name))
        (def owner (.call protocol .ap (.call table .<-list '((1 . 10) (2 . 20)))))
        (def service (.o ledger: owner sibling: 42))
        (def focus (.call Lens .compose (.lens ledger) (.call protocol .lens 1)))
        (def winner #f) (def calls 0)
        (check-exception (.call Lens .modify focus (lambda (value)
          (set! calls (+ calls 1))
          (set! winner (.call protocol .update 1 (lambda (_) 99) owner)) (+ value 1)) service)
          (message? "stale table reference"))
        (check-equal? calls 1) (check-equal? (.call protocol .ref winner 1) 99)
        (check-equal? (.@ service sibling) 42)))
    (test-case "metadata and foreign owners refuse before modification callbacks"
      (def dependency (.o revision: 0))
      (def table (.cc (RationalDict Integer) .sources: (list dependency)))
      (def root (.call table .<-list '((1 . 10))))
      (def raw (.call table .lens 1))
      (def protocol (.@ (table-styles table) Linear)) (def focus (.call protocol .lens 1))
      (def owner (.call protocol .ap root)) (def calls 0)
      (def foreign (.call (.@ (table-styles table) Linear) .ap root))
      (check-exception (.call Lens .modify focus (lambda (_) (set! calls (+ calls 1)) 1) foreign)
        (message? "incompatible table reference"))
      (.set! dependency revision 1)
      (check-exception (.call raw .get root) (message? "stale table focus"))
      (check-exception (.call Lens .modify focus (lambda (_) (set! calls (+ calls 1)) 1) owner)
        (message? "stale table styles"))
      (check-equal? calls 0))
    (test-case "Function identity late refinement failure and fresh retry compose through FUN IO"
      (def function (Fun Integer <- Integer)) (def table (RationalDict function))
      (def f (validate function (lambda (n) (+ n 1))))
      (def root (.call table .acons 1 f (.@ table .empty)))
      (def protocol (.@ (table-styles table) Classy)) (def owner (.call protocol .ap root))
      (def required (@@method owner.lens 1))
      (check (eq? f (.call required .get owner)) => #t)
      (.call Lens .modify required identity owner)
      (check (eq? f (.call required .get owner)) => #t)
      (check-exception ((some-value (@@method owner.ref/opt 1)) "bad") TypeError?)
      (def captured (@@method owner.delta/opt 1 (lambda (_) #f)))
      (check-equal? (@@method owner.count) 1)
      (@@method owner.apply-delta captured)
      (check-equal? (@@method owner.count) 0)
      (def base-table (RationalDict Integer))
      (def bounded (.cc base-table .element?:
        (lambda (r) (and (element? base-table r)
          (.call base-table .every (lambda (_ v) (<= v 100)) r)))))
      (def base (.call bounded .<-list '((1 . 10) (2 . 20))))
      (def calls 0)
      (def consume (lambda (r) (set! calls (+ calls 1)) r))
      (check-exception (service.revise-focused-ledger bounded base 1 (lambda (_) 101) consume) TypeError?)
      (check-equal? calls 0)
      (def next (service.revise-focused-ledger bounded base 1 (lambda (v) (+ v 1)) consume))
      (check-equal? (.call bounded .ref next 1) 11) (check-equal? (.call bounded .ref next 2) 20)
      (check-equal? calls 1))
    (test-case "all finite optional lens laws use observations across all five styles"
      (def table (RationalDict Bool)) (def root (.call table .<-list '((1 . #f) (2 . #t))))
      (for* ((name '(Pure Mutable Linear Posh Classy)) (key '(1 3))
             (first (list #f (some #f) (some #t))) (second (list #f (some #f) (some #t))))
        (def protocol (.ref (table-styles table) name))
        (def focus (.call protocol .lens/opt key))
        (def source (.call protocol .ap root))
        (def unchanged (.call focus .set (.call focus .get source) source))
        (check-equal? (.call protocol .list<- unchanged) (.call table .list<- root))
        (def once (.call focus .set first (.call protocol .ap root)))
        (check-equal? (.call focus .get once) first)
        (def twice (.call focus .set second once))
        (def direct (.call focus .set second (.call protocol .ap root)))
        (check-equal? (.call protocol .list<- twice) (.call protocol .list<- direct))))))
