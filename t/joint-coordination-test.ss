(export joint-coordination-test)
(import :std/test :std/sync/threads ../object ../mop ../brace ../feedback-graph
        (prefix-in ../joint-publication joint.) (prefix-in ../construction-cache cache.)
        (prefix-in ../examples/joint-topology service.) (prefix-in ../examples/joint-receipts receipts.)
        (prefix-in ../examples/joint-workers workers.) (prefix-in ../examples/joint-coordination coordination.))
;; Private named records preserve receipt/outcome and checkpoint provenance.
(defstruct observation (receipt snapshot failure) final: #t)
;; A supervisor checkpoint retains the one-shot reply for its specific coordinator.
(defstruct checkpoint (name value reply) final: #t)
;; Independent feedback never rebuilds while coordinators create competing heads.
(def builder (.cc cache.Builder. allow: (lambda (key) (not (eq? key 'stable)))))
;; Explicit final-round marker is separate from repeating topology phase names.
(def rows '((merge 24 48 24 #f) (replace 16 32 16 #f) (restore 12 24 12 #f)
            (merge 24 48 24 #f) (replace 16 32 16 #f) (restore 12 24 12 #t)))
;; Pre-cook immutable proposed metadata before sharing it across coordinator threads.
(def (policy owner ceiling budget)
  (def value (.cc (joint.approval (joint.current owner) 'shared) limit: ceiling budget: budget))
  (instantiate-object! value) value)
;; Every coordinator owns its own installation scope and counter/receive channel.
;; It retains a late worker across concurrent next-round construction and retry.
(def (coordinator owner exchange)
  (workers.call-with-installations owner (lambda (start receive)
    (let loop ((old-go #f) (old-receipt #f))
      (def command (exchange '(next)))
      (def changes (map (lambda (key) (cons key (.cc service.Change. phase: (car command)))) '(a b)))
      (def bad (car (receipts.approve-revisions owner [changes] (cadr command) builder)))
      (def bad-go (start bad))
      (exchange (list 'approved bad))
      (bad-go) (def refused (receive))
      (def fresh-policy (exchange (list 'refused refused)))
      ;; Both coordinators explicitly capture CURRENT sources again after refusal.
      (def fresh (receipts.approve-revisions owner [changes changes] fresh-policy builder))
      (def primary-go (start (car fresh))) (def later-go (start (cadr fresh)))
      (exchange (list 'ready (car fresh)))
      (when old-go (old-go)) (primary-go)
      (def results (if old-go [(receive) (receive)] [(receive)]))
      (def decision (exchange (list 'published (car fresh) old-receipt results)))
      (if (eq? decision 'finish)
        (begin (later-go) (exchange (list 'drained (receive))) (void))
        (loop later-go (cadr fresh))))) report: make-observation))
;; Receive both independently arriving checkpoints and validate the expected phase.
(def (both next phase)
  (def results (map (lambda (_) (next make-checkpoint)) '(a b)))
  (for-each (lambda (entry) (check-equal? (car (checkpoint-value entry)) phase)) results)
  (check (not (eq? (checkpoint-name (car results)) (checkpoint-name (cadr results)))) => #t)
  results)
;; Native source construction and publication genuinely occur on two coordinators.
(def joint-coordination-test
  (test-suite "independent coordinators restage and publish through six SCC rounds"
    (test-case "shared refusal then parallel fresh approvals race while older workers remain pending"
      (def owner (service.start)) (def original (joint.current owner))
      (coordination.call-with-coordinators
        [(cons 'a (lambda (exchange) (coordinator owner exchange)))
         (cons 'b (lambda (exchange) (coordinator owner exchange)))]
        (lambda (next)
          (for-each (lambda (row)
            (def before (joint.current owner)) (def shared (policy owner (cadr row) (caddr row)))
            (for-each (lambda (entry) ((checkpoint-reply entry) (list (car row) shared))) (both next 'next))
            (def approved (both next 'approved))
            (check (eq? before (joint.current owner)) => #t)
            ;; Both coordinator admissions returned; only uninstalled metadata drifts.
            (.putslot! shared 'budget ($constant-slot-spec (+ (caddr row) 1)))
            (.putslot! shared 'budget ($constant-slot-spec (caddr row)))
            (for-each (lambda (entry) ((checkpoint-reply entry) 'install)) approved)
            (def denied (both next 'refused))
            (for-each (lambda (entry)
              (def result (cadr (checkpoint-value entry)))
              (check (not (not (observation-failure result))) => #t)
              (check (eq? (observation-snapshot result) before) => #t)) denied)
            (for-each (lambda (entry)
              ((checkpoint-reply entry) (policy owner (cadr row)
                (+ (caddr row) (if (eq? (checkpoint-name entry) 'a) 0 2))))) denied)
            (for-each (lambda (entry) ((checkpoint-reply entry) 'install)) (both next 'ready))
            (def published (both next 'published)) (def successes 0) (def winner (joint.current owner))
            (for-each (lambda (entry)
              (def message (checkpoint-value entry))
              (for-each (lambda (result)
                (if (eq? (observation-receipt result) (cadr message))
                  (unless (observation-failure result)
                    (set! successes (+ successes 1)) (check (eq? (observation-snapshot result) winner) => #t))
                  (begin (check (eq? (observation-receipt result) (caddr message)) => #t)
                         (check (not (not (observation-failure result))) => #t)))
                (check (or (eq? (observation-snapshot result) before) (eq? (observation-snapshot result) winner)) => #t))
                (list-ref message 3))) published)
            (check-equal? successes 1)
            (for-each (lambda (key)
              (check-equal? (service.value winner key) (list-ref row 3))
              (check (eq? (graph-cache-ref (joint.head original key) 'stable)
                          (graph-cache-ref (joint.head winner key) 'stable)) => #t)
              (case (car row)
                ((replace) (check-exception (graph-cache-ref (joint.head winner key) 'b) true))
                ((restore) (for-each (lambda (removed)
                  (check-exception (graph-cache-ref (joint.head winner key) removed) true)
                  (check-equal? (.call (graph-cache-source (joint.head winner key)) .code removed) #f)
                  (check-equal? (.call (graph-cache-source (joint.head winner key)) .base removed) #f)) '(e f))))) '(a b))
            (for-each (lambda (entry) ((checkpoint-reply entry) (if (list-ref row 4) 'finish 'continue))) published))
            ;; The final marker is explicit; phase names repeat across cycles.
            rows)
          (for-each (lambda (entry)
            (check (not (not (observation-failure (cadr (checkpoint-value entry))))) => #t)
            ((checkpoint-reply entry) 'done)) (both next 'drained))))
      (check-equal? (service.value (joint.current owner) 'a) 12))
    (test-case "standard thread-group cleanup includes pending workers on supervisor failure"
      (def owner (service.start)) (def before (joint.current owner)) (def group #f)
      (def receipt (car (receipts.approve-revisions owner
        [[(cons 'a (.cc service.Change. phase: 'merge))]] (policy owner 24 36) builder)))
      (def failure (list 'supervisor-refused))
      (check-exception (coordination.call-with-coordinators
        [(cons 'a (lambda (exchange)
          (workers.call-with-installations owner (lambda (start _)
            (start receipt) (exchange (current-thread-group))))))]
        (lambda (next) (next (lambda (_ value __)
          (set! group value) (check (>= (length (thread-group->thread-list* group)) 2) => #t)
          (raise failure))))) (lambda (caught) (eq? caught failure)))
      (check (eq? before (joint.current owner)) => #t)
      (check (andmap (lambda (thread)
        (def state (thread-state thread))
        (or (thread-state-normally-terminated? state) (thread-state-abnormally-terminated? state)))
        (thread-group->thread-list* group)) => #t))))
