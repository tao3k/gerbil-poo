;;; Scalar families share one finite inference and original declaration chain.
(export scalar-inference-test)
(import :std/test :std/error (only-in :std/number/misc uint-below?) (only-in :gerbil/runtime/gambit string->uninterned-symbol) ../object ../mop ../prototype-types ../types/relation ../method-declaration
        (prefix-in ../examples/polymorphic-services service.)
        (prefix-in ../examples/numeric-services numeric.))
;; Distinguish typed refusal from ordinary false data and user target exceptions.
(def (refusal kind) (lambda (cause) (and (type-refusal? cause) (eq? (type-refusal-kind cause) kind))))
;; Symbols are immutable literals; Symbol and String are unrelated scalar Types.
(def calls '((() ((Enum run report)) (String (Function (String) (Symbol))))))
;; A nonunique or incomplete request must never enter a declaration builder.
(def (forbidden _) (error "scalar inference must complete before building"))
;; Independent host predicates control admission; no registry enumeration is used.
(def scalar-inference-test
  (test-suite "String Symbol inference and literal publication"
    (test-case "Rational distinguishes finite flonums and joint Real coverage"
      (def descriptor (expression-type 'Rational))
      (for-each (lambda (value)
        (check-equal? (element? descriptor value) (rational? value))
        (if (rational? value)
          (check (eq? (validate descriptor value) value) => #t)
          (check-exception (validate descriptor value) TypeError?)))
        (list -1 0 1/2 1.5 +inf.0 -inf.0 +nan.0 1+2i #f value: #!key #!rest))
      (for-each (lambda (source) (check (subtype-expression? source 'Rational) => #t))
        '(Integer UInt UInt256 JsInt (UIntN 8) (IntN 8) (Z/ 7) (Enum -1 2)))
      (check (subtype-expression? 'Rational 'Real) => #t)
      (check (subtype-expression? 'Rational 'Number) => #t)
      (check (subtype-expression? 'Float 'Rational) => #f)
      (check (subtype-expression? 'Rational 'Float) => #f)
      (check (subtype-expression? 'Real 'Rational) => #f)
      (for-each (lambda (target) (check (subtype-expression? 'Real target) => #t))
        '((Union Rational Float) (Union Float Rational) (Union Keyword (Union Rational Float))))
      (check (subtype-expression? 'Real '(Union Rational Integer)) => #f)
      (check (subtype-expression? 'Real '(Union Float Integer)) => #f)
      (check (subtype-expression? '(Union Rational Float) '(Union Float Rational)) => #f)
      (check (subtype-expression? '(Map Rational <- (Z/ 7)) '(Map Real <- UInt)) => #f)
      (check (subtype-expression? '(TypeValuePair Rational) '(TypeValuePair Real)) => #f)
      (def carried (expression-type 'Rational))
      (def tagged (validate (expression-type '(TypeValuePair Rational Real)) (cons carried 1.5)))
      (check (eq? (car tagged) carried) => #t)
      (check-equal? (cdr tagged) 1.5)
      (check-exception (validate (expression-type '(TypeValuePair Rational)) (cons carried +inf.0)) TypeError?)
      (check (function-covers? '(Function (Rational) (Real) keywords: ((scale: . Rational)))
        '(Function (Real) ((Z/ 7)))) => #t)
      (check-exception (subtype-expression? 'Real '(Union Rational Float (Unknown))) (refusal 'unsupported))
      (check-exception (subtype-expression? 'Real '(Union Rational Float) 1) (refusal 'exhausted)))
    (test-case "literal modulus reuses unsigned bounds without normalization or residue enumeration"
      (for-each (lambda (modulus)
        (def term (list 'Z/ modulus)) (def descriptor (expression-type term))
        (check-equal? (.get descriptor sexp) term)
        (for-each (lambda (value)
          (check-equal? (element? descriptor value) (uint-below? value modulus))
          (if (uint-below? value modulus)
            (check-equal? (validate descriptor value) value)
            (check-exception (validate descriptor value) TypeError?)))
          (list -1 0 (1- modulus) modulus 1.0 1/2 #f value: #!key #!rest))) '(1 7 256))
      (check (subtype-expression? '(Z/ 7) '(Z/ 11)) => #t)
      (check (subtype-expression? '(Z/ 11) '(Z/ 7)) => #f)
      (check (subtype-expression? '(Z/ 1) '(Exactly 0)) => #t)
      (check (subtype-expression? '(Z/ 3) '(Enum 2 0 1 2)) => #t)
      (check (subtype-expression? '(Z/ 3) '(Enum 0 2)) => #f)
      (check (subtype-expression? '(IntegerRange min: 0 max: 6) '(Z/ 7)) => #t)
      (check (subtype-expression? '(Z/ 7) '(Union (Z/ 3) (IntegerRange min: 3 max: 6))) => #t)
      (check (subtype-expression? '(Z/ 7) '(Union (Z/ 3) (IntegerRange min: 4 max: 6))) => #f)
      (check (function-covers? '(Function ((Z/ 7)) (Rational) optional: (Rational) rest: Rational)
        '(Function (Rational) ((Z/ 3)) optional: ((Z/ 7)) rest: (Z/ 7))) => #t)
      (check (function-covers? '(Function ((Z/ 7)) (Rational) keywords: ((scale: . Rational)))
        '(Function (Rational) ((Z/ 3)))) => #t)
      (for-each (lambda (term) (check-exception (expression-type term) (refusal 'malformed)))
        '((Z/) (Z/ 0) (Z/ -1) (Z/ 7.0) (Z/ T) (Z/ 7 8)))
      (check-exception (expression-type (list 'Z/ (arithmetic-shift 1 4096))) (refusal 'unsupported))
      (def large (list 'Z/ (arithmetic-shift 1 4095)))
      (check (subtype-expression? large 'Rational) => #t)
      (check-exception (expression-type large 20) (refusal 'exhausted))
      (check-exception (prototype-type (.o .parameters: '(Z/)) '(Z/) 'Z/ []) (refusal 'malformed))
      (def syntax (list 'Z/ 7)) (def saved (expression-type syntax))
      (set-car! (cdr syntax) 2)
      (check-equal? (.get saved sexp) '(Z/ 7))
      (check-equal? (validate saved 6) 6)
      (check-exception (validate saved 7) TypeError?))
    (test-case "residue inference specializes complete qualified methods and nested callbacks"
      (def events []) (def consumed 0) (def calibrated 0)
      (def output (numeric.residue-output 7))
      (def report (numeric.infer-residue-service 7 (list 'Bool (numeric.residue-output 11) output)
        (lambda (event) (set! events (cons event events)))))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) (list (list output)))
      (check-equal? events [])
      (def context (.o approved: #t)) (def readings (make-hash-table))
      (hash-put! readings 1 -3/2) (hash-put! readings 2 15.5)
      (def batch (cons readings (lambda (value) (set! calibrated (1+ calibrated)) (+ value 1/2))))
      (def observed #f)
      (def action (service.descriptor-service-action (.get report instance) batch context
        (lambda (subject)
          (set! consumed (1+ consumed)) (set! observed subject)
          (def result (.get subject answer))
          (check-equal? (hash-get (car result) 1) 5)
          (check-equal? (hash-get (car result) 2) 1)
          (check-equal? ((cdr result) 3/2) 2)
          (check-exception ((cdr result) +inf.0) TypeError?)
          (check-exception ((cdr result) #!key) TypeError?)
          (def again ((.get subject callback) batch))
          (check-equal? (hash-get (car again) 1) 5)
          (check-exception ((cdr ((.get subject callback) (cons readings (lambda (_) 'wrong)))) 1) TypeError?))))
      (defvalues (evidence next failure) (action context))
      (check-equal? failure #f) (check-equal? consumed 1) (check-equal? calibrated 1)
      (check (eq? next context) => #t)
      (check (eq? (.get evidence subject) observed) => #t)
      (check (eq? (.get evidence context) context) => #t)
      (check-equal? (hash-get readings 1) -3/2)
      (check-exception ((service.descriptor-service-action (.get report instance) batch context
        (lambda (_) (set! consumed 99)) #f) context) TypeError?)
      (check-equal? consumed 1)
      (defvalues (_ _next retried) (action context))
      (check-equal? retried #f) (check-equal? consumed 2)
      (def invalid (make-hash-table)) (hash-put! invalid 1 +nan.0)
      ;; Snapshot after successful calls in an expression scope: an internal
      ;; definition can initialize before the surrounding test expressions.
      (let (before events)
        (check-exception ((service.descriptor-service-action (.get report instance) (cons invalid identity) context
          (lambda (_) (set! consumed 99))) context) TypeError?)
        (check-equal? consumed 2) (check-equal? events before))
      (check-equal? (.get (numeric.infer-residue-service 7 '(Bool)) status) 'no-solution)
      (check-equal? (.get (numeric.infer-residue-service 7 (list output (numeric.residue-output 3))) status) 'ambiguous)
      (check-exception (numeric.infer-residue-service 0 (list output)) (refusal 'malformed))
      (def wrong (service.infer-descriptor-service (list numeric.residue-input) (list output)
        (list (list [] (list numeric.residue-input)
          (list output `(Function (,output) (,numeric.residue-input)))))
        (lambda (batch) (values batch identity))))
      (check-equal? (.get wrong status) 'unique)
      (def out-of-range (make-hash-table)) (hash-put! out-of-range 1 7)
      (check-exception ((service.descriptor-service-action (.get wrong instance) (cons out-of-range identity) context
        (lambda (_) (set! consumed 99))) context) TypeError?)
      (check-equal? consumed 2))
    (test-case "joint Real view publishes exceptional flonums without changing ordered alternatives"
      (def report (numeric.infer-real-batch-service (list 'Bool numeric.real-batch-output)))
      (check-equal? (.get report status) 'unique)
      (def context (.o approved: #t)) (def readings (make-hash-table))
      (hash-put! readings 1 +inf.0) (hash-put! readings 2 +nan.0) (hash-put! readings 3 1/2)
      (def consumed 0)
      (def action (service.descriptor-service-action (.get report instance) (cons readings identity) context
        (lambda (subject)
          (set! consumed (1+ consumed))
          (def result (.get subject answer))
          (check-equal? (hash-get (car result) 1) +inf.0)
          (check (nan? (hash-get (car result) 2)) => #t)
          (check-equal? (hash-get (car result) 3) 1/2)
          (check-equal? ((cdr result) +inf.0) +inf.0)
          (check-exception ((cdr result) 1+2i) TypeError?)
          (def again ((.get subject callback) (cons readings identity)))
          (check-equal? ((cdr again) 1/2) 1/2))))
      (defvalues (evidence next failure) (action context))
      (check-equal? failure #f) (check-equal? consumed 1)
      (check (eq? next context) => #t) (check (eq? (.get evidence context) context) => #t)
      (check-exception ((service.descriptor-service-action (.get report instance) (cons readings identity) context
        (lambda (_) (set! consumed 99)) #f) context) TypeError?)
      (check-equal? consumed 1)
      (defvalues (_ _next retried) (action context))
      (check-equal? retried #f) (check-equal? consumed 2))
    (test-case "numeric descriptors reuse intrinsic predicates without numeric casts"
      (def samples (list #f 0 -1 1/2 1.0 +inf.0 +nan.0 1+2i 'value value: #!key #!rest))
      (for-each (lambda (name recognize)
        (def descriptor (expression-type name))
        (for-each (lambda (value)
          (check-equal? (element? descriptor value) (recognize value))
          (if (recognize value)
            (check (eq? (validate descriptor value) value) => #t)
            (check-exception (validate descriptor value) TypeError?))) samples))
        '(Number Real Float) (list number? real? flonum?))
      (for-each (lambda (source)
        (check (subtype-expression? source 'Real) => #t)
        (check (subtype-expression? source '(Union Keyword Number)) => #t))
        '(Float Real Integer UInt UInt256 JsInt (UIntN 0) (IntN 8)
          (IntegerRange min: -10 max: 20) (Enum -1 2)))
      (check (subtype-expression? 'Number 'Real) => #f)
      (check (subtype-expression? 'Real 'Float) => #f)
      (check (subtype-expression? 'Float 'Integer) => #f)
      (check (subtype-expression? 'Integer 'Float) => #f)
      (check (subtype-expression? 'Bool 'Number) => #f)
      (check (subtype-expression? 'Number '(Union Real Float Integer)) => #f)
      (check (subtype-expression? 'Real '(Union Float Integer)) => #f)
      (check (subtype-expression? '(Union Integer Float) 'Real) => #t)
      (check (subtype-expression? '(Map Float <- UInt) '(Map Real <- UInt)) => #t)
      (check (subtype-expression? '(Map Float <- Float) '(Map Real <- Real)) => #f)
      (check (subtype-expression? '(TypeValuePair Float) '(TypeValuePair Real Number)) => #f)
      (def carried (expression-type 'Float))
      (def tagged (validate (expression-type '(TypeValuePair Float Real Number)) (cons carried 1.0)))
      (check (eq? (car tagged) carried) => #t)
      (check-equal? (cdr tagged) 1.0)
      (check-exception (validate (expression-type '(TypeValuePair Float)) (cons carried 1)) TypeError?)
      (check (subtype-expression? '(Union Float Integer) '(Union Real Integer)) => #f)
      (check-exception (expression-type '(Exactly 1.0)) (refusal 'unsupported))
      (check-exception (subtype-expression? 'Float '(Union Real (Unknown))) (refusal 'unsupported))
      (check-exception (subtype-expression? 'Float 'Real 1) (refusal 'exhausted)))
    (test-case "numeric keyword and case coverage retain exact result counts and boundaries"
      (check (function-covers?
        '(CaseFunction (Function (Float) (Real)) (Function (Float Float) (Real Real)))
        '(CaseFunction (Function (Real) (Float)) (Function (Real Real) (Float Float)))) => #t)
      (check (function-covers? '(Function (Float) (Real) optional: (Real) keywords: ((scale: . Real)) rest: Real)
        '(Function (Real) (Float) optional: (Float) keywords: ((scale: . Float)) rest: Float)) => #t)
      (check (function-covers? '(Function (Float) (Real) keywords: ((scale: . Real)))
        '(Function (Real) (Float))) => #t)
      (check (subtype-expression? '(Function (Float) (Real)) '(Function (Real Real) (Float))) => #f)
      (def checked (validate (expression-type '(Function (Real) (Float))) (lambda (value) value)))
      (check-equal? (checked 1.5) 1.5)
      (check-exception (checked 1) TypeError?)
      (check-exception (checked scale:) TypeError?)
      (check-exception (checked #!key) TypeError?))
    (test-case "numeric batch inference publishes nested callbacks through refinement and evidence"
      (def events []) (def consumed 0) (def calibrated 0)
      (def report (numeric.infer-numeric-service (list 'Bool numeric.numeric-output)
        (lambda (event) (set! events (cons event events)))))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) (list (list numeric.numeric-output)))
      (check-equal? events [])
      (def context (.o approved: #t))
      (def readings (make-hash-table)) (hash-put! readings 1 1/2)
      (def batch (cons readings (lambda (value) (set! calibrated (1+ calibrated)) (+ value 1/2))))
      (def observed #f)
      (def action (service.descriptor-service-action (.get report instance) batch context
        (lambda (subject)
          (set! consumed (1+ consumed)) (set! observed subject)
          (def result (.get subject answer))
          (check (flonum? (hash-get (car result) 1)) => #t)
          (check-equal? ((cdr result) 1/2) 1.0)
          (check-exception ((cdr result) 1+2i) TypeError?)
          (def again ((.get subject callback) batch))
          (check (flonum? (hash-get (car again) 1)) => #t)
          (check-exception ((cdr ((.get subject callback) (cons readings (lambda (_) 'wrong)))) 1.0) TypeError?))))
      (defvalues (evidence next failure) (action context))
      (check-equal? failure #f) (check-equal? consumed 1)
      (check (eq? next context) => #t)
      (check (eq? (.get evidence subject) observed) => #t)
      (check-equal? (hash-get readings 1) 1/2)
      (check-equal? calibrated 1)
      (check-exception ((service.descriptor-service-action (.get report instance) batch context
        (lambda (_) (set! consumed 99)) #f) context) TypeError?)
      (check-equal? consumed 1)
      (defvalues (_ _next retried) (action context))
      (check-equal? retried #f) (check-equal? consumed 2)
      (check-equal? (.get (numeric.infer-numeric-service (list numeric.numeric-output
        '(Pair (Map Float <- UInt) (Function (Float) (Number))))) status) 'ambiguous)
      (check-equal? (.get (numeric.infer-numeric-service '(Bool)) status) 'no-solution))
    (test-case "all admitted scalar descriptors match independent host predicates"
      (def samples (list #f #t -1 2 "hello" 'hello hello: #!key #!rest))
      (for-each (lambda (name recognize)
        (def descriptor (expression-type name))
        (for-each (lambda (value) (check-equal? (element? descriptor value) (recognize value))) samples))
        '(Bool Integer UInt Keyword String Symbol)
        (list boolean? exact-integer? (lambda (value) (and (exact-integer? value) (>= value 0)))
              keyword? string? symbol?))
      (check-exception (expression-type 'Unknown) (refusal 'unsupported))
      (for-each (lambda (name)
        (check-exception (prototype-type (.o .parameters: (list name)) (list name) name []) (refusal 'malformed))
        (check-exception (expression-type (list 'Mu name 1 (list 'List name))) (refusal 'malformed)))
        '(String Symbol)))
    (test-case "immutable symbol literals preserve identity and cannot capture Type variables"
      (check (subtype-expression? '(Exactly run) 'Symbol) => #t)
      (check (subtype-expression? '(Enum run report) 'Symbol) => #t)
      (check (subtype-expression? '(Enum run report) '(Exactly run)) => #f)
      (check (subtype-expression? '(Exactly run) 'String) => #f)
      (check (subtype-expression? '(Exactly run:) 'Symbol) => #f)
      (check (subtype-expression? '(Enum #!key #!rest) 'Symbol) => #f)
      (def descriptor (expression-type '(Enum run report)))
      (check-equal? (validate descriptor 'run) 'run)
      (check-exception (validate descriptor 'other) TypeError?)
      (check-exception (expression-type '(Exactly "run")) (refusal 'unsupported))
      (check-exception (expression-type '(Enum "run" "report")) (refusal 'unsupported))
      (def schema (prototype-type (.o .parameters: '(T)) '(T) '(Pair T (Enum T String)) []))
      (check-equal? (.get (instantiate-prototype schema '(String)) expression) '(Pair String (Enum T String))))
    (test-case "symbol snapshots retain ordered literal metadata before lazy observation"
      (def syntax (list 'Enum 'run 'report)) (def descriptor (expression-type syntax))
      (set-car! (cdr syntax) 'other)
      (check-equal? (.get descriptor sexp) '(Enum run report))
      (check-equal? (validate descriptor 'run) 'run)
      (check-exception (validate descriptor 'other) TypeError?)
      (def private (string->uninterned-symbol "run"))
      (check (eq? (validate (expression-type (list 'Exactly private)) private) private) => #t)
      (check-exception (validate (expression-type (list 'Exactly private)) 'run) TypeError?))
    (test-case "scalar replacement never invents conversion or changes invariant parents"
      (check (subtype-expression? 'String 'Symbol) => #f)
      (check (subtype-expression? 'Symbol 'String) => #f)
      (check (subtype-expression? '(Function (String) (Symbol)) '(Function (String) ((Exactly run)))) => #t)
      (check (subtype-expression? '(Map String <- Symbol) '(Map String <- String)) => #f)
      (check (subtype-expression? '(Union String Symbol) '(Union Symbol String)) => #f)
      (check (subtype-expression? '(Record ((name String required) (tag Symbol required)) closed)
        '(Record ((tag Symbol required)) open)) => #t))
    (test-case "keyword transport admits ordinary text and symbols without hiding markers"
      (for-each (lambda (input)
        (check (function-covers? `(Function (String) (,input) keywords: ((mode: . UInt)))
          `(Function (String) (,input))) => #t)) '(String Symbol (Enum run report)))
      (check (function-covers? '(Function (String) (Keyword) keywords: ((mode: . UInt)))
        '(Function (String) (Keyword))) => #f)
      (def checked (validate (expression-type '(Function (String) (Symbol) keywords: ((mode: . UInt))))
        (lambda (label mode: (_mode 0)) (symbol->string label))))
      (check-equal? (checked 'run mode: 1) "run")
      (check-exception (checked run:) TypeError?)
      (check-exception (checked #!key) TypeError?))
    (test-case "finite recursion and nested wrappers retain exact scalar families"
      (def descriptor (expression-type '(Mu X 2 (OrFalse (Pair (Function (String) (Symbol)) X)))))
      (def checked (validate descriptor (cons symbol->string #f)))
      (check-equal? ((car checked) 'report) "report")
      (check-exception ((car checked) "report") TypeError?)
      (check-equal? (cdr checked) #f)
      (check-exception (validate descriptor (cons symbol->string (cons symbol->string #f))) TypeError?))
    (test-case "prefix inference publishes a complete wrapped text service through FUN"
      (def events [])
      (def report (service.infer-text-service '(Symbol) '(Bool Symbol String) calls
        (lambda (event) (set! events (cons event events)))))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) '((String)))
      (check-equal? events [])
      (def context (.o approved: #t)) (def consumed 0) (def callback #f)
      (defvalues (evidence next failure)
        ((service.text-service-action (.get report instance) 'run context
          (lambda (subject)
            (set! consumed (1+ consumed))
            (check-equal? (.get subject answer) "run")
            (set! callback (.get subject callback)))) context))
      (check-equal? failure #f) (check (eq? next context) => #t)
      (check (eq? (.get evidence context) context) => #t)
      (check-equal? (callback 'report) "report")
      (check-exception (callback "report") TypeError?)
      (check-equal? consumed 1)
      (check (and (member 'around events) #t) => #t)
      (check-exception ((service.text-service-action (.get report instance) (string->symbol "") context
        (lambda (_) (set! consumed 99))) context) TypeError?)
      (check-equal? consumed 1))
    (test-case "failure ambiguity and exhaustion refuse before building; retry remains fresh"
      (def partial (specialize-prototype-type service.TextServiceType '(Symbol)))
      (check-equal? (.get (infer-declared-calls partial '(Bool Symbol) calls forbidden) status) 'no-solution)
      (check-equal? (.get (infer-declared-calls partial '(String Symbol) [] forbidden) status) 'ambiguous)
      (check-exception (infer-declared-calls partial '(String Symbol) calls forbidden 20) (refusal 'exhausted))
      (check-equal? (.get (service.infer-text-service '(Symbol) '(Bool Symbol String) calls) status) 'unique))))
