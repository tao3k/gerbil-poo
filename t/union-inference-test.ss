;;; Ordered scalar/container Union coverage through the shared declaration protocol.
(export union-inference-test)
(import (only-in ../function-signature encode-arguments) :std/test :std/error ../object ../mop ../type ../types/relation ../prototype-types ../method-declaration
        (prefix-in ../examples/polymorphic-services service.))
;; The bounded control retains its descriptor alongside the unbounded cases.
(def interval '(IntegerRange min: 0 max: 10))
;; Deliberately unsorted nested alternatives jointly cover the source exactly.
(def alternatives '(Union (IntegerRange min: 7 max: 10)
                           (Union (Enum 5 6) (IntegerRange min: 0 max: 4))))
;; Ordinary and callback observations share the same fully bound parameters.
(def observations (list (list [] (list interval) (list interval `(Function (,interval) (,interval))))))
;; Typed refusals remain separate from a complete negative inclusion judgment.
(def (refusal kind) (lambda (cause) (and (type-refusal? cause) (eq? (type-refusal-kind cause) kind))))
;; No declaration builder is allowed to observe an incomplete/nonunique solution.
(def (forbidden _) (error "Union declaration built before complete inference"))
;; Coverage, ordered validation and whole publication are checked independently.
(def union-inference-test
  (test-suite "Joint scalar and container coverage in ordered Union"
    (test-case "callable alternatives share complete signature coverage inside containers"
      (def target '(CaseFunction (Function (UInt) (Integer))
                                (Function (UInt UInt) (Integer Integer))))
      (def narrow '(CaseFunction (Function ((UIntN 8)) (Integer))
                                (Function ((UIntN 8) (UIntN 8)) (Integer Integer))))
      (def shadow '(CaseFunction (Function (UInt) (Integer) optional: (Integer))
                                (Function (UInt UInt) (Integer Integer))))
      (def union `(Union ,narrow ,target))
      (for-each (lambda (layout)
        (check (subtype-expression? (layout union) (layout target)) => #t)
        (check (subtype-expression? (layout `(Union ,narrow ,shadow)) (layout target)) => #f))
        (list identity (cut list 'List <>) (lambda (t) `(Map (List ,t) <- UInt))
          (lambda (t) `(Pair ,t (Tuple ,t)))
          (lambda (t) `(Record ((run ,t required)) closed))))
      (def rich '(Function (UInt) (Integer) optional: (Integer)
                   keywords: ((scale: . UInt)) rest: Integer))
      (check (subtype-expression?
        `(Union (Function ((UIntN 8)) (Integer) optional: (Integer)
                   keywords: ((scale: . UInt)) rest: Integer) ,rich) rich) => #t)
      (check (subtype-expression? `(Union ,rich (Function (UInt) (Integer))) rich) => #f)
      (check (subtype-expression? '(Union (Function (Keyword) (Keyword)))
        '(Function (Keyword) (Keyword) keywords: ((scale: . UInt)))) => #f)
      (check (subtype-expression? `(Union ,narrow ,target) `(Union ,target ,narrow)) => #f)
      (check (subtype-expression? `(Map UInt <- ,union) `(Map UInt <- ,target)) => #f)
      (check (subtype-expression? `(Union (Maybe ,narrow) ,target) target) => #f)
      (check (subtype-expression? '(Union) target) => #t)
      (check-exception (validate (expression-type '(Union)) abs) TypeError?)
      (check-exception (subtype-expression? `(Union ,narrow (Unknown UInt)) target) (refusal 'unsupported))
      (check-exception (subtype-expression? union target 1) (refusal 'exhausted)))
    (test-case "finite Or keeps its kind and covers one ordinary readable target"
      (check (subtype-expression? '(Or (List UInt) (List Integer)) '(List Integer)) => #t)
      (check (subtype-expression? '(Or (Pair UInt Null) Null) '(List Integer)) => #t)
      (check (subtype-expression? '(Or (List UInt) Bool) '(List Integer)) => #f)
      (check (subtype-expression? '(Or UInt Integer) '(Or Integer UInt)) => #f)
      (check (subtype-expression? '(Or UInt Integer) '(Union UInt Integer)) => #f)
      (check (subtype-expression? '(Union UInt Integer) '(Or UInt Integer)) => #f)
      (check (subtype-expression? '(Map UInt <- (Or UInt Integer)) '(Map UInt <- Integer)) => #f)
      (check (subtype-expression? '(Or) '(List Integer)) => #t)
      (check-exception (validate (expression-type '(Or)) '()) TypeError?)
      (check (subtype-expression? '(Mu Node 2 (Or Null (Pair UInt Node))) '(List Integer)) => #t)
      (check (subtype-expression? '(Or (Function (Keyword) (Keyword)))
        '(Function (Keyword) (Keyword) keywords: ((scale: . UInt)))) => #f)
      (check-exception (subtype-expression? '(Or Never (Unknown)) 'Integer) (refusal 'unsupported))
      (check-exception (subtype-expression? '(Or UInt Integer) 'Integer 1) (refusal 'exhausted))
      (check-equal? (substitute-type '(Or (List Item) (Exactly Item)) '((Item . UInt)) (type-work 100))
        '(Or (List UInt) (Exactly Item))))
    (test-case "Or and Union callback directories retain their selected publication wrappers"
      (for-each (lambda (alternative)
        (def target '(CaseFunction (Function (UInt) (Integer))
                                  (Function (UInt UInt) (Integer Integer))))
        (def narrow '(CaseFunction (Function ((UIntN 8)) (Integer))
                                  (Function ((UIntN 8) (UIntN 8)) (Integer Integer))))
        (def shadow '(CaseFunction (Function (UInt) (Integer) optional: (Integer))
                                  (Function (UInt UInt) (Integer Integer))))
        (def selected `(Pair (Map (List (,alternative ,narrow ,target)) <- UInt)
                            (Tuple ,target)))
        (def wrong `(Pair (Map (List (,alternative ,narrow ,shadow)) <- UInt)
                         (Tuple ,target)))
        (def calls 0) (def effects []) (def consumed 0) (def observed #f)
        ;; Real arity dispatch remains Gerbil's case-lambda; the Type layer owns
        ;; per-case argument/result guards and never speculatively executes a body.
        (def callback (case-lambda
          ((x) (set! calls (1+ calls)) (abs x))
          ((x y) (set! calls (1+ calls)) (values (abs x) (abs y)))))
        (def report (service.infer-callback-directory-service (list wrong selected)
          (lambda (packet) (values packet identity))
          (lambda (event) (set! effects (cons event effects)))))
        (check-equal? (.get report status) 'unique)
        (check-equal? (.get report solutions) (list (list selected)))
        (check-equal? calls 0)
        (def raw (cons (list->hash-table (list (cons 7 (list callback)))) (vector callback)))
        (def context (.o approved: #t))
        (def action (service.descriptor-service-action (.get report instance) raw context
          (lambda (subject)
            (set! consumed (1+ consumed)) (set! observed subject)
            (def answer (.get subject answer))
            (def first (car (hash-ref (car answer) 7)))
            (def fallback (vector-ref (cdr answer) 0))
            (check-equal? (first -8) 8)
            (defvalues (left right) (fallback -9 -10))
            (check-equal? (list left right) '(9 10))
            ;; An explicit sequential scope samples after the successful calls;
            ;; internal definitions may initialize before test expressions in AOT.
            (let (before calls)
              (check-exception (first #f) TypeError?)
              (check-exception (fallback -1 #f) TypeError?)
              (check-equal? calls before)
              ;; Both alternatives recognize a procedure. The first narrow wrapper
              ;; must reject 300 after exactly one call, without trying the later one.
              (check-exception (first -300) TypeError?)
              (check-equal? calls (1+ before)))
            (def again ((.get subject callback) raw))
            (check-exception ((car (hash-ref (car again) 7)) -300) TypeError?))))
        (defvalues (evidence next failure) (action context))
        (check-equal? failure #f) (check-equal? consumed 1)
        (check (eq? next context) => #t)
        (check (eq? (.get evidence subject) observed) => #t)
        (check (eq? (car (hash-ref (car raw) 7)) callback) => #t)
        (check (eq? (vector-ref (cdr raw) 0) callback) => #t)
        (check-equal? (reverse effects) '(around before after))
        (check-exception
          ((service.descriptor-service-action (.get report instance) raw context
            (lambda (_) (set! consumed 99)) #f) context) TypeError?)
        (check-equal? consumed 1)
        (defvalues (_retried _same retry) (action context))
        (check-equal? retry #f) (check-equal? consumed 2)
        (check-exception (validate (expression-type selected)
          (cons (list->hash-table (list (cons 7 (list #f)))) (vector callback))) TypeError?)
        (check-equal? (.get (service.infer-callback-directory-service (list wrong)
          (lambda (packet) (values packet identity))) status) 'no-solution)
        (def reversed `(Pair (Map (List (,alternative ,target ,narrow)) <- UInt)
                            (Tuple ,target)))
        (check-equal? (.get (service.infer-callback-directory-service (list selected reversed)
          (lambda (packet) (values packet identity))) status) 'ambiguous)
        (def valid-reversed (validate (expression-type reversed) raw))
        (check-equal? ((car (hash-ref (car valid-reversed) 7)) -300) 300)) '(Or Union)))
    (test-case "one data target protocol covers optional dependent tagged and singleton alternatives"
      (for-each (lambda (source target) (check (subtype-expression? source target) => #t))
        '((Union Unit (Exactly #f) (List UInt))
          (Union (Exactly #f) (List UInt) (OrFalse (List UInt)))
          (Union (TypeValuePair UInt) (TypeValuePair Bool) (TypeValuePair))
          (Union (Sum run: UInt stop: (Exactly #f)) (Sum run: (Enum 0) stop: Bool))
          (Union (Maybe Never)) (Union (OrFalse Never))
          (Union (Tuple (Enum))) (Union (List Never)))
        '((Maybe (OrFalse (List Integer))) (OrFalse (List Integer))
          (TypeValuePair Bool UInt) (Sum run: Integer stop: Bool)
          Unit Bool Integer Null))
      (for-each (lambda (source target) (check (subtype-expression? source target) => #f))
        '((Union Unit (List UInt)) (Union (Exactly #f) (List UInt))
          (Union (TypeValuePair UInt) (TypeValuePair Bool))
          (Union (Sum run: UInt stop: Bool) (Sum stop: Bool run: UInt))
          (Union (Maybe UInt)) (Union (Tuple UInt))
          (Union (Function (Bool) (Integer)))
          (Union (OrFalse Never)))
        '((OrFalse (List Integer)) (Maybe (List Integer))
          (TypeValuePair Integer) (Sum run: Integer stop: Bool)
          Unit Integer (Function (UInt) (Integer)) UInt))
      (check (subtype-expression? '(Union Unit (List UInt)) '(Union (List UInt) Unit)) => #f)
      (check (subtype-expression? '(Map UInt <- (Union Unit (Enum 0))) '(Map UInt <- Unit)) => #f)
      (check-exception (subtype-expression? '(Union Unit (TypeValuePair Unknown)) '(Maybe UInt)) (refusal 'unsupported))
      (check-exception (subtype-expression? '(Union Unit) '(Maybe UInt) 1) (refusal 'exhausted)))
    (test-case "availability alternatives preserve sentinels dependent callbacks and tagged publication"
      (def narrow (expression-type '(Function ((UIntN 8)) (Integer))))
      (def broad (expression-type '(Function (UInt) (Integer))))
      (def provider (.o Alpha: narrow Beta: broad))
      (def directory (capture-type-catalog provider '(Alpha Beta)))
      (def alpha (agetq 'Alpha directory)) (def beta (agetq 'Beta directory))
      (def handler '(Function (UInt) (Integer)))
      (def idle `(Union (Exactly #f) (List ,handler)))
      (def first `(Sum ready: (Union Unit (Exactly #f) (TypeValuePair ,alpha)) idle: ,idle))
      (def second `(Sum ready: (TypeValuePair ,beta) idle: (List ,handler)))
      (def selected `(Pair ,handler (Union ,first ,second)))
      (def wrong `(Pair ,handler (Union ,first (Sum idle: (List ,handler) ready: (TypeValuePair ,beta)))))
      (def events []) (def consumed 0) (def observed #f)
      (def report (service.infer-availability-service (list alpha beta) (list wrong selected)
        (lambda (packet) (values packet identity))
        (lambda (event) (set! events (cons event events)))))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) (list (list selected)))
      (def context (.o approved: #t))
      ;; Validate both sentinels, both carried Types and an idle callback batch
      ;; through the same inferred generic and fresh evidence for each packet.
      (for-each (lambda (state)
        (def raw (cons abs state))
        (def action (service.descriptor-service-action (.get report instance) raw context
          (lambda (subject)
            (set! observed subject) (set! consumed (1+ consumed))
            (def answer (.get subject answer))
            (check-equal? ((car answer) -7) 7)
            (check-exception ((car answer) #f) TypeError?)
            (def value (.get (cdr answer) value))
            (cond ((pair? value)
              (if (eq? (.get (cdr answer) tag) 'ready)
                (begin
                  (check (or (eq? (car value) narrow) (eq? (car value) broad)) => #t)
                  (check-exception ((cdr value) #f) TypeError?)
                  (if (eq? (car value) narrow)
                    (check-exception ((cdr value) -300) TypeError?)
                    (check-equal? ((cdr value) -300) 300)))
                (check-exception ((car value) #f) TypeError?)))
              (else (check (or (eq? value #f) (eq? value (void))) => #t)))
            (def again ((.get subject callback) raw))
            (check-exception ((car again) #f) TypeError?))))
        (defvalues (evidence returned issue) (action context))
        (check-equal? issue #f) (check (eq? returned context) => #t)
        (check (eq? (.get evidence subject) observed) => #t)
        (check (eq? (car raw) abs) => #t))
        (list (.o tag: 'ready value: (void)) (.o tag: 'ready value: #f)
          (.o tag: 'ready value: (cons narrow abs)) (.o tag: 'ready value: (cons broad abs))
          (.o tag: 'idle value: #f) (.o tag: 'idle value: (list abs))))
      (check-equal? consumed 6)
      (check-equal? (reverse events) '(around before after around before after around before after
        around before after around before after around before after))
      (def raw (cons abs (.o tag: 'ready value: (cons narrow abs))))
      (check-exception ((service.descriptor-service-action (.get report instance) raw context void #f) context) TypeError?)
      (def action (service.descriptor-service-action (.get report instance) raw context
        (lambda (_) (set! consumed (1+ consumed)))))
      (defvalues (_ _context retried) (action context))
      (check-equal? retried #f) (check-equal? consumed 7)
      (check-exception ((service.descriptor-service-action (.get report instance)
        (cons abs (.o tag: 'unknown value: (cons broad abs))) context void) context) TypeError?)
      (check-equal? (.get (service.infer-availability-service (list alpha beta) (list wrong) forbidden) status) 'no-solution)
      (check-equal? (.get (service.infer-availability-service (list alpha beta)
        (list selected `(Pair ,handler (Union ,second ,first))) forbidden) status) 'ambiguous)
      (.set! provider Alpha Bool)
      (check-exception (action context) Error?)
      (check-equal? consumed 7))
    (test-case "source alternatives cover one ordinary readable container"
      (for-each (lambda (source target)
        (check (subtype-expression? source target) => #t)
        ;; ObjectContract's public sexp is a nominal display, not captured syntax.
        (check-equal? (canonical-type source (type-work 8192)) source))
        '((Union (List UInt) (Union (List (IntegerRange min: -2 max: -1)) (List (Enum -3))))
          (Union (Tuple UInt Bool) (Tuple (Enum -1 0) (Exactly #f)))
          (Union (Pair UInt Null) (Pair (Enum -1) (List UInt)))
          (Union (Pair UInt Null) (Pair (Enum -1) (List Never)))
          (Union (Map UInt <- UInt) (Map (Enum -1) <- UInt))
          (Union (Map Bool <- (Enum)) (Map UInt <- UInt))
          (Union (Record ((x UInt required)) closed) (Object ((x Integer)) open))
          (Union (Object ((x UInt)) closed) (Record ((x Integer required)) closed))
          (Union))
        '((List Integer) (Tuple Integer Bool) (List Integer) (Pair Integer Null) (Map Integer <- UInt)
          (Map Integer <- UInt) (Object ((x Integer)) open) (Record ((x Integer required)) closed)
          (List (Function (UInt) (UInt)))))
      (for-each (lambda (source target) (check (subtype-expression? source target) => #f))
        '((Union (List UInt) (Tuple UInt)) (Union (Pair UInt Null) (Pair UInt UInt))
          (Union (Map UInt <- UInt) (Map UInt <- Integer))
          (Union (Object ((x UInt)) open) (Record ((x String required)) closed))
          (Union (List (Function (Bool) (Bool))))
          (Union (List UInt) (List Integer)))
        '((List Integer) (List Integer) (Map Integer <- UInt) (Object ((x Integer)) open)
          (List (Function (UInt) (Integer))) (Union (List Integer) (List UInt))))
      (check-exception (subtype-expression? '(Union (List UInt) (List Unknown)) '(List Integer)) (refusal 'unsupported))
      (check-exception (subtype-expression? '(Union (List UInt)) '(List Integer) 1) (refusal 'exhausted)))
    (test-case "container Union preserves committed wrapper failure and original carrier"
      (def narrow '(Record ((run (Function ((UIntN 8)) (Integer)) required)) closed))
      (def broad '(Object ((run (Function (UInt) (Integer)))) open))
      (def source `(Union ,narrow ,broad))
      (check (subtype-expression? source broad) => #t)
      (def raw (.o run: abs))
      (def checked (validate (expression-type source) raw))
      (check-equal? ((.get checked run) -7) 7)
      ;; The first selected layout's UInt8 wrapper still rejects 300; a later
      ;; compatible layout could accept it but cannot replace the committed one.
      (check-exception ((.get checked run) -300) TypeError?)
      (check-equal? ((.get (validate (expression-type broad) raw) run) -300) 300)
      (check-equal? ((.get raw run) -300) 300)
      (check-exception (validate (expression-type '(Union (List UInt) (Tuple UInt))) (cons 1 2)) TypeError?)
      (check-exception (validate (expression-type '(Union)) []) TypeError?))
    (test-case "shared worker alternatives infer publish and retry through existing declarations"
      (def handler '(Function (UInt) (Integer)))
      (def narrow '(Function ((UIntN 8)) (Integer)))
      (def jobs `(Map (List ,handler) <- UInt))
      (def primary `(Record ((run ,narrow required) (limit UInt required) (jobs ,jobs required)) closed))
      (def fallback `(Object ((run ,handler) (limit Integer) (jobs ,jobs)) open))
      (def selected `(Union ,primary ,fallback))
      (def wrong `(Union ,primary (Object ((run ,handler) (limit String) (jobs ,jobs)) open)))
      (def events []) (def consumed 0) (def observed #f)
      (def report (service.infer-worker-service (list wrong selected)
        (lambda (worker) (values worker identity))
        (lambda (event) (set! events (cons event events)))))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) (list (list selected)))
      (def raw (.o run: abs limit: 5 jobs: (hash (1 (list abs)))))
      (def context (.o approved: #t))
      (def action (service.descriptor-service-action (.get report instance) raw context
        (lambda (subject)
          (set! observed subject) (set! consumed (1+ consumed))
          (def answer (.get subject answer))
          (check-equal? ((.get answer run) -8) 8)
          (check-exception ((.get answer run) -300) TypeError?)
          (check-exception ((car (hash-ref (.get answer jobs) 1)) #f) TypeError?)
          (def again ((.get subject callback) raw))
          (check-exception ((.get again run) -300) TypeError?))))
      (defvalues (evidence returned issue) (action context))
      (check-equal? issue #f) (check (eq? returned context) => #t)
      (check (eq? (.get evidence subject) observed) => #t)
      (check (eq? (.get raw run) abs) => #t)
      (check-equal? (reverse events) '(around before after))
      (check-exception ((service.descriptor-service-action (.get report instance) raw context void #f) context) TypeError?)
      (check-equal? consumed 1)
      (defvalues (_ _context retried) (action context))
      (check-equal? retried #f) (check-equal? consumed 2)
      (check-equal? (.get (service.infer-worker-service (list wrong) forbidden) status) 'no-solution)
      (check-equal? (.get (service.infer-worker-service
        (list selected `(Union ,fallback ,primary)) forbidden) status) 'ambiguous))
    (test-case "flat source Union requires every original branch in one ordinary target"
      (for-each (lambda (source target values)
        (check (subtype-expression? source target) => #t)
        (check-equal? (.get (expression-type source) sexp) source)
        (for-each (lambda (value)
          (check (eq? (validate (expression-type source) value) value) => #t)
          (check (eq? (validate (expression-type target) value) value) => #t)) values))
        '((Union UInt (Union (Enum -2 -1) (IntegerRange max: -3)))
          (Union (Exactly #f) (Enum #t #f)) (Union) (Union (Union))
          (Union (Enum ready: report:) Keyword) (Union (BytesN 0) Bytes32))
        '(Integer Bool UInt String Keyword Bytes)
        (list '(-100 -2 -1 0 9) '(#f #t) [] [] '(ready: report:)
          (list (u8vector) (make-u8vector 32 0))))
      (check-exception (validate (expression-type '(Union)) 0) TypeError?)
      (check-exception (validate (expression-type '(Union (Union))) #f) TypeError?)
      (check (subtype-expression? '(Union UInt (Exactly -1)) 'UInt) => #f)
      (check (subtype-expression? '(Union Bool (Exactly 1)) 'Bool) => #f)
      (check (subtype-expression? '(Union Keyword (Enum #!key)) 'Keyword) => #f)
      (check (subtype-expression? '(Union Unit (Enum #f)) 'Unit) => #f)
      (check-exception (subtype-expression? '(Union UInt (Enum -1)) 'Integer 1) (refusal 'exhausted)))
    (test-case "Union source admission retains wrappers keys ordering and wire origins"
      (check (subtype-expression? '(Union UInt (Enum -1)) '(Union Integer)) => #f)
      (check (subtype-expression? '(Map UInt <- (Union UInt (Enum 0))) '(Map UInt <- UInt)) => #f)
      (check (subtype-expression? '(Union UInt (Function (UInt) (UInt))) 'Integer) => #f)
      (check (subtype-expression? '(Union (Maybe Never)) 'Unit) => #t)
      (check (subtype-expression? '(Union (Maybe UInt)) 'Unit) => #f)
      (check (subtype-expression? '(Union (Tuple (Enum))) 'Integer) => #t)
      (check (subtype-expression? '(Union (Tuple UInt)) 'Integer) => #f)
      (check-exception (subtype-expression? '(Union UInt Unknown) 'Integer) (refusal 'unsupported))
      (check (function-covers?
        '(Function (UInt) ((Union Keyword (Enum ready:))) keywords: ((mode: . UInt)))
        '(Function (UInt) (Keyword))) => #f))
    (test-case "measurement publication infers flat alternatives inside wrapped Map Pair fields"
      (def handler '(Function (UInt) (Integer)))
      (def numeric '(Union (IntegerRange max: -1) (Union (Exactly 0) UInt)))
      (def flags '(Union (Exactly #t) (Enum #f #t)))
      (def selected `(Pair ,handler (Map (Pair ,numeric ,flags) <- UInt)))
      (def wrong `(Pair ,handler (Map (Pair (Union UInt Keyword) ,flags) <- UInt)))
      (def events []) (def consumed 0) (def observed #f)
      (def report (service.infer-measurement-service (list wrong selected)
        (lambda (packet) (values packet identity))
        (lambda (event) (set! events (cons event events)))))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) (list (list selected)))
      (def source (cons abs (hash (1 (cons -1 #f)) (2 (cons 0 #t)))))
      (def context (.o approved: #t))
      (def action (service.descriptor-service-action (.get report instance) source context
        (lambda (subject)
          (set! observed subject) (set! consumed (1+ consumed))
          (def answer (.get subject answer))
          (check-equal? ((car answer) -8) 8)
          (check-exception ((car answer) #f) TypeError?)
          (check (eq? (cdr answer) (cdr source)) => #t)
          (check-equal? (hash-ref (cdr answer) 1) (cons -1 #f))
          (def next ((.get subject callback) (cons abs (hash (3 (cons -20 #t))))))
          (check-equal? ((car next) -4) 4)
          (check-exception ((.get subject callback) (cons abs (hash (3 (cons 2 ready:))))) TypeError?))))
      (defvalues (evidence returned issue) (action context))
      (check-equal? issue #f) (check (eq? returned context) => #t)
      (check (eq? (.get evidence subject) observed) => #t)
      (check (eq? (car source) abs) => #t)
      (check-equal? (reverse events) '(around before after))
      (check-exception ((service.descriptor-service-action (.get report instance) source context void #f) context) TypeError?)
      (check-equal? consumed 1)
      (defvalues (_ _context retry) (action context))
      (check-equal? retry #f) (check-equal? consumed 2)
      (check-equal? (.get (service.infer-measurement-service (list wrong) forbidden) status) 'no-solution)
      (check-equal? (.get (service.infer-measurement-service
        (list selected `(Pair ,handler (Map (Pair Integer Bool) <- UInt))) forbidden) status) 'ambiguous))
    (test-case "several branches cover a range without one covering it alone"
      (check (subtype-expression? interval alternatives) => #t)
      (check (subtype-expression? interval '(Union (IntegerRange min: 0 max: 4) (Enum 5 5 7) (IntegerRange min: 8 max: 10))) => #f)
      (check (subtype-expression? interval '(Union (IntegerRange min: 5 max: 1) (Enum 5) (IntegerRange min: 0 max: 4) (IntegerRange min: 6 max: 10))) => #t)
      (check (subtype-expression? '(IntegerRange min: 2 max: 1) '(Union)) => #t)
      (check (subtype-expression? interval '(Union)) => #f)
      (check (subtype-expression? '(IntegerRange min: 0) '(Union Integer)) => #t)
      (def huge (expt 2 2048))
      (check (subtype-expression? (list 'IntegerRange min: (- huge) max: huge)
        '(Union (IntegerRange min: 1) (Enum 0) (IntegerRange max: -1)) 2000) => #t))
    (test-case "unbounded tails require complete bridges and both infinite ends"
      (def all-integers '(IntegerRange))
      (def tails '(Union (IntegerRange min: 1) (Union (Enum 0) (IntegerRange max: -1))))
      (check (subtype-expression? all-integers tails) => #t)
      (check (subtype-expression? '(IntegerRange min: #f max: #f) tails) => #t)
      (check (subtype-expression? 'Integer tails) => #t)
      (check (subtype-expression? '(Map UInt <- (IntegerRange)) `(Map UInt <- ,tails)) => #f)
      (check (subtype-expression? all-integers '(Union (IntegerRange max: -1) (IntegerRange min: 1))) => #f)
      (check (subtype-expression? all-integers '(Union (IntegerRange min: 0) (Enum -1 -2))) => #f)
      (check (subtype-expression? all-integers '(Union (IntegerRange max: 0) (Enum 1 2))) => #f)
      (check (subtype-expression? '(IntegerRange min: -2)
        '(Union (Enum -2 -1) (IntegerRange min: 0))) => #t)
      (check (subtype-expression? '(IntegerRange max: 2)
        '(Union (IntegerRange max: 0) (Enum 2 1))) => #t)
      (check (subtype-expression? all-integers '(Union (IntegerRange min: -10 max: 10))) => #f)
      (check (subtype-expression? all-integers '(Union)) => #f)
      (check (subtype-expression? all-integers `(Union ,tails (Function (UInt) (UInt)))) => #f)
      (def huge (expt 2 2048))
      (check (subtype-expression? all-integers
        `(Union (IntegerRange min: ,(1+ huge)) (Exactly ,huge) (IntegerRange max: ,(1- huge))) 2000) => #t)
      (check (subtype-expression? all-integers
        `(Union (IntegerRange min: ,(1+ huge)) (IntegerRange max: ,(1- huge))) 2000) => #f)
      (def descriptor (expression-type tails))
      (check-equal? (.get descriptor sexp) tails)
      (for-each (lambda (value) (check (eq? (validate descriptor value) value) => #t))
        (list (- huge) -1 0 1 huge))
      (for-each (lambda (value) (check-exception (validate descriptor value) TypeError?))
        '(#!key #!rest scale: #f 1.5)))
    (test-case "Integer and UInt share interval coverage without collapsing kinds"
      (def unsigned '(Union (IntegerRange min: 1) (Enum 0)))
      (def signed `(Union (IntegerRange max: -1) ,unsigned))
      (check (subtype-expression? 'Integer signed) => #t)
      (check (subtype-expression? 'UInt unsigned) => #t)
      (check (subtype-expression? 'UInt signed) => #t)
      (check (subtype-expression? 'Integer unsigned) => #f)
      (check (subtype-expression? 'UInt '(Union (IntegerRange min: 1))) => #f)
      (check (subtype-expression? 'Integer '(Union (IntegerRange max: -1) (IntegerRange min: 1))) => #f)
      (check (subtype-expression? 'Integer '(Union (Enum -1 0 1))) => #f)
      (check (subtype-expression? 'UInt '(Union)) => #f)
      (check (subtype-expression? 'Any signed) => #f)
      (check (subtype-expression? 'Integer `(Union ,signed (Function (UInt) (UInt)))) => #f)
      (check (subtype-expression? 'UInt `(Union ,unsigned (List UInt))) => #f)
      (check-equal? (normalize-type 'Integer (type-work 2000)) 'Integer)
      (check-equal? (normalize-type 'UInt (type-work 2000)) 'UInt)
      (check (subtype-expression? `(Map UInt <- Integer) `(Map UInt <- ,signed)) => #f)
      (check (subtype-expression? `(Map UInt <- UInt) `(Map UInt <- ,unsigned)) => #f)
      (check (subtype-expression? `(Pair Integer (Map UInt <- UInt))
        `(Pair ,signed (Map ,unsigned <- UInt))) => #t)
      (def huge (expt 2 2048))
      (for-each (lambda (source)
        (check (subtype-expression? source `(Union (IntegerRange max: ,(1- huge))
          (Exactly ,huge) (IntegerRange min: ,(1+ huge))) 2000) => #t)
        (check (subtype-expression? source `(Union (IntegerRange max: ,(1- huge))
          (IntegerRange min: ,(1+ huge))) 2000) => #f)) '(Integer UInt))
      (check (subtype-expression? 'Integer '(Union Keyword (Enum #!key #!rest))) => #f)
      (check (subtype-expression? '(Enum scale: #!key #!rest) `(Union Keyword ,signed)) => #f)
      (check (subtype-expression? '(Union UInt) '(Union Integer)) => #f)
      (check (subtype-expression? signed `(Union ,unsigned (IntegerRange max: -1))) => #f))
    (test-case "independent endpoint partition oracle covers unbounded inputs"
      ;; Target endpoints lie in [-2,2]; witnesses include every singleton,
      ;; intervening cell, both infinite tails and the bounded source endpoint.
      (def sources (append '(Integer UInt (IntegerRange) (IntegerRange min: -2) (IntegerRange min: 0)
                            (IntegerRange max: 2) (IntegerRange max: 0))
                          (list interval)))
      (def branches '((IntegerRange max: -2) (IntegerRange max: 0)
                      (IntegerRange min: 0) (IntegerRange min: 2) (Enum -1 0 1)
                      (IntegerRange min: 2 max: -2) (Enum)))
      (for-each (lambda (source)
        (for-each (lambda (left)
          (for-each (lambda (right)
            (def target (list 'Union left right))
            (check-equal? (subtype-expression? source target)
              (andmap (lambda (value)
                (or (not (element? (expression-type source) value))
                    (element? (expression-type target) value)))
                '(-3 -2 -1 0 1 2 3 4 10 11)))) branches)) branches)) sources))
    (test-case "finite literal sources retain exact mixed scalar membership"
      (check (subtype-expression? '(Enum 0 1 2 #f ready other)
        '(Union (Enum #f ready) (IntegerRange min: 0 max: 1) (Exactly 2) Symbol)) => #t)
      (check (subtype-expression? '(Enum 0 1 2 #f absent)
        '(Union (Enum #f ready) (IntegerRange min: 0 max: 2))) => #f)
      (check (subtype-expression? '(Exactly 5) alternatives) => #t)
      (check (subtype-expression? '(Enum #!key #!rest scale:) '(Union Keyword (Enum #!key #!rest))) => #f)
      (check-exception (subtype-expression? '(Enum) '(Union (Enum 1.0))) (refusal 'unsupported)))
    (test-case "independent descriptor witnesses detect holes overlap and empty branches"
      (for-each (lambda (source)
        (for-each (lambda (target)
          (check-equal? (subtype-expression? source target)
            (andmap (lambda (value)
              (or (not (element? (expression-type source) value))
                  (element? (expression-type target) value))) '(-3 -2 -1 0 1 2 3))))
          '((Union) (Union (IntegerRange min: -2 max: 0) (Enum 1 2))
            (Union (Enum 2 -2) (IntegerRange min: -1 max: 1))
            (Union (Enum -2 0 2) (Enum -1)) (Union (Enum 0 0) (IntegerRange min: 2 max: 1))
            (Union Bool (Union (Enum -2 -1) (IntegerRange min: 0 max: 2))))))
        '((IntegerRange min: -2 max: 2) (IntegerRange min: -1 max: 1)
          (IntegerRange min: 0 max: 0) (IntegerRange min: 1 max: -1))))
    (test-case "descriptor order and committed failure remain unchanged"
      (check-equal? (normalize-type alternatives (type-work 2000)) alternatives)
      (def descriptor (expression-type alternatives))
      (check-equal? (.get descriptor sexp) alternatives)
      (for-each (lambda (value) (check (eq? (validate descriptor value) value) => #t)) '(0 4 5 6 7 10))
      (check-exception (validate descriptor 11) TypeError?)
      (check (subtype-expression? alternatives alternatives) => #t)
      (check (subtype-expression? alternatives '(Union (Union (Enum 5 6) (IntegerRange min: 0 max: 4)) (IntegerRange min: 7 max: 10))) => #f)
      (check (subtype-expression? interval `(Union ,interval (Function (UInt) (UInt)))) => #f)
      (check (subtype-expression? '(Enum) `(Union ,interval (Function (UInt) (UInt)))) => #f)
      (def cause (list 'selected-error)) (def fallback-calls 0)
      (def selected (.cc Type. .element?: exact-integer? .validate: (lambda (_) (raise cause))))
      (def fallback (.cc (expression-type interval) .validate: (lambda (value) (set! fallback-calls (1+ fallback-calls)) value)))
      (check-exception (validate (Union selected fallback) 5) (lambda (caught) (eq? caught cause)))
      (check-equal? fallback-calls 0))
    (test-case "container values and callback variance share coverage but keys do not"
      (check (subtype-expression? `(Pair ,interval (Function (,interval) (,alternatives)))
        `(Pair ,alternatives (Function (,alternatives) (,interval)))) => #t)
      (check (subtype-expression? `(Map ,interval <- UInt) `(Map ,alternatives <- UInt)) => #t)
      (check (subtype-expression? `(Map UInt <- ,interval) `(Map UInt <- ,alternatives)) => #f)
      (def callback (validate (expression-type `(Function (,alternatives) (,interval))) identity))
      (check-equal? (callback 6) 6) (check-exception (callback 11) TypeError?)
      (check-exception ((validate (expression-type `(Function (,alternatives) (,interval))) (lambda (_) 11)) 6) TypeError?))
    (test-case "prefix inference publishes through original qualifiers and evidence"
      (def report (service.infer-range-service (list interval) (list 'Integer 'UInt interval) observations
        schema: service.UnionServiceType))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) (list (list interval)))
      (def instance (.get report instance)) (def context (.o approved: #t)) (def consumed 0)
      (defvalues (answer callback owner) (service.invoke-signature-service (.get instance prototype) 4 1 scale: 2))
      (check-equal? answer 10) (check-equal? (callback 10) 10)
      (check-exception (callback 11) TypeError?) (check (begin (declared-snapshot owner) #t) => #t)
      (defvalues (evidence next failure)
        ((service.catalog-service-action instance 4 context (lambda (_) (set! consumed (1+ consumed))) 5) context))
      (check-equal? failure #f) (check-equal? consumed 1)
      (check (eq? next context) => #t) (check (eq? (.get evidence context) context) => #t)
      (check-exception ((service.catalog-service-action instance 8 context (lambda (_) (set! consumed 99)) 5) context) TypeError?)
      (check-equal? consumed 1))
    (test-case "unbounded inference reuses full declaration refinement and evidence"
      (def all-integers '(IntegerRange))
      (def calls (list (list [] (list all-integers)
        (list interval `(Function (,interval) (,all-integers))))))
      (def report (service.infer-range-service (list interval)
        (list 'UInt '(IntegerRange min: 0) all-integers) calls schema: service.UnboundedUnionServiceType))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) (list (list all-integers)))
      (def instance (.get report instance)) (def context (.o approved: #t)) (def consumed 0)
      (defvalues (answer callback owner)
        (service.invoke-signature-service (.get instance prototype) -4 1 scale: 2))
      (check-equal? answer 0) (check-equal? (callback -100) 0)
      (check-equal? (callback 100) 10)
      (check-exception (callback scale:) TypeError?)
      (check (begin (declared-snapshot owner) #t) => #t)
      (defvalues (evidence next failure)
        ((service.catalog-service-action instance -4 context (lambda (_) (set! consumed (1+ consumed))) 5) context))
      (check-equal? failure #f) (check-equal? consumed 1)
      (check (eq? (.get evidence context) context) => #t) (check (eq? next context) => #t)
      (check-exception ((service.catalog-service-action instance 8 context (lambda (_) (set! consumed 99)) 5) context) TypeError?)
      (check-equal? consumed 1)
      (def partial (specialize-prototype-type service.UnboundedUnionServiceType (list interval)))
      (check-equal? (.get (infer-declared-calls partial '(UInt) calls forbidden) status) 'no-solution)
      (check-equal? (.get (infer-declared-calls partial (list all-integers '(Union (IntegerRange min: 1) (Union (Enum 0) (IntegerRange max: -1)))) calls forbidden) status) 'ambiguous)
      (check-exception (infer-declared-calls partial (list all-integers) calls forbidden 20) (refusal 'exhausted))
      (check-exception (subtype-expression? all-integers
        (cons 'Union (make-list 100 '(Enum 0))) 50) (refusal 'exhausted))
      (check-equal? (.get (service.infer-range-service (list interval) (list all-integers) calls
        schema: service.UnboundedUnionServiceType) status) 'unique))
    (test-case "atomic candidates preserve rich signatures wrappers and publication"
      (for-each (lambda (schema source input)
        (def calls (list (list [] (list source) (list interval `(Function (,interval) (,source))))))
        (def report (service.infer-range-service (list interval) '(UInt Integer) calls schema: schema))
        (check-equal? (.get report status) 'unique)
        (check-equal? (.get report solutions) (list (list source)))
        (def instance (.get report instance))
        (check-equal? (.get (car (.get instance descriptor inputs)) sexp) source)
        (check-equal? (.get instance descriptor sexp)
          (.get (expression-type
            `(Function (,interval (Function (,interval) (,source))) (,source)
              optional: (,source) keywords: ((scale: . UInt)) required-keywords: () rest: ,source)) sexp))
        (defvalues (answer callback owner)
          (service.invoke-signature-service (.get instance prototype) input 1 scale: 2 3))
        (check-equal? answer (if (eq? source 'Integer) 0 10))
        (check-equal? (callback (expt 2 2048)) 10)
        (if (eq? source 'Integer) (check-equal? (callback -1) 0)
          (check-exception (callback -1) TypeError?))
        (for-each (lambda (token) (check-exception (callback token) TypeError?))
          '(scale: #!key #!rest))
        (check (begin (declared-snapshot owner) #t) => #t)
        (def context (.o approved: #t)) (def consumed 0)
        (defvalues (evidence next failure)
          ((service.catalog-service-action instance 4 context (lambda (_) (set! consumed (1+ consumed))) 5) context))
        (check-equal? failure #f) (check-equal? consumed 1)
        (check (eq? next context) => #t) (check (eq? (.get evidence context) context) => #t)
        (check-exception ((service.catalog-service-action instance 8 context (lambda (_) (set! consumed 99)) 5) context) TypeError?)
        (check-equal? consumed 1)
        (def partial (specialize-prototype-type schema (list interval)))
        (check-equal? (.get (infer-declared-calls partial (list source
          (if (eq? source 'Integer) '(IntegerRange) '(IntegerRange min: 0))) calls forbidden) status) 'ambiguous)
        (check-equal? (.get (infer-declared-calls partial '(Bool) calls forbidden) status) 'no-solution)
        (check-exception (infer-declared-calls partial (list source) calls forbidden 20) (refusal 'exhausted))
        (check-equal? (.get (service.infer-range-service (list interval) (list source) calls schema: schema) status) 'unique))
        (list service.UnboundedUnionServiceType service.UnsignedUnionServiceType)
        '(Integer UInt) '(-4 4)))
    (test-case "Bool coverage exhausts true and false using existing literal membership"
      (def complete '(Union (Exactly #t) (Union (Enum #f) (Exactly #t))))
      (for-each (lambda (target)
        (check-equal? (subtype-expression? 'Bool target)
          (andmap (lambda (value) (element? (expression-type target) value)) '(#f #t))))
        (list complete '(Union) '(Union (Exactly #t)) '(Union (Enum #f #f))
          '(Union Integer UInt) '(Union Keyword (Enum #!key #!rest))
          '(Union (Enum #f ready) (Enum #t 0)) '(Union Bool (Enum))))
      (check (subtype-expression? 'Bool '(Enum #f #t #f)) => #t)
      (check (subtype-expression? 'Bool '(Exactly #f)) => #f)
      (check-exception (subtype-expression? 'Bool '(Union Bool (Enum 1.0))) (refusal 'unsupported))
      (check (subtype-expression? '(Enum #f #t) complete) => #t)
      (check-equal? (normalize-type 'Bool (type-work 2000)) 'Bool)
      (check-equal? (.get (expression-type complete) sexp) complete)
      (for-each (lambda (value) (check (eq? (validate (expression-type complete) value) value) => #t)) '(#f #t))
      (for-each (lambda (value) (check-exception (validate (expression-type complete) value) TypeError?))
        '(0 1 ready scale: #!key #!rest))
      (check (subtype-expression? 'Bool `(Union ,complete (Function (Bool) (Bool)))) => #f)
      (check (subtype-expression? 'Bool `(Union ,complete (List Bool))) => #f)
      (check (subtype-expression? 'Any complete) => #f)
      (check (subtype-expression? '(Enum scale: #!key #!rest) `(Union Keyword ,complete)) => #f)
      (check (subtype-expression? '(Union (Enum #f) (Exactly #t)) '(Union (Exactly #t) (Enum #f))) => #f)
      (check (subtype-expression? '(Map UInt <- Bool) `(Map UInt <- ,complete)) => #f)
      (check (subtype-expression? '(Pair Bool (Map Bool <- UInt)) `(Pair ,complete (Map ,complete <- UInt))) => #t)
      (check (subtype-expression? `(Function (Bool) (,complete)) `(Function (,complete) (Bool))) => #t)
      (def error-token (list 'selected-false)) (def later 0)
      (def selected (.cc Type. .element?: (cut eq? <> #f) .validate: (lambda (_) (raise error-token))))
      (def fallback (.cc Type. .element?: boolean? .validate: (lambda (value) (set! later (1+ later)) value)))
      (check-exception (validate (Union selected fallback) #f) (lambda (cause) (eq? cause error-token)))
      (check-equal? later 0))
    (test-case "Boolean inference preserves false callbacks full signatures and evidence"
      (def calls '((() (Bool) (Bool (Function (Bool) (Bool))))))
      (def report (service.infer-boolean-service '(Bool) '(Integer UInt Bool) calls))
      (check-equal? (.get report status) 'unique)
      (check-equal? (.get report solutions) '((Bool)))
      (def instance (.get report instance))
      (check-equal? (.get (car (.get instance descriptor inputs)) sexp) 'Bool)
      (for-each (lambda (value)
        (defvalues (answer callback owner) (service.invoke-signature-service (.get instance prototype) value))
        (check-equal? answer value) (check-equal? (callback #f) #f) (check-equal? (callback #t) #t)
        (check (begin (declared-snapshot owner) #t) => #t)
        (for-each (lambda (bad) (check-exception (callback bad) TypeError?)) '(0 scale: #!key #!rest))
        (def context (.o approved: #t)) (def consumed 0)
        (defvalues (evidence next failure)
          ((service.boolean-service-action instance value context
            (lambda (subject) (check-equal? (.get subject answer) value) (set! consumed (1+ consumed))) value) context))
        (check-equal? failure #f) (check-equal? consumed 1)
        (check (eq? next context) => #t) (check (eq? (.get evidence context) context) => #t)
        (check-exception ((service.boolean-service-action instance value context
          (lambda (_) (set! consumed 99)) (not value)) context) TypeError?)
        (check-equal? consumed 1)) '(#f #t))
      (defvalues (answer callback owner)
        (service.invoke-signature-service (.get instance prototype) #f #t scale: 1 #f #t))
      (check-equal? answer #t) (check-equal? (callback #f) #f)
      (defvalues (disabled _callback _owner)
        (service.invoke-signature-service (.get instance prototype) #t #t scale: 0 #t))
      (check-equal? disabled #f)
      (check-exception (service.invoke-signature-service (.get instance prototype) #f scale: -1) TypeError?)
      (def partial (specialize-prototype-type service.BooleanServiceType '(Bool)))
      (check-equal? (.get (infer-declared-calls partial '(Bool (Enum #f #t)) calls forbidden) status) 'ambiguous)
      (check-equal? (.get (infer-declared-calls partial '((Exactly #t) (Enum #f)) calls forbidden) status) 'no-solution)
      (check-exception (infer-declared-calls partial '(Bool) calls forbidden 20) (refusal 'exhausted))
      (check-exception (subtype-expression? 'Bool (cons 'Union (make-list 100 '(Exactly #t))) 50) (refusal 'exhausted))
      (check-equal? (.get (service.infer-boolean-service '(Bool) '(Bool) calls) status) 'unique))
    (test-case "infinite scalar families need a complete same-family branch"
      (for-each (lambda (family sample fresh)
        (def complete `(Union (Enum report ready: #!key #!rest) (Union ,family Bool)))
        (check (subtype-expression? family complete) => #t)
        (check-equal? (.get (expression-type complete) sexp) complete)
        (check (eq? (validate (expression-type complete) sample) sample) => #t)
        (check (eq? (validate (expression-type complete) fresh) fresh) => #t)
        (check-equal? (normalize-type family (type-work 2000)) family)
        (for-each (lambda (target)
          (check (subtype-expression? family target) => #f))
          '((Union) (Union (Enum report ready: #!key #!rest))
            (Union (Enum report) (Union (Enum ready:) Bool Integer))))
        (for-each (lambda (other)
          (unless (eq? family other)
            (check (subtype-expression? family (list 'Union other)) => #f))) '(String Symbol Keyword))
        (check (subtype-expression? family `(Union ,family (Function (,family) (,family)))) => #f)
        (check (subtype-expression? family `(Union ,family (List ,family))) => #f)
        (check (subtype-expression? 'Any complete) => #f)
        (check (subtype-expression? `(Map UInt <- ,family) `(Map UInt <- ,complete)) => #f)
        (check (subtype-expression? `(Pair ,family (Map ,family <- UInt))
          `(Pair ,complete (Map ,complete <- UInt))) => #t)
        (check (subtype-expression? `(Function (,family) (,complete)) `(Function (,complete) (,family))) => #t)
        (check (subtype-expression? complete `(Union (Union ,family Bool) (Enum report ready: #!key #!rest))) => #f))
        '(String Symbol Keyword) (list (string-copy "report") 'report ready:)
        (list (make-string 137 #\x) (string->uninterned-symbol "fresh-scalar") (string->keyword "fresh-scalar")))
      (check-exception (subtype-expression? 'String '(Union String (Enum "mutable"))) (refusal 'unsupported))
      (check (subtype-expression? '(Enum #!key #!rest ready:) '(Union Keyword (Enum #!key #!rest))) => #f)
      (for-each (lambda (token)
        (check-exception (validate (expression-type '(Union Keyword)) token) TypeError?)) '(#!key #!rest))
      (def token (list 'selected-symbol)) (def later 0)
      (def selected (.cc Type. .element?: (cut eq? <> 'report) .validate: (lambda (_) (raise token))))
      (def fallback (.cc Type. .element?: symbol? .validate: (lambda (value) (set! later (1+ later)) value)))
      (check-exception (validate (Union selected fallback) 'report) (lambda (cause) (eq? cause token)))
      (check-equal? later 0))
    (test-case "scalar declarations encode keyword data through the full publication chain"
      (for-each (lambda (family value alternate)
        (def calls (list (list [] (list family) (list family `(Function (,family) (,family))))))
        (def schema (service.scalar-union-service-type family))
        (def report (service.infer-scalar-service family (list family) '(String Symbol Keyword Bool) calls))
        (check-equal? (.get report status) 'unique)
        (check-equal? (.get report solutions) (list (list family)))
        (def instance (.get report instance))
        (check-equal? (.get (car (.get instance descriptor inputs)) sexp) family)
        (defvalues (answer callback owner)
          (apply service.invoke-signature-service (.get instance prototype)
            (encode-arguments (list value alternate value) (list (cons scale: 2)) #t)))
        (check (eq? answer value) => #t) (check (eq? (callback alternate) alternate) => #t)
        (check (begin (declared-snapshot owner) #t) => #t)
        (for-each (lambda (bad) (check-exception (callback bad) TypeError?)) '(0 #f #!key #!rest))
        (def context (.o approved: #t)) (def consumed 0)
        (defvalues (evidence next failure)
          ((service.scalar-service-action instance value context
            (lambda (subject) (check (eq? (.get subject answer) value) => #t) (set! consumed (1+ consumed)))) context))
        (check-equal? failure #f) (check-equal? consumed 1)
        (check (eq? next context) => #t) (check (eq? (.get evidence context) context) => #t)
        (check-exception ((service.scalar-service-action instance value context
          (lambda (_) (set! consumed 99)) alternate) context) TypeError?)
        (check-equal? consumed 1)
        (def partial (specialize-prototype-type schema (list family)))
        (def union-type `(Union (Enum report ready: #!key #!rest) (Union ,family Bool)))
        (check-equal? (.get (infer-declared-calls partial (list family union-type) calls forbidden) status) 'ambiguous)
        (check-equal? (.get (infer-declared-calls partial '((Enum report ready:)) calls forbidden) status) 'no-solution)
        (check-exception (infer-declared-calls partial (list family) calls forbidden 20) (refusal 'exhausted))
        (check-exception (subtype-expression? family (cons 'Union (make-list 100 '(Enum report))) 50) (refusal 'exhausted))
        (check-equal? (.get (service.infer-scalar-service family (list family) (list family) calls) status) 'unique))
        '(String Symbol Keyword) (list (string-copy "ready") 'report scale:)
        (list (string-copy "other") 'other other:))
      ;; Value inclusion does not authorize transport-mode substitution. These
      ;; signatures cannot consume one another's encoded keyword argument rows.
      (check (subtype-expression? '(Function (Keyword) (Keyword))
        '(Function (Keyword) (Keyword) keywords: ((scale: . UInt)))) => #f)
      (check (subtype-expression? '(Function (Keyword) (Keyword) keywords: ((scale: . UInt)))
        '(Function (Keyword) (Keyword))) => #f)
      (def keyword-instance (.get (service.infer-scalar-service 'Keyword '(Keyword) '(Keyword)
        '((() (Keyword) (Keyword (Function (Keyword) (Keyword)))))) instance))
      (check-exception (service.invoke-signature-service (.get keyword-instance prototype) ready:) TypeError?)
      (check-exception (service.invoke-signature-service (.get keyword-instance prototype) scale:) TypeError?)
      (check-exception (apply service.invoke-signature-service (.get keyword-instance prototype)
        (list #!key #!key)) TypeError?))
    (test-case "ambiguity exhaustion and failed bounds cannot reach builders"
      (def partial (specialize-prototype-type service.UnionServiceType (list interval)))
      (check-equal? (.get (infer-declared-calls partial '(Integer UInt) observations forbidden) status) 'no-solution)
      (check-equal? (.get (infer-declared-calls partial (list interval alternatives) observations forbidden) status) 'ambiguous)
      (check-exception (infer-declared-calls partial (list interval) observations forbidden 20) (refusal 'exhausted))
      (check-exception (subtype-expression? interval (cons 'Union (make-list 100 '(Enum 0))) 50) (refusal 'exhausted))
      (check-equal? (.get (service.infer-range-service (list interval) (list interval) observations
        schema: service.UnionServiceType) status) 'unique))))
