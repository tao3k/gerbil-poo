;; Refusing untouched constructors verifies actual independent receipt reuse.
(def builder (.cc cache.Builder. allow: (lambda (key) (not (memq key '(quota spare stable))))))
;; Pause only after whole closure/current approval; channel scheduling is explicit
;; test control. Fixed waits bound every path without busy waiting or longer gates.
(def (paused-request owner approvals ready resume result)
  (def request (approval-revision.service.stage owner 'merge [] approvals builder extra-admit: (lambda (_ __)
    (channel-put ready 'approved)
    (unless (eq? (channel-get resume 5 'timeout) 'resume) (error "request resume timed out")) #t)))
  (thread-start! (make-thread (lambda ()
    (defvalues (head failure) (publication.submit! owner request))
    (channel-put result (cons head failure))))))
;; Controls separate revision drift from head drift and retain exact live
;; receipts across rejection/re-preparation. Arbitrary foreign writes are excluded.
(def approval-revision-test
  (test-suite "approval revision invalidation and several staged requests"
    (test-case "three staged siblings invalidate even when policy values are changed back"
      (def approvals (approval-revision.service.policies))
      (def owner (approval-revision.service.start approvals))
      (def old (publication.current owner))
      (def reached? #f)
      (def refusing (.cc cache.Builder. allow: (lambda (_) (set! reached? #t) #f)))
      (def pending (map (lambda (_) (approval-revision.service.stage owner 'merge [] approvals refusing)) '(one two three)))
      (check (eq? (publication.revise-approval! owner (cadr approvals) 'allowed #f) old) => #t)
      (publication.revise-approval! owner (cadr approvals) 'allowed #t)
      (for-each (lambda (request)
        (defvalues (held failure) (publication.submit! owner request))
        (check (eq? held old) => #t) (check (not (not failure)) => #t)) pending)
      (check-equal? reached? #f)
      (defvalues (merged ok) (approval-revision.service.submit-current! owner 'merge [] approvals builder))
      (check-equal? ok #f) (check-equal? (approval-revision.service.value merged 'settlement) 24))
    (test-case "two paused approved requests lose to metadata revision and a freshly staged third winner"
      (def approvals (approval-revision.service.policies))
      (def owner (approval-revision.service.start approvals))
      (def old (publication.current owner))
      (def ready (make-channel)) (def resume (make-channel)) (def result (make-channel))
      (def workers (map (lambda (_) (paused-request owner approvals ready resume result)) '(one two)))
      (check-equal? (channel-get ready 5 'timeout) 'approved)
      (check-equal? (channel-get ready 5 'timeout) 'approved)
      (publication.revise-approval! owner (cadr approvals) 'allowed #f)
      (def denied (approval-revision.service.stage owner 'merge [] approvals builder))
      (defvalues (held refusal) (publication.submit! owner denied))
      (check (eq? held old) => #t) (check (not (not refusal)) => #t)
      (publication.revise-approval! owner (cadr approvals) 'allowed #t)
      (defvalues (winner ok) (approval-revision.service.submit-current! owner 'merge
        [(cons 'spare (some (code.make-success 5)))] approvals
        (.cc cache.Builder. allow: (lambda (key) (not (memq key '(quota stable)))))))
      (check-equal? ok #f) (check-equal? (approval-revision.service.value winner 'settlement) 30)
      (for-each (lambda (_) (channel-put resume 'resume)) workers)
      (for-each (lambda (_)
        (def outcome (channel-get result 5 'timeout))
        (check (pair? outcome) => #t) (check (eq? (car outcome) winner) => #t)
        (check (not (not (cdr outcome))) => #t)) workers)
      (for-each (lambda (worker) (thread-join! worker 5)) workers)
      (check (eq? (publication.current owner) winner) => #t)
      (check (eq? (graph-cache-ref old 'stable) (graph-cache-ref winner 'stable)) => #t))
    (test-case "metadata-only invalidation rejects an already approved candidate with unchanged head"
      (def approvals (approval-revision.service.policies))
      (def owner (approval-revision.service.start approvals))
      (def old (publication.current owner))
      (def ready (make-channel)) (def resume (make-channel)) (def result (make-channel))
      (def worker (paused-request owner approvals ready resume result))
      (check-equal? (channel-get ready 5 'timeout) 'approved)
      (publication.revise-approval! owner (car approvals) 'limit 12)
      (channel-put resume 'resume)
      (def outcome (channel-get result 5 'timeout))
      (thread-join! worker 5)
      (check (pair? outcome) => #t) (check (eq? (car outcome) old) => #t)
      (check (not (not (cdr outcome))) => #t)
      (check (eq? (publication.current owner) old) => #t)
      (publication.revise-approval! owner (car approvals) 'limit 30)
      (defvalues (next ok) (approval-revision.service.submit-current! owner 'merge [] approvals builder))
      (check-equal? ok #f) (check-equal? (approval-revision.service.value next 'settlement) 24))
    (test-case "guarded mutation refuses before update and releases the publication lock"
      (def approvals (approval-revision.service.policies))
      (def owner (approval-revision.service.start approvals))
      (def old (publication.current owner))
      (def corrupt (approval-revision.service.stage owner 'merge [] approvals builder extra-admit: (lambda (_ __)
        (publication.revise-approval! owner (cadr approvals) 'allowed #f) #t)))
      (defvalues (held failure) (publication.submit! owner corrupt))
      (check (eq? held old) => #t) (check (not (not failure)) => #t)
      (check-equal? (.@ (cadr approvals) allowed) #t)
      (publication.revise-approval! owner (cadr approvals) 'limit 30)
      (defvalues (next ok) (approval-revision.service.submit-current! owner 'merge [] approvals builder))
      (check-equal? ok #f) (check-equal? (approval-revision.service.value next 'settlement) 24))
    (test-case "each topology round rejects siblings and restages after current service refusal"
      (def approvals (approval-revision.service.policies))
      (def owner (approval-revision.service.start approvals))
      (def original (publication.current owner))
      (def final (foldl (lambda (phase current)
        (publication.revise-approval! owner (cadr approvals) 'allowed #f)
        (def pending (map (lambda (_) (approval-revision.service.stage owner phase [] approvals builder)) '(one two three)))
        (defvalues (held denied) (publication.submit! owner (car pending)))
        (check (eq? held current) => #t) (check (not (not denied)) => #t)
        (publication.revise-approval! owner (cadr approvals) 'allowed #t)
        (defvalues (next ok) (approval-revision.service.submit-current! owner phase [] approvals builder))
        (check-equal? ok #f)
        (for-each (lambda (request)
          (defvalues (head stale) (publication.submit! owner request))
          (check (eq? head next) => #t) (check (not (not stale)) => #t)) pending)
        (check (eq? (graph-cache-ref original 'stable) (graph-cache-ref next 'stable)) => #t)
        next) original '(merge replace restore merge replace restore)))
      (check-equal? (approval-revision.service.value final 'settlement) 12)
      (check (eq? final (publication.current owner)) => #t))))

;; Return the original suites from this lexical scope.
(values approval-revision-test)
