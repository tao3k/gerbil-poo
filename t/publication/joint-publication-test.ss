(export joint-publication-test)
(import :std/test :std/sync/channel :clan/poo/object :clan/poo/mop :clan/poo/brace :clan/poo/feedback-graph :clan/poo/lens-laws
        (prefix-in :clan/poo/joint-publication joint.) (prefix-in :clan/poo/construction-cache cache.)
        (prefix-in :clan/poo/examples/component-rounds rounds.) (prefix-in :clan/poo/examples/joint-services service.))
;; Neither input nor independent feedback should rebuild on a pure topology batch.
(def builder (.cc cache.Builder. allow: (lambda (key) (not (memq key '(quota spare stable))))))
;; Execute actual whole-group closure and inspect whole snapshot identity on refusal.
(def joint-publication-test
  (test-suite "atomic shared approvals and consistent endpoint publication"
    (test-case "shared and local replacements plus both endpoint heads install as one bundle"
      (def owner (service.start)) (def old (joint.current owner))
      (def shared (service.policy 24)) (def local-a (service.policy 24))
      (def request (service.stage owner 'merge [(cons 'shared shared) (cons 'a local-a)] builder))
      (check (eq? old (joint.current owner)) => #t)
      (defvalues (next ok) (joint.submit! owner request))
      (check-equal? ok #f)
      (check-equal? (service.value next 'a) 24) (check-equal? (service.value next 'b) 24)
      (check (eq? shared (joint.approval next 'shared)) => #t)
      (check (eq? local-a (joint.approval next 'a)) => #t)
      (check-equal? (.@ (joint.approval old 'shared) limit) 12)
      (check-equal? (service.value old 'a) 12)
      (for-each (lambda (key)
        (check (eq? (graph-cache-ref (joint.head old key) 'stable)
                    (graph-cache-ref (joint.head next key) 'stable)) => #t)) '(a b))
      (defvalues (held stale) (joint.submit! owner request))
      (check (eq? held next) => #t) (check (not (not stale)) => #t))
    (test-case "second service refusal discards first constructed head and ALL proposed policies"
      (def owner (service.start)) (def old (joint.current owner))
      (def bad (service.stage owner 'merge
        [(cons 'shared (service.policy 24)) (cons 'b (service.policy 12))] builder))
      (defvalues (held failure) (joint.submit! owner bad))
      (check (eq? held old) => #t) (check (not (not failure)) => #t)
      (check-equal? (.@ (joint.approval held 'shared) limit) 12)
      (check-equal? (service.value held 'a) 12)
      (def retry (service.stage owner 'merge [(cons 'shared (service.policy 24))] builder))
      (defvalues (next ok) (joint.submit! owner retry))
      (check-equal? ok #f) (check-equal? (service.value next 'b) 24))
    (test-case "partial deployment fails final consistency and omitted endpoints still reapprove"
      (def owner (service.start)) (def old (joint.current owner))
      (def partial (joint.stage owner [(cons 'shared (service.policy 24))]
        [(cons 'a (rounds.contributions 'merge))] builder: builder))
      (defvalues (held failure) (joint.submit! owner partial))
      (check (eq? held old) => #t) (check (not (not failure)) => #t)
      (def revoked (joint.stage owner [(cons 'b (service.policy 30 #f))] []
        builder: (.cc cache.Builder. allow: (lambda (_) #f))))
      (defvalues (same refusal) (joint.submit! owner revoked))
      (check (eq? same old) => #t) (check (not (not refusal)) => #t))
    (test-case "proposed metadata mutation invalidates its staged request without changing installed bundle"
      (def owner (service.start)) (def old (joint.current owner))
      (def replacement (service.policy 24))
      (def request (service.stage owner 'merge [(cons 'shared replacement)] builder))
      (.putslot! replacement 'limit ($constant-slot-spec 30))
      (defvalues (held failure) (joint.submit! owner request))
      (check (eq? held old) => #t) (check (not (not failure)) => #t)
      (check-equal? (.@ (joint.approval old 'shared) limit) 12)
      (check-exception (joint.stage owner [(cons 'shared replacement) (cons 'shared replacement)] []) true)
      (check-exception (joint.stage owner [(cons 'unknown replacement)] []) true))
    (test-case "registered fixed callback metadata stays guarded on later requests"
      (def seed (service.start)) (def original (joint.current seed))
      (def context (.o (enabled #t)))
      (def owner (joint.publication
        [(cons 'a (joint.head original 'a)) (cons 'b (joint.head original 'b))]
        [(cons 'shared (joint.approval original 'shared))]
        (lambda (_) rounds.build-group)
        (lambda (_ __ ___ ____) (.@ context enabled)) (lambda (_ __) #t)
        guards: [(lens-check (.lens) [context] sources: [context])] ))
      (.putslot! context 'enabled ($constant-slot-spec #f))
      (def old (joint.current owner))
      (def request (joint.stage owner [] [] builder: (.cc cache.Builder. allow: (lambda (_) #f))))
      (defvalues (held failure) (joint.submit! owner request))
      (check (eq? held old) => #t) (check (not (not failure)) => #t))
    (test-case "a paused joint candidate loses to a rival whole bundle then restages from its new topology"
      (def ready (make-channel)) (def resume (make-channel)) (def result (make-channel))
      (def pause? #f)
      (def owner (service.start extra-joint: (lambda (old _)
        (when (and old pause?)
          (set! pause? #f) (channel-put ready 'ready)
          (unless (eq? (channel-get resume 5 'timeout) 'go) (error "joint resume timeout"))) #t)))
      (def old (joint.current owner))
      (def slow (service.stage owner 'merge [(cons 'shared (service.policy 24))] builder))
      (def rival (service.stage owner 'merge [(cons 'shared (service.policy 30))] builder))
      (set! pause? #t)
      (def worker (thread-start! (make-thread (lambda ()
        (defvalues (snapshot failure) (joint.submit! owner slow))
        (channel-put result (cons snapshot failure))))))
      (check-equal? (channel-get ready 5 'timeout) 'ready)
      (check (eq? old (joint.current owner)) => #t)
      (defvalues (winner ok) (joint.submit! owner rival))
      (check-equal? ok #f) (channel-put resume 'go)
      (def outcome (channel-get result 5 'timeout)) (thread-join! worker 5)
      (check (eq? (car outcome) winner) => #t) (check (not (not (cdr outcome))) => #t)
      (check-equal? (.@ (joint.approval winner 'shared) limit) 30)
      (defvalues (split fine) (joint.submit! owner (service.stage owner 'replace [] builder)))
      (check-equal? fine #f) (check-equal? (service.value split 'a) 16)
      (check-equal? (service.value split 'b) 16))))
