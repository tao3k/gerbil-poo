(export joint-restaging-test)
(import :std/test :clan/poo/object :clan/poo/mop :clan/poo/brace :clan/poo/feedback-graph
        (prefix-in :clan/poo/joint-publication joint.) (prefix-in :clan/poo/construction-cache cache.)
        (prefix-in :clan/poo/examples/joint-topology service.) (prefix-in :clan/poo/examples/joint-receipts receipts.)
        (prefix-in :clan/poo/examples/joint-workers workers.))
;; Named private observations preserve receipt and whole-snapshot provenance.
(defstruct observation (receipt snapshot failure) final: #t)
;; Reuse clean independent feedback through all actual SCC revisions.
(def builder (.cc cache.Builder. allow: (lambda (key) (not (eq? key 'stable)))))
;; Each row uses existing two-service support/closure phase contributions.
(def (edits phase) (map (lambda (key) (cons key (.cc service.Change. phase: phase))) '(a b)))
;; Stage proposed policy values separately from immutable installed metadata.
(def (policy owner ceiling budget) (.cc (joint.approval (joint.current owner) 'shared) limit: ceiling budget: budget))
;; Every late installation returns the actual current bundle on refusal.
(def (refused entry)
  (check (not (not (observation-failure entry))) => #t))
;; One worker remains pending while the next round is built, denied, and rebuilt.
(def joint-restaging-test
  (test-suite "cross-round restaging while prior installation workers remain pending"
    (test-case "six SCC phases continuously overlap old workers with denied and freshly approved work"
      (def owner (service.start)) (def original (joint.current owner))
      (workers.call-with-installations owner (lambda (start receive)
        (def initial (receipts.approve-revisions owner [(edits 'merge) (edits 'merge)] (policy owner 24 48) builder))
        (def first-go (start (car initial))) (def held-go (start (cadr initial)))
        (first-go) (def first (receive)) (check-equal? (observation-failure first) #f)
        ;; Recursion threads the STILL-PENDING worker across explicit source rounds.
        (let loop ((rows '((replace 16 32 16) (restore 12 24 12) (merge 24 48 24)
                          (replace 16 32 16) (restore 12 24 12)))
                   (old-go held-go) (old-receipt (cadr initial)))
          (if (null? rows)
            (begin (old-go) (refused (receive)))
            (let* ((row (car rows)) (before (joint.current owner))
                   (changes (edits (car row))) (shared (policy owner (cadr row) (caddr row)))
                   (pending (receipts.approve-revisions owner [changes changes] shared builder))
                   (release (map start (cons (car initial) pending))))
              ;; The old worker is still blocked; none of these new workers run yet.
              (.putslot! shared 'budget ($constant-slot-spec (+ (caddr row) 1)))
              (.putslot! shared 'budget ($constant-slot-spec (caddr row)))
              (for-each (lambda (go) (go)) release)
              (for-each (lambda (_)
                (def result (receive)) (refused result)
                (check (eq? (observation-snapshot result) before) => #t)) release)
              ;; Explicitly re-stage the SAME changes while old-go still waits.
              (def fresh (receipts.approve-revisions owner [changes changes] shared builder))
              (def next-go (start (car fresh))) (def later-go (start (cadr fresh)))
              (old-go) (next-go)
              (def results [(receive) (receive)])
              (check (not (eq? (observation-receipt (car results)) (observation-receipt (cadr results)))) => #t)
              (for-each (lambda (result)
                (if (eq? (observation-receipt result) old-receipt)
                  (refused result)
                  (begin
                    (check (eq? (observation-receipt result) (car fresh)) => #t)
                    (check-equal? (observation-failure result) #f)))) results)
              (def winner (joint.current owner))
              (for-each (lambda (result)
                (check (or (eq? (observation-snapshot result) before)
                           (eq? (observation-snapshot result) winner)) => #t)) results)
              (for-each (lambda (key)
                (check-equal? (service.value winner key) (list-ref row 3))
                (check (eq? (graph-cache-ref (joint.head original key) 'stable)
                            (graph-cache-ref (joint.head winner key) 'stable)) => #t)
                (case (car row)
                  ((replace) (check-exception (graph-cache-ref (joint.head winner key) 'b) true))
                  ((restore) (for-each (lambda (removed)
                    (check-exception (graph-cache-ref (joint.head winner key) removed) true)
                    (check-equal? (.call (graph-cache-source (joint.head winner key)) .code removed) #f)
                    (check-equal? (.call (graph-cache-source (joint.head winner key)) .base removed) #f)) '(e f))))) '(a b))
              (loop (cdr rows) later-go (cadr fresh)))))) report: make-observation)
      (check-equal? (service.value (joint.current owner) 'a) 12)
      (check-equal? (.@ (joint.approval (joint.current owner) 'shared) budget) 24))
    (test-case "scopes reject unfinished work escaped operations and duplicate release"
      (def owner (service.start)) (def before (joint.current owner))
      (def receipt (car (receipts.approve-revisions owner [(edits 'merge)] (policy owner 24 48) builder)))
      (check-exception (workers.call-with-installations owner (lambda (start _)
        (start receipt) 'unobserved)) true)
      (check (eq? before (joint.current owner)) => #t)
      (def escaped #f)
      (workers.call-with-installations owner (lambda (start _) (set! escaped start)))
      (check-exception (escaped receipt) true)
      (defvalues (marker outcome) (workers.call-with-installations owner (lambda (start receive)
        (def go (start receipt)) (go)
        (check-exception (go) true)
        (values 'observed (receive)))))
      (check-equal? marker 'observed) (check-equal? (cdr outcome) #f))))
