(export joint-generations-test)
(import :std/test (only-in :std/list/list foldl filter) :clan/poo/object :clan/poo/mop :clan/poo/brace :clan/poo/feedback-graph
        (prefix-in :clan/poo/joint-publication joint.) (prefix-in :clan/poo/construction-cache cache.)
        (prefix-in :clan/poo/examples/joint-topology service.) (prefix-in :clan/poo/examples/joint-receipts receipts.)
        (prefix-in :clan/poo/examples/joint-concurrency concurrent.))
;; Preserve the opaque receipt's identity alongside each complete outcome.
(defstruct observation (receipt snapshot failure) final: #t)
;; Installation never rebuilds independent feedback during actual revision work.
(def builder (.cc cache.Builder. allow: (lambda (key) (not (eq? key 'stable)))))
;; Existing declarations describe symmetric or asymmetric lifecycle edits.
(def (change phase) (.cc service.Change. phase: phase))
;; Shared replacements are distinct from immutable installed policy objects.
(def (policy owner ceiling budget) (.cc (joint.approval (joint.current owner) 'shared) limit: ceiling budget: budget))
;; A pure higher-order report preserves generation attribution outside the lock.
(def (race owner pending (before void))
  (concurrent.install-concurrently owner pending before-release: before report: make-observation))
;; Select actual successful installations without assuming completion order.
(def (successes outcomes) (filter (lambda (entry) (not (observation-failure entry))) outcomes))
;; Check mixed-wave identity attribution, not only final arithmetic equality.
(def joint-generations-test
  (test-suite "old and current approved receipts in the same native concurrent wave"
    (test-case "six SCC rounds mix all historical receipts with current alternatives and drift"
      (def owner (service.start)) (def original (joint.current owner))
      (def history (foldl (lambda (row previous)
        (def before (joint.current owner)) (def phase (car row))
        (def ceiling (cadr row)) (def budget (caddr row))
        (def edits (map (lambda (key) (cons key (change phase))) '(a b)))
        (def shared (policy owner ceiling budget))
        (def pending (receipts.approve-revisions owner [edits edits] shared builder))
        (def pa (policy owner ceiling budget)) (def pb (policy owner ceiling (+ budget 2)))
        (def a (car (receipts.approve-revisions owner [edits] pa builder)))
        (def b (car (receipts.approve-revisions owner [edits] pb builder)))
        (def outcomes (race owner (append previous [(car pending) a (cadr pending) b a]) (lambda ()
          (check (eq? before (joint.current owner)) => #t)
          (.putslot! shared 'budget ($constant-slot-spec (+ budget 1)))
          (.putslot! shared 'budget ($constant-slot-spec budget)))))
        (check-equal? (length outcomes) (+ (length previous) 5))
        (def accepted (successes outcomes)) (check-equal? (length accepted) 1)
        (def winner (joint.current owner)) (def won (observation-receipt (car accepted)))
        (check (or (eq? won a) (eq? won b)) => #t)
        (check (eq? (joint.approval winner 'shared) (if (eq? won a) pa pb)) => #t)
        (for-each (lambda (entry)
          (when (or (memq (observation-receipt entry) previous) (memq (observation-receipt entry) pending))
            (check (not (not (observation-failure entry))) => #t))
          (check (or (eq? (observation-snapshot entry) before) (eq? (observation-snapshot entry) winner)) => #t)) outcomes)
        (for-each (lambda (key)
          (check-equal? (service.value winner key) (list-ref row 3))
          (check (eq? (graph-cache-ref (joint.head original key) 'stable)
                      (graph-cache-ref (joint.head winner key) 'stable)) => #t)
          (case phase
            ((replace) (check-exception (graph-cache-ref (joint.head winner key) 'b) true))
            ((restore) (for-each (lambda (removed)
              (check-exception (graph-cache-ref (joint.head winner key) removed) true)
              (check-equal? (.call (graph-cache-source (joint.head winner key)) .code removed) #f)
              (check-equal? (.call (graph-cache-source (joint.head winner key)) .base removed) #f)) '(e f))))) '(a b))
        (append previous pending [a b])) [] '((merge 24 48 24) (replace 16 32 16) (restore 12 24 12)
                                            (merge 24 48 24) (replace 16 32 16) (restore 12 24 12))))
      (check-equal? (successes (race owner history)) []))
    (test-case "a fully refused mixed wave restages the same edits then continues asymmetric SCC changes"
      (def owner (service.start))
      (def old (car (receipts.approve-revisions owner [[(cons 'a (change 'merge))]] (policy owner 24 36) builder)))
      (defvalues (before ok) (joint.install! owner old)) (check-equal? ok #f)
      (def edits [(cons 'a (change 'replace)) (cons 'b (change 'merge))])
      (def shared (policy owner 24 40))
      (def pending (receipts.approve-revisions owner [edits edits] shared builder))
      (def denied (race owner (cons old pending) (lambda ()
        (.putslot! shared 'budget ($constant-slot-spec 41))
        (.putslot! shared 'budget ($constant-slot-spec 40)))))
      (check-equal? (successes denied) [])
      (for-each (lambda (entry) (check (eq? (observation-snapshot entry) before) => #t)) denied)
      ;; Explicit new staging captures the changed proposal and CURRENT graph.
      (def fresh (car (receipts.approve-revisions owner [edits] shared builder)))
      (def retry (race owner [(car pending) fresh old (cadr pending) fresh]))
      (check-equal? (length (successes retry)) 1)
      (check (eq? (observation-receipt (car (successes retry))) fresh) => #t)
      (def next (joint.current owner))
      (check-equal? (service.value next 'a) 16) (check-equal? (service.value next 'b) 24)
      (def restore (car (receipts.approve-revisions owner
        [[(cons 'a (change 'restore)) (cons 'b (change 'replace))]] (policy owner 16 28) builder)))
      (def final (race owner [old fresh (car pending) restore (cadr pending)]))
      (check-equal? (length (successes final)) 1)
      (check (eq? (observation-receipt (car (successes final))) restore) => #t)
      (check-equal? (service.value (joint.current owner) 'a) 12)
      (check-equal? (service.value (joint.current owner) 'b) 16))))
