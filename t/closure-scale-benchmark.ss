(export main)
(import :gerbil/runtime/gambit ../closure)

(def (workload family size width seed)
  (let ((equations (make-vector size)))
    (let loop ((index 0))
      (when (< index size)
        (vector-set! equations index
          (cond
            ((= index 0) (if (equal? family "ring")
                           (either (literal seed) (fact (- size 1))) (literal seed)))
            ((equal? family "dense")
             (let dense ((earlier 0) (expression (literal #f)))
               (if (= earlier index) expression
                 (dense (+ earlier 1) (either expression (fact earlier))))))
            ((equal? family "diamond")
             (if (= (modulo index 3) 0) (both (fact (- index 1)) (fact (- index 2)))
               (fact (- index (modulo index 3)))))
            ((equal? family "hubchain")
             (if (= (modulo index 16) 0) (either (fact 0) (fact (- index 1)))
               (fact (- index 1))))
            ((equal? family "bursts")
             (if (= (modulo index 32) 0) (fact (- index 1))
               (fact (- index (modulo index 32)))))
            ((equal? family "skewed")
             (let skew ((remaining width) (expression (literal #f)))
               (if (= remaining 0) expression
                 (skew (- remaining 1) (either expression (fact (- index 1)))))))
            ((equal? family "gated") (both (fact 0) (literal (= (modulo index 2) 0))))
            ((equal? family "quorum")
             (let ((a (fact (- index 1))) (b (fact (- index 1))) (c (fact 0)))
               (either (both a b) (either (both a c) (both b c)))))
            (else (fact (- index 1)))))
        (loop (+ index 1))))
    equations))

(def (main . args)
  (unless (memv (length args) '(7 8)) (error "queue state family n width seed repetitions [cold|warm]"))
  (let* ((queue (string->symbol (list-ref args 0))) (state (string->symbol (list-ref args 1)))
         (family (list-ref args 2)) (size (string->number (list-ref args 3)))
         (width (string->number (list-ref args 4))) (seed (equal? (list-ref args 5) "true"))
         (repetitions (string->number (list-ref args 6)))
         (scope (if (= (length args) 8) (list-ref args 7) "cold"))
         (validated (unless (and (exact-integer? size) (> size 0)
                            (exact-integer? width) (> width 0)
                            (exact-integer? repetitions) (> repetitions 0)
                            (member (list-ref args 5) '("true" "false"))
                            (member scope '("cold" "warm"))
                            (member family '("diamond" "dense" "ring" "skewed" "gated" "quorum" "hubchain" "bursts")))
                      (error "invalid workload parameters")))
         (source (workload family size width seed)) (last #f)
         (plan (if (equal? scope "warm") (compile-closure source) #f)) (started (cpu-time)))
    (let loop ((remaining repetitions))
      (when (> remaining 0)
        (when (equal? scope "cold") (set! plan (compile-closure source)))
        (set! last (solve-closure plan queue state))
        (loop (- remaining 1))))
    (let ((seconds (- (cpu-time) started)) (counts (closure-counts last)))
      (let check ((index 0))
        (when (< index size)
          (unless (eq? (closure-ref last index)
                       (and seed (or (not (equal? family "gated")) (= (modulo index 2) 0))))
            (error "independent scalar oracle" index))
          (check (+ index 1))))
      (unless (and (<= (vector-ref counts 0) (+ size (closure-plan-edges plan)))
                   (<= (vector-ref counts 3) size)
                   (<= (vector-ref counts 12) size)
                   (= (vector-ref counts 2) (+ (vector-ref counts 7) (vector-ref counts 8) (vector-ref counts 9)))
                   (= (vector-ref counts 10)
                      (+ size (cond ((eq? queue 'chunked) (vector-ref counts 3))
                                    ((eq? queue 'hybrid) (+ (vector-ref counts 13) (vector-ref counts 5)))
                                    (else (vector-ref counts 4)))))
                   (or (not (eq? queue 'hybrid))
                       (and (<= (+ (vector-ref counts 13) (vector-ref counts 5)) (vector-ref counts 4))
                            (<= (+ (vector-ref counts 13) (* 8 (vector-ref counts 5))) (vector-ref counts 4))
                            (<= (+ (vector-ref counts 13) (* 8 (vector-ref counts 5))) (* 8 (vector-ref counts 3)))))
                   (= (vector-ref counts 11) (if (eq? state 'owned) 0 (* size (vector-ref counts 3)))))
        (error "primitive/representation model mismatch"))
      (displayln "queue=" queue " state=" state " family=" family " n=" size " width=" width
        " seed=" seed " scope=" scope " repetitions=" repetitions " cpu_seconds=" seconds
        " pops=" (vector-ref counts 0) " evals=" (vector-ref counts 1) " nodes=" (vector-ref counts 2)
        " writes=" (vector-ref counts 3) " pushes=" (vector-ref counts 4)
        " peak_frames=" (vector-ref counts 12) " frame_allocations=" (vector-ref counts 5) " frame_pops=" (vector-ref counts 6)
        " queue_pairs=" (vector-ref counts 10) " state_copy_bytes=" (vector-ref counts 11)
        " copied_queue=" (if (eq? queue 'append) (vector-ref counts 4) (vector-ref counts 13)) " empty_schedules=" (vector-ref counts 14)
        " shared_schedules=" (vector-ref counts 15) " inline_schedules=" (vector-ref counts 16)
        " selected_fee=" (+ (if (eq? queue 'append) (vector-ref counts 4) (vector-ref counts 13)) (* 8 (vector-ref counts 5)))
        " edges=" (closure-plan-edges plan) " syntax_nodes=" (closure-plan-nodes plan) " oracle_parity=true"))))
