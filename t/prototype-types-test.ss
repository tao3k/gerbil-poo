;;; Bounded subtype, explicit polymorphism and complete finite inference controls.
(export prototype-types-test)
(import :std/test :std/error ../object ../mop ../number ../types/relation ../prototype-types
        (prefix-in ../examples/polymorphic-services service.))

;; Require the exact bounded refusal so unrelated callback failures cannot pass.
(def (type-message? text)
  (lambda (cause) (and (Error? cause) (equal? (error-message cause) text))))

;; Check positive derivations beside variance, ambiguity and refusal controls.
(def prototype-types-test
  (test-suite "bounded prototype polymorphism and inference"
    (test-case "computed parameter getters cannot rewrite captured syntax or weaken bounds"
      (def variables (list 'Self 'Super))
      (def expression (list 'Function (list 'Self) (list 'Super)))
      (def bounds (list (list 'Self 'Super)))
      (def source (.o (.parameters
        (begin (set-car! variables 'Other)
          (set-car! (cadr expression) 'Bool)
          (set-car! (cdar bounds) 'Self) '(Self Super)))))
      (def schema (prototype-type source variables expression bounds))
      (check-equal? variables '(Other Super))
      (check-equal? (.get schema variables) '(Self Super))
      (check-equal? (.get schema expression) '(Function (Self) (Super)))
      (check-equal? (.get schema bounds) '((Self Super)))
      (check-exception (instantiate-prototype schema '(Integer UInt))
        (type-message? "Type substitution violates subtype constraint"))
      (check-equal? (.get (instantiate-prototype schema '(UInt Integer)) expression)
        '(Function (UInt) (Integer))))
    (test-case "every schema revalidation entry owns its inputs before computed getters"
      (for-each (lambda (request)
        (def source (.o .parameters: '(T)))
        (def schema (prototype-type source '(T) '(Function (T) (Integer)) '((T Integer))))
        (.setslot! source .parameters ($computed-slot-spec (lambda (_self _inherited)
          (set-car! (cadr (.get schema expression)) 'Bool)
          (set-car! (cdar (.get schema bounds)) 'T) '(T))))
        (def instance (request schema))
        (check-equal? (.get instance expression) '(Function (UInt) (Integer)))
        (check-equal? (.get schema expression) '(Function (Bool) (Integer))))
        (list (cut instantiate-prototype <> '(UInt))
          (lambda (schema) (.get (infer-prototype schema '(UInt) []) instance))
          (lambda (schema) (.get (infer-prototype-calls schema '(UInt)
            '((() (Integer) (UInt)))) instance))
          (lambda (schema) (instantiate-prototype (specialize-prototype-type schema '(UInt)) [])))))
    (test-case "finite capture refuses cycles before any computed parameter getter"
      (def reads 0)
      (def source (.o (.parameters (begin (set! reads (1+ reads)) '(T)))))
      (def cycle (list 'List 'T))
      (set-cdr! cycle cycle)
      (check-exception (prototype-type source '(T) cycle [])
        (lambda (cause) (and (type-refusal? cause) (eq? (type-refusal-kind cause) 'exhausted))))
      (check-equal? reads 0)
      (def cause (Error "parameter getter failed"))
      (def failing (.o (.parameters (raise cause))))
      (check (try (prototype-type failing '(T) 'T []) #f
               (catch (actual) (eq? actual cause))) => #t))
    (test-case "captured computed configuration completes inference and evidence publication"
      (def observed 0) (def bodies 0) (def consumed 0) (def callback #f)
      ;; Reusing the source buffers must not change this request's bound or
      ;; scalar/callback output types. No host body executes during inference.
      (def (observe expression bounds)
        (set! observed (1+ observed))
        (set-car! (cadr expression) 'Bool)
        (set-car! (cdar bounds) 'Output))
      ;; Both outputs use the original inferred UInt, including the nested call.
      (def (operation value)
        (set! bodies (1+ bodies)) (values (abs value) abs))
      (def report (service.infer-observed-descriptor-service observe '(Integer)
        '(UInt Bool) '((() (Integer) (UInt (Function (UInt) (Integer))))) operation))
      (check-equal? observed 1) (check-equal? bodies 0)
      (check-equal? (.get report solutions) '((UInt)))
      (check-equal? (.get report instance expression)
        '(Function (UInt (Function (UInt) (Integer))) (Integer)))
      (def context (.o approved: #t))
      (def denied (service.descriptor-service-action (.get report instance) -7 context
        (lambda (_) (set! consumed 99)) #f))
      (check-exception (denied context) TypeError?)
      (check-equal? consumed 0)
      (def action (service.descriptor-service-action (.get report instance) -7 context
        (lambda (subject) (set! consumed (1+ consumed)) (set! callback (.get subject callback)))))
      (defvalues (evidence next issue) (action context))
      (check-equal? issue #f) (check-equal? consumed 1)
      (check (eq? next context) => #t)
      (check (eq? (.get evidence context) context) => #t)
      (check-equal? (callback -9) 9) (check-exception (callback #f) TypeError?)
      (def none (service.infer-observed-descriptor-service observe '(UInt)
        '(Bool) [] operation))
      (check-equal? (.get none status) 'no-solution)
      (check-equal? (.get none instance) #f)
      (check-equal? observed 2))
    (test-case "primitive hierarchy and nested Function variance"
      (check (element? UInt -1) => #f)
      (check (element? UInt 0) => #t)
      (check-exception (validate UInt -1) TypeError?)
      (check (subtype-expression? 'UInt 'Integer) => #t)
      (check (subtype-expression? 'Integer 'UInt) => #f)
      (check (subtype-expression? 'Bool 'Integer) => #f)
      (check (subtype-expression? '(Function (UInt) (Integer)) '(Function (Integer) (UInt))) => #t)
      (check (subtype-expression? '(Function (UInt) (UInt)) '(Function (Integer) (Integer))) => #f)
      (check (subtype-expression? '(List (Tuple UInt (Function (UInt) (Any))))
                                 '(List (Tuple Integer (Function (Integer) (Integer))))) => #t)
      (check (subtype-expression? '(Function (UInt UInt) ()) '(Function (Integer) ())) => #f))
    (test-case "explicit substitution precedes computed receiver binding"
      (let* ((instance (instantiate-prototype service.ServiceType '(UInt Integer)))
             (receiver (.get instance prototype))
             (wrapped (validate (.get instance descriptor) (.get receiver operation))))
        (check-equal? (wrapped -7) 7)
        (check (eq? (.get receiver Self) UInt) => #t)
        (check (eq? (.get receiver Super) Integer) => #t)
        (check-exception (wrapped #f) TypeError?)
        (check-exception (instantiate-prototype service.ServiceType '(Integer UInt))
                         (type-message? "Type substitution violates subtype constraint"))))
    (test-case "appendix function prototype binds higher-order Self and Super"
      (let* ((instance (instantiate-prototype service.FunctionPrototypeType
                          '((Function (UInt) (Integer)) (Function (Integer) (UInt)))))
             (combine (validate (.get instance descriptor) (.get instance prototype combine)))
             (method (combine abs identity)))
        (check-equal? (method -8) 8)
        (check-exception (method #f) TypeError?)
        (check-exception ((combine abs (lambda (_) #f)) 1) TypeError?)))
    (test-case "unique complete inference specializes once, ambiguity never guesses"
      (let* ((inferred (infer-prototype service.ServiceType '(UInt Integer) '((Integer Super) (UInt Self))))
             (unique (infer-prototype service.ServiceType '(UInt Integer)
                       '(((Function (UInt) (Integer)) (Function (Self) (Super))))))
             (none (infer-prototype service.ServiceType '(UInt Integer) '((Bool Self)))))
        (check-equal? (.get inferred status) 'ambiguous)
        (check-equal? (.get inferred instance) #f)
        (check-equal? (.get unique status) 'ambiguous)
        (check-equal? (.get none status) 'no-solution)
        (check-equal? (.get none solutions) [])))
    (test-case "negative position identifies a unique bounded specialization"
      (let* ((schema (prototype-type service.Service '(Self Super)
                       '(Function (Self) (Super)) '((Self Super) (Super Self))))
             (report (infer-prototype schema '(UInt Integer)
                       '((UInt Self) ((Function () (UInt)) (Function () (Self)))))))
        (check-equal? (.get report status) 'unique)
        (check-equal? (.get report solutions) '((UInt UInt)))
        (check-equal? (.get report instance expression) '(Function (UInt) (UInt)))))
    (test-case "contract refinement and exact evidence binding retain normalization"
      (let* ((instance (instantiate-prototype service.ServiceType '(UInt Integer)))
             (raw (.get instance prototype))
             (subject (.o operation: (.get raw operation) limit: (.get raw operation)))
             (context (.o revision: 1)) (old (.o revision: 0))
             (consumed 0)
             (action (service.service-action instance 10
                       (lambda (value) (set! consumed (+ consumed 1)) value)))
             (checked (action subject))
             (evidence (.o bind-these: #f subject: subject descriptor: (.get instance descriptor) context: context)))
        (check-equal? ((.get checked operation) -9) 9)
        (check-exception ((.get checked operation) #f) TypeError?)
        (check-equal? consumed 1)
        (let-values (((actual next refusal) (service.publish-service instance subject context evidence old)))
          (check-equal? refusal #f) (check (eq? actual evidence) => #t) (check (eq? next subject) => #t))
        (let-values (((actual next refusal)
                      (service.publish-service instance subject context (.cc evidence context: (.cc context)) old)))
          (check-equal? actual #f) (check (eq? next old) => #t) (check (not (not refusal)) => #t))
        (check-exception ((service.service-action instance 2 identity) subject) TypeError?)))
    (test-case "compiled higher-order fields use the existing nested wrappers"
      (let* ((descriptor (expression-type '(List (Tuple (Function (UInt) (Integer)))))))
        (check-exception ((vector-ref (car (validate descriptor (list (vector (lambda (_) -1))))) 0) 3) TypeError?)
        (let* ((higher (expression-type '(Function (Integer) ((Function (UInt) (Integer))))))
               (calls 0)
               (wrapped (validate higher (lambda (callback) (set! calls (+ calls 1)) (callback -4)))))
          (check-equal? (wrapped abs) 4)
          (check-exception (wrapped (lambda (_) -1)) TypeError?)
          (check-equal? calls 2))))
    (test-case "controlled refusal categories remain distinct from negative derivations"
      (check-exception (subtype-expression? 'Unknown 'Any)
        (lambda (cause) (and (type-refusal? cause) (eq? (type-refusal-kind cause) 'unsupported))))
      (check-exception (infer-prototype service.ServiceType '(UInt Integer) [] 1)
        (lambda (cause) (and (type-refusal? cause) (eq? (type-refusal-kind cause) 'exhausted))))
      (check-exception (instantiate-prototype service.ServiceType '(Integer UInt))
        (lambda (cause) (and (type-refusal? cause) (eq? (type-refusal-kind cause) 'bounds)))))
    (test-case "schema capture and revalidation reject rewritten or cyclic syntax"
      (let* ((expression (list 'List 'Self))
             (schema (prototype-type service.Service '(Self Super) expression '((Self Super)))))
        (set-car! (cdr expression) 'Bool)
        (check-equal? (.get (instantiate-prototype schema '(UInt Integer)) expression) '(List UInt))
        (check-exception (instantiate-prototype (.cc schema expression: 'Unknown) '(UInt Integer))
          (lambda (cause) (and (type-refusal? cause) (eq? (type-refusal-kind cause) 'unsupported)))))
      (let (cycle (list 'List 'UInt))
        (set-cdr! cycle cycle)
        (check-exception (subtype-expression? cycle 'Any)
          (lambda (cause) (and (type-refusal? cause) (eq? (type-refusal-kind cause) 'exhausted))))))
    (test-case "empty parameter universe has exactly the empty substitution"
      (let* ((prototype (.o .parameters: []))
             (schema (prototype-type prototype [] 'UInt []))
             (report (infer-prototype schema [] [])))
        (check-equal? (.get report status) 'unique)
        (check-equal? (.get report solutions) '(()))
        (check (eq? (.get report instance prototype) prototype) => #t)))
    (test-case "unsupported syntax and work exhaustion are never subtype false"
      (check (subtype-expression? '(Union UInt) '(Union Integer)) => #f)
      (check-exception (subtype-expression? '(Intersection UInt) '(Intersection Integer))
                       (type-message? "Unsupported Type constructor"))
      (check-exception (subtype-expression? '(List UInt) '(List Integer) 1)
                       (type-message? "Type work budget exhausted"))
      (check-exception (infer-prototype service.ServiceType '(UInt Integer) [] 40) Error?)
      (check-exception (instantiate-prototype service.ServiceType '(UInt Unknown)) Error?))
    (test-case "accepted solution keeps private raw ground and independent public syntax"
      (def schema (prototype-type (.o .parameters: '(T)) '(T)
        '(Function ((Function (T) (T))) (T)) []))
      (def report (infer-prototype schema '((List UInt)) []))
      (def instance (.get report instance))
      (def expected '(Function ((Function ((List UInt)) ((List UInt)))) ((List UInt))))
      (check-equal? (.get instance expression) expected)
      ;; Public search reports may be edited without revising accepted metadata.
      (set-car! (car (car (.get report solutions))) 'Maybe)
      (set-car! (cadr (.get (car (.get report alternatives)) expression)) 'Bool)
      (check-equal? (.get instance expression) expected)
      (check-equal? (cdr (car (.get instance substitution))) '(List UInt))
      (def second (.get (infer-prototype schema '((List UInt)) []) instance))
      (check (eq? (.get instance descriptor) (.get second descriptor)) => #f)
      (check (eq? (car (.get instance descriptor outputs)) (car (.get second descriptor outputs))) => #f)
      (def recursive (prototype-type (.o .parameters: '(T)) '(T) '(Mu X 1 (List T)) []))
      (def finite (infer-prototype recursive '(UInt) []))
      (check-equal? (.get finite instance expression) '(Mu X 1 (List UInt)))
      (check-equal? (.get (car (.get finite alternatives)) expression) '(List UInt)))
    (test-case "prototype ancestry is not semantic subtyping and malformed bounds refuse"
      (check-exception (prototype-type service.Service '(Self Self) 'Self []) Error?)
      (check-exception (prototype-type service.Service '(Self Super) 'Self '((Self))) Error?)
      (check-exception (prototype-type service.Service '(Self Super) 'Self '((Unknown Super))) Error?)
      (check-exception (instantiate-prototype service.ServiceType '(UInt)) Error?))))
