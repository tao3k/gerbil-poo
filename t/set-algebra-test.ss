;;; Finite set algebra shares standard backends, admission, deltas and ownership.
(export set-algebra-test)
(import :std/test :std/error :std/iter
        (only-in ../brace @@method)
        ../object ../mop ../number ../type ../table ../rationaldict ../support/option
        (only-in ../trie SimpleTrie SimpleTrieSet)
        (only-in ./table-validation-test alist-table)
        (only-in ./table-wrapper-test box-table)
        (prefix-in ../examples/service-collection service.))

;; Compare public refusal causes without swallowing unrelated backend exceptions.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; The independent list oracle uses ordinary membership, never table algebra.
(def (members mask)
  (filter (lambda (key) (not (zero? (bitwise-and mask (arithmetic-shift 1 key))))) '(0 1 2 3)))

;; Cover both generic merge and the existing Trie shared-subtree subset path.
(def set-algebra-test
  (test-suite "finite persistent set algebra"
    (test-case "image owners retain one erase last and restore exact inverse across backends"
      (for (table (list (RationalDict Unit) (SimpleTrie UInt Unit)))
        (def descriptor (.cc Set<-Table. Table: table))
        (def target (.cc descriptor Table: (.cc table .diff: (lambda args (error "unexpected image diff")))))
        (def calls 0)
        (def image (set-image descriptor target (lambda (key) (set! calls (+ calls 1)) (modulo key 3))))
        (def before (.call descriptor .<-list '(1 4 7 2)))
        (def state (.call image .ap before))
        (check-equal? (list-sort < (.call descriptor .list<- (.call image .get state))) '(1 2))
        (def one (.call table .delta/opt 1 (lambda (_) #f) before))
        (defvalues (kept no-edit) (.call image .apply-delta state one values))
        (check-equal? (table-delta-count no-edit) 0)
        (check (.call descriptor .=? (.call image .get kept) (.call image .get state)) => #t)
        (def remaining (.call image .unap kept))
        (def final (.call descriptor .<-list '(2)))
        (def erase (.call table .diff remaining final))
        (defvalues (gone removed) (.call image .apply-delta kept erase values))
        (check-equal? (.call descriptor .list<- (.call image .get gone)) '(2))
        (check-equal? (table-delta-count removed) 1)
        (defvalues (restored inverse) (.call image .apply-delta gone (invert-table-delta erase) values))
        (check (.call descriptor .=? (.call image .get restored) (.call image .get kept)) => #t)
        (check (.call descriptor .=? (.call table .apply-delta (.call image .get gone) inverse)
          (.call image .get kept)) => #t)
        (check (.call descriptor .=? (.call table .apply-delta (.call image .get gone)
          (invert-table-delta removed)) (.call image .get kept)) => #t)
        (let (prior calls)
          (check-exception (.call image .apply-delta gone erase) table-conflict?)
          (check-equal? calls prior))
        (check (.call descriptor .=? (.call image .unap kept) remaining) => #t)))
    (test-case "image transfers membership deltas across distinct declared source and target backends"
      (def source (.cc Set<-Table. Table: (RationalDict Unit)))
      (def target (SimpleTrieSet UInt))
      (def image (set-image source target (cut modulo <> 3)))
      (def root (.call source .<-list '(1 4 2)))
      (def state (.call image .ap root))
      (def after (.call source .<-list '(3 6 2)))
      (defvalues (next delta) (.call image .apply-delta state (.call (.@ source Table) .diff root after) values))
      (check-equal? (.call target .list<- (.call image .get next)) '(0 2))
      (check-equal? (table-delta-count delta) 2)
      (check (.call target .=? (.call (.@ target Table) .apply-delta (.call image .get next)
        (invert-table-delta delta)) (.call image .get state)) => #t))
    (test-case "image selective updates agree with a full oracle over repeated migrations"
      (def table (.cc (RationalDict Unit) Key: UInt))
      (def descriptor (.cc Set<-Table. Table: table))
      (def calls 0)
      (def image (set-image descriptor descriptor (lambda (key) (set! calls (+ calls 1)) (modulo key 4))))
      (def state (.call image .ap (.call descriptor .<-list '(1 2 3 8 12))))
      (for (round (in-range 24))
        (def before (.call image .unap state))
        (def key (+ 20 round))
        (def after (.call descriptor .cons key before))
        (let (prior calls)
          (set! state (.call image .apply-delta state (.call table .delta/opt key (lambda (_) (some (void))) before)))
          ;; One inserted owner: index projection plus touched-target selection.
          (check-equal? (- calls prior) 2))
        (def expected (.call descriptor .<-list (map (cut modulo <> 4) (.call descriptor .list<- after))))
        (check (.call descriptor .=? (.call image .get state) expected) => #t)))
    (test-case "image publishes target differences through all styles without diff rescanning"
      (def table (.cc (RationalDict Unit) Key: UInt))
      (def descriptor (.cc Set<-Table. Table: table))
      (def image (set-image descriptor descriptor (cut modulo <> 3)))
      (def before (.call descriptor .<-list '(1 4 2)))
      (def initial (.call image .ap before))
      (def after (.call descriptor .<-list '(2 3 6)))
      (def delta (.call table .diff before after))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (set-styles descriptor) name))
        (def owned (.call protocol .ap (.call image .get initial)))
        (def calls 0)
        (def action (service.publish-projected-ledger-action image delta protocol
          (lambda (_) (set! calls (+ calls 1)))))
        (def result (action (object<-alist (list (cons 'state initial) (cons 'target owned)))))
        (check-equal? calls 1)
        (check-equal? (list-sort < (.call descriptor .list<- (.call image .get (.@ result state)))) '(0 2))
        (check-equal? (list-sort < (.call protocol .list<- (.@ result target))) '(0 2))
        (check-equal? (table-delta-count (.@ result delta)) 2)))
    (test-case "regional grant workflow refuses stale public expectations and retries without losing shared owners"
      (def table (RationalDict Unit))
      (def descriptor (.cc Set<-Table. Table: table))
      (def image (set-image descriptor descriptor (cut modulo <> 3)))
      (def before (.call descriptor .<-list '(1 4 2)))
      (def state (.call image .ap before))
      (def protocol (.@ (set-styles descriptor) Linear))
      (def stale (.call protocol .ap (.call descriptor .<-list '(1))))
      (def calls 0)
      (def action (service.publish-access-image-action image descriptor
        (.call descriptor .<-list '(3 6)) (.call descriptor .<-list '(1 2)) protocol
        (lambda (_) (set! calls (+ calls 1)))))
      (check-exception (action (object<-alist (list (cons 'state state) (cons 'target stale)))) table-conflict?)
      (check-equal? calls 0)
      (check-equal? (.call protocol .list<- stale) '(1))
      (def fresh (.call protocol .ap (.call image .get state)))
      (def result (action (object<-alist (list (cons 'state state) (cons 'target fresh)))))
      (check-equal? calls 1)
      (check-equal? (list-sort < (.call protocol .list<- (.@ result target))) '(0 1))
      (check-equal? (list-sort < (.call descriptor .list<- (.call image .unap (.@ result state)))) '(3 4 6))
      (check (.call descriptor .=? (.call image .unap state) before) => #t))
    (test-case "image source and target final refinements refuse atomically and allow retry"
      (def table (RationalDict Unit))
      (def plain (.cc Set<-Table. Table: table))
      (def cohort (service.make-cohort-access table))
      (def calls 0)
      (def image (set-image cohort plain (lambda (key) (set! calls (+ calls 1)) (modulo key 3))))
      (def before (.call cohort .<-list '(1 2)))
      (def state (.call image .ap before))
      (let (prior calls)
        (check-exception (.call image .apply-delta state (.call table .delta/opt 1 (lambda (_) #f) before)) TypeError?)
        (check-equal? calls prior))
      (def target-image (set-image plain cohort (cut modulo <> 3)))
      (def target-state (.call target-image .ap before))
      (check-exception (.call target-image .apply-delta target-state
        (.call table .delta/opt 1 (lambda (_) #f) before)) TypeError?)
      (check (.call plain .=? (.call target-image .unap target-state) before) => #t)
      (def after (.call plain .<-list '(3 4)))
      (check-equal? (list-sort < (.call cohort .list<- (.call target-image .get
        (.call target-image .apply-delta target-state (.call table .diff before after))))) '(0 1)))
    (test-case "image transient owners avoid projection and no-edit delivery retains inherited origins"
      (def table (RationalDict Unit))
      (def descriptor (.cc Set<-Table. Table: table))
      (def image (set-image descriptor descriptor
        (lambda (key) (if (= key 99) (error "transient owner projected") (modulo key 3)))))
      (def root (.call descriptor .<-list '(1 4)))
      (def state (.call image .ap root))
      (def middle (.call descriptor .cons 99 root))
      (def transient (.call table .compose-deltas
        (list (.call table .diff root middle) (.call table .diff middle root))))
      (defvalues (same unchanged) (.call image .apply-delta state transient values))
      (check-equal? (table-delta-count unchanged) 0)
      (check (.call descriptor .=? (.call image .get same) (.call image .get state)) => #t)
      (def origin (.o revision: 1))
      (def inherited (.cc table .sources: (list origin)))
      (defvalues (stamped delivered) (.call image .apply-delta state (.call inherited .diff root root) values))
      (check-equal? (table-delta-count delivered) 0)
      (.set! origin revision 2)
      (check-exception (.call image .get stamped) (message? "stale set image state"))
      (check-exception (.call table .apply-delta (.call image .get state) delivered) (message? "stale or incompatible table delta")))
    (test-case "image snapshots retain source and target Set-specific refinement origins"
      (for (side '(source target))
        (def origin (.o revision: 1))
        (def plain (.cc Set<-Table. Table: (RationalDict Unit)))
        (def refined (.cc plain .sources: (list origin)))
        (def image (set-image (if (eq? side 'source) refined plain)
          (if (eq? side 'target) refined plain) (cut modulo <> 3)))
        (def state (.call image .ap (.call plain .<-list '(1 4))))
        (.set! origin revision 2)
        (check-exception (.call image .get state) (message? "stale set image"))))
    (test-case "image Function keys keep wrapped identity and declared origins reject old states"
      (def type (Fun Integer <- Integer))
      (def f (validate type (lambda (n) (+ n 7))))
      (def source (.cc Set<-Table. Table: (RationalDict Unit)))
      (def target (.cc Set<-Table. Table: (alist-table type Unit)))
      (def origin (.o revision: 1))
      (def image (set-image source target (lambda (_) f) (list origin)))
      (def state (.call image .ap (.call source .<-list '(1 2))))
      (check (eq? (car (.call target .list<- (.call image .get state))) f) => #t)
      (check (f 3) => 10)
      (.set! origin revision 2)
      (check-exception (.call image .get state) (message? "stale set image")))
    (test-case "all finite operand pairs agree with an independent membership oracle"
      (def rational (.cc Set<-Table. Table: (RationalDict Unit) sexp: 'set))
      (def trie (SimpleTrieSet UInt))
      (for* ((descriptor (list rational trie)) (left-mask (in-range 16)) (right-mask (in-range 16)))
        (def left (members left-mask)) (def right (members right-mask))
        (def a (.call descriptor .<-list left)) (def b (.call descriptor .<-list right))
        (def union (.call descriptor .union a b))
        (def inter (.call descriptor .inter a b))
        (def diff (.call descriptor .diff a b))
        (def sym (.call descriptor .symdiff a b))
        (for (key '(0 1 2 3))
          (def in-a (and (member key left) #t)) (def in-b (and (member key right) #t))
          (check (.call descriptor .elt? union key) => (or in-a in-b))
          (check (.call descriptor .elt? inter key) => (and in-a in-b))
          (check (.call descriptor .elt? diff key) => (and in-a (not in-b)))
          (check (.call descriptor .elt? sym key) => (not (eq? in-a in-b))))
        (check (.call descriptor .subset? a b) => (andmap (lambda (key) (and (member key right) #t)) left))
        (check (.call descriptor .disjoint? a b) => (not (ormap (cut member <> right) left)))
        (check (.call descriptor .=? a b) => (equal? left right))
        (check-equal? (.call descriptor .list<- a) left)
        (check-equal? (.call descriptor .list<- b) right)))
    (test-case "admission runs before empty or identical operand shortcuts"
      (for (descriptor (list (.cc Set<-Table. Table: (RationalDict Unit) sexp: 'set) (SimpleTrieSet UInt)))
        (def empty (.@ descriptor .empty))
        (for (method '(.union .inter .diff .symdiff .subset? .disjoint? .=?))
          (def operation (.ref descriptor method))
          (check-exception (operation empty 'invalid) TypeError?)
          (check-exception (operation 'invalid empty) TypeError?)
          (check-exception (operation 'invalid 'invalid) TypeError?)))
      (def plain (.cc Set<-Table. Table: (RationalDict Unit) sexp: 'unordered-set))
      (check-exception (.call plain .compare (.@ plain .empty) (.@ plain .empty))
        (message? "unsupported set comparison"))
      (def wrong (.cc Set<-Table. Table: (RationalDict Integer) sexp: 'not-unit))
      (check-exception (.call wrong .union (.@ wrong .empty) (.@ wrong .empty))
        (message? "set algebra requires Unit values")))
    (test-case "Function element identity is retained without normalization or value equality"
      (def type (Fun Integer <- Integer))
      (def f (validate type (lambda (x) (+ x 1))))
      (def g (validate type (lambda (_) "bad")))
      (def table (alist-table type Unit))
      (def descriptor (.cc Set<-Table. Table: table sexp: 'callback-set))
      (def left (.call descriptor .<-list (list f)))
      (def right (.call descriptor .<-list (list f g)))
      (def result (.call descriptor .diff (.call descriptor .union left right) left))
      (check-equal? (.call descriptor .count result) 1)
      (check (eq? (car (.call descriptor .list<- result)) g) => #t)
      (check-exception ((car (.call descriptor .list<- result)) 1) TypeError?)
      (check (.call descriptor .subset? left right) => #t)
      (check (.call descriptor .=? right (.call descriptor .union left right)) => #t)
      (check (eq? (car (.call descriptor .list<- left)) f) => #t))
    (test-case "backend failures retain identity and metadata mutation is rejected before publication"
      (def base (RationalDict Unit))
      (def fail? #t) (def cause (list 'merge-refused))
      (def table (.cc base .sources: (list base) .merge: (lambda (choose a b)
        (when fail? (raise cause)) (.call base .merge choose a b))))
      (def descriptor (.cc Set<-Table. Table: table sexp: 'guarded-set))
      (def a (.call descriptor .<-list '(1 2))) (def b (.call descriptor .<-list '(2 3)))
      (check (eq? (try (.call descriptor .union a b) #f (catch (e) e)) cause) => #t)
      (check-equal? (.call descriptor .list<- a) '(1 2))
      (set! fail? #f)
      (check-equal? (.call descriptor .list<- (.call descriptor .union a b)) '(1 2 3))
      (def mutate? #t)
      (def guarded (.cc base .sources: (list base) .every: (lambda (pred source)
        (when mutate? (.set! base Value Integer)) (.call base .every pred source))))
      (def set (.cc Set<-Table. Table: guarded sexp: 'guarded-set))
      (check-exception (.call set .subset? a b) Error?)
      (check (eq? (.@ base Value) Unit) => #t)
      (set! mutate? #f)
      (check (.call set .subset? a b) => #f))
    (test-case "Boolean membership lens composes through a service and enforces all lens laws"
      (def table (RationalDict Unit))
      (def descriptor (.cc Set<-Table. Table: table sexp: 'membership-set))
      (def before (.call descriptor .<-list '(1 3)))
      (def invalid (.call descriptor .lens "invalid-key"))
      (check-exception (.call invalid .get before) TypeError?)
      (check-exception (.call invalid .set #t before) TypeError?)
      (def focus (.call descriptor .lens 2))
      (check (.call focus .get before) => #f)
      (def added (.call focus .set #t before))
      (check (.call focus .get added) => #t)
      (check (.call descriptor .=? (.call focus .set #f added) before) => #t)
      (check (.call descriptor .=? (.call focus .set (.call focus .get before) before) before) => #t)
      (check (.call descriptor .=? (.call focus .set #f (.call focus .set #t before))
        (.call focus .set #f before)) => #t)
      (check-exception (.call focus .set 'truthy before) ContractViolation?)
      (def service (.o access: before revision: 7))
      (def nested (.call Lens .compose (.lens access) focus))
      (def next (.call Lens .modify nested not service))
      (check (.call nested .get next) => #t)
      (check-equal? (.@ next revision) 7)
      (check-equal? (.call descriptor .list<- (.@ service access)) '(1 3)))
    (test-case "access revision composes algebra delta transport conflict retry IO and inverse"
      (def table (.cc (RationalDict Unit) Key: UInt))
      (def descriptor (.cc Set<-Table. Table: table sexp: 'access-set))
      (def target (SimpleTrie UInt Unit))
      (def before (.call descriptor .<-list '(1 2 5)))
      (def grants (.call descriptor .<-list '(2 3 4)))
      (def revoked (.call descriptor .<-list '(2 4)))
      (def calls 0)
      (def action (service.prepare-access-revision descriptor before grants revoked
        (lambda (snapshot) (set! calls (+ calls 1)) snapshot)))
      (def result (action before))
      (check-equal? (.call descriptor .list<- result) '(1 3 5))
      (check-equal? calls 1)
      (def delta (.call table .diff before result))
      (def foreign (.call target .<-list (map (lambda (key) (cons key (void))) '(1 2 5))))
      (def installed (.call target .apply-delta foreign delta))
      (check-equal? (map car (.call target .list<- installed)) '(1 3 5))
      (def styles (table-styles target))
      (def linear (.@ styles Linear))
      (def owned (.call linear .ap installed))
      (def undone (.call linear .apply-delta owned (invert-table-delta delta)))
      (check-equal? (map car (.call target .list<- (.call linear .unap undone))) '(1 2 5))
      (def winner (.call descriptor .remove before 2))
      (check-exception (action winner) table-conflict?)
      (check-equal? calls 1)
      (def retry (service.prepare-access-revision descriptor winner grants revoked
        (lambda (snapshot) (set! calls (+ calls 1)) snapshot)))
      (check-equal? (.call descriptor .list<- (retry winner)) '(1 3 5))
      (check-equal? calls 2))
    (test-case "set refinements govern all algebra outputs and both relation inputs"
      (for (table (list (RationalDict Unit) (SimpleTrie UInt Unit)))
        (def descriptor (service.make-cohort-access table))
        (def a (.call descriptor .<-list '(1 2)))
        (def b (.call descriptor .<-list '(2 3)))
        (def invalid (.call table .<-list (list (cons 1 (void)))))
        (check-exception (validate descriptor invalid) TypeError?)
        (for (method '(.union .inter .diff))
          (check-exception ((.ref descriptor method) a b) TypeError?))
        (check-equal? (.call descriptor .list<- (.call descriptor .symdiff a b)) '(1 3))
        (for (method '(.union .inter .diff .symdiff .subset? .disjoint? .=? .compare))
          (def action (.ref descriptor method))
          (check-exception (action invalid a) TypeError?)
          (check-exception (action a invalid) TypeError?))
        ;; In particular, the Trie's identity/subtree shortcuts cannot bless it.
        (check-exception (.call descriptor .subset? invalid invalid) TypeError?)
        (check-equal? (.call descriptor .list<- a) '(1 2))))
    (test-case "list and iterator construction use one whole backing constructor"
      (def raw (RationalDict Unit))
      (def even (.cc raw .element?: (lambda (root)
        (and (element? raw root) (even? (.call raw .count root))))))
      (defvalues (boxed _carrier _keys) (box-table even))
      (def builds 0)
      (def table (.cc boxed .<-list: (lambda (rows)
        (set! builds (+ builds 1)) (.call boxed .<-list rows))))
      (def descriptor (service.make-cohort-access table))
      (def before (.call descriptor .<-list '(-1 -2)))
      (check-equal? builds 1)
      (check-exception (.call descriptor .<-list '(-1)) TypeError?)
      (def after (.call descriptor .<-iter (in-list '(-3 -4 -4)) before))
      (check-equal? builds 3)
      (check-equal? (.call descriptor .list<- after) '(-1 -2 -3 -4))
      (check-exception (.call descriptor .singleton -5) TypeError?)
      (check-exception (.call descriptor .cons -3 before) TypeError?)
      (check-exception (.call descriptor .remove before -1) TypeError?)
      (def nonempty (.cc descriptor .element?: (lambda (root)
        (and (element? descriptor root) (not (.call table .empty? root))))))
      (check-exception (.@ nonempty .empty) TypeError?)
      (check-equal? (.call nonempty .list<- (.call nonempty .<-iter (in-list '(-1 -2)))) '(-1 -2)))
    (test-case "membership focuses retain set origins and reject invalid successors"
      (def table (RationalDict Unit))
      (def dependency (.o epoch: 0))
      (def descriptor (.cc (service.make-cohort-access table) .sources: (list dependency)))
      (def base (.call descriptor .<-list '(1 2)))
      (def present (.call descriptor .lens 1)) (def absent (.call descriptor .lens 3))
      (check-exception (.call present .set #f base) TypeError?)
      (check-exception (.call absent .set #t base) TypeError?)
      (check-equal? (.call descriptor .list<- (.call present .set #t base)) '(1 2))
      (.set! dependency epoch 1)
      (check-exception (.call present .get base) (message? "stale set focus"))
      (def fresh (.call descriptor .lens 1))
      (check (.call fresh .get base) => #t)
      (def calls 0)
      (.set! descriptor .element? (lambda (_) (set! calls (+ calls 1)) #f))
      (check-exception (.call fresh .get base) (message? "stale set focus"))
      (check-equal? calls 0)
      (def refused (.call descriptor .lens 1))
      (check-exception (.call refused .get base) TypeError?)
      (check-equal? calls 1))
    (test-case "refined algebra failures retain all five style owners for retry"
      (def descriptor (service.make-cohort-access (RationalDict Unit)))
      (def family (set-styles descriptor))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref family name))
        (def left (.call protocol .ap (.call descriptor .<-list '(1 2))))
        (def bad (.call protocol .ap (.call descriptor .<-list '(2 3))))
        (check-exception (.call protocol .union left bad) TypeError?)
        (check-equal? (.call protocol .list<- left) '(1 2))
        (check-equal? (.call protocol .list<- bad) '(2 3))
        (def good (.call protocol .ap (.call descriptor .<-list '(3 4))))
        (def next (.call protocol .union left good))
        (check-equal? (.call protocol .list<- next) '(1 2 3 4))
        (check-equal? (.call protocol .list<- good) '(3 4))))
    (test-case "cohort Function grants compose FUN IO ownership conversion and refusal retry"
      (def type (Fun Integer <- Integer))
      (def functions (map (lambda (offset) (validate type (lambda (n) (+ n offset)))) '(1 2 3 4)))
      (def table (alist-table type Unit))
      (def descriptor (service.make-cohort-access table))
      (def before (.call descriptor .<-list (list (car functions) (cadr functions))))
      (def bad (.call descriptor .<-list (list (cadr functions) (caddr functions))))
      (def good (.call descriptor .<-list (cddr functions)))
      (def calls 0)
      (def consume (lambda (receiver) (set! calls (+ calls 1)) receiver))
      (check-exception ((service.access-style-action descriptor bad before consume) before) TypeError?)
      (check-equal? calls 0)
      (def published ((service.access-style-action descriptor good before consume) before))
      (def leaves (.call descriptor .list<- (@@method published.snapshot)))
      (check-equal? calls 1)
      (check-equal? (length leaves) 2)
      (check (and (memq (caddr functions) leaves) #t) => #t)
      (check (and (memq (cadddr functions) leaves) #t) => #t)
      (for (f leaves) (check (f 10) => (if (eq? f (caddr functions)) 13 14))))
    (test-case "one point-method boundary rejects roots before elements and lazy lookup"
      (def raw (RationalDict Unit))
      (def checks 0) (def lookups 0)
      (def key (.cc Integer .element?: (lambda (x)
        (set! checks (+ checks 1)) (integer? x))))
      (def table (.o (:: @ raw) Key: key
        (.acons (begin (set! lookups (+ lookups 1)) (.@ raw .acons)))
        (.remove (begin (set! lookups (+ lookups 1)) (.@ raw .remove)))))
      (def descriptor (.cc Set<-Table. Table: table))
      (def insert (.@ descriptor .cons)) (def remove (.@ descriptor .remove))
      (check-exception (insert 'bad 'bad-root) TypeError?)
      (check-exception (remove 'bad-root 'bad) TypeError?)
      (check-equal? checks 0) (check-equal? lookups 0)
      (check-exception (insert 1) TypeError?)
      (check-equal? checks 0) (check-equal? lookups 0)
      (def base (.call descriptor .<-list '(1 2)))
      (check-exception (insert 'bad base) TypeError?)
      (check-equal? lookups 0)
      (check-equal? (.call descriptor .list<- (remove (insert 3 base) 1)) '(2 3))
      (check-equal? (.call descriptor .list<- base) '(1 2)))
    (test-case "point methods preserve wrapped Function keys and current element contracts"
      (def type (Fun Integer <- Integer))
      (def f (validate type (lambda (x) (+ x 1))))
      (def g (validate type (lambda (_) "bad")))
      (def descriptor (.cc Set<-Table. Table: (alist-table type Unit)))
      (def before (.call descriptor .singleton f))
      (def after (.call descriptor .cons g before))
      (check (and (memq f (.call descriptor .list<- after)) #t) => #t)
      (check (and (memq g (.call descriptor .list<- after)) #t) => #t)
      (check-exception (g 1) TypeError?)
      (def only (.call descriptor .remove after g))
      (check (eq? (car (.call descriptor .list<- only)) f) => #t)
      (def mutable (.cc Set<-Table. Table: (RationalDict Unit)))
      (def singleton (.@ mutable .singleton))
      (.set! mutable Elt (.cc Integer .element?: (lambda (x) (and (integer? x) (even? x)))))
      (check-exception (singleton 3) TypeError?)
      (check-equal? (.call mutable .list<- (singleton 4)) '(4))
      (def mutating (.cc Integer epoch: 0 .element?: (lambda (x)
        (.set! mutating epoch 1) (integer? x))))
      (.set! mutable Elt mutating)
      (check-exception (singleton 4) (message? "object mutation during computation"))
      (check-equal? (.@ mutating epoch) 0))
    (test-case "set metadata and declared dependencies stay protected through final admission"
      (def raw (RationalDict Unit)) (def dependency (.o epoch: 0))
      (def mutate? #f) (def failure (list 'cohort-refused)) (def fail? #f)
      (def descriptor (.cc Set<-Table. Table: raw .sources: (list dependency)
        .element?: (lambda (root)
          (when mutate? (.set! dependency epoch 1))
          (when fail? (raise failure)) (element? raw root))))
      (def base (.call descriptor .<-list '(1 2)))
      (set! mutate? #t)
      (check-exception (.call descriptor .union base base)
        (message? "object mutation during computation"))
      (check-equal? (.@ dependency epoch) 0)
      (set! mutate? #f) (set! fail? #t)
      (check (eq? (try (.call descriptor .<-list '(3 4)) #f (catch (cause) cause)) failure) => #t)
      (set! fail? #f)
      (check-equal? (.call descriptor .list<- (.call descriptor .union base base)) '(1 2))
      ;; Method lookup itself stays inside admission; flattening the call must
      ;; not move this effectful getter outside the protected dependency scope.
      (def inserting (.o (:: @ raw) (.acons (begin (.set! dependency epoch 2) (.@ raw .acons)))))
      (def guarded (.cc Set<-Table. Table: inserting .sources: (list dependency)))
      (check-exception (.call guarded .cons 3 base) (message? "object mutation during computation"))
      (check-equal? (.@ dependency epoch) 0)
      (def changing (.o (:: @ guarded)
        (Elt (begin (.set! dependency epoch 3) Integer))))
      (check-exception (.call changing .singleton 3) (message? "object mutation during computation"))
      (check-equal? (.@ dependency epoch) 0))))
