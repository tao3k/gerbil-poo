;;; Current qualified versus compact item factories share C3/lenses/FUN/policy code.
(export main workload)
(import :std/iter ../object (prefix-in ../generalized-prototype gp.)
  (prefix-in ../examples/generalized-checkout checkout.)
  (prefix-in ../method-combination combination.) (prefix-in "factory-cases.ss" study.)
  (only-in "closure-measure.ss" run-child))
;; Identical fixed-field projection on both sides, matching the actual public report.
(def (fields view)
  (list (view 'price) (view 'rebate) (view 'service) (view 'tenant) (view 'approved)))
;; Observe raw shape/audits/metadata without forcing method bodies or their caches.
(def (raw-shape raw)
  (def local (.@ (.@ raw billing) checkout))
  (list (length (car local)) (length (cadr local)) (caddr local)
    (.@ (.@ raw billing) service) (.@ raw tenant) (.@ raw approved)))
;; Common setup and warmup order for every side, including exact same A/A closures.
(def (workload scenario)
  (def factories (list checkout.prepare-envelope-items checkout.prepare-envelope))
  (def snapshots (map (lambda (factory) (factory)) factories))
  (def base checkout.envelope-base)
  (def revised (.cc base tenant: 'us))
  (def raw (map (lambda (snapshot) (gp.approximate snapshot base base 2)) snapshots))
  (def cooks (map (lambda (snapshot) (.@ (gp.prepared-protocol snapshot) cook)) snapshots))
  (def readers (map (lambda (snapshot) (gp.bind-context-observer snapshot 2 identity identity)) snapshots))
  (def body (lambda () 7))
  (def qualified-item (combination.item body))
  (unless (= ((.@ qualified-item body)) 7) (error "warm item oracle"))
  (when (eq? scenario 'factory-history)
    (for (_ (in-range 64))
      (unless (equal? (fields ((cadr readers) base)) '(45 3 billing eu #t))
        (error "fixed factory history oracle"))))
  (def actions
    (case scenario
      ((factory factory-history factory-allocation)
       (map (lambda (factory) (lambda () (equal? ((factory) base) '(45 3 billing eu #t))))
         (list checkout.bind-envelope-items-report checkout.bind-envelope-report)))
      ((preparation)
       (map (lambda (factory) (lambda () (gp.Prepared? (factory)))) factories))
      ((binding)
       (map (lambda (snapshot) (lambda ()
         (procedure? (gp.bind-context-observer snapshot 2 identity identity)))) snapshots))
      ((construction construction-allocation)
       (map (lambda (snapshot) (lambda ()
         (equal? (raw-shape (gp.approximate snapshot base base 2)) '(4 1 audit billing eu #t)))) snapshots))
      ((cooking cooking-allocation)
       ;; Raw programs/dependency promises are prepared before timing and warmups.
       ;; This is fresh final cooking with WARM dependent self, not a cold factory.
       (map (lambda (cook state) (lambda () (equal? (fields (cook state)) '(45 3 billing eu #t)))) cooks raw))
      ((item-construct)
       (list (lambda () (procedure? body)) (lambda () (object? (combination.item body)))))
      ((item-cold)
       (list (lambda () (= (body) 7)) (lambda () (= ((.@ (combination.item body) body)) 7))))
      ((item-warm)
       (list (lambda () (= (body) 7)) (lambda () (= ((.@ qualified-item body)) 7))))
      ((revision)
       (map (lambda (reader) (lambda ()
         (and (equal? (fields (reader base)) '(45 3 billing eu #t))
           (equal? (fields (reader revised)) '(45 3 billing us #t))))) readers))
      (else (error "unknown factory scenario" scenario))))
  (list (car actions) (cadr actions) (car actions) (cadr actions)))
;; Validate all request fields before the existing bounded native measurement path.
(def (main scenario-text regime-text side-text)
  (def scenario (string->symbol scenario-text)) (def regime (string->symbol regime-text))
  (def side (string->number side-text))
  (unless (and (memq scenario study.scenarios) (memq regime '(natural collected)) (memv side '(0 1 2 3)))
    (error "invalid factory study request"))
  (run-child scenario regime side (workload scenario) (study.repetitions scenario) 4))
