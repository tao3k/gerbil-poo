(export component-requests-test)
(import :std/test :std/sync/channel ../object ../mop ../brace ../support/option ../feedback-graph ../lens-laws
        (prefix-in ../component-publication publication.) (prefix-in ../construction-cache cache.)
        (prefix-in ../dependency-analysis code.) (prefix-in ../examples/component-requests service.)
        (prefix-in ../examples/component-rounds rounds.))
;; Real materializer counters and pointer identity distinguish reuse from equality.
(def (evaluated current) (cache.cache-evaluated (graph-cache-values current)))
;; Topology-only revisions skip unchanged inputs and independent feedback.
(def builder (.cc cache.Builder. allow: (lambda (key) (not (memq key '(quota spare stable))))))
;; Deterministic interleavings test authoritative installation separately from
;; concurrent staging. They do not certify arbitrary parallel mutable callbacks.
(def component-requests-test
  (test-suite "competing staged component requests and joint approval retry"
    (test-case "two staged requests share old state and first accepted request makes sibling stale"
      (def approvals (service.policies))
      (def owner (service.start approvals))
      (def old (publication.current owner))
      (def reached? #f)
      (def first (service.stage owner 'merge [] approvals builder))
      (def second (service.stage owner 'merge [] approvals
        (.cc cache.Builder. allow: (lambda (_) (set! reached? #t) #f))))
      (check (eq? old (publication.current owner)) => #t)
      (defvalues (winner ok) (publication.submit! owner first))
      (check-equal? ok #f) (check-equal? (service.value winner 'settlement) 24)
      (defvalues (held stale) (publication.submit! owner second))
      (check (eq? held winner) => #t) (check (not (not stale)) => #t) (check-equal? reached? #f)
      (check (eq? (publication.current owner) winner) => #t))
    (test-case "a rival accepted during approval cannot be overwritten by the older candidate"
      (def approvals (service.policies))
      (def owner (service.start approvals))
      (def old (publication.current owner))
      (def rival (service.stage owner 'merge [(cons 'spare (some (code.make-success 5)))] approvals
        (.cc cache.Builder. allow: (lambda (key) (not (memq key '(quota stable)))))))
      (def winner #f)
      (def older (service.stage owner 'merge [] approvals builder extra-admit: (lambda (_ candidate)
        (check-equal? (service.value candidate 'settlement) 24)
        (defvalues (next ok) (publication.submit! owner rival))
        (check-equal? ok #f) (set! winner next) #t)))
      (defvalues (held stale) (publication.submit! owner older))
      (check (eq? held winner) => #t) (check (not (not stale)) => #t)
      (check-equal? (service.value held 'settlement) 30)
      (check-equal? (service.value old 'settlement) 12))
    (test-case "a channel-paused thread loses installation to a sibling on the authoritative head"
      (def approvals (service.policies))
      (def owner (service.start approvals))
      (def ready (make-channel))
      (def resume (make-channel))
      (def result (make-channel))
      (def older (service.stage owner 'merge [] approvals builder extra-admit: (lambda (_ __)
        (channel-put ready 'approved)
        (unless (eq? (channel-get resume 5 'timeout) 'resume) (error "approval resume timed out")) #t)))
      (def rival (service.stage owner 'merge [] approvals builder))
      (def worker (thread-start! (make-thread (lambda ()
        (defvalues (head failure) (publication.submit! owner older))
        (channel-put result (cons head failure))))))
      (check-equal? (channel-get ready 5 'timeout) 'approved)
      (defvalues (winner ok) (publication.submit! owner rival))
      (channel-put resume 'resume)
      (def outcome (channel-get result 5 'timeout))
      (thread-join! worker 5)
      (check-equal? ok #f) (check (pair? outcome) => #t)
      (check (eq? (car outcome) winner) => #t) (check (not (not (cdr outcome))) => #t)
      (check (eq? (publication.current owner) winner) => #t))
    (test-case "an approval exception after a rival commits returns the rival not the request predecessor"
      (def approvals (service.policies))
      (def owner (service.start approvals))
      (def rival (service.stage owner 'merge [] approvals builder))
      (def winner #f)
      (def older (service.stage owner 'merge [] approvals builder extra-admit: (lambda (_ __)
        (defvalues (next ok) (publication.submit! owner rival))
        (check-equal? ok #f) (set! winner next) (error "later service unavailable"))))
      (defvalues (held failure) (publication.submit! owner older))
      (check (not (not failure)) => #t) (check (eq? held winner) => #t)
      (check (eq? (publication.current owner) winner) => #t))
    (test-case "joint rejection keeps head and fresh current-policy preparation can retry"
      (def approvals (service.policies))
      (def owner (service.start approvals))
      (def old (publication.current owner))
      (.putslot! (cadr approvals) 'allowed ($constant-slot-spec #f))
      (def rejected (service.stage owner 'merge [] approvals builder))
      (defvalues (held denied) (publication.submit! owner rejected))
      (check (eq? held old) => #t) (check (not (not denied)) => #t)
      (.putslot! (cadr approvals) 'allowed ($constant-slot-spec #t))
      (defvalues (same obsolete) (publication.submit! owner rejected))
      (check (eq? same old) => #t) (check (not (not obsolete)) => #t)
      (def retry (service.stage owner 'merge [] approvals builder))
      (defvalues (next ok) (publication.submit! owner retry))
      (check-equal? ok #f) (check-equal? (evaluated next) '(shared monitor settlement)))
    (test-case "retry after a rival advances must stage against current topology and approval"
      (def approvals (service.policies))
      (def owner (service.start approvals))
      (def rival (service.stage owner 'merge [] approvals builder))
      (def denied (service.stage owner 'merge [] approvals builder extra-admit: (lambda (_ __) #f)))
      (defvalues (_ refusal) (publication.submit! owner denied))
      (check (not (not refusal)) => #t)
      (defvalues (merged ok) (publication.submit! owner rival))
      (check-equal? ok #f)
      (defvalues (held stale) (publication.submit! owner denied))
      (check (eq? held merged) => #t) (check (not (not stale)) => #t)
      (defvalues (split good) (publication.submit! owner (service.stage owner 'replace [] approvals builder)))
      (check-equal? good #f) (check-equal? (service.value split 'settlement) 16)
      (defvalues (restored fine) (publication.submit! owner (service.stage owner 'restore [] approvals builder)))
      (check-equal? fine #f) (check-equal? (service.value restored 'settlement) 12)
      (defvalues (again obsolete) (publication.submit! owner rival))
      (check (eq? again restored) => #t) (check (not (not obsolete)) => #t))
    (test-case "coordinator ownership and no-op publication also reject stale siblings"
      (def approvals (service.policies))
      (def owner (service.start approvals))
      (def other (publication.publication (publication.current owner)))
      (def request (publication.stage owner [] service.build-group (rounds.admit approvals)
        builder: (.cc cache.Builder. allow: (lambda (_) #f))))
      (defvalues (untouched wrong) (publication.submit! other request))
      (check (eq? untouched (publication.current other)) => #t) (check (not (not wrong)) => #t)
      (defvalues (next ok) (publication.submit! owner request))
      (check-equal? ok #f) (check-equal? (evaluated next) [])
      (defvalues (held stale) (publication.submit! owner request))
      (check (eq? held next) => #t) (check (not (not stale)) => #t))))
