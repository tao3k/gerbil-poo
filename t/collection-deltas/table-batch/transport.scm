;; Keep one admitted callback through Tuple/Pair conversion and revision history.
(def (fixture)
  (service.make-rational-capacity-ledger
    (list (cons 1 (vector 10 (lambda (n) (+ n 1)))))))

;; Capture all intermediate expectations, including a numeric spelling change.
(def (requests source root first second)
  (def f (vector-ref (.call source .ref root first) 1))
  (def a (.call source .delta/opt first (lambda (_) (some (vector 20 f))) root))
  (def b (.call source .delta/opt second (lambda (_) (some (vector 30 f)))
    (.call source .apply-delta root a)))
  (values a b (.call source .compose-deltas (list a b))))

;; Classify protocol failures without accepting a different inverse-law failure.
(def (collision? cause)
  (and (table-isomorphism-failure? cause)
       (eq? (table-isomorphism-failure-kind cause) 'collision)))

;; Exercise snapshot, delta, aggregate and final publication as one protocol unit.
(def table-transport-test
  (test-suite "backend-equivalent isomorphism ownership"
    (test-case "alias revisions retain ordered deltas and both transport directions"
      (def ledger (fixture))
      (def source (.@ ledger source)) (def target (.@ ledger target))
      (def folding (.@ ledger folding))
      (def root (.call folding .unap (.@ ledger state)))
      (def f (vector-ref (.call source .ref root 1) 1))
      (def mapping (table-isomorphism source target (.@ ledger keys) (.@ ledger values)))
      (for-each (lambda (keys)
        (defvalues (a b batch) (requests source root (car keys) (cadr keys)))
        (def staged (.call (.@ mapping Delta) .ap (cons root batch)))
        (check-equal? (table-delta-count (cdr staged)) 2)
        (def installed (.call target .apply-delta (car staged) (cdr staged)))
        (check-equal? (car (.call target .ref installed -1)) 30)
        (check-eq? (cdr (.call target .ref installed -1)) f)
        (check-equal? (car (.call target .ref
          (.call target .apply-delta installed (invert-table-delta (cdr staged))) -1)) 10)
        (def recovered (.call (.@ mapping Delta) .unap staged))
        (check-equal? (table-delta-count (cdr recovered)) 2)
        (check-equal? (vector-ref (.call source .ref
          (.call source .apply-delta (car recovered) (cdr recovered)) 1) 0) 30))
        '((1 1.0) (1.0 1))))
    (test-case "aggregate transfer reuses totals through deletion alias reinsertion and undo"
      (def ledger (fixture)) (def source (.@ ledger source))
      (def target (.@ ledger target)) (def folding (.@ ledger folding))
      (def bridge (.@ ledger transport)) (def derived (.@ bridge Codomain))
      (def state (.@ ledger state)) (def root (.call folding .unap state))
      (def paired (.call bridge .ap state))
      (def f (vector-ref (.call source .ref root 1) 1))
      (def remove (.call source .delta/opt 1 (lambda (_) #f) root))
      (def insert (.call source .delta/opt 1.0 (lambda (_) (some (vector 40 f)))
        (.call source .apply-delta root remove)))
      (def batch (.call source .compose-deltas (list remove insert)))
      (def effects 0)
      (def action (service.batch-ledger-action source bridge state
        (lambda (next) (set! effects (+ effects 1)) next)))
      (def next (action (list remove insert)))
      (check-equal? effects 1)
      (check-equal? (.call derived .get next) 40)
      (check-eq? (cdr (.call target .ref (.call derived .unap next) -1)) f)
      (def restored (.call bridge .apply-delta (.call bridge .unap next) (invert-table-delta batch)))
      (check-equal? (.call derived .get restored) 10)
      (check-equal? (.call derived .get paired) 10))
    (test-case "full service publication uses every presentation after alias transport"
      (def ledger (fixture)) (def source (.@ ledger source))
      (def target (.@ ledger target)) (def root (.call (.@ ledger folding) .unap (.@ ledger state)))
      (def mapping (table-isomorphism source target (.@ ledger keys) (.@ ledger values)))
      (defvalues (a b batch) (requests source root 1 1.0))
      (def effects 0)
      (def action (service.transport-ledger-action mapping
        (lambda (value) (set! effects (+ effects 1)) value)))
      (def published (action (cons root batch)))
      (check-equal? effects 1)
      (for-each (lambda (name)
        (def style (.ref (table-styles target) name))
        (def owner (.call style .ap published))
        (check-equal? (car (.call style .ref owner -1)) 30))
        '(Pure Mutable Linear Posh Classy)))
    (test-case "source conflicts suppress conversion and allow explicit rediscovery"
      (def ledger (fixture)) (def source (.@ ledger source))
      (def root (.call (.@ ledger folding) .unap (.@ ledger state)))
      (def calls 0) (def effects 0)
      (def keys (.cc (.@ ledger keys) .ap: (lambda (key) (set! calls (+ calls 1)) (- key))))
      (def mapping (table-isomorphism source (.@ ledger target) keys (.@ ledger values)))
      (defvalues (a b batch) (requests source root 1 1.0))
      (def action (service.transport-ledger-action mapping (lambda (value) (set! effects (+ effects 1)) value)))
      (check-exception (action (cons root (.call source .compose-deltas (list a a)))) table-conflict?)
      (check-equal? calls 0) (check-equal? effects 0)
      (check-equal? (car (.call (.@ ledger target) .ref (action (cons root batch)) -1)) 30)
      (check-equal? effects 1))
    (test-case "distinct logical owners still refuse a collapsing target map before inverse checks"
      (def source (RationalDict Integer)) (def target (RationalDict Integer))
      (def keys (.cc Wrapper. Domain: (.@ source Key) Codomain: (.@ target Key)
        .ap: abs .unap: identity))
      (def values (.cc Wrapper. Domain: Integer Codomain: Integer .ap: identity .unap: identity))
      (def mapping (table-isomorphism source target keys values))
      (def root (.call source .<-list '((1 . 10))))
      (def batch (.call source .delta/opt -1 (lambda (_) (some 20)) root))
      (check-exception (.call (.@ mapping Delta) .ap (cons root batch)) collision?)
      (def remove (.call source .delta/opt 1 (lambda (_) #f) root))
      (def insert (.call source .delta/opt -1 (lambda (_) (some 20))
        (.call source .apply-delta root remove)))
      (check-exception (.call (.@ mapping Delta) .ap
        (cons root (.call source .compose-deltas (list remove insert)))) collision?))
    (test-case "changed source key registry refuses the probe and fresh retry succeeds"
      (def raw (RationalDict Integer)) (def probe #f) (def interfere? #t)
      (def source (.cc raw .key-table: (lambda (value)
        (def registry (table-key-space raw value))
        (when (eq? value Unit) (set! probe registry)) registry)))
      (def target (RationalDict Integer))
      (def keys (.cc Wrapper. Domain: (.@ source Key) Codomain: (.@ target Key)
        .ap: (lambda (key) (when (and interfere? probe) (.set! probe sexp 'changed)) key)
        .unap: identity))
      (def values (.cc Wrapper. Domain: Integer Codomain: Integer .ap: identity .unap: identity))
      (def mapping (table-isomorphism source target keys values))
      (def root (.call source .<-list '((1 . 10))))
      (def delta (.call source .delta/opt 1.0 (lambda (_) (some 20)) root))
      (def effects 0)
      (def action (service.transport-ledger-action mapping
        (lambda (root) (set! effects (+ effects 1)) root)))
      (check-exception (action (cons root delta))
        (lambda (cause) (and (Error? cause) (equal? (Error-message cause) "stale table key registry"))))
      (check-equal? effects 0)
      (set! interfere? #f)
      (check-equal? (.call target .ref (action (cons root delta)) 1) 20)
      (check-equal? effects 1))
    (test-case "physical inverse checks remain strict even for logically equivalent recovered keys"
      (def source (RationalDict Integer)) (def target (RationalDict Integer))
      (def keys (.cc Wrapper. Domain: (.@ source Key) Codomain: (.@ target Key)
        .ap: identity .unap: (lambda (_) 1.0)))
      (def values (.cc Wrapper. Domain: Integer Codomain: Integer .ap: identity .unap: identity))
      (def mapping (table-isomorphism source target keys values))
      (check-exception (.call mapping .ap (.call source .<-list '((1 . 10))))
        (lambda (cause) (and (table-isomorphism-failure? cause)
          (eq? (table-isomorphism-failure-kind cause) 'left-inverse)))))))
