;;; Collection factories own finite origin declarations before metadata discovery.
(export table-origins-test)
(import :std/test :std/error :std/iter :clan/poo/object :clan/poo/mop :clan/poo/type :clan/poo/number :clan/poo/table
        :clan/poo/rationaldict :clan/poo/support/option (only-in :clan/poo/fun Wrapper.)
        (only-in :clan/poo/t/table-testing alist-table)
        (only-in :clan/poo/support/base number-comparer)
        (prefix-in :clan/poo/examples/service-collection service.))

;; Distinguish stale admission from a failing user callback or a backend error.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; The descriptor getter deliberately recycles the caller's origin buffer. Each
;; family still has to retain its original declared dependency and typed roots.
(def (factory-fixture kind origins replacement)
  (def raw (RationalDict Integer))
  (def source (.o (:: @ raw) (Value (begin (set-car! origins replacement) Integer))))
  (def target (RationalDict Integer))
  (def left (.call raw .<-list '((1 . 10))))
  (def right (.call raw .<-list '((7 . 70))))
  (case kind
    ((projection) (values
      (table-projection source target (lambda (key row) (some (cons key row))) origins) left))
    ((fold) (values
      (table-group-fold source target Integer (lambda (_key _row) 0) (lambda (_key row) row) origins) left))
    ((lookup) (values
      (table-lookup-join source raw target (lambda (_key _row) 7)
        (lambda (key row _found) (some (cons key row))) origins) (cons left right)))
    ((group) (values
      (table-group-join source raw target (RationalDict Unit)
        (alist-table (Pair (.@ raw Key) (.@ raw Key)) Unit)
        (lambda (_key _row) 0) (lambda (_key _row) 0)
        (lambda (lk lv rk rv) (some (cons (+ lk rk) (+ lv rv)))) origins) (cons left right)))
    ((combination) (values
      (table-combination source raw target (lambda (_key l r) (or l r)) origins) (cons left right)))
    ((image) (let ()
      (def backing (RationalDict Unit))
      (def set-source (.o (:: @ Set<-Table.) (Table (begin (set-car! origins replacement) backing))))
      (def set-target (.cc Set<-Table. Table: (RationalDict Unit)))
      (values (set-image set-source set-target identity origins)
        (.call backing .<-list (list (cons 1 (void)))))))))

;; Recycled descriptor declarations must remain owned before either getter runs.
(def (set-origin-fixture phase)
  (def policy (.o epoch: 0)) (def replacement (.o epoch: 0))
  (def origins (list policy)) (def raw (RationalDict Unit))
  (def descriptor (.o (:: @ Set<-Table.) .sources: origins
    (Table (begin (when (eq? phase 'Table) (set-car! origins replacement)) raw))
    (Elt (begin (when (eq? phase 'Elt) (set-car! origins replacement)) Rational))))
  (values descriptor (.call raw .singleton 1 (void)) policy replacement))

;; Existing protocols supply retained reads; the fixture adds no collection engine.
(def (retained-set-read kind descriptor root)
  (case kind
    ((focus) (let (focus (.call descriptor .lens 1)) (cut .call focus .get root)))
    ((cursor) (let (cursor (.call descriptor .iter<- root))
      (lambda () (using (cursor :- Iterator) (cursor.next!)))))
    ((image combination) (let ()
     (def target (.cc Set<-Table. Table: (RationalDict Unit)))
     (def view (if (eq? kind 'image) (set-image descriptor target identity)
       (set-combination descriptor target target 'union)))
     (def state (.call view .ap (if (eq? kind 'image) root (cons root root))))
     (cut .call view .get state)))
    ((styles) (let ()
     (def family (set-styles descriptor))
     (def owners (map (lambda (name)
       (def protocol (.ref family name)) (cons protocol (.call protocol .ap root)))
       '(Pure Mutable Linear Posh Classy)))
     (lambda () (map (lambda (entry) (.call (car entry) .unap (cdr entry))) owners))))))

;; One test unit covers preparation, retained stamps, delayed reads and retry.
(def table-origins-test
  (test-suite "owned collection dependency declarations"
    (test-case "independent Elt revisions invalidate both focus accessors and repeated cursor EOF"
      (def raw (RationalDict Unit)) (def reads 0)
      (def element (.cc Integer epoch: 0 .element?: (lambda (n) (set! reads (+ reads 1)) (integer? n))))
      (def descriptor (.cc Set<-Table. Table: raw Elt: element))
      (def root (.call raw .singleton 1 (void)))
      (def focus (.call descriptor .lens 1))
      (def cursor (.call descriptor .iter<- (.@ raw .empty)))
      (using (cursor :- Iterator) (check-eq? (cursor.next!) #!eof))
      (.set! element epoch 1) (set! reads 0)
      (check-exception (.call focus .get root) (message? "stale set focus"))
      (check-exception (.call focus .set #f root) (message? "stale set focus"))
      (using (cursor :- Iterator) (check-exception (cursor.next!) (message? "stale set iterator")))
      (check-equal? reads 0)
      (check (.call (.call descriptor .lens 1) .get root) => #t)
      (check-equal? (.call descriptor .list<- root) '(1)))
    (test-case "all retained Set families capture declared origins before Table and Elt getters"
      (for (phase '(Table Elt))
        (for (kind '(focus cursor image combination styles))
          (defvalues (descriptor root policy replacement) (set-origin-fixture phase))
          (def read (retained-set-read kind descriptor root))
          ;; Equal initial stamps do not make the replacement the same origin.
          (.set! replacement epoch 1)
          (read)
          (.set! policy epoch 1)
          (check-exception (read) Error?)
          (def fresh (.cc descriptor .sources: (list policy)))
          ((retained-set-read kind fresh root)))))
    (test-case "eager Set admission protects original declared policies before metadata and user effects"
      (for (phase '(Table Elt))
        (defvalues (descriptor root policy _replacement) (set-origin-fixture phase))
        (def calls 0)
        (check-exception (.call descriptor .for-each
          (lambda (_) (set! calls (+ calls 1)) (.set! policy epoch 1)) root) Error?)
        (check-equal? calls 1) (check-equal? (.@ policy epoch) 0)
        (.set! policy epoch 1)
        (check-equal? (.call descriptor .foldl + 0 root) 1)))
    (test-case "Set metadata preparation refuses original-policy edits and restores its scope for retry"
      (for (phase '(Table Elt))
        (def policy (.o epoch: 0)) (def raw (RationalDict Unit)) (def fail? #t)
        (def descriptor (.o (:: @ Set<-Table.) .sources: (list policy)
          (Table (begin (when (and fail? (eq? phase 'Table)) (.set! policy epoch 1)) raw))
          (Elt (begin (when (and fail? (eq? phase 'Elt)) (.set! policy epoch 1)) Rational))))
        (check-exception (.call descriptor .lens 1) Error?)
        (check-equal? (.@ policy epoch) 0)
        (.set! policy epoch 2) (set! fail? #f)
        (def focus (.call descriptor .lens 1))
        (check (.call focus .get (.call raw .singleton 1 (void))) => #t)))
    (test-case "malformed Set origins refuse before Table discovery"
      (def calls 0)
      (def descriptor (.o (:: @ Set<-Table.) .sources: 'invalid
        (Table (begin (set! calls (+ calls 1)) (RationalDict Unit)))))
      (check-exception (.call descriptor .lens 1) ContractViolation?)
      (check-equal? calls 0)
      ;; Preserve the existing Unit obligation before discovering independent Elt.
      (def nonunit (.o (:: @ Set<-Table.) Table: (RationalDict Integer)
        (Elt (begin (set! calls (+ calls 1)) Rational))))
      (check-exception (.call nonunit .lens 1) (message? "set algebra requires Unit values"))
      (check-equal? calls 0))
    (test-case "Function access image publication retries with fresh declared policy and inverse delivery in five styles"
      (def signature (Fun Integer <- Integer))
      (def procedure-type (.cc Type. .element?: procedure?))
      (def raw (alist-table procedure-type Unit))
      (def target (.cc Set<-Table. Table: (alist-table signature Unit)))
      (def f (validate signature (lambda (n) (+ n 1))))
      (def g (validate signature (lambda (n) (* n 2))))
      (def policy (.o epoch: 0)) (def replacement (.o epoch: 0)) (def origins (list policy))
      (def source (.o (:: @ Set<-Table.) .sources: origins Elt: signature
        (Table (begin (set-car! origins replacement) raw))))
      (def before (.call raw .singleton f (void)))
      (def additions (.call raw .singleton g (void))) (def removals (.@ raw .empty))
      (def image (set-image source target identity)) (def initial (.call image .ap before))
      (.set! policy epoch 1)
      (def fresh-source (.cc source .sources: (list policy)))
      (def fresh (set-image fresh-source target identity)) (def state (.call fresh .ap before))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (set-styles target) name)) (def effects 0)
        (def owner (.call protocol .ap (.call fresh .get state)))
        (def consume (lambda (_) (set! effects (+ effects 1))))
        (def old (service.publish-access-image-action image source additions removals protocol consume))
        (check-exception (old (.o state: initial target: owner)) (message? "stale set image"))
        (check-equal? effects 0)
        (check-equal? (.call protocol .count owner) 1)
        (def action (service.publish-access-image-action fresh fresh-source additions removals protocol consume))
        (def published (action (object<-alist (list (cons 'state state) (cons 'target owner)))))
        (check-equal? effects 1)
        (def current (.@ published target))
        (check-equal? (.call protocol .count current) 2)
        (def grants (.call protocol .list<- current))
        (check (and (memq f grants) (memq g grants) #t) => #t)
        (check-exception (g "invalid") TypeError?)
        (def restored (.call protocol .apply-delta current (invert-table-delta (.@ published delta))))
        (check (eq? (.call protocol .choose restored) f) => #t)
        (check (eq? (.call fresh-source .choose before) f) => #t)))
    (test-case "comparer dependencies survive caller buffer reuse and delayed wrapper reads"
      (def policy (.o direction: 1)) (def replacement (.o direction: 1))
      (check-equal? (object-revision policy) (object-revision replacement))
      (def dependencies (list policy)) (def comparisons 0)
      (def compare (lambda (a b)
        (set! comparisons (+ comparisons 1)) (* (.@ policy direction) (number-comparer a b))))
      (def comparer (table-comparer Rational compare dependencies equal?: =))
      (set-car! dependencies replacement)
      (def raw (RationalDict Integer)) (def ordered (table-order raw comparer))
      (def root (.call raw .<-list '((1 . 10) (2 . 20) (3 . 30))))
      (def keys (.cc Wrapper. Domain: Rational Codomain: Rational .ap: - .unap: -))
      (def transported (table-comparer-wrapper comparer keys))
      (def cursor (.call ordered .range<- root (some 1) (some 3)))
      (.set! policy direction -1)
      (set! comparisons 0)
      (check-exception (.call comparer .compare 1 2) (message? "stale table comparer"))
      (check-exception (.call transported .compare -1 -2) (message? "stale table comparer"))
      (using (cursor :- Iterator) (check-exception (cursor.next!) Error?))
      (check-equal? comparisons 0)
      (def fresh (table-order raw (table-comparer Rational compare (list policy) equal?: =)))
      (check-equal? (.call fresh .range root #f #f) '((3 . 30) (2 . 20) (1 . 10))))
    (test-case "inherited origin buffers cannot detach retained focuses or deltas"
      (def policy (.o revision: 0)) (def replacement (.o revision: 0))
      (def origins (list policy)) (def reads 0)
      (def raw (RationalDict Bool))
      (def source (.cc raw .sources: origins .element?: (lambda (root)
        (set! reads (+ reads 1)) (element? raw root))))
      (def root (.call raw .<-list '((1 . #f))))
      (def focus (.call source .lens/opt 1))
      (def delta (.call source .delta/opt 1 (lambda (_) (some #t)) root))
      (set-car! origins replacement)
      (.set! policy revision 1)
      (set! reads 0)
      (check-exception (.call focus .get root) (message? "stale table focus"))
      (check-exception (.call raw .apply-delta root delta) (message? "stale or incompatible table delta"))
      (check-equal? reads 0)
      (check-equal? (.call (.call source .lens/opt 1) .get root) (some #f)))
    (test-case "declared origins are captured before later Key getters recycle their buffer"
      (def policy (.o revision: 0)) (def replacement (.o revision: 0))
      (def origins (list policy))
      (def raw (RationalDict Bool))
      (def source (.o (:: @ raw) .sources: origins
        (Key (begin (set-car! origins replacement) Rational))))
      (def root (.call raw .<-list '((1 . #f))))
      (def focus (.call source .lens/opt 1))
      (.set! policy revision 1)
      (check-exception (.call focus .get root) (message? "stale table focus")))
    (test-case "all origin-accepting families snapshot before descriptor getters"
      (for (kind '(projection fold lookup group combination image))
        (def policy (.o revision: 0)) (def replacement (.o revision: 0))
        (def origins (list policy))
        (defvalues (view root) (factory-fixture kind origins replacement))
        (check-equal? (and (memq policy (.@ view .sources)) #t) #t)
        (check-equal? (memq replacement (.@ view .sources)) #f)
        (def state (.call view .ap root))
        (.set! policy revision 1)
        (check-exception (.call view .get state) Error?)))
    (test-case "declared origin objects are protected while descriptor discovery runs"
      (def policy (.o revision: 0))
      (def raw (RationalDict Integer))
      (def source (.o (:: @ raw) .sources: (list policy)
        (Key (begin (.set! policy revision 1) Rational))))
      (check-exception (.call source .lens/opt 1) Error?)
      (check-equal? (.@ policy revision) 0)
      ;; Explicit origins need the same protection even for the Set/Table getter.
      (def set-source (.o (:: @ Set<-Table.)
        (Table (begin (.set! policy revision 1) (RationalDict Unit)))))
      (def target (.cc Set<-Table. Table: (RationalDict Unit)))
      (check-exception (set-image set-source target identity (list policy)) Error?)
      (check-equal? (.@ policy revision) 0))
    (test-case "malformed origin spines refuse before metadata callbacks"
      (def calls 0)
      (def source (.o (:: @ (RationalDict Integer))
        (Value (begin (set! calls (+ calls 1)) Integer))))
      (def target (RationalDict Integer))
      (check-exception (table-projection source target (lambda (key row) (some (cons key row))) 'bad)
        ContractViolation?)
      (check-equal? calls 0)
      (def cyclic (list (.o revision: 0))) (set-cdr! cyclic cyclic)
      (check-exception (table-comparer Rational number-comparer cyclic) ContractViolation?)
      (check-equal? calls 0))
    (test-case "policy fold refuses stale publication and retries with inverse restoration"
      (def policy (.o weight: 2))
      (def signature (Fun Integer <- Integer))
      (def callback (validate signature (lambda (n) (+ n 1))))
      (def source (RationalDict (Tuple Integer Integer signature)))
      (def target (RationalDict Integer))
      (def before (.call source .<-list (list (cons 1 (vector 7 10 callback)))))
      (def after (.call source .acons 2 (vector 7 20 callback) before))
      (def delta (.call source .diff before after))
      (def folding (service.make-policy-capacity-fold source target policy))
      (def state (.call folding .ap before))
      (def effects 0)
      (.set! policy weight 3)
      (check-exception ((service.fold-ledger-action folding state
        (lambda (_) (set! effects (+ effects 1)))) delta) Error?)
      (check-equal? effects 0)
      (def fresh (service.make-policy-capacity-fold source target policy))
      (def initial (.call fresh .ap before))
      (def updated ((service.fold-ledger-action fresh initial
        (lambda (next) (set! effects (+ effects 1)) next)) delta))
      (check-equal? effects 1)
      (check-equal? (.call target .ref (.call fresh .get updated) 7) 90)
      (def restored (.call fresh .apply-delta updated (invert-table-delta delta)))
      (check-equal? (.call target .ref (.call fresh .get restored) 7) 30)
      (check-eq? (vector-ref (.call source .ref (.call fresh .unap restored) 1) 2) callback))
    (test-case "retained empty-delta origins protect every style and suppress stale publication"
      (def policy (.o revision: 0)) (def replacement (.o revision: 0))
      (def origins (list policy))
      (def signature (Fun Integer <- Integer))
      (def f (validate signature (lambda (n) (+ n 1))))
      (def raw (RationalDict signature))
      (def source (.cc raw .sources: origins))
      (def root (.call raw .<-list (list (cons 1 f))))
      (def empty (.call source .diff root root))
      (set-car! origins replacement)
      (.set! policy revision 1)
      (def effects 0)
      (for (name '(Pure Mutable Linear Posh Classy))
        (def style (.ref (table-styles raw) name)) (def owner (.call style .ap root))
        (check-exception (.call style .apply-delta owner empty) Error?)
        (check-eq? (.call style .ref owner 1) f))
      (def indexed (table-indexes raw []))
      (def indexed-root (.call indexed .wrap root))
      (check-exception (service.apply-indexed-revision indexed
        indexed-root empty
        (lambda (_) (set! effects (+ effects 1)))) Error?)
      (check-equal? effects 0)
      (def fresh (.call source .delta/opt 1 (lambda (_) (some f)) root))
      (check-equal? (table-delta-count fresh) 0)
      (check-eq? (.call raw .ref (.call raw .apply-delta root fresh) 1) f))))
