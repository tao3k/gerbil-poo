;;; Delta capture owns borrowed Option shells, while retaining admitted leaves.
(export table-capture-test)
(import :std/test :std/error :std/iter :clan/poo/object :clan/poo/mop :clan/poo/type :clan/poo/number :clan/poo/table
        :clan/poo/rationaldict :clan/poo/support/option (only-in :clan/poo/t/table-testing alist-table borrowing-table)
        (prefix-in :clan/poo/examples/service-collection service.))

;; Match protocol errors without accepting an unrelated callback exception.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; Cover producer reuse, validation interference and downstream publication.
(def table-capture-test
  (test-suite "owned table change capture"
    (test-case "batch joins own request cells before metadata discovery and root admission"
      (def raw (RationalDict Integer))
      (def a (.call raw .singleton 1 10)) (def b (.call raw .singleton 2 20))
      (def replacement (.call raw .singleton 2 90))
      (for (metadata? '(#f #t))
        (def requests (list a b))
        (def table (if metadata?
          (.o (:: @ raw) (Key (begin (set-car! (cdr requests) replacement) Rational)))
          (.cc raw .element?: (lambda (root)
            (set-car! (cdr requests) replacement) (element? raw root)))))
        (check-equal? (.call raw .list<- (.call table .join/list requests)) '((1 . 10) (2 . 20)))
        (check-eq? (cadr requests) replacement)))
    (test-case "captured invalid batch roots cannot be repaired by an earlier recognizer"
      (def raw (RationalDict Integer)) (def a (.call raw .singleton 1 10))
      (def requests (list a 'invalid))
      (def table (.cc raw .element?: (lambda (root)
        (set-car! (cdr requests) a) (element? raw root))))
      (check-exception (.call table .join/list requests) TypeError?)
      (check-eq? (cadr requests) a))
    (test-case "delta batches own repeated requests before descriptor getters replace cells"
      (def raw (RationalDict Integer))
      (def base (.call raw .singleton 1 0)) (def first (.call raw .singleton 1 10))
      (def final (.call raw .singleton 1 20)) (def other (.call raw .singleton 1 90))
      (def one (.call raw .diff base first)) (def two (.call raw .diff first final))
      (def replacement (.call raw .diff first other))
      (def requests (list one two))
      (def table (.o (:: @ raw) (Key (begin (set-car! (cdr requests) replacement) Rational))))
      (def batch (.call table .compose-deltas requests))
      (check-equal? (table-delta-count batch) 2)
      (check-eq? (cadr requests) replacement)
      (def installed (.call raw .apply-delta base batch))
      (check-equal? (.call raw .list<- installed) '((1 . 20)))
      (check-equal? (.call raw .list<- (.call raw .apply-delta installed (invert-table-delta batch))) '((1 . 0)))
      (check-exception (.call raw .apply-delta other batch) table-conflict?))
    (test-case "five style batch joins capture owner identities before admission and retain right owners"
      (for (name '(Pure Mutable Linear Posh Classy))
        (def raw (RationalDict Integer)) (def requests #f) (def armed? #f)
        (def table (.cc raw .element?: (lambda (root)
          (when armed? (set-car! requests 'foreign)) (element? raw root))))
        (def protocol (.ref (table-styles table) name))
        (def a (.call protocol .ap (.call raw .singleton 1 10)))
        (def b (.call protocol .ap (.call raw .singleton 2 20)))
        (set! requests (list a b b)) (set! armed? #t)
        (def joined (.call protocol .join/list a requests))
        (set! armed? #f)
        (check-equal? (.call protocol .list<- joined) '((1 . 10) (2 . 20)))
        (check-equal? (.call protocol .list<- b) '((2 . 20)))
        (check-eq? (car requests) 'foreign)))
    (test-case "captured foreign owners refuse without a commit and a fresh valid batch retries"
      (for (name '(Mutable Linear Classy))
        (def raw (RationalDict Integer)) (def requests #f) (def valid #f) (def armed? #f)
        (def table (.cc raw .element?: (lambda (root)
          (when armed? (set-car! requests valid)) (element? raw root))))
        (def protocol (.ref (table-styles table) name))
        (def base (.call raw .singleton 1 10)) (def owner (.call protocol .ap base))
        (set! valid (.call protocol .ap (.call raw .singleton 2 20)))
        (set! requests (list 'foreign)) (set! armed? #t)
        (check-exception (.call protocol .join/list owner requests) Error?)
        (set! armed? #f)
        (check-eq? (.call protocol .unap owner) base)
        (set! requests (list valid))
        (check-equal? (.call protocol .list<- (.call protocol .join/list owner requests)) '((1 . 10) (2 . 20)))))
    (test-case "captured batches compose indexed swap fold publication refusal retry and inverse"
      (def function (Fun Integer <- Integer))
      (def callback (validate function (lambda (n) (+ n 1))))
      (def source (RationalDict (Tuple Integer function)))
      (def indexed (table-indexes source (list (.cc Type. name: 'rank
        table: (RationalDict Rational) unique?: #t project: (lambda (_ row) (vector-ref row 0))))))
      (def a (.call indexed .<-list (list (cons 1 (vector 10 callback)))))
      (def b (.call indexed .<-list (list (cons 2 (vector 20 callback)))))
      (def policy (.o epoch: 0)) (def requests (list a b))
      (def table (.cc indexed .element?: (lambda (root)
        (set-car! (cdr requests) a) (element? indexed root))))
      (def effects 0)
      (def joined ((service.join-ledger-action table (lambda (root)
        (set! effects (+ effects 1)) root)) requests))
      (check-equal? effects 1)
      (check-equal? (.call indexed .index-ref/opt joined 'rank 20) (some 2))
      (def raw (.call source .<-list (list (cons 1 (vector 10 callback)) (cons 2 (vector 20 callback)))))
      (def swapped (.call source .<-list (list (cons 1 (vector 20 callback)) (cons 2 (vector 10 callback)))))
      (def delta (.call source .diff raw swapped))
      (def folding (table-fold indexed Integer (lambda (_ row) (vector-ref row 0)) (list policy)))
      (def state (.call folding .ap joined))
      (def batches (list delta (invert-table-delta delta)))
      (def view (.o (:: @ indexed) (Key (begin (set-car! (cdr batches) delta) Rational))))
      (def action (service.batch-ledger-action view folding state (lambda (next)
        (set! effects (+ effects 1)) next)))
      (def roundtrip (action batches))
      (check-equal? (.call folding .get roundtrip) 30) (check-equal? effects 2)
      (check-eq? (vector-ref (.call indexed .ref (.call folding .unap roundtrip) 1) 1) callback)
      (def conflict (list delta delta))
      (check-exception (action conflict) table-conflict?)
      (check-equal? effects 2)
      (def retry (action (list delta (invert-table-delta delta))))
      (check-equal? (.call folding .get retry) 30)
      (.set! policy epoch 1)
      (check-exception (action []) Error?)
      (check-equal? effects 3))
    (test-case "generic diff owns reused lookup shells through compose and inverse"
      (def raw (RationalDict Bool)) (def shell (some #f))
      (def source (borrowing-table raw shell))
      (def before (.call raw .<-list '((1 . #f) (2 . #t) (3 . #f))))
      (def after (.call raw .<-list '((1 . #t) (2 . #f) (4 . #f))))
      (def delta (.call source .diff before after))
      (some-value-set! shell 'poison)
      (check-equal? (table-delta-count delta) 4)
      (def installed (.call raw .apply-delta before delta))
      (check-equal? (.call raw .list<- installed) (.call raw .list<- after))
      (check-equal? (.call raw .list<- (.call raw .apply-delta installed (invert-table-delta delta)))
        (.call raw .list<- before))
      (check-equal? (.call raw .list<- (.call raw .apply-delta before
        (.call raw .compose-deltas (list delta (invert-table-delta delta))))) (.call raw .list<- before)))
    (test-case "point callbacks cannot overwrite a borrowed old expectation"
      (def raw (RationalDict Bool)) (def source (borrowing-table raw))
      (def before (.call raw .<-list '((1 . #f) (9 . #t))))
      (def delta (.call source .delta/opt 1 (lambda (_)
        (.call source .ref/opt before 9) (some #t)) before))
      (check-equal? (table-delta-count delta) 1)
      (def installed (.call raw .apply-delta before delta))
      (check-equal? (.call raw .ref installed 1) #t)
      (check-equal? (.call raw .ref (.call raw .apply-delta installed (invert-table-delta delta)) 1) #f))
    (test-case "point responses are captured before the value recognizer runs"
      (def response (some #t)) (def armed? #f)
      (def value-type (.cc Bool .element?: (lambda (value)
        (when armed? (some-value-set! response #f)) (boolean? value))))
      (def source (RationalDict value-type))
      (def before (.call source .<-list '((1 . #f))))
      (def delta (.call source .delta/opt 1 (lambda (_) (set! armed? #t) response) before))
      (set! armed? #f)
      (check-equal? (table-delta-count delta) 1)
      (check-equal? (.call source .ref (.call source .apply-delta before delta) 1) #t))
    (test-case "diff captures both event shells before key recognition"
      (def old (some #f)) (def next (some #t)) (def armed? #f)
      (def key-type (.cc Rational .element?: (lambda (key)
        (when armed? (some-value-set! old #t) (some-value-set! next #f)) (rational? key))))
      (def source (.cc (RationalDict Bool) Key: key-type
        .for-each-change: (lambda (emit _before _after)
          (set! armed? #t) (emit 1 old next) (set! armed? #f))))
      (def before (.call source .<-list '((1 . #f))))
      (def after (.call source .<-list '((1 . #t))))
      (def delta (.call source .diff before after))
      (check-equal? (.call source .ref (.call source .apply-delta before delta) 1) #t)
      (check-equal? (.call source .ref (.call source .apply-delta after (invert-table-delta delta)) 1) #f))
    (test-case "streamed Function rows retain wrappers through transport fold and every style"
      (def ledger (service.make-rational-capacity-ledger
        (list (cons 1 (vector 10 (lambda (n) (+ n 1))))
              (cons 2 (vector 20 (lambda (n) (+ n 2)))))))
      (def raw (.@ ledger source)) (def folding (.@ ledger folding))
      (def before (.call folding .unap (.@ ledger state)))
      (def f (vector-ref (.call raw .ref before 1) 1))
      (def g (vector-ref (.call raw .ref before 2) 1))
      (def after (.call raw .acons 2 (vector 22 g) (.call raw .acons 1 (vector 11 f) before)))
      (def old (some #f)) (def next (some #f))
      (def source (.cc raw .for-each-change: (lambda (emit a b)
        (for-each (lambda (key)
          (some-value-set! old (.call raw .ref a key))
          (some-value-set! next (.call raw .ref b key)) (emit key old next)) '(1 2))
        (some-value-set! old 'poison) (some-value-set! next 'poison))))
      (def delta (.call source .diff before after))
      (def target (.@ ledger target)) (def effects 0)
      (def action (service.prepare-ledger-transport source target (.@ ledger keys) (.@ ledger values)
        (lambda (root) (set! effects (+ effects 1)) root)))
      (def published (action (cons before delta)))
      (check-equal? effects 1)
      (for-each (lambda (name)
        (def style (.ref (table-styles target) name)) (def owner (.call style .ap published))
        (check-equal? (car (.call style .ref owner -1)) 11)
        (check-eq? (cdr (.call style .ref owner -1)) f)
        (check-eq? (cdr (.call style .ref owner -2)) g)) '(Pure Mutable Linear Posh Classy))
      (def updated (.call folding .apply-delta (.@ ledger state) delta))
      (check-equal? (.call folding .get updated) 33)
      (check-equal? (.call folding .get (.call folding .apply-delta updated (invert-table-delta delta))) 30)
      (check-eq? (vector-ref (.call raw .ref (.call folding .unap updated) 1) 1) f))
    (test-case "malformed event tails refuse before installation and retry publishes once"
      (for-each (lambda (failure)
        (def mode failure) (def installs 0) (def effects 0)
        (def raw (RationalDict Bool))
        (def source (.cc raw .apply-delta: (lambda (root delta)
          (set! installs (+ installs 1)) (.call raw .apply-delta root delta))
          .for-each-change: (lambda (emit _before _after)
            (emit 1 (some #f) (some #t))
            (emit (if (eq? mode 'key) 'bad 2) (some #f)
              (case mode ((option) 'bad) ((value) (some 'bad)) (else (some #t)))))))
        (def indexed (table-indexes source []))
        (def before (.call raw .<-list '((1 . #f) (2 . #f))))
        (def after (.call raw .<-list '((1 . #t) (2 . #t))))
        (def state (.call indexed .wrap before))
        (def publish (lambda () (service.revise-indexed-services indexed source state
          (lambda (_) after) (lambda (root) (set! effects (+ effects 1)) root))))
        (check-exception (publish) (if (eq? failure 'option)
          (message? "table update must return Option") TypeError?))
        (check-equal? installs 0) (check-equal? effects 0)
        (check-equal? (.call indexed .list<- state) (.call raw .list<- before))
        (set! mode 'valid)
        (check-equal? (.call indexed .list<- (publish)) (.call raw .list<- after))
        (check-equal? installs 1) (check-equal? effects 1)) '(key option value)))
    (test-case "captured Boolean swaps publish unique indexes atomically and undo in every style"
      (def raw (RationalDict Bool)) (def shared (some #f))
      (def source (borrowing-table raw shared))
      (def indexed (table-indexes source (list (.o name: 'flag unique?: #t
        table: (alist-table Bool (.@ source Key)) project: (lambda (_ value) value)))))
      (def before (.call raw .<-list '((1 . #f) (2 . #t))))
      (def after (.call raw .<-list '((1 . #t) (2 . #f))))
      (def state (.call indexed .wrap before)) (def effects 0)
      (def published (service.revise-indexed-services indexed source state (lambda (_) after)
        (lambda (root) (set! effects (+ effects 1)) root)))
      (check-equal? effects 1)
      (check-equal? (.call indexed .index-ref/opt published 'flag #t) (some 1))
      (check-equal? (.call indexed .index-ref/opt published 'flag #f) (some 2))
      (def delta (.call source .diff before after))
      (some-value-set! shared 'poison)
      (for-each (lambda (name)
        (def style (.ref (table-styles indexed) name))
        (def undo (.call style .apply-delta (.call style .ap published) (invert-table-delta delta)))
        (check-equal? (.call style .ref undo 1) #f)
        (check-equal? (.call style .ref undo 2) #t)
        (check-equal? (.call style .index-ref/opt undo 'flag #f) (some 1)))
        '(Pure Mutable Linear Posh Classy)))
    (test-case "seeded Iterable updates own old values before the next lookup"
      (def raw (RationalDict Bool)) (def source (borrowing-table raw))
      (def before (.call raw .<-list '((1 . #f) (2 . #t))))
      (def installed (.call source .<-iter (iter '((1 . #t) (2 . #f))) before))
      (check-equal? (.call raw .list<- installed) '((1 . #t) (2 . #f))))
    (test-case "Set image output deltas survive unrelated typed provider lookups"
      (def shared (some #f))
      (def backing (borrowing-table (RationalDict Unit) shared))
      (def source (.cc Set<-Table. Table: backing))
      (def target (.cc Set<-Table. Table: (borrowing-table (RationalDict Unit) shared)))
      (def image (set-image source target identity))
      (def before (.call source .<-list '(1 2)))
      (def state (.call image .ap before))
      (def delta (.call backing .diff before (.call source .<-list [])))
      (defvalues (updated output) (.call image .apply-delta state delta values))
      (def unrelated (borrowing-table (RationalDict Integer) shared))
      (.call unrelated .ref/opt (.call unrelated .<-list '((9 . 99))) 9)
      (def restored (.call (.@ target Table) .apply-delta (.call image .get updated) (invert-table-delta output)))
      (check-equal? (element? target restored) #t)
      (check-eq? (.call (.@ target Table) .ref restored 1) (void))
      (check-equal? (.call target .list<- restored) '(1 2)))))
