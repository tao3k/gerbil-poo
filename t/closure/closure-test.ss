(export closure-test)
(import :std/test :std/iter :clan/poo/closure)

(def (assert-result plan result expected)
  (def counts (closure-counts result))
  (def size (closure-plan-size plan))
  (check-equal? (closure->list result) expected)
  (check (<= (vector-ref counts 0) (+ size (closure-plan-edges plan))) => #t)
  (check (<= (vector-ref counts 3) size) => #t)
  (check (<= (vector-ref counts 12) size) => #t)
  (check-equal? (+ (vector-ref counts 7) (vector-ref counts 8) (vector-ref counts 9))
                (vector-ref counts 2)))

(def (scalar-eval expression assignment)
  (case (vector-ref expression 0)
    ((0) (vector-ref expression 1))
    ((1) (vector-ref assignment (vector-ref expression 1)))
    ((2) (and (scalar-eval (vector-ref expression 1) assignment)
              (scalar-eval (vector-ref expression 2) assignment)))
    (else (or (scalar-eval (vector-ref expression 1) assignment)
              (scalar-eval (vector-ref expression 2) assignment)))))

;; Independent synchronous truth-table solver; no worklist/index implementation.
(def (oracle source)
  (let* ((size (vector-length source)) (state (make-vector size #f)))
    (let loop ((remaining (+ size 1)))
      (let ((next (vector-map (lambda (expression) (scalar-eval expression state)) source)))
        (if (equal? next state) (vector->list state)
          (begin (when (= remaining 0) (error "oracle height exhausted"))
                 (set! state next) (loop (- remaining 1))))))))

(def closure-test
  (test-suite "costed positive closure"
    (test-case "all 512 three-fact source combinations and five representations"
      (def clauses (vector (literal #f) (literal #t) (fact 0) (fact 1) (fact 2)
                           (both (fact 0) (fact 1)) (either (fact 1) (fact 2))
                           (both (either (fact 0) (fact 2)) (fact 1))))
      (for* ((a (in-range 8)) (b (in-range 8)) (c (in-range 8)))
        (def source (vector (vector-ref clauses a) (vector-ref clauses b) (vector-ref clauses c)))
        (def plan (compile-closure source))
        (def expected (oracle source))
        (for (variant '((append copied) (append owned) (chunked owned) (hybrid owned) (auto owned)))
          (assert-result plan (solve-closure plan (car variant) (cadr variant)) expected))
        (def cold (compile-closure source 'cold))
        (check-equal? (closure-plan-selector-visits cold) 0)
        (check-equal? (closure-plan-selector-visits plan) 3)
        (assert-result cold (solve-closure cold) expected)
        (assert-result cold (construct-closure source) expected)
        (check (eq? (prepare-closure plan) plan) => #t)
        (def upgraded (prepare-closure cold))
        (check-equal? (closure-plan-queue upgraded) (closure-plan-queue plan))
        (assert-result upgraded (solve-closure upgraded) expected)
        (def automatic (solve-closure plan))
        (def selected (solve-closure plan (closure-plan-queue plan)))
        (check-equal? (closure-counts automatic) (closure-counts selected))
        (def counts (closure-counts automatic))
        (def charge (if (eq? (closure-plan-queue plan) 'append) (* 4 (vector-ref counts 4))
                       (+ (* 4 (vector-ref counts 13)) (* 32 (vector-ref counts 5))
                          (if (eq? (closure-plan-queue plan) 'hybrid) (vector-ref counts 3) 0))))
        (check (<= charge (* 4 (closure-plan-edges plan))) => #t)
        (check (<= charge (closure-plan-hybrid-ceiling plan)) => #t)
        (for (prices '((0 0 0) (1 4 4) (9 0 0) (2 1 1)))
          (def policy (apply closure-policy prices))
          (def result (solve-closure plan 'hybrid 'owned policy))
          (assert-result plan result expected)
          (def c (closure-counts result))
          (def fee (+ (* (car prices) (vector-ref c 13))
                      (* (+ (cadr prices) (caddr prices)) (vector-ref c 5))))
          (check (<= fee (* (car prices) (vector-ref c 4))) => #t)
          (check (<= fee (* (+ (cadr prices) (caddr prices)) (vector-ref c 3))) => #t))))
    (test-case "retained topology revocation and private snapshots"
      (def source (vector (literal #t) (either (fact 0) (fact 2)) (fact 1)))
      (def plan (compile-closure source))
      (def old (solve-closure plan))
      (vector-set! (vector-ref source 0) 1 #f)
      (assert-result plan old '(#t #t #t))
      (assert-result plan (solve-closure plan) '(#t #t #t))
      (def next (reconfigure-closure plan source))
      (check-equal? (closure-plan-selector-visits next) 0)
      (check (eq? (prepare-closure next) next) => #t)
      (check-equal? (closure-plan-queue next) (closure-plan-queue plan))
      (check-equal? (closure-plan-hybrid-ceiling next) (closure-plan-hybrid-ceiling plan))
      (assert-result next (solve-closure next) '(#f #f #f))
      (assert-result plan old '(#t #t #t))
      (check-exception (reconfigure-closure plan (vector (literal #f) (fact 0) (fact 1))) true)
      (check-exception (compile-closure (vector (fact 1))) true)
      (check-exception (compile-closure (vector (literal 42))) true)
      (check-exception (compile-closure (vector '#(4 0 0))) true)
      (check-exception (solve-closure plan 'unknown) true)
      (def cycle (both (literal #f) (literal #t)))
      (vector-set! cycle 1 cycle)
      (check-exception (compile-closure (vector cycle)) true))
    (test-case "queue shortcuts and invalid prices"
      (check-exception (closure-policy -1 4 4) true)
      (check-exception (solve-closure (compile-closure '#()) 'auto 'owned (closure-policy 0 0 0)) true)
      (check-exception (closure-policy 1 1.5 4) true)
      (def plan (compile-closure (vector (literal #t) (fact 0) (fact 1))))
      (def result (solve-closure plan 'hybrid))
      (assert-result plan result '(#t #t #t))
      (def counts (closure-counts result))
      (check-equal? (vector-ref counts 5) 0)
      (check-equal? (vector-ref counts 14) 1)
      (check (positive? (+ (vector-ref counts 15) (vector-ref counts 16))) => #t))
    (test-case "empty and dense allocations"
      (assert-result (compile-closure '#()) (solve-closure (compile-closure '#())) '())
      (def size 256)
      (def source (make-vector size))
      (for (i (in-range size))
        (vector-set! source i
          (if (= i 0) (literal #t)
            (for/fold (expression (literal #f)) (j (in-range i))
              (either expression (fact j))))))
      (def plan (compile-closure source))
      (check-equal? (closure-plan-queue plan) 'chunked)
      (def cold (compile-closure source 'cold))
      (check-equal? (closure-plan-queue cold) 'chunked)
      (check-equal? (closure-plan-selector-visits cold) 0)
      (def chunked (solve-closure plan 'chunked))
      (def append (solve-closure plan 'append))
      (assert-result plan chunked (make-list size #t))
      (def chunk-counts (closure-counts chunked))
      (def append-counts (closure-counts append))
      (check-equal? (vector-ref chunk-counts 10) (* 2 size))
      (check-equal? (vector-ref chunk-counts 5) (vector-ref chunk-counts 6))
      (check-equal? (vector-ref chunk-counts 11) 0)
      (check-equal? (vector-ref append-counts 10) (+ size (closure-plan-edges plan)))
      (check (< (vector-ref chunk-counts 10) (vector-ref append-counts 10)) => #t))))
