(export closure-alignment-test)
(import (only-in :std/values first-value) :std/test :std/iter :clan/poo/closure :clan/poo/object
        (prefix-in :clan/poo/cyclic-publication cyclic-publication.)
        (prefix-in :clan/poo/examples/cyclic-access access.))
(def (invoke-value current service . args)
  (first-value (apply cyclic-publication.invoke current service args)))
(def (source seed)
  (vector (literal seed) (both (fact 0) (fact 2)) (fact 1)))
(def (reshaped seed)
  ;; More syntax and different Boolean semantics, same ordered dependencies.
  (vector (literal seed) (either (fact 0) (both (literal #f) (fact 2))) (fact 1)))
(def (cook facts) (.o (release (closure-ref facts 1)) (active (closure->list facts))))
(def (services view)
  (list (cons 'grant (lambda (user consent) (and consent (.@ view release) (string-append "release:" user))))
        (cons 'explain (lambda () (.@ view active)))))
(def (admit candidate)
  (equal? (invoke-value candidate 'explain) (.@ (cyclic-publication.version-view candidate) active)))
(def closure-alignment-test
  (test-suite "dependency-equal reshape and atomic cyclic services"
    (test-case "reshaping retains exact occurrence order and recomputes from bottom"
      (def old (compile-closure (source #t)))
      (def before (solve-closure old))
      (def next (reconfigure-closure old (reshaped #t)))
      (check (closure-index-shared? old next) => #t)
      (check-equal? (closure-plan-selector-visits next) 0)
      (check-equal? (closure->list before) '(#t #f #f))
      (check-equal? (closure->list (solve-closure next)) '(#t #t #t))
      (check-exception (reconfigure-closure old (vector (literal #t) (both (fact 2) (fact 0)) (fact 1))) true)
      (check-exception (reconfigure-closure old (vector (literal #t) (fact 0) (fact 1))) true))
    (test-case "ten-fact CyclicAccess alignment over every configuration"
      (for* ((seed '(#f #t)) (trust '(#f #t)) (training '(#f #t)) (team '(#f #t)) (compliance '(#f #t)))
        (def config (access.config trust training team compliance))
        (def approved (and seed trust (>= (+ (if training 1 0) (if team 1 0) (if compliance 1 0)) 2)))
        (def released (and approved team compliance))
        (defvalues (old issue) (access.start config seed))
        (check-equal? issue #f)
        (def view (cyclic-publication.version-view old))
        (check-equal? (.@ view member) (and seed trust))
        (check-equal? (.@ view approved) approved)
        (check-equal? (.@ view release) released)
        (check-equal? (invoke-value old 'grant "alice" #t)
                      (if released '(ok "release:alice") '(error not-authorized)))
        (check-equal? (invoke-value old 'explain)
                      (filter (lambda (i) (list-ref (cyclic-publication.version-facts old) i)) (iota 10)))
        (defvalues (next denied) (access.revise old config #f))
        (check-equal? denied #f)
        (check-equal? (invoke-value next 'grant "alice" #t) '(error not-authorized))
        (check-equal? (.@ (cyclic-publication.version-view old) release) released)
        (defvalues (retained refusal) (access.revise old config #f #t))
        (check (eq? retained old) => #t)
        (check-equal? (cyclic-publication.failure-stage refusal) 'admission)))
    (test-case "all family members publish together and refusal returns old identity"
      (def active (vector (literal #t) (either (fact 0) (fact 2)) (fact 1)))
      (defvalues (old issue) (cyclic-publication.prepare active cook services admit))
      (check-equal? issue #f)
      (check-equal? (invoke-value old 'grant "alice" #t) "release:alice")
      (check-equal? (invoke-value old 'explain) '(#t #t #t))
      (defvalues (next denied) (cyclic-publication.publish old (source #f) cook services admit))
      (check-equal? denied #f)
      (check-equal? (invoke-value next 'grant "alice" #t) #f)
      (check-equal? (invoke-value next 'explain) '(#f #f #f))
      (check-equal? (invoke-value old 'grant "alice" #t) "release:alice")
      (for (stage '(cooking services admission))
        (defvalues (retained failure)
          (cyclic-publication.publish old active
            (if (eq? stage 'cooking) (lambda (_) (error "cook")) cook)
            (if (eq? stage 'services) (lambda (_) (list (cons 'same void) (cons 'same void))) services)
            (if (eq? stage 'admission) (lambda (_) #f) admit)))
        (check (eq? retained old) => #t)
        (check-equal? (cyclic-publication.failure-stage failure) stage)
        (check-equal? (invoke-value old 'explain) '(#t #t #t)))
      (check-exception (invoke-value old 'missing) true))))
