(export contract-family-test)
(import :std/test :std/iter ../object (only-in :std/values first-value)
        (prefix-in ../contract-family family.) (prefix-in ../declarative-metadata metadata.)
        (prefix-in ../examples/service-metadata service.)
        (prefix-in ../examples/service-bundle bundle.) (prefix-in ../examples/cyclic-access access.)
        (prefix-in ../examples/shared-contracts shared.)
        (prefix-in ../staged-publication staged.) (prefix-in ../cyclic-publication publication.))
(def (caught thunk) (try (thunk) #f (catch (cause) cause)))
(def contract-family-test
  (test-suite "closed contract preparation and late binding"
    (test-case "prepared selection executes once and falls back on changed support size"
      (def calls 0)
      (def prices (.cc family.PreparationCosts. prepare-cost: 3 shared-cost: 0 direct-cost: 1))
      (def costs (.cc prices
        .choose: (lambda (count) (set! calls (+ calls 1)) (family.choose-preparation prices count))))
      (def keys '(reserve cancel))
      (def cache (.cc family.SelectionCache. preparation-costs: costs keys: keys))
      (check-equal? (family.cached-choice cache keys) 'direct)
      (check-equal? (family.cached-choice cache keys) 'direct)
      (check-equal? (family.cached-choice cache (list 'cancel 'reserve)) 'direct)
      (check-equal? calls 1)
      (check-equal? (family.cached-choice cache '(quote reserve cancel)) 'shared)
      (check-equal? calls 2)
      (def changed-cache (.cc cache preparation-costs:
        (.cc family.PreparationCosts. prepare-cost: 3 shared-cost: 1 direct-cost: 20)))
      (check-equal? (family.cached-choice changed-cache keys) 'shared)
      (check-equal? (family.cached-choice cache keys) 'direct)
      (def source (.cc shared.cached-source selection-cache: cache))
      (def model (.cc shared.cached-model contract-source: source))
      (def policy (.cc bundle.Policy. capacity: 10 price: 3 invoice: "invoice:1"))
      (def equations (access.equations (access.config) #t))
      (defvalues (old issue) (staged.prepare model equations policy))
      (check-equal? issue #f)
      (defvalues (_ warm) (publication.invoke old 'reserve 2))
      (def changed (.cc policy capacity: 20 invoice: "invoice:2"))
      (defvalues (next accepted) (staged.publish model warm equations changed))
      (check-equal? accepted #f) (check-equal? calls 2)
      (check-equal? (family.family-preparation (publication.version-contract-family next)) 'direct)
      (check-equal? (family.family-built (publication.version-contract-family next)) '(reserve cancel))
      (check-equal? (first-value (publication.invoke next 'reserve 2)) '(ok 18 #t))
      (check-equal? (first-value (publication.invoke next 'cancel "customer" #t)) '("customer" "invoice:2"))
      (defvalues (repriced issue2) (staged.publish model next equations (.cc changed price: 4)))
      (check-equal? issue2 #f) (check-equal? calls 2)
      (check-equal? (family.family-preparation (publication.version-contract-family repriced)) 'retained)
      (for (key keys)
        (check (eq? (publication.version-contract-invoker next key) (publication.version-contract-invoker repriced key)) => #t))
      ;; Changing support is still validated before selecting; invalid services
      ;; cannot be authorized by a cached decision or declared planning size.
      (check-exception (family.refresh source (publication.version-contract-family next) policy
        (publication.version-view next) (lambda (_ __ ___) #f) (lambda (_) #f)) true)
      (check-equal? calls 2)
      (defvalues (refused failure) (staged.publish model warm equations (.cc policy cache-limit: 0)))
      (check (eq? refused warm) => #t)
      (check-equal? (publication.failure-stage failure) 'admission))
    (test-case "cached family shrinks support and reintroduces a dependent contract"
      (def calls 0)
      (def prices (.@ shared.selected-source preparation-costs))
      (def costs (.cc prices .choose: (lambda (size)
        (set! calls (+ calls 1)) (family.choose-preparation prices size))))
      (def keys '(reserve cancel))
      (def source (.cc shared.cached-source keys: (lambda (names _) names)
        selection-cache: (.cc family.SelectionCache. keys: keys preparation-costs: costs)))
      (def (execute key args current)
        (values (case key ((reserve) '(ok 8 #t)) ((cancel) (list (car args) (.@ current invoice)))) current))
      (def first (.o (capacity 10) (invoice "invoice:1")))
      (def second (.o (capacity 10) (invoice "invoice:2")))
      (def third (.o (capacity 10) (invoice "invoice:3")))
      (def old (family.prepare source keys first execute))
      (check-equal? calls 1)
      (def reduced (family.refresh source old '(reserve) second execute))
      (check-equal? calls 2)
      (check-equal? (family.family-built reduced) [])
      (check (family.family-invoker reduced 'cancel) => #f)
      (def restored (family.refresh source reduced keys third execute))
      (check-equal? calls 2)
      (check-equal? (family.family-built restored) '(cancel))
      (check (eq? (family.family-invoker old 'reserve) (family.family-invoker restored 'reserve)) => #t)
      (check-equal? (first-value ((family.family-invoker restored 'cancel) '("customer" #t) third)) '("customer" "invoice:3")))
    (test-case "failed current support does not force cold cache selection"
      (def calls 0)
      (def prices (.@ shared.selected-source preparation-costs))
      (def costs (.cc prices .choose: (lambda (size)
        (set! calls (+ calls 1)) (family.choose-preparation prices size))))
      (def source (.cc shared.cached-source selection-cache:
        (.cc family.SelectionCache. preparation-costs: costs keys: '(reserve cancel))))
      (check-exception (family.prepare source #f (.o (capacity 10) (invoice "invoice:1"))
        (lambda (_ __ ___) (error "unreachable")) (lambda (_) #f)) true)
      (check-equal? calls 0))
    (test-case "priced direct/shared selection keeps the full publication contract"
      (def cheap (.cc family.PreparationCosts. prepare-cost: 3 shared-cost: 1 direct-cost: 1 selection-cost: 1))
      (def indexed (.cc cheap direct-cost: 20))
      (check-equal? (family.choose-preparation cheap 2) 'direct)
      (check-equal? (family.choose-preparation indexed 2) 'shared)
      ;; The saving must pay selection too. A tie keeps shared preparation.
      (check-equal? (family.choose-preparation (.cc cheap selection-cost: 3) 2) 'shared)
      (check-exception (family.choose-preparation (.cc cheap prepare-cost: -1) 2) true)
      (for* ((capacity '(0 1 10 20)) (invoice '("invoice:1" "invoice:2")) (key '(reserve cancel)))
        (def context (list capacity invoice))
        (check-equal? (shared.project-direct key context)
          (shared.project-shared key (shared.prepare-shared context))))
      (def prepared 0)
      (def source (.cc shared.selected-source prepare-shared: (lambda (context)
        (set! prepared (+ prepared 1)) (shared.prepare-shared context))))
      (def model (.cc shared.selected-model contract-source: source))
      (def policy (.cc bundle.Policy. capacity: 10 price: 3 invoice: "invoice:1"))
      (def equations (access.equations (access.config) #t))
      (defvalues (old issue) (staged.prepare model equations policy))
      (check-equal? issue #f) (check-equal? prepared 0)
      (check-equal? (family.family-preparation (publication.version-contract-family old)) 'direct)
      (defvalues (_ warm) (publication.invoke old 'cancel "customer" #t))
      (defvalues (repriced accepted) (staged.publish model warm equations (.cc policy price: 4)))
      (check-equal? accepted #f)
      (check-equal? (family.family-preparation (publication.version-contract-family repriced)) 'retained)
      (check-equal? (family.family-built (publication.version-contract-family repriced)) [])
      (def changed (.cc policy capacity: 20 invoice: "invoice:2"))
      (defvalues (joint accepted2) (staged.publish model repriced equations changed))
      (check-equal? accepted2 #f) (check-equal? prepared 0)
      (check-equal? (family.family-preparation (publication.version-contract-family joint)) 'direct)
      (check-equal? (family.family-built (publication.version-contract-family joint)) '(reserve cancel))
      (check-equal? (family.family-bound (publication.version-contract-family joint)) '(reserve cancel))
      (for (key '(reserve cancel))
        (def before (publication.version-contract old key))
        (def after (publication.version-contract joint key))
        (check (eq? before after) => #f)
        ;; Templates share only invariant structure, never stale dependent meaning.
        (check (eq? (.@ before input) (.@ after input)) => #t)
        (check (eq? (.@ before output) (.@ after output)) => #t)
        (check (eq? (.@ before rule) (.@ after rule)) => #t))
      (check-equal? (first-value (publication.invoke joint 'reserve 2)) '(ok 18 #t))
      (check-equal? (first-value (publication.invoke joint 'cancel "customer" #t)) '("customer" "invoice:2"))
      (check-equal? (metadata.failure-phase (caught (cut publication.invoke joint 'cancel "customer" #f))) 'input)
      (check-equal? (metadata.failure-phase (caught (cut publication.invoke joint 'reserve 0))) 'input)
      ;; Larger per-key work chooses the existing shared implementation.
      (def indexed-source (.cc source preparation-costs: indexed))
      (defvalues (rebuilt accepted3) (staged.publish (.cc model contract-source: indexed-source) joint equations changed))
      (check-equal? accepted3 #f) (check-equal? prepared 1)
      (check-equal? (family.family-preparation (publication.version-contract-family rebuilt)) 'shared)
      ;; Source changes invalidate everything even if strategy/context match.
      (check-equal? (family.family-built (publication.version-contract-family rebuilt)) '(reserve cancel))
      (defvalues (refused failure) (staged.publish model warm equations (.cc policy cache-limit: 0)))
      (check (eq? refused warm) => #t)
      (check-equal? (publication.failure-stage failure) 'admission))
    (test-case "shared preparation and cross-service joint revision"
      (def preparations 0)
      (def probes [])
      (def source (.cc shared.source prepare-shared: (lambda (context)
        (set! preparations (+ preparations 1)) (shared.prepare-shared context))
        construct: (lambda (key input)
          (def base (shared.construct key input))
          (.cc base .wrap: (lambda (execute)
            (def checked (metadata.wrap base execute))
            (lambda (args current)
              (set! probes (cons key probes)) (checked args current)))))))
      (def model (.cc shared.model contract-source: source))
      (def policy (.cc bundle.Policy. capacity: 10 price: 3 invoice: "invoice:1"))
      (def equations (access.equations (access.config) #t))
      (defvalues (old issue) (staged.prepare model equations policy))
      (check-equal? issue #f) (check-equal? preparations 1)
      (defvalues (_ warm) (publication.invoke old 'cancel "customer" #t))
      (defvalues (repriced accepted) (staged.publish model warm equations (.cc policy price: 4)))
      (check-equal? accepted #f) (check-equal? preparations 1)
      (check-equal? probes '(cancel cancel reserve))
      (set! probes [])
      (def retained (publication.version-contract-family repriced))
      (check-equal? (family.family-prepared? retained) #f)
      (check-equal? (family.family-built retained) [])
      (check-equal? (family.family-bound retained) [])
      (check (eq? (publication.version-service warm 'cancel) (publication.version-service repriced 'cancel)) => #t)
      (def changed (.cc policy capacity: 20 invoice: "invoice:2"))
      (defvalues (joint accepted2) (staged.publish model repriced equations changed))
      (check-equal? accepted2 #f) (check-equal? preparations 2)
      (check-equal? probes '(cancel reserve))
      (check-equal? (family.family-built (publication.version-contract-family joint)) '(reserve cancel))
      (check-equal? (first-value (publication.invoke joint 'reserve 2)) '(ok 18 #t))
      (check-equal? (first-value (publication.invoke joint 'cancel "customer" #t)) '("customer" "invoice:2"))
      (defvalues (invoice-only accepted3) (staged.publish model joint equations (.cc changed invoice: "invoice:3")))
      (check-equal? accepted3 #f) (check-equal? preparations 3)
      (check-equal? (family.family-built (publication.version-contract-family invoice-only)) '(cancel))
      (check (eq? (publication.version-contract-invoker joint 'reserve)
                  (publication.version-contract-invoker invoice-only 'reserve)) => #t)
      ;; Current support is checked before even the shared input preparation.
      (check-exception (family.refresh source retained policy (publication.version-view repriced)
        (lambda (_ __ ___) (error "unreachable")) (lambda (key) (not (eq? key 'cancel)))) true)
      (check-equal? preparations 3)
      ;; Replacing the source cannot reuse another source's prepared lookup.
      (defvalues (replacement accepted4) (staged.publish (.cc model contract-source: (.cc source)) invoice-only equations changed))
      (check-equal? accepted4 #f) (check-equal? preparations 4)
      (check-equal? (family.family-built (publication.version-contract-family replacement)) '(reserve cancel))
      ;; A failed common preparation cannot leak a partially revised family.
      (def refusing (.cc model contract-source: (.cc source prepare-shared: (lambda (_) (error "preparation refused")))))
      (defvalues (unchanged preparation-failure) (staged.publish refusing joint equations changed))
      (check (eq? unchanged joint) => #t)
      (check-equal? (publication.failure-stage preparation-failure) 'metadata)
      ;; Approval refusal keeps the complete old version, including warm caches.
      (defvalues (refused failure) (staged.publish model repriced equations (.cc policy price: 4 cache-limit: 0)))
      (check (eq? refused repriced) => #t)
      (check-equal? (publication.failure-stage failure) 'admission))
    (test-case "unchanged descriptors and wrappers skip real construction and binding"
      (def constructed [])
      (def wrapped [])
      (def source (.cc family.Source.
        keys: (lambda (names _) names)
        project: (lambda (_ __ view) (.@ view capacity))
        construct: (lambda (key capacity)
          (set! constructed (cons key constructed))
          (.cc (service.reservation capacity)
            .wrap: (lambda (execute)
              (set! wrapped (cons key wrapped)) (metadata.wrap (service.reservation capacity) execute))))))
      (def (execute _ args current) (values (list 'ok (- (.@ current capacity) (car args)) #t) current))
      (def initial (.o (capacity 10) (revision 1)))
      (def current (.o (capacity 10) (revision 2)))
      (def old (family.prepare source '(reserve) initial execute))
      (check-equal? constructed '(reserve))
      (check-equal? wrapped '(reserve))
      (set! constructed []) (set! wrapped [])
      (def next (family.refresh source old '(reserve) current execute))
      (check-equal? constructed []) (check-equal? wrapped [])
      (check-equal? (family.family-built next) [])
      (check-equal? (family.family-bound next) [])
      (check-equal? (family.family-reused next) '(reserve))
      (check (eq? (family.family-ref next 'reserve) (family.family-ref old 'reserve)) => #t)
      (check (eq? (family.family-invoker next 'reserve) (family.family-invoker old 'reserve)) => #t)
      (defvalues (result returned) ((family.family-invoker next 'reserve) '(2) current))
      (check-equal? result '(ok 8 #t))
      (check (eq? returned current) => #t)
      (def larger (.o (capacity 20)))
      (def changed (family.refresh source next '(reserve) larger execute))
      (check-equal? constructed '(reserve)) (check-equal? wrapped '(reserve))
      (check-equal? (family.family-built changed) '(reserve))
      (check-equal? (first-value ((family.family-invoker changed 'reserve) '(2) larger)) '(ok 18 #t))
      ;; Executor changes retain the descriptor, but never the old wrapper.
      (def (bad-execute _ args state) (values '(ok 99 #t) state))
      (def rebound (family.refresh source next '(reserve) current bad-execute))
      (check-equal? (family.family-built rebound) [])
      (check-equal? (family.family-bound rebound) '(reserve))
      (check (eq? (family.family-ref rebound 'reserve) (family.family-ref next 'reserve)) => #t)
      (check-equal? (metadata.failure-phase (caught (cut (family.family-invoker rebound 'reserve) '(2) current))) 'logic)
      (def replaced (family.refresh (.cc source) next '(reserve) current execute))
      (check-equal? (family.family-built replaced) '(reserve))
      (def removed (family.refresh source next [] current execute))
      (check-equal? (family.family-keys removed) [])
      (check (family.family-ref removed 'reserve) => #f)
      (check (family.family-invoker removed 'reserve) => #f)
      (check-equal? (family.family-built (family.refresh source removed '(reserve) current execute)) '(reserve))
      (set! constructed [])
      (check-exception (family.refresh source next '(reserve) larger execute (lambda (_) #f)) true)
      (check-equal? constructed [])
      (check-exception (family.refresh source next '(reserve reserve) current execute) true))
    (test-case "heterogeneous invoice revision rebuilds cancel and retains reserve"
      (def (cancellation invoice)
        (metadata.contract
          (metadata.predicate "consent" (match <> ([customer #t] (string? customer)) (else #f)))
          (metadata.predicate "event" (match <> ([customer tag] (and (string? customer) (string? tag))) (else #f)))
          (lambda (_ args result) (equal? result (list (car args) invoice))) (metadata.atom 'invoice)))
      (def source (.cc family.Source.
        keys: (lambda (names _) names)
        project: (lambda (key _ view) (case key ((reserve) (.@ view capacity)) ((cancel) (.@ view invoice))))
        construct: (lambda (key input) (case key ((reserve) (service.reservation input)) ((cancel) (cancellation input))))))
      (def initial (.o (capacity 10) (invoice "invoice:1")))
      (def current (.o (capacity 10) (invoice "invoice:2")))
      (def (execute key args view)
        (values (case key ((reserve) (list 'ok (- (.@ view capacity) (car args)) #t))
                          ((cancel) (list (car args) (.@ view invoice)))) view))
      (def old (family.prepare source '(reserve cancel) initial execute))
      (def next (family.refresh source old '(reserve cancel) current execute))
      (check-equal? (family.family-built next) '(cancel))
      (check-equal? (family.family-bound next) '(cancel))
      (check-equal? (family.family-reused next) '(reserve))
      (check (eq? (family.family-invoker next 'reserve) (family.family-invoker old 'reserve)) => #t)
      (check (eq? (family.family-invoker next 'cancel) (family.family-invoker old 'cancel)) => #f)
      (defvalues (reserved returned) ((family.family-invoker next 'reserve) '(2) current))
      (check-equal? reserved '(ok 8 #t))
      (check (eq? returned current) => #t)
      (check-equal? (first-value ((family.family-invoker next 'cancel) '("customer" #t) current)) '("customer" "invoice:2")))
    (test-case "joint approval skips the actual retained probe but invocation still checks"
      (def calls 0)
      (def source (.cc (.@ bundle.model contract-source)
        construct: (lambda (_ capacity)
          (def base (service.reservation capacity))
          (.cc base .wrap: (lambda (execute)
            (def checked (metadata.wrap base execute))
            (lambda (args . context)
              (set! calls (+ calls 1)) (apply checked args context)))))))
      (def model (.cc bundle.model contract-source: source))
      (def policy (.cc bundle.Policy. capacity: 10 price: 3 invoice: "invoice:1"))
      (def equations (access.equations (access.config) #t))
      (defvalues (old issue) (staged.prepare model equations policy))
      (check-equal? issue #f) (check-equal? calls 1)
      (set! calls 0)
      (defvalues (next accepted) (staged.publish model old equations (.cc policy price: 4)))
      (check-equal? accepted #f) (check-equal? calls 0)
      (check-equal? (first-value (publication.invoke next 'reserve 2)) '(ok 8 #t))
      (check-equal? calls 1)
      (check-equal? (metadata.failure-phase (caught (cut publication.invoke next 'reserve 0))) 'input)
      (check-equal? calls 2))
    (test-case "service revisions reuse contracts; changed services use the current snapshot"
      (def policy (.cc bundle.Policy. capacity: 10 price: 3 invoice: "invoice:1"))
      (defvalues (old issue) (bundle.start policy))
      (check-equal? issue #f)
      (defvalues (_ warm) (publication.invoke old 'reserve 2))
      (defvalues (repriced accepted) (bundle.revise warm (.cc policy price: 4)))
      (check-equal? accepted #f)
      (check (eq? (publication.version-contract old 'reserve) (publication.version-contract repriced 'reserve)) => #t)
      (check (eq? (publication.version-contract-invoker old 'reserve) (publication.version-contract-invoker repriced 'reserve)) => #t)
      (check-equal? (family.family-built (publication.version-contract-family repriced)) [])
      (check-equal? (family.family-bound (publication.version-contract-family repriced)) [])
      (check-equal? (first-value (publication.invoke repriced 'reserve 2)) '(ok 8 #t))
      ;; Fresh generic with unchanged contract: the retained wrapper must run it.
      (def shifted-policy (.cc policy reserve-shift: 1))
      (def shifted (.cc bundle.model admit: (lambda (_ __) #t) .readmit: (lambda (_ __) #t)))
      (defvalues (changed admitted) (staged.publish shifted warm (access.equations (access.config) #t) shifted-policy))
      (check-equal? admitted #f)
      (check (eq? (publication.version-contract-invoker warm 'reserve) (publication.version-contract-invoker changed 'reserve)) => #t)
      (check-equal? (metadata.failure-phase (caught (cut publication.invoke changed 'reserve 2))) 'logic)
      (def source (.@ bundle.model contract-source))
      (def without (.cc bundle.model contract-source: (.cc source keys: (lambda (_ __) []))))
      (defvalues (removed no-issue) (staged.publish without warm (access.equations (access.config) #t) policy))
      (check-equal? no-issue #f)
      (check (publication.version-contract removed 'reserve) => #f)
      (check (publication.version-contract-invoker removed 'reserve) => #f)
      (def overridden (.cc bundle.model contracts: (lambda (_ __)
                         (list (cons 'reserve (service.reservation 11))))))
      (defvalues (preserved override-issue) (staged.publish overridden warm (access.equations (access.config) #t) policy))
      (check (eq? preserved warm) => #t)
      (check-equal? (publication.failure-stage override-issue) 'admission)
      (for (bad (list (.cc source keys: (lambda (_ __) '(absent)))
                     (.cc source keys: (lambda (_ __) '(reserve reserve)))
                     (.cc source construct: (lambda (_ __) (error "constructor refused")))))
        (defvalues (retained refused) (staged.publish (.cc bundle.model contract-source: bad) warm (access.equations (access.config) #t) policy))
        (check (eq? retained warm) => #t)
        (check-equal? (publication.failure-stage refused) 'metadata)))))
