(export contract-family-test)
(import :std/test :std/iter ../object (only-in :std/values first-value)
        (prefix-in ../contract-family family.) (prefix-in ../declarative-metadata metadata.)
        (prefix-in ../examples/service-metadata service.)
        (prefix-in ../examples/service-bundle bundle.) (prefix-in ../examples/cyclic-access access.)
        (prefix-in ../staged-publication staged.) (prefix-in ../cyclic-publication publication.))
(def (caught thunk) (try (thunk) #f (catch (cause) cause)))
(def contract-family-test
  (test-suite "closed contract preparation and late binding"
    (test-case "unchanged descriptors and wrappers skip real construction and binding"
      (def constructed [])
      (def wrapped [])
      (def source (.cc family.Source.
        keys: (lambda (names _) names)
        project: (lambda (_ __ view) (.@ view capacity))
        construct: (lambda (key capacity)
          (set! constructed (cons key constructed))
          (.cc (service.reservation capacity)
            .wrap: (lambda (execute)
              (set! wrapped (cons key wrapped)) (metadata.wrap (service.reservation capacity) execute))))))
      (def (execute _ args current) (values (list 'ok (- (.@ current capacity) (car args)) #t) current))
      (def initial (.o (capacity 10) (revision 1)))
      (def current (.o (capacity 10) (revision 2)))
      (def old (family.prepare source '(reserve) initial execute))
      (check-equal? constructed '(reserve))
      (check-equal? wrapped '(reserve))
      (set! constructed []) (set! wrapped [])
      (def next (family.refresh source old '(reserve) current execute))
      (check-equal? constructed []) (check-equal? wrapped [])
      (check-equal? (family.family-built next) [])
      (check-equal? (family.family-bound next) [])
      (check-equal? (family.family-reused next) '(reserve))
      (check (eq? (family.family-ref next 'reserve) (family.family-ref old 'reserve)) => #t)
      (check (eq? (family.family-invoker next 'reserve) (family.family-invoker old 'reserve)) => #t)
      (defvalues (result returned) ((family.family-invoker next 'reserve) '(2) current))
      (check-equal? result '(ok 8 #t))
      (check (eq? returned current) => #t)
      (def larger (.o (capacity 20)))
      (def changed (family.refresh source next '(reserve) larger execute))
      (check-equal? constructed '(reserve)) (check-equal? wrapped '(reserve))
      (check-equal? (family.family-built changed) '(reserve))
      (check-equal? (first-value ((family.family-invoker changed 'reserve) '(2) larger)) '(ok 18 #t))
      ;; Executor changes retain the descriptor, but never the old wrapper.
      (def (bad-execute _ args state) (values '(ok 99 #t) state))
      (def rebound (family.refresh source next '(reserve) current bad-execute))
      (check-equal? (family.family-built rebound) [])
      (check-equal? (family.family-bound rebound) '(reserve))
      (check (eq? (family.family-ref rebound 'reserve) (family.family-ref next 'reserve)) => #t)
      (check-equal? (metadata.failure-phase (caught (cut (family.family-invoker rebound 'reserve) '(2) current))) 'logic)
      (def replaced (family.refresh (.cc source) next '(reserve) current execute))
      (check-equal? (family.family-built replaced) '(reserve))
      (def removed (family.refresh source next [] current execute))
      (check-equal? (family.family-keys removed) [])
      (check (family.family-ref removed 'reserve) => #f)
      (check (family.family-invoker removed 'reserve) => #f)
      (check-equal? (family.family-built (family.refresh source removed '(reserve) current execute)) '(reserve))
      (set! constructed [])
      (check-exception (family.refresh source next '(reserve) larger execute (lambda (_) #f)) true)
      (check-equal? constructed [])
      (check-exception (family.refresh source next '(reserve reserve) current execute) true))
    (test-case "joint approval skips the actual retained probe but invocation still checks"
      (def calls 0)
      (def source (.cc (.@ bundle.model contract-source)
        construct: (lambda (_ capacity)
          (def base (service.reservation capacity))
          (.cc base .wrap: (lambda (execute)
            (def checked (metadata.wrap base execute))
            (lambda (args . context)
              (set! calls (+ calls 1)) (apply checked args context)))))))
      (def model (.cc bundle.model contract-source: source))
      (def policy (.cc bundle.Policy. capacity: 10 price: 3 invoice: "invoice:1"))
      (def equations (access.equations (access.config) #t))
      (defvalues (old issue) (staged.prepare model equations policy))
      (check-equal? issue #f) (check-equal? calls 1)
      (set! calls 0)
      (defvalues (next accepted) (staged.publish model old equations (.cc policy price: 4)))
      (check-equal? accepted #f) (check-equal? calls 0)
      (check-equal? (first-value (publication.invoke next 'reserve 2)) '(ok 8 #t))
      (check-equal? calls 1)
      (check-equal? (metadata.failure-phase (caught (cut publication.invoke next 'reserve 0))) 'input)
      (check-equal? calls 2))
    (test-case "service revisions reuse contracts; changed services use the current snapshot"
      (def policy (.cc bundle.Policy. capacity: 10 price: 3 invoice: "invoice:1"))
      (defvalues (old issue) (bundle.start policy))
      (check-equal? issue #f)
      (defvalues (_ warm) (publication.invoke old 'reserve 2))
      (defvalues (repriced accepted) (bundle.revise warm (.cc policy price: 4)))
      (check-equal? accepted #f)
      (check (eq? (publication.version-contract old 'reserve) (publication.version-contract repriced 'reserve)) => #t)
      (check (eq? (publication.version-contract-invoker old 'reserve) (publication.version-contract-invoker repriced 'reserve)) => #t)
      (check-equal? (family.family-built (publication.version-contract-family repriced)) [])
      (check-equal? (family.family-bound (publication.version-contract-family repriced)) [])
      (check-equal? (first-value (publication.invoke repriced 'reserve 2)) '(ok 8 #t))
      ;; Fresh generic with unchanged contract: the retained wrapper must run it.
      (def shifted-policy (.cc policy reserve-shift: 1))
      (def shifted (.cc bundle.model admit: (lambda (_ __) #t) .readmit: (lambda (_ __) #t)))
      (defvalues (changed admitted) (staged.publish shifted warm (access.equations (access.config) #t) shifted-policy))
      (check-equal? admitted #f)
      (check (eq? (publication.version-contract-invoker warm 'reserve) (publication.version-contract-invoker changed 'reserve)) => #t)
      (check-equal? (metadata.failure-phase (caught (cut publication.invoke changed 'reserve 2))) 'logic)
      (def source (.@ bundle.model contract-source))
      (def without (.cc bundle.model contract-source: (.cc source keys: (lambda (_ __) []))))
      (defvalues (removed no-issue) (staged.publish without warm (access.equations (access.config) #t) policy))
      (check-equal? no-issue #f)
      (check (publication.version-contract removed 'reserve) => #f)
      (check (publication.version-contract-invoker removed 'reserve) => #f)
      (def overridden (.cc bundle.model contracts: (lambda (_ __)
                         (list (cons 'reserve (service.reservation 11))))))
      (defvalues (preserved override-issue) (staged.publish overridden warm (access.equations (access.config) #t) policy))
      (check (eq? preserved warm) => #t)
      (check-equal? (publication.failure-stage override-issue) 'admission)
      (for (bad (list (.cc source keys: (lambda (_ __) '(absent)))
                     (.cc source keys: (lambda (_ __) '(reserve reserve)))
                     (.cc source construct: (lambda (_ __) (error "constructor refused")))))
        (defvalues (retained refused) (staged.publish (.cc bundle.model contract-source: bad) warm (access.equations (access.config) #t) policy))
        (check (eq? retained warm) => #t)
        (check-equal? (publication.failure-stage refused) 'metadata)))))
