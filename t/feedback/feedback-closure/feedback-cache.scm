;; Closed groups are atomic cache nodes, not partial cyclic reconstruction states.
(def feedback-cache-test
  (test-suite "selective feedback groups and shared dependency invalidation"
    (test-case "shared revision rebuilds both readers and physically retains the independent group"
      (def policy (.o (allowed #t) (limit 27)))
      (defvalues (old failure) (service.publish #f (service.source 3) policy (.cc cache.Builder.)))
      (check-equal? failure #f) (check-equal? (cache.cache-evaluated old) '(quota left right stable))
      (check-equal? (map (cut list-ref <> 4) (service.report old 2)) '(36 48 24))
      (.putslot! policy 'limit ($constant-slot-spec 33))
      (def source (graph.set-base (cache.cache-source old) 'quota (some (code.make-success 4))))
      (defvalues (next ok) (service.publish old source policy
        (.cc cache.Builder. allow: (lambda (key) (not (eq? key 'stable))))))
      (check-equal? ok #f) (check-equal? (cache.cache-evaluated next) '(quota left right))
      (check-equal? (cache.cache-reused next) '(stable))
      (check (eq? (feedback-cache-ref old 'stable) (feedback-cache-ref next 'stable)) => #t)
      (check-equal? (map (cut list-ref <> 4) (service.report next 2)) '(48 60 24))
      (check-equal? (map (cut list-ref <> 4) (service.report old 2)) '(36 48 24))
      (def smaller (graph.set-base (cache.cache-source next) 'quota (some (code.make-success 1))))
      (defvalues (shrunk fine) (service.publish next smaller policy
        (.cc cache.Builder. allow: (lambda (key) (not (eq? key 'stable))))))
      (check-equal? fine #f) (check-equal? (cache.cache-evaluated shrunk) '(quota left right))
      (check-equal? (map (cut list-ref <> 4) (service.report shrunk 2)) '(12 24 24))
      (check (eq? (feedback-cache-ref next 'stable) (feedback-cache-ref shrunk 'stable)) => #t))
    (test-case "a left body edit invalidates its downstream group but skips quota and independent group"
      (def policy (.o (allowed #t) (limit 33)))
      (defvalues (old _) (service.publish #f (service.source 3) policy (.cc cache.Builder.)))
      (def code (code.need 'quota (lambda (quota) (service.build-group (+ quota 1)))))
      (def source (graph.define (cache.cache-source old) 'left code))
      (defvalues (next failure) (service.publish old source policy
        (.cc cache.Builder. allow: (lambda (key) (memq key '(left right))))))
      (check-equal? failure #f) (check-equal? (cache.cache-evaluated next) '(left right))
      (check-equal? (cache.cache-reused next) '(quota stable))
      (check-equal? (map (cut list-ref <> 4) (service.report next 2)) '(48 60 24))
      (check (eq? (feedback-cache-ref next 'stable) (feedback-cache-ref old 'stable)) => #t))
    (test-case "joint refusal keeps old cache and retry never reuses a speculative candidate"
      (def policy (.o (allowed #t) (limit 27)))
      (defvalues (old _) (service.publish #f (service.source 3) policy (.cc cache.Builder.)))
      (def source (graph.set-base (cache.cache-source old) 'quota (some (code.make-success 4))))
      (defvalues (held denied) (service.publish old source policy (.cc cache.Builder.)))
      (check (eq? held old) => #t) (check (not (not denied)) => #t)
      (.putslot! policy 'limit ($constant-slot-spec 33))
      (defvalues (next ok) (service.publish old source policy (.cc cache.Builder.)))
      (check-equal? ok #f) (check-equal? (cache.cache-evaluated next) '(quota left right))
      (check (eq? (feedback-cache-ref next 'stable) (feedback-cache-ref old 'stable)) => #t))
    (test-case "approval-only revision skips all builders and still checks current permission"
      (def policy (.o (allowed #t) (limit 27)))
      (defvalues (old _) (service.publish #f (service.source 3) policy (.cc cache.Builder.)))
      (.putslot! policy 'allowed ($constant-slot-spec #f))
      (defvalues (held denied) (service.publish old (cache.cache-source old) policy
        (.cc cache.Builder. allow: (lambda (_) #f))))
      (check (eq? held old) => #t) (check (not (not denied)) => #t)
      (.putslot! policy 'allowed ($constant-slot-spec #t))
      (defvalues (next ok) (service.publish old (cache.cache-source old) policy
        (.cc cache.Builder. allow: (lambda (_) #f))))
      (check-equal? ok #f) (check-equal? (cache.cache-evaluated next) [])
      (check-equal? (cache.cache-reused next) '(quota left right stable)))
    (test-case "removed shared input and cross-group cycles refuse before joint approval"
      (def policy (.o (allowed #t) (limit 27)))
      (defvalues (old _) (service.publish #f (service.source 3) policy (.cc cache.Builder.)))
      (def reached? #f)
      (defvalues (held missing) (publish-feedback-cache old (graph.remove (cache.cache-source old) 'quota)
        service.required-keys (lambda (_ __) (set! reached? #t) #t)))
      (check (eq? held old) => #t) (check (not (not missing)) => #t) (check-equal? reached? #f)
      (def cyclic (graph.define (cache.cache-source old) 'left (code.need 'right identity)))
      (defvalues (same cycle) (service.publish old cyclic policy (.cc cache.Builder.)))
      (check (eq? same old) => #t) (check (not (not cycle)) => #t))
    (test-case "retained stale group sources refuse until the source explicitly rebuilds that group"
      (def dependency (.o (revision 1)))
      (def focus (.lens))
      (def (build _)
        (close-feedback-group (.prototype GeneralizedDeclaration. (.o) identity
          (fragment stable (lens-fragment focus (lambda (value _ inherited) value) 7 sources: [dependency]))) 7 7 1))
      (def source (graph.declaration '(stable) [(cons 'stable (code.map (code.pure 0) build))]))
      (defvalues (old _) (publish-feedback-cache #f source '(stable) (lambda (_ __) #t)))
      (.putslot! dependency 'revision ($constant-slot-spec 2))
      (def reached? #f)
      (defvalues (held stale) (publish-feedback-cache old (cache.cache-source old) '(stable)
        (lambda (_ __) (set! reached? #t) #t)))
      (check (eq? held old) => #t) (check (not (not stale)) => #t) (check-equal? reached? #f)
      (def fresh (graph.define (cache.cache-source old) 'stable (code.map (code.pure 0) build)))
      (defvalues (next ok) (publish-feedback-cache old fresh '(stable) (lambda (_ __) #t)))
      (check-equal? ok #f) (check-equal? (cache.cache-evaluated next) '(stable)))
    (test-case "Reader composition observes accepted groups and suppresses suffix after refusal"
      (def policy (.o (allowed #t) (limit 27)))
      (def action (.call fun.Observation. .map (cut service.report <> 2)
        (feedback-cache-action (service.source 3) service.required-keys (service.admit policy))))
      (check-equal? (map (cut list-ref <> 4) (action #f)) '(36 48 24))
      (def reached? #f)
      (def refused (.call fun.Observation. .map (lambda (_) (set! reached? #t))
        (feedback-cache-action (service.source 3) service.required-keys (lambda (_ __) #f))))
      (check-exception (refused #f) true) (check-equal? reached? #f))
    (test-case "approval guards stay active after full reuse and non-Boolean approval refuses"
      (def policy (.o (allowed #t) (limit 27)))
      (defvalues (old _) (service.publish #f (service.source 3) policy (.cc cache.Builder.)))
      (defvalues (held failure) (publish-feedback-cache old (cache.cache-source old) service.required-keys
        (lambda (_ __) (.putslot! policy 'allowed ($constant-slot-spec #f)) #t)
        guards: [(lens-check (.lens) [policy] sources: [policy])]))
      (check (eq? held old) => #t) (check (not (not failure)) => #t)
      (check-equal? (.@ policy allowed) #t)
      (defvalues (same invalid) (publish-feedback-cache old (cache.cache-source old)
        service.required-keys (lambda (_ __) 'yes)))
      (check (eq? same old) => #t) (check (not (not invalid)) => #t)
      (check-equal? (active-object-constructions) []))))

;; Return the original suites from this lexical scope.
(values feedback-cache-test)
