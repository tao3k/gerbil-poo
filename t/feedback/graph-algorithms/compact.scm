;;; Prepared traversal study over the actual private production index.
(extern namespace: clan/poo/strong-components
  make-compact-graph capture-compact compact-graph-names compact-graph-positions compact-graph-offsets compact-graph-targets compact-graph-direction
  compact-discover compact-selected-discover compact-component-owners compact-discovery-result compact-reachable)

(def (compact-row graph key)
  (def node (hash-ref (compact-graph-positions graph) key))
  (def offsets (compact-graph-offsets graph))
  (def targets (compact-graph-targets graph))
  (def names (compact-graph-names graph))
  (for/collect (at (in-range (u32vector-ref offsets node) (u32vector-ref offsets (fx+ node 1))))
    (vector-ref names (u32vector-ref targets at))))

;; Exercise the actual POO owner boundary, not only the numeric kernel. Input
;; rows are the SAME immutable metadata used by the existing capacity case.
(def (owned-query-study keys rows root expected size edges)
  (def acquisitions 0)
  (def owner-keys keys)
  (defvalues (bundle cold)
    (measure (lambda ()
      (def source (.o keys: owner-keys .reads: (lambda (key)
        (set! acquisitions (1+ acquisitions)) (hash-ref rows key))))
      (def indexed (scc.capture-reachability source))
      (def query (.ref indexed '.reachable))
      (vector indexed query (query root))) 1))
  (unless (and (= acquisitions size) (equal? (vector-ref bundle 2) expected))
    (error "owned reachability cold acquisition/order" size acquisitions))
  (vector-set! bundle 2 #f)
  (let-values (((answer hot) (measure (cut (vector-ref bundle 1) root) 1)))
    (unless (and (= acquisitions size) (equal? answer expected))
      (error "owned reachability query replayed an author" size acquisitions))
    (display "GRAPH-OWNED-INDEX ")
    (write (list size edges (cons 'author-acquisitions acquisitions)
                 (cons 'cold-owner-capture-and-query cold) (cons 'prepared-query hot)))
    (newline) (force-output)))

;; The SAME captured rows interpreted as an admitted inverse directory. Charge
;; representation preparation once; subsequent hints must visit only their union.
(def (invalidation-study keys rows last-key size edges)
  (defvalues (inverse preparation)
    (measure (lambda ()
      (def index (make-hash-table-symbolic size: size))
      (for (key keys) (hash-put! index key (hash-ref rows key))) index) 1))
  (def sparse-key (list-ref keys 65))
  (for ((kind '(full sparse))
        (roots (list (list last-key last-key) (list (car keys) sparse-key sparse-key)))
        (reached (list size 66)) (observed-edges (list edges 920)))
    (def work (vector 0 0))
    (def marked (affected-owners inverse roots work))
    (unless (and (= (hash-length marked) reached)
                 (= (vector-ref work 0) reached) (= (vector-ref work 1) observed-edges))
      (error "inverse worklist repeated or omitted a bucket/edge" size kind work))
    (let-values (((answer costs) (measure (cut affected-owners inverse roots) 1)))
      (unless (and (= (hash-length answer) reached)
                   (andmap (cut hash-key? answer <>)
                     (if (eq? kind 'full) keys (take keys 66))))
        (error "inverse timed closure identity/cardinality"))
      (display "GRAPH-INVALIDATION ")
      (write (list size edges kind (cons 'reached-owners reached)
                   (cons 'index-preparation preparation) (cons 'work work) costs))
      (newline) (force-output))))

(def (shared-workspace-study index keys expected family size edges)
  (let (observations [])
    (for (engine '(separate shared shared separate))
      (let-values (((result costs) (measure
                    (lambda () ((if (eq? engine 'separate) prior-compact-discover compact-discover) index)) 1)))
        (vector-set! result 0 (compact-component-owners index result))
        (check-discovery result keys expected size (length expected) edges)
        (set! observations (cons (list engine costs) observations))))
    (display "GRAPH-SHARED-PAIR ")
    (write (list family size edges '(order . (separate shared shared separate)) (reverse observations)))
    (newline) (force-output)))

;; The SAME degree-16 cyclic band as the failed overlapping-phase fixture: all
;; predecessor edges plus 0 -> last, exactly 1,000,000 owners/15,999,865 edges.
;; Its own TestCase releases the previous cold-capture call frames first. Numeric
;; fixture construction avoids retaining an unnecessary E-cell symbolic copy.
(def (shared-cyclic-study)
  (def size 1000000)
  (def edges (1+ (- (* 16 size) 136)))
  (defvalues (cyclic preparation)
    (measure (lambda ()
      (def owner-names (names size))
      (def positions (make-hash-table-symbolic size: size))
      (def offsets (make-u32vector (1+ size) 0))
      (def targets (make-u32vector edges 0))
      (for (node (in-range size)) (hash-put! positions (vector-ref owner-names node) node))
      (u32vector-set! targets 0 (1- size))
      (let owner ((node 1) (cursor 1))
        (u32vector-set! offsets node cursor)
        (if (= node size)
          (unless (= cursor edges) (error "cyclic band exact edge count" cursor edges))
          (let fill ((distance 1) (cursor cursor))
            (if (> distance (min node 16)) (owner (1+ node) cursor)
              (begin
                (u32vector-set! targets cursor (- node distance))
                (fill (1+ distance) (1+ cursor)))))))
      (make-compact-graph owner-names positions offsets targets 0)) 1))
  (def keys (vector->list (compact-graph-names cyclic)))
  (display "GRAPH-SHARED-INPUT ")
  (write (list 'cyclic-band size edges preparation)) (newline) (force-output)
  (shared-workspace-study cyclic keys (list keys) 'cyclic-band size edges)
  (displayln "GRAPH-SHARED-CYCLIC-OK nodes=1000000 edges=15999865"))

(def (compact-study)
  (for* ((size '(100000 1000000)) (family '(chain ring band)))
    ;; A pure frozen provider models the existing streaming source interface.
    ;; It retains N names/positions, not an extra E-sized adjacency copy. Both
    ;; cold engines pay exactly the same N row generations inside their timer.
    (defvalues (source source-preparation)
      (measure (lambda ()
        (let* ((names (names size)) (keys (vector->list names))
               (positions (make-hash-table-eq size: size)))
          (for (i (in-range size)) (hash-put! positions (vector-ref names i) i))
          (vector keys (lambda (key) (family-reads family names size (hash-ref positions key)))))) 1))
    (def keys (vector-ref source 0)) (def read-owner (vector-ref source 1))
    (def edges (case family ((chain) (1- size)) ((band) (- (* 16 size) 136)) (else size)))
    (discovery-study read-owner keys family size (family-groups family size) edges source-preparation)
    ;; The original STORED adjacency workload is independently materialized,
    ;; charged and retained for the following full-edge encoding/query windows.
    (defvalues (rows preparation)
      (measure (lambda ()
        (let (rows (make-hash-table-eq size: size))
          (for (key keys) (hash-put! rows key (read-owner key))) rows)) 1))
    (vector-set! source 1 #f) (set! read-owner #f)
    (reachability-study rows keys family size edges)
    (def reverse-keys (reverse keys))
    (def root (car (if (eq? family 'band) reverse-keys keys)))
    (def expected (if (eq? family 'band) keys reverse-keys))
    ;; Charge encoding AND first query in one enclosing cold window. Inner
    ;; diagnostics do not let conversion disappear from the reported total.
    (defvalues (bundle cold)
      (measure (lambda ()
        (defvalues (index encoded) (measure (cut capture-compact keys rows edges) 1))
        (defvalues (answer first) (measure (cut compact-reachable index root) 1))
        (vector index encoded first answer)) 1))
    (unless (equal? (vector-ref bundle 3) expected) (error "compact cold order" family size))
    (vector-set! bundle 3 #f)
    (def index (vector-ref bundle 0))
    (def samples [])
    (for (side '(hash compact compact hash))
      (let-values (((answer costs) (measure
                     (lambda () (if (eq? side 'hash) (hash-reachable rows root) (compact-reachable index root))) 1)))
        (unless (equal? answer expected) (error "compact paired order" family size side))
        (set! samples (cons (list side costs) samples))))
    ;; Same admitted index, tiny NONEMPTY closures. Deterministic allocation
    ;; events are callback-free and untimed; ordinary EVAL timings use no probe.
    (when (eq? family 'band)
      (for (reached '(2 66))
        (def start (vector-ref (compact-graph-names index) (1- reached)))
        (def expected-small (vector->list (vector-copy (compact-graph-names index) 0 reached)))
        (def allocation (vector 0 0 0))
        (unless (and (equal? (compact-reachable index start allocation) expected-small)
                     (= (vector-ref allocation 0) 0)
                     (<= (vector-ref allocation 1) (* 8 reached))
                     (<= (vector-ref allocation 2) (* 4 reached))
                     (or (> reached 64) (equal? allocation '#(0 0 0))))
          (error "sparse query allocated whole-support workspace" size reached allocation))
        (let-values (((answer costs) (measure (cut compact-reachable index start) 1000)))
          (unless (equal? answer expected-small) (error "sparse nonempty query order"))
          (display "GRAPH-COMPACT-SPARSE ")
          (write (list size reached '(repetitions . 1000) (cons 'allocation-events allocation) costs))
          (newline) (force-output))))
    ;; Complete SCC traversal and symbolic output are separate charged phases.
    ;; Its actual counters require N entries/finishes/pops and EVERY input edge.
    (defvalues (scc-result scc-cost) (measure (cut compact-discover index) 1))
    (defvalues (owner-map owner-cost) (measure (cut compact-component-owners index scc-result) 1))
    (vector-set! scc-result 0 owner-map)
    (check-discovery scc-result keys (family-groups family size) size
      (if (eq? family 'ring) 1 size) edges)
    ;; The SAME packed rows, general DFS versus source-rank selection. Preserve
    ;; natural GC and charge every result vector allocation inside its window.
    (let (observations [])
      (for (engine '(tarjan selected selected tarjan))
        (let-values (((result costs) (measure
                      (lambda () ((if (eq? engine 'tarjan) compact-discover compact-selected-discover) index)) 1)))
          (vector-set! result 0 (compact-component-owners index result))
          (check-discovery result keys (family-groups family size) size
            (if (eq? family 'ring) 1 size) edges)
          (set! observations (cons (list engine costs) observations))))
      (display "GRAPH-RANK-PAIR ")
      (write (list family size edges '(order . (tarjan selected selected tarjan)) (reverse observations)))
      (newline) (force-output))
    (shared-workspace-study index keys (family-groups family size) family size edges)
    (display "GRAPH-COMPACT-SCC ")
    (write (list family size edges (cons 'discovery scc-cost) (cons 'symbolic-output owner-cost)))
    (newline) (force-output)
    (display "GRAPH-COMPACT-PAIR ")
    (write (list family size edges (cons 'source-preparation source-preparation)
                 (cons 'input-preparation preparation)
                 (cons 'cold-encode-and-first-query cold) (cons 'encoding (vector-ref bundle 1))
                 (cons 'first-query (vector-ref bundle 2)) (reverse samples)))
    (newline) (force-output)
    ;; Later public capture needs ROWS but not this prepared CSR. Retire both
    ;; index aliases and old SCC outputs before that next allocation phase.
    (when (eq? family 'band)
      (set! owner-map #f) (vector-set! scc-result 0 #f)
      (set! reverse-keys #f)
      (vector-set! bundle 0 #f) (set! index #f)
      (owned-query-study keys rows root expected size edges)
      (invalidation-study keys rows root size edges)))
  (displayln "GRAPH-DISCOVERY-PAIRED-OK observations=48 sizes=100000,1000000")
  (displayln "GRAPH-REACHABILITY-SCALE-OK full=6 sparse=2")
  (displayln "GRAPH-COMPACT-OK nodes=100000,1000000 shapes=chain,ring,band"))
