(export feedback-revision-test)
(import :std/test :clan/poo/object :clan/poo/mop :clan/poo/brace :clan/poo/generalized-closure
        :clan/poo/feedback-closure :clan/poo/lens-laws (prefix-in :clan/poo/examples/shared-feedback service.)
        (prefix-in (only-in :clan/poo/fun Observation.) fun.))
;; Shared dependency invalidation, cross-service feedback and exact-candidate approval.
(def feedback-revision-test
  (test-suite "shared cyclic feedback and cross-service revision"
    (test-case "one shared quota closes both service branches before joint publication"
      (def policy (.o (quota 3) (limit 12))) (def approval (.o (allowed #t)))
      (defvalues (closed failure) (service.revise #f policy approval))
      (check-equal? failure #f) (check-equal? (closed-steps closed) 6)
      (check-equal? (service.report closed 2) '(3 24 36 60 #t audit))
      (check-equal? (service.report closed 3) '(3 36 54 90 #t audit))
      (check-equal? service.base (vector 0 (vector 0 0) (vector 0 0) #f 'audit)))
    (test-case "increasing and decreasing shared quota re-close both services from old raw"
      (def policy (.o (quota 3) (limit 12))) (def approval (.o (allowed #t)))
      (defvalues (old _) (service.revise #f policy approval))
      (.putslot! policy 'quota ($constant-slot-spec 4))
      (.putslot! policy 'limit ($constant-slot-spec 16))
      (defvalues (grown failure) (service.revise old policy approval 4))
      (check-equal? failure #f) (check-equal? (closed-steps grown) 4)
      (check-equal? (service.report grown 2) '(4 32 48 80 #t audit))
      (check-equal? (service.report old 2) '(3 24 36 60 #t audit))
      (.putslot! policy 'quota ($constant-slot-spec 1))
      (.putslot! policy 'limit ($constant-slot-spec 4))
      (defvalues (shrunk ok) (service.revise grown policy approval 4))
      (check-equal? ok #f) (check-equal? (closed-steps shrunk) 4)
      (check-equal? (service.report shrunk 2) '(1 8 12 20 #t audit)))
    (test-case "closed but overcommitted revision retains old family then retries fresh approval"
      (def policy (.o (quota 3) (limit 12))) (def approval (.o (allowed #t)))
      (defvalues (old _) (service.revise #f policy approval))
      (.putslot! policy 'quota ($constant-slot-spec 4))
      (defvalues (held failure) (service.revise old policy approval 4))
      (check (eq? held old) => #t) (check-equal? (feedback-approval-failure-kind failure) 'refused)
      (check-equal? (service.report held 2) '(3 24 36 60 #t audit))
      (.putslot! policy 'limit ($constant-slot-spec 16))
      (defvalues (next ok) (service.revise old policy approval 4))
      (check-equal? ok #f) (check-equal? (service.report next 2) '(4 32 48 80 #t audit)))
    (test-case "unchanged raw still receives current approval and non-Boolean results refuse"
      (def policy (.o (quota 3) (limit 12))) (def approval (.o (allowed #t)))
      (defvalues (old _) (service.revise #f policy approval))
      (def prepared (service.prepare-services policy approval)) (def calls 0)
      (defvalues (same ok) (publish-feedback-revision old prepared service.base 1
        (lambda (prior next)
          (set! calls (+ calls 1)) (check (eq? prior old) => #t)
          (check-equal? (service.report next 2) '(3 24 36 60 #t audit)) #t)))
      (check-equal? ok #f) (check-equal? calls 1) (check-equal? (closed-steps same) 1)
      (defvalues (held failure) (publish-feedback-revision old prepared service.base 1 (lambda (_ __) 'yes)))
      (check (eq? held old) => #t) (check-equal? (feedback-approval-failure-kind failure) 'non-boolean)
      (.putslot! approval 'allowed ($constant-slot-spec #f))
      (defvalues (refused cause) (service.revise old policy approval 1))
      (check (eq? refused old) => #t) (check-equal? (feedback-approval-failure-kind cause) 'refused))
    (test-case "stale preparation refuses before approval and insufficient warm budget exposes no prefix"
      (def policy (.o (quota 3) (limit 12))) (def approval (.o (allowed #t)))
      (defvalues (old _) (service.revise #f policy approval))
      (def prepared (service.prepare-services policy approval)) (def reached? #f)
      (.putslot! policy 'quota ($constant-slot-spec 1))
      (defvalues (held stale) (publish-feedback-revision old prepared service.base 4
        (lambda (_ __) (set! reached? #t) #t)))
      (check (eq? held old) => #t) (check (not (not stale)) => #t) (check-equal? reached? #f)
      (defvalues (same exhausted) (service.revise old policy approval 3))
      (check (eq? same old) => #t) (check-equal? (closure-failure-kind exhausted) 'budget)
      (check-equal? (service.report old 2) '(3 24 36 60 #t audit)))
    (test-case "registered approval sources stay protected through the complete admission callback"
      (def policy (.o (quota 3) (limit 12))) (def approval (.o (allowed #t)))
      (def extra (.o (value 1)))
      (def focus (lens-of-get-set identity (lambda (value _) value)))
      (def guard-check (lens-check focus [service.base] sources: [extra]))
      (def prepared (service.prepare-services policy approval))
      (defvalues (held failure) (publish-feedback-revision #f prepared service.base 6
        (lambda (_ __) (.putslot! extra 'value ($constant-slot-spec 2)) #t) checks: [guard-check]))
      (check-equal? held #f) (check (not (not failure)) => #t) (check-equal? (.@ extra value) 1)
      (defvalues (old refused) (publish-feedback-revision #f prepared service.base 6
        (lambda (_ __) (.putslot! policy 'limit ($constant-slot-spec 99)) #t)))
      (check-equal? old #f) (check (not (not refused)) => #t) (check-equal? (.@ policy limit) 12)
      (defvalues (same blocked) (publish-feedback-revision #f prepared service.base 6
        (lambda (_ __) (.putslot! approval 'allowed ($constant-slot-spec #f)) #t)))
      (check-equal? same #f) (check (not (not blocked)) => #t) (check-equal? (.@ approval allowed) #t)
      (check-equal? (active-object-constructions) []))
    (test-case "preparation errors and approval exceptions retain the exact old family"
      (def policy (.o (quota 3) (limit 12))) (def approval (.o (allowed #t)))
      (defvalues (old _) (service.revise #f policy approval))
      (.putslot! policy 'quota ($constant-slot-spec -1))
      (defvalues (held invalid) (service.revise old policy approval))
      (check (eq? held old) => #t) (check (not (not invalid)) => #t)
      (.putslot! policy 'quota ($constant-slot-spec 3))
      (.putslot! policy 'limit ($constant-slot-spec 12.5))
      (defvalues (same malformed) (service.revise old policy approval))
      (check (eq? same old) => #t) (check (not (not malformed)) => #t)
      (.putslot! policy 'limit ($constant-slot-spec 12))
      (defvalues (prior unavailable) (publish-feedback-revision old (service.prepare-services policy approval)
        service.base 1 (lambda (_ __) (error "approval unavailable"))))
      (check (eq? prior old) => #t) (check (not (not unavailable)) => #t)
      (check-equal? (service.report old 2) '(3 24 36 60 #t audit)))
    (test-case "Reader composition short-circuits joint refusal and observes accepted candidate"
      (def policy (.o (quota 3) (limit 12))) (def approval (.o (allowed #t)))
      (def prepared (service.prepare-services policy approval)) (def reached? #f)
      (def denied (.call fun.Observation. .map (lambda (_) (set! reached? #t))
        (feedback-revision-action prepared service.base 6 (lambda (_ __) #f))))
      (check-exception (denied #f) true) (check-equal? reached? #f)
      (def allowed (.call fun.Observation. .map (lambda (candidate) (service.report candidate 2))
        (feedback-revision-action prepared service.base 6 (service.admit policy approval))))
      (check-equal? (allowed #f) '(3 24 36 60 #t audit)))) )
