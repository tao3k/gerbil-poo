;;; Graph properties and scale accounting through the existing POO APIs.
(export graph-algorithms-test main small-reachability-study compact-study shared-cyclic-study)
(import :std/test :std/iter :clan/poo/object :clan/poo/mop
        (only-in :std/error Error? Error-message Error-irritants UnboundKeyError?)
        (only-in :gerbil/runtime/gambit string->uninterned-symbol)
        (only-in :gerbil/runtime/interface interface-instance-object)
        (only-in :gerbil/runtime/hash symbol-hash-table? HashTable::interface)
        (prefix-in (only-in :gerbil/runtime/mop slot-ref slot-set!) runtime.)
        (only-in :gerbil/runtime/table symbolic-table-ref symbolic-table-set!)
        :clan/poo/type :clan/poo/number (prefix-in :clan/poo/testing/type typed.)
        (only-in :clan/poo/support/testing require-property-passed)
        (only-in :clan/poo/support/index %make-ordinal-buckets %ordinal-bucket-ref)
        (rename-in (only-in :clan/poo/benchmarks/closure-measure measure qualified-metrics) (measure raw-measure))
        (only-in :std/list/list filter foldl find take append-map delete-duplicates/hash)
        (prefix-in :clan/poo/generalized-graph graph.)
        (prefix-in :clan/poo/dependency-analysis code.)
        (prefix-in :clan/poo/strong-components scc.)
        (prefix-in :clan/poo/recursive-topology topology.)
        (prefix-in :clan/poo/component-revision component.))
;; Graph receipts use the existing paired-study allocation admission rule.
;; Only the post-timer projection changes; workload, clocks and GC stay intact.
(def (measure thunk repetitions (collect? #f))
  (let-values (((result metrics) (raw-measure thunk repetitions collect?)))
    (values result (qualified-metrics metrics))))

(include "graph-algorithms/baseline.ss")
(include "graph-algorithms/discovery-study.ss")
(include "graph-algorithms/compact.ss")

(def (names size)
  (list->vector (for/collect (i (in-range size))
    (string->symbol (string-append "graph-owner-" (number->string i))))))
(def (source keys rows)
  (graph.declaration (vector->list keys)
    (for/collect (i (in-range (vector-length keys)))
      (cons (vector-ref keys i)
        (.cc code.Computation.
          reads: (vector-ref rows i)
          .evaluate: (lambda (_) (error "partition must not evaluate business code")))))))

;; Independent all-source reachability is bounded to small property inputs.
;; It shares no lowlink, active-stack or component-number implementation.
(def (oracle-groups keys rows)
  (def adjacency (make-hash-table-eq))
  (def reach (make-hash-table-eq))
  (def assigned (make-hash-table-eq))
  (for ((key (vector->list keys)) (i (in-range (vector-length keys))))
    (hash-put! adjacency key (vector-ref rows i)))
  (for (root (vector->list keys))
    (let (seen (make-hash-table-eq))
      (let walk ((pending (list root)))
        (unless (null? pending)
          (let ((key (car pending)) (rest (cdr pending)))
            (if (hash-key? seen key) (walk rest)
              (begin (hash-put! seen key #t) (walk (append rest (hash-ref adjacency key))))))))
      (hash-put! reach root seen)))
  (reverse (foldl (lambda (key result)
    (if (hash-key? assigned key) result
      (let (members (filter (lambda (other)
                     (and (hash-key? (hash-ref reach key) other)
                          (hash-key? (hash-ref reach other) key))) (vector->list keys)))
        (for (member members) (hash-put! assigned member #t))
        (cons members result)))) [] (vector->list keys))))

(def (matches? keys rows (declare source))
  (let* ((expected (oracle-groups keys rows)) (part (scc.partition (declare keys rows))))
    (and (equal? expected (scc.partition-groups part))
      (let rows-exact ((i 0))
        (or (= i (vector-length keys))
          (and (equal? ((scc.partition-reads part) (vector-ref keys i))
                       (delete-duplicates/hash (vector-ref rows i)))
               (rows-exact (1+ i)))))
      (discovery-controls part (vector->list keys) rows)
      (equal? expected (baseline-partition (source keys rows)))
      (andmap (lambda (members)
        (and (equal? (scc.partition-members part (car members)) members)
          (andmap (lambda (key) (eq? ((scc.partition-owner part) key) (car members))) members))) expected))))

(extern namespace: clan/poo/generalized-graph %declared-row-source %packed-rows?)
(def (check-declared-rows)
  (test-case "packed declaration owns its arrays and respects observed and stale reads"
    (def keys (vector 'a 'b 'c 'd))
    (def offsets (u32vector 0 2 3 4 5))
    (def targets (u32vector 1 2 0 3 2))
    (def spec (graph.declaration/rows keys offsets
      (lambda _ (error "partition evaluated a provider")) targets: targets))
    (def publication (%declared-row-source spec))
    (check (%packed-rows? publication) => #t)
    (vector-set! keys 0 'changed)
    (u32vector-set! offsets 1 0)
    (u32vector-set! targets 0 3)
    (def partition (scc.partition spec))
    (check-eq? (%declared-row-source spec) publication)
    (check-equal? (scc.partition-groups partition) '((a b) (c d)))
    (check-equal? ((scc.partition-reads partition) 'a) '(b c))
    (check-equal? (scc.partition-groups (scc.partition-owned spec)) '((a b) (c d)))
    (def trace [])
    (def observed (call-with-slot-read-observer
      (lambda (read) (set! trace (cons (slot-read-key read) trace)))
      (lambda () (scc.partition spec))))
    (check-equal? (reverse trace) '(keys .code reads .code reads .code reads .code reads))
    (check-equal? (scc.partition-groups observed) (scc.partition-groups partition))
    (uninstantiate-object! spec)
    (check (%declared-row-source spec) => #f)
    (check-equal? (scc.partition-groups (scc.partition spec)) (scc.partition-groups partition)))
  (test-case "packed admission refuses in owner order and preserves repeated public arcs"
    (def (expected message irritants)
      (lambda (cause) (and (Error? cause) (equal? (Error-message cause) message)
                           (equal? (Error-irritants cause) irritants))))
    (check-exception
      (graph.declaration/rows '#(a b) '#u32(0 1 2) void targets: '#u32(2 3))
      (expected "unsupported component ordinal" '(a 2)))
    (check-exception
      (graph.declaration/rows '#(a a) '#u32(0 1 2) void targets: '#u32(2 3))
      (expected "distinct captured owners required" []))
    (def spec (graph.declaration/rows '#(a b c) '#u32(0 3 3 3) void targets: '#u32(1 2 1)))
    (check (%declared-row-source spec) => #f)
    (check-equal? (.get (.call spec .code 'a) reads) '(b c b))
    (check-equal? ((scc.partition-reads (scc.partition spec)) 'a) '(c b)))
  (test-case "Declared rows share SCC validation and remain owned by the issuing graph"
    (def keys (list 'a 'b 'c 'd))
    (def row (list 'b 'c 'b))
    (def rows (vector row (list 'a) [] #f))
    (def evaluations [])
    (def spec (graph.declaration/rows keys rows (lambda (key provider)
      (set! evaluations (cons key evaluations)) (provider key))))
    (check (vector? (%declared-row-source spec)) => #t)
    (set-car! keys 'wrong)
    (set-car! row 'wrong)
    (vector-set! rows 1 #f)
    (set-car! (.get spec keys) 'wrong)
    (def part (scc.partition spec))
    (def owned (scc.partition-owned spec))
    (check-equal? (scc.partition-groups part) '((a b) (c) (d)))
    (check-equal? (scc.partition-groups owned) (scc.partition-groups part))
    (check-equal? ((scc.partition-reads part) 'a) '(c b))
    (check-equal? ((scc.partition-reads owned) 'a) '(c b))
    (check-equal? evaluations [])
    (check (not (.call spec .code 'd)) => #t)
    (def program (.call spec .code 'c))
    (check-equal? (.get program reads) [])
    (check-eq? (.call program .evaluate identity) 'c)
    (check-equal? evaluations '(c))
    (set-car! (.get (.call spec .code 'a) reads) 'wrong)
    (check-equal? (.get (.call spec .code 'a) reads) '(b c b))
    (def trace [])
    (def prechecks [])
    (def observed (call-with-slot-read-observer
      (lambda (read) (set! trace (cons (slot-read-key read) trace)))
      (lambda () (scc.partition spec))
      before: (lambda (_ key) (set! prechecks (cons key prechecks)))))
    (check-equal? (scc.partition-groups observed) (scc.partition-groups part))
    (check-equal? (reverse trace) '(keys .code reads .code reads .code reads .code))
    (check-equal? prechecks trace)
    (def edited (graph.define spec 'b #f))
    (check (%declared-row-source edited) => #f)
    (check-equal? (scc.partition-groups (scc.partition edited)) '((a) (b) (c) (d)))
    (uninstantiate-object! spec)
    (check (%declared-row-source spec) => #f)
    (check-equal? (scc.partition-groups (scc.partition spec)) (scc.partition-groups part)))
  (test-case "Declared row refusal reports the first owner without lending its row"
    (def spec (graph.declaration/rows '(a b c) (vector '(absent-a) '(absent-b) [])
      (lambda _ (error "partition must not evaluate a provider"))))
    (def (irritants)
      (try (scc.partition spec) (error "expected refusal")
        (catch (cause) (and (Error? cause)
          (equal? (Error-message cause) "unsupported component read") (Error-irritants cause)))))
    (def first (irritants))
    (check-equal? first '(a (absent-a)))
    (set-car! (cadr first) 'c)
    (check-equal? (irritants) '(a (absent-a)))
    (check-exception (scc.partition (graph.declaration/rows '(a a) #(#f #f) void)) true)))

(def (family-reads family keys size i)
  (case family
      ((isolated) [])
      ((self) (list (vector-ref keys i)))
      ((chain) (if (< (1+ i) size) (list (vector-ref keys (1+ i))) []))
      ((pairs) (list (vector-ref keys (if (even? i) (1+ i) (1- i)))))
      ((ring) (list (vector-ref keys (modulo (1+ i) size))))
      ((hub) (if (zero? i) [] (list (vector-ref keys 0))))
      ((band) (filter identity (for/collect (offset (in-range 1 17))
                (and (>= (- i offset) 0) (vector-ref keys (- i offset))))))
      (else (error "unknown graph family" family))))

(def (family-source family size)
  (def keys (names size))
  (source keys (list->vector (for/collect (i (in-range size))
    (family-reads family keys size i)))))

;; Capacity is graph metadata, not one retained business provider per node.
;; The existing Declaration getter produces inert metadata from a frozen key
;; index; partition captures each footprint once. No loader or value cache.
(def (metadata-family-source family size)
  (def keys (names size))
  (def positions (make-hash-table-eq))
  (for (i (in-range size)) (hash-put! positions (vector-ref keys i) i))
  (.cc graph.Declaration. keys: (vector->list keys)
    .code: (lambda (key)
      (.cc code.Computation. reads: (family-reads family keys size (hash-ref positions key))
        .evaluate: (lambda (_) (error "Graph capacity must not evaluate a provider"))))
    .base: (lambda (_) #f)))

(def (metadata-getter-counts spec)
  (def count 0)
  (def edges 0)
  (for (key (.@ spec keys))
    (let* ((program (.call spec .code key)) (row (if program (.@ program reads) [])))
      (set! count (1+ count)) (set! edges (+ edges (length row)))))
  (vector count edges))

(def (family-groups family size)
  (def keys (names size))
  (case family
    ((ring) (list (vector->list keys)))
    ((pairs) (for/collect (i (in-range (quotient size 2)))
               (list (vector-ref keys (* 2 i)) (vector-ref keys (1+ (* 2 i))))))
    (else (map list (vector->list keys)))))
(def (check-scale part family size)
  (def groups (scc.partition-groups part))
  (def work (scc.partition-work part))
  (def edges (case family ((isolated) 0) ((chain hub) (1- size))
               ((band) (- (* 16 size) 136)) (else size)))
  (def nontrivial? (memq family '(pairs ring)))
  (def ranked? (not nontrivial?))
  (def ring? (eq? family 'ring))
  (unless (and (= (.@ work discoveries) (if ranked? 0 size))
               (= (.@ work finishes) (cond (ranked? 0) (ring? 1) (else size)))
               (= (.@ work member-pops) (if (eq? family 'pairs) size 0))
               (= (.@ work bulk-retired) (if ring? size 0))
               (= (.@ work normalization-owners) size)
               (= (.@ work validation-edges) edges)
               (= (.@ work edge-visits) (if ranked? 0 edges))
               (= (.@ work rank-owners) (if ranked? size 0))
               (= (.@ work rank-edges) (if ranked? edges 0))
               (= (.@ work certificate-buckets) (if nontrivial? (* 2 size) 0))
               (= (.@ work certificate-edges) (if nontrivial? (* 2 edges) 0))
               (= (.@ work certificate-singletons) (if nontrivial? 0 size))
               (= (.@ work reverse-edges) (if nontrivial? edges 0))
               (= (.@ work quotient-edges) edges)
               (equal? groups (family-groups family size))
               (= (foldl (lambda (members total) (+ total (length members))) 0 groups) size)
               (andmap (lambda (members)
                 (and (eq? members (scc.partition-members part (car members)))
                   (andmap (lambda (key) (eq? ((scc.partition-owner part) key) (car members))) members))) groups))
    (error "linear SCC work/group oracle" family size))
  #t)


;; Frozen membership-observation rule, bounded to small differential inputs.
;; It deliberately shares neither owner lookup nor per-group verdicts.
(def (membership-oracle before after)
  (def old (scc.partition-groups before))
  (def fresh (scc.partition-groups after))
  (def (group groups node) (find (lambda (members) (memq node members)) groups))
  (filter (lambda (node)
    (let ((left (group old node)) (right (group fresh node)))
      (not (and left right (= (length left) (length right))
        (andmap (cut memq <> right) left)))))
    (delete-duplicates/hash (apply append (append old fresh)))))
(def (change-matches? before after)
  (equal? (membership-oracle before after) (topology.changed-members before after)))
(def (group-partition groups)
  (def keys (append-map reverse groups))
  (def rows (make-hash-table-eq))
  (for (members groups)
    (for ((key members) (next (append (cdr members) (list (car members)))))
      (hash-put! rows key next)))
  (scc.partition (.cc graph.Declaration. keys: keys
    .code: (lambda (key) (.cc code.Computation. reads: (list (hash-ref rows key))
      .evaluate: (lambda (_) (error "membership metadata is not a provider"))))
    .base: (lambda (_) #f))))

(def (comparison-input kind size)
  (def keys (vector->list (names size)))
  (case kind
    ((giant-unchanged) (values (group-partition (list keys))
                              (group-partition (list (reverse keys))) []))
    ((isolated-unchanged) (values (group-partition (map list keys))
                                 (group-partition (map list (reverse keys))) []))
    ((merge) (values (group-partition (map list keys)) (group-partition (list keys)) keys))
    ((split) (values (group-partition (list keys)) (group-partition (map list keys)) keys))
    ((pairs-unchanged)
     (let (groups (family-groups 'pairs size))
       (values (group-partition groups) (group-partition (map reverse (reverse groups))) [])))
    (else (error "unknown membership comparison" kind))))

;; changed-members observes only groups and the existing owner/member indices.
;; Reuse public capacity partitions; a reordered historical view is independently
;; repartitioned/certified from its captured rows, without new author getters.
(def (reordered-partition part keys)
  (def rows (captured-rows part keys))
  (partition-captured keys rows (.@ (scc.partition-work part) quotient-edges) 0 0))

(def (prepared-comparison kind size single pairs giant)
  (def keys (vector->list (names size)))
  (case kind
    ((giant-unchanged) (values giant (reordered-partition giant (reverse keys)) []))
    ((isolated-unchanged) (values single (reordered-partition single (reverse keys)) []))
    ((merge) (values single giant keys))
    ((split) (values giant single keys))
    ((pairs-unchanged) (values pairs (reordered-partition pairs (reverse keys)) []))
    (else (error "unknown prepared membership comparison" kind))))

(def (membership-observation part keys)
  (list (scc.partition-groups part)
    (map (lambda (key) (list ((scc.partition-owner part) key)
                             (scc.partition-group-of part key)
                             (scc.partition-group-size part key)
                             (scc.partition-members part key))) keys)))

(def (membership-capacity size single pairs giant)
  (for (kind (if (= size 100000) '(giant-unchanged isolated-unchanged merge split pairs-unchanged)
                                    '(giant-unchanged merge split)))
    (let-values (((inputs preparation) (measure
                   (lambda () (let-values (((before after expected)
                                  (prepared-comparison kind size single pairs giant)))
                     (vector before after expected))) 1)))
      (let-values (((result comparison) (measure
                     (lambda () (topology.changed-members (vector-ref inputs 0) (vector-ref inputs 1))) 1)))
        (unless (equal? result (vector-ref inputs 2)) (error "membership scale oracle" size kind))
        (display "GRAPH-MEMBERSHIP-SCALE ")
        (write (list kind size (cons 'captured-partition-preparation preparation)
                     (cons 'indexed-comparison comparison))) (newline)))))

(extern namespace: clan/poo/strong-components partition-captured finish-partition %partition-members %partition-groups)

(def (check-certificate-refusal)
  (test-case "independent SCC certificate reports the first bad owner"
    (def (refuses message irritants keys rows)
      (def owners (list->hash-table-eq '((a . 0) (b . 0) (c . 1) (d . 2))))
      (check-exception
        (finish-partition keys (list->hash-table-eq rows) 4 2 owners 4 3 2 4 4)
        (lambda (cause)
          (and (Error? cause) (equal? (Error-message cause) message)
               (equal? (Error-irritants cause) irritants)))))
    ;; b cannot return to a. Its invalid outgoing quotient edge must not
    ;; take precedence over the spanning failure on that same owner.
    (refuses "invalid SCC spanning certificate" '(b)
      '(a b c d) '((a b) (b d) (c) (d)))
    ;; Here an earlier owner has a bad quotient edge. A later missing span
    ;; must not hide that earlier failure.
    (refuses "invalid SCC quotient certificate" '(c d)
      '(c d a b) '((a b) (b) (c d) (d)))))

;; Separate registration closures so Gambit emits smaller C host functions.
(def (check-graph-properties)
    (test-case "Graph receipts qualify allocation across GC without changing time"
      (for (input '(#(1 2 3 0 0) #(1 2 3 0 208) #(1 2 3 0 -208)
                    #(1 2 3 1 208) #(1 2 3 1 9999999999999999)))
        (def qualified (qualified-metrics input))
        (check-equal? (vector-copy qualified 0 4) (vector-copy input 0 4))
        (check-equal? qualified (qualified-metrics qualified))
        (check-equal? (vector-ref qualified 4)
          (and (= (vector-ref input 3) 0) (>= (vector-ref input 4) 0) (vector-ref input 4))))
      ;; Same payload in both regimes. The actual raw counter under-reports this
      ;; payload across requested collections on the current runtime. The report
      ;; must say unavailable, not turn that counter into an allocation gain.
      (for (collect-inside? '(#f #t))
        (defvalues (answer costs)
          (measure (lambda ()
            (let loop ((left 8) (sum 0))
              (if (zero? left) sum
                (let (buffer (make-u8vector 1048576 left))
                  (when (and collect-inside? (even? left)) (##gc))
                  (loop (1- left) (+ sum (u8vector-ref buffer 0))))))) 1 #t))
        (check-equal? answer 36)
        (if (zero? (vector-ref costs 3))
          (check (>= (vector-ref costs 4) 8388608) => #t)
          (check-equal? (vector-ref costs 4) #f))
        (when collect-inside? (check (>= (vector-ref costs 3) 4) => #t))))
    (test-case "author edits to caller keys cannot rename a captured owner"
      (def (mutating-source)
        (def owner-keys (list 'a 'b 'c))
        (def (read-row key)
          (when (eq? key 'a) (set-car! (cdr owner-keys) 'rogue))
          (if (eq? key 'a) '(b) []))
        (.o keys: owner-keys .reads: read-row
          .code: (lambda (key) (let (dependencies (read-row key)) (.o reads: dependencies)))))
      (def index (scc.capture-reachability (mutating-source)))
      (check-equal? (.call index .reachable 'a) '(b a))
      (check-equal? (scc.partition-groups (scc.partition (mutating-source))) '((a) (b) (c)))
      (def keys (list 'a 'b 'a 'c))
      (def program (.o reads: (begin (set-car! (cdr keys) 'rogue) '(b))))
      (def schedule (graph.schedule-owned keys (list (cons 'a program))))
      (check-equal? (graph.schedule-order schedule) '(b a c))
      (check-equal? (graph.schedule-supports? schedule 'rogue) #f))
    (test-case "all 512 directed three-owner graphs agree with reachability"
      (def keys (names 3))
      (def failure #f)
      (for (mask (in-range 512))
        (let (rows (list->vector (for/collect (i (in-range 3))
                     (for/collect (j (in-range 3))
                       (if (odd? (quotient mask (expt 2 (+ (* i 3) j)))) (vector-ref keys j) #f)))))
          (for (i (in-range 3)) (vector-set! rows i (filter identity (vector-ref rows i))))
          (unless (or (matches? keys rows) failure)
            (set! failure (list mask (oracle-groups keys rows)
              (scc.partition-groups (scc.partition (source keys rows))))))))
      (check-equal? failure #f)))

(def (check-generated-graphs)
    (test-case "native POO generators cover arbitrary edges and duplicate footprints"
      (require-property-passed (typed.check-property (Tuple UInt (List Bool))
        (lambda (input)
          (def size (1+ (modulo (vector-ref input 0) 8)))
          (def keys (names size))
          (def bits (list->vector (vector-ref input 1)))
          (def rows (list->vector (for/collect (i (in-range size))
            (filter identity (for/collect (j (in-range size))
              (and (positive? (vector-length bits))
                (vector-ref bits (modulo (+ (* i size) j) (vector-length bits)))
                (vector-ref keys j)))))))
          (and (change-matches? (scc.partition (source keys rows))
                 (scc.partition (source keys
                   (list->vector (for/collect (i (in-range size))
                     (filter (lambda (key) (not (memq key (vector-ref rows i))))
                       (vector->list keys)))))))
            (matches? keys rows)
            (matches? keys (list->vector (map (lambda (row) (append row row)) (vector->list rows)))
              (lambda (keys rows)
                (graph.declaration/rows (vector->list keys) rows
                  (lambda _ (error "partition must not evaluate a provider")))))
            (matches? (list->vector (reverse (vector->list keys)))
              (list->vector (reverse (vector->list rows))))
            (matches? keys (list->vector (for/collect (i (in-range size))
              (filter identity (for/collect (j (in-range size))
                (and (memq (vector-ref keys i) (vector-ref rows j)) (vector-ref keys j)))))))))
        seed: 2947 cases: 256 size: 64))))

(def (check-scale-graphs)
    (test-case "10000-owner shapes visit every node and edge only once"
      (for (family '(isolated self chain pairs ring hub band))
        (check (check-scale (scc.partition (family-source family 10000)) family 10000) => #t))))

(def (check-graph-membership)
    (test-case "indexed membership handles missing equal-size and renamed groups"
      (def before (group-partition '((a b) (c) (removed))))
      (def after (group-partition '((a c) (b) (added))))
      (check-equal? (topology.changed-members before after) '(removed a c b added))
      (check (change-matches? before after) => #t)
      (check-equal? (topology.changed-members before
        (group-partition '((removed) (c) (b a)))) [])
      (def empty (group-partition []))
      (check-equal? (topology.changed-members empty empty) [])
      (check-equal? (topology.changed-members empty before) '(a b c removed))
      (check-equal? (topology.changed-members before empty) '(a b c removed))
      (check-equal? (scc.partition-group-of before 'absent) #f)
      (check-equal? (scc.partition-group-size before 'absent) #f)
      (check-equal? (scc.partition-group-size before 'b) 2)
      (check (eq? (scc.partition-group-of before 'b)
                  (scc.partition-members before 'a)) => #t))
    (test-case "10000-owner membership compares giant merge split and renamed partitions"
      (for (kind '(giant-unchanged isolated-unchanged merge split pairs-unchanged))
        (let-values (((before after expected) (comparison-input kind 10000)))
          (check-equal? (topology.changed-members before after) expected))))
    (test-case "multi-member contributions preserve declaration order"
      (def initial (graph.declaration '(old) []))
      (def revised (component.reconfigure initial
        (list (component.fragment '(a b) [] [])
              (component.fragment '(c d) [] []))))
      (check-equal? (.@ revised keys) '(old a b c d)))
    (test-case "prepared membership fixtures preserve every observed index"
      (def size 16) (def keys (vector->list (names size)))
      (def single (scc.partition (family-source 'self size)))
      (def pairs (scc.partition (family-source 'pairs size)))
      (def giant (scc.partition (family-source 'ring size)))
      (for (kind '(giant-unchanged isolated-unchanged merge split pairs-unchanged))
        (let-values (((old-a old-b expected) (comparison-input kind size))
                     ((new-a new-b actual) (prepared-comparison kind size single pairs giant)))
          (check-equal? actual expected)
          (check-equal? (membership-observation new-a keys) (membership-observation old-a keys))
          (check-equal? (membership-observation new-b keys) (membership-observation old-b keys))
          (check-equal? (topology.changed-members new-a new-b) expected)))))

(def (check-graph-admission)
    (test-case "fused capture preserves rejection trace duplicates and private spines"
      (def observed [])
      (def mutable-row (list 'b))
      (let-values (((reads index declared edges)
                    (capture-graph '(a b) (lambda (key)
                      (set! observed (cons key observed))
                      (if (eq? key 'a) mutable-row
                        (begin (set-car! mutable-row 'outside) []))))))
        (check-equal? (reverse observed) '(a b))
        (check-equal? (hash-ref reads 'a) '(b))
        (check-equal? (compact-row index 'a) '(b))
        (check-equal? (list declared edges) '(1 1)))
      (set! observed [])
      (check-exception (capture-graph '(a b c) (lambda (key)
        (set! observed (cons key observed))
        (case key ((a) '(b b)) ((b) '(outside outside)) (else [])))) error-object?)
      (check-equal? (reverse observed) '(a b))
      (let-values (((reads index declared edges)
                    (capture-graph '(a b c) (lambda (_) '(b c b)))))
        (check-equal? (hash-ref reads 'a) '(c b))
        (check-equal? (compact-row index 'a) '(c b))
        (check-equal? (list declared edges) '(9 6))))
    (test-case "the owner ID index rejects every bad roster before an author"
      (for (roster (list '(a b a) '(a 7 b) '(a . b)
                    (let (cycle (list 'a 'b)) (set-cdr! (cdr cycle) cycle) cycle)))
        (def calls 0)
        (def source (.o keys: roster .reads: (lambda (_) (set! calls (1+ calls)) [])
          .code: (lambda (_) (set! calls (1+ calls)) #f)))
        (check-exception (scc.capture-reachability source) error-object?)
        (check-equal? calls 0)
        (check-exception (scc.partition source) error-object?)
        (check-equal? calls 0)))
    (test-case "pure row admission preserves malformed-row refusal and author boundary"
      (for* ((bad (list 17 "not-an-owner" '(b . c) (vector 'b)))
             (kernel (list separate-admission-capture capture-graph)))
        (def observed [])
        (check-exception (kernel '(a b c) (lambda (key)
          (set! observed (cons key observed))
          (case key ((a) '(b c)) ((b) (list 'a bad 'outside))
            (else (error "refused row crossed its author boundary")))) #f) error-object?)
        (check-equal? (reverse observed) '(a b)))
      (for (kernel (list separate-admission-capture capture-graph))
        (for (bad (list '(a . b) (let (cycle (list 'a 'b))
                                     (set-cdr! (cdr cycle) cycle) cycle)))
          (check-exception (kernel '(a b) (lambda (_) bad) #f) error-object?)))))

(extern namespace: clan/poo/read-route %gc-scratch-routes-current? %standard-symbol-table-lookup?)
(extern namespace: clan/poo/strong-components
  certify-active-tour certify-ordinal-whole certify-ordinal-components certify-ordinal-return)

(extern namespace: clan/poo/support/index probe-ordinal-roster ordinal-probe)
(extern namespace: clan/poo/strong-components ordinal-backward sparse-ordinal-backward dense-ordinal-backward)

(def (check-graph-projection)
    (test-case "multi-SCC ordinal queries retain source order and exposed owner mutations"
      ;; Both groups interleave in source order. A self edge makes the second
      ;; group use the two-direction certificate. q is an isolated singleton.
      (def keys '#(b z a x q))
      (def rows '#((a z) (z x) (b) (z) ()))
      (def spec (graph.declaration/rows (vector->list keys) rows
        (lambda _ (error "partition evaluated a provider"))))
      (def part (scc.partition spec))
      (def ordinary (scc.partition (source keys rows)))
      (check (procedure? (%partition-members part)) => #t)
      (check-equal? (membership-observation part (vector->list keys))
        (membership-observation ordinary (vector->list keys)))
      (check-equal? ((scc.partition-reads part) 'b) '(a z))
      (check-equal? (.get (scc.partition-work part) reverse-edges) 0)
      (check-equal? (.get (scc.partition-work part) certificate-buckets) 6)
      (check-equal? (.get (scc.partition-work part) certificate-edges) 6)
      (defvalues (visits checked singletons reverse-edges)
        (certify-ordinal-components
          (make-compact-graph keys #f '#u32(0 2 4 5 6 6) '#u32(2 1 1 3 0 1) 0)
          '#u32(1 0 1 0 2) '#u32(1 0 4) '#u32(2 2 1)))
      (check-equal? (list visits checked singletons reverse-edges) '(6 8 1 3))
      (def first (scc.partition-members part 'b))
      (check-equal? (scc.partition-groups part) '((b a) (z x) (q)))
      (check-eq? (car (scc.partition-groups part)) first)
      (check (scc.partition-group-of part 'missing) => #f)
      (def owner (scc.partition-owner part))
      (def owners (with-catch
        (lambda (failure)
          (if (UnboundKeyError? failure) (cadr (memq hash: (Error-irritants failure))) (raise failure)))
        (lambda () (owner 'missing))))
      (hash-put! owners 'a 'z)
      (check-eq? (owner 'a) 'z)
      (check-eq? (scc.partition-group-of part 'a) (scc.partition-members part 'z))
      (check-eq? (scc.partition-members part 'b) first))
    (test-case "owned root projection keeps source order and fresh member lists"
      (def source (graph.declaration/rows '#(b z a x q) '#u32(0 2 4 5 6 6) values
        targets: '#u32(2 1 1 3 0 1)))
      (def prior (scc.partition-owned source))
      (check (procedure? (%partition-groups prior)) => #t)
      (def delivered [])
      (def (visit key) (set! delivered (cons key delivered)))
      (check (scc.partition-for-each-member prior 'b visit) => #t)
      (check-equal? (reverse delivered) '(b a))
      (check (scc.partition-for-each-member prior 'a visit) => #f)
      (check (scc.partition-for-each-member prior 'unknown visit) => #f)
      (check-equal? delivered '(a b))
      (def groups (scc.partition-groups prior))
      (check-equal? groups '((b a) (z x) (q)))
      (set-car! (car groups) 'mutated)
      (def edited (scc.revise-partition prior '((b a x))))
      (check-eq? (%partition-groups edited) (%partition-groups prior))
      (check-equal? (scc.partition-groups edited) '((b a) (z x) (q)))
      (def split (scc.revise-partition edited '((a))))
      (check-equal? (scc.partition-groups split) '((b) (z x) (a) (q)))
      (set! delivered [])
      (check (scc.partition-for-each-member split 'b visit) => #t)
      (check (scc.partition-for-each-member split 'z visit) => #t)
      (check-equal? (reverse delivered) '(b z x))
      (check-exception (scc.partition-for-each-member split 'z (lambda (_) (error "member visitor"))) error-object?)
      (check-equal? (scc.partition-groups prior) '((b a) (z x) (q))))
    (test-case "contiguous groups stream in source order and return independent lists"
      (def spec (graph.declaration/rows '#(a b c x y) '#u32(0 1 2 3 5 6) values
        targets: '#u32(1 2 0 4 1 3)))
      (def part (scc.partition-owned spec))
      (def first (scc.partition-members part 'a))
      (check-equal? first '(a b c))
      (set-car! (cdr first) 'changed)
      (def visited [])
      (check (scc.partition-for-each-member part 'a (lambda (k) (set! visited (cons k visited)))) => #t)
      (check-equal? (reverse visited) '(a b c))
      (check-equal? (scc.partition-group-size part 'b) 3)
      (check-equal? (scc.partition-group-of part 'b) '(a b c))
      (check-equal? (scc.partition-groups part) '((a b c) (x y))))
    (test-case "multi-SCC certificate rejects bad quotient order and false cycles"
      (def keys '#(a b c d))
      (def offsets '#u32(0 1 3 4 5))
      (def (certificate-error message irritants)
        (lambda (cause)
          (and (Error? cause) (equal? (Error-message cause) message)
               (equal? (Error-irritants cause) irritants))))
      (check-exception
        (certify-ordinal-components (make-compact-graph keys #f offsets '#u32(1 0 2 3 2) 0)
          '#u32(0 0 1 1) '#u32(0 2) '#u32(2 2))
        (certificate-error "invalid SCC quotient certificate" '(b c)))
      (check-exception
        (certify-ordinal-components (make-compact-graph keys #f offsets '#u32(1 1 2 3 2) 0)
          '#u32(1 1 0 0) '#u32(2 0) '#u32(2 2) '#u8(255 0 255 0))
        (certificate-error "invalid SCC spanning certificate" '(b)))
      ;; A short closed cycle cannot certify a rank with another cycle.
      ;; Owner c also has a bad quotient edge. Its spanning error comes first.
      (check-exception
        (certify-ordinal-components
          (make-compact-graph '#(a b c d e f) #f '#u32(0 1 2 4 5 7 8)
            '#u32(1 0 3 4 2 4 5 4) 0)
          '#u32(0 0 0 0 1 1) '#u32(0 4) '#u32(4 2))
        (certificate-error "invalid SCC spanning certificate" '(c))))
    (test-case "return verifier checks decoded edges, one root and forward coverage"
      (def (certify rows targets choices)
        (certify-ordinal-return (make-compact-graph '#(a b c) #f rows targets 0)
          choices #f '#u32(3) (make-u8vector 3 0)))
      (check (certify '#u32(0 1 2 3) '#u32(1 2 0) '#u8(255 0 0)) => #t)
      (check (certify '#u32(0 1 2 3) '#u32(1 2 0) '#u32(4294967295 0 0)) => #t)
      (check (certify '#u32(0 1 2 3) '#u32(1 2 1) '#u8(255 0 0)) => #f)
      (check (certify '#u32(0 1 2 3) '#u32(1 2 0) '#u8(255 1 0)) => #f)
      (check (certify '#u32(0 1 2 3) '#u32(1 2 0) '#u8(255 255 0)) => #f)
      (check (certify '#u32(0 1 2 3) '#u32(0 0 1) '#u8(255 0 0)) => #f))
    (test-case "wide return choices keep the source representative when discovery starts elsewhere"
      (def keys (names 259))
      (def offsets (make-u32vector 260 260))
      (def targets (make-u32vector 260 0))
      ;; The first owner reaches the second group's DFS leader, ordinal 2.
      ;; A self edge makes that group branching. Its rootward edge from
      ;; ordinal 1 follows 256 already-retired singleton neighbors.
      (u32vector-set! offsets 0 0)
      (u32vector-set! offsets 1 1)
      (u32vector-set! offsets 2 258)
      (u32vector-set! targets 0 2)
      (for (i (in-range 256)) (u32vector-set! targets (fx+ i 1) (fx+ i 3)))
      (u32vector-set! targets 257 2)
      (u32vector-set! targets 258 1)
      (u32vector-set! targets 259 2)
      (def part (scc.partition (graph.declaration/rows keys offsets values targets: targets)))
      (def first (vector-ref keys 1))
      (def leader (vector-ref keys 2))
      (check-eq? ((scc.partition-owner part) leader) first)
      (check-equal? (scc.partition-members part first) (list first leader))
      (check-equal? (.get (scc.partition-work part) reverse-edges) 0)
      (check-equal? (.get (scc.partition-work part) member-pops) 259))
    (test-case "whole ordinal component preserves point queries and exposed owner table"
      (def keys '#(c a b))
      (def declared-rows '#((a b) (b) (c)))
      (defvalues (reads index declared edges)
        (capture-graph keys #f #t 4294967295 'adjacent #f #t declared-rows))
      (def result (partition-captured keys reads edges 3 declared index #f values #f #t))
      (def ordinary (scc.partition (source keys declared-rows)))
      (check (procedure? (%partition-members result)) => #t)
      (check-equal? (membership-observation result '(c a b))
        (membership-observation ordinary '(c a b)))
      (check (scc.partition-group-size result 'missing) => #f)
      (check-equal? ((scc.partition-reads result) 'c) '(a b))
      (def work (scc.partition-work result))
      (check-equal? (.get work bulk-retired) 3)
      (check-equal? (.get work reverse-edges) 0)
      (check-equal? (.get work certificate-edges) 3)
      (def group (scc.partition-members result 'c))
      (check-eq? (car (scc.partition-groups result)) group)
      (check (scc.partition-members result 'a) => #f)
      (def owner (scc.partition-owner result))
      (def owners (with-catch
        (lambda (failure)
          (if (UnboundKeyError? failure) (cadr (memq hash: (Error-irritants failure))) (raise failure)))
        (lambda () (owner 'missing))))
      (check-eq? (hash-ref owners 'b) 'c)
      (hash-put! owners 'b 'a)
      (check-eq? (owner 'b) 'a)
      (check (scc.partition-group-of result 'b) => #f)
      (check-eq? (scc.partition-group-of result 'a) group))
    (test-case "active DFS tour rejects missing or forged parent links"
      (def offsets '#u32(0 1 2 3))
      (def targets '#u32(1 2 0))
      (check (certify-active-tour offsets targets '#u32(0 0 1) 0 2 2 0 3) => #t)
      (check (certify-active-tour offsets targets '#u32(0 0 0) 0 2 2 0 3) => #f)
      (check (certify-active-tour offsets targets '#u32(0 0 2) 0 2 2 0 3) => #f)
      (check (certify-active-tour offsets targets '#u32(0 0 1) 0 2 2 1 3) => #f))
    (test-case "bulk retirement keeps completed followers when the active chain is only a prefix"
      (def part (scc.partition (graph.declaration/rows '#(a b c d) '#u32(0 2 3 4 5) values
        targets: '#u32(1 2 0 3 0))))
      (def work (scc.partition-work part))
      (check-equal? (scc.partition-groups part) '((a b c d)))
      (check-equal? (.get work bulk-retired) 4)
      (check-equal? (.get work finishes) 2)
      (check-equal? (.get work certificate-buckets) 8)
      (check-equal? (.get work reverse-edges) 0))
    (test-case "whole ordinal certificate rejects either missing spanning direction"
      (for (targets '(#u32(1 2 2) #u32(0 0 1)))
        (check-exception
          (certify-ordinal-whole
            (make-compact-graph '#(a b c) #f '#u32(0 1 2 3) targets 0) '#u32(4 4 4))
          (lambda (cause)
            (and (Error? cause) (equal? (Error-message cause) "invalid SCC spanning certificate")
                 (equal? (Error-irritants cause) '(b)))))))
    (test-case "packed rank normalization preserves public owner and group identities"
      (def names (vector 'c 'b 'a 'd))
      (def (row key)
        (case key ((a) '(b c)) ((b) '(a)) (else [])))
      (def (partition keys)
        (defvalues (rows index declared edges) (capture-graph keys row))
        (partition-captured keys rows edges (vector-length names) declared index))
      (make-hash-table-eq)
      (check (%gc-scratch-routes-current?) => #t)
      (check (%standard-symbol-table-lookup? (make-hash-table-symbolic)) => #t)
      (def packed (partition names))
      (def ordinary (partition (vector->list names)))
      (check-equal? (scc.partition-groups packed) '((c) (b a) (d)))
      (for (key (in-vector names))
        (check-eq? ((scc.partition-owner packed) key) ((scc.partition-owner ordinary) key))
        (check-equal? (scc.partition-group-of packed key) (scc.partition-group-of ordinary key))
        (check-equal? ((scc.partition-reads packed) key) ((scc.partition-reads ordinary) key)))
      (def owner (scc.partition-owner packed))
      (def owners
        (with-catch
          (lambda (err)
            (if (UnboundKeyError? err) (cadr (memq hash: (Error-irritants err))) (raise err)))
          (lambda () (owner 'missing))))
      (def members (scc.partition-members packed 'b))
      (set-car! members 'changed)
      (check-eq? (owner 'a) 'b)
      (check-eq? (scc.partition-group-of packed 'a) members)
      (check-equal? (scc.partition-group-size packed 'a) 2)
      (hash-put! owners 'a 'd)
      (check-eq? (owner 'a) 'd)
      (check-eq? (scc.partition-group-of packed 'a) (scc.partition-members packed 'd)))
    (test-case "ordinal singleton members keep alias, cardinality and independent refusal"
      (def names '#(a b c d))
      (def (row key)
        (case key ((a) '(a b)) ((b c) '(d)) (else [])))
      (make-hash-table-symbolic seed: 0)
      (make-hash-table-eq)
      (defvalues (rows index declared edges)
        (capture-graph names row #t 4294967295 'adjacent #f #t))
      (def result (partition-captured names rows edges 4 declared index))
      (check (procedure? (%partition-members result)) => #t)
      (def first-group (scc.partition-members result 'a))
      (def ordered (scc.partition-groups result))
      (check-equal? ordered '((a) (b) (c) (d)))
      (check-eq? (car ordered) first-group)
      (check-eq? (scc.partition-groups result) ordered)
      (check-equal? ((scc.partition-reads result) 'b) '(d))
      (check-equal? ((scc.partition-reads result) 'c) '(d))
      (check-equal? (.@ (scc.partition-work result) quotient-edges) 4)
      (check (scc.partition-members result 'missing) => #f)
      (def group (car (scc.partition-groups result)))
      (set-car! group 'changed)
      (set-cdr! group '(extra))
      (check-eq? group (scc.partition-group-of result 'a))
      (check-equal? (scc.partition-group-size result 'a) 1)
      (def descriptor (runtime.slot-ref HashTable::interface 'type))
      (dynamic-wind void
        (lambda ()
          (runtime.slot-set! HashTable::interface 'type (##structure-copy descriptor))
          (check-eq? (scc.partition-members result 'a) group))
        (lambda () (runtime.slot-set! HashTable::interface 'type descriptor)))
      (check-eq? (scc.partition-members result 'a) group)
      (check-equal? (scc.partition-group-size result 'a) 1)
      (def owner (scc.partition-owner result))
      (def (missing-table key)
        (with-catch
          (lambda (err)
            (if (UnboundKeyError? err) (cadr (memq hash: (Error-irritants err))) (raise err)))
          (lambda () (owner key))))
      (check-eq? (owner 'a) 'a)
      (check (scc.partition-group-of result 'absent) => #f)
      (def visible (missing-table 'absent))
      (check-eq? visible (missing-table 'other))
      (check-equal? (hash-length visible) 4)
      (hash-put! visible 'a 'd)
      (check-eq? (owner 'a) 'd)
      (check-eq? (scc.partition-group-of result 'a) (scc.partition-members result 'd))
      ;; Retiring before the first enumeration must also retain issued tokens.
      (def retired (partition-captured names rows edges 4 declared index))
      (def prior-group (scc.partition-members retired 'b))
      (set-car! prior-group 'prior)
      (dynamic-wind void
        (lambda ()
          (runtime.slot-set! HashTable::interface 'type (##structure-copy descriptor))
          (check-eq? (scc.partition-members retired 'b) prior-group))
        (lambda () (runtime.slot-set! HashTable::interface 'type descriptor)))
      (check-eq? (cadr (scc.partition-groups retired)) prior-group)
      (def mismatched (make-compact-graph names (compact-graph-positions index)
                       (compact-graph-offsets index) (compact-graph-targets index) 1))
      (check-exception (partition-captured names rows edges 4 declared mismatched)
        (lambda (cause) (and (Error? cause)
          (equal? (Error-message cause) "invalid SCC quotient certificate")
          (equal? (Error-irritants cause) '(a b))))))
    (test-case "probed ordinals retain exact symbol identity and reject an occupied key"
      (def left (string->uninterned-symbol "owner"))
      (def right (string->uninterned-symbol "owner"))
      (def absent (string->uninterned-symbol "owner"))
      (def keys (vector left right))
      (def index (probe-ordinal-roster keys))
      (check (%ordinal-bucket-ref index left) => 0)
      (check (%ordinal-bucket-ref index right) => 1)
      (check (%ordinal-bucket-ref index absent) => #f)
      (check (probe-ordinal-roster (vector left left)) => #f)
      (check (probe-ordinal-roster (vector left 7 right)) => #f)
      ;; A saturated route must decline both insertion and an absent read.
      (check (ordinal-probe keys '#u32(1) 0 right 1) => #f)
      (check (ordinal-probe keys '#u32(1) 0 right) => #f))
    (test-case "sparse and dense inverse signing agree on ordered reader buckets"
      (def keys '#(a b c d e f g))
      (def offsets '#u32(0 1 2 3 4 5 6 7))
      (def sparse '#u32(1 2 0 0 5 6 4))
      (def single (sparse-ordinal-backward keys offsets sparse))
      (def dense (dense-ordinal-backward keys offsets sparse))
      (check (procedure? single) => #t)
      (check-equal? (single 0) '(d c))
      (for (ordinal (in-range 7))
        (check-equal? (single ordinal) (dense ordinal)))
      (def saturated '#u32(0 0 0 0 0 0 0))
      (check (sparse-ordinal-backward keys offsets saturated) => #f)
      (def ordinary (ordinal-backward keys offsets saturated identity))
      (check-equal? (ordinary 0) '(g f e d c b a))
      (check-equal? (ordinary 1) []))
    (test-case "packed owner buckets preserve symbol identity and refusal order"
      (def left (string->uninterned-symbol "owner"))
      (def right (string->uninterned-symbol "owner"))
      (def absent (string->uninterned-symbol "owner"))
      (def names (vector left right))
      (def buckets (%make-ordinal-buckets names))
      ;; Both ordinals occupy one bucket, including the valid ordinal zero.
      (check-equal? (%ordinal-bucket-ref buckets left) 0)
      (check-equal? (%ordinal-bucket-ref buckets right) 1)
      (check-eq? (%ordinal-bucket-ref buckets absent) #f)
      (check-eq? (%make-ordinal-buckets (vector left left)) #f)
      (check-eq? (%make-ordinal-buckets (make-vector 25 left)) #f)
      (make-hash-table-symbolic seed: 0)
      (def calls [])
      (def (read key) (set! calls (cons key calls)) (if (eq? key left) (list right) []))
      (defvalues (rows index declared edges) (capture-graph names read))
      (check-eq? (compact-graph-positions index) #f)
      (check-equal? (reverse calls) (list left right))
      (check-equal? (hash-ref rows left) (list right))
      (check-equal? (list declared edges) '(1 1))
      (set! calls [])
      (check-exception (capture-graph (vector left left 7 right) read)
        (lambda (failure) (and (Error? failure)
          (equal? (Error-message failure) "symbolic captured owner required"))))
      (check-equal? calls []))
    (test-case "packed rows retain ownership through a miss and a changed route"
      (def keys '#(first second third))
      (def author-row (list 'second 'first 'second))
      (def (read key)
        (when (eq? key 'second) (set-car! author-row 'third))
        (if (eq? key 'first) author-row []))
      (make-hash-table-symbolic seed: 0)
      (defvalues (compact _graph _declared _edges)
        (capture-graph keys read #t 4294967295 'adjacent #f #t))
      (check (procedure? compact) => #t)
      (def demands
        (for/collect (_ (in-range 2))
          (def task (make-thread (lambda () (compact 'first))))
          (thread-start! task)
          task))
      (def stored (thread-join! (car demands)))
      (check-eq? (thread-join! (cadr demands)) stored)
      (check-equal? stored '(first second))
      (def misses
        (for/collect (key '(outside other))
          (def thread (make-thread (lambda ()
            (with-catch UnboundKeyError? (lambda () (compact key) #f)))))
          (thread-start! thread)
          thread))
      (for (thread misses) (check-eq? (thread-join! thread) #t))
      (check-eq? (compact 'first) stored)
      (def descriptor (runtime.slot-ref HashTable::interface 'type))
      (def replaced (##structure-copy descriptor))
      (def calls [])
      (def earlier (list 'second 'first 'second))
      (def restored
        (dynamic-wind void
          (lambda ()
            (defvalues (rows _index _declared _edges)
              (capture-graph keys
                (lambda (key)
                  (set! calls (cons key calls))
                  (when (eq? key 'second)
                    (set-car! (cdr earlier) 'third)
                    (runtime.slot-set! HashTable::interface 'type replaced))
                  (case key ((first) earlier) ((second) '(third first)) (else [])))
                #t 4294967295 'adjacent #f #t))
            rows)
          (lambda () (runtime.slot-set! HashTable::interface 'type descriptor))))
      (check (procedure? restored) => #f)
      (check-equal? (reverse calls) '(first second third))
      (check-equal? (hash-ref restored 'first) '(first second))
      (check-equal? (hash-ref restored 'second) '(third first)))
    (test-case "query row projection restores completed rows at the word boundary"
      ;; Reduced PRIVATE word ceilings cover first-row fallback, empty rows,
      ;; rightmost duplicates, chunk crossings and the singleton append route.
      ;; Production always uses the full u32 ceiling; no larger budget is tested.
      (for (fixture (list
             (list '(a b c d e f) '#((b c d e f) (a c d e f) (a) (a b) () (f f)) '(0 5 10))
             (list '(a b c d) '#(() (a c a) () (b c d b)) '(0 2))))
        (def keys (car fixture)) (def input (cadr fixture))
        (def rows (make-hash-table-eq))
        (for ((key keys) (row (in-vector input))) (hash-put! rows key row))
        (defvalues (reference _index declared edges) (capture-graph keys (cut hash-ref rows <>)))
        (for* ((limit (caddr fixture)) (retain? '(#t #f))
               (roster (list keys (list->vector keys))))
          (def calls [])
          (defvalues (actual index observed-declared observed-edges)
            (capture-graph roster (lambda (key)
              (set! calls (cons key calls)) (hash-ref rows key)) retain? limit 'adjacent #f (vector? roster)))
          (check-equal? (reverse calls) keys)
          (check-equal? index #f)
          (check-equal? (list observed-declared observed-edges) (list declared edges))
          (for (key keys)
            (check-equal? (hash-ref actual key) (hash-ref reference key))
            (check-equal? (wide-reachable actual key) (list-reachable-order reference key)))
          (check-exception (wide-reachable actual 'outside) error-object?)))
      ;; Restoration reads owned chunks, not an earlier mutable author row.
      (def prior-row (list 'b 'c 'b))
      (def calls [])
      (defvalues (rows index declared edges)
        (capture-graph '(a b c) (lambda (key)
          (set! calls (cons key calls))
          (case key ((a) prior-row) ((b) (set-car! prior-row 'outside) '(a)) (else []))) #f 2))
      (check-equal? (reverse calls) '(a b c))
      (check-equal? index #f)
      (check-equal? (list declared edges) '(4 3))
      (check-equal? (hash-ref rows 'a) '(c b))
      (check-equal? (wide-reachable rows 'a) '(b c a))
      ;; A later refused author still stops acquisition at the same owner.
      (set! calls [])
      (check-exception
        (capture-graph '(a b c d) (lambda (key)
          (set! calls (cons key calls))
          (case key ((a) '(b c)) ((b) '(a)) ((c) '(outside)) (else []))) #f 2)
        error-object?)
      (check-equal? (reverse calls) '(a b c)))
    (test-case "ordered capture publishes only a complete verified row"
      (def roster (vector->list (names 65)))
      (def input (list->vector roster))
      (def (key at) (vector-ref input at))
      (def (read owner)
        (cond ((eq? owner (key 0)) (list (key 1)))
              ((eq? owner (key 1)) (list (key 2) (key 3) (key 4)))
              ((eq? owner (key 2)) (list (key 4) (key 3) (key 3) (key 2)))
              (else [])))
      (defvalues (_rows actual declared unique) (capture-graph roster read #f))
      (defvalues (_reference expected original normalized) (capture-graph roster read #f 4294967295 #f))
      (check-equal? (list declared unique) (list original normalized))
      (check-equal? (list declared unique) '(8 7))
      (check-equal? (compact-graph-direction actual) (compact-graph-direction expected))
      (for (owner roster)
        (check-equal? (compact-row actual owner) (compact-row expected owner)))
      ;; The speculative row scans a valid prefix, then a bad tail.
      ;; No later author may run, and the same original row is refused.
      (for (bad (list 'bad-tail
                      (let (cycle (list (key 2) (key 3) (key 4)))
                        (set-cdr! (cddr cycle) cycle) cycle)))
        (def calls [])
        (def row (cons (key 2) (cons (key 3) bad)))
        (check-exception
          (capture-graph roster (lambda (owner)
            (set! calls (cons owner calls))
            (cond ((eq? owner (key 0)) (read owner))
                  ((eq? owner (key 1)) row)
                  (else (error "refused row crossed its author boundary")))) #f)
          error-object?)
        (check-equal? (reverse calls) (list (key 0) (key 1)))))
    (test-case "row workspace growth and duplicate gaps retain exact adjacency"
      (def keys '#(a b c d))
      (check (matches? keys '#((a b b c) (d c d a b b a d c) (c a a) ())) => #t)))

(def (check-graph-reachability)
    (test-case "inverse continuation owns added roots and drains the older frontier first"
      (def inverse (make-hash-table-symbolic))
      (hash-put! inverse 'a '(b b))
      (hash-put! inverse 'b '(a))
      (hash-put! inverse 'c '(b))
      (def receipt (vector 0 0))
      (def work (start-affected-work inverse receipt))
      (check (advance-affected-work! work '(a) 1) => #f)
      (def roots (list 'c))
      (check (advance-affected-work! work roots 1) => #f)
      (set-car! roots 'outside)
      (check (hash-key? (affected-work-marked work) 'b) => #t)
      (check (hash-key? (affected-work-marked work) 'c) => #f)
      (check (advance-affected-work! work []) => #t)
      (check-equal? (hash-length (affected-work-marked work)) 3)
      (check (hash-key? (affected-work-marked work) 'c) => #t)
      (check-equal? receipt '#(3 4))
      (check (advance-affected-work! work '(a c)) => #t)
      (check-equal? receipt '#(3 4)))
    (test-case "owned reachability captures once and rejects missing roots"
      (def acquisitions [])
      (def row (list 'b 'c))
      (def source (.o keys: '(a b c isolated)
        .reads: (lambda (key)
          (set! acquisitions (cons key acquisitions))
          (case key ((a) row) ((b) (set-car! row 'outside) '(c)) (else [])))))
      (def indexed (scc.capture-reachability source))
      (check (eq? (.@ indexed source) source) => #t)
      (check-equal? (reverse acquisitions) '(a b c isolated))
      (check-equal? (.call indexed .reachable 'a) '(c b a))
      (check-equal? (.call indexed .reachable 'a) '(c b a))
      (check-equal? (.call indexed .reachable 'isolated) '(isolated))
      (check-exception (.call indexed .reachable 'outside) error-object?)
      (check-equal? (length acquisitions) 4))
    (test-case "compact IDs retain distinct same-spelling symbol identities"
      (def a (string->uninterned-symbol "same-owner"))
      (def b (string->uninterned-symbol "same-owner"))
      (def keys (vector a b))
      (check (eq? a b) => #f)
      (check (matches? keys (vector (list b) (list a))) => #t))
    (test-case "representative lookup is exact and does not alias a non-representative"
      (def part (scc.partition (family-source 'pairs 10000)))
      (check-equal? (length (scc.partition-groups part)) 5000)
      (check-equal? (scc.partition-members part 'absent) #f)
      (for (members (scc.partition-groups part))
        (unless (eq? (scc.partition-members part (cadr members)) #f)
          (error "non-representative group alias" members)))))

(def graph-algorithms-test
  (test-suite "indexed Graph properties and scale"
    (check-certificate-refusal)
    (check-graph-properties)
    (check-declared-rows)
    (check-generated-graphs)
    (check-scale-graphs)
    (check-graph-membership)
    (check-graph-admission)
    (check-graph-projection)
    (check-graph-reachability)))

;; The existing SCC benchmark entry invokes this alongside its unchanged matrix.
;; Source construction and partitioning have separate process-statistics rows.
(def (main)
  (def prepared (vector #f #f))
  (for* ((size '(100000 1000000))
         (family (if (= size 100000) '(isolated self chain pairs ring hub band) '(chain pairs ring band))))
    (defvalues (spec preparation) (measure (lambda () (metadata-family-source family size)) 1))
    (defvalues (getter-counts getter-cost) (measure (cut metadata-getter-counts spec) 1))
    (unless (= (vector-ref getter-counts 0) size) (error "metadata enumeration count"))
    (display "GRAPH-CAPTURE-BEGIN ") (write (list family size)) (newline) (force-output)
    (defvalues (part traversal) (measure (cut scc.partition spec) 1))
    (display "GRAPH-PARTITION-RETURNED ") (write (list family size)) (newline) (force-output)
    (unless (= (vector-ref getter-counts 1) (.@ (scc.partition-work part) validation-edges))
      (error "getter/capture edge count disagreement" family size))
    (check-scale part family size)
    (case family
      ((chain) (vector-set! prepared 0 part))
      ((pairs) (vector-set! prepared 1 part))
      ((ring)
       (membership-capacity size (vector-ref prepared 0) (vector-ref prepared 1) part)
       ;; Release every retained fixture before the degree-16 million-node band.
       (vector-set! prepared 0 #f) (vector-set! prepared 1 #f)))
    (display "GRAPH-SCALE ")
    (write (list family size (cons 'source-preparation preparation)
      (cons 'metadata-getter-pass getter-cost) (cons 'partition-including-getter traversal) (cons 'work (.alist/sort (scc.partition-work part)))))
    (newline))
  ;; Small exact-old-rule controls and 100K/1M candidate windows are separate:
  ;; do not spend the gate proving that the former cubic giant-group scan is slow.
  (for* ((size '(64 256)) (regime '(natural collected))
         (order '((before after after before) (before before after after))))
    (let-values (((before after expected) (comparison-input 'giant-unchanged size)))
      (let (observations [])
        (for (side order)
          (let-values (((result costs) (measure
            (lambda () (if (eq? side 'before) (membership-oracle before after)
                         (topology.changed-members before after))) 1 (eq? regime 'collected))))
            (unless (equal? result expected) (error "membership paired oracle" size side))
            (set! observations (cons (list side costs) observations))))
        (display "GRAPH-MEMBERSHIP-PAIR ")
        (write (list size regime order (reverse observations))) (newline))))
  (displayln "GRAPH-MEMBERSHIP-OK bounded-pairs=32 sizes=100000,1000000")
  (displayln "GRAPH-SCALE-OK sizes=100000,1000000 shapes=7,4")
  (void))
