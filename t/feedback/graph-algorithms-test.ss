;;; Graph properties and scale accounting through the existing POO APIs.
(export graph-algorithms-test main small-reachability-study compact-study shared-cyclic-study)
(import :std/test :std/iter :clan/poo/object :clan/poo/mop
        (only-in :gerbil/runtime/gambit string->uninterned-symbol)
        (only-in :gerbil/runtime/interface interface-instance-object)
        (only-in :gerbil/runtime/hash symbol-hash-table?)
        (only-in :gerbil/runtime/table symbolic-table-ref symbolic-table-set!)
        :clan/poo/type :clan/poo/number (prefix-in :clan/poo/testing/type typed.)
        (only-in :clan/poo/support/testing require-property-passed)
        (rename-in (only-in :clan/poo/benchmarks/closure-measure measure qualified-metrics) (measure raw-measure))
        (only-in :std/list/list filter foldl find take append-map delete-duplicates/hash)
        (prefix-in :clan/poo/generalized-graph graph.)
        (prefix-in :clan/poo/dependency-analysis code.)
        (prefix-in :clan/poo/strong-components scc.)
        (prefix-in :clan/poo/recursive-topology topology.)
        (prefix-in :clan/poo/component-revision component.))
;; Graph receipts use the existing paired-study allocation admission rule.
;; Only the post-timer projection changes; workload, clocks and GC stay intact.
(def (measure thunk repetitions (collect? #f))
  (let-values (((result metrics) (raw-measure thunk repetitions collect?)))
    (values result (qualified-metrics metrics))))

(include "graph-algorithms/baseline.scm")
(include "graph-algorithms/discovery-study.scm")
(include "graph-algorithms/compact.scm")

(def (names size)
  (list->vector (for/collect (i (in-range size))
    (string->symbol (string-append "graph-owner-" (number->string i))))))
(def (source keys rows)
  (graph.declaration (vector->list keys)
    (for/collect (i (in-range (vector-length keys)))
      (cons (vector-ref keys i)
        (.cc code.Computation.
          reads: (vector-ref rows i)
          .evaluate: (lambda (_) (error "partition must not evaluate business code")))))))

;; Independent all-source reachability is bounded to small property inputs.
;; It shares no lowlink, active-stack or component-number implementation.
(def (oracle-groups keys rows)
  (def adjacency (make-hash-table-eq))
  (def reach (make-hash-table-eq))
  (def assigned (make-hash-table-eq))
  (for ((key (vector->list keys)) (i (in-range (vector-length keys))))
    (hash-put! adjacency key (vector-ref rows i)))
  (for (root (vector->list keys))
    (let (seen (make-hash-table-eq))
      (let walk ((pending (list root)))
        (unless (null? pending)
          (let ((key (car pending)) (rest (cdr pending)))
            (if (hash-key? seen key) (walk rest)
              (begin (hash-put! seen key #t) (walk (append rest (hash-ref adjacency key))))))))
      (hash-put! reach root seen)))
  (reverse (foldl (lambda (key result)
    (if (hash-key? assigned key) result
      (let (members (filter (lambda (other)
                     (and (hash-key? (hash-ref reach key) other)
                          (hash-key? (hash-ref reach other) key))) (vector->list keys)))
        (for (member members) (hash-put! assigned member #t))
        (cons members result)))) [] (vector->list keys))))

(def (matches? keys rows)
  (let* ((expected (oracle-groups keys rows)) (part (scc.partition (source keys rows))))
    (and (equal? expected (scc.partition-groups part))
      (let rows-exact ((i 0))
        (or (= i (vector-length keys))
          (and (equal? ((scc.partition-reads part) (vector-ref keys i))
                       (delete-duplicates/hash (vector-ref rows i)))
               (rows-exact (1+ i)))))
      (discovery-controls part (vector->list keys) rows)
      (equal? expected (baseline-partition (source keys rows)))
      (andmap (lambda (members)
        (and (equal? (scc.partition-members part (car members)) members)
          (andmap (lambda (key) (eq? ((scc.partition-owner part) key) (car members))) members))) expected))))

(def (family-reads family keys size i)
  (case family
      ((isolated) [])
      ((self) (list (vector-ref keys i)))
      ((chain) (if (< (1+ i) size) (list (vector-ref keys (1+ i))) []))
      ((pairs) (list (vector-ref keys (if (even? i) (1+ i) (1- i)))))
      ((ring) (list (vector-ref keys (modulo (1+ i) size))))
      ((hub) (if (zero? i) [] (list (vector-ref keys 0))))
      ((band) (filter identity (for/collect (offset (in-range 1 17))
                (and (>= (- i offset) 0) (vector-ref keys (- i offset))))))
      (else (error "unknown graph family" family))))

(def (family-source family size)
  (def keys (names size))
  (source keys (list->vector (for/collect (i (in-range size))
    (family-reads family keys size i)))))

;; Capacity is graph metadata, not one retained business provider per node.
;; The existing Declaration getter produces inert metadata from a frozen key
;; index; partition captures each footprint once. No loader or value cache.
(def (metadata-family-source family size)
  (def keys (names size))
  (def positions (make-hash-table-eq))
  (for (i (in-range size)) (hash-put! positions (vector-ref keys i) i))
  (.cc graph.Declaration. keys: (vector->list keys)
    .code: (lambda (key)
      (.cc code.Computation. reads: (family-reads family keys size (hash-ref positions key))
        .evaluate: (lambda (_) (error "Graph capacity must not evaluate a provider"))))
    .base: (lambda (_) #f)))

(def (metadata-getter-counts spec)
  (def count 0)
  (def edges 0)
  (for (key (.@ spec keys))
    (let* ((program (.call spec .code key)) (row (if program (.@ program reads) [])))
      (set! count (1+ count)) (set! edges (+ edges (length row)))))
  (vector count edges))

(def (family-groups family size)
  (def keys (names size))
  (case family
    ((ring) (list (vector->list keys)))
    ((pairs) (for/collect (i (in-range (quotient size 2)))
               (list (vector-ref keys (* 2 i)) (vector-ref keys (1+ (* 2 i))))))
    (else (map list (vector->list keys)))))
(def (check-scale part family size)
  (def groups (scc.partition-groups part))
  (def work (scc.partition-work part))
  (def edges (case family ((isolated) 0) ((chain hub) (1- size))
               ((band) (- (* 16 size) 136)) (else size)))
  (def nontrivial? (memq family '(pairs ring)))
  (def ranked? (not nontrivial?))
  (def ring? (eq? family 'ring))
  (unless (and (= (.@ work discoveries) (if ranked? 0 size))
               (= (.@ work finishes) (cond (ranked? 0) (ring? 1) (else size)))
               (= (.@ work member-pops) (if (eq? family 'pairs) size 0))
               (= (.@ work bulk-retired) (if ring? size 0))
               (= (.@ work normalization-owners) size)
               (= (.@ work validation-edges) edges)
               (= (.@ work edge-visits) (if ranked? 0 edges))
               (= (.@ work rank-owners) (if ranked? size 0))
               (= (.@ work rank-edges) (if ranked? edges 0))
               (= (.@ work certificate-buckets) (if nontrivial? (* 2 size) 0))
               (= (.@ work certificate-edges) (if nontrivial? (* 2 edges) 0))
               (= (.@ work certificate-singletons) (if nontrivial? 0 size))
               (= (.@ work reverse-edges) (if nontrivial? edges 0))
               (= (.@ work quotient-edges) edges)
               (equal? groups (family-groups family size))
               (= (foldl (lambda (members total) (+ total (length members))) 0 groups) size)
               (andmap (lambda (members)
                 (and (eq? members (scc.partition-members part (car members)))
                   (andmap (lambda (key) (eq? ((scc.partition-owner part) key) (car members))) members))) groups))
    (error "linear SCC work/group oracle" family size))
  #t)


;; Frozen membership-observation rule, bounded to small differential inputs.
;; It deliberately shares neither owner lookup nor per-group verdicts.
(def (membership-oracle before after)
  (def old (scc.partition-groups before))
  (def fresh (scc.partition-groups after))
  (def (group groups node) (find (lambda (members) (memq node members)) groups))
  (filter (lambda (node)
    (let ((left (group old node)) (right (group fresh node)))
      (not (and left right (= (length left) (length right))
        (andmap (cut memq <> right) left)))))
    (delete-duplicates/hash (apply append (append old fresh)))))
(def (change-matches? before after)
  (equal? (membership-oracle before after) (topology.changed-members before after)))
(def (group-partition groups)
  (def keys (append-map reverse groups))
  (def rows (make-hash-table-eq))
  (for (members groups)
    (for ((key members) (next (append (cdr members) (list (car members)))))
      (hash-put! rows key next)))
  (scc.partition (.cc graph.Declaration. keys: keys
    .code: (lambda (key) (.cc code.Computation. reads: (list (hash-ref rows key))
      .evaluate: (lambda (_) (error "membership metadata is not a provider"))))
    .base: (lambda (_) #f))))

(def (comparison-input kind size)
  (def keys (vector->list (names size)))
  (case kind
    ((giant-unchanged) (values (group-partition (list keys))
                              (group-partition (list (reverse keys))) []))
    ((isolated-unchanged) (values (group-partition (map list keys))
                                 (group-partition (map list (reverse keys))) []))
    ((merge) (values (group-partition (map list keys)) (group-partition (list keys)) keys))
    ((split) (values (group-partition (list keys)) (group-partition (map list keys)) keys))
    ((pairs-unchanged)
     (let (groups (family-groups 'pairs size))
       (values (group-partition groups) (group-partition (map reverse (reverse groups))) [])))
    (else (error "unknown membership comparison" kind))))

;; changed-members observes only groups and the existing owner/member indices.
;; Reuse public capacity partitions; a reordered historical view is independently
;; repartitioned/certified from its captured rows, without new author getters.
(def (reordered-partition part keys)
  (def rows (captured-rows part keys))
  (partition-captured keys rows (.@ (scc.partition-work part) quotient-edges) 0 0))

(def (prepared-comparison kind size single pairs giant)
  (def keys (vector->list (names size)))
  (case kind
    ((giant-unchanged) (values giant (reordered-partition giant (reverse keys)) []))
    ((isolated-unchanged) (values single (reordered-partition single (reverse keys)) []))
    ((merge) (values single giant keys))
    ((split) (values giant single keys))
    ((pairs-unchanged) (values pairs (reordered-partition pairs (reverse keys)) []))
    (else (error "unknown prepared membership comparison" kind))))

(def (membership-observation part keys)
  (list (scc.partition-groups part)
    (map (lambda (key) (list ((scc.partition-owner part) key)
                             (scc.partition-group-of part key)
                             (scc.partition-group-size part key)
                             (scc.partition-members part key))) keys)))

(def (membership-capacity size single pairs giant)
  (for (kind (if (= size 100000) '(giant-unchanged isolated-unchanged merge split pairs-unchanged)
                                    '(giant-unchanged merge split)))
    (let-values (((inputs preparation) (measure
                   (lambda () (let-values (((before after expected)
                                  (prepared-comparison kind size single pairs giant)))
                     (vector before after expected))) 1)))
      (let-values (((result comparison) (measure
                     (lambda () (topology.changed-members (vector-ref inputs 0) (vector-ref inputs 1))) 1)))
        (unless (equal? result (vector-ref inputs 2)) (error "membership scale oracle" size kind))
        (display "GRAPH-MEMBERSHIP-SCALE ")
        (write (list kind size (cons 'captured-partition-preparation preparation)
                     (cons 'indexed-comparison comparison))) (newline)))))

(def graph-algorithms-test
  (test-suite "indexed Graph properties and scale"
    (test-case "Graph receipts qualify allocation across GC without changing time"
      (for (input '(#(1 2 3 0 0) #(1 2 3 0 208) #(1 2 3 0 -208)
                    #(1 2 3 1 208) #(1 2 3 1 9999999999999999)))
        (def qualified (qualified-metrics input))
        (check-equal? (vector-copy qualified 0 4) (vector-copy input 0 4))
        (check-equal? qualified (qualified-metrics qualified))
        (check-equal? (vector-ref qualified 4)
          (and (= (vector-ref input 3) 0) (>= (vector-ref input 4) 0) (vector-ref input 4))))
      ;; Same payload in both regimes. The actual raw counter under-reports this
      ;; payload across requested collections on the current runtime. The report
      ;; must say unavailable, not turn that counter into an allocation gain.
      (for (collect-inside? '(#f #t))
        (defvalues (answer costs)
          (measure (lambda ()
            (let loop ((left 8) (sum 0))
              (if (zero? left) sum
                (let (buffer (make-u8vector 1048576 left))
                  (when (and collect-inside? (even? left)) (##gc))
                  (loop (1- left) (+ sum (u8vector-ref buffer 0))))))) 1 #t))
        (check-equal? answer 36)
        (if (zero? (vector-ref costs 3))
          (check (>= (vector-ref costs 4) 8388608) => #t)
          (check-equal? (vector-ref costs 4) #f))
        (when collect-inside? (check (>= (vector-ref costs 3) 4) => #t))))
    (test-case "author edits to caller keys cannot rename a captured owner"
      (def (mutating-source)
        (def owner-keys (list 'a 'b 'c))
        (def (read-row key)
          (when (eq? key 'a) (set-car! (cdr owner-keys) 'rogue))
          (if (eq? key 'a) '(b) []))
        (.o keys: owner-keys .reads: read-row
          .code: (lambda (key) (let (dependencies (read-row key)) (.o reads: dependencies)))))
      (def index (scc.capture-reachability (mutating-source)))
      (check-equal? (.call index .reachable 'a) '(b a))
      (check-equal? (scc.partition-groups (scc.partition (mutating-source))) '((a) (b) (c))))
    (test-case "all 512 directed three-owner graphs agree with reachability"
      (def keys (names 3))
      (def failure #f)
      (for (mask (in-range 512))
        (let (rows (list->vector (for/collect (i (in-range 3))
                     (for/collect (j (in-range 3))
                       (if (odd? (quotient mask (expt 2 (+ (* i 3) j)))) (vector-ref keys j) #f)))))
          (for (i (in-range 3)) (vector-set! rows i (filter identity (vector-ref rows i))))
          (unless (or (matches? keys rows) failure)
            (set! failure (list mask (oracle-groups keys rows)
              (scc.partition-groups (scc.partition (source keys rows))))))))
      (check-equal? failure #f))
    (test-case "native POO generators cover arbitrary edges and duplicate footprints"
      (require-property-passed (typed.check-property (Tuple UInt (List Bool))
        (lambda (input)
          (def size (1+ (modulo (vector-ref input 0) 8)))
          (def keys (names size))
          (def bits (list->vector (vector-ref input 1)))
          (def rows (list->vector (for/collect (i (in-range size))
            (filter identity (for/collect (j (in-range size))
              (and (positive? (vector-length bits))
                (vector-ref bits (modulo (+ (* i size) j) (vector-length bits)))
                (vector-ref keys j)))))))
          (and (change-matches? (scc.partition (source keys rows))
                 (scc.partition (source keys
                   (list->vector (for/collect (i (in-range size))
                     (filter (lambda (key) (not (memq key (vector-ref rows i))))
                       (vector->list keys)))))))
            (matches? keys rows)
            (matches? keys (list->vector (map (lambda (row) (append row row)) (vector->list rows))))
            (matches? (list->vector (reverse (vector->list keys)))
              (list->vector (reverse (vector->list rows))))
            (matches? keys (list->vector (for/collect (i (in-range size))
              (filter identity (for/collect (j (in-range size))
                (and (memq (vector-ref keys i) (vector-ref rows j)) (vector-ref keys j)))))))))
        seed: 2947 cases: 256 size: 64)))
    (test-case "10000-owner shapes visit every node and edge only once"
      (for (family '(isolated self chain pairs ring hub band))
        (check (check-scale (scc.partition (family-source family 10000)) family 10000) => #t)))
    (test-case "indexed membership handles missing equal-size and renamed groups"
      (def before (group-partition '((a b) (c) (removed))))
      (def after (group-partition '((a c) (b) (added))))
      (check-equal? (topology.changed-members before after) '(removed a c b added))
      (check (change-matches? before after) => #t)
      (check-equal? (topology.changed-members before
        (group-partition '((removed) (c) (b a)))) [])
      (def empty (group-partition []))
      (check-equal? (topology.changed-members empty empty) [])
      (check-equal? (topology.changed-members empty before) '(a b c removed))
      (check-equal? (topology.changed-members before empty) '(a b c removed))
      (check-equal? (scc.partition-group-of before 'absent) #f)
      (check-equal? (scc.partition-group-size before 'absent) #f)
      (check-equal? (scc.partition-group-size before 'b) 2)
      (check (eq? (scc.partition-group-of before 'b)
                  (scc.partition-members before 'a)) => #t))
    (test-case "10000-owner membership compares giant merge split and renamed partitions"
      (for (kind '(giant-unchanged isolated-unchanged merge split pairs-unchanged))
        (let-values (((before after expected) (comparison-input kind 10000)))
          (check-equal? (topology.changed-members before after) expected))))
    (test-case "multi-member contributions preserve declaration order"
      (def initial (graph.declaration '(old) []))
      (def revised (component.reconfigure initial
        (list (component.fragment '(a b) [] [])
              (component.fragment '(c d) [] []))))
      (check-equal? (.@ revised keys) '(old a b c d)))
    (test-case "prepared membership fixtures preserve every observed index"
      (def size 16) (def keys (vector->list (names size)))
      (def single (scc.partition (family-source 'self size)))
      (def pairs (scc.partition (family-source 'pairs size)))
      (def giant (scc.partition (family-source 'ring size)))
      (for (kind '(giant-unchanged isolated-unchanged merge split pairs-unchanged))
        (let-values (((old-a old-b expected) (comparison-input kind size))
                     ((new-a new-b actual) (prepared-comparison kind size single pairs giant)))
          (check-equal? actual expected)
          (check-equal? (membership-observation new-a keys) (membership-observation old-a keys))
          (check-equal? (membership-observation new-b keys) (membership-observation old-b keys))
          (check-equal? (topology.changed-members new-a new-b) expected))))
    (test-case "fused capture preserves rejection trace duplicates and private spines"
      (def observed [])
      (def mutable-row (list 'b))
      (let-values (((reads index declared edges)
                    (capture-graph '(a b) (lambda (key)
                      (set! observed (cons key observed))
                      (if (eq? key 'a) mutable-row
                        (begin (set-car! mutable-row 'outside) []))))))
        (check-equal? (reverse observed) '(a b))
        (check-equal? (hash-ref reads 'a) '(b))
        (check-equal? (compact-row index 'a) '(b))
        (check-equal? (list declared edges) '(1 1)))
      (set! observed [])
      (check-exception (capture-graph '(a b c) (lambda (key)
        (set! observed (cons key observed))
        (case key ((a) '(b b)) ((b) '(outside outside)) (else [])))) error-object?)
      (check-equal? (reverse observed) '(a b))
      (let-values (((reads index declared edges)
                    (capture-graph '(a b c) (lambda (_) '(b c b)))))
        (check-equal? (hash-ref reads 'a) '(c b))
        (check-equal? (compact-row index 'a) '(c b))
        (check-equal? (list declared edges) '(9 6))))
    (test-case "the owner ID index rejects every bad roster before an author"
      (for (roster (list '(a b a) '(a 7 b) '(a . b)
                    (let (cycle (list 'a 'b)) (set-cdr! (cdr cycle) cycle) cycle)))
        (def calls 0)
        (def source (.o keys: roster .reads: (lambda (_) (set! calls (1+ calls)) [])
          .code: (lambda (_) (set! calls (1+ calls)) #f)))
        (check-exception (scc.capture-reachability source) error-object?)
        (check-equal? calls 0)
        (check-exception (scc.partition source) error-object?)
        (check-equal? calls 0)))
    (test-case "pure row admission preserves malformed-row refusal and author boundary"
      (for* ((bad (list 17 "not-an-owner" '(b . c) (vector 'b)))
             (kernel (list separate-admission-capture capture-graph)))
        (def observed [])
        (check-exception (kernel '(a b c) (lambda (key)
          (set! observed (cons key observed))
          (case key ((a) '(b c)) ((b) (list 'a bad 'outside))
            (else (error "refused row crossed its author boundary")))) #f) error-object?)
        (check-equal? (reverse observed) '(a b)))
      (for (kernel (list separate-admission-capture capture-graph))
        (for (bad (list '(a . b) (let (cycle (list 'a 'b))
                                     (set-cdr! (cdr cycle) cycle) cycle)))
          (check-exception (kernel '(a b) (lambda (_) bad) #f) error-object?))))
    (test-case "query row projection restores completed rows at the word boundary"
      ;; Reduced PRIVATE word ceilings cover first-row fallback, empty rows,
      ;; rightmost duplicates, chunk crossings and the singleton append route.
      ;; Production always uses the full u32 ceiling; no larger budget is tested.
      (for (fixture (list
             (list '(a b c d e f) '#((b c d e f) (a c d e f) (a) (a b) () (f f)) '(0 5 10))
             (list '(a b c d) '#(() (a c a) () (b c d b)) '(0 2))))
        (def keys (car fixture)) (def input (cadr fixture))
        (def rows (make-hash-table-eq))
        (for ((key keys) (row (in-vector input))) (hash-put! rows key row))
        (defvalues (reference _index declared edges) (capture-graph keys (cut hash-ref rows <>)))
        (for* ((limit (caddr fixture)) (retain? '(#t #f)))
          (def calls [])
          (defvalues (actual index observed-declared observed-edges)
            (capture-graph keys (lambda (key)
              (set! calls (cons key calls)) (hash-ref rows key)) retain? limit))
          (check-equal? (reverse calls) keys)
          (check-equal? index #f)
          (check-equal? (list observed-declared observed-edges) (list declared edges))
          (for (key keys)
            (check-equal? (hash-ref actual key) (hash-ref reference key))
            (check-equal? (wide-reachable actual key) (list-reachable-order reference key)))
          (check-exception (wide-reachable actual 'outside) error-object?)))
      ;; Restoration reads owned chunks, not an earlier mutable author row.
      (def prior-row (list 'b 'c 'b))
      (def calls [])
      (defvalues (rows index declared edges)
        (capture-graph '(a b c) (lambda (key)
          (set! calls (cons key calls))
          (case key ((a) prior-row) ((b) (set-car! prior-row 'outside) '(a)) (else []))) #f 2))
      (check-equal? (reverse calls) '(a b c))
      (check-equal? index #f)
      (check-equal? (list declared edges) '(4 3))
      (check-equal? (hash-ref rows 'a) '(c b))
      (check-equal? (wide-reachable rows 'a) '(b c a))
      ;; A later refused author still stops acquisition at the same owner.
      (set! calls [])
      (check-exception
        (capture-graph '(a b c d) (lambda (key)
          (set! calls (cons key calls))
          (case key ((a) '(b c)) ((b) '(a)) ((c) '(outside)) (else []))) #f 2)
        error-object?)
      (check-equal? (reverse calls) '(a b c)))
    (test-case "ordered capture publishes only a complete verified row"
      (def roster (vector->list (names 65)))
      (def input (list->vector roster))
      (def (key at) (vector-ref input at))
      (def (read owner)
        (cond ((eq? owner (key 0)) (list (key 1)))
              ((eq? owner (key 1)) (list (key 2) (key 3) (key 4)))
              ((eq? owner (key 2)) (list (key 4) (key 3) (key 3) (key 2)))
              (else [])))
      (defvalues (_rows actual declared unique) (capture-graph roster read #f))
      (defvalues (_reference expected original normalized) (capture-graph roster read #f 4294967295 #f))
      (check-equal? (list declared unique) (list original normalized))
      (check-equal? (list declared unique) '(8 7))
      (check-equal? (compact-graph-direction actual) (compact-graph-direction expected))
      (for (owner roster)
        (check-equal? (compact-row actual owner) (compact-row expected owner)))
      ;; The speculative row scans a valid prefix, then a bad tail.
      ;; No later author may run, and the same original row is refused.
      (for (bad (list 'bad-tail
                      (let (cycle (list (key 2) (key 3) (key 4)))
                        (set-cdr! (cddr cycle) cycle) cycle)))
        (def calls [])
        (def row (cons (key 2) (cons (key 3) bad)))
        (check-exception
          (capture-graph roster (lambda (owner)
            (set! calls (cons owner calls))
            (cond ((eq? owner (key 0)) (read owner))
                  ((eq? owner (key 1)) row)
                  (else (error "refused row crossed its author boundary")))) #f)
          error-object?)
        (check-equal? (reverse calls) (list (key 0) (key 1)))))
    (test-case "row workspace growth and duplicate gaps retain exact adjacency"
      (def keys '#(a b c d))
      (check (matches? keys '#((a b b c) (d c d a b b a d c) (c a a) ())) => #t))
    (test-case "inverse continuation owns added roots and drains the older frontier first"
      (def inverse (make-hash-table-symbolic))
      (hash-put! inverse 'a '(b b))
      (hash-put! inverse 'b '(a))
      (hash-put! inverse 'c '(b))
      (def receipt (vector 0 0))
      (def work (start-affected-work inverse receipt))
      (check (advance-affected-work! work '(a) 1) => #f)
      (def roots (list 'c))
      (check (advance-affected-work! work roots 1) => #f)
      (set-car! roots 'outside)
      (check (hash-key? (affected-work-marked work) 'b) => #t)
      (check (hash-key? (affected-work-marked work) 'c) => #f)
      (check (advance-affected-work! work []) => #t)
      (check-equal? (hash-length (affected-work-marked work)) 3)
      (check (hash-key? (affected-work-marked work) 'c) => #t)
      (check-equal? receipt '#(3 4))
      (check (advance-affected-work! work '(a c)) => #t)
      (check-equal? receipt '#(3 4)))
    (test-case "owned reachability captures once and rejects missing roots"
      (def acquisitions [])
      (def row (list 'b 'c))
      (def source (.o keys: '(a b c isolated)
        .reads: (lambda (key)
          (set! acquisitions (cons key acquisitions))
          (case key ((a) row) ((b) (set-car! row 'outside) '(c)) (else [])))))
      (def indexed (scc.capture-reachability source))
      (check (eq? (.@ indexed source) source) => #t)
      (check-equal? (reverse acquisitions) '(a b c isolated))
      (check-equal? (.call indexed .reachable 'a) '(c b a))
      (check-equal? (.call indexed .reachable 'a) '(c b a))
      (check-equal? (.call indexed .reachable 'isolated) '(isolated))
      (check-exception (.call indexed .reachable 'outside) error-object?)
      (check-equal? (length acquisitions) 4))
    (test-case "compact IDs retain distinct same-spelling symbol identities"
      (def a (string->uninterned-symbol "same-owner"))
      (def b (string->uninterned-symbol "same-owner"))
      (def keys (vector a b))
      (check (eq? a b) => #f)
      (check (matches? keys (vector (list b) (list a))) => #t))
    (test-case "representative lookup is exact and does not alias a non-representative"
      (def part (scc.partition (family-source 'pairs 10000)))
      (check-equal? (length (scc.partition-groups part)) 5000)
      (check-equal? (scc.partition-members part 'absent) #f)
      (for (members (scc.partition-groups part))
        (unless (eq? (scc.partition-members part (cadr members)) #f)
          (error "non-representative group alias" members))))))

;; The existing SCC benchmark entry invokes this alongside its unchanged matrix.
;; Source construction and partitioning have separate process-statistics rows.
(def (main)
  (def prepared (vector #f #f))
  (for* ((size '(100000 1000000))
         (family (if (= size 100000) '(isolated self chain pairs ring hub band) '(chain pairs ring band))))
    (defvalues (spec preparation) (measure (lambda () (metadata-family-source family size)) 1))
    (defvalues (getter-counts getter-cost) (measure (cut metadata-getter-counts spec) 1))
    (unless (= (vector-ref getter-counts 0) size) (error "metadata enumeration count"))
    (display "GRAPH-CAPTURE-BEGIN ") (write (list family size)) (newline) (force-output)
    (defvalues (part traversal) (measure (cut scc.partition spec) 1))
    (display "GRAPH-PARTITION-RETURNED ") (write (list family size)) (newline) (force-output)
    (unless (= (vector-ref getter-counts 1) (.@ (scc.partition-work part) validation-edges))
      (error "getter/capture edge count disagreement" family size))
    (check-scale part family size)
    (case family
      ((chain) (vector-set! prepared 0 part))
      ((pairs) (vector-set! prepared 1 part))
      ((ring)
       (membership-capacity size (vector-ref prepared 0) (vector-ref prepared 1) part)
       ;; Release every retained fixture before the degree-16 million-node band.
       (vector-set! prepared 0 #f) (vector-set! prepared 1 #f)))
    (display "GRAPH-SCALE ")
    (write (list family size (cons 'source-preparation preparation)
      (cons 'metadata-getter-pass getter-cost) (cons 'partition-including-getter traversal) (cons 'work (.alist/sort (scc.partition-work part)))))
    (newline))
  ;; Small exact-old-rule controls and 100K/1M candidate windows are separate:
  ;; do not spend the gate proving that the former cubic giant-group scan is slow.
  (for* ((size '(64 256)) (regime '(natural collected))
         (order '((before after after before) (before before after after))))
    (let-values (((before after expected) (comparison-input 'giant-unchanged size)))
      (let (observations [])
        (for (side order)
          (let-values (((result costs) (measure
            (lambda () (if (eq? side 'before) (membership-oracle before after)
                         (topology.changed-members before after))) 1 (eq? regime 'collected))))
            (unless (equal? result expected) (error "membership paired oracle" size side))
            (set! observations (cons (list side costs) observations))))
        (display "GRAPH-MEMBERSHIP-PAIR ")
        (write (list size regime order (reverse observations))) (newline))))
  (displayln "GRAPH-MEMBERSHIP-OK bounded-pairs=32 sizes=100000,1000000")
  (displayln "GRAPH-SCALE-OK sizes=100000,1000000 shapes=7,4")
  (void))
