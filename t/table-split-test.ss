;;; Ordered decomposition shares typed maps, complete admission and owner staging.
(export table-split-test)
(import :std/test :std/error :std/iter
        (only-in ../support/base number-comparer) (only-in ../brace @@method)
        ../object ../mop ../type ../number ../table ../rationaldict ../support/option
        (only-in ../trie SimpleTrie) (only-in ../fun Wrapper.)
        (only-in ./table-wrapper-test box-table) (only-in ./table-validation-test alist-table)
        (prefix-in ../examples/service-collection service.))

;; Compare an existing persistent backend under its own or an explicit numeric order.
(def (ordered table)
  (table-order table (if (.has? table Comparer) (.@ table Comparer)
    (table-comparer (.@ table Key) number-comparer))))

;; Keep deliberate protocol refusals separate from arbitrary comparator failures.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; Independent list filters check both sides, pivot presence and original snapshots.
(def table-split-test
  (test-suite "checked ordered decomposition"
    (test-case "division covers empty singleton and strict finite parts across representations"
      (defvalues (boxed _carrier _keys) (box-table (RationalDict Bool)))
      (for* ((table (list (SimpleTrie UInt Bool) (RationalDict Bool) boxed)) (size '(0 1 2 3 8 17)))
        (def rows (for/collect (key (in-range size)) (cons key (odd? key))))
        (def root (.call table .<-list rows))
        (def parts (.call table .divide/list root))
        (check-equal? (length parts) (min size 2))
        (check-equal? (apply + (map (cut .call table .count <>) parts)) size)
        (when (> size 1)
          (check (andmap (lambda (part) (< 0 (.call table .count part) size)) parts) => #t))
        (when (= size 1) (check (eq? (car parts) root) => #t))
        (check-equal? (.call table .list<- (.call table .join/list parts)) (.call table .list<- root))
        (defvalues (left right) (.call table .divide root))
        (check-equal? (map (cut .call table .list<- <>) (filter identity (list left right)))
          (map (cut .call table .list<- <>) parts))))
    (test-case "indexed division preserves shared buckets admitted Functions and reconstruction"
      (defvalues (indexed source) (service.make-ordered-service-indexes))
      (def f (validate (Fun Integer <- Integer) (lambda (n) (+ n 7))))
      (def base (.call source .<-list (for/collect (key (in-range 8))
        (cons key (vector (+ key 10) (modulo key 2) f)))))
      (def root (.call indexed .wrap base))
      (def parts (.call indexed .divide/list root))
      (check-equal? (map (cut .call indexed .count <>) parts) '(4 4))
      (for (part parts)
        (.call indexed .for-each (lambda (key row)
          (check (eq? (vector-ref row 2) f) => #t)
          (check-equal? (.call indexed .index-ref/opt part 'priority (+ key 10)) (some key))) part)
        (check-equal? (.call indexed .index-fold part 'team
          (lambda (_ bucket count) (+ count (.call source .count bucket))) 0) 4))
      (check-equal? (.call indexed .list<- (.call indexed .join/list parts)) (.call indexed .list<- root))
      (check-equal? (.call indexed .count root) 8))
    (test-case "late branch refinement refuses without consuming owners and corrected input retries"
      (def raw (RationalDict Integer))
      (def table (.cc raw .element?: (lambda (root)
        (and (element? raw root) (not (and (= (.call raw .count root) 2) (.call raw .key? root 3)))))))
      (def base (.call raw .<-list '((1 . 10) (2 . 20) (3 . 30) (4 . 40))))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles table) name)) (def owner (.call protocol .ap base))
        (check-exception (.call protocol .divide/list owner) TypeError?)
        (check-equal? (.call raw .list<- (.call protocol .unap owner)) (.call raw .list<- base))
        (def repaired (.call raw .<-list '((1 . 10) (2 . 20))))
        (def next (.call protocol .apply-delta owner (.call raw .diff base repaired)))
        (check-equal? (map (lambda (part) (.call raw .count (.call protocol .unap part)))
          (.call protocol .divide/list next)) '(1 1))))
    (test-case "all table and Set styles install zero one or two results exactly once"
      (def table (SimpleTrie UInt Integer))
      (for* ((name '(Pure Mutable Linear Posh Classy)) (size '(0 1 4)))
        (def protocol (.ref (table-styles table) name))
        (def root (.call table .<-list (for/collect (key (in-range size)) (cons key key))))
        (def owner (.call protocol .ap root))
        (def parts (.call protocol .divide/list owner))
        (check-equal? (length parts) (min 2 size))
        (check-equal? (apply + (map (lambda (part) (.call table .count (.call protocol .unap part))) parts)) size)
        (cond
          ((eq? name 'Linear) (check-exception (.call protocol .unap owner) Error?))
          ((and (memq name '(Mutable Classy)) (pair? parts)) (check (eq? (car parts) owner) => #t))
          (else (check-equal? (.call table .count (.call protocol .unap owner)) size)))
        (when (and (memq name '(Posh Classy)) (pair? parts))
          (let (expected (min 2 (.call table .count (.call protocol .unap (car parts)))))
            (check-equal? (length {divide/list (car parts)}) expected))))
      (def set (.cc Set<-Table. Table: (SimpleTrie UInt Unit)))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (set-styles set) name)) (def owner (.call protocol .ap (.call set .<-list '(1 2 3 4))))
        (defvalues (left right) (.call protocol .divide owner))
        (check-equal? (+ (.call set .count (.call protocol .unap left)) (.call set .count (.call protocol .unap right))) 4)))
    (test-case "invalid structural progress and original backend exceptions refuse without results"
      (def raw (RationalDict Integer)) (def cause (list 'division-failure))
      (def broken (.cc raw .divide/key: (lambda (root) (values root root))))
      (def base (.call raw .<-list '((1 . 10) (2 . 20))))
      (check-exception (.call broken .divide/list base) (message? "invalid table division progress"))
      (def failing (.cc raw .divide/key: (lambda (_root) (raise cause))))
      (check-exception (.call failing .divide base) (cut eq? <> cause))
      (check-equal? (.call raw .list<- base) '((1 . 10) (2 . 20)))
      (def wrong (.cc raw .divide: (lambda (root) (values root root root))))
      (for (name '(Mutable Linear))
        (def protocol (.ref (table-styles wrong) name)) (def owner (.call protocol .ap base))
        (check-exception (.call protocol .divide owner) true)
        (check-equal? (.call raw .list<- (.call protocol .unap owner)) '((1 . 10) (2 . 20))))
      ;; A singleton reuses its admitted nonempty root without constructing an
      ;; empty remainder that the refinement would legitimately reject.
      (def nonempty (.cc raw .element?: (lambda (root)
        (and (element? raw root) (> (.call raw .count root) 0)))))
      (def one (.call raw .<-list '((1 . 10))))
      (check (eq? (car (.call nonempty .divide/list one)) one) => #t))
    (test-case "division service workflow retains Functions and suppresses IO on branch refusal"
      (def signature (Fun Integer <- Integer)) (def f (validate signature (lambda (n) (+ n 7))))
      (def table (RationalDict signature))
      (def base (.call table .<-list (for/collect (key (in-range 4)) (cons key f))))
      (def effects 0)
      (def action (service.divide-ledger-action table (lambda (parts)
        (set! effects (+ effects 1))
        (apply + (map (lambda (part) (.call table .foldl (lambda (_ callback acc)
          (check (eq? callback f) => #t) (+ acc (callback 3))) 0 part)) parts)))))
      (check-equal? (action base) 40) (check-equal? effects 1)
      (def refined (.cc table .element?: (lambda (root)
        (and (element? table root) (not (= (.call table .count root) 2))))))
      (check-exception ((service.divide-ledger-action refined (lambda (_) (set! effects (+ effects 1)))) base) TypeError?)
      (check-equal? effects 1))
    (test-case "prefixes share backend traversal and inverse recovery without repeated extraction"
      (defvalues (boxed _carrier _keys) (box-table (RationalDict Bool)))
      (for (table (list (SimpleTrie UInt Bool) (RationalDict Bool) boxed))
        (def root (.call table .<-list '((1 . #f) (3 . #t) (8 . #f) (9 . #t))))
        (def rows (.call table .list<- root))
        (for (n '(0 1 2 4 7))
          (def head (.call table .take n root)) (def tail (.call table .drop n root))
          (check-equal? (append (.call table .list<- head) (.call table .list<- tail)) rows)
          (check-equal? (.call table .count head) (min n 4))
          (check-equal? (.call table .count tail) (max 0 (- 4 n)))
          (check-equal? (.call table .list<- (.call table .apply-delta tail
            (invert-table-delta (.call table .diff root tail)))) rows))
        (check-equal? (.call table .list<- root) rows)
        (for (n (list -1 1/2 1.0 #f 'bad))
          (check-exception (.call table .take n root) Error?)
          (check-exception (.call table .drop n root) Error?))))
    (test-case "table and set prefixes use one commit in all five ownership presentations"
      (for* ((set? '(#f #t)) (method '(.take .drop)) (name '(Pure Mutable Linear Posh Classy)))
        (def table (SimpleTrie UInt (if set? Unit Bool)))
        (def descriptor (if set? (.cc Set<-Table. Table: table) table))
        (def protocol (.ref (if set? (set-styles descriptor) (table-styles descriptor)) name))
        (def root (if set? (.call descriptor .<-list '(1 3 8))
          (.call table .<-list '((1 . #f) (3 . #t) (8 . #f)))))
        (def owner (.call protocol .ap root))
        (check-exception ((.ref protocol method) -1 owner) Error?)
        (check (eq? root (.call protocol .unap owner)) => #t)
        (def next (if (memq name '(Posh Classy))
          (if (eq? method '.take) (@@method owner.take 1) (@@method owner.drop 1))
          ((.ref protocol method) 1 owner)))
        (check-equal? (.call descriptor .list<- (.call protocol .unap next))
          (if set? (if (eq? method '.take) '(1) '(3 8))
            (if (eq? method '.take) '((1 . #f)) '((3 . #t) (8 . #f)))))
        (case name
          ((Mutable Classy) (check (eq? owner next) => #t))
          ((Linear) (check-exception (.call protocol .unap owner) Error?))
          (else (check (eq? root (.call protocol .unap owner)) => #t)))))
    (test-case "prefix admission skips forbidden intermediate roots and failed owners retry"
      (for* ((set? '(#f #t)) (method '(.take .drop)) (name '(Pure Mutable Linear Posh Classy)))
        (def table (SimpleTrie UInt (if set? Unit Bool)))
        (def base (if set? (.cc Set<-Table. Table: table) table))
        (def descriptor (.cc base .element?: (lambda (root)
          (and (element? base root) (even? (.call base .count root))))))
        (def root (if set? (.call base .<-list '(1 2 3 4))
          (.call table .<-list '((1 . #f) (2 . #t) (3 . #f) (4 . #t)))))
        (def protocol (.ref (if set? (set-styles descriptor) (table-styles descriptor)) name))
        (def owner (.call protocol .ap root))
        (check-exception ((.ref protocol method) 1 owner) TypeError?)
        (check (eq? root (.call protocol .unap owner)) => #t)
        (def next ((.ref protocol method) 2 owner))
        (check-equal? (.call base .count (.call protocol .unap next)) 2)))
    (test-case "prefixes delegate selection once and reject reentrant installation"
      (for (name '(Mutable Classy))
        (def table (SimpleTrie UInt Bool)) (def protocol #f) (def owner #f)
        (def calls 0) (def armed? #f)
        (def hooked (.cc table .filter: (lambda (pred root)
          (set! calls (+ calls 1))
          (when armed? (set! armed? #f) (.call protocol .acons 9 #t owner))
          (.call table .filter pred root))))
        (set! protocol (.ref (table-styles hooked) name))
        (set! owner (.call protocol .ap (.call table .<-list '((1 . #f) (2 . #t)))))
        (set! armed? #t)
        (check-exception (.call protocol .drop 1 owner) (message? "stale table reference"))
        (check-equal? calls 1)
        (check-equal? (.call table .list<- (.call protocol .unap owner)) '((1 . #f) (2 . #t) (9 . #t)))
        (def next (.call protocol .take 2 owner))
        (check-equal? calls 2)
        (check-equal? (.call table .count (.call protocol .unap next)) 2)))
    (test-case "empty and false-valued sets retain prefix and metadata boundaries"
      (def table (alist-table Bool Unit)) (def set (.cc Set<-Table. Table: table))
      (def root (.call set .<-list '(#f #t)))
      (check-equal? (.call set .list<- (.call set .take 1 root)) '(#f))
      (check-equal? (.call set .list<- (.call set .drop 1 root)) '(#t))
      (for (method '(.take .drop))
        (check-equal? (.call set .list<- ((.ref set method) 10 (.@ set .empty))) [])
        (check-exception ((.ref set method) -1 (.@ set .empty)) Error?))
      (def protocol (.@ (set-styles set) Linear)) (def owner (.call protocol .ap root))
      (.set! set .drop (lambda (_count _root) (error "revised method must not run")))
      (check-exception (.call protocol .drop 1 owner) (message? "stale table styles")))
    (test-case "prefix service draining preserves Functions and correlated indexes through FUN IO"
      (def callback (Fun Integer <- Integer)) (def f (validate callback (lambda (n) (+ n 1))))
      (def source (RationalDict (Tuple Integer callback)))
      (def indexed (table-indexes source (list (.o name: 'badge
        table: (RationalDict (.@ source Key)) unique?: #t project: (lambda (_ row) (vector-ref row 0))))))
      (def root (.call indexed .<-list
        (map (lambda (n) (cons n (vector (* n 10) f))) '(1 2 3 4))))
      (def effects 0)
      (def action (service.drop-ledger-action indexed 2 (lambda (rest)
        (set! effects (+ effects 1))
        (check-equal? (.call indexed .index-ref/opt rest 'badge 10) #f)
        (check-equal? (.call indexed .index-ref/opt rest 'badge 30) (some 3))
        (check (eq? (vector-ref (.call indexed .ref rest 3) 1) f) => #t)
        (check-exception (f "bad") TypeError?) rest)))
      (def rest (action root)) (check-equal? effects 1)
      (check-equal? (.call indexed .list<- (.call indexed .apply-delta rest
        (invert-table-delta (.call indexed .diff root rest)))) (.call indexed .list<- root)))
    (test-case "decons retains exact bindings and every original remainder in backend order"
      (for (table (list (SimpleTrie UInt Bool) (RationalDict Bool)))
        (def root (.call table .<-list '((1 . #f) (3 . #t) (8 . #f))))
        (def original root)
        (for (expected '((1 . #f) (3 . #t) (8 . #f)))
          (defvalues (found rest) (.call table .decons/opt root))
          (check-equal? found (some expected))
          (check-equal? (.call table .ref/opt rest (car expected)) #f)
          (def inverse (invert-table-delta (.call table .diff root rest)))
          (check-equal? (.call table .list<- (.call table .apply-delta rest inverse)) (.call table .list<- root))
          (set! root rest))
        (defvalues (found rest) (.call table .decons/opt root))
        (check-equal? found #f) (check (eq? root rest) => #t)
        (check-exception (.call table .decons root) (message? "no value"))
        (check-equal? (.call table .list<- original) '((1 . #f) (3 . #t) (8 . #f)))))
    (test-case "decons commits once through every table and set ownership presentation"
      (for* ((set? '(#f #t)) (required? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def table (SimpleTrie UInt (if set? Unit Bool)))
        (def descriptor (if set? (.cc Set<-Table. Table: table) table))
        (def family (if set? (set-styles descriptor) (table-styles table)))
        (def protocol (.ref family name))
        (def root (if set? (.call descriptor .<-list '(1 2)) (.call table .<-list '((1 . #f) (2 . #t)))))
        (def owner (.call protocol .ap root))
        (defvalues (found next)
          (if (memq name '(Posh Classy))
            (if required? (@@method owner.decons) (@@method owner.decons/opt))
            ((.ref protocol (if required? '.decons '.decons/opt)) owner)))
        (def expected (if set? 1 (cons 1 #f)))
        (check-equal? found (if required? expected (some expected)))
        (check-equal? (.call descriptor .list<- (.call protocol .unap next))
          (if set? '(2) '((2 . #t))))
        (when (memq name '(Mutable Classy)) (check (eq? owner next) => #t))
        (when (memq name '(Pure Posh)) (check-equal? (.call descriptor .count (.call protocol .unap owner)) 2))
        (when (eq? name 'Linear) (check-exception (.call protocol .unap owner) Error?))
        (def empty-owner (.call protocol .ap (.@ descriptor .empty)))
        (check-exception (.call protocol .decons empty-owner) (message? "no value"))
        (check-equal? (.call descriptor .count (.call protocol .unap empty-owner)) 0)
        (defvalues (absent empty-next) (.call protocol .decons/opt empty-owner))
        (check-equal? absent #f)
        (check-equal? (.call descriptor .count (.call protocol .unap empty-next)) 0)))
    (test-case "set extraction distinguishes false elements from absence"
      (def table (alist-table Bool Unit)) (def set (.cc Set<-Table. Table: table))
      (def root (.call set .singleton #f))
      (defvalues (present rest) (.call set .decons/opt root))
      (check-equal? present (some #f)) (check-equal? (.call set .list<- rest) [])
      (defvalues (element tail) (.call set .decons root))
      (check-equal? element #f) (check-equal? (.call set .list<- tail) []))
    (test-case "complete remainder refusal exposes no choice and keeps every owner retryable"
      (for* ((set? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def table (SimpleTrie UInt (if set? Unit Bool)))
        (def base (if set? (.cc Set<-Table. Table: table) table))
        (def fail? #t)
        (def descriptor (.cc base .element?: (lambda (root)
          (and (element? base root) (not (and fail? (= (.call base .count root) 1)))))))
        (def protocol (.ref (if set? (set-styles descriptor) (table-styles descriptor)) name))
        (def root (if set? (.call base .<-list '(1 2)) (.call base .<-list '((1 . #f) (2 . #t)))))
        (def owner (.call protocol .ap root))
        (check-exception (.call protocol .decons/opt owner) TypeError?)
        (check (eq? root (.call protocol .unap owner)) => #t)
        (set! fail? #f)
        (defvalues (found next) (.call protocol .decons/opt owner))
        (check-equal? (.call base .count (.call protocol .unap next)) 1)
        (check (some? found) => #t)))
    (test-case "inconsistent backend choices reuse ordered old-value conflicts and typed entry refusal"
      (def table (SimpleTrie UInt Bool)) (def root (.call table .<-list '((1 . #f) (2 . #t))))
      (for (row '((1 . #t) (9 . #f)))
        (def inconsistent (.cc table .choose/opt: (lambda (_) (some row))))
        (check-exception (.call inconsistent .decons/opt root) table-conflict?))
      (for (response (list #t (some (cons 'bad #f)) (some (cons 1 'bad))))
        (def malformed (.cc table .choose/opt: (lambda (_) response)))
        (check-exception (.call malformed .decons/opt root) Error?))
      (check-equal? (.call table .list<- root) '((1 . #f) (2 . #t))))
    (test-case "a reentrant installation wins without exposing the losing extraction"
      (for (name '(Mutable Classy))
        (def table (SimpleTrie UInt Bool)) (def protocol #f) (def owner #f) (def armed? #f)
        (def hooked (.cc table .choose/opt: (lambda (root)
          (when armed? (set! armed? #f) (.call protocol .acons 9 #t owner))
          (.call table .choose/opt root))))
        (set! protocol (.ref (table-styles hooked) name))
        (set! owner (.call protocol .ap (.call table .<-list '((1 . #f) (2 . #t)))))
        (set! armed? #t)
        (check-exception (.call protocol .decons/opt owner) (message? "stale table reference"))
        (check-equal? (.call table .list<- (.call protocol .unap owner)) '((1 . #f) (2 . #t) (9 . #t)))
        (defvalues (found next) (.call protocol .decons owner))
        (check-equal? found '(1 . #f))
        (check-equal? (.call table .list<- (.call protocol .unap next)) '((2 . #t) (9 . #t)))))
    (test-case "Function services retain correlated indexes and IO runs only after extraction commits"
      (def callback (Fun Integer <- Integer)) (def f (validate callback (lambda (n) (+ n 1))))
      (def source (RationalDict (Tuple Integer callback)))
      (def indexed (table-indexes source (list (.o name: 'badge
        table: (RationalDict (.@ source Key)) unique?: #t project: (lambda (_ row) (vector-ref row 0))))))
      (def root (.call indexed .<-list (list (cons 1 (vector 10 f)) (cons 2 (vector 20 f)))))
      (def effects 0)
      (def action (service.decons-ledger-action indexed (lambda (found rest)
        (check (eq? (vector-ref (cdr (some-value found)) 1) f) => #t)
        (check (eq? (vector-ref (.call indexed .ref rest 2) 1) f) => #t)
        (check-equal? (.call indexed .index-ref/opt rest 'badge 10) #f)
        (check-equal? (.call indexed .index-ref/opt rest 'badge 20) (some 2))
        (check-exception (f "bad") TypeError?)
        (set! effects (+ effects 1)) rest)))
      (def rest (action root)) (check-equal? effects 1)
      (check-equal? (.call indexed .list<- (.call indexed .apply-delta rest
        (invert-table-delta (.call indexed .diff root rest)))) (.call indexed .list<- root)))
    (test-case "choice shells are captured before child admission and stale factories refuse before choice"
      (def row (cons 1 #f)) (def response (some row))
      (def key (.cc UInt .element?: (lambda (n) (set-car! row 99) (element? UInt n))))
      (def raw (RationalDict Bool)) (def choices 0)
      (def table (.cc raw Key: key .choose/opt: (lambda (_)
        (set! choices (+ choices 1)) (set-car! row 1) response)))
      (def root (.call table .<-list '((1 . #f) (2 . #t))))
      (defvalues (found rest) (.call table .decons/opt root))
      (check-equal? found (some '(1 . #f))) (check-equal? (.call table .list<- rest) '((2 . #t)))
      (def protocol (.@ (table-styles table) Linear)) (def owner (.call protocol .ap root))
      (.set! table .choose/opt (lambda (_) (error "stale choice must not run")))
      (let (before choices)
        (check-exception (.call protocol .decons/opt owner) (message? "stale table styles"))
        (check-equal? choices before)))
    (test-case "sparse huge Trie and Rational roots match the independent oracle"
      (def huge (arithmetic-shift 1 80))
      (for (table (list (SimpleTrie UInt Bool) (ordered (RationalDict Bool))))
        (def rows (list (cons 0 #f) (cons 1 #t) (cons 3 #f) (cons 17 #t) (cons huge #f)))
        (def root (.call table .<-list rows))
        (for (pivot (append '(0 1 2 3 7 17 18) (list huge (+ huge 1))))
          (defvalues (left found right) (.call table .split pivot root))
          (check-equal? (.call table .list<- left) (filter (lambda (row) (< (car row) pivot)) rows))
          (check-equal? (.call table .list<- right) (filter (lambda (row) (> (car row) pivot)) rows))
          (check-equal? found (.call table .ref/opt root pivot))
          (check-equal? (.call table .list<- root) rows))
        (defvalues (left found right) (.call table .split 2 (.@ table .empty)))
        (check (.call table .empty? left) => #t) (check (.call table .empty? right) => #t)
        (check-equal? found #f)
        (check-exception (.call table .split "bad" (.@ table .empty)) TypeError?)))
    (test-case "standard RBTree admits rational and bignum comparison signs"
      (def table (ordered (RationalDict Integer)))
      (def huge (arithmetic-shift 1 100))
      (def rows (list (cons (- huge) 1) (cons 1/3 2) (cons 2/3 3) (cons huge 4)))
      (def root (.call table .<-list rows))
      ;; Both bulk and point construction share the bounded comparator protocol.
      (def point (.call table .acons 2/3 3 (.call table .acons (- huge) 1 (.@ table .empty))))
      (check-equal? (.call table .ref point 2/3) 3)
      (defvalues (left found right) (.call table .split 1/3 root))
      (check-equal? (.call table .list<- left) (list (cons (- huge) 1)))
      (check-equal? (.call table .list<- right) (list (cons 2/3 3) (cons huge 4)))
      (check-equal? found (some 2))
      (check-equal? (.call table .list<- (.call table .remove root (- huge))) (cdr rows)))
    (test-case "five styles expose both successors with one ownership transition"
      (def table (ordered (RationalDict Bool)))
      (def root (.call table .<-list '((1 . #t) (2 . #f) (3 . #t))))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles table) name)) (def owner (.call protocol .ap root))
        (defvalues (left found right) (if (memq name '(Posh Classy)) (@@method owner.split 2)
          (.call protocol .split 2 owner)))
        (check-equal? (.call protocol .list<- left) '((1 . #t)))
        (check-equal? (.call protocol .list<- right) '((3 . #t)))
        (check-equal? found (some #f))
        (case name
          ((Pure Posh) (check (eq? (.call protocol .unap owner) root) => #t))
          ((Mutable Classy) (check (eq? owner left) => #t) (check (eq? left right) => #f))
          ((Linear) (check-exception (.call protocol .unap owner) (message? "consumed table reference"))))))
    (test-case "late right-side failure preserves all owners and permits explicit retry"
      (def source (RationalDict Integer)) (def calls 0) (def refuse? #t)
      (def comparer (table-comparer (.@ source Key) (lambda (a b)
        (set! calls (+ calls 1))
        (when (and refuse? (= calls 5)) (error "late comparison refused"))
        (number-comparer a b))))
      ;; Preserve the backend fold order so the fifth comparison is in pass two.
      (def table (.cc source Comparer: comparer .sources: (list comparer)))
      (def root (.call table .<-list '((1 . 10) (2 . 20) (3 . 30))))
      (for (name '(Mutable Linear Classy))
        (def protocol (.ref (table-styles table) name)) (def owner (.call protocol .ap root))
        (set! calls 0) (set! refuse? #t)
        (check-exception (.call protocol .split 2 owner) (message? "late comparison refused"))
        (check (eq? root (.call protocol .unap owner)) => #t)
        (set! refuse? #f)
        (defvalues (left found right) (.call protocol .split 2 owner))
        (check-equal? (.call protocol .list<- right) '((3 . 30)))
        (check-equal? found (some 20))))
    (test-case "custom refinement refuses the second result before either escapes"
      (def source (RationalDict Integer))
      (def ordinary (ordered source))
      (def table (.cc ordinary .element?: (lambda (root)
        (and (element? ordinary root) (not (equal? (.call ordinary .list<- root) '((3 . 30))))))))
      (def root (.call table .<-list '((1 . 10) (2 . 20) (3 . 30))))
      (def protocol (.@ (table-styles table) Linear)) (def owner (.call protocol .ap root))
      (check-exception (.call protocol .split 2 owner) TypeError?)
      (check (eq? root (.call protocol .unap owner)) => #t)
      (defvalues (left found right) (.call protocol .split 3 owner))
      (check-equal? found (some 30)) (check-equal? (.call protocol .list<- right) []))
    (test-case "transported comparison and set presence retain explicit order"
      (def source (RationalDict Unit))
      (def comparer (table-comparer (.@ source Key) number-comparer))
      (def key (.cc Wrapper. Domain: (.@ source Key) Codomain: (.@ source Key) .ap: - .unap: -))
      (def table (table-order source (table-comparer-wrapper comparer key)))
      (def set (.cc Set<-Table. Table: table sexp: 'negative-set))
      (def root (.call set .<-list '(-1 -2 -3)))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (set-styles set) name))
        (defvalues (left found right) (.call protocol .split -2 (.call protocol .ap root)))
        (check-equal? (.call protocol .list<- left) '(-1))
        (check-equal? (.call protocol .list<- right) '(-3)) (check-equal? found #t))
      ;; The declared representation Wrapper uses the same bulk-map path.
      (defvalues (boxed _carrier keys) (box-table (RationalDict Bool)))
      (def view (table-order boxed (table-comparer-wrapper comparer keys)))
      (def boxed-root (.call view .<-list '((-1 . #t) (-2 . #f) (-3 . #t))))
      (defvalues (before middle after) (.call view .split -2 boxed-root))
      (check-equal? (.call view .list<- before) '((-1 . #t)))
      (check-equal? (.call view .list<- after) '((-3 . #t)))
      (check-equal? middle (some #f))
      ;; Direct set calls must retain their custom refinement, not only styles.
      (def refined (.cc set .element?: (lambda (input)
        (and (element? set input) (not (equal? (.call set .list<- input) '(-3)))))))
      (check-exception (.call refined .split -2 root) TypeError?)
      (check-equal? (.call set .list<- root) '(-1 -2 -3))
      (def unordered (alist-table UInt Integer))
      (check-exception (.call unordered .split 2 (.@ unordered .empty))
        (message? "unordered table split")))
    (test-case "Function leaves and correlated indexes survive FUN IO and inverse retry"
      (def function (Fun Integer <- Integer)) (def callback (validate function (lambda (n) (+ n 1))))
      (def source (RationalDict (Tuple Integer function)))
      (def declaration (.cc Type. name: 'rank table: (RationalDict (.@ source Key)) unique?: #t
        project: (lambda (_ row) (vector-ref row 0))))
      (def indexed (table-indexes source (list declaration))) (def table (ordered indexed))
      (def base (.call table .<-list (list (cons 1 (vector 10 callback))
        (cons 2 (vector 20 callback)) (cons 3 (vector 30 callback)))))
      (def observed 0)
      (def action (service.split-ledger-action table 2 (lambda (left found right)
        (set! observed (+ observed 1))
        (check (eq? callback (vector-ref (some-value found) 1)) => #t)
        (check (eq? callback (vector-ref (.call table .ref right 3) 1)) => #t)
        (check-equal? (.call indexed .index-ref/opt left 'rank 10) (some 1))
        (check-equal? (.call indexed .index-ref/opt right 'rank 10) #f)
        (check-exception ((vector-ref (some-value found) 1) "bad") TypeError?)
        (def delta (.call table .diff base left))
        (def restored (.call table .apply-delta left (invert-table-delta delta)))
        (check-equal? (.call table .list<- restored) (.call table .list<- base))
        'published)))
      (check-equal? (action base) 'published) (check-equal? observed 1))
    (test-case "raw backend comparer dependencies invalidate all retained styles"
      (for (name '(Pure Mutable Linear Posh Classy))
        (def dependency (.o revision: 0))
        (def comparer (table-comparer UInt number-comparer (list dependency)))
        (def table (.cc (SimpleTrie UInt Integer) Comparer: comparer))
        (def root (.call table .<-list '((1 . 10) (2 . 20))))
        (def protocol (.ref (table-styles table) name))
        (def owner (.call protocol .ap root))
        (.set! dependency revision 1)
        (check-exception (.call protocol .split 1 owner) (message? "stale table styles"))
        ;; A genuinely fresh comparer/factory can retry; stale factories never revive.
        (def current (.cc table Comparer: (table-comparer UInt number-comparer (list dependency))))
        (def next-protocol (.ref (table-styles current) name))
        (def next (.call next-protocol .ap root))
        (.set! (.@ current Comparer) sexp 'changed)
        (check-exception (.call next-protocol .split 1 next) (message? "stale table styles"))
        (def fresh (.ref (table-styles current) name))
        (defvalues (left found right) (.call fresh .split 1 (.call fresh .ap root)))
        (check-equal? found (some 10))
        (check-equal? (.call fresh .list<- right) '((2 . 20)))))
    (test-case "reentrant winner and stale comparer cannot publish prepared sides"
      (def source (RationalDict Integer)) (def owner #f) (def protocol #f) (def fired? #f)
      (def comparer (table-comparer (.@ source Key) (lambda (a b)
        (when (and owner (not fired?)) (set! fired? #t) (.call protocol .acons 9 90 owner))
        (number-comparer a b))))
      (def table (table-order source comparer))
      (set! protocol (.@ (table-styles table) Mutable))
      (set! owner (.call protocol .ap (.call table .<-list '((1 . 10) (2 . 20) (3 . 30)))))
      (check-exception (.call protocol .split 2 owner) (message? "stale table reference"))
      (check-equal? (.call protocol .ref owner 9) 90)
      (.set! comparer sexp 'changed)
      (check-exception (.call protocol .split 2 owner) Error?))))
