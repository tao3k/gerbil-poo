;;; Incremental view composition regressions in the existing table test namespace.
    (test-case "composed views deliver exact deltas and retain Function leaves across five styles"
      (def callback (Fun Integer <- Integer))
      (def f (validate callback (lambda (n) (+ n 3))))
      (def source (SimpleTrie UInt (Tuple (List UInt) callback)))
      (def middle (.cc (SimpleTrie UInt callback) .diff: (lambda args (error "unexpected middle diff"))))
      (def target (.cc (SimpleTrie UInt callback) .diff: (lambda args (error "unexpected target diff"))))
      (def calls [])
      (def composed (table-projection-compose (service.make-service-routes source middle)
        (table-projection middle target (lambda (key value)
          (set! calls (cons key calls)) (some (cons (modulo key 10) value))))))
      (def root (.call source .<-list (list (cons 1 (vector '(10 21) f)) (cons 9 (vector '(99) f)))))
      (def state (.call composed .ap root))
      (def delta (.call source .delta/opt 1 (lambda (_) (some (vector '(32 43) f))) root))
      (for (name '(Pure Mutable Linear Posh Classy))
        (set! calls [])
        (def protocol (.ref (table-styles target) name))
        (def effects 0)
        (def request (object<-alist (list (cons 'state state)
          (cons 'target (.call protocol .ap (.call composed .get state))))))
        (def result ((service.publish-projected-ledger-action composed delta protocol
          (lambda (_) (set! effects (+ effects 1)))) request))
        (check-equal? calls '(43 32))
        (check-equal? effects 1)
        (def observed (.call protocol .unap (.@ result target)))
        (check-equal? (map car (.call target .list<- observed)) '(2 3 9))
        (for (key '(2 3 9)) (check (eq? (.call target .ref observed key) f) => #t))
        (check-exception ((.call target .ref observed 2) "bad") TypeError?)
        (def restored (.call protocol .apply-delta (.@ result target) (invert-table-delta (.@ result delta))))
        (check-equal? (map car (.call target .list<- (.call protocol .unap restored))) '(0 1 9)))
      (def next (.call composed .apply-delta state delta))
      (def restored (.call composed .apply-delta next (invert-table-delta delta)))
      (check-equal? (.call source .list<- (.call composed .unap restored)) (.call source .list<- root)))
    (test-case "downstream collision refuses the whole chain and leaves an immutable retry"
      (def source (SimpleTrie UInt UInt)) (def middle (SimpleTrie UInt UInt))
      (def target (SimpleTrie UInt UInt)) (def deliveries 0)
      (def composed (table-projection-compose
        (table-projection source middle (lambda (key value) (some (cons key value))))
        (table-projection middle target (lambda (key value) (some (cons (modulo key 10) value))))))
      (def root (.call source .<-list '((1 . 10) (2 . 20))))
      (def state (.call composed .ap root))
      (def bad (.call source .delta/opt 11 (lambda (_) (some 30)) root))
      (check-exception (.call composed .apply-delta state bad
        (lambda args (set! deliveries (+ deliveries 1)))) table-index-conflict?)
      (check-equal? deliveries 0)
      (check-equal? (.call target .list<- (.call composed .get state)) '((1 . 10) (2 . 20)))
      (def good (.call source .delta/opt 3 (lambda (_) (some 30)) root))
      (def next (.call composed .apply-delta state good))
      (check-equal? (.call target .list<- (.call composed .get next)) '((1 . 10) (2 . 20) (3 . 30)))
      (def stale (.call source .delta/opt 1 (lambda (_) (some 99)) (.call source .acons 1 0 root)))
      (check-exception (.call composed .apply-delta state stale) table-conflict?)
      (check-equal? (.call composed .get state) (.call composed .get
        (.call composed .apply-delta next (invert-table-delta good)))))
    (test-case "composed service expansion and grouped summaries invalidate only affected cohorts"
      (def callback (Fun Integer <- Integer))
      (def f (validate callback (lambda (n) (+ n 3))))
      (def source (SimpleTrie UInt (Tuple (List UInt) callback)))
      (def routes (SimpleTrie UInt callback)) (def summary (SimpleTrie UInt Integer))
      (def composed (service.make-service-route-summary source routes summary))
      (def root (.call source .<-list (list (cons 1 (vector '(10 11) f)) (cons 2 (vector '(20) f)))))
      (def state (.call composed .ap root))
      (check-equal? (.call summary .list<- (.call composed .get state)) '((1 . 6) (2 . 3)))
      (def delta (.call source .delta/opt 1 (lambda (_) (some (vector '(30) f))) root))
      (defvalues (next output) (.call composed .apply-delta state delta values))
      (check-equal? (table-delta-count output) 2)
      (check-equal? (.call summary .list<- (.call composed .get next)) '((2 . 3) (3 . 3)))
      (check-equal? (.call summary .list<- (.call summary .apply-delta (.call composed .get state) output))
        '((2 . 3) (3 . 3))))
    (test-case "composition rejects foreign caches, mismatched middle descriptors and stale declarations"
      (def source (SimpleTrie UInt UInt)) (def middle (SimpleTrie UInt UInt))
      (def target (SimpleTrie UInt UInt))
      (def first (table-projection source middle (lambda (key value) (some (cons key value)))))
      (def second (table-projection middle target (lambda (key value) (some (cons key value)))))
      (def composed (table-projection-compose first second))
      (def root (.call source .<-list '((1 . 1)))) (def state (.call composed .ap root))
      (def foreign (table-projection-compose first second))
      (check-exception (.call foreign .get state) (message? "incompatible projection composition state"))
      (check-exception (table-projection-compose first
        (table-projection (.cc middle sexp: 'other) target (lambda (key value) (some (cons key value)))))
        (message? "incompatible projection composition"))
      (.set! second note 'revised)
      (check-exception (.call composed .get state) (message? "stale projection composition")))
    (test-case "downstream whole-root refusal and callback failure never deliver a partial chain"
      (def source (SimpleTrie UInt UInt)) (def middle (SimpleTrie UInt UInt))
      (def raw (SimpleTrie UInt UInt))
      (def target (.cc raw .element?: (lambda (root)
        (and (.call raw .element? root) (= (length (.call raw .list<- root)) 2)))))
      (def cause (Error "downstream callback" irritants: [] where: #f)) (def deliveries 0)
      (def composed (table-projection-compose
        (table-projection source middle (lambda (key value) (some (cons key value))))
        (table-projection middle target (lambda (key value)
          (if (= value 77) (raise cause) (some (cons key value)))))))
      (def root (.call source .<-list '((1 . 10) (2 . 20)))) (def state (.call composed .ap root))
      (check-exception (.call composed .apply-delta state
        (.call source .delta/opt 1 (lambda (_) #f) root)
        (lambda args (set! deliveries (+ deliveries 1)))) TypeError?)
      (check-exception (.call composed .apply-delta state
        (.call source .delta/opt 1 (lambda (_) (some 77)) root)
        (lambda args (set! deliveries (+ deliveries 1)))) (lambda (caught) (eq? caught cause)))
      (check-equal? deliveries 0)
      (def next (.call composed .apply-delta state (.call source .delta/opt 1 (lambda (_) (some 30)) root)))
      (check-equal? (.call raw .list<- (.call composed .get next)) '((1 . 30) (2 . 20)))
      (check-equal? (.call raw .list<- (.call composed .get state)) '((1 . 10) (2 . 20))))
    (test-case "nested composition coalesces batches and keeps no-op delta origins live"
      (def source (SimpleTrie UInt UInt)) (def middle (SimpleTrie UInt UInt))
      (def final (SimpleTrie UInt UInt)) (def calls [])
      (def first (table-projection source middle (lambda (key value) (some (cons key value)))))
      (def second (table-projection middle final (lambda (key value)
        (set! calls (cons value calls)) (some (cons key (+ value 1))))))
      (def last (table-projection final source (lambda (key value) (some (cons key (* value 2))))))
      (def composed (table-projection-compose (table-projection-compose first second) last))
      (def root (.call source .<-list '((1 . 1) (9 . 9))))
      (def state (.call composed .ap root))
      (def a (.call source .delta/opt 1 (lambda (_) (some 10)) root))
      (def b (.call source .delta/opt 1 (lambda (_) (some 20)) (.call source .apply-delta root a)))
      (set! calls [])
      (def next (.call composed .apply-delta state (.call source .compose-deltas (list a b))))
      (check-equal? calls '(20))
      (check-equal? (.call source .list<- (.call composed .get next)) '((1 . 42) (9 . 20)))
      (def origin (.o epoch: 0)) (def witnessed (.cc source .sources: (list origin)))
      (def noop (.call witnessed .delta/opt 1 identity root))
      (defvalues (same output) (.call composed .apply-delta state noop values))
      (check-equal? (table-delta-count output) 0)
      (.set! origin epoch 1)
      (check-exception (.call composed .get same) Error?)
      (check-exception (.call composed .unap same) Error?))
    (test-case "joint join deltas flow to Function targets through every publication style"
      (def signature (Fun Integer <- Integer))
      (def f (validate signature (lambda (n) (+ n 3))))
      (def g (validate signature (lambda (n) (+ n 5))))
      (def left (SimpleTrie UInt UInt)) (def right (SimpleTrie UInt signature))
      (def middle (.cc (SimpleTrie UInt signature) .diff: (lambda args (error "unexpected middle diff"))))
      (def target (.cc (SimpleTrie UInt signature) .diff: (lambda args (error "unexpected target diff"))))
      (def calls [])
      (def join (table-lookup-join left right middle (lambda (_key row) row)
        (lambda (key _row found) (and (some? found) (some (cons key (some-value found)))))))
      (def chain (table-projection-compose join (table-projection middle target
        (lambda (key value) (set! calls (cons key calls)) (some (cons (+ key 100) value))))))
      (check (.has? chain .apply-deltas) => #t)
      (check (.has? chain .apply-delta) => #f)
      (def l (.call left .<-list '((1 . 10) (2 . 10) (9 . 90))))
      (def r (.call right .<-list (list (cons 10 f) (cons 90 g))))
      (def state (.call chain .ap (cons l r)))
      (def dl (.call left .delta/opt 2 (lambda (_) (some 20)) l))
      (def final-r (.call right .acons 20 f (.call right .acons 10 g r)))
      (def dr (.call right .diff r final-r))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles target) name)) (def effects 0)
        (def action (service.publish-join-action chain dl dr protocol (lambda (_) (set! effects (+ effects 1)))))
        (def stale (.call protocol .ap (.call target .acons 101 g (.call chain .get state))))
        (check-exception (action (object<-alist (list (cons 'state state) (cons 'target stale)))) table-conflict?)
        (check-equal? effects 0)
        (set! calls [])
        (def result (action (object<-alist (list (cons 'state state)
          (cons 'target (.call protocol .ap (.call chain .get state)))))))
        (check-equal? effects 1)
        (check-equal? (length calls) 2)
        (check (and (member 1 calls) (member 2 calls) #t) => #t)
        (def observed (.call protocol .unap (.@ result target)))
        (check (eq? (.call target .ref observed 101) g) => #t)
        (check (eq? (.call target .ref observed 102) f) => #t)
        (check (eq? (.call target .ref observed 109) g) => #t)
        (check-exception ((.call target .ref observed 101) "bad") TypeError?)
        (def undo (.call protocol .apply-delta (.@ result target) (invert-table-delta (.@ result delta))))
        (check (eq? (.call target .ref (.call protocol .unap undo) 101) f) => #t))
      (def next (.call chain .apply-deltas state dl dr))
      (def restored (.call chain .apply-deltas next (invert-table-delta dl) (invert-table-delta dr)))
      (check-equal? (.call target .list<- (.call chain .get restored)) (.call target .list<- (.call chain .get state))))
    (test-case "shared service policy revision feeds grouped summaries without reinitializing the chain"
      (def signature (Fun Integer <- Integer))
      (def f (validate signature (lambda (n) (+ n 3))))
      (def g (validate signature (lambda (n) (+ n 5))))
      (def services (SimpleTrie UInt (Tuple UInt signature)))
      (def policies (SimpleTrie UInt Bool)) (def routes (SimpleTrie UInt signature))
      (def summary (.cc (SimpleTrie UInt Integer) .diff: (lambda args (error "unexpected summary diff"))))
      (def chain (service.make-service-policy-summary services policies routes summary))
      (def l (.call services .<-list (list (cons 11 (vector 10 f)) (cons 12 (vector 10 g))
        (cons 21 (vector 20 f)) (cons 99 (vector 90 g)))))
      (def r (.call policies .<-list '((10 . #t) (20 . #f) (90 . #t))))
      (def state (.call chain .ap (cons l r)))
      (check-equal? (.call summary .list<- (.call chain .get state)) '((1 . 8) (9 . 5)))
      (def dl (.call services .delta/opt 12 (lambda (_) (some (vector 20 g))) l))
      (def dr (.call policies .diff r (.call policies .<-list '((10 . #f) (20 . #t) (90 . #t)))))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles summary) name))
        (def result ((service.publish-join-action chain dl dr protocol void)
          (object<-alist (list (cons 'state state) (cons 'target (.call protocol .ap (.call chain .get state)))))))
        (check-equal? (.call summary .list<- (.call protocol .unap (.@ result target))) '((1 . 5) (2 . 3) (9 . 5)))
        (check-equal? (table-delta-count (.@ result delta)) 2)))
    (test-case "nested joint chains retain binary arity across alternating source revisions and inverse recovery"
      (def source (SimpleTrie UInt UInt))
      (def join (table-lookup-join source source source (lambda (_key row) row)
        (lambda (key _row found) (and (some? found) (some (cons key (some-value found)))))))
      (def add (table-projection source source (lambda (key value) (some (cons key (+ value 1))))))
      (def double (table-projection source source (lambda (key value) (some (cons key (* value 2))))))
      (def chain (table-projection-compose (table-projection-compose join add) double))
      (def l (.call source .<-list '((1 . 10) (2 . 20))))
      (def r (.call source .<-list '((10 . 100) (20 . 200))))
      (def state (.call chain .ap (cons l r)))
      (for (round (in-range 8))
        (def next-l (.call source .acons 1 (if (even? round) 20 10) l))
        (def next-r (.call source .acons 20 (+ 200 round) r))
        (def dl (.call source .diff l next-l)) (def dr (.call source .diff r next-r))
        (defvalues (next output) (.call chain .apply-deltas state dl dr values))
        (def expected (map (lambda (row)
          (cons (car row) (* 2 (+ 1 (.call source .ref next-r (cdr row)))))) (.call source .list<- next-l)))
        (check-equal? (.call source .list<- (.call chain .get next)) expected)
        (check-equal? (.call source .list<- (.call source .apply-delta (.call chain .get state) output)) expected)
        (def undo (.call chain .apply-deltas next (invert-table-delta dl) (invert-table-delta dr)))
        (check-equal? (.call source .list<- (.call chain .get undo)) (.call source .list<- (.call chain .get state)))
        (set! l next-l) (set! r next-r) (set! state next)))
    (test-case "joint source conflict and downstream refusal suppress delivery and preserve retry"
      (def source (SimpleTrie UInt UInt)) (def calls 0) (def delivered 0)
      (def cause (Error "downstream joint refusal" irritants: [] where: #f))
      (def join (table-lookup-join source source source (lambda (_key row) row)
        (lambda (key _row found) (and (some? found) (some (cons key (some-value found)))))))
      (def chain (table-projection-compose join (table-projection source source
        (lambda (key value) (set! calls (+ calls 1))
          (if (= value 77) (raise cause) (some (cons key value)))))))
      (def l (.call source .<-list '((1 . 10)))) (def r (.call source .<-list '((10 . 100))))
      (def state (.call chain .ap (cons l r)))
      (def dl (.call source .delta/opt 2 (lambda (_) (some 10)) l))
      (def stale (.call source .delta/opt 10 (lambda (_) (some 77)) (.call source .acons 10 0 r)))
      (set! calls 0)
      (check-exception (.call chain .apply-deltas state dl stale
        (lambda args (set! delivered (+ delivered 1)))) table-conflict?)
      (check-equal? calls 0)
      (check-exception (.call chain .apply-deltas state dl
        (.call source .delta/opt 10 (lambda (_) (some 77)) r)
        (lambda args (set! delivered (+ delivered 1)))) (lambda (caught) (eq? caught cause)))
      (check-equal? delivered 0)
      (check-equal? (.call source .list<- (.call chain .get state)) '((1 . 100)))
      (def next (.call chain .apply-deltas state dl (.call source .delta/opt 10 (lambda (_) (some 88)) r)))
      (check-equal? (.call source .list<- (.call chain .get next)) '((1 . 88) (2 . 88))))
    (test-case "joint no-op origins and declaration invalidation reach every nested view"
      (def source (SimpleTrie UInt UInt)) (def origin (.o epoch: 0))
      (def witnessed (.cc source .sources: (list origin)))
      (def join (table-lookup-join source source source (lambda (_key row) row)
        (lambda (key _row found) (and (some? found) (some (cons key (some-value found)))))))
      (def projection (table-projection source source (lambda (key value) (some (cons key value)))))
      (def chain (table-projection-compose (table-projection-compose join projection) projection))
      (def l (.call source .<-list '((1 . 10)))) (def r (.call source .<-list '((10 . 100))))
      (def state (.call chain .ap (cons l r)))
      (defvalues (next output) (.call chain .apply-deltas state (.call source .diff l l)
        (.call witnessed .diff r r) values))
      (check-equal? (table-delta-count output) 0)
      (.set! origin epoch 1)
      (check-exception (.call chain .get next) Error?)
      (check-exception (.call chain .unap next) Error?)
      (.set! projection note 'changed)
      (check-exception (.call chain .get state) (message? "stale projection composition")))
    (test-case "many-to-many group join and downstream projection publish one final delta"
      (def source (SimpleTrie UInt UInt))
      (def pairs (alist-table (Pair UInt UInt) Unit))
      (def join (table-group-join source source source (SimpleTrie UInt Unit) pairs
        (lambda (_key row) row) (lambda (_key row) row)
        (lambda (lk lv rk rv) (some (cons (+ (* lk 100) rk) (+ lv rv))))))
      (def chain (table-projection-compose join (table-projection source source
        (lambda (key value) (some (cons key (+ value 1)))))))
      (def l (.call source .<-list '((1 . 10) (2 . 20))))
      (def r (.call source .<-list '((7 . 10) (8 . 20))))
      (def state (.call chain .ap (cons l r)))
      (def dl (.call source .delta/opt 1 (lambda (_) (some 20)) l))
      (def dr (.call source .delta/opt 7 (lambda (_) (some 20)) r))
      (defvalues (next output) (.call chain .apply-deltas state dl dr values))
      (check-equal? (.call source .list<- (.call chain .get next)) '((107 . 41) (108 . 41) (207 . 41) (208 . 41)))
      (check-equal? (.call source .list<- (.call source .apply-delta (.call chain .get state) output))
        (.call source .list<- (.call chain .get next)))
      (def undo (.call chain .apply-deltas next (invert-table-delta dl) (invert-table-delta dr)))
      (check-equal? (.call source .list<- (.call chain .get undo)) '((107 . 21) (208 . 41))))
