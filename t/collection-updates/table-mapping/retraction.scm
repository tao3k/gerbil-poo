;;; Cached projection retraction owns observations before backend eviction.
    (test-case "single projection retires original target keys before a provider recycles its Option"
      (def signature (Fun Integer <- Integer))
      (def f (validate signature (lambda (n) (+ n 1))))
      (def g (validate signature (lambda (n) (+ n 2))))
      (def source (recycling-projection-source (.cc (RationalDict (Tuple Integer signature)) Key: Integer)))
      (def target (.cc (RationalDict signature) Key: Integer
        .diff: (lambda args (error "unexpected target diff"))))
      (def projection (table-projection source target
        (lambda (_ row) (some (cons (vector-ref row 0) (vector-ref row 1))))))
      (def root (.call source .<-list (list (cons 1 (vector 10 f)) (cons 9 (vector 90 f)))))
      (def state (.call projection .ap root)) (def before (.call projection .get state))
      (def delta (.call source .delta/opt 1 (lambda (_) (some (vector 20 g))) root))
      (defvalues (next output) (.call projection .apply-delta state delta values))
      (check-equal? (map car (.call target .list<- (.call projection .get next))) '(20 90))
      (check-eq? (.call target .ref (.call projection .get next) 20) g)
      (check-equal? (.call target .list<- (.call target .apply-delta before output))
        (.call target .list<- (.call projection .get next)))
      (check-equal? (.call target .list<- (.call target .apply-delta (.call projection .get next)
        (invert-table-delta output))) (.call target .list<- before))
      (def restored (.call projection .apply-delta next (invert-table-delta delta)))
      (check-equal? (.call target .list<- (.call projection .get restored)) (.call target .list<- before)))
    (test-case "multivalued swaps release all old owners and preserve exact deltas and unaffected Functions"
      (def signature (Fun Integer <- Integer))
      (def f (validate signature (lambda (n) (+ n 1)))) (def g (validate signature (lambda (n) (+ n 2))))
      (def source (recycling-projection-source (.cc (RationalDict (Tuple (List UInt) signature)) Key: Integer)))
      (def target (.cc (RationalDict signature) Key: UInt .diff: (lambda args (error "unexpected target diff"))))
      (def projection (service.make-service-routes source target))
      (def root (.call source .<-list (list (cons 1 (vector '(10 11) f))
        (cons 2 (vector '(20) g)) (cons 9 (vector '(90) f)))))
      (def state (.call projection .ap root))
      (def after (.call source .acons 2 (vector '(10 11) g) (.call source .acons 1 (vector '(20) f) root)))
      (def delta (.call source .diff root after))
      (defvalues (next output) (.call projection .apply-delta state delta values))
      (def observed (.call projection .get next))
      (check-equal? (map car (.call target .list<- observed)) '(10 11 20 90))
      (check-eq? (.call target .ref observed 10) g) (check-eq? (.call target .ref observed 20) f)
      (check-eq? (.call target .ref observed 90) f)
      (check-equal? (table-delta-count output) 6)
      (def deletion (.call source .delta/opt 2 (lambda (_) #f) after))
      (def deleted (.call projection .apply-delta next deletion))
      (check-equal? (map car (.call target .list<- (.call projection .get deleted))) '(20 90))
      (def undone (.call projection .apply-delta deleted (invert-table-delta deletion)))
      (check-equal? (.call target .list<- (.call projection .get undone)) (.call target .list<- observed)))
    (test-case "recycled ledgers compose through exact middle deltas without stale output keys"
      (def signature (Fun Integer <- Integer)) (def f (validate signature (lambda (n) (+ n 4))))
      (def source (recycling-projection-source (.cc (RationalDict (Tuple (List UInt) signature)) Key: Integer)))
      (def middle (recycling-projection-source (.cc (RationalDict signature) Key: UInt
        .diff: (lambda args (error "unexpected middle diff")))))
      (def target (.cc (RationalDict signature) Key: UInt .diff: (lambda args (error "unexpected target diff"))))
      (def calls [])
      (def chain (table-projection-compose (service.make-service-routes source middle)
        (table-projection middle target (lambda (key value)
          (set! calls (cons key calls)) (some (cons (+ key 1000) value))))))
      (def root (.call source .<-list (list (cons 1 (vector '(10 11) f)) (cons 9 (vector '(90) f)))))
      (def state (.call chain .ap root)) (set! calls [])
      (def delta (.call source .delta/opt 1 (lambda (_) (some (vector '(20 21) f))) root))
      (defvalues (next output) (.call chain .apply-delta state delta values))
      (check-equal? (and (= (length calls) 2) (memv 20 calls) (memv 21 calls) #t) #t)
      (check-equal? (map car (.call target .list<- (.call chain .get next))) '(1020 1021 1090))
      (check-eq? (.call target .ref (.call chain .get next) 1090) f)
      (check-equal? (.call target .list<- (.call target .apply-delta (.call chain .get next)
        (invert-table-delta output))) (.call target .list<- (.call chain .get state))))
    (test-case "five-style publication refuses collisions and target constraints then retries without replaying old rows"
      (def signature (Fun Integer <- Integer)) (def f (validate signature (lambda (n) (+ n 3))))
      (def source (recycling-projection-source (.cc (RationalDict (Tuple (List UInt) signature)) Key: Integer)))
      (def raw (.cc (RationalDict signature) Key: UInt))
      (def target (.cc raw .element?: (lambda (root)
        (and (element? raw root) (not (.call raw .key? root 30))))))
      (def projection (service.make-service-routes source target))
      (def root (.call source .<-list (list (cons 1 (vector '(10 11) f)) (cons 9 (vector '(90) f)))))
      (def state (.call projection .ap root))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles target) name)) (def effects 0)
        (def owner (.call protocol .ap (.call projection .get state)))
        (def request (object<-alist (list (cons 'state state) (cons 'target owner))))
        (def consume (lambda (_) (set! effects (+ effects 1))))
        (check-exception ((service.reroute-service-action projection 1 '(90) protocol consume) request)
          table-index-conflict?)
        (check-exception ((service.reroute-service-action projection 1 '(30) protocol consume) request) TypeError?)
        (check-equal? effects 0)
        (check-equal? (map car (.call target .list<- (.call protocol .unap owner))) '(10 11 90))
        (def result ((service.reroute-service-action projection 1 '(40 41) protocol consume) request))
        (check-equal? effects 1)
        (check-equal? (map car (.call target .list<- (.call protocol .unap (.@ result target)))) '(40 41 90))
        (check-eq? (.call protocol .ref (.@ result target) 40) f)
        (def undo (.call protocol .apply-delta (.@ result target) (invert-table-delta (.@ result delta))))
        (check-equal? (map car (.call target .list<- (.call protocol .unap undo))) '(10 11 90))))
    (test-case "projection eviction retains false keys false values and inverse absence semantics"
      (def source (recycling-projection-source (alist-table Bool Bool)))
      (def target (alist-table Bool Bool))
      (def projection (table-projection source target (lambda (key value) (some (cons key value)))))
      (def root (.call source .<-list '((#f . #f) (#t . #t))))
      (def state (.call projection .ap root))
      (def delta (.call source .delta/opt #f (lambda (_) #f) root))
      (defvalues (next output) (.call projection .apply-delta state delta values))
      (check-equal? (.call target .ref/opt (.call projection .get next) #f) #f)
      (check-equal? (.call target .ref/opt (.call projection .get next) #t) (some #t))
      (def restored (.call target .apply-delta (.call projection .get next) (invert-table-delta output)))
      (check-equal? (.call target .ref/opt restored #f) (some #f)))
    (test-case "late projection callback refusal preserves its cause and allows a fresh revision attempt"
      (def source (recycling-projection-source (.cc (RationalDict Integer) Key: Integer)))
      (def target (.cc (RationalDict Integer) Key: Integer)) (def fail? #f) (def calls 0)
      (def cause (list 'original-projection-refusal))
      (def projection (table-projection source target (lambda (_ value)
        (set! calls (+ calls 1)) (when fail? (raise cause)) (some (cons value value)))))
      (def root (.call source .<-list '((1 . 10) (9 . 90)))) (def state (.call projection .ap root))
      (def delta (.call source .delta/opt 1 (lambda (_) (some 20)) root))
      (set! calls 0) (set! fail? #t)
      (check-eq? (with-catch identity (lambda () (.call projection .apply-delta state delta))) cause)
      (check-equal? calls 1)
      (check-equal? (.call target .list<- (.call projection .get state)) '((10 . 10) (90 . 90)))
      (set! fail? #f) (set! calls 0)
      (def next (.call projection .apply-delta state delta))
      (check-equal? calls 1)
      (check-equal? (.call target .list<- (.call projection .get next)) '((20 . 20) (90 . 90))))
