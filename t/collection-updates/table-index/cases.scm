;;; Whole correlated snapshots, final uniqueness and consuming ownership workflows.



;; Keep protocol refusal distinct from a different callback implementation error.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; Admit shared callbacks once before differences are captured or styles converted.
(def (fixture)
  (defvalues (indexed source declarations) (service.make-indexed-services))
  (def f (validate (Fun Integer <- Integer) (lambda (n) (+ n 1))))
  (def base (.call source .<-list (list (cons 1 (vector 101 1001 10 f))
    (cons 2 (vector 102 1002 10 f)) (cons 9 (vector 109 1009 90 f)))))
  (values indexed source declarations base f))

;; Compare all observable primary/bucket contents, not tree shapes or allocation.
(def (observations indexed source state)
  (list (.call indexed .list<- state)
    (map (lambda (key) (.call indexed .index-ref/opt state 'badge key)) '(101 102 103 109))
    (map (lambda (key) (.call indexed .index-ref/opt state 'endpoint key)) '(1001 1002 1003 1009))
    (map (lambda (key) (map/option (cut .call source .list<- <>)
      (.call indexed .index-ref/opt state 'team key))) '(10 20 30 90))))

;; Simultaneous identifier swaps, shared-team migration and undo use one protocol.
(def table-index-test
  (test-suite "declarative correlated table indexes"
    (test-case "multimembership capacity folds retain Functions and publish exact deltas in every style"
      (def signature (Fun Integer <- Integer)) (def calls 0) (def warm? #f)
      (def f (validate signature (lambda (n) (set! calls (+ calls 1)) (+ n 3))))
      (def g (validate signature (lambda (n) (set! calls (+ calls 1)) (+ n 4))))
      (def h (validate signature (lambda (n) (when warm? (error "unaffected cohort refolded")) (+ n 9))))
      (def source (SimpleTrie UInt (Tuple (List UInt) signature)))
      (def target (.cc (SimpleTrie UInt Integer) .diff: (lambda args (error "unexpected summary diff"))))
      (def view (service.make-service-membership-fold source target))
      (def root (.call source .<-list (list (cons 1 (vector '(10 10 20) f))
        (cons 2 (vector '(20) g)) (cons 9 (vector '(90) h)))))
      (def state (.call view .ap root))
      (check-equal? (.call target .list<- (.call view .get state)) '((10 . 3) (20 . 7) (90 . 9)))
      (def delta (.call source .delta/opt 1 (lambda (_) (some (vector '(20 30 30) f))) root))
      (set! warm? #t)
      (for (name '(Pure Mutable Linear Posh Classy))
        (set! calls 0)
        (def protocol (.ref (table-styles target) name)) (def effects 0)
        (def result ((service.publish-projected-ledger-action view delta protocol
          (lambda (_) (set! effects (+ effects 1))))
          (object<-alist (list (cons 'state state) (cons 'target (.call protocol .ap (.call view .get state)))))))
        (check-equal? calls 3)
        (check-equal? effects 1)
        (check-equal? (table-delta-count (.@ result delta)) 2)
        (check-equal? (.call target .list<- (.call protocol .unap (.@ result target))) '((20 . 7) (30 . 3) (90 . 9)))
        (def undo (.call protocol .apply-delta (.@ result target) (invert-table-delta (.@ result delta))))
        (check-equal? (.call target .list<- (.call protocol .unap undo)) '((10 . 3) (20 . 7) (90 . 9))))
      (check (eq? (vector-ref (.call source .ref (.call view .unap state) 1) 1) f) => #t))
    (test-case "multimembership aggregation matches a finite membership oracle across migration and undo"
      (for (backend (list (lambda (v) (SimpleTrie UInt v)) RationalDict))
        (def source (backend (Tuple (List UInt) Integer))) (def target (backend Integer))
        (def view (table-group-fold source target Integer
          (lambda (_key row) (vector-ref row 0)) (lambda (_key row) (vector-ref row 1)) multiple?: #t))
        (def root (.call source .<-list '((1 . #((10 10 20) 3)) (2 . #((20) -3)))))
        (def state (.call view .ap root))
        (check-equal? (.call target .ref/opt (.call view .get state) 20) (some 0))
        (for (round (in-range 12))
          (def next-root (.call source .acons 1
            (vector (list-ref '((20 30 30) () (10 30)) (modulo round 3)) round) root))
          (def delta (.call source .diff root next-root))
          (defvalues (next output) (.call view .apply-delta state delta values))
          (def expected (foldr (lambda (bucket acc)
            (def rows (filter (lambda (row) (member bucket (vector-ref (cdr row) 0))) (.call source .list<- next-root)))
            (if (null? rows) acc (cons (cons bucket
              (foldl (lambda (row total) (+ total (vector-ref (cdr row) 1))) 0 rows)) acc))) [] '(10 20 30)))
          (check-equal? (.call target .list<- (.call view .get next)) expected)
          (check-equal? (.call target .list<- (.call target .apply-delta (.call view .get state) output)) expected)
          (def undo (.call view .apply-delta next (invert-table-delta delta)))
          (check-equal? (.call target .list<- (.call view .get undo)) (.call target .list<- (.call view .get state)))
          (set! root next-root) (set! state next))))
