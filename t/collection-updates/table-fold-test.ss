;;; Complete fold-state admission composes with sparse updates and representations.
(export table-fold-test)
(import :std/test :std/iter (only-in :std/error Error? Error-message ContractViolation?)
        :clan/poo/object :clan/poo/mop :clan/poo/number :clan/poo/type :clan/poo/table :clan/poo/rationaldict :clan/poo/support/option
        (only-in :clan/poo/fun Wrapper.) (only-in :clan/poo/support/base number-comparer)
        (only-in :clan/poo/t/table-testing box-table borrowing-table alist-table) (prefix-in :clan/poo/examples/service-collection service.))

;; Refine a backend through its existing complete recognizer, never a new carrier.
(def (even-table table)
  (.cc table .element?: (lambda (root)
    (and (element? table root) (even? (.call table .count root))))))

;; Typed identity preserves the existing isomorphism preparation and child laws.
(def (identity-wrapper type)
  (.cc Wrapper. Domain: type Codomain: type .ap: identity .unap: identity))

;; Failure causes, including arbitrary callback payloads, retain exact identity.
(def (cause-of action) (try (action) #f (catch (cause) cause)))

 ;; Keep the base backend's ordinary atomic installer while exposing borrowed
;; read responses. Installer lookups therefore cannot accidentally repair a
;; previously overwritten expectation by reusing the very same response shell.
(def (borrowed-read-table base)
  (.cc (borrowing-table base) .apply-delta: (.@ base .apply-delta)))

 ;; Read-only value conversion can recycle a backend's borrowed Option. Neither
;; the queried root nor the old paired target changes. Observe may inject a
;; controlled refusal; every ordinary conversion still returns the same value.
(def (querying-fold-bridge (observe void))
  (def source (RationalDict Integer))
  (def target (borrowed-read-table source))
  (def other (.call source .singleton 9 999))
  (def payloads (.cc Wrapper. Domain: Integer Codomain: Integer .unap: identity
    .ap: (lambda (value)
      (when (>= value 20) (.call target .ref/opt other 9))
      (observe value) value)))
  (def folding (table-fold source Integer (lambda (_ value) value)))
  (values source target folding (.call folding .isomorphism target
    (identity-wrapper (.@ source Key)) payloads)))

;; Exercise final-state acceptance through actual public fold and FUN operations.
(def table-fold-test
  (test-suite "complete incremental fold admission"
    (test-case "represented installation snapshots source expectations before replacement queries"
      (def raw (RationalDict Integer)) (def source (borrowed-read-table raw))
      (def other (.call raw .singleton 9 999))
      (def payloads (.cc Wrapper. Domain: Integer Codomain: Integer .ap: identity
        .unap: (lambda (value) (when (>= value 20) (.call source .ref/opt other 9)) value)))
      (defvalues (view _carrier _keys) (box-table source value: payloads))
      (def original (.call raw .singleton 1 10)) (def root (.call view .wrap original))
      (def before (.call raw .singleton -1 10)) (def after (.call raw .singleton -1 20))
      (def delta (.call raw .diff before after))
      (def next (.call view .apply-delta root delta))
      (check-equal? (.call view .ref next -1) 20)
      (check-equal? (.call raw .ref original 1) 10)
      (def restored (.call view .apply-delta next (invert-table-delta delta)))
      (check-equal? (.call view .ref restored -1) 10))
    (test-case "five represented styles preserve stale refusal priority and allow queried retry and inverse"
      (def raw (RationalDict Integer)) (def source (borrowed-read-table raw))
      (def other (.call raw .singleton 9 999)) (def calls 0)
      (def payloads (.cc Wrapper. Domain: Integer Codomain: Integer .ap: identity
        .unap: (lambda (value) (when (= value 20)
          (set! calls (+ calls 1)) (.call source .ref/opt other 9)) value)))
      (defvalues (view _carrier _keys) (box-table source value: payloads))
      (def root (.call view .wrap (.call raw .singleton 1 10)))
      (def after (.call raw .singleton -1 20))
      (def delta (.call raw .diff (.call raw .singleton -1 10) after))
      (def stale (.call raw .diff (.call raw .singleton -1 99) after))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles view) name)) (def owner (.call protocol .ap root))
        (set! calls 0)
        (def cause (cause-of (lambda () (.call protocol .apply-delta owner stale))))
        (check-equal? (and (table-conflict? cause) #t) #t)
        (check-equal? (table-conflict-key cause) -1) (check-equal? calls 0)
        (check-eq? (.call protocol .unap owner) root)
        (def next (.call protocol .apply-delta owner delta))
        (check-equal? (.call protocol .ref next -1) 20)
        (def restored (.call protocol .apply-delta next (invert-table-delta delta)))
        (check-equal? (.call protocol .ref restored -1) 10)))
    (test-case "sparse fold transfer preserves old target values across read-only conversion queries"
      (defvalues (source target folding bridge) (querying-fold-bridge))
      (def derived (.@ bridge Codomain))
      (def root (.call source .<-list '((1 . 10) (9 . 90))))
      (def state (.call folding .ap root)) (def first (.call bridge .ap state))
      (def delta (.call source .delta/opt 1 (lambda (_) (some 20)) root))
      (def next (.call bridge .apply-delta state delta))
      (check-equal? (.call derived .get next) 110)
      (check-equal? (.call target .ref (.call derived .unap next) 1) 20)
      (check-equal? (.call derived .get first) 100)
      (def recovered (.call bridge .unap next))
      (check-equal? (.call folding .get recovered) 110)
      (def restored (.call bridge .apply-delta recovered (invert-table-delta delta)))
      (check-equal? (.call derived .get restored) 100)
      (check-equal? (.call target .list<- (.call derived .unap restored)) (.call source .list<- root)))
    (test-case "queried fold batches preserve every repeated and cancelling expectation"
      (defvalues (source target folding bridge) (querying-fold-bridge))
      (def derived (.@ bridge Codomain))
      (def root (.call source .singleton 1 10))
      (def middle (.call source .singleton 1 20)) (def final (.call source .singleton 1 30))
      (def batch (.call source .compose-deltas (list (.call source .diff root middle) (.call source .diff middle final))))
      (def state (.call folding .ap root)) (.call bridge .ap state)
      (def next (.call bridge .apply-delta state batch))
      (check-equal? (.call derived .get next) 30)
      (check-equal? (.call target .ref (.call derived .unap next) 1) 30)
      (def restored (.call bridge .apply-delta (.call bridge .unap next) (invert-table-delta batch)))
      (check-equal? (.call derived .get restored) 10)
      (def cancel (.call source .compose-deltas (list (.call source .diff root middle) (.call source .diff middle root))))
      (def unchanged (.call bridge .apply-delta state cancel))
      (check-equal? (.call derived .get unchanged) 10))
    (test-case "failed queried capacity conversion retains paired Functions and FUN IO retries without refolding"
      (def signature (Fun Integer <- Integer)) (def f (validate signature (lambda (n) (+ n 3))))
      (def target #f) (def other #f) (def fail? #f) (def effects 0)
      (def cause (list 'original-capacity-conversion-refusal))
      (def ledger (service.make-capacity-ledger
        (list (cons 1 (vector f 10)) (cons 2 (vector f 40)))
        target: (lambda (type) (set! target (borrowed-read-table type)) target)
        value: (lambda (mapping) (.cc mapping .ap: (lambda (row)
          (when (= (vector-ref row 1) 20)
            (.call target .ref/opt other 9) (when fail? (raise cause)))
          (.call mapping .ap row))))))
      (set! other (.call target .singleton 9 (cons 999 f)))
      (def source (.@ ledger source)) (def folding (.@ ledger folding))
      (def bridge (.@ ledger transport)) (def state (.@ ledger state)) (def derived (.@ bridge Codomain))
      (def first (.call bridge .ap state))
      (def root (.call folding .unap state))
      (def delta (.call source .delta/opt 1 (lambda (_) (some (vector f 20))) root))
      (def action (service.fold-ledger-action bridge state
        (lambda (next) (set! effects (+ effects 1)) next)))
      (set! fail? #t)
      (check-eq? (cause-of (lambda () (action delta))) cause)
      (check-equal? effects 0) (check-eq? (.call bridge .ap state) first)
      (check-eq? (.call bridge .unap first) state)
      (set! fail? #f)
      (def next (action delta))
      (check-equal? effects 1) (check-equal? (.call derived .get next) 60)
      (check-eq? (cdr (.call target .ref (.call derived .unap next) 0)) f)
      (check-exception ((cdr (.call target .ref (.call derived .unap next) 0)) "bad") TypeError?)
      (def restored (.call bridge .apply-delta (.call bridge .unap next) (invert-table-delta delta)))
      (check-equal? (.call derived .get restored) 50))
    (test-case "represented queried replacements preserve present false values and false keys"
      (def raw (alist-table Bool Bool)) (def source (borrowed-read-table raw))
      (def other (.call raw .singleton #t #f))
      (def payloads (.cc Wrapper. Domain: Bool Codomain: Bool .ap: identity
        .unap: (lambda (value) (unless value (.call source .ref/opt other #t)) value)))
      (defvalues (view _carrier _keys) (box-table source key: (identity-wrapper Bool) value: payloads))
      (def original (.call raw .singleton #f #t)) (def root (.call view .wrap original))
      (def delta (.call raw .diff original (.call raw .singleton #f #f)))
      (def next (.call view .apply-delta root delta))
      (check-equal? (.call view .ref/opt next #f) (some #f))
      (def restored (.call view .apply-delta next (invert-table-delta delta)))
      (check-equal? (.call view .ref/opt restored #f) (some #t)))
    (test-case "compatible raw deltas cannot bypass a refined source before projection"
      (def raw (RationalDict Integer)) (def source (even-table raw)) (def calls 0)
      (def folding (table-fold source Integer (lambda (_ value) (set! calls (+ calls 1)) value)))
      (def base (.call raw .<-list '((1 . 10) (2 . 20))))
      (def state (.call folding .ap base))
      (def after (.call raw .remove base 1))
      (def delta (.call raw .diff base after))
      (set! calls 0)
      (check-exception (.call folding .apply-delta state delta) TypeError?)
      (check-equal? calls 0)
      (check (eq? (.call folding .unap state) base) => #t)
      (check-equal? (.call folding .get state) 30)
      ;; An empty request remains a real admission boundary on the captured root.
      (check-equal? (.call folding .get
        (.call folding .apply-delta state (.call raw .diff base base))) 30)
      (check-equal? calls 0))
    (test-case "composed requests admit the final root without demanding valid intermediate roots"
      (def raw (RationalDict Integer)) (def source (even-table raw)) (def calls 0)
      (def folding (table-fold source Integer (lambda (_ value) (set! calls (+ calls 1)) value)))
      (def base (.call raw .<-list '((1 . 10) (2 . 20))))
      (def middle (.call raw .remove base 1))
      (def final (.call raw .acons 3 40 middle))
      (def batch (.call raw .compose-deltas
        (list (.call raw .diff base middle) (.call raw .diff middle final))))
      (def state (.call folding .ap base))
      (set! calls 0)
      (def changed (.call folding .apply-delta state batch))
      (check-equal? calls 2)
      (check (element? source (.call folding .unap changed)) => #t)
      (check-equal? (.call folding .get changed) 60)
      (check-equal? (.call folding .get
        (.call folding .apply-delta changed (invert-table-delta batch))) 30)
      (check-equal? calls 4))
    (test-case "cold and warm target refusal retain the previous pair and support batch retry and undo"
      (def raw (RationalDict Integer)) (def target (even-table raw))
      (def folding (table-fold raw Integer (lambda (_ value) value)))
      (def bridge (.call folding .isomorphism target
        (identity-wrapper (.@ raw Key)) (identity-wrapper Integer)))
      (def derived (.@ bridge Codomain))
      (def base (.call raw .<-list '((1 . 10) (2 . 20))))
      (def state (.call folding .ap base)) (def first (.call bridge .ap state))
      (def middle (.call raw .remove base 1))
      (check-exception (.call bridge .ap (.call folding .ap middle)) TypeError?)
      (check (eq? (.call bridge .ap state) first) => #t)
      (check-exception (.call bridge .apply-delta state (.call raw .diff base middle)) TypeError?)
      (check (eq? (.call bridge .ap state) first) => #t)
      (check (eq? (.call bridge .unap first) state) => #t)
      (def final (.call raw .acons 3 40 middle))
      (def batch (.call raw .compose-deltas
        (list (.call raw .diff base middle) (.call raw .diff middle final))))
      (def changed (.call bridge .apply-delta state batch))
      (check-equal? (.call derived .get changed) 60)
      (check (element? target (.call derived .unap changed)) => #t)
      (def restored (.call bridge .apply-delta (.call bridge .unap changed) (invert-table-delta batch)))
      (check-equal? (.call derived .get restored) 30)
      (check-equal? (.call raw .list<- (.call derived .unap restored)) (.call raw .list<- base)))
    (test-case "source recognizer causes and mutation protection precede aggregate and IO callbacks"
      (def raw (RationalDict Integer)) (def failure (list 'root-refused))
      (def refuse? #f) (def mutate? #f) (def calls 0) (def consumed 0) (def source #f)
      (set! source (.cc raw .element?: (lambda (root)
        (when refuse? (raise failure))
        (when mutate? (.set! source sexp 'interference))
        (element? raw root))))
      (def folding (table-fold source Integer (lambda (_ value) (set! calls (+ calls 1)) value)))
      (def base (.call raw .singleton 1 10)) (def state (.call folding .ap base))
      (def delta (.call raw .diff base (.call raw .acons 1 20 base)))
      (def action (service.fold-ledger-action folding state (lambda (value)
        (set! consumed (+ consumed 1)) value)))
      (set! calls 0) (set! refuse? #t)
      (check (eq? (cause-of (cut action delta)) failure) => #t)
      (check-equal? calls 0) (check-equal? consumed 0)
      (set! refuse? #f) (set! mutate? #t)
      (check-exception (action delta) (lambda (cause)
        (and (Error? cause) (equal? (Error-message cause) "object mutation during computation"))))
      (check-equal? calls 0) (check-equal? consumed 0)
      (set! mutate? #f)
      (check-equal? (.call folding .get (action delta)) 20)
      (check-equal? consumed 1))
    (test-case "service refinements preserve checked Functions through refused publication retry and inverse"
      (def input-callback (lambda (value) (+ value 1)))
      (def ledger (service.make-capacity-ledger
        (list (cons 0 (vector input-callback 10)) (cons 1 (vector input-callback 20)))
        source: even-table
        target: (lambda (table) (.cc table .element?: (lambda (root)
          (and (element? table root)
            (<= (.call table .foldl (lambda (_ row sum) (+ sum (car row))) 0 root) 50)))))))
      (def source (.@ ledger source)) (def folding (.@ ledger folding))
      (def bridge (.@ ledger transport)) (def derived (.@ bridge Codomain))
      (def state (.@ ledger state)) (def base (.call folding .unap state))
      ;; Requests reuse the leaf admitted by this ledger's exact Function Type.
      (def callback (vector-ref (.call source .ref base 0) 0))
      (def first (.call bridge .ap state)) (def consumed 0)
      (def action (service.fold-ledger-action bridge state (lambda (next)
        (set! consumed (+ consumed 1)) next)))
      (def bad (.call source .diff base (.call source .acons 0 (vector callback 45) base)))
      (check-exception (action bad) TypeError?) (check-equal? consumed 0)
      (check (eq? (.call bridge .ap state) first) => #t)
      (def final (.call source .acons 1 (vector callback 25)
        (.call source .acons 0 (vector callback 15) base)))
      (def retry (.call source .diff base final))
      (def changed (action retry))
      (check-equal? consumed 1) (check-equal? (.call derived .get changed) 40)
      (def row (.call (.@ ledger target) .ref (.call derived .unap changed) 1))
      (check (eq? (cdr row) callback) => #t) (check-equal? ((cdr row) 7) 8)
      (check-exception ((cdr row) "wrong") TypeError?)
      (def restored ((service.fold-ledger-action bridge (.call bridge .unap changed)
        (lambda (next) (set! consumed (+ consumed 1)) next)) (invert-table-delta retry)))
      (check-equal? consumed 2) (check-equal? (.call derived .get restored) 30)
      (check (eq? (cdr (.call (.@ ledger target) .ref (.call derived .unap restored) 1)) callback) => #t))
    (test-case "closed indexed constructors and typed key registries admit a complete primary once"
      (def source (.cc (RationalDict Integer) Key: UInt))
      (def primary (even-table source)) (def projects 0)
      (def indexed (table-indexes primary (list
        (.cc Type. name: 'value table: (RationalDict UInt) unique?: #t
          project: (lambda (_ value) (set! projects (+ projects 1)) value)))))
      (def registry (.call indexed .key-table UInt))
      (def owned (.call registry .acons 7 9 (.@ registry .empty)))
      (check (element? registry owned) => #t)
      (check-equal? (.call registry .ref owned 7) 9)
      (check-equal? projects 0)
      ;; Kind and descriptor refusal still precede malformed-root admission.
      (def ordered (table-order indexed (table-comparer UInt number-comparer)))
      (check-exception (.call ordered .apply-delta 'invalid #f) (lambda (cause)
        (and (Error? cause) (equal? (Error-message cause) "table delta required"))))
      (def other (.cc (RationalDict Bool) Key: UInt))
      (def incompatible (.call other .diff (.@ other .empty) (.@ other .empty)))
      (check-exception (.call ordered .apply-delta 'invalid incompatible) (lambda (cause)
        (and (Error? cause) (equal? (Error-message cause) "stale or incompatible table delta"))))
      (def folding (table-fold source Integer (lambda (_ value) value)))
      (def bridge (.call folding .isomorphism indexed (identity-wrapper UInt) (identity-wrapper Integer)))
      (def base (.call source .<-list '((1 . 10) (2 . 20))))
      (def state (.call folding .ap base))
      (def converted (.call bridge .ap state))
      (check-equal? projects 2)
      (check-equal? (.call (.@ bridge Codomain) .get converted) 30)
      (def after (.call source .<-list '((1 . 20) (2 . 10))))
      (def changed (.call bridge .apply-delta state (.call source .diff base after)))
      (check-equal? (.call indexed .list<- (.call (.@ bridge Codomain) .unap changed)) '((1 . 20) (2 . 10))))
    (test-case "fold transport delegates a whole unique swap to the existing target installer"
      (def source (RationalDict Integer))
      (def raw (table-indexes source (list
        (.cc Type. name: 'value table: (RationalDict (.@ source Key)) unique?: #t
          project: (lambda (_ value) value)))))
      (def installs 0)
      (def target (.cc raw .acons: (lambda _ (error "target point insertion"))
        .remove: (lambda _ (error "target point removal"))
        .apply-delta: (lambda (root delta) (set! installs (+ installs 1)) (.call raw .apply-delta root delta))))
      (def folding (table-fold source Integer (lambda (_ value) value)))
      (def bridge (.call folding .isomorphism target
        (identity-wrapper (.@ source Key)) (identity-wrapper Integer)))
      (def derived (.@ bridge Codomain))
      (def base (.call source .<-list '((1 . 10) (2 . 20))))
      (def state (.call folding .ap base)) (def first (.call bridge .ap state))
      (def final (.call source .<-list '((1 . 20) (2 . 10))))
      (def delta (.call source .diff base final))
      (def changed (.call bridge .apply-delta state delta))
      (check-equal? installs 1)
      (check-equal? (.call derived .get changed) 30)
      (check-equal? (.call raw .index-ref/opt (.call derived .unap changed) 'value 10) (some 2))
      (def restored (.call bridge .apply-delta (.call bridge .unap changed) (invert-table-delta delta)))
      (check-equal? installs 2)
      (check-equal? (.call raw .list<- (.call derived .unap restored)) (.call source .list<- base))
      (check-equal? (.call raw .list<- (.call derived .unap first)) (.call source .list<- base)))
    (test-case "the ordered overlay distinguishes untouched deleted and stored false across repeated edits"
      (def source (.cc (RationalDict Bool) Key: UInt))
      (def target (table-indexes source (list
        (.cc Type. name: 'identity table: (RationalDict UInt) unique?: #t project: (lambda (key _) key)))))
      (def folding (table-fold source Integer (lambda (_ value) (if value 1 0))))
      (def bridge (.call folding .isomorphism target (identity-wrapper UInt) (identity-wrapper Bool)))
      (def derived (.@ bridge Codomain))
      (def base (.call source .<-list '((0 . #f) (1 . #t))))
      (def absent (.call source .remove base 0))
      (def present (.call source .acons 0 #t absent))
      (def final (.call source .acons 0 #f (.call source .acons 1 #f present)))
      (def batch (.call source .compose-deltas (list (.call source .diff base absent)
        (.call source .diff absent present) (.call source .diff present final))))
      (def state (.call folding .ap base))
      (def changed (.call bridge .apply-delta state batch))
      (check-equal? (.call derived .get changed) 0)
      (check-equal? (.call target .list<- (.call derived .unap changed)) '((0 . #f) (1 . #f)))
      (def restored (.call bridge .apply-delta (.call bridge .unap changed) (invert-table-delta batch)))
      (check-equal? (.call derived .get restored) 1)
      (check-equal? (.call target .list<- (.call derived .unap restored)) (.call source .list<- base)))
    (test-case "collisions and late conversion causes refuse before any target install and retain the pair"
      (def source (.cc (RationalDict Integer) Key: UInt))
      (def raw (table-indexes source (list
        (.cc Type. name: 'value table: (RationalDict UInt) unique?: #t project: (lambda (_ value) value)))))
      (def installs 0) (def conversions 0) (def fail? #f) (def failure (list 'conversion-refused))
      (def target (.cc raw .apply-delta: (lambda (root delta)
        (set! installs (+ installs 1)) (.call raw .apply-delta root delta))))
      (def keys (.cc Wrapper. Domain: UInt Codomain: UInt .ap: (lambda (key) (if (= key 2) 0 key)) .unap: identity))
      (def payloads (.cc Wrapper. Domain: Integer Codomain: Integer
        .ap: (lambda (value) (set! conversions (+ conversions 1))
          (when (and fail? (= value 40)) (raise failure)) value) .unap: identity))
      (def folding (table-fold source Integer (lambda (_ value) value)))
      (def bridge (.call folding .isomorphism target keys payloads))
      (def base (.call source .singleton 0 10))
      (def state (.call folding .ap base)) (def first (.call bridge .ap state))
      (set! conversions 0)
      (def collision (.call source .diff base (.call source .acons 2 30 base)))
      (def refused (cause-of (cut .call bridge .apply-delta state collision)))
      (check (table-isomorphism-failure? refused) => #t)
      (check-equal? (table-isomorphism-failure-kind refused) 'collision)
      (check-equal? conversions 0) (check-equal? installs 0)
      (check (eq? (.call bridge .ap state) first) => #t)
      (def final (.call source .acons 4 40 (.call source .acons 3 30 base)))
      (def delta (.call source .diff base final))
      (set! fail? #t)
      (check (eq? (cause-of (cut .call bridge .apply-delta state delta)) failure) => #t)
      (check-equal? installs 0)
      (check (eq? (.call bridge .ap state) first) => #t)
      (set! fail? #f)
      (check-equal? (.call (.@ bridge Codomain) .get (.call bridge .apply-delta state delta)) 80)
      (check-equal? installs 1))
    (test-case "ordered represented service ledgers publish dual identifier swaps and team migration through FUN"
      (def ledger (service.make-service-ledger
        (list (cons 1 (vector 101 1001 10 (lambda (n) (+ n 1))))
              (cons 2 (vector 102 1002 10 (lambda (n) (+ n 2))))
              (cons 9 (vector 109 1009 90 (lambda (n) (+ n 9)))))
        (lambda (indexed)
          (def ordered (table-order indexed (table-comparer (.@ indexed Key) number-comparer)))
          (defvalues (view _carrier _keys) (box-table ordered)) view)))
      (def source (.@ ledger source)) (def target (.@ ledger target)) (def indexed (.@ ledger indexed))
      (def folding (.@ ledger folding)) (def bridge (.@ ledger transport)) (def derived (.@ bridge Codomain))
      (def state (.@ ledger state)) (def base (.call folding .unap state))
      (def first (.call bridge .ap state))
      (def f1 (vector-ref (.call source .ref base 1) 3))
      (def f2 (vector-ref (.call source .ref base 2) 3))
      (def consumed 0)
      (def action (service.fold-ledger-action bridge state (lambda (next) (set! consumed (+ consumed 1)) next)))
      (def invalid (.call source .acons 1 (vector 102 1001 20 f1) base))
      (check-exception (action (.call source .diff base invalid)) table-index-conflict?)
      (check-equal? consumed 0) (check (eq? (.call bridge .ap state) first) => #t)
      (def final (.call source .acons 2 (vector 101 1001 20 f2)
        (.call source .acons 1 (vector 102 1002 20 f1) base)))
      (def delta (.call source .diff base final))
      (def changed (action delta)) (def root (.call derived .unap changed))
      (def primary (.call target .unwrap root))
      (check-equal? consumed 1) (check-equal? (.call derived .get changed) 3)
      (check-equal? (.call indexed .index-ref/opt primary 'badge 101) (some -2))
      (check-equal? (.call indexed .index-ref/opt primary 'endpoint 1002) (some -1))
      (check-equal? (.call indexed .index-ref/opt primary 'team 10) #f)
      (check-equal? (.call source .count (some-value (.call indexed .index-ref/opt primary 'team 20))) 2)
      (check (eq? (vector-ref (.call target .ref root 2) 3) f2) => #t)
      (check-equal? ((vector-ref (.call target .ref root 2) 3) 7) 9)
      (check-exception ((vector-ref (.call target .ref root 2) 3) "wrong") TypeError?)
      (def restored ((service.fold-ledger-action bridge (.call bridge .unap changed)
        (lambda (next) (set! consumed (+ consumed 1)) next)) (invert-table-delta delta)))
      (check-equal? consumed 2)
      (check-equal? (.call target .list<- (.call derived .unap restored))
        (.call target .list<- (.call derived .unap first)))
      (check (eq? (vector-ref (.call target .ref (.call derived .unap restored) 1) 3) f1) => #t))
    (test-case "transported deltas retain declaration invalidation through empty batches"
      (def source (.cc (RationalDict Integer) Key: UInt))
      (def recipe (.cc Type. name: 'value table: (RationalDict UInt) unique?: #t project: (lambda (_ v) v)))
      (def indexed (table-indexes source (list recipe)))
      (def folding (table-fold source Integer (lambda (_ value) value)))
      (def state (.call folding .ap (.call source .singleton 0 10)))
      (def bridge (.call folding .isomorphism indexed (identity-wrapper UInt) (identity-wrapper Integer)))
      (def first (.call bridge .ap state))
      (def base (.call folding .unap state)) (def empty (.call source .diff base base))
      (.set! recipe sexp 'changed)
      (check-exception (.call bridge .apply-delta state empty) (lambda (cause)
        (and (Error? cause) (equal? (Error-message cause) "stale table fold isomorphism"))))
      ;; Fresh target preparation retains the independent admitted source state.
      (def fresh (table-indexes source (list recipe)))
      (def retry (.call folding .isomorphism fresh (identity-wrapper UInt) (identity-wrapper Integer)))
      (check-equal? (.call (.@ retry Codomain) .get (.call retry .apply-delta state empty)) 10))
    (test-case "key-space capability typing and protected getters refuse before conversions"
      (def key-type (.cc UInt)) (def source (.cc (RationalDict Integer) Key: key-type))
      (def raw (table-indexes source (list
        (.cc Type. name: 'value table: (RationalDict key-type) unique?: #t project: (lambda (_ value) value)))))
      (def bad 'key) (def mutate? #f) (def conversions 0)
      (def target (.cc raw .key-table: (lambda (value)
        (when mutate? (.set! key-type sexp 'interference))
        (case bad
          ((key) (.cc source Key: Bool Value: value))
          ((value) (.cc source Value: Bool))
          (else (.call raw .key-table value))))))
      (def values (.cc Wrapper. Domain: Integer Codomain: Integer .unap: identity
        .ap: (lambda (value) (set! conversions (+ conversions 1)) value)))
      (def folding (table-fold source Integer (lambda (_ value) value)))
      (def state (.call folding .ap (.call source .singleton 1 10)))
      (def bridge (.call folding .isomorphism target (identity-wrapper key-type) values))
      (def missing (.cc raw .key-table: #f))
      (def unsupported (.call folding .isomorphism missing (identity-wrapper key-type) values))
      (check-exception (.call unsupported .ap state) (lambda (cause)
        (and (Error? cause) (equal? (Error-message cause) "unsupported table key registry"))))
      (for (kind '(key value))
        (set! bad kind)
        (check-exception (.call bridge .ap state) (lambda (cause)
          (and (Error? cause) (equal? (Error-message cause) "incompatible table key registry")))))
      (check-equal? conversions 0)
      (set! bad #f) (set! mutate? #t)
      (check-exception (.call bridge .ap state) (lambda (cause)
        (and (Error? cause) (equal? (Error-message cause) "object mutation during computation"))))
      (check-equal? conversions 0)
      (set! mutate? #f)
      (check-equal? (.call (.@ bridge Codomain) .get (.call bridge .ap state)) 10))
    (test-case "represented old-value refusal precedes replacement conversion and preserves its public key"
      (def source (RationalDict Integer)) (def failure (list 'replacement-refused)) (def calls 0)
      (def payloads (.cc Wrapper. Domain: Integer Codomain: Integer .ap: identity
        .unap: (lambda (value) (when (= value 20) (set! calls (+ calls 1)) (raise failure)) value)))
      (defvalues (table _carrier _keys) (box-table source value: payloads))
      (def base (.call table .wrap (.call source .singleton 1 10)))
      (def proposed (.call source .singleton -1 20))
      (def stale (.call source .diff (.call source .singleton -1 99) proposed))
      (def refused (cause-of (cut .call table .apply-delta base stale)))
      (check (table-conflict? refused) => #t)
      (check-equal? (table-conflict-key refused) -1) (check-equal? calls 0)
      (def matching (.call source .diff (.call source .singleton -1 10) proposed))
      (check (eq? (cause-of (cut .call table .apply-delta base matching)) failure) => #t)
      (check-equal? calls 1) (check-equal? (.call table .ref base -1) 10)
      (def repaired (.call source .diff (.call source .singleton -1 10) (.call source .singleton -1 30)))
      (check-equal? (.call table .ref (.call table .apply-delta base repaired) -1) 30))
    (test-case "ordinary folds declare policy origins and refuse every stale entry"
      (def source (RationalDict Integer)) (def policy (.o weight: 2)) (def calls 0)
      (def root (.call source .singleton 1 10))
      (def project (lambda (_ row) (set! calls (+ calls 1)) (* (.@ policy weight) row)))
      (def folding (table-fold source Integer project (list policy)))
      (check (and (memq policy (.@ folding .sources)) #t) => #t)
      (def state (.call folding .ap root))
      (check-equal? (.call folding .get state) 20)
      (.set! policy weight 3) (set! calls 0)
      (check-exception (.call folding .get state) Error?)
      (check-exception (.call folding .unap state) Error?)
      (check-exception (.call folding .ap root) Error?)
      (check-exception (.call folding .apply-delta state (.call source .diff root root)) Error?)
      (check-equal? calls 0)
      (def fresh (table-fold source Integer project (list policy)))
      (def retried (.call fresh .ap root))
      (check-equal? (.call fresh .get retried) 30)
      (check-eq? (.call fresh .unap retried) root))
    (test-case "fold origin capture precedes descriptor getters and caller buffer reuse"
      (def raw (RationalDict Integer))
      (def policy (.o epoch: 0)) (def replacement (.o epoch: 0))
      (def origins (list policy))
      (def source (.o (:: @ raw) (Value (begin (set-car! origins replacement) Integer))))
      (def folding (table-fold source Integer (lambda (_ row) row) origins))
      (check (and (memq policy (.@ folding .sources)) #t) => #t)
      (check-equal? (memq replacement (.@ folding .sources)) #f)
      (def state (.call folding .ap (.call raw .singleton 1 10)))
      (.set! policy epoch 1)
      (check-exception (.call folding .get state) Error?))
    (test-case "finite declarations and policy protection precede algebra getter preparation"
      (def source (RationalDict Integer)) (def policy (.o epoch: 0)) (def calls 0)
      (def aggregate (.o (:: @ Integer) (.zero (begin (set! calls (+ calls 1)) 0))))
      (check-exception (table-fold source aggregate (lambda (_ row) row) 'bad) ContractViolation?)
      (def cyclic (list policy)) (set-cdr! cyclic cyclic)
      (check-exception (table-fold source aggregate (lambda (_ row) row) cyclic) ContractViolation?)
      (check-equal? calls 0)
      (def guarded (.o (:: @ Integer) (.zero (begin (.set! policy epoch 1) 0))))
      (check-exception (table-fold source guarded (lambda (_ row) row) (list policy)) Error?)
      (check-equal? (.@ policy epoch) 0))
    (test-case "isomorphism Codomain retains policies for independently initialized target states"
      (def source (RationalDict Integer)) (def target (.cc source))
      (def policy (.o weight: 2)) (def calls 0)
      (def folding (table-fold source Integer
        (lambda (_ row) (set! calls (+ calls 1)) (* (.@ policy weight) row)) (list policy)))
      (def bridge (.call folding .isomorphism target (identity-wrapper Rational) (identity-wrapper Integer)))
      (def root (.call source .singleton 1 10))
      (def state (.call folding .ap root))
      (def converted (.call bridge .ap state))
      (def cooked (.@ bridge Codomain))
      (def independent (.call cooked .ap root))
      (check (and (memq policy (.@ cooked .sources)) (memq policy (.@ bridge .sources)) #t) => #t)
      (check-equal? (.call cooked .get independent) 20)
      (.set! policy weight 3) (set! calls 0)
      (check-exception (.call cooked .get converted) Error?)
      (check-exception (.call cooked .get independent) Error?)
      (check-exception (.call cooked .ap root) Error?)
      (check-exception (.call bridge .ap state) Error?)
      (check-exception (.call folding .isomorphism target (identity-wrapper Rational) (identity-wrapper Integer)) Error?)
      (.set! policy weight 2)
      (check-exception (.call cooked .get independent) Error?)
      (check-equal? calls 0))
    (test-case "converter invalidation preserves the independently declared source aggregate"
      (def source (RationalDict Integer)) (def policy (.o weight: 2)) (def calls 0)
      (def folding (table-fold source Integer
        (lambda (_ row) (set! calls (+ calls 1)) (* (.@ policy weight) row)) (list policy)))
      (def state (.call folding .ap (.call source .singleton 1 10)))
      (def keys (.cc (identity-wrapper Rational) epoch: 0))
      (def bridge (.call folding .isomorphism source keys (identity-wrapper Integer)))
      (.call bridge .ap state)
      (.set! keys epoch 1)
      (check-exception (.call bridge .ap state) Error?)
      (check-equal? (.call folding .get state) 20)
      (set! calls 0)
      (let (fresh (.call folding .isomorphism source keys (identity-wrapper Integer)))
        (check-equal? (.call (.@ fresh Codomain) .get (.call fresh .ap state)) 20)
        (check-equal? calls 0)))
    (test-case "no-op historical delta origins frame independent source and transported states"
      (def source (RationalDict Integer)) (def policy (.o weight: 2)) (def delta-policy (.o epoch: 0))
      (def folding (table-fold source Integer (lambda (_ row) (* (.@ policy weight) row)) (list policy)))
      (def root (.call source .singleton 1 10)) (def original (.call folding .ap root))
      (def declared (.cc source .sources: (list delta-policy)))
      (def extended (.call folding .apply-delta original (.call declared .diff root root)))
      (def bridge (.call folding .isomorphism source (identity-wrapper Rational) (identity-wrapper Integer)))
      (def first (.call bridge .ap original)) (def later (.call bridge .ap extended))
      (.set! delta-policy epoch 1)
      (check-equal? (.call folding .get original) 20)
      (check-exception (.call folding .get extended) Error?)
      (check-equal? (.call (.@ bridge Codomain) .get first) 20)
      (check-exception (.call (.@ bridge Codomain) .get later) Error?)
      (check-equal? (.call (.@ bridge Codomain) .get (.call bridge .ap original)) 20))
    (test-case "declared fold conflicts and callback failures suppress IO and retain retry and undo"
      (def source (RationalDict Integer)) (def policy (.o weight: 2))
      (def fail? #f) (def cause (list 'projection-refused)) (def effects 0) (def calls 0)
      (def folding (table-fold source Integer (lambda (_ row)
        (set! calls (+ calls 1)) (when fail? (raise cause)) (* (.@ policy weight) row)) (list policy)))
      (def root (.call source .singleton 1 10)) (def state (.call folding .ap root))
      (def after (.call source .singleton 1 20)) (def delta (.call source .diff root after))
      (def action (service.fold-ledger-action folding state (lambda (next) (set! effects (+ effects 1)) next)))
      (set! fail? #t) (set! calls 0)
      (check (table-conflict? (cause-of (cut action (.call source .diff (.call source .singleton 1 99) after)))) => #t)
      (check-equal? calls 0)
      (check-eq? (cause-of (cut action delta)) cause)
      (check-equal? effects 0) (check-equal? (.call folding .get state) 20)
      (set! fail? #f)
      (def next (action delta))
      (check-equal? (.call folding .get next) 40) (check-equal? effects 1)
      (def restored (.call folding .apply-delta next (invert-table-delta delta)))
      (check-equal? (.call folding .get restored) 20)
      (check-equal? (.call source .list<- (.call folding .unap restored)) (.call source .list<- root)))
    (test-case "policy-weighted service ledger transports checked callbacks and rebuilds after revision"
      (def policy (.o weight: 2)) (def callback (lambda (n) (+ n 1)))
      (def rows (list (cons 0 (vector callback 10)) (cons 2 (vector callback 20))))
      (def ledger (service.make-capacity-ledger rows policy: policy))
      (def source (.@ ledger source)) (def target (.@ ledger target))
      (def folding (.@ ledger folding)) (def bridge (.@ ledger transport)) (def state (.@ ledger state))
      (def root (.call folding .unap state)) (def stored (vector-ref (.call source .ref root 0) 0))
      (def target-state (.call bridge .ap state)) (def target-root (.call (.@ bridge Codomain) .unap target-state))
      (check-eq? (cdr (.call target .ref target-root 1)) stored)
      (check-equal? (.call (.@ bridge Codomain) .get target-state) 60)
      ;; Policy affects the score, not the independently typed represented data.
      (def styles (table-styles target))
      (def published (map (lambda (name)
        (def protocol (.ref styles name)) (cons protocol (.call protocol .ap target-root)))
        '(Pure Mutable Linear Posh Classy)))
      (.set! policy weight 3)
      (check-exception (.call folding .get state) Error?)
      (check-exception (.call (.@ bridge Codomain) .ap target-root) Error?)
      (for-each (lambda (entry)
        (check-equal? (.call (car entry) .count (cdr entry)) 2)
        (check-eq? (cdr (.call (car entry) .ref (cdr entry) 1)) stored)) published)
      (def fresh (service.make-capacity-ledger rows policy: policy))
      (def fsource (.@ fresh source)) (def ffold (.@ fresh folding)) (def fbridge (.@ fresh transport))
      (def fstate (.@ fresh state)) (def froot (.call ffold .unap fstate))
      (def fcallback (vector-ref (.call fsource .ref froot 0) 0))
      (def delta (.call fsource .delta/opt 0 (lambda (_) (some (vector fcallback 15))) froot))
      (def effects 0)
      (def next ((service.fold-ledger-action fbridge fstate (lambda (value) (set! effects (+ effects 1)) value)) delta))
      (check-equal? (.call (.@ fbridge Codomain) .get next) 105)
      (check-equal? effects 1)
      (check-eq? (cdr (.call (.@ fresh target) .ref (.call (.@ fbridge Codomain) .unap next) 1)) fcallback)
      (def restored (.call fbridge .apply-delta (.call fbridge .unap next) (invert-table-delta delta)))
      (check-equal? (.call (.@ fbridge Codomain) .get restored) 90)
      (check-equal? (fcallback 5) 6))

))
