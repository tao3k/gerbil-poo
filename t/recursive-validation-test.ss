;;; Finite cyclic graphs, productive computed links and bounded request controls.
(export recursive-validation-test)
(import :std/test ../object ../mop ../number ../object-contract
        (only-in ../type Record List)
        (prefix-in ../recursive-validation graph.)
        (prefix-in ../examples/recursive-validation service.)
        (prefix-in ../examples/object-contracts config.)
        (prefix-in ../examples/contract-publication publication.)
        (prefix-in ../recursive-handling handling.)
        (prefix-in ../recursive-cache cached.)
        (prefix-in ../declarative-metadata metadata.))

;; Decode data only; executable graph methods come from the existing constructors.
(def request "{\"host\":\"api\",\"port\":443,\"capacity\":10,\"used\":2,\"secure\":true}")

;; Application policy is preserved independently from exact subject/context binding.
(def Call (metadata.contract (metadata.predicate "object" object?)
  (metadata.predicate "evidence" object?) (lambda (_key _request _result) #t) metadata.truth))

;; Small cyclic source fixture; expose sources/descriptors only for revision tests.
(def (cyclic-build reference)
  (def left-type (Record value: [Integer] peer: [(reference 'right)]))
  (def right-type (Record value: [Integer] peer: [(reference 'left)]))
  (def left (.o value: 1 peer: right))
  (def right (.o value: 2 peer: left))
  (list (list 'left left-type left) (list 'right right-type right)))

;; Match only the expected phase, without erasing original cycle/source exceptions.
(def (phase? expected)
  (lambda (cause) (and (graph.validation-failure? cause)
                      (eq? expected (graph.validation-failure-kind cause)))))

;; Test complete closure rather than treating active references as validated nodes.
(def recursive-validation-test
  (test-suite "finite recursive graph validation"
    (test-case "canonical cycles preserve shared identity and source ancestry"
      (def sources #f)
      (def closed (graph.close-validation (lambda (reference)
        (set! sources (cyclic-build reference)) sources)))
      (def left (graph.closed-ref closed 'left)) (def right (graph.closed-ref closed 'right))
      (check (eq? (.get left peer) right) => #t)
      (check (eq? (.get right peer) left) => #t)
      (check (eq? (validate (graph.closed-type closed 'left) left) left) => #t)
      (check (eq? (validate (graph.closed-type closed 'left) (caddar sources)) left) => #t)
      (check (and (memq (caddar sources) (compute-precedence-list! left)) #t) => #t)
      (check-exception (validate (graph.closed-type closed 'left) right) (phase? 'reference))
      (check-exception (.put! left 'value 8) (lambda (_) #t)))
    (test-case "self reference and repeated List references share one node"
      (def closed (graph.close-validation (lambda (reference)
        (def descriptor (Record children: [(List (reference 'root))]))
        (def source (.o children: (list source source)))
        (list (list 'root descriptor source)))))
      (def root (graph.closed-ref closed 'root))
      (check (eq? (car (.get root children)) root) => #t)
      (check (eq? (cadr (.get root children)) root) => #t))
    (test-case "every target shape gates all normalizers, including unused nodes"
      (def visits 0)
      (def counted (.cc Integer .validate: (lambda (value) (set! visits (+ visits 1)) value)))
      (check-exception (graph.close-validation (lambda (_reference)
        (list (list 'root (Record value: [counted]) (.o value: 1))
              (list 'hidden (Record value: [Integer]) (.o value: #f))))) (phase? 'shape))
      (check-equal? visits 0))
    (test-case "catalog limit duplicates missing references and unsupported Types refuse"
      (check-exception (graph.close-validation cyclic-build 1) (phase? 'catalog))
      (check-exception (graph.close-validation (lambda (_)
        (list (list 'x (Record) (.o)) (list 'x (Record) (.o))))) (phase? 'duplicate))
      (check-exception (graph.close-validation (lambda (reference)
        (list (list 'x (Record peer: [(reference 'missing)]) (.o peer: #f))))) (phase? 'missing-reference))
      (check-exception (graph.close-validation (lambda (_)
        (list (list 'x Any (.o))))) (phase? 'protocol)))
    (test-case "custom Slot cannot leave a raw recursive target in the final graph"
      (define-type (RawSlot @ Slot)
        .slot.validate: (lambda (_ _name original _receiver) original))
      (check-exception (graph.close-validation (lambda (reference)
        (def left-type (.cc Class. slots: (.o peer: (.new RawSlot type: (reference 'right)))))
        (def right-type (Record peer: [(reference 'left)]))
        (def left (.o peer: right)) (def right (.o peer: left))
        (list (list 'left left-type left) (list 'right right-type right)))) (phase? 'admission)))
    (test-case "distinct graph owners cannot mix canonical references"
      (def first (graph.close-validation cyclic-build))
      (def second (graph.close-validation cyclic-build))
      (check-exception (validate (graph.closed-type first 'left) (graph.closed-ref second 'left))
                       (phase? 'reference)))
    (test-case "reusing foreign reference descriptors cannot close a new owner graph"
      (def entries #f)
      (graph.close-validation (lambda (reference) (set! entries (cyclic-build reference)) entries))
      (check-exception (graph.close-validation (lambda (_reference) entries)) (phase? 'owner)))
    (test-case "source and descriptor edits invalidate graph access and reference validation"
      (def sources #f)
      (def closed (graph.close-validation (lambda (reference)
        (set! sources (cyclic-build reference)) sources)))
      (def type (graph.closed-type closed 'left)) (def left (graph.closed-ref closed 'left))
      (.put! (caddar sources) 'value 8)
      (check-exception (graph.closed-ref closed 'left) (phase? 'stale))
      (check-exception (validate type left) (phase? 'stale))
      (def declarations #f)
      (def another (graph.close-validation (lambda (reference)
        (set! declarations (cyclic-build reference)) declarations)))
      (.put! (cadar declarations) 'sealed #t)
      (check-exception (graph.closed-ref another 'right) (phase? 'stale)))
    (test-case "whole graph refinement runs after all nodes normalize"
      (def refined #f)
      (def closed (graph.close-validation (lambda (reference)
        (def right-type (Record function: [(Fun Integer <- Integer)] peer: [(reference 'left)]))
        (def raw values)
        (def left-type (refine (.cc ObjectContract. responsibilities: (.o peer: (reference 'right)))
          (lambda (candidate location)
            (set! refined #t)
            (if (eq? (.get candidate peer function) raw) [(.o kind: 'raw path: location)] '()))))
        (def left (.o peer: right)) (def right (.o function: raw peer: left))
        (list (list 'left left-type left) (list 'right right-type right)))))
      (check-equal? refined #t)
      (check-exception ((.get (graph.closed-ref closed 'left) peer function) #f) TypeError?))
    (test-case "nested schema obligations wait for all graph node normalization"
      (def ready #f)
      (def counted (.cc Integer .validate: (lambda (value) (set! ready #t) value)))
      (def closed (graph.close-validation (lambda (reference)
        (def nested (refine (.cc ObjectContract. responsibilities: (.o peer: (reference 'right)))
          (lambda (_ location)
            (if ready '() [(.o kind: 'too-early path: location)]))))
        (def left-type (Record nested: [nested]))
        (def right-type (Record marker: [counted] peer: [(reference 'left)]))
        (def left (.o nested: (.o peer: right)))
        (def right (.o marker: 1 peer: left))
        (list (list 'left left-type left) (list 'right right-type right)))))
      (check-equal? ready #t)
      (check (eq? (.get (graph.closed-ref closed 'left) nested peer peer)
                  (graph.closed-ref closed 'left)) => #t))
    (test-case "failed node batch discards deferred obligations and scope unwinds"
      (def observed 0)
      (def cause (list 'original-normalizer))
      (def broken (.cc Integer .validate: (lambda (_) (raise cause))))
      (check-exception (graph.close-validation (lambda (reference)
        (def nested (refine (.cc ObjectContract. responsibilities: (.o peer: (reference 'right)))
          (lambda (_ _location) (set! observed (+ observed 1)) '())))
        (def left-type (Record nested: [nested]))
        (def right-type (Record marker: [broken] peer: [(reference 'left)]))
        (def left (.o nested: (.o peer: right))) (def right (.o marker: 1 peer: left))
        (list (list 'left left-type left) (list 'right right-type right)))) (lambda (caught) (eq? caught cause)))
      (check-equal? observed 0)
      (check (graph.closed? (graph.close-validation cyclic-build)) => #t)
      (def ordinary (refine (.cc ObjectContract. responsibilities: (.o n: Integer))
        (lambda (_ location) [(.o kind: 'ordinary-refusal path: location)])))
      (check-exception (validate ordinary (.o n: 1)) TypeError?))
    (test-case "shared target normalizer runs once despite repeated reference edges"
      (def visits 0)
      (def counted (.cc Integer .validate: (lambda (value) (set! visits (+ visits 1)) value)))
      (def closed (graph.close-validation (lambda (reference)
        (def root-type (Record children: [(List (reference 'shared))]))
        (def shared-type (Record n: [counted]))
        (def shared (.o n: 1))
        (list (list 'root root-type (.o children: (list shared shared shared)))
              (list 'shared shared-type shared)))))
      (check-equal? visits 1)
      (def root (graph.closed-ref closed 'root))
      (check (andmap (lambda (child) (eq? child (graph.closed-ref closed 'shared))) (.get root children)) => #t))
    (test-case "a failing remote refinement cannot publish a graph and retry is fresh"
      (check-exception (graph.close-validation (lambda (reference)
        (def entries (cyclic-build reference))
        (def rejected (refine (.cc ObjectContract. responsibilities: (.o value: Integer peer: (reference 'left)))
          (lambda (_ location) [(.o kind: 'remote-refusal path: location)])))
        (list (car entries) (list 'right rejected (caddr (cadr entries)))))) (phase? 'admission))
      (check (graph.closed? (graph.close-validation cyclic-build)) => #t))
    (test-case "unannotated structural object recursion refuses before normalization"
      (check-exception (graph.close-validation (lambda (_reference)
        (def descriptor (.cc ObjectContract. responsibilities: (.o next: descriptor)))
        (def source (.o next: source))
        (list (list 'root descriptor source))))
        (lambda (cause) (and ((phase? 'shape) cause)
                            (eq? (.get (car (graph.validation-failure-cause cause)) kind) 'recursive-structure)))))
    (test-case "unproductive eager computed cycle still refuses"
      (check-exception (graph.close-validation (lambda (_)
        (def descriptor (Record first: [Integer] second: [Integer]))
        (def source (.o (:: self []) first: (.get self second) second: (.get self first)))
        (list (list 'root descriptor source)))) CyclicSlot?))
    (test-case "productive computed peer captures and positive flags close together"
      (def closed (service.close-service (.o)))
      (def left (graph.closed-ref closed 'left))
      (check (eq? (.get left peer peer) left) => #t)
      (check (eq? (.get left peer-handler) (.get left peer handler)) => #t)
      (check-equal? (.get left active) #t)
      (check-equal? (.get left peer active) #t)
      (check-exception ((.get left peer-handler) (handling.session service.program) #f) TypeError?))
    (test-case "safe recursive requests share memo without admitting diagnostics"
      (def closed (service.close-service (.o))) (def left (graph.closed-ref closed 'left))
      (def session (handling.session service.program))
      (def first ((.get left handler) session 4))
      (check-equal? (handling.result-value first) 10)
      (def second ((.get left peer-handler) (handling.result-next first) 3))
      (check-equal? (handling.result-value second) 8)
      (check-equal? (handling.result-reused second) #t)
      (def failed (handling.call-slot session service.registry 'left 4 0))
      (check (eq? session (handling.result-next failed)) => #t)
      (check-equal? (cached.diagnostic-kind (handling.failure-cause (handling.result-failure failed))) 'budget-exhausted))
    (test-case "full FUN closure refinement and evidence publication"
      (def context-value (.o commits: 0 session: (handling.session service.program)))
      (defvalues (result state failure) ((service.service-action Call context-value) request))
      (check-equal? failure #f)
      (check-equal? (.get result total) 18)
      (check-equal? (.get result reused) #t)
      (check-equal? (.get state commits) 1))
    (test-case "raw and stale evidence refuse before current graph retry"
      (def closed (service.close-service (.o)))
      (def descriptor-value (service.envelope closed))
      (def context-value (.o commits: 1)) (def stale (.o commits: 0))
      (def source (.o config: (config.decode-service request) processor: (graph.closed-ref closed 'left)))
      ;; Each root admission binds its own normalized subject and current context.
      (def (action raw-subject evidence-context)
        (publication.publication-action descriptor-value Call context-value
          (lambda (checked) (values (.o subject: (or raw-subject checked) descriptor: descriptor-value
                                         context: evidence-context) (.o commits: 2)))))
      ;; Force a changed outer field so raw-root identity is observably different.
      (def wrapper (.cc descriptor-value responsibilities: (.cc (.get descriptor-value responsibilities)
        marker: (Fun Integer <- Integer))))
      (def candidate (.cc source marker: values))
      (def publish-raw (publication.publication-action wrapper Call context-value
        (lambda (_checked) (values (.o subject: candidate descriptor: wrapper context: context-value) (.o commits: 2)))))
      (defvalues (_ old failure) (publish-raw candidate))
      (check (eq? old context-value) => #t)
      (check-equal? (metadata.failure-phase failure) 'logic)
      (defvalues (_result old-state stale-failure) ((action #f stale) source))
      (check (eq? old-state context-value) => #t)
      (check-equal? (metadata.failure-phase stale-failure) 'logic)
      (defvalues (_next next-state next-failure) ((action #f context-value) source))
      (check-equal? next-failure #f)
      (check-equal? (.get next-state commits) 2))))
