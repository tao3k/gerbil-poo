(export method-declaration-test)
(import :std/test :std/error :std/iter :clan/poo/object :clan/poo/mop :clan/poo/brace :clan/poo/declaration :clan/poo/method-declaration :clan/poo/reflection
        (only-in :clan/poo/number Integer)
        :clan/poo/recursive-declaration
        :clan/poo/support/option
        (prefix-in :clan/poo/proto proto.)
        (prefix-in :clan/poo/method-combination combination.) (prefix-in :clan/poo/examples/declared-methods service.))
;; Independent historical equations retain delayed suffix reconstruction, so the
;; standard reduction is compared with the previous observable capture boundary.
(def (reference-prototypes layers)
  (match layers
    ([] proto.identity-proto) ([p] p) ([p q] (proto.compose-proto p q))
    ([p . tail] (lambda (self inherited)
      (p self ((reference-prototypes tail) self inherited))))))
;; Exercise source-spine mutation by a body after the complete suffix was selected.
;; The constructor must retain the old outer head and see tail edits next time.
(def (prototype-capture constructor)
  (def events [])
  (def layers #f)
  ;; Record exact self, input and callback order without replacing the interpreter.
  (def (layer name)
    (lambda (self inherited)
      (set! events (cons [name self inherited] events))
      (when (eq? name 'inner) (set-car! (cdr layers) (layer 'revised)))
      (cons name inherited)))
  (set! layers (map layer '(outer middle inner terminal)))
  (def program (constructor layers))
  (set-car! layers (layer 'uncaptured))
  (def first (program 'self []))
  (def second (program 'self []))
  [first second (reverse events)])
;; Combined instance methods preserve argument order through the existing generic macro.
(.defgeneric (score self value) slot: .score combination: (simple-combination combination.sum))
;; Explicit empty fragments provide the missing-slot default, not a method result cache.
(.defgeneric (empty-score self value) slot: .score default: [] combination: (simple-combination combination.sum))
;; A combined zero-argument function invokes its method; a plain instance getter stays a getter.
(.defgeneric (zero-score self) slot: .zero combination: (simple-combination combination.sum))
;; A rest argument row, including false, reaches the item unchanged.
(.defgeneric (collect-score self . args) slot: .collect combination: (simple-combination combination.collect))
;; Instance property access follows its zero-argument slot protocol.
(.defgeneric (label self) slot: label)
;; Genuine absence gets a default; nested computation errors must propagate.
(.defgeneric (fallback self) slot: .missing default: 'fallback)
;; Mismatched combination qualifiers must refuse before executing any body.
(.defgeneric (wrong-score self value) slot: .score combination: standard-combination)
;; Forwarding replaces only payload; dispatch remains the original argument.
(.defgeneric (forward-call self dispatch payload) slot: .forward combination: (forwarding-combination Any))
;; Inner contribution lists contain ordinary next-thunk procedures.
(.defgeneric (inner-call self value) slot: .inner combination: (inner-combination (lambda (_) 0)))
;; Simula bodies retain their existing prefix/inner/suffix protocol.
(.defgeneric (simula-call self value) slot: .simula combination: simula-combination)
;; Standard around/primary semantics also apply to an instance-provided generic.
(.defgeneric (standard-call self value) slot: .standard combination: standard-combination)
;; Deliberately effectful selection and lookup expose the bridge evaluation order.
;; The combiner returns multiple values, including the complete escaped call row.
(.defgeneric (boundary-call self required (optional #f) label: (label #f) . rest)
  slot: .parts combination: (begin ((.@ self record) 'combine) (.@ self combiner)))
;; Test actual assembled methods rather than expected constants injected into slots.
(def method-declaration-test
  (test-suite "declaration fragments method combination and defgeneric"
    (test-case "constructor evidence follows current bodies and qualifier revisions"
      (def primary (combination.primary (lambda (_ value) (+ value 1))))
      (def before (combination.before (lambda (_) (.set! primary body (lambda (_ value) (+ value 10))))))
      (check (combination.standard-contribution? primary) => #t)
      ;; Before runs before primary grouping: admission must not freeze callbacks.
      (check-equal? (standard-combination [before primary] [3]) 13)
      (.set! primary qualifier 'item)
      (check (combination.standard-contribution? primary) => #f)
      (check (combination.simple-contribution? primary) => #t)
      (.set! primary body #f)
      (check (combination.simple-contribution? primary) => #f)
      (check-exception (standard-combination [primary] [3]) true)
      (.set! primary body (lambda (value) (+ value 20)))
      (check-equal? ((simple-combination combination.sum) [primary] [3]) 23)
      (check-exception (combination.contribution 'primary #f) true)
      (check (combination.standard-contribution? (combination.contribution 'unknown identity)) => #f)
      (check (combination.standard-contribution? #f) => #f))
    (test-case "audited diamond registration composes current FUN review refusal and retry"
      (def registered [])
      ;; Share one builder through declaration assembly; no method body runs here.
      (def (register qualifier body)
        (set! registered (cons qualifier registered))
        (combination.contribution qualifier body))
      (def events [])
      ;; The complete effect trace catches duplicated shared-base contributions.
      (def (record event) (set! events (cons event events)))
      (def family (service.make-reporting-family record register))
      (def action (service.typed-summary-action family 2))
      (check-equal? events [])
      (check-equal? (length registered) 8)
      (check-equal? (call/values (lambda () (action (.o rate: 10))) list)
        '(46 ((10 2 2 #f (payload: #f)))))
      (check-equal? (reverse events)
        '(summary around-enter billing-before risk-before billing-primary base risk-after billing-after around-exit))
      (set! events [])
      (check-equal? (call/values (lambda () (action (.o rate: 20))) list)
        '(86 ((20 2 2 #f (payload: #f)))))
      (check-equal? (length events) 9)
      ;; Retained evidence does not bypass current visibility or post-success review.
      (def reviews [])
      (def reviewed (service.reviewed-summary-action family 2
        (lambda (amount _) (set! reviews (cons amount reviews)))))
      (def descriptor (cdr (assq (quote .summary) (reflect-slots family))))
      (.setslot! descriptor hidden ($constant-slot-spec #t))
      (set! events [])
      (check-exception (reviewed (.o rate: 30)) true)
      (check-equal? events [])
      (check-equal? reviews [])
      (.setslot! descriptor hidden ($constant-slot-spec #f))
      (check-equal? (call/values (lambda () (reviewed (.o rate: 30))) list)
        (quote (126 ((30 2 2 #f (payload: #f))))))
      (check-equal? reviews (quote (126))))
    (test-case "fused Reader reviews reenter with fresh receivers and retry current metadata"
      (def events [])
      (def reviews [])
      (def action #f)
      (def family (service.make-reporting-family
        (lambda (event) (set! events (cons event events)))))
      ;; The review invokes the same captured action with another current rate.
      ;; The outer result must survive nested accounts and two result-value frames.
      (def (review amount summary)
        (set! reviews (cons amount reviews))
        (when (= amount 46)
          (check-equal? (call/values (lambda () (action (.o rate: 20))) list)
            '(86 ((20 2 2 #f (payload: #f)))))))
      (set! action (service.reviewed-summary-action family 2 review))
      (check-equal? (call/values (lambda () (action (.o rate: 10))) list)
        '(46 ((10 2 2 #f (payload: #f)))))
      (check-equal? (reverse reviews) '(46 86))
      (check-equal? (length (filter (cut eq? <> 'base) events)) 2)
      (def descriptor (cdr (assq '.summary (reflect-slots family))))
      (.setslot! descriptor hidden ($constant-slot-spec #t))
      (set! events []) (set! reviews [])
      (check-exception (action (.o rate: 30)) Error?)
      (check-equal? events []) (check-equal? reviews [])
      (.setslot! descriptor hidden ($constant-slot-spec #f))
      (check-equal? (call/values (lambda () (action (.o rate: 30))) list)
        '(126 ((30 2 2 #f (payload: #f)))))
      (check-equal? reviews '(126))
      (def cause (list 'review-refused))
      (def failed (service.reviewed-summary-action family 2 (lambda (_ __) (raise cause))))
      (set! events [])
      (check-exception (failed (.o rate: 40)) (lambda (actual) (eq? actual cause)))
      (check-equal? (length (filter (cut eq? <> 'base) events)) 1))
    (test-case "FUN Observation specifies its summary result context"
      (def family (service.make-reporting-family void))
      (def charges 0)
      (def outputs [])
      ;; Zero/single/multiple results use the declared ordinary value context.
      (def (summary-results account units label: (label #f) . rest) (apply values outputs))
      ;; A counter distinguishes result projection from new refusal or double work.
      (def (charging account units) (set! charges (+ charges 1)) 'charged)
      (def action (service.summary-observation family 2 summary-results charging))
      (for (results (list [] [#f] ['first] ['first 'second]))
        (set! outputs results) (set! charges 0)
        (def actual (call/values (lambda () (action (.o rate: 10))) list))
        ;; Gerbil retains an opaque multiple-values carrier in this context.
        ;; Compare its contents through the core values->list boundary rather
        ;; than pointer identity of separately created opaque return carriers.
        (check-equal? (car actual) 'charged)
        (check-equal? (length actual) 2)
        (check-equal? (values->list (cadr actual)) results)
        (check-equal? charges 1)))
    (test-case "direct combined rows retain selection lookup defaults and multiple values"
      (def events [])
      ;; One log distinguishes selector failure, lookup failure and body execution.
      (def (record-event event) (set! events (cons event events)))
      (def self (.o
        (record record-event)
        (combiner (lambda (parts row) (record-event 'body) (values #f (cons parts row))))
        (.parts (begin (record-event 'lookup) 'parts))))
      (check-equal? (call/values (lambda () (boundary-call self #!key payload: label: #f #!rest #f #f)) list)
        '(#f (parts label: #f #!rest payload: #f #f)))
      (check-equal? (reverse events) '(combine lookup body))
      (def frames [])
      ;; A combiner owns each transported row; changing it cannot rewrite a
      ;; caller's replay list or a subsequent invocation's independently built row.
      (.set! self combiner (lambda (_ row)
        (set! frames (cons row frames)) (set-car! row 'changed) #f))
      (def supplied (list label: #f #!rest 3 #f payload: #f))
      (check (apply boundary-call self supplied) => #f)
      (check (apply boundary-call self supplied) => #f)
      (check-equal? supplied '(label: #f #!rest 3 #f payload: #f))
      (check (eq? (car frames) (cadr frames)) => #f)
      ;; Mutate the copied rest spine, not merely the newly constructed prefix.
      ;; A later replay must still see the caller's original escaped payload.
      (.set! self combiner (lambda (_ row)
        (check-equal? row '(label: #f #!rest 3 #f payload: #f))
        (set-car! (list-tail row 5) 'private)
        (set-cdr! (list-tail row 5) []) #t))
      (check (apply boundary-call self supplied) => #t)
      (check (apply boundary-call self supplied) => #t)
      (check-equal? supplied '(label: #f #!rest 3 #f payload: #f))
      (.set! self combiner #f)
      ;; Invalidate the cached slot too: invalid combiners must still demand it.
      (.setslot! self .parts ($computed-slot-spec (lambda (_ inherited) (record-event 'lookup) 'parts)))
      (set! events [])
      (check-exception (boundary-call self 2) Error?)
      (check-equal? (reverse events) '(combine lookup))
      (def cause (list 'lookup-failed))
      (.setslot! self .parts ($computed-slot-spec (lambda (_ inherited) (record-event 'lookup) (raise cause))))
      (set! events [])
      (check-exception (boundary-call self 2) (lambda (actual) (eq? actual cause)))
      (check-equal? (reverse events) '(combine lookup))
      (.set! self record (lambda (_) (raise cause)))
      (set! events [])
      (check-exception (boundary-call self 2) (lambda (actual) (eq? actual cause)))
      (check-equal? events []))
    (test-case "replayed Reader requests own rest rows across metadata refusal and retry"
      (def events [])
      ;; Preserve callback order and one shared C3 base, including the retry.
      (def (record event) (set! events (cons event events)))
      (def metadata-family (.declare MethodDeclaration. (.o)
        (public .summary-combination (.o (type Any) (default (simple-combination combination.collect))))))
      (def family (.mix metadata-family (service.make-reporting-family record)))
      (def request (list 2 2 #f (list payload: #f)))
      (def action (service.replayed-summary-action family 2 (list request request)))
      (write-slot! family '.summary-combination (lambda (parts row)
        (def result ((simple-combination combination.collect) parts row))
        (set-car! (list-tail row 6) 'private)
        (set-cdr! (list-tail row 6) [])
        result))
      (check-equal? (call/values (lambda () (action (.o rate: 10))) list)
        '(46 (((10 2 2 #f ((payload: #f)))) ((10 2 2 #f ((payload: #f)))))))
      (check-equal? request '(2 2 #f (payload: #f)))
      (check-equal? (length (filter (cut eq? <> 'base) events)) 1)
      (def metadata (cdr (assq '.summary-combination (reflect-slots family))))
      (.setslot! metadata hidden ($constant-slot-spec #t))
      (set! events [])
      (check-exception (action (.o rate: 20)) Error?)
      (check-equal? events [])
      (.setslot! metadata hidden ($constant-slot-spec #f))
      (check-equal? (car (call/values (lambda () (action (.o rate: 20))) list)) 86)
      (check-equal? request '(2 2 #f (payload: #f))))
    (test-case "current declared combiner composes reflection Reader and shared C3 retry"
      (def events [])
      ;; Record every method separately from the current combination boundary.
      (def (record event) (set! events (cons event events)))
      (def family (.declare MethodDeclaration. (.o)
        (public .summary-combination (.o (type Any) (default (simple-combination combination.collect))))))
      (def complete (.mix family (service.make-reporting-family record)))
      (def action (service.configured-summary-action complete 2))
      (check-equal? (call/values (lambda () (action (.o rate: 10))) list)
        '(46 ((10 2 2 #f (payload: #f)))))
      (def metadata (cdr (assq '.summary-combination (reflect-slots complete))))
      (.setslot! metadata hidden ($constant-slot-spec #t))
      (set! events [])
      (check-exception (action (.o rate: 20)) Error?)
      (check-equal? events [])
      (.setslot! metadata hidden ($constant-slot-spec #f))
      (write-slot! complete '.summary-combination
        (lambda (parts row) (record 'combine) ((simple-combination combination.collect) parts row)))
      (check-equal? (car (call/values (lambda () (action (.o rate: 20))) list)) 86)
      (check-equal? (car (reverse events)) 'combine)
      (check-equal? (length (filter (cut eq? <> 'base) events)) 1)
      (write-slot! complete '.summary-combination #f)
      (set! events [])
      (check-exception (action (.o rate: 30)) Error?)
      (check-equal? events [])
      (write-slot! complete '.summary-combination (simple-combination combination.collect))
      (check-equal? (car (call/values (lambda () (action (.o rate: 30))) list)) 126))
    (test-case "standard prototype reduction preserves identities current tails and exact body failures"
      (def layer (lambda (_ value) (cons 'only value)))
      (check (eq? (proto.compose-proto* []) proto.identity-proto) => #t)
      (check (eq? (proto.compose-proto* [layer]) layer) => #t)
      (def pair (list layer layer))
      (def captured-pair (proto.compose-proto* pair))
      (set-car! (cdr pair) (lambda (_ value) (cons 'changed value)))
      (check-equal? (captured-pair 'self []) '(only only))
      (for-each (lambda (count)
        (def layers (map (lambda (n) (lambda (self value) (cons [self n] value))) (iota count)))
        (check-equal? ((proto.compose-proto* layers) 'self [])
          ((reference-prototypes layers) 'self []))) (iota 9))
      (def calls [])
      (def cause (list 'prototype-refused))
      (def program (proto.compose-proto*
        [(lambda (_ value) (set! calls (cons 'outer calls)) value)
         (lambda (_ value) (raise cause))
         (lambda (_ value) (set! calls (cons 'inner calls)) value)]))
      (check-exception (program 'self #f) (lambda (actual) (eq? actual cause)))
      (check-equal? calls '(inner)))
    (test-case "standard prototype reduction selects before callbacks and rejects cyclic revised suffixes"
      (def result (prototype-capture proto.compose-proto*))
      (check-equal? result (prototype-capture reference-prototypes))
      (check-equal? (take result 2)
        '((outer middle inner terminal) (outer revised inner terminal)))
      (check-equal? (map car (caddr result))
        '(terminal inner middle outer terminal inner revised outer))
      (check (every (lambda (event) (eq? (cadr event) 'self)) (caddr result)) => #t)
      (def calls 0)
      (def layer (lambda (_ value) (set! calls (1+ calls)) value))
      (def layers (list layer layer layer))
      (def program (proto.compose-proto* layers))
      (set-cdr! (cddr layers) (cdr layers))
      (check-exception (program 'self #f) contract-violation-error?)
      (set-cdr! (cddr layers) 'improper)
      (check-exception (program 'self #f) contract-violation-error?)
      (check-equal? calls 0))
    (test-case "prototype Reader layers compose current policy reflection forwarding and C3 retry"
      (def events [])
      ;; One ordered callback log spans prototype actions and actual method bodies.
      (def (record event) (set! events (cons event events)))
      (def family (service.make-reporting-family record))
      (def policy (.declare Declaration. (.o)
        (public offset (.o (type Integer) (default 1))) (public tag (.o (constant #f)))))
      (def action (service.prototype-summary-action family 2 (service.summary-prototypes policy record)))
      (check-equal? events [])
      (check-equal? (action (.o rate: 10 approved: #t))
        '(#f 50 ((11 2 2 #f (payload: #f)))))
      (check-equal? (reverse events)
        '(approval offset summary around-enter billing-before risk-before billing-primary base
          risk-after billing-after around-exit tag observed))
      (set! events [])
      (check-exception (action (.o rate: 20 approved: #f)) Error?)
      (check-equal? events [])
      (def descriptor (cdr (assq 'offset (reflect-slots policy))))
      (.setslot! descriptor hidden ($constant-slot-spec #t))
      (check-exception (action (.o rate: 20 approved: #t)) Error?)
      (check-equal? (reverse events) '(approval offset))
      (.setslot! descriptor hidden ($constant-slot-spec #f))
      (check-exception (write-slot! policy 'offset #f) Error?)
      (check-equal? (read-slot policy 'offset) 1)
      (write-slot! policy 'offset 3)
      (set! events [])
      (check-equal? (cadr (action (.o rate: 20 approved: #t))) 98)
      (def summary (cdr (assq '.summary (reflect-slots family))))
      (.setslot! summary hidden ($constant-slot-spec #t))
      (set! events [])
      (check-exception (action (.o rate: 20 approved: #t)) Error?)
      (check-equal? (reverse events) '(approval offset))
      (.setslot! summary hidden ($constant-slot-spec #f))
      (def tag (cdr (assq 'tag (reflect-slots policy))))
      (.setslot! tag hidden ($constant-slot-spec #t))
      (set! events [])
      (check-exception (action (.o rate: 20 approved: #t)) Error?)
      (check-equal? (length (filter (cut eq? <> 'base) events)) 1)
      (check (memq 'observed events) => #f)
      (check-equal? (car events) 'tag)
      (.setslot! tag hidden ($constant-slot-spec #f))
      (check-equal? (cadr (action (.o rate: 30 approved: #t))) 138))
    (test-case "core contracted forwarding composes current reflection and both method policies"
      (def events [])
      (def family (service.make-reporting-family (lambda (event) (set! events (cons event events)))))
      (def action (service.typed-summary-action family 2))
      (check-equal? events [])
      (check-equal? (call/values (lambda () (action (.o rate: 10))) list)
        '(46 ((10 2 2 #f (payload: #f)))))
      (check-equal? (reverse events)
        '(summary around-enter billing-before risk-before billing-primary base risk-after billing-after around-exit))
      (set! events [])
      (check-exception ((service.typed-summary-action family #f) (.o rate: 10)) contract-violation-error?)
      (check-equal? events [])
      (def descriptor (cdr (assq '.summary (reflect-slots family))))
      (.setslot! descriptor hidden ($constant-slot-spec #t))
      (check-exception (action (.o rate: 20)) Error?)
      (check-exception ((service.typed-summary-action family #f) (.o rate: 20))
        (lambda (cause) (and (Error? cause)
          (equal? (error-message cause) "slot is hidden or undeclared"))))
      (check-equal? events [])
      (.setslot! descriptor hidden ($constant-slot-spec #f))
      (check-equal? (call/values (lambda () (action (.o rate: 20))) list)
        '(86 ((20 2 2 #f (payload: #f)))))
      (check-equal? (length (filter (cut eq? <> 'base) events)) 1))
    (test-case "prefixed FUN workflow separates snapshots live aliases and current reflection"
      (def events [])
      (def family (service.make-family (lambda (event) (set! events (cons event events)))))
      (def account (service.make-account family 10))
      (def action (service.prefixed-action account 2))
      (check-equal? events [])
      (check-equal? (call/values (lambda () (action (.o approved: #t))) list) '(10 10 46))
      (set! events [])
      (.setslot! account rate ($constant-slot-spec 20))
      (check-exception (action (.o approved: #f)) Error?)
      (check-equal? events [])
      (def descriptor (cdr (assq '.charge (reflect-slots family))))
      (.setslot! descriptor hidden ($constant-slot-spec #t))
      (check-exception (action (.o approved: #t)) Error?)
      (check-equal? events [])
      (.setslot! descriptor hidden ($constant-slot-spec #f))
      (check-equal? (call/values (lambda () (action (.o approved: #t))) list) '(10 20 86))
      (check-equal? (reverse events)
        '(around-enter billing-before risk-before billing-primary base risk-after billing-after around-exit)))
    (test-case "prepared whole-batch declarations finalize before inherited combined dispatch"
      (def events [])
      (def record (lambda (event) (set! events (cons event events))))
      (def family (service.make-family record))
      (def expander (service.batch-expander record))
      (def action (service.batch-action family expander 2))
      (check-equal? events [])
      (check-equal? (call/values (lambda ()
        (action (.o tenant: 'eu rate: 10 surcharge: 5 approved: #t))) list)
        '(eu (tenant .charge label) 56))
      (check-equal? (reverse events)
        '(tenant token .charge finalize around-enter batch-before billing-before risk-before
          batch-primary billing-primary base risk-after billing-after batch-after around-exit))
      (set! events [])
      (check-exception (action (.o tenant: 'us rate: 20 surcharge: 7 approved: #f)) Error?)
      (check-equal? (reverse events) '(tenant token .charge finalize))
      (set! events [])
      (check-equal? (call/values (lambda ()
        (action (.o tenant: 'us rate: 20 surcharge: 7 approved: #t))) list)
        '(us (tenant .charge label) 100))
      (check-equal? (active-object-constructions) []))
    (test-case "stale batch expanders refuse before effects and fresh preparation recovers"
      (def events [])
      (def record (lambda (event) (set! events (cons event events))))
      (def family (service.make-family record))
      (def expander (service.batch-expander record))
      (def action (service.batch-action family expander 2))
      (def finalize (.@ expander finalize-declarations))
      (.putslot! expander 'finalize-declarations ($constant-slot-spec finalize))
      (check-exception (action (.o tenant: 'eu rate: 10 surcharge: 5 approved: #t)) Error?)
      (check-equal? events [])
      (check-equal? (call/values (lambda ()
        ((service.batch-action family expander 2)
          (.o tenant: 'eu rate: 10 surcharge: 5 approved: #t))) list)
        '(eu (tenant .charge label) 56)))
    (test-case "shared family preserves qualifier order receiver and current Reader data"
      (def events [])
      (def family (service.make-family (lambda (event) (set! events (cons event events)))))
      (check-equal? events [])
      (def action (service.observation family 2))
      (check-equal? (action (.o (rate 10))) 46)
      (check-equal? (reverse events)
        '(around-enter billing-before risk-before billing-primary base risk-after billing-after around-exit))
      ;; Effective reflection visits the branch's method before the base's label.
      (check-equal? (.@ family .public-slots) '(.charge label))
      (set! events [])
      (check-equal? (action (.o (rate 20))) 86)
      (check-equal? (length (filter (cut eq? <> 'base) events)) 1))
    (test-case "static and computed fragments share public record declaration syntax"
      (def value (.declare MethodDeclaration. (.o)
        (public label (.o (constant 'mixed)))
        (method .score (.o (admit combination.simple-contribution?)
          (contributions [(combination.item identity)])))
        ,@[(method-fragment '.score [(combination.item (lambda (value) (* 2 value)))] combination.simple-contribution?)]))
      (check-equal? (label value) 'mixed)
      (check-equal? (score value 4) 12)
      (check-equal? (.@ value .public-slots) '(label .score))
      (check-exception (wrong-score value 4) true)
      (check-equal? (empty-score (.o) 4) 0))
    (test-case "zero and rest argument combined calls preserve their conventions"
      (def value (object<-declaration-forms MethodDeclaration. (.o)
        (list (method-fragment '.zero [(combination.item (lambda () 7))] combination.simple-contribution?)
          (method-fragment '.collect [(combination.item (lambda args args))] combination.simple-contribution?))))
      (check-equal? (zero-score value) 7)
      (check-equal? (collect-score value 1 #f 'three) '((1 #f three))))
    (test-case "descriptor edits invalidate groups and detect revised visibility conflicts"
      (def metadata (.o (admit combination.simple-contribution?) (contributions [(combination.item identity)])))
      (def other (.o (admit combination.simple-contribution?) (contributions [(combination.item (lambda (_) 2))])))
      (def value (.declare MethodDeclaration. (.o) (method .score metadata) (method .score other)))
      (check-equal? (score value 3) 5)
      (.putslot! metadata 'contributions ($constant-slot-spec [(combination.item (lambda (value) (* 10 value)))]))
      (check-equal? (score value 3) 32)
      (.putslot! other 'hidden ($constant-slot-spec #t))
      (check-exception (.@ value .public-slots) true))
    (test-case "collisions malformed fragments and inconsistent visibility refuse before effects"
      (def called? #f)
      (def body (combination.primary (lambda (_ value) (set! called? #t) value)))
      (check-exception (.declare MethodDeclaration. (.o)
        (method .score (.o (contributions [body]))) (public .score (.o (default 3)))) true)
      (check-exception (object<-declaration-forms MethodDeclaration. (.o)
        (list (method-fragment '.score [body]) (method-fragment '.score [body] combination.standard-contribution? #t))) true)
      (check-exception (.declare MethodDeclaration. (.o)
        (method .score (.o (contributions [(combination.item identity)])))) true)
      (check-equal? called? #f))
    (test-case "nested absence is not an empty inherited group or generic default"
      (def missing (.o))
      (check-equal? (fallback (.o)) 'fallback)
      (def value (.o (.missing (.ref missing 'nested))))
      (check-exception (fallback value) true)
      (def parent (.o (.score (.ref missing 'nested))))
      (def child (object<-declaration-forms MethodDeclaration. (.o)
        [(method-fragment '.score [(combination.item identity)] combination.simple-contribution?)] supers: [parent]))
      (check-exception (score child 3) true))
    (test-case "recursive declaration roots finalize into the same generic method slot"
      (def expander (.mix RecursiveDeclaration. MethodDeclaration.))
      (def value (object<-recursive-declarations expander (.o)
        (list (cons 'first (method-fragment '.score [(combination.item identity)] combination.simple-contribution?))
          (cons 'second (method-fragment '.score [(combination.item (lambda (_) 2))] combination.simple-contribution?)))
        '(first second) 50))
      (check-equal? (score value 3) 5)
      (check-equal? (.@ value .public-slots) '(.score)))
    (test-case "forwarding inner and Simula declarations use the method-combination interpreters"
      (def events [])
      (def value (object<-declaration-forms MethodDeclaration. (.o)
        (list
          (method-fragment '.forward
            [(combination.forward-primary (lambda (next dispatch payload) (next (some (+ payload 1)))))
             (combination.forward-primary (lambda (_ dispatch payload) (list dispatch payload)))]
            combination.forward-contribution?)
          (method-fragment '.inner
            [(lambda (next value) (+ value (next))) (lambda (next value) (+ 10 (next)))] procedure?)
          (method-fragment '.simula
            [(combination.simula-body (lambda (_) (set! events (cons 'specific-prefix events)))
               (lambda (_) (set! events (cons 'specific-suffix events))))
             (combination.simula-body (lambda (_) (set! events (cons 'general-prefix events)))
               (lambda (_) (set! events (cons 'general-suffix events))))]
            combination.simula-body?))))
      (check-equal? (forward-call value 'fixed 4) '(fixed 5))
      (check-equal? (inner-call value 3) 13)
      (simula-call value 1)
      (check-equal? (reverse events) '(general-prefix specific-prefix specific-suffix general-suffix)))
    (test-case "around omission and primary failure preserve effect boundaries"
      (def events [])
      (def skipped (.declare MethodDeclaration. (.o)
        (method .standard (.o (contributions
          [(combination.around (lambda (_ value) 7))
           (combination.primary (lambda (_ value) (set! events '(primary)) value))])))))
      (check-equal? (standard-call skipped 4) 7)
      (check-equal? events [])
      (def refused (.declare MethodDeclaration. (.o)
        (method .standard (.o (contributions
          [(combination.primary (lambda (_ value) (error "refused")))
           (combination.after (lambda (value) (set! events '(after))))])))))
      (check-exception (standard-call refused 4) true)
      (check-equal? events []))))
