;
;; Consume the standard Iterator through its own protocol; no test cursor engine.
(def (entries cursor) (for/collect (entry cursor) entry))

;; Rational keys include exact/inexact aliases; every declaration retains RBTree equality.
(def rationaldict-order-test
  (test-suite "standard rational backend ordered protocol"
    (test-case "positioned producers capture Pair shells before bound comparator effects"
      (def raw (RationalDict Integer)) (def row (cons 1 10))
      (def compare (lambda (a b)
        (when (and (= a 1) (= b 0)) (set-car! row 9) (set-cdr! row 20))
        (number-comparer a b)))
      (def source (.cc raw Comparer: (table-comparer Rational compare equal?: =)))
      (def cursor (table-ordered-cursor source (.call raw .singleton 1 10)
        (some 0) #t (lambda (_) (list row)) compare =))
      (check-equal? (entries cursor) '((1 . 10)))
      (check-equal? row '(9 . 20)))
    (test-case "invalid producer rows refuse before filtering or comparator repair"
      (def raw (RationalDict Integer)) (def comparisons 0)
      (def row (cons -1 'invalid))
      (def compare (lambda (a b)
        (set! comparisons (+ comparisons 1)) (set-cdr! row 10) (number-comparer a b)))
      (def source (.cc raw Comparer: (table-comparer Rational compare equal?: =)))
      (def root (.call raw .singleton 1 10))
      (for (bad (list row 'malformed))
        (let (cursor (table-ordered-cursor source root (some 0) #t
          (lambda (_) (list bad)) compare =))
          (using (cursor :- Iterator) (check-exception (cursor.next!) TypeError?))))
      (check-equal? comparisons 0) (check-equal? (cdr row) 'invalid))
    (test-case "reused producer buffers retain Function leaves and suppress IO on late refusal then retry"
      (def signature (Fun Integer <- Integer))
      (def callback (validate signature (lambda (n) (+ n 1))))
      (def raw (RationalDict signature)) (def row (cons 1 callback))
      (def invalid? #t) (def deliveries 0)
      (def compare (lambda (a b)
        (set-cdr! row 'overwritten) (number-comparer a b)))
      (def source (.cc raw Comparer: (table-comparer Rational compare equal?: =)))
      (def root (.call raw .<-list (list (cons 1 callback) (cons 2 callback))))
      (def producer (lambda (_) (in-coroutine (lambda (yield)
        (set-car! row 1) (set-cdr! row callback) (yield row)
        (set-car! row 2) (set-cdr! row (if invalid? 'invalid callback)) (yield row)))))
      (def descriptor (.cc source .seek<-: (lambda (input lower inclusive?)
        (table-ordered-cursor source input lower inclusive? producer compare =))))
      (def action (service.observe-positioned-ledger-action descriptor (some 0)
        (lambda (rows) (set! deliveries (+ deliveries 1)) rows)))
      (check-exception (action root) TypeError?) (check-equal? deliveries 0)
      (set! invalid? #f)
      (let (rows (action root))
        (check-equal? (map car rows) '(1 2))
        (for (entry rows) (check-eq? (cdr entry) callback))
        (check-equal? ((cdar rows) 7) 8))
      (check-equal? deliveries 1)
      (check-equal? (.call raw .ref root 2) callback))
    (test-case "numeric aliases use declared equality and strict Boolean decisions"
      (def source (RationalDict Integer))
      (check-equal? (.call (.@ source Comparer) .compare 1 1.0) 0)
      (check-equal? (.call (.@ source Comparer) .compare -3/2 -1.5) 0)
      (def structural (table-comparer (.@ source Key) number-comparer))
      (check-exception (.call structural .compare 1 1.0) (message? "invalid table comparison"))
      (def wrong (table-comparer (.@ source Key) number-comparer equal?: (lambda _ 'yes)))
      (check-exception (.call wrong .compare 1 1.0) ContractViolation?)
      (def left (.call source .singleton 1 10))
      (def right (.call source .singleton 1.0 10))
      (check-equal? (.call source .compare number-comparer left right) 0)
      (check-equal? (.call RationalSet .compare (.call RationalSet .singleton 1)
        (.call RationalSet .singleton 1.0)) 0)
      (def flags (RationalDict Bool))
      (def rows (.call flags .<-list '((1 . #f) (2 . #t))))
      (defvalues (before-pivot present after-pivot) (.call flags .split 1.0 rows))
      (check (.call flags .empty? before-pivot) => #t)
      (check-equal? present (some #f))
      (check (.call flags .ref after-pivot 2) => #t))
    (test-case "sign refusal precedes equality effects and equality failures keep their cause"
      (def calls 0) (def source (RationalDict Integer))
      (def bad (table-comparer (.@ source Key) (lambda _ 9)
        equal?: (lambda _ (set! calls (+ calls 1)) (error "must not run"))))
      (check-exception (.call bad .compare 1 2) (message? "invalid table comparison"))
      (check-equal? calls 0)
      (def cause (list 'declared-equality-failed))
      (def failing (table-comparer (.@ source Key) number-comparer equal?: (lambda _ (raise cause))))
      (check (eq? (with-catch identity (lambda () (.call failing .compare 1 1.0))) cause) => #t))
    (test-case "bounds handle negative fractional bignum and inexact aliases"
      (def source (RationalDict Integer))
      (def huge (expt 2 100))
      (def root (.call source .<-list (list (cons (- huge) 0) (cons -3/2 1)
        (cons 0 2) (cons 1 3) (cons 3/2 4) (cons huge 5))))
      (check-equal? (map car (entries (.call source .seek<- root (some 1.0) #t))) (list 1 3/2 huge))
      (check-equal? (map car (entries (.call source .seek<- root (some 1.0) #f))) (list 3/2 huge))
      (def ordered (table-order source (.@ source Comparer)))
      (check-equal? (.call ordered .range root (some -1.5) (some 1.5) #f #f) '((0 . 2) (1 . 3)))
      (check-equal? (.call ordered .range root (some huge) (some huge)) (list (cons huge 5)))
      (check-equal? (.call ordered .range root (some huge) (some huge) #f #t) []))
    (test-case "nested order views avoid snapshot listing while mismatched equality keeps fallback"
      (def raw (RationalDict Integer))
      (def source (.cc raw .list<-: (lambda (_) (error "sorting fallback demanded"))))
      (def inner (table-order source (.@ source Comparer)))
      (def outer (table-order inner (.@ inner Comparer)))
      (def root (.call source .<-list '((-1 . 1) (0 . 2) (1 . 3))))
      (check-equal? (.call outer .range root (some 0.0) (some 1)) '((0 . 2) (1 . 3)))
      (def other (table-comparer (.@ source Key) number-comparer equal?: equal?))
      (check-exception (.call (table-order source other) .range root #f #f)
        (message? "sorting fallback demanded")))
    (test-case "backend comparer replacement cannot borrow the original producer order"
      (def source (RationalDict Integer))
      (def reverse (table-comparer (.@ source Key) (lambda (a b) (- (number-comparer a b))) equal?: =))
      (def root (.call source .<-list '((1 . 10) (2 . 20))))
      (def inconsistent (.cc source Comparer: reverse))
      (check-exception (.call inconsistent .seek<- root #f #t)
        (message? "incompatible ordered table cursor"))
      ;; An explicitly different order view still uses the legitimate sort path.
      (check-equal? (.call (table-order source reverse) .range root #f #f) '((2 . 20) (1 . 10))))
    (test-case "complete admission and captured bounds precede any producer pull"
      (def source (RationalDict UInt)) (def pulls 0)
      (def malformed (.call source .<-list/key '((1 . 10) (2 . bad))))
      (check-exception (table-ordered-cursor source malformed #f #t
        (lambda (root) (set! pulls (+ pulls 1)) (.call source .iter<- root)) number-comparer =) TypeError?)
      (check-equal? pulls 0)
      (def root (.call source .<-list '((1 . 10) (2 . 20))))
      (def lower (some 1.0))
      (def cursor (.call source .seek<- root lower #t))
      (some-value-set! lower 2)
      (check-equal? (map car (entries cursor)) '(1 2))
      (check-exception (.call source .seek<- root (some "bad") #t) TypeError?)
      (check-exception (.call source .seek<- root #f 'yes) ContractViolation?))
    (test-case "partly consumed and exhausted cursors reject metadata revision before another pull"
      (def source (RationalDict (.cc Integer)))
      (def root (.call source .singleton 1 10))
      (using ((active (.call source .seek<- root #f #t) :- Iterator)
              (finished (.call source .seek<- root #f #t) :- Iterator))
        (check-equal? (active.next!) '(1 . 10))
        (check-equal? (finished.next!) '(1 . 10))
        (check (eq? (finished.next!) #!eof) => #t)
        (.set! (.@ source Value) sexp 'changed)
        (check-exception (active.next!) (message? "stale ordered table cursor"))
        (check-exception (finished.next!) (message? "stale ordered table cursor"))))
    (test-case "transported rational order keeps wrappers and all five ownership workflows"
      (def table (service.make-mirrored-ledger))
      (def ordered (table-order table (.@ table Comparer)))
      (def signature (Fun Integer <- Integer))
      (def f (validate signature (lambda (n) (+ n 1))))
      (def root (.call ordered .<-list (list (cons -1 (cons 10 f)) (cons -2 (cons 20 f)))))
      (def after (.call ordered .<-list (list (cons -1 (cons 30 f)) (cons -2 (cons 20 f)))))
      (def delta (.call ordered .diff root after))
      (def effects 0)
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles ordered) name))
        (def owner (.call protocol .ap root))
        (def action (service.observe-ledger-range protocol (some -1.0) (some -2)
          entries (lambda (rows) (set! effects (+ effects 1)) rows)))
        (check-equal? (map car (action owner)) '(-1 -2))
        (check-exception (.call protocol .apply-delta owner (invert-table-delta delta)) table-conflict?)
        (def next (.call protocol .apply-delta owner delta))
        (check (eq? (cdr (.call protocol .ref next -1.0)) f) => #t)
        (def restored (.call protocol .apply-delta next (invert-table-delta delta)))
        (check-equal? (car (.call protocol .ref restored -1)) 10))
      (check-equal? effects 5))
    (test-case "shared rational index backends retain unique swaps grouped ranges and inverse recovery"
      (def signature (Fun Integer <- Integer))
      (def source (RationalDict (Tuple UInt UInt signature)))
      (defvalues (indexed _source) (service.make-ordered-service-indexes source RationalDict))
      (def f (validate signature (lambda (n) n)))
      (def before (.call source .<-list (list (cons 1 (vector 10 7 f)) (cons 2 (vector 20 7 f)))))
      (def after (.call source .<-list (list (cons 1 (vector 20 8 f)) (cons 2 (vector 10 8 f)))))
      (def initial (.call indexed .wrap before))
      (def delta (.call source .diff before after))
      (def next (.call indexed .apply-delta initial delta))
      (check-equal? (.call indexed .index-range next 'priority (some 10.0) (some 20)) '((10 . 2) (20 . 1)))
      (check (.call indexed .index-ref/opt next 'team 7) => #f)
      (def group (some-value (.call indexed .index-ref/opt next 'team 8.0)))
      (check-equal? (.call source .count group) 2)
      (check (eq? (vector-ref (.call source .ref group 1) 2) f) => #t)
      (def restored (.call indexed .apply-delta next (invert-table-delta delta)))
      (check-equal? (.call indexed .index-range restored 'priority #f #f) '((10 . 1) (20 . 2))))))
