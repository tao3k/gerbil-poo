;;; Complete finite ordered observations retain original producer cells.
(test-case "all direct ordered queries honor inherited receiver refusal before backend work"
  (for (positioned? '(#f #t))
    (def raw (RationalDict Integer)) (def reads 0)
    (def source (.cc raw .list/key: (lambda (root)
      (set! reads (+ reads 1)) (.call raw .list<- root))))
    (def ordered (table-order source (if positioned? (.@ source Comparer)
      (table-comparer (.@ source Key) (lambda (a b) (number-comparer a b)) equal?: =))))
    (def denied (.cc ordered .element?: (lambda (_) #f)))
    (def root (.call raw .singleton 1 10))
    (for (query (list
        (lambda () (.call denied .range root #f #f))
        (lambda () (.call denied .seek root #f))
        (lambda () (.call denied .iter<- root))
        (lambda () (.call denied .seek<- root #f #t))
        (lambda () (.call denied .range<- root #f #f))))
      (check-exception (query) TypeError?))
    (check-equal? reads 0)
    ;; Editing the original receiver revokes both its seal and retained cursors.
    (using ((cursor (.call ordered .iter<- root) :- Iterator))
      (.set! ordered .element? (lambda (_) #f))
      (check-exception (cursor.next!) Error?)
      (check-exception (.call ordered .range root #f #f) TypeError?))))

(test-case "ordered child overrides reject invalid tails even outside a narrow range"
  (def raw (RationalDict Integer))
  (def ordered (table-order raw (.@ raw Comparer)))
  (def narrowed (.cc ordered Value: UInt))
  (def root (.call raw .<-list '((1 . 10) (2 . -20))))
  (check-exception (.call narrowed .seek root (some 1)) TypeError?)
  (check-exception (.call narrowed .range root (some 1) (some 1)) TypeError?)
  (check-exception (.call narrowed .iter<- root) TypeError?))

(test-case "retained ordered cursors attest their actual receiver through EOF without readmission"
  (def raw (RationalDict Bool)) (def admissions 0)
  (def ordered (table-order raw (.@ raw Comparer)))
  (def refined (.cc ordered .element?: (lambda (root)
    (set! admissions (+ admissions 1)) (element? ordered root))))
  (def root (.call raw .singleton 1 #f))
  (for (method '(.iter<- .seek<- .range<-))
    (set! admissions 0)
    (using ((cursor (case method
              ((.iter<-) (.call refined .iter<- root))
              ((.seek<-) (.call refined .seek<- root #f #t))
              (else (.call refined .range<- root #f #f))) :- Iterator))
      (check-equal? admissions 1)
      (check-equal? (cursor.next!) '(1 . #f))
      (check (cursor.next!) => #!eof)
      (check (cursor.next!) => #!eof)
      (check-equal? admissions 1)
      (.set! refined sexp (list 'changed method))
      (check-exception (cursor.next!) Error?))))

(test-case "recursive receiver admission refuses finitely and fresh retry keeps checked Functions"
  (def signature (Fun Integer <- Integer))
  (def f (validate signature (lambda (n) (+ n 7))))
  (def raw (RationalDict signature)) (def ordered (table-order raw (.@ raw Comparer)))
  (def root (.call raw .singleton 1 f)) (def reenter? #t) (def admissions 0)
  (def refined #f)
  (set! refined (.cc ordered .element?: (lambda (snapshot)
    (set! admissions (+ admissions 1))
    (when reenter?
      (when (> admissions 2) (error "receiver admission guard missing"))
      (.call refined .seek snapshot #f))
    (element? ordered snapshot))))
  (check-exception (.call refined .range root #f #f) (message? "recursive table observation admission"))
  (check-equal? admissions 1)
  (set! reenter? #f)
  (check (eq? (cdr (some-value (.call refined .seek root #f))) f) => #t))

(test-case "receiver origins invalidate exhausted cursors and admission cannot rewrite captured bounds"
  (def raw (RationalDict Bool)) (def ordered (table-order raw (.@ raw Comparer)))
  (def policy (.o epoch: 0)) (def lower (some 1))
  (def refined (.cc ordered .sources: (list policy) .element?: (lambda (root)
    (some-value-set! lower 99) (element? ordered root))))
  (def root (.call raw .<-list '((1 . #f) (2 . #t))))
  (using ((cursor (.call refined .range<- root lower (some 1)) :- Iterator))
    (check-equal? (cursor.next!) '(1 . #f))
    (check (cursor.next!) => #!eof)
    (.set! policy epoch 1)
    (check-exception (cursor.next!) (message? "stale ordered table receiver")))
  (some-value-set! lower 1)
  (check-equal? (.call refined .range root lower (some 1)) '((1 . #f))))

(test-case "bounded service observation retains one receiver approval and suppresses IO before retry"
  (def signature (Fun Integer <- Integer))
  (def f (validate signature (lambda (n) (+ n 3))))
  (def raw (RationalDict signature)) (def ordered (table-order raw (.@ raw Comparer)))
  (def approved? #f) (def effects 0)
  (def refined (.cc ordered .element?: (lambda (root) (and approved? (element? ordered root)))))
  (def root (.call raw .<-list (list (cons 1 f) (cons 2 f))))
  (def action (service.observe-ledger-range refined (some 1) (some 2)
    (lambda (rows) (for/collect (row rows) ((cdr row) (car row))))
    (lambda (result) (set! effects (+ effects 1)) result)))
  (check-exception (action root) TypeError?)
  (check-equal? effects 0)
  (set! approved? #t)
  (check-equal? (action root) '(4 5))
  (check-equal? effects 1)
  (for (name '(Pure Mutable Linear Posh Classy))
    (def protocol (.ref (table-styles refined) name))
    (def owner (.call protocol .ap root))
    (check-equal? (for/collect (row (.call protocol .range<- owner #f #f)) ((cdr row) 1)) '(4 4))
    (check (eq? (.call protocol .unap owner) root) => #t)))

(test-case "fallback sorting captures all rows before comparison recycles Pair and list shells"
  (def raw (RationalDict Integer))
  (defvalues (source ordered arm recycle) (borrowed-order raw 999 #f))
  (def root (.call raw .<-list '((1 . 10) (2 . 20) (3 . 30))))
  (arm)
  (check-equal? (.call ordered .list<- root) '((1 . 10) (2 . 20) (3 . 30)))
  (check-equal? (.call ordered .range root (some 1) (some 3)) '((1 . 10) (2 . 20) (3 . 30)))
  (check-equal? (for/collect (row (.call ordered .seek<- root (some 2) #t)) row) '((2 . 20) (3 . 30)))
  (check-equal? (.call raw .list<- root) '((1 . 10) (2 . 20) (3 . 30))))

(test-case "positioned and fallback reverse folds capture before callback buffer reuse"
  (for (positioned? '(#f #t))
    (def raw (RationalDict Bool))
    (defvalues (source ordered arm recycle) (borrowed-order raw #t positioned?))
    (def root (.call raw .<-list '((1 . #f) (2 . #f) (3 . #f))))
    (arm)
    (check-equal? (.call ordered .foldr
      (lambda (key value rows) (recycle) (cons (cons key value) rows)) [] root)
      '((1 . #f) (2 . #f) (3 . #f)))
    (check-equal? (.call raw .list<- root) '((1 . #f) (2 . #f) (3 . #f)))))

(test-case "retained ordered cursors preserve checked Functions across later preparation and five styles"
  (def signature (Fun Integer <- Integer))
  (def f (validate signature (lambda (n) (+ n 1))))
  (def g (validate signature (lambda (n) (+ n 2))))
  (defvalues (source ordered arm recycle) (borrowed-order (RationalDict signature) g #f))
  (def root (.call source .<-list (list (cons 1 f) (cons 2 f) (cons 3 f))))
  (arm)
  (for (name '(Pure Mutable Linear Posh Classy))
    (def protocol (.ref (table-styles ordered) name))
    (def owner (.call protocol .ap root))
    (def cursor (.call protocol .iter<- owner))
    ;; A later ordinary query and callback recycle the first producer's cells.
    (.call ordered .range root #f #f) (recycle)
    (def rows (for/collect (row cursor) row))
    (check-equal? (map car rows) '(1 2 3))
    (check (andmap (lambda (row) (eq? (cdr row) f)) rows) => #t)
    (check-exception ((cdar rows) #f) TypeError?)
    (check (eq? (.call protocol .unap owner) root) => #t)
    (def effects 0)
    (def action (service.observe-ledger-range protocol (some 1) (some 3)
      (lambda (entries) (for/collect (entry entries) ((cdr entry) (car entry))))
      (lambda (result) (set! effects (+ effects 1)) result)))
    (check-equal? (action owner) '(2 3 4))
    (check-equal? effects 1)))

(test-case "ordered observation chain suppresses IO on comparison refusal and retries original snapshots"
  (def raw (RationalDict Integer)) (def cause (list 'comparison-refused))
  (def denied? #f) (def effects 0)
  (def ordered (table-order raw (table-comparer (.@ raw Key)
    (lambda (a b) (when denied? (raise cause)) (number-comparer a b)) equal?: =)))
  (def root (.call raw .<-list '((1 . 10) (2 . 20) (3 . 30))))
  ;; One factory owns both the action and reference; another factory is foreign.
  (def protocol (.@ (table-styles ordered) Linear))
  (def action (service.observe-ledger-range protocol (some 1) (some 3)
    (lambda (entries) (for/collect (entry entries) entry))
    (lambda (_) (set! effects (+ effects 1)))))
  (def owner (.call protocol .ap root))
  (set! denied? #t)
  (check (eq? (with-catch identity (lambda () (action owner))) cause) => #t)
  (check-equal? effects 0)
  (check (eq? (.call protocol .unap owner) root) => #t)
  (set! denied? #f)
  (action owner)
  (check-equal? effects 1))
