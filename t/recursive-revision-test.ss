;;; Selective reclosure, shared computed captures and linear old-reference refusal.
(export recursive-revision-test)
(import :std/test ../object ../mop ../number ../object-contract
        (only-in ../type Record)
        (prefix-in ../recursive-validation graph.)
        (prefix-in ../examples/recursive-revision service.)
        (prefix-in ../declarative-metadata metadata.)
        (prefix-in ../examples/contract-publication publication.))

;; Keep the exact typed failure phase instead of swallowing arbitrary exceptions.
(def (phase? kind)
  (lambda (cause) (and (graph.validation-failure? cause)
                      (eq? kind (graph.validation-failure-kind cause)))))

;; Application policy composes with the existing bind-evidence publication gate.
(def Call (metadata.contract (metadata.predicate "object" object?)
  (metadata.predicate "evidence" object?) (lambda (_ _request _result) #t) metadata.truth))

;; Exercise supported revisions, rather than assuming output equality permits reuse.
(def recursive-revision-test
  (test-suite "recursive graph revision"
    (test-case "unchanged revision skips every builder and normalizer"
      (def visits 0) (def normalized 0) (def admitted 0)
      (def counted (.cc Integer .validate: (lambda (value)
        (set! normalized (+ normalized 1)) value)))
      (def base (Record value: [counted]))
      (def checked-type (.cc base .element?: (lambda (value)
        (set! admitted (+ admitted 1)) (.call base .element? value))))
      (def recipe (graph.validation-node 'root [] [] (lambda (_ref _source)
        (set! visits (+ visits 1))
        (list checked-type (.o value: 7)))))
      (def first (graph.revise-validation #f [recipe]))
      (def root (graph.closed-ref first 'root))
      (def second ((graph.revision-action [recipe]) first))
      (check-equal? visits 1)
      (check-equal? normalized 1)
      (check-equal? admitted 2)
      (check-equal? (graph.closed-evaluated second) [])
      (check (eq? root (graph.closed-ref second 'root)) => #t)
      (check-exception (graph.closed-ref first 'root) (phase? 'stale)))
    (test-case "watched edit propagates through sharing SCC and computed readers"
      (def settings (.o delta: 3)) (def recipes (service.recipes settings))
      (def first (graph.revise-validation #f recipes))
      (def idle (graph.closed-ref first 'idle))
      (def idle-type (graph.closed-type first 'idle))
      (def old-report (graph.closed-ref first 'report))
      (def old-type (graph.closed-type first 'report))
      (check-equal? (.get old-report total) 13)
      (.put! settings 'delta 8)
      (check-exception (graph.closed-ref first 'report) (phase? 'stale))
      (def second (graph.revise-validation first recipes))
      (check-equal? (graph.closed-evaluated second) '(shared left right report))
      (check-equal? (graph.closed-reused second) '(idle))
      (check (eq? idle (graph.closed-ref second 'idle)) => #t)
      (check (eq? idle (validate idle-type idle)) => #t)
      (check-equal? (.get (graph.closed-ref second 'report) total) 23)
      (check-exception (validate old-type old-report) (phase? 'stale))
      (check-exception (validate (graph.closed-type second 'report) old-report) (phase? 'reference))
      (def report (graph.closed-ref second 'report))
      (check (eq? (.get report left shared) (.get report right shared)) => #t)
      (check (eq? (.get report left peer-handler) (.get report right handler)) => #t)
      (check-exception ((.get report left peer-handler) #f) TypeError?))
    (test-case "peer replacement retains shared provider and rebuilds complete SCC"
      (def settings (.o delta: 3)) (def recipes (service.recipes settings))
      (def first (graph.revise-validation #f recipes))
      (def shared (graph.closed-ref first 'shared))
      (def shared-type (graph.closed-type first 'shared))
      (def alternatives (service.recipes settings 9))
      (def next (map (lambda (before after) (if (eq? before (cadr recipes)) after before)) recipes alternatives))
      (def second (graph.revise-validation first next))
      (check-equal? (graph.closed-evaluated second) '(left right report))
      (check (eq? shared (graph.closed-ref second 'shared)) => #t)
      (check (eq? shared (validate shared-type shared)) => #t)
      (check-equal? (.get (graph.closed-ref second 'report) total) 20)
      ;; A later edit must revoke a Reference retained from an earlier generation.
      (def third (graph.revise-validation second alternatives))
      (check-exception (validate shared-type shared) (phase? 'stale))
      (check-equal? (.get (graph.closed-ref third 'report) total) 20))
    (test-case "failed final admission leaves prior snapshot and capabilities usable"
      (def settings (.o delta: 3)) (def recipes (service.recipes settings))
      (def first (graph.revise-validation #f recipes))
      (def root (graph.closed-ref first 'report)) (def type (graph.closed-type first 'report))
      (def bad (graph.validation-node 'idle [] [] (lambda (_ref _source)
        (list (.cc (Record value: [Integer]) .element?: (lambda (_) #f)) (.o value: 2)))))
      (check-exception (graph.revise-validation first (append (reverse (cdr (reverse recipes))) [bad]))
                       (phase? 'admission))
      (check (eq? root (graph.closed-ref first 'report)) => #t)
      (check (eq? root (validate type root)) => #t)
      (def second (graph.revise-validation first recipes))
      (check (eq? root (graph.closed-ref second 'report)) => #t))
    (test-case "catalog and declared reads refuse before inconsistent reclosure"
      (def undeclared (graph.validation-node 'root [] [] (lambda (reference _source)
        (list (Record peer: [(reference 'root)]) (.o peer: #f)))))
      (check-exception (graph.revise-validation #f [undeclared]) (phase? 'dependency))
      (def missing (graph.validation-node 'root '(absent) [] (lambda (_ref _source) (error "unreachable"))))
      (check-exception (graph.revise-validation #f [missing]) (phase? 'missing-reference)))
    (test-case "source and descriptor edits seed invalidation without changing recipe"
      (def source (.o value: 1)) (def descriptor (Record value: [Integer]))
      (def visits 0)
      (def recipe (graph.validation-node 'root [] [] (lambda (_ref _source)
        (set! visits (+ visits 1)) (list descriptor source))))
      (def first (graph.revise-validation #f [recipe]))
      (.put! source 'value 2)
      (def second (graph.revise-validation first [recipe]))
      (check-equal? visits 2)
      (check-equal? (.get (graph.closed-ref second 'root) value) 2)
      (.put! descriptor 'sealed #t)
      (def third (graph.revise-validation second [recipe]))
      (check-equal? visits 3)
      (check-equal? (.get (graph.closed-ref third 'root) value) 2))
    (test-case "builder cannot silently restamp an edited clean source"
      (def raw (.o value: 1))
      (def stable (graph.validation-node 'stable [] [] (lambda (_reference _source)
        (list (Record value: [Integer]) raw))))
      (def idle (graph.validation-node 'idle [] [] (lambda (_reference _source)
        (list (Record value: [Integer]) (.o value: 2)))))
      (def first (graph.revise-validation #f [stable idle]))
      (def modifying (graph.validation-node 'idle [] [] (lambda (_reference _source)
        (.put! raw 'value 9)
        (list (Record value: [Integer]) (.o value: 3)))))
      (check-exception (graph.revise-validation first [stable modifying]) (phase? 'stale))
      ;; The callback's source effect is not rolled back. A fresh retry rebuilds it.
      (def second (graph.revise-validation first [stable idle]))
      (check-equal? (.get (graph.closed-ref second 'stable) value) 9))
    (test-case "old same-owner Reference cannot hide inside a rebuilt descriptor"
      (def saved #f)
      (def recipe (graph.validation-node 'root '(root) [] (lambda (reference source)
        (def descriptor (Record peer: [(reference 'root)]))
        (def raw (.o peer: (source 'root)))
        (set! saved (list descriptor raw)) saved)))
      (def first (graph.revise-validation #f [recipe]))
      (def root (graph.closed-ref first 'root))
      (def replacement (graph.validation-node 'root '(root) [] (lambda (_reference _source) saved)))
      (check-exception (graph.revise-validation first [replacement]) (phase? 'reference))
      (check (eq? root (graph.closed-ref first 'root)) => #t))
    (test-case "removed target capability retires while surviving subgraph stays shared"
      (def recipes (service.recipes (.o delta: 3)))
      (def first (graph.revise-validation #f recipes))
      (def idle (graph.closed-ref first 'idle)) (def type (graph.closed-type first 'idle))
      (def root (graph.closed-ref first 'report))
      (def second (graph.revise-validation first (reverse (cdr (reverse recipes)))))
      (check-equal? (graph.closed-evaluated second) [])
      (check (eq? root (graph.closed-ref second 'report)) => #t)
      (check-exception (validate type idle) (phase? 'stale)))
    (test-case "reentrant competing commit refuses the superseded outer candidate"
      (def recipe (graph.validation-node 'root [] [] (lambda (_reference _source)
        (list (Record value: [Integer]) (.o value: 1)))))
      (def first (graph.revise-validation #f [recipe]))
      (def winner #f)
      (def winning (graph.validation-node 'root [] [] (lambda (_reference _source)
        (list (Record value: [Integer]) (.o value: 2)))))
      (def competing (graph.validation-node 'root [] [] (lambda (_reference _source)
        (set! winner (graph.revise-validation first [winning]))
        (list (Record value: [Integer]) (.o value: 3)))))
      (check-exception (graph.revise-validation first [competing]) (phase? 'stale))
      (check-equal? (.get (graph.closed-ref winner 'root) value) 2))
    (test-case "current refinement and evidence accept while stale context refuses"
      (def graph (graph.revise-validation #f (service.recipes (.o delta: 3))))
      (def context-value (.o commits: 0))
      (def candidate (.o report: (graph.closed-ref graph 'report)))
      (defvalues (result state failure) ((service.publish-action graph 13 Call context-value) candidate))
      (check-equal? failure #f)
      (check-equal? (.get result total) 13)
      (check-equal? (.get state commits) 1)
      (def descriptor-value (service.envelope graph 13))
      (def checked (validate descriptor-value candidate))
      (check (eq? (.get checked report) (graph.closed-ref graph 'report)) => #t)
      (def stale-context (.o commits: 0))
      (def stale-action (publication.publication-action descriptor-value Call context-value
        (lambda (subject) (values (.o subject: subject descriptor: descriptor-value context: stale-context)
                                  (.o commits: 1)))))
      (defvalues (_result old-state stale-failure) (stale-action candidate))
      (check (eq? old-state context-value) => #t)
      (check-equal? (metadata.failure-phase stale-failure) 'logic)
      (def other (.o report: (graph.closed-ref graph 'report)))
      (def wrong-action (publication.publication-action descriptor-value Call context-value
        (lambda (_subject) (values (.o subject: other descriptor: descriptor-value context: context-value)
                                   (.o commits: 1)))))
      (defvalues (_wrong wrong-state wrong-failure) (wrong-action candidate))
      (check (eq? wrong-state context-value) => #t)
      (check-equal? (metadata.failure-phase wrong-failure) 'logic))))
