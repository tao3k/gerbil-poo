(export main)
(import :std/iter (only-in "closure-suite.ss" read-study) "closure-cases.ss" "closure-measure.ss")
(def (main path)
  (defvalues (header rows) (read-study path))
  (for* ((runtime '(scheme lean)) (case-index (in-range (length cases))) (scope scopes) (queue queues))
    (def selected (filter (lambda (row) (and (eq? (vector-ref row 0) runtime) (= (vector-ref row 1) case-index)
                                            (vector-ref row 2) (eq? (vector-ref row 3) scope)
                                            (eq? (vector-ref row 5) queue))) rows))
    (def (cost row index)
      (def data (vector-ref row 6))
      (/ (vector-ref (vector-ref data 2) index) (vector-ref data 1)))
    (displayln runtime "/" (list-ref cases case-index) "/" scope "/" queue
      " us=" (* 1e6 (median (map (cut cost <> (if (eq? runtime 'scheme) 0 1)) selected)))
      " bytes=" (if (eq? runtime 'scheme) (median (map (cut cost <> 4) selected)) 'unavailable))))
