;;; Explicit order integrates index publication, inversion and ownership transfer.
(export table-order-test)
(import (only-in ../support/base number-comparer) (only-in :std/list/list-builder with-list-builder) :std/test :std/error :std/iter ../object ../mop ../type ../number ../table ../rationaldict ../support/option
        (only-in ../brace @@method) (only-in ./table-testing alist-table) (only-in ./table-testing box-table) (only-in ../fun Wrapper. IdWrap) (only-in ../trie SimpleTrie Trie. Branch Leaf trie-for-each-change) (prefix-in ../examples/service-collection service.))

;; Keep deliberate protocol refusal separate from arbitrary comparator failures.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; Use one admitted callback identity across publication and inverse recovery.
(def (fixture)
  (defvalues (indexed source comparer key) (service.make-ordered-services))
  (def callback (validate (Fun Integer <- Integer) (lambda (n) (+ n 10))))
  (def base (.call source .<-list (list (cons 1 (vector 10 callback))
    (cons 2 (vector 20 callback)) (cons 3 (vector 30 callback)))))
  (values indexed source comparer key callback base))

 ;; A finite three-key oracle compares presence before Bool payloads, independently
;; of the tree/cursor implementation; all 27 by 27 source pairs are exercised.
(def (bool-comparison a b) (cond ((eq? a b) 0) (a 1) (else -1)))
;; Scan only the known finite test domain, with no descriptor query or merge.
(def (finite-comparison-oracle left right)
  (let/cc return
    (for (key '(0 1 2))
      (let ((a (assoc key left)) (b (assoc key right)))
        (cond ((and a b) (let (rank (bool-comparison (cdr a) (cdr b)))
                          (unless (zero? rank) (return rank))))
              (a (return 1)) (b (return -1))))) 0))

;; A whole lifecycle includes changed order, conflict retry and inverse recovery.
(def table-order-test
  (test-suite "explicit transported table order"
    (test-case "all finite presence and Bool values agree across structural and cursor comparison"
      (def fixtures (for/collect (code (in-range 27))
        (with-list-builder (emit) (for (key (in-range 3))
          (let (digit (modulo (quotient code (expt 3 key)) 3))
            (unless (zero? digit) (emit (cons key (= digit 2)))))))))
      (def trie (SimpleTrie UInt Bool))
      (def raw (RationalDict Bool))
      (for (table (list trie (table-order trie (.@ trie Comparer))
                       (table-order raw (table-comparer (.@ raw Key) number-comparer))))
        (def roots (list->vector (map (cut .call table .<-list <>) fixtures)))
        (def rows (list->vector fixtures))
        (for* ((i (in-range 27)) (j (in-range 27)))
          (check-equal? (.call table .compare bool-comparison (vector-ref roots i) (vector-ref roots j))
            (finite-comparison-oracle (vector-ref rows i) (vector-ref rows j))))))
    (test-case "complete admission and strict comparison precede identical and empty shortcuts"
      (for (base (list (SimpleTrie UInt Integer)
                      (let (raw (RationalDict Integer))
                        (table-order raw (table-comparer (.@ raw Key) number-comparer)))))
        (def root (.call base .<-list '((1 . 10) (2 . 20))))
        (def denied (.cc base .element?: (lambda (_) #f)))
        (def calls 0)
        (check-exception (.call denied .compare (lambda _ (set! calls (+ calls 1)) 0) root root) TypeError?)
        (check-equal? calls 0)
        (check-exception (.call base .compare #f (.@ base .empty) (.@ base .empty)) ContractViolation?)
        (for (bad '(#t #f 1.0 1/2 "sign"))
          (check-exception (.call base .compare (lambda _ bad) root root) ContractViolation?))
        (check-equal? (.call base .compare (lambda _ (expt 2 100)) root root) (expt 2 100))
        (check-equal? (.call base .compare number-comparer (.@ base .empty) root) -1)
        (check-equal? (.call base .compare number-comparer root (.@ base .empty)) 1)
        (def cause (with-catch identity (lambda () (error "original comparison cause"))))
        (check (eq? (with-catch identity (lambda () (.call base .compare (lambda _ (raise cause)) root root))) cause) => #t))
      (def plain (alist-table UInt Integer))
      (check-exception (.call plain .compare number-comparer (.@ plain .empty) (.@ plain .empty))
        (message? "unsupported table comparison")))
    (test-case "partial refinements and absence decisions need no fabricated merged root"
      (def base (SimpleTrie UInt Integer))
      (def refined (.cc base .element?: (lambda (root)
        (and (element? base root) (= (.call base .count root) 2)))))
      (def a (.call base .<-list '((1 . 10) (3 . 30))))
      (def b (.call base .<-list '((2 . 20) (4 . 40))))
      (check-equal? (.call refined .compare (lambda _ (error "values never share a key")) a b) 1)
      (check-equal? (.call refined .compare number-comparer b a) -1)
      (check-equal? (.call refined .compare number-comparer a a) 0))
    (test-case "cursor comparison stops at its first decision and captures shared Pair shells"
      (def raw (SimpleTrie UInt Integer))
      (def ordered (table-order raw (.@ raw Comparer)))
      (def pulls 0)
      (def counted (.cc ordered
        .iter<-: (lambda (root) (iterator-map identity (.call ordered .iter<- root)
          (lambda (pull) (set! pulls (+ pulls 1)) (pull))))
        .list<-: (lambda _ (error "unexpected comparison materialization"))))
      (def a (.call raw .<-list '((0 . 10) (1 . 20) (2 . 30))))
      (def b (.call raw .<-list '((0 . 11) (1 . 20) (2 . 30))))
      (check-equal? (.call counted .compare number-comparer a b) -1)
      (check-equal? pulls 2)
      (let (before pulls)
        (check-equal? (.call counted .compare number-comparer a a) 0)
        (check-equal? (- pulls before) 8))
      (def shell (cons 0 0))
      (def shared (.cc ordered .iter<-: (lambda (root)
        (in-coroutine (lambda (yield) (for (row (.call raw .list<- root))
          (set-car! shell (car row)) (set-cdr! shell (cdr row)) (yield shell)))))))
      (check-equal? (.call shared .compare number-comparer a b) -1))
    (test-case "transported and reverse declared orders retain their own presence convention"
      (def raw (RationalDict Integer))
      (def forward (table-order raw (table-comparer (.@ raw Key) number-comparer)))
      (def reverse-order (table-order raw
        (table-comparer (.@ raw Key) (lambda (a b) (- (number-comparer a b))))))
      (def a (.call raw .<-list '((1 . 10) (2 . 20))))
      (def b (.call raw .<-list '((1 . 10) (3 . 30))))
      (defvalues (boxed _carrier _keys) (box-table forward))
      (check-equal? (.call forward .compare number-comparer a b) 1)
      (check-equal? (.call reverse-order .compare number-comparer a b) -1)
      (check-equal? (.call boxed .compare number-comparer (.call boxed .wrap a) (.call boxed .wrap b)) 1))
    (test-case "five presentations and receivers compare two snapshots without consuming owners"
      (for* ((set? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def raw (SimpleTrie UInt (if set? Unit Integer)))
        (def table (table-order raw (.@ raw Comparer)))
        (def descriptor (if set? (.cc Set<-Table. Table: table) table))
        (def protocol (.ref ((if set? set-styles table-styles) descriptor) name))
        (def a (.call descriptor .<-list (if set? '(0 2) '((0 . 10) (2 . 30)))))
        (def b (.call descriptor .<-list (if set? '(0 1) '((0 . 10) (1 . 20)))))
        (def left (.call protocol .ap a)) (def right (.call protocol .ap b))
        (check-equal? (if set? (.call protocol .compare left right)
          (.call protocol .compare number-comparer left right)) -1)
        (when (memq name '(Posh Classy))
          (check-equal? (if set? (@@method left.compare right)
            (@@method left.compare number-comparer right)) -1))
        (check (eq? (.call protocol .unap left) a) => #t)
        (check (eq? (.call protocol .unap right) b) => #t)
        (when (eq? name 'Linear)
          (.call protocol .step left identity)
          (check-exception (if set? (.call protocol .compare left right)
            (.call protocol .compare number-comparer left right)) true))))
    (test-case "comparison retains captured snapshots and rejects revised order before fresh retry"
      (def raw (SimpleTrie UInt Integer))
      (def comparer (table-comparer UInt number-comparer))
      (def table (table-order raw comparer))
      (def protocol (.@ (table-styles table) Mutable))
      (def a (.call raw .singleton 1 10)) (def b (.call raw .singleton 1 20))
      (def left (.call protocol .ap a)) (def right (.call protocol .ap b))
      (check-equal? (.call protocol .compare (lambda (x y)
        (.call protocol .acons 9 90 left) (number-comparer x y)) left right) -1)
      (check-equal? (.call protocol .count left) 2)
      (check-equal? (.call protocol .count right) 1)
      (check-exception (.call protocol .compare (lambda _ (.set! comparer sexp 'blocked) 0) left right) true)
      (.set! comparer sexp 'revised)
      (check-exception (.call protocol .compare number-comparer left right) true)
      (let (fresh (table-order raw (table-comparer UInt number-comparer)))
        (check-equal? (.call fresh .compare number-comparer a b) -1)))
    (test-case "indexed Function ledgers compare by explicit values through Reader FUN IO"
      (defvalues (indexed source _comparer _keys) (service.make-ordered-services))
      (def table (table-order indexed (table-comparer (.@ source Key) number-comparer)))
      (def signature (Fun Integer <- Integer))
      (def f (validate signature (lambda (n) (+ n 1))))
      (def g (validate signature (lambda (n) (+ n 2))))
      (def a (.call indexed .<-list (list (cons 1 (vector 10 f)) (cons 2 (vector 20 f)))))
      (def b (.call indexed .<-list (list (cons 1 (vector 10 g)) (cons 2 (vector 30 f)) (cons 3 (vector 40 g)))))
      (def effects 0)
      (def action (service.compare-ledger-action table
        (lambda (x y) (- (vector-ref x 0) (vector-ref y 0)))
        (lambda (rank) (set! effects (+ effects 1)) rank)))
      (check-equal? (action (cons a b)) -10)
      (check-equal? effects 1)
      (check (eq? (vector-ref (.call indexed .ref a 1) 1) f) => #t)
      (check (eq? (vector-ref (.call indexed .ref b 1) 1) g) => #t)
      (let ((before effects) (bad (service.compare-ledger-action table (lambda _ 'bad)
        (lambda (_) (set! effects (+ effects 1))))))
        (check-exception (bad (cons a b)) ContractViolation?)
        (check-equal? effects before))
      (check-equal? (action (cons a b)) -10))
    (test-case "named index iterators seek and ranges share the eager index observations"
      (defvalues (indexed source) (service.make-ordered-service-indexes))
      (def f (validate (Fun Integer <- Integer) (lambda (n) (+ n 7))))
      (def base (.call source .<-list (list (cons 1 (vector 10 100 f))
        (cons 2 (vector 20 100 f)) (cons 3 (vector 30 200 f)))))
      (def state (.call indexed .wrap base))
      (check-equal? (for/collect (entry (.call indexed .index-iter<- state 'priority)) entry)
        '((10 . 1) (20 . 2) (30 . 3)))
      (check-equal? (for/collect (entry (.call indexed .index-seek<- state 'priority (some 10) #f)) entry)
        '((20 . 2) (30 . 3)))
      (for* ((lo (list #f (some 10) (some 20))) (hi (list #f (some 30)))
             (li '(#f #t)) (ui '(#f #t)))
        (check-equal? (for/collect (entry (.call indexed .index-range<- state 'priority lo hi li ui)) entry)
          (.call indexed .index-range state 'priority lo hi li ui)))
      (check-equal? (.call indexed .index-fold state 'priority (lambda (_ owner acc) (+ owner acc)) 0) 6)
      (using ((cursor (.call indexed .index-range<- state 'team (some 100) (some 100)) :- Iterator))
        (def bucket (cdr (cursor.next!)))
        (check (eq? (vector-ref (.call source .ref bucket 1) 2) f) => #t)
        (check-equal? (.call source .count bucket) 2)
        (check (cursor.next!) => #!eof)))
    (test-case "index cursors retain old snapshots through atomic swaps and shared bucket migration"
      (defvalues (indexed source) (service.make-ordered-service-indexes))
      (def f (validate (Fun Integer <- Integer) (lambda (n) n)))
      (def base (.call source .<-list (list (cons 1 (vector 10 100 f)) (cons 2 (vector 20 100 f)))))
      (def state (.call indexed .wrap base))
      (def cursor (.call indexed .index-range<- state 'priority #f #f))
      (def final (.call source .<-list (list (cons 1 (vector 20 100 f)) (cons 2 (vector 10 200 f)))))
      (def delta (.call source .diff base final))
      (def next (.call indexed .apply-delta state delta))
      (check-equal? (for/collect (entry cursor) entry) '((10 . 1) (20 . 2)))
      (check-equal? (for/collect (entry (.call indexed .index-range<- next 'priority #f #f)) entry)
        '((10 . 2) (20 . 1)))
      (check-equal? (for/collect (entry (.call indexed .index-iter<- next 'team))
        (cons (car entry) (.call source .count (cdr entry)))) '((100 . 1) (200 . 1)))
      (def restored (.call indexed .apply-delta next (invert-table-delta delta)))
      (check-equal? (for/collect (entry (.call indexed .index-iter<- restored 'priority)) entry)
        '((10 . 1) (20 . 2)))
      (check-exception (.call indexed .apply-delta next delta) table-conflict?))
    (test-case "sibling declaration changes refuse partial and exhausted named cursors"
      (for (phase '(partial exhausted))
        (defvalues (indexed source declarations) (service.make-tagged-services))
        (def f (validate (Fun Integer <- Integer) (lambda (n) n)))
        (def state (.call indexed .wrap (.call source .<-list
          (list (cons 1 (vector '(10 20) '(100 200) f))))))
        (using ((cursor (.call indexed .index-range<- state 'teams #f #f) :- Iterator))
          (check-equal? (car (cursor.next!)) 100)
          (when (eq? phase 'exhausted)
            (check-equal? (car (cursor.next!)) 200) (check (cursor.next!) => #!eof))
          (.set! (car declarations) sexp 'changed-sibling)
          (check-exception (cursor.next!) Error?))))
    (test-case "every style and receiver forwards named observations without consuming owners"
      (defvalues (indexed source) (service.make-ordered-service-indexes))
      (def f (validate (Fun Integer <- Integer) (lambda (n) n)))
      (def root (.call indexed .wrap (.call source .<-list
        (list (cons 1 (vector 10 100 f)) (cons 2 (vector 20 200 f))))))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles indexed) name)) (def owner (.call protocol .ap root))
        (check-equal? (for/collect (entry (.call protocol .index-range<- owner 'priority #f #f)) entry)
          '((10 . 1) (20 . 2)))
        (check-equal? (.call protocol .index-fold owner 'priority (lambda (_ value acc) (+ value acc)) 0) 3)
        (check-equal? (.call indexed .count (.call protocol .unap owner)) 2)
        (when (memq name '(Posh Classy))
          (check-equal? (for/collect (entry {index-seek<- owner 'priority (some 20)}) entry) '((20 . 2)))
          (check-equal? (for/collect (entry {index-iter<- owner 'priority}) entry) '((10 . 1) (20 . 2)))
          (check-equal? {index-fold owner 'priority (lambda (_ value acc) (+ value acc)) 0} 3))))
    (test-case "named queries reject unknown names unordered capabilities and foreign caches"
      (defvalues (indexed source declarations) (service.make-indexed-services))
      (def f (validate (Fun Integer <- Integer) (lambda (n) n)))
      (def state (.call indexed .wrap (.call source .<-list (list (cons 1 (vector 10 20 100 f))))))
      (check-equal? (for/collect (entry (.call indexed .index-iter<- state 'badge)) entry) '((10 . 1)))
      (check-exception (.call indexed .index-range<- state 'badge #f #f) Error?)
      (check-exception (.call indexed .index-iter<- state 'missing) (message? "unknown table index"))
      (check-exception (.call indexed .index-fold state 'badge 'bad 0) ContractViolation?)
      (def other (table-indexes source declarations))
      (check-exception (.call other .index-iter<- state 'badge) (message? "incompatible indexed table")))
    (test-case "named group inspection reuses bounded FUN IO and retains checked callbacks"
      (defvalues (indexed source) (service.make-ordered-service-indexes))
      (def f (validate (Fun Integer <- Integer) (lambda (n) (+ n 7))))
      (def protocol (.@ (table-styles indexed) Linear))
      (def owner (.call protocol .ap (.call indexed .wrap (.call source .<-list
        (list (cons 1 (vector 10 100 f)) (cons 2 (vector 20 100 f)) (cons 3 (vector 30 200 f)))))))
      (def effects 0)
      (def action (service.observe-indexed-range protocol 'team (some 100) (some 100)
        (lambda (rows) (for/fold (total 0) (entry rows)
          (.call source .foldl (lambda (_ row acc) (+ acc ((vector-ref row 2) 3))) total (cdr entry))))
        (lambda (result) (set! effects (+ effects 1)) result)))
      (check-equal? (action owner) 20) (check-equal? effects 1)
      (check-exception ((service.observe-indexed-range protocol 'team #f #f
        (lambda (rows) (for/collect (entry rows)
          (.call source .foldl (lambda (_ row acc) ((vector-ref row 2) 'bad)) 0 (cdr entry))))
        (lambda (_) (set! effects (+ effects 1)))) owner) TypeError?)
      (check-equal? effects 1))
    (test-case "lazy bounded cursor pulls on demand and EOF never resumes the backend"
      (def backend (SimpleTrie UInt Integer)) (def pulls 0)
      (def source (.cc backend .seek<-: (lambda (root lower inclusive?)
        (def cursor (.call backend .seek<- root lower inclusive?))
        (in-coroutine (lambda (yield)
          (for (row cursor) (set! pulls (+ pulls 1)) (yield row)))))))
      (def ordered (table-order source (.@ source Comparer)))
      (def root (.call source .<-list '((1 . 10) (2 . 20) (3 . 30) (4 . 40))))
      (using ((cursor (.call ordered .range<- root (some 1) (some 2)) :- Iterator))
        (check-equal? pulls 0)
        (check-equal? (cursor.next!) '(1 . 10)) (check-equal? pulls 1)
        (check-equal? (cursor.next!) '(2 . 20)) (check-equal? pulls 2)
        (check (cursor.next!) => #!eof) (check-equal? pulls 3)
        (check (cursor.next!) => #!eof) (check-equal? pulls 3)
        (.set! source sexp 'changed)
        (check-exception (cursor.next!) Error?) (check-equal? pulls 3)))
    (test-case "lazy ranges match materialized bounds across seek and sorted fallback"
      (for (source (list (SimpleTrie UInt Integer) (RationalDict Integer)))
        (def ordered (table-order source (if (.has? source Comparer) (.@ source Comparer)
          (table-comparer (.@ source Key) number-comparer))))
        (def root (.call source .<-list '((0 . 0) (1 . 10) (2 . 20) (3 . 30))))
        (for* ((lo (list #f (some 0) (some 1) (some 3)))
               (hi (list #f (some 3))) (li '(#f #t)) (ui '(#f #t)))
          (check-equal? (for/collect (entry (.call ordered .range<- root lo hi li ui)) entry)
            (.call ordered .range root lo hi li ui)))
        (check-exception (.call ordered .range<- root (some 3) (some 1)) (message? "reversed table range"))
        (check-exception (.call ordered .range<- root 'bad #f) (message? "table range bound must be Option"))
        (check-exception (.call ordered .range<- root #f #f 'bad) ContractViolation?)))
    (test-case "range bounds own Option shells and callback failure does not invalidate retry"
      (def backend (SimpleTrie UInt Integer)) (def fail? #f) (def cause (list 'comparison-refusal))
      (def comparer (table-comparer UInt (lambda (a b) (if fail? (raise cause) (number-comparer a b)))))
      (def ordered (table-order backend comparer))
      (def root (.call backend .<-list '((1 . 10) (2 . 20) (3 . 30))))
      (def lo (some 1)) (def hi (some 2))
      (using ((cursor (.call ordered .range<- root lo hi) :- Iterator))
        (some-value-set! lo 3) (some-value-set! hi 3)
        (check-equal? (cursor.next!) '(1 . 10))
        (check-equal? (cursor.next!) '(2 . 20)) (check (cursor.next!) => #!eof))
      (def cursor (.call ordered .range<- root (some 1) (some 2)))
      (set! fail? #t)
      (using ((cursor :- Iterator)) (check-exception (cursor.next!) (cut eq? <> cause)))
      (set! fail? #f)
      (check-equal? (for/collect (entry (.call ordered .range<- root (some 1) (some 2))) entry)
        '((1 . 10) (2 . 20))))
    (test-case "all table and Set styles retain snapshot ranges without consuming ownership"
      (def backend (SimpleTrie UInt Integer)) (def ordered (table-order backend (.@ backend Comparer)))
      (def root (.call backend .<-list '((1 . 10) (2 . 20) (3 . 30))))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles ordered) name)) (def owner (.call protocol .ap root))
        (def cursor (.call protocol .range<- owner (some 1) (some 2)))
        (def next (.call protocol .acons 2 200 owner))
        (check-equal? (for/collect (entry cursor) entry) '((1 . 10) (2 . 20)))
        (check-equal? (.call ordered .ref (.call protocol .unap next) 2) 200)
        (when (memq name '(Posh Classy))
          (check-equal? (for/collect (entry {range<- next (some 2) (some 2)}) entry) '((2 . 200)))))
      (def set (.cc Set<-Table. Table: (table-order (SimpleTrie UInt Unit) (.@ backend Comparer))))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (set-styles set) name)) (def owner (.call protocol .ap (.call set .<-list '(1 2 3))))
        (check-equal? (for/collect (entry (.call protocol .range<- owner (some 1) (some 2))) entry) '(1 2))
        (check-equal? (.call set .list<- (.call protocol .unap owner)) '(1 2 3))))
    (test-case "nested transported order ranges retain Function identities and origin guards"
      (def signature (Fun Integer <- Integer)) (def f (validate signature (lambda (n) (+ n 7))))
      (def source (SimpleTrie UInt signature))
      (def first (table-order source (.@ source Comparer))) (def outer (table-order first (.@ first Comparer)))
      (def root (.call source .<-list (list (cons 1 f) (cons 2 f) (cons 3 f))))
      (using ((cursor (.call outer .range<- root (some 2) (some 2)) :- Iterator))
        (check (eq? (cdr (cursor.next!)) f) => #t)
        (check (cursor.next!) => #!eof)
        (.set! first sexp 'changed)
        (check-exception (cursor.next!) Error?)))
    (test-case "bounded service inspection composes with Reader FUN IO and suppresses effects on refusal"
      (def signature (Fun Integer <- Integer)) (def f (validate signature (lambda (n) (+ n 7))))
      (def source (SimpleTrie UInt signature)) (def ordered (table-order source (.@ source Comparer)))
      (def protocol (.@ (table-styles ordered) Linear))
      (def owner (.call protocol .ap (.call source .<-list (list (cons 1 f) (cons 2 f) (cons 3 f)))))
      (def effects 0)
      (def action (service.observe-ledger-range protocol (some 1) (some 2)
        (lambda (rows) (for/collect (entry rows) ((cdr entry) 3)))
        (lambda (result) (set! effects (+ effects 1)) result)))
      (check-equal? (action owner) '(10 10)) (check-equal? effects 1)
      (check-exception ((service.observe-ledger-range protocol (some 1) (some 2)
        (lambda (rows) (for/collect (entry rows) ((cdr entry) 'bad)))
        (lambda (_) (set! effects (+ effects 1)))) owner) TypeError?)
      (check-equal? effects 1)
      (check (eq? (.call source .ref (.call protocol .unap owner) 1) f) => #t))
    (test-case "transported order controls traversal and all range boundaries"
      (def source (RationalDict Integer))
      (def comparer (table-comparer (.@ source Key) number-comparer))
      (def key (.cc Wrapper. Domain: (.@ source Key) Codomain: (.@ source Key) .ap: - .unap: -))
      (def ordered (table-order source (table-comparer-wrapper comparer key)))
      (def base (.call source .<-list '((-30 . 3) (-10 . 1) (-20 . 2))))
      (check-equal? (map car (.call ordered .list<- base)) '(-10 -20 -30))
      (check-equal? (map car (.call ordered .range base (some -10) (some -30))) '(-10 -20 -30))
      (check-equal? (.call ordered .range base (some -10) (some -30) #f #f) '((-20 . 2)))
      (check-equal? (.call ordered .range base (some -20) (some -20) #f) [])
      (check-equal? (map car (.call ordered .range base #f (some -20))) '(-10 -20))
      (check-equal? (map car (.call ordered .range base (some -20) #f)) '(-20 -30))
      (check-exception (.call ordered .range base (some -30) (some -10)) (message? "reversed table range"))
      (check-exception (.call ordered .range base (some "bad") #f) TypeError?)
      (check-exception (.call ordered .range base 'bad #f) (message? "table range bound must be Option")))
    (test-case "indexed revisions retain wrapping and all styles recover after refusal"
      (defvalues (indexed source _comparer _key callback base) (fixture))
      (def original (.call indexed .wrap base))
      (def after (.call source .acons 1 (vector 40 callback) base))
      (def delta (.call source .diff base after))
      (def conflict (.call source .diff base (.call source .acons 1 (vector 20 callback) base)))
      (def styles (table-styles indexed))
      (for-each (lambda (name)
        (def style (.ref styles name))
        (def state (.call style .ap original))
        (check-exception (.call style .apply-delta state conflict) table-index-conflict?)
        (check (eq? (.call style .unap state) original) => #t)
        (def next (.call style .apply-delta state delta))
        (def pure (.call style .convert next 'pure))
        (check-equal? (.call indexed .index-range pure 'priority #f #f) '((-20 . 2) (-30 . 3) (-40 . 1)))
        (check (eq? (vector-ref (.call indexed .ref pure 1) 1) callback) => #t)
        (check-exception (callback "bad") TypeError?)
        (def restored (.call indexed .apply-delta pure (invert-table-delta delta)))
        (check-equal? (.call indexed .index-range restored 'priority #f #f) '((-10 . 1) (-20 . 2) (-30 . 3)))
        (check-equal? (.call indexed .index-range
          (.call indexed .apply-delta restored delta) 'priority (some -30) #f) '((-30 . 3) (-40 . 1))))
        '(Pure Mutable Linear)))
    (test-case "stale comparers invalidate retained index snapshots and ordering views"
      (defvalues (indexed source comparer _key _callback base) (fixture))
      (def state (.call indexed .wrap base))
      (.set! comparer sexp 'changed)
      (check-exception (.call indexed .index-range state 'priority #f #f) Error?))
    (test-case "ordered grouped buckets and unordered index refusal preserve primary rows"
      (def source (RationalDict Integer))
      (def backend (RationalDict source))
      (def ordered (table-order backend (table-comparer (.@ backend Key) number-comparer)))
      (def declaration (.cc Type. name: 'group table: ordered unique?: #f
        project: (lambda (_ row) (modulo row 3))))
      (def indexed (table-indexes source (list declaration)))
      (def base (.call source .<-list '((1 . 4) (2 . 5) (3 . 7))))
      (def state (.call indexed .wrap base))
      (def groups (.call indexed .index-range state 'group (some 1) #f))
      (check-equal? (map car groups) '(1 2))
      (check-equal? (map (lambda (entry) (.call source .list<- (cdr entry))) groups)
        '(((1 . 4) (3 . 7)) ((2 . 5))))
      (def plain (table-indexes source (list (.cc declaration table: backend))))
      (check-exception (.call plain .index-range (.call plain .wrap base) 'group #f #f)
        (message? "unordered table index"))
      (check-exception (.call indexed .index-range state 'unknown #f #f)
        (message? "unknown table index")))
    (test-case "all point and derived operations reject stale ordering origins"
      (def source (RationalDict Integer))
      (def comparer (table-comparer (.@ source Key) number-comparer))
      (def ordered (table-order source comparer))
      (def base (.call ordered .<-list '((1 . 10) (2 . 20))))
      (def delta (.call ordered .diff base (.call ordered .acons 3 30 base)))
      (.set! comparer sexp 'changed)
      (check-exception (.call ordered .range base #f #f) Error?)
      (check-exception (.call ordered .ref base 1) Error?)
      (check-exception (.call ordered .acons 3 30 base) Error?)
      (check-exception (.call ordered .apply-delta base delta) Error?))
    (test-case "positioned Trie ranges match the sorting oracle across sparse and huge keys"
      (def source (SimpleTrie UInt Integer))
      (def fast (table-order source (.@ source Comparer)))
      (def reference (table-order source (table-comparer UInt (lambda (a b) (number-comparer a b)))))
      (def huge (arithmetic-shift 1 80))
      (def keys (append '(0 1 3 8 17 31 32 63 128) (list huge (+ huge 3))))
      (def base (.call source .<-list (map (lambda (k) (cons k k)) keys)))
      (def lowers (cons #f (map (lambda (key) (some key)) (append keys '(2 7 16 30 129) (list (+ huge 1) (+ huge 4))))))
      (for* ((lower lowers) (inclusive? '(#t #f)))
        (check-equal? (.call fast .range base lower #f inclusive?)
          (.call reference .range base lower #f inclusive?))
        (def rows (.call reference .range base lower #f inclusive?))
        (check-equal? (.call fast .seek base lower inclusive?) (if (null? rows) #f (some (car rows)))))
      (for* ((lower '(0 1 2 17 63)) (upper '(63 128)) (open-lower? '(#t #f)) (open-upper? '(#t #f)))
        (check-equal? (.call fast .range base (some lower) (some upper) open-lower? open-upper?)
          (.call reference .range base (some lower) (some upper) open-lower? open-upper?))))
    (test-case "a narrow high range visits the seek spine rather than the entire snapshot"
      (def visits 0)
      (def source (.cc (.mix Trie. IdWrap) Key: UInt Value: Integer
        .unwrap: (lambda (tree) (set! visits (+ visits 1)) tree)))
      (def ordered (table-order source (.@ source Comparer)))
      (def base (.call source .<-list (for/collect (n (in-range 2048)) (cons n n))))
      (.call ordered .validate-shape base)
      (set! visits 0)
      (check-equal? (.call ordered .range base (some 1800) (some 1803))
        '((1800 . 1800) (1801 . 1801) (1802 . 1802) (1803 . 1803)))
      (check (< visits 80) => #t)
      (check (> visits 0) => #t)
      (let (positioned visits)
      (def reference (table-order source (table-comparer UInt (lambda (a b) (number-comparer a b)))))
      (.call reference .validate-shape base)
      (set! visits 0)
      (check-equal? (.call reference .range base (some 1800) (some 1803))
        '((1800 . 1800) (1801 . 1801) (1802 . 1802) (1803 . 1803)))
      (check (> visits 2048) => #t)
      (displayln "TABLE-SEEK-WORK rows=2048 hits=4 positioned=" positioned " reference=" visits)))
    (test-case "cold index chains reuse only declared persistent output shapes"
      ;; Count complete preparation for identical backends with/without the law.
      (def (work preserves?)
        (def visits 0)
        (def source (SimpleTrie UInt UInt))
        (def backend (.cc (.mix Trie. IdWrap) Key: UInt Value: UInt
          .shape-preserving?: preserves?
          .unwrap: (lambda (tree) (set! visits (+ visits 1)) tree)))
        (def ordered (table-order backend (.@ backend Comparer)))
        (def declaration (.cc Type. name: 'value table: ordered unique?: #t
          project: (lambda (_ row) row)))
        (def indexed (table-indexes source (list declaration)))
        (def base (.call source .<-list (for/collect (n (in-range 256)) (cons n n))))
        (set! visits 0)
        (let (state (.call indexed .wrap base))
          (let (cold visits)
            (check-equal? (.call indexed .index-range state 'value (some 252) (some 255))
              '((252 . 252) (253 . 253) (254 . 254) (255 . 255)))
            (check-exception (.call ordered .acons -1 1 (.@ ordered .empty)) TypeError?)
            cold)))
      (let ((reference (work #f)) (reused (work #t)))
        (check (< (* reused 5) reference) => #t)
        (displayln "TABLE-COLD-WORK rows=256 reused=" reused " reference=" reference)))
    (test-case "failed updates cannot approve arbitrary roots or bypass stale metadata"
      (def failure (list 'update-refused))
      (def fail? #t)
      (def raw (SimpleTrie UInt Integer))
      (def source (.cc raw .acons: (lambda (k v t)
        (when fail? (raise failure)) (.call raw .acons k v t))))
      (def ordered (table-order source (.@ source Comparer)))
      (check-exception (.call ordered .acons 1 10 (.@ source .empty)) (cut eq? <> failure))
      (set! fail? #f)
      (let (next (.call ordered .acons 1 10 (.@ source .empty)))
        (check-equal? (.call ordered .range next #f #f) '((1 . 10)))
        (check-exception (.call ordered .acons 2 20 (Branch 1 (Leaf 10) (Leaf 20))) TypeError?)
        (check-equal? (.call ordered .range (.call ordered .remove next 1) #f #f) [])
        (.set! source .shape-preserving? #f)
        (check-exception (.call ordered .range next #f #f) (message? "stale table order"))))
    (test-case "cold multi-index services retain Functions through conflict retry and inverse"
      (defvalues (indexed source) (service.make-ordered-service-indexes))
      (def callback (validate (Fun Integer <- Integer) (lambda (n) (+ n 1))))
      (def base (.call source .<-list (for/collect (n (in-range 64))
        (cons n (vector n (modulo n 4) callback)))))
      (def original (.call indexed .wrap base))
      (def linear (.@ (table-styles indexed) Linear))
      (def owned (.call linear .ap original))
      (def conflict (.call source .diff base (.call source .acons 0 (vector 1 0 callback) base)))
      (check-exception (.call linear .apply-delta owned conflict) table-index-conflict?)
      (check (eq? (.call linear .unap owned) original) => #t)
      (def after (.call source .acons 1 (vector 0 2 callback)
        (.call source .acons 0 (vector 1 2 callback) base)))
      (def delta (.call source .diff base after))
      (def next (.call linear .convert (.call linear .apply-delta owned delta) 'pure))
      (check-equal? (.call indexed .index-range next 'priority (some 0) (some 1)) '((0 . 1) (1 . 0)))
      (def bucket (some-value (.call indexed .index-ref/opt next 'team 2)))
      (check (eq? (vector-ref (.call source .ref bucket 0) 2) callback) => #t)
      (check-exception (callback "bad") TypeError?)
      (def restored (.call indexed .apply-delta next (invert-table-delta delta)))
      (check-equal? (.call indexed .index-range restored 'priority (some 0) (some 1)) '((0 . 0) (1 . 1)))
      (check (eq? (vector-ref (.call indexed .ref restored 0) 2) callback) => #t))
    (test-case "persistent point closure preserves sparse huge-key shapes across removals"
      (def source (SimpleTrie UInt Integer))
      (def ordered (table-order source (.@ source Comparer)))
      (def huge (arithmetic-shift 1 80))
      (def keys (list 0 huge 31 1 (+ huge 3) 63 32 8 128 huge))
      (def state (.@ ordered .empty))
      (for (key keys)
        (set! state (.call ordered .acons key key state))
        ;; Independently check every cached output with the raw backend recognizer.
        (.call source .validate-shape state)
        (check-equal? (.call ordered .list<- state) (.call source .list<- state)))
      (for (key (append (reverse keys) (list (+ huge 999))))
        (set! state (.call ordered .remove state key))
        (.call source .validate-shape state)
        (check-equal? (.call ordered .list<- state) (.call source .list<- state)))
      (check-equal? (.call ordered .list<- state) []))
    (test-case "shared delta traversal matches ordered generic callbacks across topology changes"
      (def source (SimpleTrie UInt Integer))
      (def huge (arithmetic-shift 1 80))
      (def shapes '(() ((0 . 0)) ((8 . 80)) ((10 . 100)) ((8 . 80) (9 . 90))
        ((10 . 100) (12 . 120)) ((1 . 10) (8 . 80) (30 . 300))
        ((8 . 81) (9 . 90) (32 . 320))))
      ;; Reuse the same independent generic oracle for every sparse/huge pair.
      (def (events specialized? before after)
        (with-list-builder (emit)
          ((if specialized? (.@ source .for-each-change) (cut table-for-each-change source <> <> <>))
            (lambda (key old next) (emit (list key old next))) before after)))
      (for* ((offset (list 0 huge)) (left shapes) (right shapes))
        (def before (.call source .<-list (map (lambda (row) (cons (+ offset (car row)) (cdr row))) left)))
        (def after (.call source .<-list (map (lambda (row) (cons (+ offset (car row)) (cdr row))) right)))
        (check-equal? (events #t before after) (events #f before after))
        (check-equal? (.call source .list<- (.call source .apply-delta before (.call source .diff before after)))
          (.call source .list<- after))))
    (test-case "shared discovery preserves full admission and distinguishes missing from false"
      (def checked 0) (def traversals 0)
      (def value (.cc UInt .element?: (lambda (row) (set! checked (+ checked 1)) (element? UInt row))))
      (def raw (SimpleTrie UInt value))
      (def source (.cc raw .for-each-change: (lambda (emit a b)
        (set! traversals (+ traversals 1)) (trie-for-each-change raw emit a b))))
      (def base (.call source .<-list '((0 . 1) (8 . 2) (20 . 3))))
      (set! checked 0)
      (check-equal? (table-delta-count (.call source .diff base base)) 0)
      (check-equal? checked 6)
      (def bad (.call source .acons 8 -1 base))
      (set! traversals 0)
      (check-exception (.call source .diff bad bad) TypeError?)
      (check-equal? traversals 0)
      (def booleans (SimpleTrie UInt Bool))
      (def before (.call booleans .<-list '((8 . #f) (20 . #t))))
      (def after (.call booleans .<-list '((0 . #f) (8 . #f))))
      (def delta (.call booleans .diff before after))
      (check-equal? (table-delta-count delta) 2)
      (check-equal? (.call booleans .ref/opt (.call booleans .apply-delta before delta) 0) (some #f))
      (check-equal? (.call booleans .list<- (.call booleans .apply-delta after (invert-table-delta delta)))
        (.call booleans .list<- before))
      (def seen []) (def failure (list 'consumer-refused))
      (check-exception (.call booleans .for-each-change
        (lambda (key _old _next) (set! seen (cons key seen)) (raise failure)) before after) (cut eq? <> failure))
      (check-equal? seen '(20)))
    (test-case "shared delta work skips unchanged subtrees after independent admission"
      (def visits 0)
      (def source (.cc (.mix Trie. IdWrap) Key: UInt Value: Integer
        .unwrap: (lambda (tree) (set! visits (+ visits 1)) tree)))
      (def before (.call source .<-list (for/collect (n (in-range 2048)) (cons n n))))
      (def after (.call source .acons 1800 -1 before))
      (.call source .validate-shape before) (.call source .validate-shape after)
      (set! visits 0)
      (.call source .for-each-change void before after)
      (let (shared visits)
        (set! visits 0)
        (table-for-each-change source void before after)
        (check (< shared 200) => #t)
        (check (> visits 2048) => #t)
        (displayln "TABLE-DIFF-WORK rows=2048 edits=1 shared=" shared " reference=" visits)))
    (test-case "shared publication composes FUN consumption conflict retry and grouped migration"
      (defvalues (indexed source) (service.make-ordered-service-indexes))
      (def callback (validate (Fun Integer <- Integer) (lambda (n) (+ n 1))))
      (def before (.call source .<-list (for/collect (n (in-range 64))
        (cons n (vector n (modulo n 4) callback)))))
      (def base (.call indexed .wrap before))
      (def calls 0)
      ;; Only an installed complete snapshot can reach this IO consumer.
      (def (consume state)
        (set! calls (+ calls 1))
        (check (eq? (vector-ref (.call indexed .ref state 1) 2) callback) => #t)
        (.call indexed .index-range state 'priority (some 0) (some 1)))
      (check-exception (service.revise-indexed-services indexed source base
        (lambda (tree) (.call source .acons 0 (vector 1 2 callback) tree)) consume) table-index-conflict?)
      (check-equal? calls 0)
      (check-equal? (service.revise-indexed-services indexed source base
        (lambda (tree) (.call source .acons 1 (vector 0 2 callback)
          (.call source .acons 0 (vector 1 2 callback) tree))) consume) '((0 . 1) (1 . 0)))
      (check-equal? calls 1)
      (check (eq? (.call indexed .unwrap base) before) => #t)
      (check-exception (callback "bad") TypeError?))
    (test-case "failed shape admission is never recorded as a reusable root"
      (def source (SimpleTrie UInt Integer))
      (def ordered (table-order source (.@ source Comparer)))
      (def invalid (Branch 1 (Leaf 10) (Leaf 20)))
      (check-exception (.call ordered .range invalid #f #f) TypeError?)
      (check-exception (.call ordered .seek invalid #f) TypeError?))
    (test-case "transported seek composes indexed swaps inverse retry and ownership transfer"
      (defvalues (indexed source _derived) (service.make-seek-services))
      (def f (validate (Fun Integer <- Integer) (lambda (x) (+ x 1))))
      (def base (.call source .<-list (list (cons 10 (vector 0 f)) (cons 20 (vector 1 f)) (cons 30 (vector 2 f)))))
      (def original (.call indexed .wrap base))
      (check-equal? (.call indexed .index-range original 'priority #f #f) '((1 . 10) (0 . 20) (3 . 30)))
      (def changed (.call source .acons 10 (vector 3 f) base))
      (def delta (.call source .diff base changed))
      (def bad (.call source .diff base (.call source .acons 10 (vector 1 f) base)))
      (def style (.@ (table-styles indexed) Linear))
      (def owned (.call style .ap original))
      (check-exception (.call style .apply-delta owned bad) table-index-conflict?)
      (def next (.call style .apply-delta owned delta))
      (def pure (.call style .convert next 'pure))
      (check-equal? (.call indexed .index-range pure 'priority (some 0) (some 2)) '((0 . 20) (3 . 30) (2 . 10)))
      (check (eq? (vector-ref (.call indexed .ref pure 10) 1) f) => #t)
      (check-equal? (.call indexed .index-range
        (.call indexed .apply-delta pure (invert-table-delta delta)) 'priority #f #f)
        (.call indexed .index-range original 'priority #f #f)))
    (test-case "transported cursor guards every pull including EOF and refuses changed origins"
      (defvalues (_indexed _source derived) (service.make-seek-services))
      (def raw (.call derived .<-list '((1 . 10) (0 . 20))))
      (using ((cursor (.call derived .seek<- raw #f #t) :- Iterator))
        (check-equal? (cursor.next!) '(1 . 10))
        (check-equal? (cursor.next!) '(0 . 20))
        (check (cursor.next!) => #!eof)
        (.set! (car (.@ derived .sources)) sexp 'changed)
        (check-exception (cursor.next!) Error?)))
    (test-case "nested order views retain seek without enumeration or Function copying"
      (def scans 0)
      (def callback (validate (Fun Integer <- Integer) (lambda (n) (+ n 1))))
      (def backend (SimpleTrie UInt (Fun Integer <- Integer)))
      (def source (.cc backend .list<-: (lambda (state)
        (set! scans (+ scans 1)) (.call backend .list<- state))))
      (def inner (table-order source (.@ source Comparer)))
      (def outer (table-order inner (.@ inner Comparer)))
      (def base (.call source .<-list (for/collect (n (in-range 128)) (cons n callback))))
      (check-equal? (map car (.call outer .range base (some 120) (some 122))) '(120 121 122))
      (check-equal? scans 0)
      (check (eq? (cdr (some-value (.call outer .seek base (some 127)))) callback) => #t)
      (using ((cursor (.call outer .seek<- base (some 127) #t) :- Iterator))
        (check (eq? (cdr (cursor.next!)) callback) => #t)
        (check (cursor.next!) => #!eof)
        (.set! inner sexp 'revised)
        (check-exception (cursor.next!) Error?))
      (check-exception (.call outer .seek base #f) Error?))
    (test-case "ordered fallback publishes one guarded cursor with typed bounds"
      (def source (RationalDict (.cc Integer)))
      (def inner (table-order source (table-comparer (.@ source Key)
        (lambda (a b) (number-comparer a b)))))
      (def outer (table-order inner (.@ inner Comparer)))
      (def base (.call source .<-list '((1 . 10) (2 . 20) (3 . 30))))
      (check-equal? (.call outer .range base (some 1) (some 3) #f #f) '((2 . 20)))
      (check-exception (.call inner .seek<- base (some "bad") #t) TypeError?)
      (check-exception (.call inner .seek<- base #f 'yes) Error?)
      (using ((cursor (.call inner .seek<- base (some 2) #t) :- Iterator))
        (check-equal? (cursor.next!) '(2 . 20))
        (.set! (.@ source Value) sexp 'changed)
        (check-exception (cursor.next!) Error?)))
    (test-case "copied comparer methods cannot borrow a different procedure's seek capability"
      (def source (SimpleTrie UInt Integer))
      (def copied (.cc (.@ source Comparer) .compare: (lambda (a b) (- (number-comparer a b)))))
      (def ordered (table-order source copied))
      (def base (.call source .<-list '((1 . 10) (2 . 20) (3 . 30))))
      (check-equal? (.call ordered .range base #f #f) '((3 . 30) (2 . 20) (1 . 10)))
      (check-equal? (.call ordered .seek base (some 2)) (some '(2 . 20))))
    (test-case "stale comparer dependencies refuse fresh empty and singleton ordering views"
      (def source (RationalDict Integer)) (def policy (.o epoch: 0))
      (def comparer (table-comparer Rational number-comparer (list policy) equal?: =))
      (def empty (.@ source .empty)) (def one (.call source .singleton 1 10))
      (.set! policy epoch 1)
      (for (root (list empty one))
        (check-exception (.call (table-order source comparer) .range root #f #f)
          (message? "stale table comparer")))
      (check-exception (.call comparer .compare 1 1) (message? "stale table comparer"))
      (def fresh (table-order source (table-comparer Rational number-comparer (list policy) equal?: =)))
      (check-equal? (.call fresh .range one #f #f) '((1 . 10))))
    (test-case "complete comparer seals reject same-root comparison before value callbacks"
      (def raw (RationalDict Integer)) (def policy (.o epoch: 0)) (def calls 0)
      (def comparer (table-comparer Rational number-comparer (list policy) equal?: =))
      (def source (.cc raw Comparer: comparer))
      (def roots (list (.@ raw .empty) (.call raw .singleton 1 10)))
      (.set! policy epoch 1)
      (for (root roots)
        (check-exception (.call source .compare (lambda (a b) (set! calls (+ calls 1)) (number-comparer a b)) root root)
          (message? "stale table comparer")))
      (check-equal? calls 0))
    (test-case "cursor seals check source dependencies on construction and after EOF"
      (def raw (RationalDict Integer)) (def policy (.o epoch: 0))
      (def comparer (table-comparer Rational number-comparer (list policy) equal?: =))
      (def source (.cc raw Comparer: comparer))
      (def empty (.@ raw .empty))
      (using ((cursor (.call source .seek<- empty #f #t) :- Iterator))
        (check (cursor.next!) => #!eof)
        (.set! policy epoch 1)
        (check-exception (cursor.next!) (message? "stale ordered table cursor")))
      (check-exception (.call source .seek<- empty #f #t) (message? "stale table comparer")))
    (test-case "unbounded delayed pulls refuse stale seals without comparator or producer work"
      (def policy (.o epoch: 0)) (def comparisons 0) (def pulls 0)
      (def compare (lambda (a b) (set! comparisons (+ comparisons 1)) (number-comparer a b)))
      (def comparer (table-comparer Rational compare (list policy) equal?: =))
      (def raw (RationalDict Integer)) (def source (.cc raw Comparer: comparer))
      (def root (.call raw .singleton 1 10))
      (def producer (lambda (input) (in-coroutine (lambda (yield)
        (for (row (.call raw .list<- input)) (set! pulls (+ pulls 1)) (yield row))))))
      (using ((cursor (table-ordered-cursor source root #f #t producer compare =) :- Iterator))
        (check-equal? (cursor.next!) '(1 . 10))
        (check (cursor.next!) => #!eof)
        (check-equal? pulls 1) (check-equal? comparisons 0)
        (.set! policy epoch 1)
        (check-exception (cursor.next!) Error?)
        (check-equal? pulls 1) (check-equal? comparisons 0)))
    (test-case "comparer admission protects dependencies before wrapper and table getters"
      (def policy (.o epoch: 0))
      (def comparer (table-comparer Rational number-comparer (list policy) equal?: =))
      (def key (.o (:: @ Wrapper.)
        (Domain (begin (.set! policy epoch 1) Rational)) Codomain: Rational .ap: identity .unap: identity))
      (check-exception (table-comparer-wrapper comparer key) (message? "object mutation during computation"))
      (check-equal? (.@ policy epoch) 0)
      (def raw (RationalDict Integer))
      (def source (.o (:: @ raw) (Value (begin (.set! policy epoch 1) Integer))))
      (check-exception (table-order source comparer) (message? "object mutation during computation"))
      (check-equal? (.@ policy epoch) 0)
      (def target (.cc Rational epoch: 0))
      (def endpoint (.o (:: @ Wrapper.) Domain: Rational Codomain: target
        (.ap (begin (.set! target epoch 1) identity)) .unap: identity))
      (check-exception (table-comparer-wrapper comparer endpoint) (message? "object mutation during computation"))
      (check-equal? (.@ target epoch) 0))
    (test-case "edited comparer labels revoke positioning while reference comparisons remain valid"
      (def raw (RationalDict Integer))
      (def source (.cc raw .seek<-: (lambda args (error "unexpected positioning"))))
      (def comparer (table-comparer Rational number-comparer equal?: =))
      (.set! comparer sexp 'edited)
      (check-equal? (.call comparer .compare 1 1) 0)
      (def unsealed (table-order source comparer))
      (check-equal? (.call unsealed .range (.call raw .singleton 1 10) #f #f) '((1 . 10)))
      (def backend (.cc raw Comparer: comparer))
      (check-exception (.call backend .seek<- (.@ raw .empty) #f #t) Error?)
      (def custom (.cc comparer .compare: (lambda (a b) (- (number-comparer a b)))))
      (def ordered (table-order source custom))
      (def root (.call raw .<-list '((1 . 10) (2 . 20) (3 . 30))))
      (check-equal? (.call ordered .range root #f #f) '((3 . 30) (2 . 20) (1 . 10)))
      (check-equal? (.call ordered .seek root (some 2)) (some '(2 . 20))))
    (test-case "key descriptor revisions invalidate seals and fresh declarations permit retry"
      (def key (.cc Rational)) (def raw (.cc (RationalDict Integer) Key: key))
      (def comparer (table-comparer key number-comparer equal?: =))
      (def source (.cc raw Comparer: comparer))
      (def root (.call raw .singleton 1 10))
      (.set! key sexp 'revised-key)
      (check-exception (.call source .seek<- root #f #t) Error?)
      (check-exception (table-order source comparer) (message? "stale table comparer"))
      (def fresh-comparer (table-comparer key number-comparer equal?: =))
      (def fresh-source (.cc raw Comparer: fresh-comparer))
      (check-equal? (.call (table-order fresh-source fresh-comparer) .range root #f #f) '((1 . 10))))
    (test-case "policy-sealed service indexes reject old workflows and rebuild reverse order with undo"
      (def policy (.o direction: 1))
      (defvalues (indexed source) (service.make-ordered-service-indexes order-policy: policy))
      (def f (validate (Fun Integer <- Integer) (lambda (n) (+ n 1))))
      (def root (.call source .<-list (list (cons 1 (vector 10 2 f)) (cons 2 (vector 20 2 f)))))
      (def state (.call indexed .wrap root))
      (def styles (table-styles indexed))
      (def owners (map (lambda (name) (def protocol (.ref styles name))
        (cons protocol (.call protocol .ap state))) '(Pure Mutable Linear Posh Classy)))
      (def effects 0)
      (for (entry owners)
        (check-equal? (.call (car entry) .index-range (cdr entry) 'priority #f #f) '((10 . 1) (20 . 2))))
      (.set! policy direction -1)
      (for (entry owners)
        (check-exception ((service.observe-indexed-range (car entry) 'priority #f #f
          (lambda (rows) (for/collect (row rows) row)) (lambda (_) (set! effects (+ effects 1)))) (cdr entry)) Error?))
      (check-equal? effects 0)
      (defvalues (fresh _source) (service.make-ordered-service-indexes source (cut SimpleTrie UInt <>) order-policy: policy))
      (def initial (.call fresh .wrap root))
      (check-equal? (.call fresh .index-range initial 'priority #f #f) '((20 . 2) (10 . 1)))
      (def delta (.call source .delta/opt 1 (lambda (_) (some (vector 30 2 f))) root))
      (def next (.call fresh .apply-delta initial delta))
      (check-equal? (.call fresh .index-range next 'priority #f #f) '((30 . 1) (20 . 2)))
      (check-eq? (vector-ref (.call source .ref (.call fresh .unwrap next) 1) 2) f)
      (def action (service.observe-indexed-range fresh 'priority #f #f
        (lambda (rows) (for/fold (total 0) (row rows)
          (+ total ((vector-ref (.call source .ref (.call fresh .unwrap next) (cdr row)) 2) 1))))
        (lambda (value) (set! effects (+ effects 1)) value)))
      (check-equal? (action next) 4) (check-equal? effects 1)
      (check-equal? (.call fresh .index-range (.call fresh .apply-delta next (invert-table-delta delta)) 'priority #f #f)
        '((20 . 2) (10 . 1))))
    (test-case "bad signs equality collisions and broken inverse laws refuse"
      (def source (RationalDict Integer))
      (def bad (table-comparer (.@ source Key) (lambda (_a _b) 0)))
      (check-exception (.call bad .compare 1 2) (message? "invalid table comparison"))
      (def sign (table-comparer (.@ source Key) (lambda (_a _b) 9)))
      (check-exception (.call sign .compare 1 1) (message? "invalid table comparison"))
      (def good (table-comparer (.@ source Key) number-comparer))
      (def broken (.cc Wrapper. Domain: (.@ source Key) Codomain: (.@ source Key) .ap: (lambda (x) (+ x 1)) .unap: identity))
      (check-exception (.call (table-comparer-wrapper good broken) .compare 1 2) table-isomorphism-failure?))))
