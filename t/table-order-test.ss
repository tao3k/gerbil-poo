;;; Explicit order integrates index publication, inversion and ownership transfer.
(export table-order-test)
(import (only-in ../support/base number-comparer) :std/test :std/error ../object ../mop ../type ../number ../table ../rationaldict ../support/option
        (only-in ../fun Wrapper.) (prefix-in ../examples/service-collection service.))

;; Keep deliberate protocol refusal separate from arbitrary comparator failures.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; Use one admitted callback identity across publication and inverse recovery.
(def (fixture)
  (defvalues (indexed source comparer key) (service.make-ordered-services))
  (def callback (validate (Fun Integer <- Integer) (lambda (n) (+ n 10))))
  (def base (.call source .<-list (list (cons 1 (vector 10 callback))
    (cons 2 (vector 20 callback)) (cons 3 (vector 30 callback)))))
  (values indexed source comparer key callback base))

;; A whole lifecycle includes changed order, conflict retry and inverse recovery.
(def table-order-test
  (test-suite "explicit transported table order"
    (test-case "transported order controls traversal and all range boundaries"
      (def source (RationalDict Integer))
      (def comparer (table-comparer (.@ source Key) number-comparer))
      (def key (.cc Wrapper. Domain: (.@ source Key) Codomain: (.@ source Key) .ap: - .unap: -))
      (def ordered (table-order source (table-comparer-wrapper comparer key)))
      (def base (.call source .<-list '((-30 . 3) (-10 . 1) (-20 . 2))))
      (check-equal? (map car (.call ordered .list<- base)) '(-10 -20 -30))
      (check-equal? (map car (.call ordered .range base (some -10) (some -30))) '(-10 -20 -30))
      (check-equal? (.call ordered .range base (some -10) (some -30) #f #f) '((-20 . 2)))
      (check-equal? (.call ordered .range base (some -20) (some -20) #f) [])
      (check-equal? (map car (.call ordered .range base #f (some -20))) '(-10 -20))
      (check-equal? (map car (.call ordered .range base (some -20) #f)) '(-20 -30))
      (check-exception (.call ordered .range base (some -30) (some -10)) (message? "reversed table range"))
      (check-exception (.call ordered .range base (some "bad") #f) TypeError?)
      (check-exception (.call ordered .range base 'bad #f) (message? "table range bound must be Option")))
    (test-case "indexed revisions retain wrapping and all styles recover after refusal"
      (defvalues (indexed source _comparer _key callback base) (fixture))
      (def original (.call indexed .wrap base))
      (def after (.call source .acons 1 (vector 40 callback) base))
      (def delta (.call source .diff base after))
      (def conflict (.call source .diff base (.call source .acons 1 (vector 20 callback) base)))
      (def styles (table-styles indexed))
      (for-each (lambda (name)
        (def style (.ref styles name))
        (def state (.call style .ap original))
        (check-exception (.call style .apply-delta state conflict) table-index-conflict?)
        (check (eq? (.call style .unap state) original) => #t)
        (def next (.call style .apply-delta state delta))
        (def pure (.call style .convert next 'pure))
        (check-equal? (.call indexed .index-range pure 'priority #f #f) '((-20 . 2) (-30 . 3) (-40 . 1)))
        (check (eq? (vector-ref (.call indexed .ref pure 1) 1) callback) => #t)
        (check-exception (callback "bad") TypeError?)
        (def restored (.call indexed .apply-delta pure (invert-table-delta delta)))
        (check-equal? (.call indexed .index-range restored 'priority #f #f) '((-10 . 1) (-20 . 2) (-30 . 3)))
        (check-equal? (.call indexed .index-range
          (.call indexed .apply-delta restored delta) 'priority (some -30) #f) '((-30 . 3) (-40 . 1))))
        '(Pure Mutable Linear)))
    (test-case "stale comparers invalidate retained index snapshots and ordering views"
      (defvalues (indexed source comparer _key _callback base) (fixture))
      (def state (.call indexed .wrap base))
      (.set! comparer sexp 'changed)
      (check-exception (.call indexed .index-range state 'priority #f #f) Error?))
    (test-case "ordered grouped buckets and unordered index refusal preserve primary rows"
      (def source (RationalDict Integer))
      (def backend (RationalDict source))
      (def ordered (table-order backend (table-comparer (.@ backend Key) number-comparer)))
      (def declaration (.cc Type. name: 'group table: ordered unique?: #f
        project: (lambda (_ row) (modulo row 3))))
      (def indexed (table-indexes source (list declaration)))
      (def base (.call source .<-list '((1 . 4) (2 . 5) (3 . 7))))
      (def state (.call indexed .wrap base))
      (def groups (.call indexed .index-range state 'group (some 1) #f))
      (check-equal? (map car groups) '(1 2))
      (check-equal? (map (lambda (entry) (.call source .list<- (cdr entry))) groups)
        '(((1 . 4) (3 . 7)) ((2 . 5))))
      (def plain (table-indexes source (list (.cc declaration table: backend))))
      (check-exception (.call plain .index-range (.call plain .wrap base) 'group #f #f)
        (message? "unordered table index"))
      (check-exception (.call indexed .index-range state 'unknown #f #f)
        (message? "unknown table index")))
    (test-case "all point and derived operations reject stale ordering origins"
      (def source (RationalDict Integer))
      (def comparer (table-comparer (.@ source Key) number-comparer))
      (def ordered (table-order source comparer))
      (def base (.call ordered .<-list '((1 . 10) (2 . 20))))
      (def delta (.call ordered .diff base (.call ordered .acons 3 30 base)))
      (.set! comparer sexp 'changed)
      (check-exception (.call ordered .range base #f #f) Error?)
      (check-exception (.call ordered .ref base 1) Error?)
      (check-exception (.call ordered .acons 3 30 base) Error?)
      (check-exception (.call ordered .apply-delta base delta) Error?))
    (test-case "bad signs equality collisions and broken inverse laws refuse"
      (def source (RationalDict Integer))
      (def bad (table-comparer (.@ source Key) (lambda (_a _b) 0)))
      (check-exception (.call bad .compare 1 2) (message? "invalid table comparison"))
      (def sign (table-comparer (.@ source Key) (lambda (_a _b) 9)))
      (check-exception (.call sign .compare 1 1) (message? "invalid table comparison"))
      (def good (table-comparer (.@ source Key) number-comparer))
      (def broken (.cc Wrapper. Domain: (.@ source Key) Codomain: (.@ source Key) .ap: (lambda (x) (+ x 1)) .unap: identity))
      (check-exception (.call (table-comparer-wrapper good broken) .compare 1 2) table-isomorphism-failure?))))
