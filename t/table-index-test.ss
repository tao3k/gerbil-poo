;;; Whole correlated snapshots, final uniqueness and consuming ownership workflows.
(export table-index-test)
(import :std/test :std/error :std/iter
        ../object ../mop ../type ../number ../table ../rationaldict ../support/option
        (only-in ../fun Wrapper.) (only-in ../trie SimpleTrie)
        (only-in ./table-wrapper-test box-table)
        (only-in ./table-validation-test alist-table)
        (prefix-in ../examples/service-collection service.))

;; Keep protocol refusal distinct from a different callback implementation error.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; Admit shared callbacks once before differences are captured or styles converted.
(def (fixture)
  (defvalues (indexed source declarations) (service.make-indexed-services))
  (def f (validate (Fun Integer <- Integer) (lambda (n) (+ n 1))))
  (def base (.call source .<-list (list (cons 1 (vector 101 1001 10 f))
    (cons 2 (vector 102 1002 10 f)) (cons 9 (vector 109 1009 90 f)))))
  (values indexed source declarations base f))

;; Compare all observable primary/bucket contents, not tree shapes or allocation.
(def (observations indexed source state)
  (list (.call indexed .list<- state)
    (map (lambda (key) (.call indexed .index-ref/opt state 'badge key)) '(101 102 103 109))
    (map (lambda (key) (.call indexed .index-ref/opt state 'endpoint key)) '(1001 1002 1003 1009))
    (map (lambda (key) (map/option (cut .call source .list<- <>)
      (.call indexed .index-ref/opt state 'team key))) '(10 20 30 90))))

;; Simultaneous identifier swaps, shared-team migration and undo use one protocol.
(def table-index-test
  (test-suite "declarative correlated table indexes"
    (test-case "finite group join expands shared buckets and selectively maintains row pairs"
      (def left (SimpleTrie UInt (Tuple UInt Integer)))
      (def right (SimpleTrie UInt (Tuple UInt Integer)))
      (def groups (SimpleTrie UInt Unit))
      (def pairs (alist-table (Pair UInt UInt) Unit))
      (def target (SimpleTrie UInt Integer))
      (def seen [])
      (def join (table-group-join left right target groups pairs
        (lambda (_key row) (vector-ref row 0)) (lambda (_key row) (vector-ref row 0))
        (lambda (lk lv rk rv)
          (set! seen (cons (cons lk rk) seen))
          (some (cons (+ (* lk 100) rk) (+ (vector-ref lv 1) (vector-ref rv 1)))))))
      (def l (.call left .<-list '((1 . #(10 1)) (2 . #(10 2)) (9 . #(90 9)))))
      (def r (.call right .<-list '((3 . #(10 30)) (4 . #(10 40)) (8 . #(90 80)))))
      (def state (.call join .ap (cons l r)))
      (check-equal? (length seen) 5)
      (def la (.call left .acons 1 '#(20 11) l))
      (def ra (.call right .acons 4 '#(20 44) r))
      (set! seen [])
      (def dl (.call left .diff l la)) (def dr (.call right .diff r ra))
      (defvalues (next edits) (.call join .apply-deltas state dl dr values))
      (check-equal? (length seen) 1)
      (check (member '(9 . 8) seen) => #f)
      (check-equal? (.call target .list<- (.call join .get next)) '((104 . 55) (203 . 32) (908 . 89)))
      (check-equal? (.call target .list<- (.call target .apply-delta (.call join .get next)
        (invert-table-delta edits))) (.call target .list<- (.call join .get state)))
      (def restored (.call join .apply-deltas next (invert-table-delta dl) (invert-table-delta dr)))
      (check-equal? (.call target .list<- (.call join .get restored)) (.call target .list<- (.call join .get state)))
      (let (prior (length seen))
        (check-exception (.call join .apply-deltas next dl dr) table-conflict?)
        (check-equal? (length seen) prior)))
    (test-case "group join matches an independent Cartesian oracle through mixed finite revisions"
      (def source (SimpleTrie UInt (Tuple UInt Integer)))
      (def target (SimpleTrie UInt Integer))
      (def join (table-group-join source source target (SimpleTrie UInt Unit)
        (alist-table (Pair UInt UInt) Unit)
        (lambda (_key row) (vector-ref row 0)) (lambda (_key row) (vector-ref row 0))
        (lambda (lk lv rk rv) (some (cons (+ (* lk 100) rk) (+ (vector-ref lv 1) (vector-ref rv 1)))))))
      (def state (.call join .ap (cons (.@ source .empty) (.@ source .empty))))
      (for (round (in-range 36))
        (def roots (.call join .unap state))
        (def lk (modulo round 5)) (def rk (modulo (+ round 2) 6))
        (def l (if (= (modulo round 5) 4) (.call source .remove (car roots) lk)
          (.call source .acons lk (vector (modulo round 3) round) (car roots))))
        (def r (if (= (modulo round 4) 3) (.call source .remove (cdr roots) rk)
          (.call source .acons rk (vector (modulo (+ round 1) 3) (- round)) (cdr roots))))
        (defvalues (next edits) (.call join .apply-deltas state
          (.call source .diff (car roots) l) (.call source .diff (cdr roots) r) values))
        ;; Expand ordinary source lists independently of the maintained indexes.
        (def expected (.call source .list<- l))
        (def rows (foldl (lambda (le rows)
          (append (filter-map (lambda (re)
            (and (= (vector-ref (cdr le) 0) (vector-ref (cdr re) 0))
              (cons (+ (* (car le) 100) (car re)) (+ (vector-ref (cdr le) 1) (vector-ref (cdr re) 1)))))
            (.call source .list<- r)) rows)) [] expected))
        (check-equal? (.call target .list<- (.call join .get next))
          (.call target .list<- (.call target .<-list rows)))
        (check-equal? (.call target .list<- (.call target .apply-delta (.call join .get next)
          (invert-table-delta edits))) (.call target .list<- (.call join .get state)))
        (set! state next)))
    (test-case "group join rejects collisions atomically and retries compensated source revisions"
      (def source (SimpleTrie UInt (Tuple UInt UInt)))
      (def target (SimpleTrie UInt UInt))
      (def join (table-group-join source source target (SimpleTrie UInt Unit)
        (alist-table (Pair UInt UInt) Unit)
        (lambda (_key row) (vector-ref row 0)) (lambda (_key row) (vector-ref row 0))
        (lambda (_lk lv _rk rv) (some (cons (vector-ref rv 1) (vector-ref lv 1))))))
      (def l (.call source .<-list '((1 . #(10 7)))))
      (def r (.call source .<-list '((3 . #(10 30)) (4 . #(20 40)))))
      (def state (.call join .ap (cons l r)))
      (def collide (.call source .acons 4 '#(10 30) r))
      (check-exception (.call join .apply-deltas state (.call source .diff l l)
        (.call source .diff r collide)) table-index-conflict?)
      (check-equal? (.call target .list<- (.call join .get state)) '((30 . 7)))
      (def repaired (.call source .acons 4 '#(10 40) r))
      (def next (.call join .apply-deltas state (.call source .diff l l) (.call source .diff r repaired)))
      (check-equal? (.call target .list<- (.call join .get next)) '((30 . 7) (40 . 7)))
      (check-exception (.call join .ap (cons l collide)) table-index-conflict?))
    (test-case "both complete sources are admitted before classifiers and late refusal retains cause"
      (def raw (SimpleTrie UInt UInt))
      (def left (.cc raw .element?: (lambda (root) (and (.call raw .element? root) (.call raw .key? root 1)))))
      (def right (.cc raw .element?: (lambda (root) (and (.call raw .element? root) (.call raw .key? root 3)))))
      (def calls 0) (def refuse? #f) (def cause (list 'late-group-projection))
      (def join (table-group-join left right raw (SimpleTrie UInt Unit) (alist-table (Pair UInt UInt) Unit)
        (lambda (_key row) (set! calls (+ calls 1)) row)
        (lambda (_key row) (set! calls (+ calls 1)) row)
        (lambda (lk _lv rk _rv) (if refuse? (raise cause) (some (cons (+ (* lk 100) rk) 1))))))
      (def l (.call raw .<-list '((1 . 10)))) (def r (.call raw .<-list '((3 . 10))))
      (def state (.call join .ap (cons l r)))
      (let (prior calls)
        (check-exception (.call join .apply-deltas state (.call raw .diff l (.@ raw .empty))
          (.call raw .diff r r)) TypeError?)
        (check-equal? calls prior)
        (check-exception (.call join .apply-deltas state (.call raw .diff l l)
          (.call raw .diff r (.@ raw .empty))) TypeError?)
        (check-equal? calls prior))
      (set! refuse? #t)
      ;; Removing the last match demands no projection, even when it would fail.
      (def removed (.call join .apply-deltas state (.call raw .diff l l)
        (.call raw .diff r (.call raw .acons 3 20 r))))
      (check-equal? (.call raw .count (.call join .get removed)) 0)
      ;; A new matching pair really reaches the injected late refusal.
      (def ra (.call raw .acons 4 10 r))
      (check (try (.call join .apply-deltas state (.call raw .diff l l) (.call raw .diff r ra))
        #f (catch (actual) (eq? actual cause))) => #t)
      (check-equal? (.call raw .list<- (.call join .get state)) '((103 . 1)))
      (set! refuse? #f)
      (def next (.call join .apply-deltas state (.call raw .diff l (.call raw .acons 1 20 l)) (.call raw .diff r (.call raw .acons 3 20 ra))))
      (check-equal? (.call raw .list<- (.call join .get next)) '((103 . 1))))
    (test-case "group join supports typed heterogeneous pair keys and wrapped Functions across five styles"
      (def signature (Fun Integer <- Integer))
      (def f (validate signature (lambda (n) (+ n 1))))
      (def left (SimpleTrie UInt (Tuple UInt signature)))
      (def right (alist-table Symbol (Tuple UInt Bool)))
      (def key-type (Pair UInt Symbol))
      (def target (alist-table key-type signature))
      (def join (service.make-service-placement-join left right target (SimpleTrie UInt Unit)
        (alist-table key-type Unit)))
      (def l (.call left .<-list (list (cons 1 (vector 10 f)) (cons 2 (vector 10 f)))))
      (def r (.call right .<-list '((east . #(10 #t)) (west . #(10 #f)))))
      (def state (.call join .ap (cons l r)))
      (check-equal? (.call target .count (.call join .get state)) 2)
      (def ra (.call right .acons 'west '#(10 #t) r))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles target) name))
        (def calls 0)
        (def action (service.publish-join-action join (.call left .diff l l) (.call right .diff r ra)
          protocol (lambda (_) (set! calls (+ calls 1)))))
        (def stale (.call protocol .ap (.call target .acons '(1 . west) f (.call join .get state))))
        (check-exception (action (object<-alist (list (cons 'state state) (cons 'target stale)))) table-conflict?)
        (check-equal? calls 0)
        (def owner (.call protocol .ap (.call join .get state)))
        (def result (action (object<-alist (list (cons 'state state) (cons 'target owner)))))
        (check-equal? calls 1)
        (check-equal? (.call protocol .count (.@ result target)) 4)
        (check (eq? (.call protocol .ref (.@ result target) '(2 . west)) f) => #t)
        (check-exception ((.call protocol .ref (.@ result target) '(2 . west)) #f) TypeError?)
        (def undone (.call protocol .apply-delta (.@ result target) (invert-table-delta (.@ result delta))))
        (check-equal? (.call protocol .count undone) 2)))
    (test-case "group join rejects incompatible states and retains zero-edit origins"
      (def source (SimpleTrie UInt UInt)) (def groups (SimpleTrie UInt Unit))
      (def pairs (alist-table (Pair UInt UInt) Unit))
      (def origin (.o revision: 1)) (def inherited (.cc source .sources: (list origin)))
      (def classify (lambda (_key row) row))
      (def project (lambda (lk _lv rk _rv) (some (cons (+ (* lk 100) rk) 1))))
      (def join (table-group-join source source source groups pairs classify classify project))
      (def l (.call source .<-list '((1 . 10)))) (def r (.call source .<-list '((3 . 10))))
      (def state (.call join .ap (cons l r)))
      (def other (table-group-join source source source groups pairs classify classify project))
      (check-exception (.call other .get state) (message? "incompatible table group join"))
      (def next (.call join .apply-deltas state (.call source .diff l l) (.call inherited .diff r r)))
      (.set! origin revision 2)
      (check-exception (.call join .get next) (message? "stale table group join state"))
      (check-equal? (.call source .list<- (.call join .get state)) '((103 . 1))))
    (test-case "group join admits the complete refined target and retries a compensated pair removal"
      (def source (SimpleTrie UInt UInt))
      (def raw (SimpleTrie UInt UInt))
      (def target (.cc raw .element?: (lambda (root)
        (and (.call raw .element? root) (= (.call raw .count root) 2)))))
      (def join (table-group-join source source target (SimpleTrie UInt Unit)
        (alist-table (Pair UInt UInt) Unit) (lambda (_key row) row) (lambda (_key row) row)
        (lambda (lk lv rk _rv) (some (cons (+ (* lk 100) rk) lv)))))
      (def l (.call source .<-list '((1 . 10))))
      (def r (.call source .<-list '((3 . 10) (4 . 10))))
      (def state (.call join .ap (cons l r)))
      (def removed (.call source .remove r 4))
      (check-exception (.call join .apply-deltas state (.call source .diff l l)
        (.call source .diff r removed)) TypeError?)
      (check-equal? (.call raw .list<- (.call join .get state)) '((103 . 10) (104 . 10)))
      (def repaired (.call source .acons 5 10 removed))
      (defvalues (next edits) (.call join .apply-deltas state (.call source .diff l l)
        (.call source .diff r repaired) values))
      (check-equal? (.call raw .list<- (.call join .get next)) '((103 . 10) (105 . 10)))
      (check-equal? (.call raw .list<- (.call target .apply-delta (.call join .get next)
        (invert-table-delta edits))) '((103 . 10) (104 . 10))))
    (test-case "group join requires explicit correctly typed pair identities before callbacks"
      (def source (SimpleTrie UInt UInt)) (def calls 0)
      (def classify (lambda (_key row) (set! calls (+ calls 1)) row))
      (check-exception (table-group-join source source source (SimpleTrie UInt Unit)
        (alist-table (Pair UInt Symbol) Unit) classify classify (lambda args #f))
        (message? "join requires declared component Pair keys"))
      (check-equal? calls 0))
    (test-case "group summaries repair only affected buckets and deliver exact target edits across backends"
      (for (trie? '(#f #t))
        (def source ((if trie? (lambda (v) (SimpleTrie UInt v)) RationalDict) (Tuple UInt Integer)))
        (def raw ((if trie? (lambda (v) (SimpleTrie UInt v)) RationalDict) Integer))
        (def target (.cc raw .diff: (lambda args (error "unexpected grouped snapshot diff"))))
        (def warm? #f) (def calls 0)
        (def view (table-group-fold source target Integer
          (lambda (_key row) (vector-ref row 0))
          (lambda (key row)
            (when (and warm? (= key 9)) (error "untouched group refolded"))
            (set! calls (+ calls 1)) (vector-ref row 1))))
        (def root (.call source .<-list '((1 . #(10 5)) (2 . #(10 -5)) (9 . #(90 4)))))
        (def state (.call view .ap root))
        ;; A live group summing to zero remains distinct from a missing group.
        (check-equal? (.call target .list<- (.call view .get state)) '((10 . 0) (90 . 4)))
        (set! warm? #t)
        (def after (.call source .acons 1 '#(20 7) root))
        (def source-delta (.call source .diff root after))
        (let (prior calls)
          (defvalues (next edits) (.call view .apply-delta state source-delta values))
          (check-equal? (- calls prior) 2)
          (check-equal? (.call target .list<- (.call view .get next)) '((10 . -5) (20 . 7) (90 . 4)))
          (check-equal? (table-delta-count edits) 2)
          (check-equal? (.call target .list<- (.call target .apply-delta (.call view .get next)
            (invert-table-delta edits))) '((10 . 0) (90 . 4)))
          (def restored (.call view .apply-delta next (invert-table-delta source-delta)))
          (check-equal? (.call target .list<- (.call view .get restored)) '((10 . 0) (90 . 4)))
          (let (prior calls)
            (check-exception (.call view .apply-delta next source-delta) table-conflict?)
            (check-equal? calls prior)))))
    (test-case "group summaries match an independent finite list oracle through repeated migrations and last-owner removals"
      (def source (SimpleTrie UInt (Tuple UInt Integer)))
      (def target (SimpleTrie UInt Integer))
      (def view (service.make-team-capacity-fold source target))
      (def state (.call view .ap (.@ source .empty)))
      (for (round (in-range 32))
        (def before (.call view .unap state))
        (def key (modulo round 7))
        (def after (if (= (modulo round 4) 3) (.call source .remove before key)
          (.call source .acons key (vector (modulo round 3) (- round 12)) before)))
        (defvalues (next delta) (.call view .apply-delta state (.call source .diff before after) values))
        (def rows (.call source .list<- after))
        (for (group '(0 1 2))
          (def selected (filter (lambda (entry) (= (vector-ref (cdr entry) 0) group)) rows))
          (def expected (and (pair? selected) (some (apply + (map (lambda (entry) (vector-ref (cdr entry) 1)) selected)))))
          (check-equal? (.call target .ref/opt (.call view .get next) group) expected))
        (check (.call target .=? (.call target .apply-delta (.call view .get state) delta)
          (.call view .get next)) => #t)
        (set! state next)))
    (test-case "group summary target refinement refuses atomically and compensated retry preserves the predecessor"
      (def source (SimpleTrie UInt (Tuple UInt Integer)))
      (def raw (SimpleTrie UInt Integer))
      (def target (.cc raw .element?: (lambda (root)
        (and (element? raw root) (= (.call raw .count root) 2)))))
      (def view (service.make-team-capacity-fold source target))
      (def root (.call source .<-list '((1 . #(10 5)) (2 . #(20 7)))))
      (def state (.call view .ap root))
      (def calls 0)
      (check-exception (.call view .apply-delta state (.call source .delta/opt 1 (lambda (_) #f) root)
        (lambda (next delta) (set! calls (+ calls 1)) next)) TypeError?)
      (check-equal? calls 0)
      (check-equal? (.call target .list<- (.call view .get state)) '((10 . 5) (20 . 7)))
      (def after (.call source .<-list '((2 . #(20 7)) (3 . #(30 9)))))
      (def next (.call view .apply-delta state (.call source .diff root after)))
      (check-equal? (.call target .list<- (.call view .get next)) '((20 . 7) (30 . 9))))
    (test-case "group source refusal suppresses classification and aggregation while arithmetic failure retains its cause for retry"
      (def raw (SimpleTrie UInt (Tuple UInt Integer)))
      (def source (.cc raw .element?: (lambda (root)
        (and (element? raw root) (even? (.call raw .count root))))))
      (def target (SimpleTrie UInt Integer))
      (def calls 0) (def fail? #f) (def cause (list 'aggregate-refused))
      (def view (table-group-fold source target Integer
        (lambda (_key row) (set! calls (+ calls 1)) (vector-ref row 0))
        (lambda (key row) (when (and fail? (= key 2)) (raise cause)) (vector-ref row 1))))
      (def root (.call source .<-list '((1 . #(10 5)) (2 . #(20 7)))))
      (def state (.call view .ap root))
      (let (prior calls)
        (check-exception (.call view .apply-delta state (.call raw .delta/opt 1 (lambda (_) #f) root)) TypeError?)
        (check-equal? calls prior))
      (def after (.call source .acons 2 '#(10 11) root))
      (def delta (.call source .diff root after))
      (set! fail? #t)
      (check (eq? (try (.call view .apply-delta state delta) #f (catch (e) e)) cause) => #t)
      (check-equal? (.call target .list<- (.call view .get state)) '((10 . 5) (20 . 7)))
      (set! fail? #f)
      (check-equal? (.call target .list<- (.call view .get (.call view .apply-delta state delta))) '((10 . 16))))
    (test-case "group delivery carries transient batches and inherited origins even without target changes"
      (def source (SimpleTrie UInt (Tuple UInt Integer)))
      (def target (SimpleTrie UInt Integer))
      (def origin (.o revision: 1))
      (def inherited (.cc source .sources: (list origin)))
      (def view (table-group-fold source target Integer
        (lambda (key row) (when (= key 99) (error "transient group projected")) (vector-ref row 0))
        (lambda (_key row) (vector-ref row 1))))
      (def root (.call source .<-list '((1 . #(10 5)))))
      (def state (.call view .ap root))
      (def middle (.call source .acons 99 '#(90 20) root))
      (def edits (.call source .compose-deltas
        (list (.call source .diff root middle) (.call source .diff middle root) (.call inherited .diff root root))))
      (defvalues (next delivered) (.call view .apply-delta state edits values))
      (check-equal? (table-delta-count delivered) 0)
      (.set! origin revision 2)
      (check-exception (.call view .get next) (message? "stale table group fold state"))
      (check-exception (.call target .apply-delta (.call view .get state) delivered)
        (message? "stale or incompatible table delta")))
    (test-case "team capacity publication retains wrapped service callbacks through five styles and retries stale targets"
      (def callback (validate (Fun Integer <- Integer) (lambda (n) (+ n 1))))
      (def source (SimpleTrie UInt (Tuple UInt Integer (Fun Integer <- Integer))))
      (def target (SimpleTrie UInt Integer))
      (def view (service.make-team-capacity-fold source target))
      (def root (.call source .<-list (list (cons 1 (vector 10 5 callback)) (cons 2 (vector 20 7 callback)))))
      (def state (.call view .ap root))
      (def after (.call source .<-list (list (cons 1 (vector 20 9 callback)) (cons 3 (vector 30 2 callback)))))
      (def delta (.call source .diff root after))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles target) name))
        (def calls 0)
        (def action (service.publish-projected-ledger-action view delta protocol (lambda (_) (set! calls (+ calls 1)))))
        (def stale (.call protocol .ap (.call target .<-list '((10 . 99) (20 . 7)))))
        (check-exception (action (object<-alist (list (cons 'state state) (cons 'target stale)))) table-conflict?)
        (check-equal? calls 0)
        (check-equal? (.call protocol .list<- stale) '((10 . 99) (20 . 7)))
        (def owner (.call protocol .ap (.call view .get state)))
        (def result (action (object<-alist (list (cons 'state state) (cons 'target owner)))))
        (check-equal? calls 1)
        (check-equal? (.call protocol .list<- (.@ result target)) '((20 . 9) (30 . 2)))
        (check (eq? (vector-ref (.call source .ref (.call view .unap (.@ result state)) 1) 2) callback) => #t)
        (check ((vector-ref (.call source .ref (.call view .unap (.@ result state)) 1) 2) 6) => 7)
        (def undone (.call protocol .apply-delta (.@ result target) (invert-table-delta (.@ result delta))))
        (check-equal? (.call protocol .list<- undone) '((10 . 5) (20 . 7)))))
    (test-case "group folding reuses ordered evaluation without requiring a retractable aggregate"
      (def source (SimpleTrie UInt Integer))
      (def sequence (.cc (List Integer) .zero: [] .add: append))
      (def target (SimpleTrie UInt sequence))
      (def view (table-group-fold source target sequence
        (lambda (_key _row) 10) (lambda (_key row) (list row))))
      (def before (.call source .<-list '((1 . 5) (2 . 7) (3 . 9))))
      (def state (.call view .ap before))
      (check-equal? (.call target .ref (.call view .get state) 10) '(5 7 9))
      (def after (.call source .remove before 2))
      (def next (.call view .apply-delta state (.call source .diff before after)))
      (check-equal? (.call target .ref (.call view .get next) 10) '(5 9))
      (check-equal? (.call target .ref (.call view .get state) 10) '(5 7 9)))
    (test-case "group summaries reject changed declarations and incompatible aggregate descriptors"
      (def source (SimpleTrie UInt Integer)) (def target (SimpleTrie UInt Integer))
      (def origin (.o revision: 1))
      (def view (table-group-fold source target Integer (lambda (_key row) row) (lambda (_key row) row) (list origin)))
      (def state (.call view .ap (.call source .<-list '((1 . 10)))))
      (def other (table-group-fold source target Integer (lambda (_key row) row) (lambda (_key row) row)))
      (check-exception (.call other .get state) (message? "incompatible table group fold"))
      (.set! origin revision 2)
      (check-exception (.call view .get state) (message? "stale table group fold"))
      (check-exception (table-group-fold source (SimpleTrie UInt UInt) Integer
        (lambda (_key row) row) (lambda (_key row) row)) (message? "incompatible grouped aggregate type")))
    (test-case "cold and warm cache recognition retains declaration order and suppresses later work"
      (for (trie? '(#f #t))
        (def source (SimpleTrie UInt Integer))
        (def raw ((if trie? (lambda (v) (SimpleTrie UInt v)) RationalDict) (.@ source Key)))
        (def trace [])
        (def cache (.cc raw .element?: (lambda (root)
          (set! trace (cons 'admit-first trace))
          (and (element? raw root) (even? (.call raw .count root))))))
        (def first (.cc Type. name: 'first table: cache unique?: #t
          project: (lambda (key row) (set! trace (cons key trace)) row)))
        (def second (.cc Type. name: 'second table: (RationalDict (.@ source Key)) unique?: #t
          project: (lambda (key row) (set! trace (cons 'later trace)) row)))
        (def indexed (table-indexes source (list first second)))
        (def base (.call source .<-list '((1 . 10) (2 . 20))))
        (set! trace [])
        (check-exception (.call indexed .wrap (.call source .acons 3 30 base)) TypeError?)
        (check-equal? (reverse trace) '(1 2 3 admit-first))
        (def state (.call indexed .wrap base))
        (def delta (.call source .delta/opt 3 (lambda (_) (some 30)) base))
        (set! trace [])
        (check-exception (.call indexed .apply-delta state delta) TypeError?)
        (check-equal? (reverse trace) '(3 admit-first))
        (check-equal? (.call indexed .index-ref/opt state 'first 30) #f)
        (check-equal? (.call indexed .count state) 2)))
    (test-case "primary and unique conflicts precede final cache admission"
      (def source (RationalDict Integer)) (def raw (RationalDict (.@ source Key)))
      (def checks 0) (def failure (list 'recognizer-refused)) (def fail? #f)
      (def cache (.cc raw .element?: (lambda (root)
        (set! checks (+ checks 1)) (when fail? (raise failure)) (element? raw root))))
      (def indexed (table-indexes source (list
        (.cc Type. name: 'key table: cache unique?: #t project: (lambda (_ row) row)))))
      (def base (.call source .<-list '((1 . 10) (2 . 20))))
      (def state (.call indexed .wrap base)) (set! checks 0)
      (def old (.call source .delta/opt 1 (lambda (_) (some 11)) base))
      (def winner (.call indexed .acons 1 12 state))
      (set! checks 0) (set! fail? #t)
      (check-exception (.call indexed .apply-delta winner old) table-conflict?)
      (check-equal? checks 0)
      (check-exception (.call indexed .acons 2 12 winner) table-index-conflict?)
      (check-equal? checks 0)
      (check (eq? (try (.call indexed .apply-delta state (.call source .diff base base))
        #f (catch (cause) cause)) failure) => #t)
      (check-equal? checks 1)
      (set! fail? #f)
      (check-equal? (.call indexed .list<- (.call indexed .apply-delta state old)) '((1 . 11) (2 . 20))))
    (test-case "grouped bucket refinements reject incomplete cohorts across carriers and five styles"
      (defvalues (indexed source declarations) (service.make-cohort-services))
      (def callback (validate (Fun Integer <- Integer) (lambda (n) (+ n 1))))
      (def base (.call source .<-list
        (list (cons 1 (vector 101 10 callback)) (cons 2 (vector 102 10 callback))
              (cons 3 (vector 103 20 callback)) (cons 4 (vector 104 20 callback)))))
      (def state (.call indexed .wrap base))
      (def bad (.call source .acons 1 (vector 101 20 callback) base))
      (def bad-delta (.call source .diff base bad))
      ;; One incomplete migration is invalid; a single final two-team exchange
      ;; is valid, including the unique badge swap and every unchanged callback.
      (def repaired (.call source .acons 3 (vector 101 10 callback)
        (.call source .acons 1 (vector 103 20 callback) base)))
      (def delta (.call source .diff base repaired))
      (check-exception (.call indexed .wrap bad) TypeError?)
      (defvalues (boxed carrier keys) (box-table indexed))
      (for* ((wrapped? '(#f #t)) (name '(Pure Mutable Linear Posh Classy)))
        (def table (if wrapped? boxed indexed))
        (def before (if wrapped? (.call boxed .wrap state) state))
        (def protocol (.ref (table-styles table) name))
        (def owner (.call protocol .ap before))
        (check-exception (.call protocol .filter (lambda (key _) (not (= (abs key) 1))) owner) TypeError?)
        (check (eq? before (.call protocol .unap owner)) => #t)
        (check-exception (.call protocol .map/2 (lambda (key row)
          (if (= (abs key) 1) (vector 101 20 callback) row)) owner) TypeError?)
        (check (eq? before (.call protocol .unap owner)) => #t)
        (def next (.call protocol .map/2 (lambda (key row)
          (case (abs key) ((1) (vector 103 20 callback)) ((3) (vector 101 10 callback)) (else row))) owner))
        (def raw-state (.call protocol .unap next))
        (def accepted (if wrapped? (.call boxed .unwrap raw-state) raw-state))
        (check-equal? (.call indexed .index-ref/opt accepted 'badge 101) (some 3))
        (check-equal? (.call source .list<- (some-value (.call indexed .index-ref/opt accepted 'team 10)))
          (filter (lambda (entry) (memv (car entry) '(2 3))) (.call source .list<- repaired)))
        (for (entry (.call indexed .list<- accepted))
          (check (eq? callback (vector-ref (cdr entry) 2)) => #t)))
      (def consumed 0)
      (check-exception (service.revise-indexed-services indexed source state (lambda (_) bad)
        (lambda (_) (set! consumed (+ consumed 1)))) TypeError?)
      (check-equal? consumed 0)
      (def accepted (service.revise-indexed-services indexed source state (lambda (_) repaired)
        (lambda (root) (set! consumed (+ consumed 1)) root)))
      (check-equal? consumed 1)
      (def restored (.call indexed .apply-delta accepted (invert-table-delta delta)))
      (check-equal? (.call indexed .list<- restored) (.call indexed .list<- state))
      (check (eq? callback (vector-ref (.call indexed .ref restored 1) 2)) => #t)
      (check-exception (callback "bad") TypeError?))
    (test-case "late cache refusal retains earlier caches and no-op validates every declaration"
      (def source (RationalDict Integer)) (def raw (RationalDict (.@ source Key)))
      (def trace []) (def reject? #f)
      (def first (.cc raw .element?: (lambda (root)
        (set! trace (cons 'first trace)) (element? raw root))))
      (def second (.cc raw .element?: (lambda (root)
        (set! trace (cons 'second trace)) (and (not reject?) (element? raw root)))))
      (def indexed (table-indexes source (list
        (.cc Type. name: 'first table: first unique?: #t project: (lambda (_ row) row))
        (.cc Type. name: 'second table: second unique?: #t project: (lambda (_ row) row)))))
      (def base (.call source .<-list '((1 . 10) (2 . 20))))
      (def state (.call indexed .wrap base))
      (def delta (.call source .delta/opt 1 (lambda (_) (some 30)) base))
      (def noop (.call source .diff base base))
      (set! reject? #t)
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (table-styles indexed) name))
        (def owner (.call protocol .ap state))
        (set! trace [])
        (check-exception (.call protocol .apply-delta owner delta) TypeError?)
        (check-equal? (reverse trace) '(first second))
        (check (eq? state (.call protocol .unap owner)) => #t))
      (set! trace [])
      (check-exception (.call indexed .apply-delta state noop) TypeError?)
      (check-equal? (reverse trace) '(first second))
      (check-equal? (.call indexed .index-ref/opt state 'first 30) #f)
      (set! reject? #f) (set! trace [])
      (def next (.call indexed .apply-delta state delta))
      (check-equal? (reverse trace) '(first second))
      (check-equal? (.call indexed .index-ref/opt next 'first 30) (some 1)))
    (test-case "cache postconditions reject malformed carriers and typed owners without normalization"
      (for (shape? '(#f #t))
        (def source (SimpleTrie UInt Integer)) (def raw (RationalDict UInt))
        (def backend (.cc raw
          .validate: (lambda _ (error "unexpected normalization"))
          .acons: (lambda (key owner root)
            (if shape? 'foreign-carrier (.call raw .acons key 'untyped-owner root)))))
        (def indexed (table-indexes source (list
          (.cc Type. name: 'owner table: backend unique?: #t project: (lambda (_ row) row)))))
        (def root (.call source .singleton 1 10))
        (check-exception (.call indexed .wrap root) TypeError?)))
    (test-case "computed declarations refuse peer mutation before FUN publication and permit fresh retry"
      (def source (RationalDict (Tuple UInt (Fun Integer <- Integer))))
      (def backend (RationalDict (.@ source Key)))
      (def earlier (.cc Type. name: 'earlier table: backend unique?: #t
        project: (lambda (_ row) (vector-ref row 0))))
      (def interfere? #t) (def revised 0) (def consumed 0)
      (def later (.o (:: @ Type.) name: 'later table: backend unique?: #t
        (project (begin
          (when interfere? (.set! earlier project (lambda (_ row) (+ 100 (vector-ref row 0)))))
          (lambda (_ row) (vector-ref row 0))))))
      (def callback (validate (Fun Integer <- Integer) (lambda (n) (+ n 1))))
      (def base (.call source .<-list (list (cons 1 (vector 7 callback)) (cons 2 (vector 9 callback)))))
      ;; One service action covers cold preparation, exact callback retention,
      ;; unique failure, explicit retry and inverse restoration after publication.
      (def (publish value)
        (service.publish-indexed-services source (list earlier later) base
          (lambda (root) (set! revised (+ revised 1)) (.call source .acons 1 (vector value callback) root))
          (lambda (indexed state)
            (set! consumed (+ consumed 1))
            (check-equal? (.call indexed .index-ref/opt state 'earlier value) (some 1))
            (check-equal? (.call indexed .index-ref/opt state 'later value) (some 1))
            (check (eq? (vector-ref (.call indexed .ref state 1) 1) callback) => #t)
            (cons indexed state))))
      (def revision (object-revision earlier))
      (check-exception (publish 8) (message? "object mutation during computation"))
      (check-equal? revised 0) (check-equal? consumed 0)
      (check-equal? (object-revision earlier) revision)
      (set! interfere? #f)
      (check-exception (publish 9) table-index-conflict?)
      (check-equal? revised 1) (check-equal? consumed 0)
      (def published (publish 8))
      (def indexed (car published)) (def state (cdr published))
      (check-equal? revised 2) (check-equal? consumed 1)
      (check-equal? (callback 7) 8) (check-exception (callback "bad") TypeError?)
      (def delta (.call source .diff base (.call indexed .unwrap state)))
      (def restored (.call indexed .apply-delta state (invert-table-delta delta)))
      (check-equal? (.call indexed .index-ref/opt restored 'earlier 7) (some 1))
      (.set! earlier project (lambda (_ row) (+ 100 (vector-ref row 0))))
      (check-exception (.call indexed .ref state 1) (message? "stale indexed table")))
    (test-case "computed recipes protect every discovered backend and child Type"
      (for (which '(backend child source))
        (def source (RationalDict Integer)) (def backend (RationalDict (.@ source Key)))
        (def changed (case which ((backend) backend) ((child) (.@ backend Key)) (else source)))
        (def revision (object-revision changed))
        (def declaration (.o (:: @ Type.) name: 'value table: backend unique?: #t
          (project (begin (.set! changed sexp 'changed) (lambda (_ value) value)))))
        (check-exception (table-indexes source (list declaration)) (message? "object mutation during computation"))
        (check-equal? (object-revision changed) revision)))
    (test-case "computed getters cannot replace the original declaration request spine"
      (def source (RationalDict Integer)) (def backend (RationalDict (.@ source Key)))
      (def original (.cc Type. name: 'original table: backend unique?: #t project: (lambda (_ v) v)))
      (def replacement (.cc original name: 'replacement))
      (def declarations (list #f original))
      (def first (.o (:: @ Type.) name: 'first table: backend unique?: #t
        (project (begin (set-car! (cdr declarations) replacement) (lambda (_ v) v)))))
      (set-car! declarations first)
      (def indexed (table-indexes source declarations))
      (def base (.call source .acons 1 7 (.@ source .empty)))
      (def state (.call indexed .wrap base))
      (check-equal? (.call indexed .index-ref/opt state 'original 7) (some 1))
      (check-exception (.call indexed .index-ref/opt state 'replacement 7) (message? "unknown table index"))
      (def fresh (table-indexes source declarations))
      (check-equal? (.call fresh .index-ref/opt (.call fresh .wrap base) 'replacement 7) (some 1)))
    (test-case "point index writes build no trial table and preserve multi-key FUN retry"
      (defvalues (original source declarations) (service.make-tagged-services))
      (def writes 0)
      (def observed (.cc source
        .acons: (lambda (key row root) (set! writes (+ writes 1)) (.call source .acons key row root))
        .for-each-change: (lambda _ (error "unexpected difference scan"))))
      ;; Grouped indexes require exactly the same source descriptor for buckets.
      (def indexed (table-indexes observed (list (car declarations))))
      (def f (validate (Fun Integer <- Integer) identity))
      (def base (.call source .<-list (list (cons 1 (vector '(101) '(10) f))
        (cons 2 (vector '(102) '(20) f)))))
      (def state (.call indexed .wrap base))
      (set! writes 0)
      (def next (.call indexed .acons 1 (vector '(103 113) '(30) f) state))
      (check-equal? writes 1)
      (check-equal? (.call indexed .index-ref/opt next 'aliases 101) #f)
      (check-equal? (.call indexed .index-ref/opt next 'aliases 113) (some 1))
      (check (eq? (vector-ref (.call indexed .ref next 1) 2) f) => #t)
      (def calls 0)
      (check-exception (service.update-indexed-service original (.call original .wrap base) 1
        (lambda (_) (some (vector '(102) '(30) f)))
        (lambda (_) (set! calls (+ calls 1)))) table-index-conflict?)
      (check-equal? calls 0)
      (def retried (service.update-indexed-service original (.call original .wrap base) 1
        (lambda (_) (some (vector '(103 113) '(30 40) f))) identity))
      (check-equal? (.call original .index-ref/opt retried 'aliases 113) (some 1))
      (check-equal? (map car (.call original .index-range retried 'teams (some 30) (some 40))) '(30 40))
      (check (eq? (vector-ref (.call original .ref retried 1) 2) f) => #t)
      (def removed (.call indexed .remove next 1))
      (check-equal? (.call indexed .index-ref/opt removed 'aliases 113) #f))
    (test-case "multiple aliases and teams migrate atomically through FUN ownership and undo"
      (defvalues (indexed source _declarations) (service.make-tagged-services))
      (def f (validate (Fun Integer <- Integer) (lambda (n) (+ n 1))))
      (def base (.call source .<-list (list
        (cons 1 (vector '(101 101 111) '(10 20 10) f))
        (cons 2 (vector '(102 112) '(20 30) f)) (cons 9 (vector '() '() f)))))
      (def state (.call indexed .wrap base))
      (check-equal? (.call indexed .index-ref/opt state 'aliases 111) (some 1))
      (def team (option-ref (.call indexed .index-ref/opt state 'teams 20)))
      (check-equal? (map car (.call source .list<- team)) '(1 2))
      (check (eq? (vector-ref (.call source .ref team 1) 2) f) => #t)
      (def final (.call source .acons 2 (vector '(101 111) '(10 40) f)
        (.call source .acons 1 (vector '(102 112) '(30 40 40) f) base)))
      (def delta (.call source .diff base final))
      (def next (service.revise-indexed-services indexed source state (lambda (_) final) identity))
      (check-equal? (.call indexed .index-ref/opt next 'aliases 101) (some 2))
      (check-equal? (.call indexed .index-ref/opt next 'aliases 112) (some 1))
      (check-equal? (.call indexed .index-ref/opt next 'teams 20) #f)
      (check-equal? (map car (.call indexed .index-range next 'teams (some 20) (some 40))) '(30 40))
      (check (eq? (vector-ref (.call indexed .ref next 1) 2) f) => #t)
      (check-exception (f "bad") TypeError?)
      (def undo (.call indexed .apply-delta next (invert-table-delta delta)))
      (check-equal? (.call indexed .list<- undo) (.call indexed .list<- state))
      (check-equal? (.call indexed .index-ref/opt undo 'aliases 111) (some 1))
      (check-equal? (.call indexed .index-ref/opt undo 'teams 40) #f)
      (check-equal? (.call indexed .list<- (.call indexed .apply-delta undo delta))
        (.call indexed .list<- next)))
    (test-case "multi-key late collisions refuse consumption and preserve first-key failure order"
      (defvalues (indexed source declarations) (service.make-tagged-services))
      (def f (validate (Fun Integer <- Integer) identity))
      (def base (.call source .<-list (list (cons 1 (vector '(101 111) '(10 20) f))
        (cons 2 (vector '(102 112) '(20 30) f)))))
      (def state (.call indexed .wrap base))
      (def consumed 0)
      (def bad (.call source .acons 2 (vector '(200 111 101 111) '(40) f) base))
      (def cause (try (service.revise-indexed-services indexed source state (lambda (_) bad)
        (lambda (_) (set! consumed (+ consumed 1)))) #f (catch (e) e)))
      (check (table-index-conflict? cause) => #t)
      (check-equal? (table-index-conflict-key cause) 111)
      (check-equal? consumed 0)
      (check-equal? (.call indexed .index-ref/opt state 'aliases 200) #f)
      (check-equal? (.call indexed .index-ref/opt state 'teams 40) #f)
      (def repaired (.call source .acons 2 (vector '(200 201) '(40) f) base))
      (def next (service.revise-indexed-services indexed source state (lambda (_) repaired) identity))
      (check-equal? (.call indexed .index-ref/opt next 'aliases 200) (some 2))
      (check-equal? (.call indexed .index-ref/opt next 'aliases 102) #f)
      (.set! (car declarations) multiple? #f)
      (check-exception (.call indexed .index-ref/opt next 'aliases 200) (message? "stale indexed table")))
    (test-case "projection cardinality is explicit and all projected keys are admitted"
      (def source (RationalDict Integer))
      (def single (.cc Type. name: 'single table: (RationalDict (.@ source Key))
        unique?: #t project: (lambda (_ value) (list value value))))
      (def indexed (table-indexes source (list single)))
      (def base (.call source .acons 1 7 (.@ source .empty)))
      (check-exception (.call indexed .wrap base) TypeError?)
      (def many (table-indexes source (list (.cc single multiple?: #t))))
      (check-equal? (.call many .index-ref/opt (.call many .wrap base) 'single 7) (some 1))
      (def multiple (.cc Type. name: 'multiple table: (RationalDict (.@ source Key))
        unique?: #t multiple?: #t project: (lambda (_ value) (list value "bad"))))
      (check-exception (.call (table-indexes source (list multiple)) .wrap base) TypeError?)
      (check-exception (.call (table-indexes source
        (list (.cc multiple project: (lambda (_ value) value)))) .wrap base) ContractViolation?)
      (def cyclic (list 7))
      (set-cdr! cyclic cyclic)
      (check-exception (.call (table-indexes source
        (list (.cc multiple project: (lambda (_ value) cyclic)))) .wrap base) ContractViolation?)
      (check-exception (table-indexes source (list (.cc multiple multiple?: 'unknown))) ContractViolation?))
    (test-case "cold construction synchronizes heterogeneous unique and grouped indexes"
      (defvalues (indexed source _declarations base f) (fixture))
      (def state (.call indexed .wrap base))
      (check-equal? (.call indexed .index-ref/opt state 'badge 101) (some 1))
      (check-equal? (.call indexed .index-ref/opt state 'endpoint 1002) (some 2))
      (def team (option-ref (.call indexed .index-ref/opt state 'team 10)))
      (check-equal? (map car (.call source .list<- team)) '(1 2))
      (check (eq? (vector-ref (.call source .ref team 1) 3) f) => #t)
      (check (eq? (.call indexed .unwrap state) base) => #t)
      (check-equal? (.call indexed .index-ref/opt state 'team 20) #f)
      (check-exception (.call indexed .index-ref/opt state 'unknown 1) (message? "unknown table index"))
      (check-exception (.call indexed .index-ref/opt state 'badge "bad") TypeError?))
    (test-case "atomic swap repeated edits deletion and grouped migration invert and retry"
      (defvalues (indexed source _declarations base f) (fixture))
      (def state (.call indexed .wrap base))
      (def middle (.call source .acons 1 (vector 102 1002 20 f) base))
      (def final (.call source .acons 2 (vector 101 1001 20 f) middle))
      (def gone (.call source .remove final 1))
      (def restored (.call source .acons 1 (vector 102 1002 20 f) gone))
      (def batch (.call source .compose-deltas (list (.call source .diff base middle)
        (.call source .diff middle final) (.call source .diff final gone) (.call source .diff gone restored))))
      (def next (.call indexed .apply-delta state batch))
      (check-equal? (.call indexed .index-ref/opt next 'badge 101) (some 2))
      (check-equal? (.call indexed .index-ref/opt next 'endpoint 1002) (some 1))
      (check-equal? (.call indexed .index-ref/opt next 'team 10) #f)
      (def team (option-ref (.call indexed .index-ref/opt next 'team 20)))
      (check-equal? (map car (.call source .list<- team)) '(1 2))
      (check (eq? (vector-ref (.call source .ref team 2) 3) f) => #t)
      (check-exception (f "bad") TypeError?)
      (def undo (.call indexed .apply-delta next (invert-table-delta batch)))
      (check-equal? (observations indexed source undo) (observations indexed source state))
      (check-exception (.call indexed .apply-delta next batch) table-conflict?)
      (check-equal? (observations indexed source (.call indexed .apply-delta undo batch))
        (observations indexed source next)))
    (test-case "a later unique index refuses the entire staged primary and every earlier index"
      (defvalues (indexed source _declarations base f) (fixture))
      (def state (.call indexed .wrap base))
      (def bad (.call source .acons 1 (vector 103 1002 20 f) base))
      (def delta (.call source .diff base bad))
      (def cause (try (.call indexed .apply-delta state delta) #f (catch (e) e)))
      (check (table-index-conflict? cause) => #t)
      (check-equal? (table-index-conflict-name cause) 'endpoint)
      (check-equal? (table-index-conflict-key cause) 1002)
      (check-equal? (table-index-conflict-existing cause) 2)
      (check-equal? (table-index-conflict-incoming cause) 1)
      (check-equal? (.call indexed .index-ref/opt state 'badge 103) #f)
      (check (eq? (.call indexed .unwrap state) base) => #t)
      (check-exception (.call indexed .wrap bad) table-index-conflict?)
      (def repaired (.call source .acons 1 (vector 103 1003 20 f) base))
      (check-equal? (.call indexed .index-ref/opt
        (.call indexed .apply-delta state (.call source .diff base repaired)) 'badge 103) (some 1)))
    (test-case "every style keeps ownership on index refusal and transfers whole snapshots on success"
      (defvalues (indexed source _declarations base f) (fixture))
      (def state (.call indexed .wrap base))
      (def styles (table-styles indexed))
      (def bad (.call source .acons 1 (vector 103 1002 20 f) base))
      (def good (.call source .acons 1 (vector 103 1003 20 f) base))
      (for (name '(Pure Mutable Linear))
        (def style (.ref styles name))
        (def owned (.call style .ap state))
        (check-exception (.call style .apply-delta owned (.call source .diff base bad)) table-index-conflict?)
        (check (eq? (.call style .unap owned) state) => #t)
        (def next (.call style .apply-batch owned (list (.call source .diff base good))))
        (def snapshot (.call style .convert next 'pure))
        (check-equal? (.call indexed .index-ref/opt snapshot 'endpoint 1003) (some 1))
        (when (eq? name 'Linear)
          (check-exception (.call style .unap owned) (message? "consumed table reference")))))
    (test-case "projection work is bounded by edits rather than the whole primary"
      (def source (RationalDict Integer)) (def calls 0)
      (def declaration (.cc Type. name: 'value table: (RationalDict (.@ source Key)) unique?: #t
        project: (lambda (_ value) (set! calls (+ calls 1)) value)))
      (def indexed (table-indexes source (list declaration)))
      (def base (.call source .<-list (for/collect (n (in-range 100)) (cons n n))))
      (def state (.call indexed .wrap base))
      (check-equal? calls 100)
      (set! calls 0)
      (def next (.call indexed .apply-delta state (.call source .diff base (.call source .acons 1 1001 base))))
      (check-equal? calls 2)
      (check-equal? (.call indexed .index-ref/opt next 'value 1001) (some 1)))
    (test-case "raw callback failures precede publication and primary conflicts precede projections"
      (def source (RationalDict Integer)) (def calls 0) (def fail? #f)
      (def cause (list 'projection-failure))
      (def declaration (.cc Type. name: 'value table: (RationalDict (.@ source Key)) unique?: #t
        project: (lambda (_ value) (set! calls (+ calls 1)) (when fail? (raise cause)) value)))
      (def indexed (table-indexes source (list declaration)))
      (def base (.call source .acons 1 1 (.@ source .empty)))
      (def state (.call indexed .wrap base))
      (def target (.call source .acons 1 2 base))
      (set! fail? #t) (set! calls 0)
      (check-exception (.call indexed .apply-delta state
        (.call source .diff (.call source .acons 1 3 base) target)) table-conflict?)
      (check-equal? calls 0)
      (check (eq? (try (.call indexed .apply-delta state (.call source .diff base target)) #f
        (catch (e) e)) cause) => #t)
      (check (eq? (.call indexed .unwrap state) base) => #t)
      (set! fail? #f)
      (check-equal? (.call indexed .index-ref/opt
        (.call indexed .apply-delta state (.call source .diff base target)) 'value 2) (some 1)))
    (test-case "isomorphism-derived carriers compose indexed swaps with consuming style transfers"
      (def source (service.make-mirrored-ledger))
      (def declaration (.cc Type. name: 'capacity table: (RationalDict (.@ source Key)) unique?: #t
        project: (lambda (_ row) (car row))))
      (def indexed (table-indexes source (list declaration)))
      (def f (validate (Fun Integer <- Integer) (lambda (n) (+ n 1))))
      (def base (.call source .<-list (list (cons -1 (cons 10 f)) (cons -2 (cons 20 f)))))
      (def state (.call indexed .wrap base))
      (def middle (.call source .acons -1 (cons 20 f) base))
      (def final (.call source .acons -2 (cons 10 f) middle))
      (def batch (list (.call source .diff base middle) (.call source .diff middle final)))
      (def linear (.@ (table-styles indexed) Linear))
      (def owned (.call linear .ap state))
      (def next (.call linear .apply-batch owned batch))
      (def snapshot (.call linear .convert next 'pure))
      (check-equal? (.call indexed .index-ref/opt snapshot 'capacity 20) (some -1))
      (check-equal? (.call indexed .index-ref/opt snapshot 'capacity 10) (some -2))
      (check (eq? (cdr (.call indexed .ref snapshot -1)) f) => #t)
      (check-exception (.call linear .unap owned) (message? "consumed table reference"))
      (def undo (.call indexed .apply-delta snapshot (invert-table-delta (.call source .compose-deltas batch))))
      (check-equal? (.call indexed .list<- undo) (.call indexed .list<- state)))
    (test-case "logical emptiness and canonical empty buckets survive independent snapshot identities"
      (defvalues (indexed source _declarations _base f) (fixture))
      (def one (.call source .acons 1 (vector 101 1001 10 f) (.@ source .empty)))
      (def empty (.call indexed .remove (.call indexed .wrap one) 1))
      (check (.call indexed .empty? empty) => #t)
      (check-equal? (.call indexed .index-ref/opt empty 'badge 101) #f)
      (check-equal? (.call indexed .index-ref/opt empty 'team 10) #f)
      (check (.call indexed .empty? (.call indexed .wrap (.@ source .empty))) => #t))
    (test-case "empty revisions retain new origin dependencies and invalidate later reads"
      (def source (RationalDict Integer))
      (def declaration (.cc Type. name: 'value table: (RationalDict (.@ source Key))
        project: (lambda (_ value) value) unique?: #t))
      (def indexed (table-indexes source (list declaration)))
      (def base (.call source .acons 1 1 (.@ source .empty)))
      (def state (.call indexed .wrap base))
      (def foreign (.cc source sexp: 'foreign))
      (def next (.call indexed .apply-delta state (.call foreign .diff base base)))
      (.set! foreign sexp 'changed)
      (check-exception (.call indexed .index-ref/opt next 'value 1) (message? "stale indexed table"))
      (check-equal? (.call indexed .index-ref/opt state 'value 1) (some 1)))
    (test-case "declarations and dependency origins cannot be silently replaced"
      (defvalues (indexed source declarations base _f) (fixture))
      (def state (.call indexed .wrap base))
      (check-exception (table-indexes source (list (car declarations) (car declarations)))
        (message? "duplicate table index name"))
      (check-exception (table-indexes source (list (.cc (car declarations) table: (RationalDict Integer))))
        (message? "incompatible table index value type"))
      (defvalues (other _ _decls _base _function) (fixture))
      (check-exception (.call other .unwrap state) (message? "incompatible indexed table"))
      (.set! (car declarations) sexp 'changed)
      (check-exception (.call indexed .unwrap state) (message? "stale indexed table")))))
