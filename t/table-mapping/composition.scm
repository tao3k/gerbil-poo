;;; Incremental view composition regressions in the existing table test namespace.
    (test-case "composed views deliver exact deltas and retain Function leaves across five styles"
      (def callback (Fun Integer <- Integer))
      (def f (validate callback (lambda (n) (+ n 3))))
      (def source (SimpleTrie UInt (Tuple (List UInt) callback)))
      (def middle (.cc (SimpleTrie UInt callback) .diff: (lambda args (error "unexpected middle diff"))))
      (def target (.cc (SimpleTrie UInt callback) .diff: (lambda args (error "unexpected target diff"))))
      (def calls [])
      (def composed (table-projection-compose (service.make-service-routes source middle)
        (table-projection middle target (lambda (key value)
          (set! calls (cons key calls)) (some (cons (modulo key 10) value))))))
      (def root (.call source .<-list (list (cons 1 (vector '(10 21) f)) (cons 9 (vector '(99) f)))))
      (def state (.call composed .ap root))
      (def delta (.call source .delta/opt 1 (lambda (_) (some (vector '(32 43) f))) root))
      (for (name '(Pure Mutable Linear Posh Classy))
        (set! calls [])
        (def protocol (.ref (table-styles target) name))
        (def effects 0)
        (def request (object<-alist (list (cons 'state state)
          (cons 'target (.call protocol .ap (.call composed .get state))))))
        (def result ((service.publish-projected-ledger-action composed delta protocol
          (lambda (_) (set! effects (+ effects 1)))) request))
        (check-equal? calls '(43 32))
        (check-equal? effects 1)
        (def observed (.call protocol .unap (.@ result target)))
        (check-equal? (map car (.call target .list<- observed)) '(2 3 9))
        (for (key '(2 3 9)) (check (eq? (.call target .ref observed key) f) => #t))
        (check-exception ((.call target .ref observed 2) "bad") TypeError?)
        (def restored (.call protocol .apply-delta (.@ result target) (invert-table-delta (.@ result delta))))
        (check-equal? (map car (.call target .list<- (.call protocol .unap restored))) '(0 1 9)))
      (def next (.call composed .apply-delta state delta))
      (def restored (.call composed .apply-delta next (invert-table-delta delta)))
      (check-equal? (.call source .list<- (.call composed .unap restored)) (.call source .list<- root)))
    (test-case "downstream collision refuses the whole chain and leaves an immutable retry"
      (def source (SimpleTrie UInt UInt)) (def middle (SimpleTrie UInt UInt))
      (def target (SimpleTrie UInt UInt)) (def deliveries 0)
      (def composed (table-projection-compose
        (table-projection source middle (lambda (key value) (some (cons key value))))
        (table-projection middle target (lambda (key value) (some (cons (modulo key 10) value))))))
      (def root (.call source .<-list '((1 . 10) (2 . 20))))
      (def state (.call composed .ap root))
      (def bad (.call source .delta/opt 11 (lambda (_) (some 30)) root))
      (check-exception (.call composed .apply-delta state bad
        (lambda args (set! deliveries (+ deliveries 1)))) table-index-conflict?)
      (check-equal? deliveries 0)
      (check-equal? (.call target .list<- (.call composed .get state)) '((1 . 10) (2 . 20)))
      (def good (.call source .delta/opt 3 (lambda (_) (some 30)) root))
      (def next (.call composed .apply-delta state good))
      (check-equal? (.call target .list<- (.call composed .get next)) '((1 . 10) (2 . 20) (3 . 30)))
      (def stale (.call source .delta/opt 1 (lambda (_) (some 99)) (.call source .acons 1 0 root)))
      (check-exception (.call composed .apply-delta state stale) table-conflict?)
      (check-equal? (.call composed .get state) (.call composed .get
        (.call composed .apply-delta next (invert-table-delta good)))))
    (test-case "composed service expansion and grouped summaries invalidate only affected cohorts"
      (def callback (Fun Integer <- Integer))
      (def f (validate callback (lambda (n) (+ n 3))))
      (def source (SimpleTrie UInt (Tuple (List UInt) callback)))
      (def routes (SimpleTrie UInt callback)) (def summary (SimpleTrie UInt Integer))
      (def composed (service.make-service-route-summary source routes summary))
      (def root (.call source .<-list (list (cons 1 (vector '(10 11) f)) (cons 2 (vector '(20) f)))))
      (def state (.call composed .ap root))
      (check-equal? (.call summary .list<- (.call composed .get state)) '((1 . 6) (2 . 3)))
      (def delta (.call source .delta/opt 1 (lambda (_) (some (vector '(30) f))) root))
      (defvalues (next output) (.call composed .apply-delta state delta values))
      (check-equal? (table-delta-count output) 2)
      (check-equal? (.call summary .list<- (.call composed .get next)) '((2 . 3) (3 . 3)))
      (check-equal? (.call summary .list<- (.call summary .apply-delta (.call composed .get state) output))
        '((2 . 3) (3 . 3))))
    (test-case "composition rejects foreign caches, mismatched middle descriptors and stale declarations"
      (def source (SimpleTrie UInt UInt)) (def middle (SimpleTrie UInt UInt))
      (def target (SimpleTrie UInt UInt))
      (def first (table-projection source middle (lambda (key value) (some (cons key value)))))
      (def second (table-projection middle target (lambda (key value) (some (cons key value)))))
      (def composed (table-projection-compose first second))
      (def root (.call source .<-list '((1 . 1)))) (def state (.call composed .ap root))
      (def foreign (table-projection-compose first second))
      (check-exception (.call foreign .get state) (message? "incompatible projection composition state"))
      (check-exception (table-projection-compose first
        (table-projection (.cc middle sexp: 'other) target (lambda (key value) (some (cons key value)))))
        (message? "incompatible projection composition"))
      (.set! second note 'revised)
      (check-exception (.call composed .get state) (message? "stale projection composition")))
    (test-case "downstream whole-root refusal and callback failure never deliver a partial chain"
      (def source (SimpleTrie UInt UInt)) (def middle (SimpleTrie UInt UInt))
      (def raw (SimpleTrie UInt UInt))
      (def target (.cc raw .element?: (lambda (root)
        (and (.call raw .element? root) (= (length (.call raw .list<- root)) 2)))))
      (def cause (Error "downstream callback" irritants: [] where: #f)) (def deliveries 0)
      (def composed (table-projection-compose
        (table-projection source middle (lambda (key value) (some (cons key value))))
        (table-projection middle target (lambda (key value)
          (if (= value 77) (raise cause) (some (cons key value)))))))
      (def root (.call source .<-list '((1 . 10) (2 . 20)))) (def state (.call composed .ap root))
      (check-exception (.call composed .apply-delta state
        (.call source .delta/opt 1 (lambda (_) #f) root)
        (lambda args (set! deliveries (+ deliveries 1)))) TypeError?)
      (check-exception (.call composed .apply-delta state
        (.call source .delta/opt 1 (lambda (_) (some 77)) root)
        (lambda args (set! deliveries (+ deliveries 1)))) (lambda (caught) (eq? caught cause)))
      (check-equal? deliveries 0)
      (def next (.call composed .apply-delta state (.call source .delta/opt 1 (lambda (_) (some 30)) root)))
      (check-equal? (.call raw .list<- (.call composed .get next)) '((1 . 30) (2 . 20)))
      (check-equal? (.call raw .list<- (.call composed .get state)) '((1 . 10) (2 . 20))))
    (test-case "nested composition coalesces batches and keeps no-op delta origins live"
      (def source (SimpleTrie UInt UInt)) (def middle (SimpleTrie UInt UInt))
      (def final (SimpleTrie UInt UInt)) (def calls [])
      (def first (table-projection source middle (lambda (key value) (some (cons key value)))))
      (def second (table-projection middle final (lambda (key value)
        (set! calls (cons value calls)) (some (cons key (+ value 1))))))
      (def last (table-projection final source (lambda (key value) (some (cons key (* value 2))))))
      (def composed (table-projection-compose (table-projection-compose first second) last))
      (def root (.call source .<-list '((1 . 1) (9 . 9))))
      (def state (.call composed .ap root))
      (def a (.call source .delta/opt 1 (lambda (_) (some 10)) root))
      (def b (.call source .delta/opt 1 (lambda (_) (some 20)) (.call source .apply-delta root a)))
      (set! calls [])
      (def next (.call composed .apply-delta state (.call source .compose-deltas (list a b))))
      (check-equal? calls '(20))
      (check-equal? (.call source .list<- (.call composed .get next)) '((1 . 42) (9 . 20)))
      (def origin (.o epoch: 0)) (def witnessed (.cc source .sources: (list origin)))
      (def noop (.call witnessed .delta/opt 1 identity root))
      (defvalues (same output) (.call composed .apply-delta state noop values))
      (check-equal? (table-delta-count output) 0)
      (.set! origin epoch 1)
      (check-exception (.call composed .get same) Error?)
      (check-exception (.call composed .unap same) Error?))
