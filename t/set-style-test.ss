;;; Set presentations reuse table ownership while observing admitted elements.
(export set-style-test)
(import :std/test :std/error :std/iter :std/interface
        (only-in ../brace @@method) ../object ../mop ../type ../number ../table
        ../rationaldict ../support/option (only-in ../trie SimpleTrie SimpleTrieSet TrieSet.)
        (only-in ./table-testing alist-table)
        (prefix-in ../examples/service-collection service.))

;; Protocol refusals remain distinguishable from unrelated implementation errors.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; Assert both element-level presentation and the original ownership/failure rules.
(def set-style-test
  (test-suite "derived set styles"
    (test-case "membership lenses present Bool and preserve all five ownership rules"
      (def descriptor (.cc Set<-Table. Table: (RationalDict Unit)))
      (def base (.call descriptor .singleton 1))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (set-styles descriptor) name))
        (def owner (.call protocol .ap base))
        (def present (.call protocol .lens 1))
        (def absent (if (memq name '(Posh Classy)) (@@method owner.lens 2) (.call protocol .lens 2)))
        (check (.call present .get owner) => #t)
        (check (.call absent .get owner) => #f)
        (check-exception (.call absent .set 'truthy owner) ContractViolation?)
        (check (.call absent .get owner) => #f)
        (def next (.call absent .set #t owner))
        (check (.call absent .get next) => #t)
        (check (.call present .get next) => #t)
        (case name
          ((Pure Posh) (check (.call absent .get owner) => #f))
          ((Mutable Classy) (check-eq? next owner))
          ((Linear) (check-exception (.call absent .get owner) (message? "consumed table reference"))))
        (def removed (.call Lens .modify absent not next))
        (check (.call absent .get removed) => #f)
        (check-equal? (.call protocol .list<- removed) '(1))))
    (test-case "Boolean false keys and no-op membership writes retain exact lens semantics"
      (def descriptor (.cc Set<-Table. Table: (alist-table Bool Unit)))
      (def base (.call descriptor .singleton #f))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (set-styles descriptor) name))
        (def focus (.call protocol .lens #f)) (def owner (.call protocol .ap base))
        (check (.call focus .get owner) => #t)
        (check-exception (.call protocol .lens 0) TypeError?)
        (def unchanged (.call Lens .modify focus identity owner))
        (check (.call focus .get unchanged) => #t)
        (when (eq? name 'Linear)
          (check-exception (.call protocol .unap owner) (message? "consumed table reference")))
        (def empty (.call focus .set #f unchanged))
        (check-equal? (.call protocol .count empty) 0)
        (def restored (.call focus .set #t empty))
        (check (.call focus .get restored) => #t)
        (check-equal? (.call protocol .list<- restored) '(#f))))
    (test-case "composed access modification retains a competing winner and retries without losing the service frame"
      (def descriptor (.cc Set<-Table. Table: (RationalDict Unit)))
      (def root (.call descriptor .singleton 1))
      (for (name '(Mutable Linear Classy))
        (def protocol (.ref (set-styles descriptor) name))
        (def owner (.call protocol .ap root)) (def winner #f) (def calls 0) (def effects 0)
        (def service-state (.o access: owner sibling: 77))
        (def losing (service.revise-focused-access protocol 1
          (lambda (present?)
            (set! calls (+ calls 1))
            (check present? => #t)
            (set! winner (.call protocol .cons 3 owner)) #f)
          (lambda (_) (set! effects (+ effects 1)))))
        (check-exception (losing service-state) (message? "stale table reference"))
        (check-equal? calls 1) (check-equal? effects 0)
        (check-equal? (.call protocol .list<- winner) '(1 3))
        (check-equal? (.@ service-state sibling) 77)
        (def retry (service.revise-focused-access protocol 1 not
          (lambda (_) (set! effects (+ effects 1)))))
        (def next (retry (.o access: winner sibling: 77)))
        (check-equal? effects 1)
        (check-equal? (.@ next sibling) 77)
        (check-equal? (.call protocol .list<- (.@ next access)) '(3))))
    (test-case "refinement and callback refusal preserve owners and suppress IO until a fresh successful modification"
      (def raw (RationalDict Unit))
      (def descriptor (.cc Set<-Table. Table: raw .element?: (lambda (root)
        (and (element? raw root) (= (.call raw .count root) 2)))))
      (def base (.call raw .<-list (list (cons 1 (void)) (cons 2 (void)))))
      (def cause (list 'membership-modifier-refused))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (set-styles descriptor) name)) (def owner (.call protocol .ap base))
        (def effects 0) (def request (.o access: owner sibling: 'kept))
        (def consume (lambda (_) (set! effects (+ effects 1))))
        (def remove (service.revise-focused-access protocol 1 not consume))
        (check-exception (remove request) TypeError?)
        (def refuse (service.revise-focused-access protocol 1 (lambda (_) (raise cause)) consume))
        (check-eq? (with-catch identity (lambda () (refuse request))) cause)
        (check-equal? effects 0) (check-equal? (.call protocol .count owner) 2)
        (def retry (service.revise-focused-access protocol 1 identity consume))
        (def next (retry request))
        (check-equal? effects 1) (check-equal? (.@ next sibling) 'kept)
        (check-equal? (.call protocol .count (.@ next access)) 2)))
    (test-case "foreign consumed and stale capabilities refuse before membership modifiers while Table focuses retain their domain"
      (def policy (.o epoch: 0))
      (def raw (RationalDict Unit))
      (def descriptor (.cc Set<-Table. Table: raw .sources: (list policy)))
      (def base (.call descriptor .singleton 1))
      (for (name '(Mutable Linear Posh Classy))
        (def protocol (.ref (set-styles descriptor) name))
        (def other (.ref (set-styles descriptor) name))
        (def foreign (.call other .ap base)) (def calls 0)
        (def focus (.call protocol .lens 1))
        (check-exception (.call Lens .modify focus
          (lambda (_) (set! calls (+ calls 1)) #t) foreign) Error?)
        (check-equal? calls 0))
      (def linear (.@ (set-styles descriptor) Linear)) (def owner (.call linear .ap base))
      (def focus (.call linear .lens 1)) (def live (.call focus .set #t owner)) (def calls 0)
      (check-exception (.call Lens .modify focus (lambda (_) (set! calls (+ calls 1)) #t) owner)
        (message? "consumed table reference"))
      (.set! policy epoch 1)
      (check-exception (.call Lens .modify focus (lambda (_) (set! calls (+ calls 1)) #t) live)
        (message? "stale table styles"))
      (check-equal? calls 0)
      (def table-protocol (.@ (table-styles raw) Pure))
      (check-eq? (.call (.call table-protocol .lens 1) .get base) (void))
      (check (.call (.call table-protocol .lens/opt 2) .get base) => #f))
    (test-case "Function membership updates compose policy refresh direct deltas and inverse recovery without recooking keys"
      (def signature (Fun Integer <- Integer)) (def calls 0)
      (def f (validate signature (lambda (n) (set! calls (+ calls 1)) (+ n 1))))
      (def g (validate signature (lambda (n) (set! calls (+ calls 1)) (* n 2))))
      (def policy (.o epoch: 0)) (def table (alist-table signature Unit))
      (def descriptor (.cc Set<-Table. Table: table .sources: (list policy)))
      (def base (.call descriptor .singleton f))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def old (.ref (set-styles descriptor) name)) (def old-owner (.call old .ap base))
        (def effects 0) (def modifications 0)
        (def action (service.revise-focused-access old g
          (lambda (present?) (set! modifications (+ modifications 1)) (not present?))
          (lambda (_) (set! effects (+ effects 1)))))
        (.set! policy epoch (+ 1 (.@ policy epoch)))
        (check-exception (action (.o access: old-owner sibling: 'service)) (message? "stale table styles"))
        (check-equal? modifications 0) (check-equal? effects 0)
        (def protocol (.ref (set-styles descriptor) name))
        (def owner (.call protocol .ap base))
        (def retry (service.revise-focused-access protocol g not
          (lambda (_) (set! effects (+ effects 1)))))
        (def published (retry (.o access: owner sibling: 'service)))
        (def current (.@ published access)) (def after (.call protocol .unap current))
        (check-equal? effects 1) (check-equal? (.@ published sibling) 'service)
        (def members (.call protocol .list<- current))
        (check (and (memq f members) (memq g members) #t) => #t)
        (def delta (.call table .diff base after))
        (def restored (.call protocol .apply-delta current (invert-table-delta delta)))
        (check-eq? (.call protocol .choose restored) f)
        (check-exception (g "invalid") TypeError?))
      (check-equal? calls 0))
    (test-case "parameterized Trie sets share exact element and backing key contracts"
      (for (element (list (UIntN 8) UInt256))
        (def descriptor (SimpleTrieSet element)) (def table (.@ descriptor Table))
        (def limit (.@ element n))
        (check-eq? (.@ descriptor Elt) (.@ table Key)) (check-eq? (.@ table Value) Unit)
        (def root (.call descriptor .<-list (list 0 (- limit 1))))
        (check-equal? (.call descriptor .list<- root) (list 0 (- limit 1)))
        (for (key (list -1 limit))
          (check-exception (.call descriptor .<-list (list 0 key)) TypeError?)
          (check-exception (.call descriptor .<-iter (iter (list 0 key))) TypeError?))
        (def wide (SimpleTrie UInt Unit))
        (def invalid (.call wide .singleton limit (void)))
        (check (element? descriptor invalid) => #f)
        (check-exception (.call descriptor .empty? invalid) TypeError?)))
    (test-case "refined UInt element contracts govern bulk data algebra and shared-root shortcuts"
      (def even (.cc UInt .element?: (lambda (value)
        (and (element? UInt value) (even? value)))))
      (def descriptor (SimpleTrieSet even))
      (def root (.call descriptor .<-list '(2 4)))
      (check-eq? (.@ (.@ descriptor Table) Key) even)
      (check-exception (.call descriptor .<-list '(2 3)) TypeError?)
      (def invalid (.call (SimpleTrie UInt Unit) .singleton 3 (void)))
      (check (element? descriptor invalid) => #f)
      (check-exception (.call descriptor .subset? invalid invalid) TypeError?)
      (check-exception (.call descriptor .union root invalid) TypeError?)
      (check-equal? (.call descriptor .list<- root) '(2 4)))
    (test-case "bounded Trie set factories support all twenty-five transfers and checked updates"
      (def descriptor (SimpleTrieSet (UIntN 8)))
      (def root (.call descriptor .<-list '(1 255)))
      (def styles (set-styles descriptor))
      (for* ((from '(Pure Mutable Linear Posh Classy)) (to '(Pure Mutable Linear Posh Classy)))
        (def source (.ref styles from)) (def target (.ref styles to))
        (def owner (.call source .ap root))
        (def next (.call source .convert owner (string->symbol (string-downcase (symbol->string to)))))
        (check-eq? (.call target .unap next) root)
        (check-exception (.call target .cons 256 next) TypeError?)
        (check-eq? (.call target .unap next) root)
        (def revised (.call target .cons 7 next))
        (check-equal? (.call target .list<- revised) '(1 7 255))
        (check-equal? (.call descriptor .list<- root) '(1 255))))
    (test-case "typed Trie Set codecs and the default trait retain the existing carrier and wire protocols"
      (def descriptor (SimpleTrieSet (UIntN 8))) (def root (.call descriptor .<-list '(0 7 255)))
      (def decoded (.call descriptor .<-bytes (.call descriptor .bytes<- root)))
      (check-equal? (.call descriptor .list<- decoded) '(0 7 255))
      (check-equal? (.call descriptor .list<- (.call descriptor .<-json (.call descriptor .json<- root))) '(0 7 255))
      (def default (.cc TrieSet. sexp: 'default-trie-set))
      (check-eq? (.@ default Elt) UInt) (check-eq? (.@ (.@ default Table) Key) UInt)
      (check-equal? (.call default .list<- (.call default .<-list '(1 2))) '(1 2)))
    (test-case "element rebinding invalidates old factories and rebinds the shared key contract"
      (def descriptor (SimpleTrieSet (UIntN 8)))
      (def root (.call descriptor .<-list '(1 31))) (def compatible (.call descriptor .<-list '(1 2)))
      (def old (.@ (set-styles descriptor) Mutable)) (def owner (.call old .ap root))
      (def narrow (UIntN 4))
      (.set! descriptor Elt narrow)
      (check-eq? (.@ (.@ descriptor Table) Key) narrow)
      (check-exception (.call old .unap owner) (message? "stale table styles"))
      (def fresh (.@ (set-styles descriptor) Mutable))
      (check-exception (.call fresh .ap root) TypeError?)
      (def next (.call fresh .ap compatible))
      (check-eq? (.call fresh .unap next) compatible)
      (check-exception (.call fresh .cons 16 next) TypeError?)
      (check-equal? (.call fresh .list<- (.call fresh .cons 15 next)) '(1 2 15)))
    (test-case "bounded service permissions compose shared dependencies publication retry and inverse"
      (def services (SimpleTrieSet UInt)) (def permissions (SimpleTrieSet (UIntN 8)))
      (def catalog (SimpleTrie UInt (List (.@ permissions Elt))))
      (def assignments (.call catalog .<-list '((1 7 255) (2 255 8) (3 9))))
      (def image (service.make-service-permission-image services permissions catalog assignments))
      (def state (.call image .ap (.call services .<-list '(1 2))))
      (check-equal? (.call permissions .list<- (.call image .get state)) '(7 8 255))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref (set-styles permissions) name)) (def calls 0)
        (def action (service.publish-access-image-action image services (.call services .<-list '(3))
          (.call services .<-list '(1)) protocol (lambda (_) (set! calls (+ calls 1)))))
        (def stale (.call protocol .ap (.call permissions .<-list '(8 255))))
        (check-exception (action (object<-alist (list (cons 'state state) (cons 'target stale)))) table-conflict?)
        (check-equal? calls 0) (check-equal? (.call protocol .list<- stale) '(8 255))
        (def current (.call protocol .ap (.call image .get state)))
        (def result (action (object<-alist (list (cons 'state state) (cons 'target current)))))
        (check-equal? calls 1)
        (check-equal? (.call protocol .list<- (.@ result target)) '(8 9 255))
        (check-equal? (table-delta-count (.@ result delta)) 2)
        (def restored (.call protocol .apply-delta (.@ result target) (invert-table-delta (.@ result delta))))
        (check-equal? (.call protocol .list<- restored) '(7 8 255))))
    (test-case "all twenty-five set transfers preserve snapshots and retire owned sources"
      (def set RationalSet)
      (def base (.call set .<-list '(1 3)))
      (def styles (set-styles set))
      (for* ((from '(Pure Mutable Linear Posh Classy)) (to '(Pure Mutable Linear Posh Classy)))
        (def source (.ref styles from)) (def target (.ref styles to))
        (check (eq? (.@ source Domain) set) => #t)
        (def input (.call source .ap base))
        (def output (.call source .convert input (string->symbol (string-downcase (symbol->string to)))))
        (check (eq? base (.call target .unap output)) => #t)
        (check-equal? (.call target .list<- output) '(1 3))
        (if (memq from '(Pure Posh))
          (check (eq? base (.call source .unap input)) => #t)
          (check-exception (.call source .unap input) (message? "consumed table reference")))))
    (test-case "every style delegates set algebra and only commits the left operand"
      (def set RationalSet) (def styles (set-styles set))
      (def a (.call set .<-list '(1 2))) (def b (.call set .<-list '(2 3)))
      (for* ((name '(Pure Mutable Linear Posh Classy)) (method '(.union .inter .diff .symdiff)))
        (def protocol (.ref styles name))
        (def left (.call protocol .ap a)) (def right (.call protocol .ap b))
        (def result ((.ref protocol method) left right))
        (check-equal? (.call protocol .list<- result)
          (.call set .list<- ((.ref set method) a b)))
        (check (eq? b (.call protocol .unap right)) => #t)
        (case name
          ((Pure Posh) (check (eq? a (.call protocol .unap left)) => #t))
          ((Mutable Classy) (check (eq? result left) => #t))
          ((Linear) (check-exception (.call protocol .unap left) (message? "consumed table reference"))))))
    (test-case "element observations folds and receiver calls never expose Unit pairs"
      (def styles (set-styles RationalSet))
      (def base (.call RationalSet .<-list '(1 2 3)))
      (for (name '(Pure Mutable Linear Posh Classy))
        (def protocol (.ref styles name)) (def state (.call protocol .ap base))
        (check-equal? (for/collect (element (.call protocol .iter<- state)) element) '(1 2 3))
        (check-equal? (.call protocol .foldl + 0 state) 6)
        (check-equal? (.call protocol .foldr cons [] state) '(1 2 3))
        (check (.call protocol .subset? state state) => #t)
        (check (.call protocol .=? state state) => #t)
        (when (memq name '(Posh Classy))
          (check-equal? (for/collect (element state) element) '(1 2 3))
          (check (@@method state.elt? 2) => #t)
          (check-equal? (@@method state.foldl + 0) 6)
          (let (next (@@method state.cons 4))
            (check-equal? (@@method next.list<-) '(1 2 3 4))))))
    (test-case "foreign consumed and callback refusals preserve live owners for retry"
      (def set RationalSet) (def styles (set-styles set))
      (def protocol (.@ styles Classy))
      (def a (.call protocol .ap (.call set .<-list '(1 2))))
      (def b (.call protocol .ap (.call set .<-list '(2 3))))
      (def foreign (.call (.@ (set-styles set) Classy) .ap (.@ set .empty)))
      (check-exception (@@method a.union foreign) (message? "incompatible table receiver"))
      (check-equal? (@@method a.list<-) '(1 2))
      (def cause (list 'refused))
      (check (eq? (try (@@method a.step (lambda (_) (raise cause))) #f (catch (e) e)) cause) => #t)
      (def snapshot (@@method a.snapshot))
      (check-exception (@@method a.step (lambda (_) 'bad)) TypeError?)
      (check (eq? snapshot (@@method a.snapshot)) => #t)
      (@@method b.convert 'posh)
      (check-exception (@@method a.union b) (message? "consumed table reference"))
      (check-equal? (@@method a.list<-) '(1 2))
      (check (eq? a (@@method a.cons 3)) => #t))
    (test-case "descriptor refusal alias retirement and declared set origins stay explicit"
      (check-exception (set-styles (.cc Set<-Table. Table: (RationalDict Unit) Elt: String sexp: 'incompatible))
        (message? "incompatible set style descriptor"))
      (check-exception (set-styles (.cc Set<-Table. Table: (RationalDict Integer) sexp: 'bad))
        (message? "incompatible set style descriptor"))
      (def dependency (.o revision: 1))
      (def descriptor (.cc RationalSet .sources: (list dependency)))
      (def styles (set-styles descriptor)) (def linear (.@ styles Linear))
      (def input (.call linear .ap (.call descriptor .<-list '(1 2))))
      (def next (.call linear .diff input input))
      (check-equal? (.call linear .list<- next) [])
      (check-exception (.call linear .unap input) (message? "consumed table reference"))
      (.set! dependency revision 2)
      (check-exception (.call linear .unap next) (message? "stale table styles")))
    (test-case "captured element cursors survive transfer but refuse revised set metadata at EOF"
      (def set (.cc RationalSet))
      (def protocol (.@ (set-styles set) Classy))
      (def state (.call protocol .ap (.call set .<-list '(1 2))))
      (def cursor (iter state))
      (def exhausted (iter state))
      (check-equal? (for/collect (value exhausted) value) '(1 2))
      (@@method state.cons 3) (@@method state.convert 'posh)
      (check-equal? (for/collect (value cursor) value) '(1 2))
      (.set! set sexp 'revised-set)
      (for (stream (list cursor exhausted))
        (using (iterator stream :- Iterator)
          (check-exception (iterator.next!) (message? "stale table styles")))))
    (test-case "ordered set capabilities project positioned entries without changing bounds"
      (def source (SimpleTrie UInt Unit))
      (def table (table-order source (.@ source Comparer)))
      (def set (.cc Set<-Table. Table: table sexp: 'ordered-set))
      (def state (.call (.@ (set-styles set) Posh) .ap (.call set .<-list '(1 3 5))))
      (check-equal? (@@method state.seek (some 2)) (some 3))
      (check-equal? (@@method state.range (some 1) (some 5) #f #f) '(3))
      (check-equal? (for/collect (value (@@method state.seek<- (some 3) #f)) value) '(5))
      (check-exception (@@method state.range (some 5) (some 1)) (message? "reversed table range")))
    (test-case "custom set membership is admitted before committing an owned result"
      (def set (.cc RationalSet .element?: (lambda (root)
        (and (.call RationalSet .element? root) (<= (.call RationalSet .count root) 2)))))
      (def classy (.@ (set-styles set) Classy))
      (def input (.call classy .ap (.call set .<-list '(1 2))))
      (check-exception (.call classy .cons 3 input) TypeError?)
      (check-equal? (.call classy .list<- input) '(1 2))
      (check-exception (.call classy .admit (.call RationalSet .<-list '(1 2 3))) TypeError?)
      (check (eq? input (.call classy .remove input 2)) => #t)
      (check-equal? (.call classy .list<- input) '(1)))
    (test-case "Function elements retain exact wrappers through set operations and conversion"
      (def type (Fun Integer <- Integer))
      (def set (.cc Set<-Table. Table: (alist-table type Unit) sexp: 'function-set))
      (def styles (set-styles set)) (def classy (.@ styles Classy))
      (def a (.call classy .admit (.call set .<-list (list (lambda (_) "bad")))))
      (def f (car (.call classy .list<- a)))
      (check-exception (f 1) TypeError?)
      (def b (.call classy .ap (.call classy .unap a)))
      (def result (@@method a.inter b))
      (check (eq? f (car (@@method result.list<-))) => #t)
      (def posh (@@method result.convert 'posh))
      (check (eq? f (car (@@method posh.list<-))) => #t)
      (check-equal? (@@method b.count) 1))
    (test-case "set policy publication reuses batches inverse recovery and Reader IO"
      (def set RationalSet) (def table (.@ set Table))
      (def before (.call set .<-list '(1 2 5)))
      (def grants (.call set .<-list '(2 3 4))) (def revoked (.call set .<-list '(2 4)))
      (def calls 0)
      (def action (service.access-style-action set grants revoked (lambda (receiver)
        (set! calls (+ calls 1)) (for/collect (element receiver) element))))
      (check-equal? (action before) '(1 3 5))
      (check-equal? calls 1)
      (def styles (set-styles set)) (def linear (.@ styles Linear))
      (def after (.call set .<-list '(1 3 5)))
      (def delta (.call table .diff before after))
      (def state (.call linear .ap before))
      (def next (.call linear .apply-batch state (list delta (invert-table-delta delta))))
      (check-equal? (.call linear .list<- next) '(1 2 5))
      (check-exception (action 'bad) TypeError?)
      (check-equal? calls 1)
      (check-equal? (action before) '(1 3 5))
      (check-equal? calls 2))))
