(export inheritance-hooks-test)
(import :std/test ../object ../mop ../brace ../number
        ../inheritance-hooks ../reflection
        (prefix-in ../examples/inherited-services services.))
;; Exercise actual native protocol composition, not serialized model constants.
(def inheritance-hooks-test
  (test-suite "inherited hooks mutation and declared reflection"
    (test-case "inherited hooks compile cold slots without invoking bodies"
      (def events []) (def bodies 0)
      (def base (.o
        (compute-precedence-list (lambda (self next) (set! events (cons 'order events)) (next)))
        (compute-slot (lambda (self next slot)
          (def body (next)) (lambda () (body))))))
      (def audited (.o (:: @ base)
        (compute-slot (inherited)
          (lambda (self next slot)
            (def body ((inherited) self next slot))
            (lambda () (set! events (cons slot events)) (body))))))
      (def root (.o (value (begin (set! bodies (+ bodies 1)) 10))))
      (def object (with-inheritance-hooks audited root))
      (check-equal? (.all-slots object) '(value)) (check-equal? bodies 0)
      (check-equal? (.@ object value) 10) (check-equal? bodies 1)
      (check-equal? (.@ object value) 10) (check-equal? bodies 1)
      (check (member 'order events) => '(order))
      (check (car events) => 'value)
      (def child (.mix object))
      (check-equal? (.@ child value) 10)
      (check-equal? bodies 2)
      (def bad (.o (compute-precedence-list (lambda (_ next) (reverse (next))))))
      (check-exception (.@ (with-inheritance-hooks bad root) value) true))
    (test-case "diamond edits invalidate cached thunks values order and views"
      (def root (.o (value 1)))
      (def left (.mix root)) (def right (.mix root)) (def join (.mix left right))
      (check-equal? (.@ join value) 1)
      (def revision (object-revision join))
      (.putslot! root 'value ($constant-slot-spec 2))
      (check-equal? (object-revision join) (+ revision 1))
      (check-equal? (.@ join value) 2)
      (.putdefault! root 'extra #f)
      (check-equal? (.@ join extra) #f)
      (check-equal? (.all-slots/sort join) '(extra value))
      (.put! root 'value 9)
      (check-equal? (.@ root value) 9)
      (check-equal? (.@ join value) 2)
      (replace-object-supers! right [(.o (other 7))])
      (check-equal? (.@ join other) 7)
      (def before (object-revision root))
      (check-exception (replace-object-supers! root [join]) true)
      (check-equal? (object-revision root) before)
      (seal-object! root)
      (check-exception (.putslot! root 'value ($constant-slot-spec 99)) true)
      (check-exception (.put! root 'value 99) true)
      (check-equal? (.@ root value) 9))
    (test-case "protocol edits invalidate owners and failed construction retries"
      (def hook (.o (compute-slot (lambda (_ next slot) (next)))))
      (def object (with-inheritance-hooks hook (.o (value 1))))
      (check-equal? (.@ object value) 1)
      (.putslot! hook 'compute-slot ($constant-slot-spec (lambda (_ next slot)
        (def body (next)) (lambda () (+ 10 (body))))))
      (check-equal? (.@ object value) 11)
      (.putslot! hook 'compute-slot ($constant-slot-spec (lambda (_ next slot) #f)))
      (check-exception (.@ object value) true)
      (check (object-%instance object) => #f)
      (.putslot! hook 'compute-slot ($constant-slot-spec (lambda (_ next slot) (next))))
      (check-equal? (.@ object value) 1))
    (test-case "declared metadata composes inheritance and current public admission"
      (def amount (instance Slot type: Integer default: 10))
      (def private (instance Slot hidden: #t constant: 'secret))
      (def source (object<-declarations [(cons 'amount amount) (cons 'token private)]))
      (def service (.mix source))
      (check-equal? (map car (reflect-slots service)) '(amount))
      (check-equal? (map car (reflect-slots service include-hidden?: #t)) '(amount token))
      (check-exception (read-slot service 'token) true)
      (check-equal? (read-slot service 'amount) 10)
      (def revision (object-revision service))
      (check-exception (write-slot! service 'amount "bad") true)
      (check-equal? (object-revision service) revision)
      (.put! amount 'default 20)
      (check-equal? (read-slot service 'amount) 20)
      (write-slot! service 'amount 30)
      (check-equal? (read-slot service 'amount) 30)
      (check-equal? (read-slot source 'amount) 20)
      (.put! amount 'hidden #t)
      (check-equal? (reflect-slots service) [])
      (check-exception (read-slot service 'amount) true)
      (check-exception (object<-declarations [(cons 'x amount) (cons 'x amount)]) true))
    (test-case "class reflection optional absence and child visibility use existing Slot protocols"
      (define-type (Account @ Class.)
        slots: =>.+ {amount: {type: Integer default: 10} token: {hidden: #t constant: 'secret}})
      (def account (make-declared-instance Account amount: 12))
      (check-equal? (read-slot account 'amount) 12)
      (check-exception (read-slot account 'token) true)
      (check-exception (write-slot! account 'amount "bad") true)
      (write-slot! account 'amount 13)
      (check-equal? (read-slot account 'amount) 13)
      (def parent (object<-declarations [(cons 'amount (instance Slot constant: 7))]))
      (def child (object<-declarations [(cons 'amount (instance Slot hidden: #t constant: 8))]
        supers: [parent]))
      (check-equal? (reflect-slots child) [])
      (check-equal? (.@ child amount) 8)
      (def absent (object<-declarations [(cons 'missing (instance Slot optional: #t))]))
      (check-equal? (.all-slots absent) [])
      (check-equal? (map car (reflect-slots absent)) '(missing))
      (check-exception (read-slot absent 'missing) NoApplicableMethod?)
      (def bad-default (object<-declarations
        [(cons 'amount (instance Slot type: Integer default: "invalid"))]))
      (check-exception (read-slot bad-default 'amount) true)
      (def bad-hook (.o (compute-slot (lambda (_ next slot) (lambda () "invalid")))))
      (def transformed (object<-declarations
        [(cons 'amount (instance Slot type: Integer default: 7))] protocol: bad-hook))
      (check-exception (read-slot transformed 'amount) true)
      (object-protocol-set! transformed #f)
      (check-equal? (read-slot transformed 'amount) 7))
    (test-case "shared service revision and metadata refusal compose through FUN"
      (def demanded []) (def private-demands 0)
      (def family (services.make-services
        (lambda (slot) (set! demanded (cons slot demanded)))
        (lambda () (set! private-demands (+ private-demands 1)) 'secret)))
      (check-equal? (services.report family) '(10 10 10))
      (check-equal? private-demands 0)
      (def join-revision (object-revision (.@ family join)))
      (check-exception ((services.revision-action "bad") family) true)
      (check-equal? (object-revision (.@ family join)) join-revision)
      (check-equal? ((services.revision-action 20) family) '(20 20 20))
      (check-equal? (object-revision (.@ family join)) (+ join-revision 1))
      (.put! (.@ family amount) 'hidden #t)
      (check-exception (services.report family) true)
      (.put! (.@ family amount) 'hidden #f)
      (check-equal? (services.report family) '(20 20 20))
      (seal-object! (.@ family source))
      (check-exception ((services.revision-action 30) family) true)
      (check-equal? (services.report family) '(20 20 20))
      (check-equal? private-demands 0))
    (test-case "direct prototype merge retains declaration and protocol sources"
      (def amount (instance Slot type: Integer default: 10))
      (def protocol (.o (compute-slot (lambda (_ next slot)
        (def body (next)) (if (eq? slot 'amount) (lambda () (+ 1 (body))) body)))))
      (def declared (object<-declarations [(cons 'amount amount)] protocol: protocol))
      (def composed (.+ (.o (base 7)) declared))
      (def cloned (.cc declared))
      (def focused (.call (slot-lens 'amount) .set 30 declared))
      (check-equal? (read-slot cloned 'amount) 11)
      (check-equal? (read-slot focused 'amount) 31)
      (check-equal? (read-slot composed 'amount) 11)
      (check-equal? (.@ composed base) 7)
      (.put! amount 'default 20)
      (check-equal? (read-slot composed 'amount) 21)
      (check-equal? (read-slot cloned 'amount) 21)
      (check-equal? (read-slot focused 'amount) 31)
      (.put! amount 'hidden #t)
      (check-exception (read-slot composed 'amount) true)
      (check-exception (read-slot cloned 'amount) true)
      (check-exception (read-slot focused 'amount) true)
      (.put! amount 'hidden #f)
      (check-equal? (read-slot composed 'amount) 21)
      (.putslot! protocol 'compute-slot ($constant-slot-spec (lambda (_ next slot) (next))))
      (check-equal? (read-slot composed 'amount) 20)
      (check-equal? (read-slot cloned 'amount) 20)
      (check-equal? (read-slot focused 'amount) 30))
    (test-case "direct C3 hooks cannot mutate the source graph during admission"
      (def root (.o (value 7)))
      (def protocol (.o (compute-precedence-list (lambda (_ next)
        (.putslot! root 'value ($constant-slot-spec 8)) (next)))))
      (def target (with-inheritance-hooks protocol root))
      (check-exception (compute-precedence-list! target) true)
      (check-equal? (object-revision root) 0)
      (check (object-%precedence-list target) => #f)
      (object-protocol-set! target #f)
      (check-equal? (.@ target value) 7))
    (test-case "edits during a dependent computation refuse without losing old sources"
      (def root (.o (value 7)))
      (def child (.o (:: @ root) (bad (begin (.putslot! root 'value ($constant-slot-spec 8)) 0))))
      (check-exception (.@ child bad) true)
      (check-equal? (.@ root value) 7)
      (check-equal? (active-slot-computations) []))))
