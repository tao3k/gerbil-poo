(export generalized-prototype-test)
(import :std/test ../object (only-in ../mop Lens lens-of-get-set slot-lens) (prefix-in ../generalized-prototype gp.)
        (prefix-in ../examples/generalized-checkout checkout.))
;; Exercise actual native protocols and failures; no injected compiled snapshots.
(def generalized-prototype-test
  (test-suite "generalized future-work hooks"
    (test-case "shared diamond and FUN observations preserve independent audit frame"
      (def snapshot (checkout.prepare-checkout))
      (check-equal? (length (gp.prepared-fragments snapshot)) 4)
      (check-equal? (checkout.report snapshot) '(30 33 3))
      (check-equal? (caddr (gp.approximate snapshot checkout.base '(a b untouched) 0)) 'untouched)
      (check-equal? (caddr (gp.approximate snapshot checkout.base checkout.base 3)) 'audit)
      (check-equal? (checkout.total snapshot 3) 33)
      (check-exception (checkout.total snapshot -1) true))
    (test-case "preparation compiles once and never runs a method body"
      (def compiled 0) (def invoked 0)
      (def protocol (.cc gp.Protocol. cook: identity compile:
        (lambda (fragment) (set! compiled (+ compiled 1))
          (lambda (_ parent) (set! invoked (+ invoked 1)) (+ fragment (parent))))))
      (def snapshot (gp.prepare protocol '(1 2 3)))
      (check-equal? compiled 3) (check-equal? invoked 0)
      (check-equal? (gp.observe snapshot 0 99 2) 6)
      (check-equal? compiled 3) (check-equal? invoked 6))
    (test-case "ignoring inherited suffix does not force it and exceptions stop FUN bind"
      (def protocol (.cc gp.Protocol. cook: identity compile: identity))
      (def snapshot (gp.prepare protocol
        (list (lambda (_ parent) 7) (lambda _ (error "must stay delayed")))))
      (check-equal? (gp.step snapshot 0 0) 7)
      (def reached #f)
      (def action ((.@ gp.Observation. .bind)
        (lambda (_) (error "source hook failure"))
        (lambda (_) (set! reached #t) (.@ gp.Observation. .ap))))
      (check-exception (action 0) true) (check-equal? reached #f))
    (test-case "compatible public self extension preserves finite construction"
      (def protocol (gp.reindex-self checkout.protocol car
        (lambda (raw) (cons ((.@ checkout.protocol cook) raw) 'metadata))))
      (def snapshot (gp.prepare-inheritance protocol checkout.root checkout.declarations))
      (check-equal? ((car (gp.observe snapshot checkout.base checkout.base 2)) 'price) 33)
      (check-equal? (cdr (gp.observe snapshot checkout.base checkout.base 2)) 'metadata)
      (check-exception ((gp.sum-compiler identity identity) '(unknown . value)) true))
    (test-case "named cooking forces only demanded fields and memoizes false"
      (def forced 0)
      (def cook (gp.cook-fields (list
        (cons 'flag (lambda (_) (set! forced (+ forced 1)) #f))
        (cons 'unused (lambda (_) (error "unused field must stay delayed"))))))
      (def view (cook 'seed))
      (check-equal? forced 0)
      (check-equal? (view 'flag) #f) (check-equal? (view 'flag) #f)
      (check-equal? forced 1)
      (check-exception (view 'unknown) true)
      (check-exception (view 'unused) true)
      (check-exception (gp.cook-fields (list (cons 'a identity) (cons 'a identity))) true)
      (check-exception (gp.cook-fields '((a . 1))) true))
    (test-case "shared cooked self is local to one stage and one observation seed"
      (def cooked 0)
      (def protocol (.cc gp.Protocol. cook:
        (lambda (value) (set! cooked (+ cooked 1)) value) compile:
        (lambda (_) (lambda (self parent) (+ (self) (self) (parent))))))
      (def snapshot (gp.prepare protocol '(unit)))
      (check-equal? (gp.step snapshot 2 5) 9)
      (check-equal? cooked 1)
      (def observe (gp.bind-observer snapshot 5 1))
      (check-equal? (observe 2) 9) (check-equal? cooked 3)
      (check-equal? (observe 9) 23) (check-equal? cooked 5)
      (check-exception (gp.bind-observer snapshot 5 -1) true))
    (test-case "native composed lenses preserve nested service metadata and both audits"
      (def focus (.call Lens .compose (slot-lens 'checkout)
        (lens-of-get-set caddr (lambda (value raw) (list (car raw) (cadr raw) value)))))
      (def revised (.call focus .set 'revised checkout.nested-base))
      (check-equal? (.call focus .get revised) 'revised)
      (check-equal? (.call focus .get checkout.nested-base) 'audit)
      (check-equal? (.@ revised service) 'billing)
      (def snapshot (checkout.prepare-nested))
      (check-equal? (checkout.nested-report snapshot) '(39 3 billing))
      (def raw (gp.approximate snapshot checkout.nested-base checkout.nested-base 2))
      (check-equal? (caddr (.@ raw checkout)) 'audit)
      (check-equal? (.@ raw service) 'billing))
    (test-case "focused assembly writes once per nonempty stage and preserves frame"
      (def writes 0)
      (def focus (lens-of-get-set car (lambda (value raw) (set! writes (+ writes 1)) (cons value (cdr raw)))))
      (def cook (lambda (raw) ((.@ checkout.protocol cook) (car raw))))
      (def base (cons checkout.base 'frame))
      (def fragments (gp.prepared-fragments (checkout.prepare-checkout)))
      (def outer (gp.focus-protocol checkout.protocol focus identity cook))
      (def plain (gp.prepare outer fragments))
      (check-equal? ((gp.observe plain base base 2) 'price) 33)
      (check-equal? writes 8)
      (set! writes 0)
      (def fused (gp.prepare-focused checkout.protocol focus identity cook fragments))
      (check-equal? ((gp.observe fused base base 2) 'price) 33)
      (check-equal? writes 2)
      (check-equal? (cdr (gp.approximate fused base base 2)) 'frame)
      (set! writes 0)
      (def empty (gp.prepare-focused checkout.protocol focus identity cook []))
      (check (eq? (gp.approximate empty base base 1) base) => #t)
      (check-equal? writes 0))
    (test-case "joint service revision cannot reuse an old approval or observed seed"
      (check-equal? (checkout.envelope-report checkout.envelope-base) '(45 3 billing eu #t))
      (check-equal? (checkout.envelope-report checkout.envelope-base #f) '(45 3 billing eu #t))
      (def revised (.cc checkout.envelope-base tenant: 'us))
      (check-equal? (checkout.envelope-report revised) '(45 3 billing us #t))
      (check-equal? (checkout.envelope-report checkout.envelope-base) '(45 3 billing eu #t))
      (check-exception (checkout.envelope-report (.cc revised approved: #f)) true)
      (check-exception (checkout.envelope-report (.cc revised approved: #f) #f) true)
      (check-exception (checkout.envelope-report (.cc revised approved: 0)) true)
      (check-exception (checkout.envelope-report (.cc revised approved: "yes") #f) true)
      (def raw (gp.approximate (checkout.prepare-envelope) revised revised 2))
      (check-equal? (caddr (.@ (.@ raw billing) checkout)) 'audit)
      (check-equal? (.@ (.@ raw billing) service) 'billing))
    (test-case "Reader map evaluates once and propagates failures before projection"
      (def calls 0) (def projected 0)
      (def mapped ((.@ gp.Observation. .map)
        (lambda (value) (set! projected (+ projected 1)) (not value))
        (lambda (value) (set! calls (+ calls 1)) value)))
      (check-equal? (mapped #f) #t) (check-equal? (mapped #t) #f)
      (check-equal? calls 2) (check-equal? projected 2)
      (def failed ((.@ gp.Observation. .map)
        (lambda (_) (set! projected (+ projected 1))) (lambda (_) (error "reader failure"))))
      (check-exception (failed 0) true) (check-equal? projected 2))
    (test-case "context binding selects current base and seed independently"
      (def compiled 0)
      (def protocol (.cc gp.Protocol. cook: identity compile:
        (lambda (_) (set! compiled (+ compiled 1))
          (lambda (self parent) (+ (self) (parent))))))
      (def snapshot (gp.prepare protocol '(sum)))
      (def reader (gp.bind-context-observer snapshot 1 car cdr))
      (check-equal? (reader '(5 . 2)) 7) (check-equal? (reader '(9 . 3)) 12)
      (check-equal? compiled 1)
      (check-equal? ((gp.bind-context-observer snapshot 0 car cdr) '(9 . 3)) 3)
      (check-exception (gp.bind-context-observer snapshot -1 car cdr) true))
    (test-case "one reusable report reads fresh tenant and approval after refusal"
      (def report (checkout.bind-envelope-report))
      (def revised (.cc checkout.envelope-base tenant: 'us))
      (check-equal? (report checkout.envelope-base) '(45 3 billing eu #t))
      (check-equal? (report revised) '(45 3 billing us #t))
      (def split (gp.bind-context-observer (checkout.prepare-envelope) 2 car cdr))
      (check-exception ((split (cons (.cc revised approved: #f) checkout.envelope-base)) 'price) true)
      (check-equal? ((split (cons revised (.cc checkout.envelope-base approved: #f))) 'price) 45)
      (check-exception (report (.cc revised approved: #f)) true)
      (check-exception (report (.cc revised approved: 0)) true)
      (check-exception (report (.cc revised approved: "yes")) true)
      (check-equal? (report checkout.envelope-base) '(45 3 billing eu #t)))
    (test-case "item representation preserves shared C3 lenses approvals and recovery"
      (def compact (checkout.bind-envelope-items-report))
      (def qualified (checkout.bind-envelope-report))
      (def revised (.cc checkout.envelope-base tenant: 'us))
      (for-each (lambda (raw) (check-equal? (compact raw) (qualified raw)))
        (list checkout.envelope-base revised checkout.envelope-base))
      (for-each (lambda (policy)
        (check-exception (compact (.cc revised approved: policy)) true)
        (check-exception (qualified (.cc revised approved: policy)) true)) (list #f 0 "yes"))
      (check-equal? (compact revised) '(45 3 billing us #t))
      (def snapshot (checkout.prepare-envelope-items))
      (def split (gp.bind-context-observer snapshot 2 car cdr))
      (check-exception ((split (cons (.cc revised approved: #f) checkout.envelope-base)) 'price) true)
      (check-equal? ((split (cons revised (.cc checkout.envelope-base approved: #f))) 'price) 45)
      (def raw (gp.approximate snapshot revised revised 2))
      (def local (.@ (.@ raw billing) checkout))
      (check-equal? (length (car local)) 4) (check-equal? (length (cadr local)) 1)
      (check (andmap procedure? (append (car local) (cadr local))) => #t)
      (check-equal? (caddr local) 'audit)
      (check-equal? (.@ (.@ raw billing) service) 'billing))
    (test-case "native C3 inconsistency is retained before fragment compilation"
      (def x (.o)) (def y (.o))
      (def xy (.mix x y)) (def yx (.mix y x))
      (def bad (.mix xy yx))
      (def reached #f)
      (check-exception (gp.prepare-inheritance checkout.protocol bad
        (lambda (_) (set! reached #t) [])) true)
      (check-equal? reached #f))))
