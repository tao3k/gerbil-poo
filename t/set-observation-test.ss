;;; Complete Set reads retain admission, backend order and ownership observations.
(export set-observation-test)
(import :std/test :std/error :std/iter
        (only-in ../brace @@method)
        ../object ../mop ../number ../type ../table ../rationaldict
        (only-in ./table-testing alist-table)
        (prefix-in ../examples/service-collection service.)
        (prefix-in (only-in ../examples/contract-publication publication-action) publication.)
        (prefix-in ../declarative-metadata metadata.))

;; Preserve the precise cause of user and backend refusal for identity controls.
(def (cause-of action) (with-catch identity (lambda () (action) #f)))
;; Route the entire read family through its public element-level signatures.
(def (read-set descriptor method root callback)
  (case method
    ((.foldl .foldr) ((.ref descriptor method) (lambda (elt sum) (callback elt) (+ elt sum)) 0 root))
    ((.for-each .for-each/reverse) ((.ref descriptor method) callback root))
    ((.elt?) (.call descriptor .elt? root 1))
    (else ((.ref descriptor method) root))))
;; One finite list makes full family coverage explicit without another read engine.
(def reads '(.foldl .foldr .for-each .for-each/reverse .count .list<- .elt?))

;; The backing admits procedures; the independent Elt supplies actual call wrapping.
;; Use the existing association backend and its declared key-equivalence registry.
(def (function-access-fixture)
  (def procedure-type (.cc Type. .element?: procedure?))
  (def table (alist-table procedure-type Unit))
  (def signature (Fun Integer <- Integer))
  (values table signature (.cc Set<-Table. Table: table Elt: signature)))

(def set-observation-test
  (test-suite "complete Set observation admission"
    (test-case "independent Elt constrains whole roots and cannot be weakened by a custom recognizer"
      (def table (RationalDict Unit)) (def descriptor (.cc Set<-Table. Table: table Elt: (UIntN 8)))
      (def invalid (.call table .singleton 256 (void))) (def callbacks 0)
      (check (element? descriptor invalid) => #f)
      (def broad (.cc descriptor .element?: (lambda (_) #t)))
      (for-each (lambda (method)
        (check-exception (read-set broad method invalid
          (lambda (_) (set! callbacks (+ callbacks 1)))) TypeError?)) reads)
      (check-exception (.call broad .iter<- invalid) TypeError?)
      (check-exception (.call broad .filter (lambda (_) (set! callbacks (+ callbacks 1)) #t) invalid) TypeError?)
      (check-exception (.call broad .union invalid invalid) TypeError?)
      (check-exception (.call broad .json<- invalid) TypeError?)
      (check-equal? callbacks 0)
      (check-exception (validate descriptor invalid) TypeError?)
      (def valid (.call descriptor .<-list '(0 255)))
      (check (element? descriptor valid) => #t)
      (check-equal? (.call descriptor .list<- valid) '(0 255))
      ;; This explicit style identity boundary is retained, not guessed from subtyping.
      (check-exception (set-styles descriptor)
        (lambda (cause) (and (Error? cause) (equal? (Error-message cause) "incompatible set style descriptor")))))
    (test-case "bulk and iterator admission check original Elt occurrences before numeric alias coalescing"
      (def table (RationalDict Unit))
      (def exact-type (.cc Integer .element?: exact-integer?))
      (def descriptor (.cc Set<-Table. Table: table Elt: exact-type))
      (check-exception (.call descriptor .<-list '(1.0 1)) TypeError?)
      (check-exception (.call descriptor .<-iter (iter '(1.0 1))) TypeError?)
      (check-exception (.call descriptor .singleton 1.0) TypeError?)
      (check-equal? (.call descriptor .list<- (.call descriptor .<-list '(1 1 2))) '(1 2))
      (def root (.call descriptor .<-list '(1 2)))
      (check-exception (.call descriptor .<-iter (iter '(1.0 1)) root) TypeError?)
      (check-equal? (.call descriptor .list<- root) '(1 2))
      (check-equal? (.call descriptor .list<- (.call descriptor .<-iter (iter '(2 3)) root)) '(1 2 3)))
    (test-case "membership lens split and cursor bounds enforce the declared element and backing domains"
      (def raw (RationalDict Unit)) (def queries 0) (def writes 0)
      (def table (.cc raw
        .key?: (lambda (root key) (set! queries (+ queries 1)) (.call raw .key? root key))
        .acons: (lambda (key value root) (set! writes (+ writes 1)) (.call raw .acons key value root))))
      (def descriptor (.cc Set<-Table. Table: table Elt: (UIntN 8)))
      (def empty (.@ raw .empty)) (def root (.call descriptor .<-list '(1 2)))
      (set! queries 0) (set! writes 0)
      (check-exception (.call descriptor .elt? empty 256) TypeError?)
      (def focus (.call descriptor .lens 256))
      (check-exception (.call focus .get empty) TypeError?)
      (check-exception (.call focus .set #t empty) TypeError?)
      (check-exception (.call descriptor .split 256 root) TypeError?)
      (check-exception (.call descriptor .iter<- root from: 256) TypeError?)
      (check-equal? queries 0) (check-equal? writes 0)
      (check (.call descriptor .elt? root 255) => #f)
      (check-equal? (for/collect (elt (.call descriptor .iter<- root from: 2)) elt) '(2))
      (def matched (.cc Set<-Table. Table: (.cc raw Key: (UIntN 8))))
      (check-exception (.call matched .elt? empty 256) TypeError?)
      (def wider (.cc Set<-Table. Table: (.cc raw Key: UInt) Elt: Rational))
      (check-exception (.call wider .elt? empty -1) TypeError?)
      (check-exception (.call wider .cons -1 empty) TypeError?)
      (def boolean-set (.cc Set<-Table. Table: (alist-table Bool Unit)))
      (def booleans (.call boolean-set .singleton #f))
      (check (.call boolean-set .elt? booleans #f) => #t)
      (check-exception (.call boolean-set .elt? booleans 0) TypeError?))
    (test-case "independent Function Elt validation keeps wrappers while backing and source remain unchanged"
      (defvalues (table signature descriptor) (function-access-fixture))
      (def calls 0) (def raw (lambda (n) (set! calls (+ calls 1)) (+ n 1)))
      (def source (.call table .singleton raw (void)))
      (def checked (validate descriptor source))
      (def grant (.call descriptor .choose checked))
      (check (eq? grant raw) => #f)
      (check (eq? (car (.call table .choose source)) raw) => #t)
      (check-equal? calls 0)
      (check-exception (grant "bad") TypeError?)
      (check-equal? calls 0)
      (check-equal? (grant 3) 4)
      (check-equal? calls 1)
      (check (eq? (.call descriptor .choose checked) grant) => #t)
      ;; Composite keys retain the recursive validator's returned container too.
      (def vectors (alist-table (.cc Type. .element?: vector?) Unit))
      (def nested (.cc Set<-Table. Table: vectors Elt: (Tuple signature Bool)))
      (def original (vector (lambda (_) 'wrong) #f))
      (def raw-root (.call vectors .singleton original (void)))
      (def cooked (.call nested .choose (validate nested raw-root)))
      (check (eq? cooked original) => #f)
      (check-equal? (vector-ref cooked 1) #f)
      (check-exception ((vector-ref cooked 0) 3) TypeError?)
      (check ((vector-ref original 0) 3) => 'wrong))
    (test-case "Elt normalization uses one complete business constructor and no forbidden intermediate root"
      (defvalues (raw signature _descriptor) (function-access-fixture))
      (def constructions 0)
      (def table (.o (:: @ raw)
        (.empty (error "business empty must not run"))
        .element?: (lambda (root) (and (element? raw root) (= (.call raw .count root) 2)))
        .<-list: (lambda (rows) (set! constructions (+ constructions 1)) (.call raw .<-list rows))))
      (def descriptor (.cc Set<-Table. Table: table Elt: signature))
      (def source (.call raw .<-list (list (cons (lambda (n) (+ n 1)) (void))
        (cons (lambda (n) (* n 2)) (void)))))
      (def checked (validate descriptor source))
      (check-equal? constructions 1)
      (check-equal? (.call descriptor .foldl (lambda (grant sum) (+ sum (grant 3))) 0 checked) 10)
      ;; No-change children need neither a key registry nor a business constructor.
      (def stable (.cc (RationalDict Unit) .key-table: #f .<-list: (lambda (_) (error "unexpected reconstruction"))))
      (def narrowed (.cc Set<-Table. Table: stable Elt: Integer))
      (def unchanged (.call (RationalDict Unit) .singleton 1 (void)))
      (check (eq? (validate narrowed unchanged) unchanged) => #t))
    (test-case "normalized collisions and original child failures suppress construction and allow a fresh retry"
      (def raw (RationalDict Unit)) (def constructions 0) (def preparations 0) (def mode 'collision)
      (def cause (list 'element-validation-refused))
      (def element (.cc Integer .validate: (lambda (n)
        (case mode ((collision) 0) ((refuse) (if (= n 2) (raise cause) n)) (else (+ n 10))))))
      (def table (.cc raw
        .key-table: (lambda (value) (set! preparations (+ preparations 1)) (.call raw .key-table value))
        .<-list: (lambda (rows) (set! constructions (+ constructions 1)) (.call raw .<-list rows))))
      (def descriptor (.cc Set<-Table. Table: table Elt: element))
      (def source (.call raw .<-list (list (cons 1 (void)) (cons 2 (void)))))
      (check-exception (validate descriptor source) TypeError?)
      (check-equal? constructions 0)
      (set! mode 'refuse) (set! preparations 0)
      (check (eq? (cause-of (lambda () (validate descriptor source))) cause) => #t)
      (check-equal? preparations 0) (check-equal? constructions 0)
      (set! mode 'retry)
      (check-equal? (.call descriptor .list<- (validate descriptor source)) '(11 12))
      (check-equal? constructions 1)
      (check-equal? (map car (.call raw .list<- source)) '(1 2)))
    (test-case "backing and independent Elt validators run once in declared order without recooking reconstructed keys"
      (def backing-calls []) (def element-calls [])
      (def key (.cc Integer .validate: (lambda (n)
        (set! backing-calls (cons n backing-calls)) (+ n 100))))
      (def element (.cc Integer .validate: (lambda (n)
        (set! element-calls (cons n element-calls)) (+ n 10))))
      (def table (.cc (RationalDict Unit) Key: key))
      (def source (.call table .<-list (list (cons 1 (void)) (cons 2 (void)))))
      (def descriptor (.cc Set<-Table. Table: table Elt: element))
      (check-equal? (.call descriptor .list<- (validate descriptor source)) '(111 112))
      (check-equal? (reverse backing-calls) '(1 2))
      (check-equal? (reverse element-calls) '(101 102))
      (set! backing-calls []) (set! element-calls [])
      (def aligned (.cc Set<-Table. Table: table))
      (check-equal? (.call aligned .list<- (validate aligned source)) '(101 102))
      (check-equal? (reverse backing-calls) '(1 2))
      (check-equal? element-calls []))
    (test-case "approved Function access composes refine exact evidence FUN and five ownership styles"
      (defvalues (raw signature descriptor) (function-access-fixture))
      (def target (.cc Set<-Table. Table: (alist-table signature Unit)))
      (def invocation (metadata.contract (metadata.predicate "request" object?)
        (metadata.predicate "result" object?) (lambda (_key _request _result) #t) metadata.truth))
      (def request-context (.o tenant: 'access))
      (def effects 0) (def delivered #f) (def protocol #f)
      (def submission (service.approved-access-contract descriptor))
      (def action (publication.publication-action submission invocation request-context (lambda (candidate)
        (def installed-owner (.call protocol .ap (.@ candidate access)))
        (def result (.call protocol .foldl (lambda (grant sum) (+ sum (grant 3))) 0 installed-owner))
        (set! delivered installed-owner) (set! effects (+ effects 1))
        (check-equal? result 4)
        (values (.o subject: candidate descriptor: submission context: request-context owner: installed-owner) request-context))))
      (def source (.call raw .singleton (lambda (n) (+ n 1)) (void)))
      (check-exception (action (.o approved: #f access: source)) TypeError?)
      (check-equal? effects 0)
      (for-each (lambda (name)
        (set! protocol (.ref (set-styles target) name))
        (defvalues (result next refusal) (action (.o approved: #t access: source)))
        (check-equal? refusal #f)
        (check (eq? next request-context) => #t)
        (check (eq? (.@ result owner) delivered) => #t)
        (check (eq? (.call protocol .unap delivered) (.@ result subject access)) => #t)
        (def grant (.call protocol .choose delivered))
        (check-exception (grant "bad") TypeError?)) '(Pure Mutable Linear Posh Classy))
      (check-equal? effects 5)
      (def invalid (.call raw .singleton (lambda (_) 'wrong) (void)))
      (defvalues (failed retained refusal) (action (.o approved: #t access: invalid)))
      (check-equal? failed #f)
      (check (eq? retained request-context) => #t)
      (check-equal? (metadata.failure-phase refusal) 'source)
      (check (TypeError? (metadata.failure-cause refusal)) => #t)
      (check-equal? effects 5)
      (check (eq? (car (.call raw .choose source)) (.call descriptor .choose source)) => #t))
    (test-case "all reads and construction refuse recursive Set admission and restore the scope"
      (def table (RationalDict Unit))
      (def root (.call table .singleton 1 (void)))
      (def calls 0) (def recursive? #t)
      (def descriptor (.cc Set<-Table. Table: table .element?: (lambda (snapshot)
        (set! calls (+ calls 1))
        ;; A bounded negative control cannot overflow even if the guard regresses.
        (when (and recursive? (> calls 3)) (error "unexpected repeated Set recognizer"))
        (when recursive? (.call descriptor .count snapshot))
        (element? table snapshot))))
      (def operations (append
        (map (lambda (method) (lambda () (read-set descriptor method root (lambda (_) (error "unexpected user callback"))))) reads)
        (list (lambda () (.call descriptor .iter<- root))
              (lambda () (.call descriptor .cons 2 root))
              (lambda () (.call descriptor .singleton 2))
              (lambda () (.call descriptor .union root root))
              (lambda () (validate descriptor root)))))
      (for-each (lambda (operation)
        (set! calls 0)
        (def cause (cause-of operation))
        (check (and (Error? cause) (equal? (Error-message cause) "recursive table observation admission")) => #t)
        (check-equal? calls 1)) operations)
      (set! recursive? #f) (set! calls 0)
      (check-equal? (.call descriptor .list<- root) '(1))
      (check-equal? calls 1)
      (check-equal? (.call descriptor .list<- (.call descriptor .cons 2 root)) '(1 2)))
    (test-case "mutual Set admission refuses at the repeated receiver but backing observations remain legal"
      (def table (RationalDict Unit))
      (def root (.call table .singleton 1 (void)))
      (def left-calls 0) (def right-calls 0) (def recursive? #t)
      (def left (.cc Set<-Table. Table: table .element?: (lambda (snapshot)
        (set! left-calls (+ left-calls 1))
        (when (> left-calls 3) (error "unexpected mutual recursion"))
        (.call right .count snapshot)
        (element? table snapshot))))
      (def right (.cc Set<-Table. Table: table .element?: (lambda (snapshot)
        (set! right-calls (+ right-calls 1))
        (when recursive? (.call left .list<- snapshot))
        ;; A different receiver over the same persistent root is a legal query.
        (= (.call table .count snapshot) 1))))
      (def cause (cause-of (lambda () (.call left .list<- root))))
      (check (and (Error? cause) (equal? (Error-message cause) "recursive table observation admission")) => #t)
      (check-equal? left-calls 1) (check-equal? right-calls 1)
      (set! recursive? #f) (set! left-calls 0) (set! right-calls 0)
      (check-equal? (.call left .list<- root) '(1))
      (check-equal? left-calls 1) (check-equal? right-calls 1))
    (test-case "a recognizer can observe the same receiver at a distinct root without false recursion"
      (def table (RationalDict Unit))
      (def empty (.@ table .empty)) (def root (.call table .singleton 1 (void)))
      (def descriptor (.cc Set<-Table. Table: table .element?: (lambda (snapshot)
        (when (eq? snapshot root) (.call descriptor .count empty))
        (element? table snapshot))))
      (check-equal? (.call descriptor .list<- root) '(1))
      (check-equal? (.call descriptor .count empty) 0))
    (test-case "Function grant publication across all styles refuses cyclic policy and retries without recooking"
      (def callback (Fun Integer <- Integer))
      (def grant (validate callback (lambda (n) (+ n 4))))
      (def table (alist-table callback Unit))
      (def root (.call table .singleton grant (void)))
      (def recursive? #f) (def admissions 0) (def effects 0) (def calls 0)
      (def descriptor (.cc Set<-Table. Table: table .element?: (lambda (snapshot)
        (set! admissions (+ admissions 1))
        (when (and recursive? (> admissions 3)) (error "unexpected policy recursion"))
        (when recursive? (.call descriptor .count snapshot))
        (element? table snapshot))))
      (for-each (lambda (name)
        (set! recursive? #f)
        (def protocol (.ref (set-styles descriptor) name))
        (def owner (.call protocol .ap root))
        (def action (service.fold-access-action protocol
          (lambda (f sum) (set! calls (+ calls 1))
            (check (eq? f grant) => #t) (+ sum (f 3))) 0
          (lambda (sum) (set! effects (+ effects 1)) sum)))
        (set! admissions 0) (set! recursive? #t)
        (def cause (cause-of (lambda () (action owner))))
        (check (and (Error? cause) (equal? (Error-message cause) "recursive table observation admission")) => #t)
        (check-equal? admissions 1)
        (set! recursive? #f)
        (check (eq? (.call protocol .unap owner) root) => #t)
        (check-equal? (action owner) 7)) '(Pure Mutable Linear Posh Classy))
      (check-equal? calls 5) (check-equal? effects 5)
      (check-exception (grant "bad") TypeError?))
    (test-case "every raw read refuses a valid backing root excluded by the Set refinement"
      (def table (RationalDict Unit))
      (def descriptor (.cc Set<-Table. Table: table .element?: (lambda (root)
        (and (element? table root) (= (.call table .count root) 2)))))
      (def excluded (.call table .<-list (list (cons 1 (void)))))
      (def callbacks 0)
      (for-each (lambda (method)
        (check-exception (read-set descriptor method excluded (lambda (_) (set! callbacks (+ callbacks 1)))) TypeError?)) reads)
      (check-equal? callbacks 0))
    (test-case "malformed carriers refuse before callbacks across the read family"
      (def descriptor (.cc Set<-Table. Table: (RationalDict Unit)))
      (def callbacks 0)
      (for-each (lambda (method)
        (check-exception (read-set descriptor method 'bad (lambda (_) (set! callbacks (+ callbacks 1)))) TypeError?)) reads)
      (check-equal? callbacks 0))
    (test-case "both folds and visits keep backend order and visits discard arbitrary results"
      (def descriptor (.cc Set<-Table. Table: (RationalDict Unit)))
      (def root (.call descriptor .<-list '(1 2 3)))
      (check-equal? (.call descriptor .foldl cons [] root) '(3 2 1))
      (check-equal? (.call descriptor .foldr cons [] root) '(1 2 3))
      (def trace [])
      (check (void? (.call descriptor .for-each (lambda (elt) (set! trace (cons elt trace)) (values elt elt)) root)) => #t)
      (check-equal? trace '(3 2 1))
      (set! trace [])
      (check (void? (.call descriptor .for-each/reverse (lambda (elt) (set! trace (cons elt trace)) 'ignored) root)) => #t)
      (check-equal? trace '(1 2 3))
      (check-equal? (.call descriptor .foldl + 40 (.@ descriptor .empty)) 40))
    (test-case "empty reads still check the caller callback"
      (def descriptor (.cc Set<-Table. Table: (RationalDict Unit)))
      (def empty (.@ descriptor .empty))
      (for-each (lambda (method)
        (check-exception ((.ref descriptor method) 'bad 0 empty) ContractViolation?)) '(.foldl .foldr))
      (for-each (lambda (method)
        (check-exception ((.ref descriptor method) 'bad empty) ContractViolation?)) '(.for-each .for-each/reverse)))
    (test-case "count list and membership retain specialized backend delegates"
      (def raw (RationalDict Unit)) (def counts 0) (def lists 0) (def probes 0)
      (def table (.cc raw
        .count: (lambda (root) (set! counts (+ counts 1)) (.call raw .count root))
        .list<-: (lambda (root) (set! lists (+ lists 1)) (reverse (.call raw .list<- root)))
        .key?: (lambda (root key) (set! probes (+ probes 1)) (.call raw .key? root key))))
      (def descriptor (.cc Set<-Table. Table: table))
      (def root (.call raw .<-list (list (cons 1 (void)) (cons 2 (void)))))
      (check-equal? (.call descriptor .count root) 2)
      (check-equal? (.call descriptor .list<- root) '(2 1))
      (check (.call descriptor .elt? root 1) => #t)
      (check-equal? (list counts lists probes) '(1 1 1)))
    (test-case "opaque accumulators and checked Function elements retain identity"
      (def signature (Fun Integer <- Integer))
      (def f (validate signature (lambda (x) (+ x 1))))
      (def g (validate signature (lambda (_) 'bad)))
      (def descriptor (.cc Set<-Table. Table: (alist-table signature Unit)))
      (def root (.call descriptor .<-list (list f g)))
      (def leaves (.call descriptor .list<- root))
      (check (and (memq f leaves) (memq g leaves) #t) => #t)
      (def result (.call descriptor .foldl (lambda (elt acc) (vector (+ 1 (vector-ref acc 0)) (cons elt (vector-ref acc 1)))) (vector 0 []) root))
      (check-equal? (vector-ref result 0) 2)
      (check (and (memq f (vector-ref result 1)) (memq g (vector-ref result 1)) #t) => #t)
      (check-exception (g 1) TypeError?)
      (check-equal? (f 1) 2))
    (test-case "metadata stays protected across callbacks and lazy delegate lookup"
      (def raw (RationalDict Unit)) (def dependency (.o epoch: 0))
      (def root (.call raw .<-list (list (cons 1 (void)) (cons 2 (void)))))
      (def descriptor (.cc Set<-Table. Table: raw .sources: (list dependency) epoch: 0))
      (check-exception (.call descriptor .for-each (lambda (_) (.set! dependency epoch 1)) root) Error?)
      (check-equal? (.@ dependency epoch) 0)
      (check-exception (.call descriptor .foldr (lambda (_ acc) (.set! descriptor epoch 1) acc) 0 root) Error?)
      (check-equal? (.@ descriptor epoch) 0)
      (def table (.o (:: @ raw) (.count (begin (.set! dependency epoch 1) (.@ raw .count)))))
      (def guarded (.cc Set<-Table. Table: table .sources: (list dependency)))
      (check-exception (.call guarded .count root) Error?)
      (check-equal? (.@ dependency epoch) 0))
    (test-case "callback failure keeps its prefix and cause and suppresses IO until retry"
      (def descriptor (.cc Set<-Table. Table: (RationalDict Unit)))
      (def root (.call descriptor .<-list '(1 2 3)))
      (def trace []) (def effects 0) (def fail? #t) (def cause (list 'refused))
      (def action (service.fold-access-action descriptor (lambda (elt total)
        (set! trace (cons elt trace)) (when (and fail? (= elt 2)) (raise cause)) (+ elt total)) 0
        (lambda (total) (set! effects (+ effects 1)) total)))
      (check-eq? (cause-of (cut action root)) cause)
      (check-equal? trace '(2 1)) (check-equal? effects 0)
      (set! fail? #f) (set! trace [])
      (check-equal? (action root) 6)
      (check-equal? trace '(3 2 1)) (check-equal? effects 1)
      (check-equal? (.call descriptor .list<- root) '(1 2 3)))
    (test-case "five styles and receivers preserve element arity and nonconsuming reads"
      (def descriptor (.cc Set<-Table. Table: (RationalDict Unit)))
      (def family (set-styles descriptor))
      (def root (.call descriptor .<-list '(1 2 3)))
      (for-each (lambda (name)
        (def protocol (.ref family name)) (def owner (.call protocol .ap root))
        (check-equal? (.call protocol .foldl + 0 owner) 6)
        (check-equal? (.call protocol .foldr cons [] owner) '(1 2 3))
        (def trace [])
        (.call protocol .for-each (lambda (elt) (set! trace (cons elt trace))) owner)
        (check-equal? trace '(3 2 1))
        (set! trace [])
        (.call protocol .for-each/reverse (lambda (elt) (set! trace (cons elt trace))) owner)
        (check-equal? trace '(1 2 3))
        (check-equal? (.call protocol .count owner) 3)
        (check-equal? (.call protocol .list<- owner) '(1 2 3))
        (check (.call protocol .elt? owner 2) => #t)
        (when (memq name '(Posh Classy))
          (set! trace [])
          (@@method owner.for-each (lambda (elt) (set! trace (cons elt trace))))
          (check-equal? trace '(3 2 1)))) '(Pure Mutable Linear Posh Classy)))
    (test-case "reentrant receiver publication cannot change the captured traversal"
      (def descriptor (.cc Set<-Table. Table: (RationalDict Unit)))
      (def protocol (.@ (set-styles descriptor) Classy))
      (def owner (.call protocol .ap (.call descriptor .<-list '(1 2 3))))
      (def trace [])
      (@@method owner.for-each (lambda (elt)
        (set! trace (cons elt trace)) (when (= elt 1) (@@method owner.cons 4))))
      (check-equal? trace '(3 2 1))
      (check-equal? (@@method owner.list<-) '(1 2 3 4)))))
