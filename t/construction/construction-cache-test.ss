(export construction-cache-test)
(import :std/test :std/iter (only-in :std/list/list delete-duplicates/hash) :clan/poo/object :clan/poo/support/option
        (prefix-in :clan/poo/dependency-analysis code.) (prefix-in :clan/poo/generalized-graph graph.)
        (prefix-in :clan/poo/construction-cache cache.))
(def (value cache key) (code.success-value (some-value (cache.cache-ref cache key))))
(def (caught thunk) (try (thunk) #f (catch (cause) cause)))
(def construction-cache-test
  (test-suite "shared materialization and source-bound invalidation"
    (test-case "shared nodes execute once and clean builders are skipped"
      (def source (graph.declaration '(join right left input absent)
        (list (cons 'left (code.need 'input (cut + <> 1)))
              (cons 'right (code.need 'input (cut * <> 2)))
              (cons 'join (code.both (code.need 'left identity) (code.need 'right identity) +)))
        (list (cons 'input (some (code.make-success 10))))))
      (def calls [])
      (def old (cache.start source (.cc cache.Builder. allow: (lambda (key) (set! calls (cons key calls)) #t))))
      (check-equal? (value old 'join) 31)
      (check-equal? (length calls) 5)
      (check-equal? (length (delete-duplicates/hash calls)) 5)
      (def reject (.cc cache.Builder. allow: (lambda (_) #f)))
      (def retained (cache.refresh old (cache.cache-source old) reject))
      (check-equal? (cache.cache-evaluated retained) [])
      (check-equal? (length (cache.cache-reused retained)) 5)
      (check (eq? (cache.cache-ref old 'join) (cache.cache-ref retained 'join)) => #t)
      (def changed (graph.define (cache.cache-source old) 'left (code.need 'input (cut + <> 3))))
      (def next (cache.refresh old changed (.cc cache.Builder. allow: (cut memq <> '(left join)))))
      (check-equal? (cache.cache-evaluated next) '(left join))
      (check-equal? (value next 'join) 33)
      (check (eq? (cache.cache-ref old 'right) (cache.cache-ref next 'right)) => #t)
      (def cold (cache.start changed))
      (for (key '(left right join input absent))
        (check-equal? (if (cache.cache-ref next key) (value next key) 'absent)
                      (if (cache.cache-ref cold key) (value cold key) 'absent))))
    (test-case "checked schedules survive bodies and values, not changed edges"
      (def source (graph.declaration '(join left right root)
        (list (cons 'left (code.need 'root identity)) (cons 'right (code.need 'root identity))
              (cons 'join (code.both (code.need 'left identity) (code.need 'right identity) +)))
        (list (cons 'root (some (code.make-success 3))))))
      (def prior (graph.schedule source))
      (def edited (graph.define source 'left (code.need 'root (cut + <> 7))))
      (def retained (graph.reschedule prior edited))
      (check (eq? (graph.schedule-order retained) (graph.schedule-order prior)) => #t)
      (check (eq? (graph.schedule-reads retained) (graph.schedule-reads prior)) => #t)
      (def old (cache.start source))
      (def next (cache.refresh old edited))
      (check-equal? (value next 'join) 13)
      (check-equal? (cache.cache-evaluated next) '(left join))
      (def changed (graph.define edited 'left (code.need 'right identity)))
      (def fresh (graph.reschedule retained changed))
      (check-equal? ((graph.schedule-reads fresh) 'left) '(right))
      (check-equal? (value (cache.refresh next changed) 'join) 6)
      (check-equal? (graph.failure-kind (caught (cut graph.reschedule prior
        (graph.define source 'root (code.need 'join identity))))) 'cycle)
      (check-equal? (graph.failure-kind (caught (cut graph.reschedule prior
        (graph.define source 'left (code.need 'missing identity))))) 'unsupported))
    (test-case "absence failures and unselected branches are tracked"
      (def source (graph.declaration '(select available denied failed absent)
        (list (cons 'select (code.choose (code.inspect 'absent identity) identity (code.pure 1) (code.pure 2)))
              (cons 'available (code.inspect 'absent identity)) (cons 'denied (code.deny 'absent 9))
              (cons 'failed (code.failure "business")))))
      (def old (cache.start source))
      (check-equal? (value old 'select) 2)
      (check-equal? (value old 'available) #f)
      (def next (cache.refresh old (graph.set-base (cache.cache-source old) 'absent (some (code.make-success #f)))))
      (check-equal? (value next 'select) 1)
      (check-equal? (value next 'available) #t)
      (check-equal? (code.error-kind (some-value (cache.cache-ref next 'denied))) 'introduced)
      (check (eq? (cache.cache-ref old 'failed) (cache.cache-ref next 'failed)) => #t)
      (def branch (cache.start (graph.declaration '(branch hidden)
        (list (cons 'branch (code.choose (code.pure #t) identity (code.pure 7) (code.need 'hidden identity)))))))
      (def changed (cache.refresh branch (graph.set-base (cache.cache-source branch) 'hidden (some (code.make-success 3)))))
      (check-equal? (value changed 'branch) 7)
      (check-equal? (length (cache.cache-evaluated changed)) 2))
    (test-case "latent source survives support changes; equal output does not authorize reuse"
      (def old (cache.start (graph.declaration '(a) (list (cons 'b (code.pure 7))) (list (cons 'a (some (code.make-success 1)))))))
      (def next (cache.refresh old (graph.support (cache.cache-source old) '(a b))))
      (check-equal? (value next 'b) 7)
      (check-equal? (cache.cache-evaluated next) '(b))
      (check-equal? (cache.cache-reused next) '(a))
      (check (eq? (cache.cache-ref old 'a) (cache.cache-ref next 'a)) => #t)
      (def removed (cache.refresh next (graph.support (cache.cache-source next) '(a))
        (.cc cache.Builder. allow: (lambda (_) #f))))
      (check-equal? (cache.cache-evaluated removed) [])
      (check-equal? (cache.cache-reused removed) '(a))
      (def changed (graph.define (cache.cache-source old) 'a (code.pure 1)))
      (check-equal? (cache.failure-key (caught (cut cache.refresh old changed (.cc cache.Builder. allow: (lambda (_) #f))))) 'a))
    (test-case "cycles unsupported dependencies and undeclared reads refuse"
      (def cycle (graph.declaration '(a b) (list (cons 'a (code.need 'b identity)) (cons 'b (code.need 'a identity)))))
      (check-equal? (graph.failure-kind (caught (cut cache.start cycle))) 'cycle)
      (check-equal? (graph.failure-kind (caught (cut cache.start (graph.declaration '(a) (list (cons 'a (code.need 'outside identity))))))) 'unsupported)
      (def liar (.cc code.Computation. reads: [] .evaluate: (lambda (provider) (provider 'outside))))
      (check-equal? (cache.failure-key (caught (cut cache.start (graph.declaration '(a) (list (cons 'a liar)))))) 'a))))
