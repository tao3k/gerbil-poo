;;; Sparse rank repair in the existing Graph and ConstructionCache paths.
(export graph-order-repair-test main owned-delta-study owned-cache-study owned-invalidation-study reverse-bucket-study
        local-components-test local-components-study local-component-pressure-study)
(import :std/test :std/iter :clan/poo/object :clan/poo/support/option
        (only-in :clan/poo/benchmarks/closure-measure measure measure-pair qualified-metrics)
        (only-in :std/error Error? Error-message UnboundKeyError?)
        (only-in :clan/poo/support/index %index-changes %index-base %roster %roster-append
                 %roster-retire %roster-keys %roster-width %roster-position)
        (only-in :std/struct/rbtree rbtree-size)
        (only-in :clan/poo/lens-laws lens-check)
        (only-in :clan/poo/mop lens-of-get-set)
        (only-in :clan/poo/component-closure component-group-builder)
        (only-in :clan/poo/generalized-closure closed-raw)
        (only-in :clan/poo/feedback-cache group-closed)
        (only-in :clan/poo/feedback-graph publish-owned-feedback-graph graph-cache-partition graph-cache-ref graph-cache-values)
        (prefix-in :clan/poo/component-publication publication.)
        (prefix-in :clan/poo/component-revision revision.)
        (only-in :clan/poo/slot-observation call-with-slot-read-observer slot-read-receiver slot-read-key)
        (prefix-in (only-in :gerbil/runtime/mop slot-set!) runtime.)
        (prefix-in :clan/poo/generalized-graph graph.)
        (prefix-in :clan/poo/construction-cache cache.)
        (prefix-in :clan/poo/dependency-analysis code.)
        (prefix-in :clan/poo/strong-components scc.))

(extern namespace: clan/poo/generalized-graph %invalidation-work affected-work-receipt-set!
  %schedule-reverse reverse-bucket-remove reverse-bucket-add reverse-bucket-members reverse-bucket-edited
  edited-search-frontier
  %schedule-owned %owned-source-programs %schedule-adjacency %schedule-ranks
  start-affected-work advance-affected-work! affected-work-marked %retire-component-source
  %component-source-code-witnesses %component-source-storage %component-source-roster %owned-source-bases)
(extern namespace: clan/poo/strong-components %partition-owned owned-partition-backward
  owned-partition-owner owned-partition-members owned-partition-forward
  owned-partition-roster %retire-partition-isolates %append-partition-owners
  %check-partition-retirements)
(extern namespace: clan/poo/support/index roster-appended roster-positions)
(extern namespace: clan/poo/construction-cache cache-scheduled cache-patch)

(def (caught thunk) (try (thunk) #f (catch (cause) cause)))
(def (value state key) (code.success-value (some-value (cache.cache-ref state key))))
;; Lifetime diagnostics are separate from natural timing. Keep only weak
;; observations outside this activation; their values never retain the keys.
(def (owned-lifetime-source objects owners)
  (def names (for/collect (i (in-range 64))
    (string->symbol (string-append "owned-lifetime-" (number->string i)))))
  (def prior (graph.schedule-owned names
    [(cons (cadr names) (code.need (car names) identity))]
    [(cons (car names) (some (code.make-success 1)))]))
  (def continuation (graph.schedule-invalidation prior))
  (def ticket (graph.schedule-revision prior [(cons (car names) (code.pure 2))]))
  (def next (call-with-values
    (lambda () (graph.%apply-schedule-revision-with-invalidation prior ticket #t continuation))
    (lambda (scheduled _affected _work) scheduled)))
  (for (value [prior (graph.schedule-source prior) continuation ticket next])
    (hash-put! objects value #t))
  (for (key names) (hash-put! owners key #t))
  (vector prior continuation ticket next))
;; The full oracle is deliberately separate from the update's operation counts.
(def (valid-order? scheduled keys)
  (def indices (make-hash-table-eq))
  (def order (graph.schedule-order scheduled))
  (def valid? (= (length order) (length keys)))
  (for ((key order) (index (in-range (length order))))
    (when (hash-key? indices key) (set! valid? #f))
    (hash-put! indices key index))
  (for (key keys)
    (unless (hash-key? indices key) (set! valid? #f))
    (for (dep ((graph.schedule-reads scheduled) key))
      (unless (and (hash-key? indices dep) (hash-key? indices key)
                   (< (hash-ref indices dep) (hash-ref indices key)))
        (set! valid? #f))))
  valid?)

;; Keep case registration in separate C host functions. Gambit groups the
;; closures under their enclosing function, even in multiple-host mode.
(def (check-owned-graph-admission)
    (test-case "owned empty and single-provider cold graphs retain domain effects and snapshots"
      (def calls 0)
      (def program (.o reads: (begin (set! calls (1+ calls)) [])
                      .evaluate: (lambda (_) (error "cold graph evaluated business code"))))
      (check-equal? calls 0)
      (def prior (graph.schedule-owned '(b a) [(cons 'a program)]))
      (check-equal? calls 1)
      (check-equal? (graph.schedule-order prior) '(b a))
      (check (graph.schedule-supports? prior 'b) => #t)
      (check (graph.schedule-supports? prior 'unknown) => #f)
      (check-equal? ((graph.schedule-reads prior) 'b) [])
      (check-equal? (hash-length (%index-base (%schedule-reverse prior))) 0)
      (def next (graph.apply-schedule-revision prior
        (graph.schedule-revision prior [(cons 'b (code.need 'a identity))])))
      (check-equal? ((graph.schedule-reads next) 'b) '(a))
      (check (valid-order? next '(b a)) => #t)
      (check-equal? (hash-length (%index-base (%schedule-reverse prior))) 0)
      (check-equal? (graph.schedule-order prior) '(b a))
      (def hub (graph.schedule-owned '(a b c)
        [(cons 'b (code.need 'a identity)) (cons 'c (code.need 'a identity))]))
      (check-equal? (hash-length (%index-base (%schedule-reverse hub))) 1)
      (def chain (graph.schedule-owned '(a b c)
        [(cons 'b (code.need 'a identity)) (cons 'c (code.need 'b identity))]))
      (check-equal? (hash-length (%index-base (%schedule-reverse chain))) 3)
      (def unknown (graph.schedule (graph.declaration '(b a) [])))
      (check-equal? (hash-length (%index-base (%schedule-reverse unknown))) 2)
      (check-equal? (graph.schedule-order unknown) '(b a))
      (def cyclic (caught (lambda () (graph.schedule-owned '(a b)
        [(cons 'a (code.need 'b identity)) (cons 'b (code.need 'a identity))]))))
      (check-equal? (and (graph.failure? cyclic) (graph.failure-kind cyclic)) 'cycle)
      (def dangling (caught (lambda () (graph.schedule-owned '(a)
        [(cons 'a (code.need 'outside identity))]))))
      (check-equal? (and (graph.failure? dangling) (graph.failure-kind dangling)) 'unsupported))
    (test-case "directional rank bounds preserve partial and complete search frontiers"
      (def keys '(a b c d e f))
      (def prior (graph.schedule-owned keys
        [(cons 'e (code.need 'a identity)) (cons 'f (code.need 'b identity))]))
      (check-equal? (graph.schedule-order prior) keys)
      (def next (graph.apply-schedule-revision prior
        (graph.schedule-revision prior [(cons 'b (code.need 'e identity))])))
      (check (valid-order? next keys) => #t)
      ;; Both boundary edges are inspected; neither outside owner is expanded.
      (check-equal? (.get (graph.schedule-work next) search-buckets) 2)
      (check-equal? (.get (graph.schedule-work next) search-edges) 2)
      (check-equal? (.get (graph.schedule-work next) rank-writes) 2)
      (check-equal? (graph.schedule-order next) '(a e c d b f))
      (check-equal? (graph.schedule-order prior) keys)
      ;; A retirement leaves label 2 vacant; the remaining maximum is still 5.
      ;; Active cardinality 5 is NOT a bound on these admitted labels.
      (def gap (graph.apply-schedule-revision prior
        (graph.%schedule-support-revision prior [] [] '(c)
          (lambda (_a _b) (error "retirement must not order additions")))))
      (def gap-keys '(a b d e f))
      (def gap-next (graph.apply-schedule-revision gap
        (graph.schedule-revision gap [(cons 'b (code.need 'e identity))])))
      (check (valid-order? gap-next gap-keys) => #t)
      (check-equal? (.get (graph.schedule-work gap-next) search-buckets) 2)
      (check-equal? (.get (graph.schedule-work gap-next) rank-writes) 2)
      (check-equal? (graph.schedule-order gap) gap-keys)
      (def floor (graph.schedule-owned keys [(cons 'e (code.need 'b identity))]))
      (def floor-next (graph.apply-schedule-revision floor
        (graph.schedule-revision floor [(cons 'a (code.need 'e identity))])))
      (check (valid-order? floor-next keys) => #t)
      (check-equal? (.get (graph.schedule-work floor-next) rank-writes) 3)
      (check-equal? (graph.schedule-order floor) keys)
      (def ceiling (graph.schedule-owned keys [(cons 'c (code.need 'b identity))]))
      (def ceiling-next (graph.apply-schedule-revision ceiling
        (graph.schedule-revision ceiling [(cons 'b (code.need 'f identity))])))
      (check (valid-order? ceiling-next keys) => #t)
      (check-equal? (.get (graph.schedule-work ceiling-next) rank-writes) 3)
      (check-equal? (graph.schedule-order ceiling) keys))
    (test-case "structural index forks preserve roots, false values and projection effects"
      (def table (make-hash-table-symbolic))
      (hash-put! table 'present #f)
      (hash-put! table 'empty [])
      (def cold (graph.%index table))
      (def first (graph.%index-fork cold))
      (graph.%index-write! first 'present 1)
      (def second (graph.%index-fork first))
      (check-eq? (%index-base cold) table)
      (check-eq? (%index-base first) table)
      (check-eq? (%index-base second) table)
      (graph.%index-write! second 'present #f)
      (graph.%index-write! second 'new [])
      (check-eq? (graph.%index-ref cold 'present 'missing) #f)
      (check-equal? (graph.%index-ref first 'present) 1)
      (check-eq? (graph.%index-ref second 'present 'missing) #f)
      (check-equal? (graph.%index-ref second 'new 'missing) [])
      (check-eq? (graph.%index-ref first 'new 'missing) 'missing)
      (check-equal? (graph.%index-ref cold 'empty 'missing) [])
      (check-exception (graph.%index-ref cold 'absent) UnboundKeyError?)
      (def calls 0)
      (def projected (graph.%index-project table
        (lambda (key) (set! calls (1+ calls)) (hash-ref table key))))
      (def overlay (graph.%index-fork projected))
      (check-equal? calls 0)
      (check-eq? (graph.%index-ref projected 'absent #f) #f)
      (check-equal? calls 0)
      (check-exception (graph.%index-ref projected 'absent) UnboundKeyError?)
      (check-equal? calls 0)
      (check-eq? (graph.%index-ref projected 'present 'missing) #f)
      (check-eq? (graph.%index-ref projected 'present 'missing) #f)
      ;; Projection remains a live operation, not a newly memoized result.
      (check-equal? calls 2)
      (graph.%index-write! overlay 'present [])
      (check-equal? (graph.%index-ref overlay 'present) [])
      (check-equal? calls 2)
      (check-eq? (graph.%index-ref projected 'present 'missing) #f)
      (check-equal? calls 3))
    (test-case "released owned schedules and continuations leave no strong registry roots"
      (def objects (make-hash-table test: eq? weak-keys: #t))
      (def owners (make-hash-table test: eq? weak-keys: #t))
      (def held (owned-lifetime-source objects owners))
      (##gc)
      (check-equal? (length (graph.schedule-order (vector-ref held 0))) 64)
      (check-equal? (hash-length objects) 5)
      (check-equal? (hash-length owners) 64)
      (set! held #f)
      (##gc) (##gc)
      (check-equal? (hash-length objects) 0)
      ;; Symbol interning is a VM lifetime policy; report it independently
      ;; rather than treating retained names as leaked schedule indexes.
      (displayln (list 'GRAPH-OWNED-LIFETIME 'objects (hash-length objects)
        'interned-owners (hash-length owners))))
    (test-case "10000 owned rows reuse only new inverse buckets and restart when roots are removed"
      (def names (append '(root client outer other tail)
        (for/collect (i (in-range 9995))
          (string->symbol (string-append "untouched-inverse-" (number->string i))))))
      (def prior (graph.schedule-owned names
        [(cons 'client (code.need 'root identity)) (cons 'outer (code.need 'client identity))
         (cons 'tail (code.need 'other identity))]
        [(cons 'root (some (code.make-success 1))) (cons 'other (some (code.make-success 5)))]))
      (def work (graph.schedule-invalidation prior))
      (def (apply-edit codes)
        (graph.%apply-schedule-revision-with-invalidation prior
          (graph.schedule-revision prior codes) #t work))
      (def root-code (cons 'root (code.pure 2)))
      (def other-code (cons 'other (code.pure 7)))
      (defvalues (first first-owners first-counts) (apply-edit [root-code]))
      (check-equal? first-owners '(root client outer))
      (check-equal? first-counts '#(3 2))
      (def first-view (graph.schedule-invalidate! prior work '(root)))
      (defvalues (both both-owners both-counts) (apply-edit [root-code other-code]))
      (check-equal? both-owners '(root client outer other tail))
      (check-equal? both-counts '#(2 1))
      (check (first-view 'tail) => #f)
      (defvalues (_repeat repeat-owners repeat-counts) (apply-edit [root-code other-code]))
      (check-equal? repeat-owners both-owners)
      (check-equal? repeat-counts '#(0 0))
      (defvalues (_only only-owners only-counts) (apply-edit [other-code]))
      (check-equal? only-owners '(other tail))
      (check-equal? only-counts '#(2 1))
      (defvalues (_empty empty-owners empty-counts) (apply-edit []))
      (check-equal? empty-owners [])
      (check-equal? empty-counts '#(0 0))
      ;; The changed consumer is a root even when its new provider was clean.
      (defvalues (_row row-owners row-counts)
        (apply-edit [(cons 'client (code.need 'other identity))]))
      (check-equal? row-owners '(client outer))
      (check-equal? row-counts '#(2 1))
      (check-exception
        (graph.%apply-schedule-revision-with-invalidation first
          (graph.schedule-revision first [other-code]) #t work) error-object?)
      (check-equal? ((graph.schedule-reads prior) 'client) '(root))
      ;; Materialization consumes the same native ticket/continuation path.
      (def old (cache.start-owned prior))
      (def next (cache.%revise-with-builder old [root-code other-code] (.cc cache.Builder.)
                  invalidation: work))
      (check-equal? (value next 'outer) 2)
      (check-equal? (value next 'tail) 7)
      (check-equal? (value old 'outer) 1)
      (check-equal? (value old 'tail) 5)
      (check-equal? (cache.cache-evaluated next) both-owners)
      (def cold (cache.start (cache.cache-source next)))
      (for (key '(root client outer other tail))
        (check-equal? (value next key) (value cold key)))))

(def (check-rank-repair)
    (test-case "owner patches distinguish hash collisions and same-name symbols"
      (def left (string->uninterned-symbol "shared-owner" 17))
      (def right (string->uninterned-symbol "shared-owner" 17))
      (def source-name (string-copy "other-owner"))
      (def other (string->uninterned-symbol source-name 17))
      (check (eq? left right) => #f)
      (check (map symbol-hash [left right other]) => [17 17 17])
      (def (base owner value) (cons owner (some (code.make-success value))))
      (def old (cache.start-owned (graph.schedule-owned [left right other] []
        [(base left 1) (base right 2) (base other 3)])))
      (def next (cache.refresh-revision old
        (cache.revision old [] [(base left 10) (base right 20) (base other 30)])))
      (string-set! source-name 0 #\z)
      (def latest (cache.refresh-revision next
        (cache.revision next [] [(base right 21)])))
      (check (map (cut value old <>) [left right other]) => [1 2 3])
      (check (map (cut value next <>) [left right other]) => [10 20 30])
      (check (map (cut value latest <>) [left right other]) => [10 21 30]))
    (test-case "10000 owners: two frontier buckets, two rank writes, outer consumer invalidated"
      (def names (list->vector (for/collect (i (in-range 10000))
        (string->symbol (string-append "owner-" (number->string i))))))
      (def (key i) (vector-ref names i))
      (def keys (vector->list names))
      (def source (graph.declaration keys
        (list (cons (key 9998) (code.need (key 0) identity))
              (cons (key 9999) (code.need (key 1) identity)))
        (list (cons (key 0) (some (code.make-success 10)))
              (cons (key 1) (some (code.make-success 1))))))
      (def prior (graph.schedule source))
      (def edited (graph.define source (key 1) (code.need (key 9998) identity)))
      (def next (graph.reschedule prior edited))
      (def receipt (graph.schedule-work next))
      (check-equal? (.@ receipt owner-checks) 10000)
      (check-equal? (.@ receipt footprint-reads) 3)
      (check-equal? (.@ receipt search-buckets) 2)
      (check-equal? (.@ receipt search-edges) 2)
      (check-equal? (.@ receipt rank-writes) 2)
      (check-equal? (.@ receipt incident-checks) 2)
      ;; The candidate writes private sparse roots; full enumeration is below.
      (check-equal? (.@ receipt copied-entries) 0)
      (check-equal? (.@ receipt order-materialized) 0)
      (check-equal? (.@ receipt patch-writes) 8)
      (def order (list->vector (graph.schedule-order next)))
      (def mismatch #f)
      (for (i (in-range 10000))
        (unless (eq? (vector-ref order i) (key (cond ((= i 1) 9998) ((= i 9998) 1) (else i))))
          (unless mismatch (set! mismatch (list i (vector-ref order i))))))
      (check-equal? mismatch #f)
      (check (valid-order? next keys) => #t)
      (check-equal? (graph.schedule-order prior) keys)
      (check-equal? ((graph.schedule-reads prior) (key 1)) [])
      (def old-readers (graph.schedule-invalidate! prior (graph.schedule-invalidation prior)
                         (list (key 9998))))
      (def new-readers (graph.schedule-invalidate! next (graph.schedule-invalidation next)
                         (list (key 9998))))
      (check (old-readers (key 1)) => #f)
      (check (new-readers (key 1)) => #t)
      (check (new-readers (key 9999)) => #t)
      ;; Run both proposals on the exact old native inverse. The first
      ;; observation keeps its own closure even after the work advances.
      (def pending (graph.schedule-invalidation prior))
      (def work (vector 0 0))
      (affected-work-receipt-set! (%invalidation-work pending) work)
      (def first (graph.schedule-invalidate! prior pending (list (key 0))))
      (check-equal? work '#(2 1))
      (check (first (key 9998)) => #t)
      (def both (graph.schedule-invalidate! prior pending (list (key 0) (key 1) (key 1))))
      (check-equal? work '#(4 2))
      (check (first (key 9999)) => #f)
      (check (both (key 9998)) => #t)
      (check (both (key 9999)) => #t)
      (check (both (key 5000)) => #f)
      (check-exception (graph.schedule-invalidate! next pending (list (key 2))) error-object?)
      (check-equal? work '#(4 2))
      ;; Same real 10000-owner declaration, through the existing value cache.

      (def old (cache.start source))
      (def refreshed (cache.refresh old edited))
      (check-equal? (cache.cache-evaluated refreshed) (list (key 1) (key 9999)))
      (check-equal? (value old (key 9999)) 1)
      (check-equal? (value refreshed (key 9999)) 10)
      (check (eq? (cache.cache-ref old (key 9998)) (cache.cache-ref refreshed (key 9998))) => #t))
    (test-case "all removals precede additions; failed candidates leave the old graph intact"
      (def source (graph.declaration '(a b c)
        (list (cons 'b (code.need 'a identity)))))
      (def prior (graph.schedule source))
      (def replacement (graph.revise source
        (list (cons 'a (code.need 'b identity)) (cons 'b (code.pure 1)))))
      (check-equal? (graph.schedule-order (graph.reschedule prior replacement)) '(b a c))
      (check (valid-order? (graph.reschedule prior replacement) '(a b c)) => #t)
      (check-equal? (graph.failure-kind (caught (cut graph.reschedule prior
        (graph.define source 'a (code.need 'b identity))))) 'cycle)
      (check-equal? (graph.failure-kind (caught (cut graph.reschedule prior
        (graph.define source 'a (code.need 'missing identity))))) 'unsupported)
      (check-equal? ((graph.schedule-reads prior) 'a) [])
      (check-equal? ((graph.schedule-reads prior) 'b) '(a))
      (check-equal? (graph.schedule-order prior) '(a b c)))
    (test-case "unknown source compares current rows with the admitted predecessor"
      (def current #f)
      (def roster (list 'a 'b))
      (def source (.cc graph.Declaration. keys: roster
                    .code: (lambda (key) (and (eq? key 'a) current))))
      (def prior (graph.schedule source))
      (set! current (code.need 'b identity))
      (def next (graph.reschedule prior source))
      (check-equal? ((graph.schedule-reads next) 'a) '(b))
      (check-equal? (graph.schedule-order next) '(b a))
      (set! current (code.need 'missing identity))
      (check-equal? (graph.failure-kind (caught (cut graph.reschedule next source))) 'unsupported)
      (check-equal? ((graph.schedule-reads prior) 'a) [])
      (check-equal? ((graph.schedule-reads next) 'a) '(b))
      (set-car! (cdr roster) 'c)
      (set! current (code.need 'c identity))
      (def reconfigured (graph.reschedule next source))
      (check-equal? (graph.schedule-order reconfigured) '(c a))
      (check (graph.schedule-supports? next 'b) => #t)
      (check (graph.schedule-supports? reconfigured 'b) => #f))
    (test-case "successive repairs compose inside one batch and refusal keeps the old order"
      (def source (graph.declaration '(a b c d) []))
      (def prior (graph.schedule source))
      (def next (graph.reschedule prior (graph.revise source
        (list (cons 'a (code.need 'b identity)) (cons 'b (code.need 'c identity))
              (cons 'c (code.need 'd identity))))))
      (check-equal? (graph.schedule-order next) '(d c b a))
      (check (valid-order? next '(a b c d)) => #t)
      (def removed (graph.define (graph.schedule-source next) 'b (code.pure 0)))
      (def successor (graph.reschedule next removed))
      (check-equal? ((graph.schedule-reads next) 'b) '(c))
      (check-equal? ((graph.schedule-reads successor) 'b) [])
      (check (eq? (graph.schedule-order next) (graph.schedule-order successor)) => #t)
      (def old-readers (graph.schedule-invalidate! next (graph.schedule-invalidation next) '(c)))
      (def new-readers (graph.schedule-invalidate! successor (graph.schedule-invalidation successor) '(c)))
      (check (old-readers 'a) => #t)
      (check (new-readers 'a) => #f)
      (check-equal? (graph.failure-kind (caught (cut graph.reschedule prior
        (graph.revise source (list (cons 'a (code.need 'b identity))
                                  (cons 'b (code.need 'a identity))))))) 'cycle)
      (check-equal? (graph.schedule-order prior) '(a b c d)))
    (test-case "bounded exhaustive insertion agrees with independent cold scheduling"
      (def keys '#(a b c d))
      (def pairs '((1 . 0) (2 . 0) (2 . 1) (3 . 0) (3 . 1) (3 . 2)))
      (def cases 0)
      (def first-failure #f)
      (for (mask (in-range 64))
        (def rows (make-vector 4 []))
        (for ((edge pairs) (bit (in-range 6)))
          (when (odd? (quotient mask (expt 2 bit)))
            (vector-set! rows (car edge) (cons (vector-ref keys (cdr edge)) (vector-ref rows (car edge))))))
        (def (program reads) (.cc code.Computation. reads: reads .evaluate: (lambda (_) (code.make-success 0))))
        (def source (graph.declaration (vector->list keys)
          (for/collect (i (in-range 4)) (cons (vector-ref keys i) (program (vector-ref rows i))))))
        (def prior (graph.schedule source))
        (for (consumer (in-range 4))
          (for (provider (in-range 4))
            (def key (vector-ref keys consumer))
            (def dep (vector-ref keys provider))
            (def next (graph.define source key (program (cons dep (vector-ref rows consumer)))))
            (def reference (caught (cut graph.schedule next)))
            (def valid?
              (if reference
                (let (cause (caught (cut graph.reschedule prior next)))
                  (and (graph.failure? cause) (eq? (graph.failure-kind cause) 'cycle)))
                (valid-order? (graph.reschedule prior next) (vector->list keys))))
            (set! cases (1+ cases))
            (unless (or valid? first-failure)
              (set! first-failure (list mask consumer provider (graph.schedule-order (graph.reschedule prior next))))))))
      (check-equal? cases 1024)
      (check-equal? first-failure #f)))

(def (check-quotient-edits)
    (test-case "complete quotient replacement builds a private program base and preserves surviving inputs"
      (def kept (some (code.make-success 7)))
      (def retired (some (code.make-success 19)))
      (def old (graph.schedule-owned '(keep retired untouched)
        [(cons 'keep (code.pure 5)) (cons 'retired (code.need 'keep identity))]
        [(cons 'keep kept) (cons 'retired retired)]))
      (def keys '(fresh keep))
      (def codes [(cons 'fresh (code.need 'keep identity)) (cons 'keep #f)])
      (def next (graph.%reschedule-owned-support old keys codes))
      (def cold (graph.schedule-owned keys codes [(cons 'keep kept)]))
      (check-equal? (graph.schedule-order next) (graph.schedule-order cold))
      (check-equal? ((graph.schedule-reads next) 'fresh) '(keep))
      (check-equal? (%index-changes (%owned-source-programs (%schedule-owned next))) #f)
      (check-equal? (.call (graph.schedule-source next) .code 'keep) #f)
      (check (eq? (.call (graph.schedule-source next) .base 'keep) kept) => #t)
      (check-equal? (.call (graph.schedule-source next) .base 'retired) #f)
      (check (eq? (.call (graph.schedule-source old) .base 'retired) retired) => #t)
      (def readded (graph.%reschedule-owned-support next '(fresh keep retired) [(cons 'retired #f)]))
      (check-equal? (.call (graph.schedule-source readded) .base 'retired) #f)
      (check-equal? ((graph.schedule-reads old) 'retired) '(keep)))
    (test-case "support replacement repairs ranks without enumerating the admitted roster"
      (def untouched (for/collect (i (in-range 9996))
        (string->symbol (string-append "untouched-" (number->string i)))))
      (def names (append '(base client outer retired) untouched))
      (def positions (make-hash-table-symbolic))
      (for ((key (append '(base fresh client outer retired spare) untouched))
            (rank (in-range (+ 2 (length names)))))
        (hash-put! positions key rank))
      (def compared 0)
      (def (before? a b)
        (set! compared (1+ compared))
        (< (hash-ref positions a) (hash-ref positions b)))
      (def old (graph.schedule-owned names
        [(cons 'client (code.need 'retired identity)) (cons 'outer (code.need 'client identity))]
        [(cons 'retired (some (code.make-success 7)))]))
      (def missing-reader
        (caught (cut graph.%schedule-support-revision old [] [] '(retired) before?)))
      (check-equal? (and (graph.failure? missing-reader) (graph.failure-kind missing-reader)) 'unsupported)
      (check-equal? (graph.failure-key missing-reader) 'retired)
      (def codes [(cons 'fresh (code.need 'base identity))
                  (cons 'client (code.need 'fresh identity)) (cons 'spare #f)])
      (def ticket (graph.%schedule-support-revision old codes '(spare fresh) '(retired) before?))
      (defvalues (next affected _) (graph.apply-schedule-revision old ticket affected?: #t))
      (check-equal? compared 0)
      (check-equal? affected '(fresh client spare outer))
      (def work (graph.schedule-work next))
      (check-equal? (.get work owner-checks) 3)
      (check-equal? (.get work order-materialized) 0)
      (check-equal? (.get work retirement-buckets) 1)
      (check-equal? (.get work retirement-readers) 1)
      (check (graph.schedule-supports? next 'retired) => #f)
      (check (graph.schedule-supports? old 'retired) => #t)
      (check-equal? ((graph.schedule-reads old) 'client) '(retired))
      (def successor (append '(base fresh client outer spare) untouched))
      (check-equal? (.get (graph.schedule-source next) keys) successor)
      (check (valid-order? next successor) => #t)
      (def restored
        (graph.apply-schedule-revision next
          (graph.%schedule-support-revision next [(cons 'retired #f)] '(retired) '(spare) before?)))
      (check-equal? (.call (graph.schedule-source restored) .base 'retired) #f)
      (check (graph.schedule-supports? next 'spare) => #t)
      (check (graph.schedule-supports? restored 'spare) => #f)
      (check (valid-order? restored (append '(base fresh client outer retired) untouched)) => #t))
    (test-case "quotient retirement drops fresh schedule and value entries but masks cold values"
      (def (before? a b) (string<? (symbol->string a) (symbol->string b)))
      (def builder (.cc cache.Builder.))
      (def old (cache.start-owned (graph.schedule-owned '(a) [(cons 'a (code.pure 1))])))
      (def expanded (cache.%revise-with-builder old [(cons 'b (code.pure 2))] builder
                      added: '(b) before?: before?))
      (def next (cache.%revise-with-builder expanded [] builder retired: '(b) before?: before?))
      (def schedule (cache-scheduled next))
      (for (index [%schedule-adjacency %schedule-ranks %schedule-reverse])
        (check-equal? (rbtree-size (%index-changes (index schedule))) 0)
        (check-equal? (rbtree-size (%index-changes (index (cache-scheduled expanded)))) 1))
      (check-equal? (rbtree-size (cache-patch next)) 0)
      (check-equal? (value expanded 'b) 2)
      (check-equal? (cache.cache-ref next 'b) #f)
      (def failure (caught (cut (graph.schedule-reads schedule) 'b)))
      (check-equal? (and (graph.failure? failure) (graph.failure-kind failure)) 'unsupported)
      (check-equal? (graph.schedule-order schedule) '(a))
      (def retired (cache.%revise-with-builder next [] builder retired: '(a) before?: before?))
      (check-equal? (rbtree-size (cache-patch retired)) 1)
      (check-equal? (cache.cache-ref retired 'a) #f)
      (check-equal? (value old 'a) 1))
    (test-case "explicit representative enumeration skips intermediate revision rosters"
      (def old (graph.schedule-owned '(a) []))
      (def enumerated [])
      (def (append-owner prior key names)
        (graph.apply-schedule-revision prior
          (graph.%schedule-support-revision prior [(cons key #f)] (list key) []
            (lambda (a b) (string<? (symbol->string a) (symbol->string b)))
            representatives: (lambda () (set! enumerated (cons key enumerated)) names))))
      (def next (append-owner old 'b '(a b)))
      (def latest (append-owner next 'c '(a b c)))
      (check-equal? enumerated [])
      (check-equal? (graph.schedule-order latest) '(a b c))
      (check-equal? enumerated [])
      (check-equal? (.get (graph.schedule-source latest) keys) '(a b c))
      (check-equal? enumerated '(c))
      (check-equal? (.get (graph.schedule-source next) keys) '(a b))
      (check-equal? enumerated '(b c)))
    (test-case "an owned revision reads only its edit and is bound to the exact parent"
      (def source-row (list 'a))
      (def scope (lambda (_) (error "graph scheduling evaluated a program")))
      (def initial (.o reads: source-row .evaluate: (error "graph scheduling forced an evaluator")))
      (def original-base (some (code.make-success 7)))
      (def prior (graph.schedule-owned '(a b c d)
        (list (cons 'b initial)) (list (cons 'a original-base))))
      (set-car! source-row 'd)
      (def published ((graph.schedule-reads prior) 'b))
      (set-car! published 'c)
      (check-equal? ((graph.schedule-reads prior) 'b) '(a))
      (def ticket (graph.schedule-revision prior
        (list (cons 'a (code.need 'd scope)))))
      (def next (graph.apply-schedule-revision prior ticket))
      (def work (graph.schedule-work next))
      (check (.ref/cached (graph.schedule-source next) 'keys) => #f)
      (check-equal? (.@ work owner-checks) 1)
      (check-equal? (.@ work footprint-reads) 1)
      (check-equal? (.@ work source-patch-writes) 1)
      (check-equal? (.@ work copied-entries) 0)
      (check-equal? (.@ work order-materialized) 0)
      (check (valid-order? next '(a b c d)) => #t)
      (check-equal? (graph.schedule-order prior) '(a b c d))
      (check-equal? ((graph.schedule-reads next) 'a) '(d))
      (check-equal? ((graph.schedule-reads next) 'b) '(a))
      (def cold (graph.schedule (graph.schedule-source next)))
      (for (name '(a b c d))
        (check-equal? ((graph.schedule-reads next) name) ((graph.schedule-reads cold) name)))
      (def consumers (graph.schedule-invalidate! next (graph.schedule-invalidation next) '(d)))
      (check (consumers 'b) => #t)
      (check-equal? (graph.failure-kind (caught (cut graph.apply-schedule-revision next ticket))) 'stale-revision)
      (def foreign (graph.schedule-owned '(a b c d) []))
      (check-equal? (graph.failure-kind (caught (cut graph.apply-schedule-revision foreign ticket))) 'stale-revision)
      (check-equal? (graph.failure-kind (caught (cut graph.apply-schedule-revision prior #f))) 'stale-revision)
      (check-exception (graph.schedule-revision cold []) error-object?)
      (check-equal? (graph.failure-kind (caught (lambda ()
        (graph.apply-schedule-revision next
          (graph.schedule-revision next (list (cons 'd (code.need 'b scope)))))))) 'cycle)
      (def removal (graph.apply-schedule-revision next
        (graph.schedule-revision next (list (cons 'a #f)) (list (cons 'a #f)))))
      (check-equal? ((graph.schedule-reads removal) 'a) [])
      (check-equal? ((graph.schedule-reads next) 'a) '(d))
      (check-equal? (.call (graph.schedule-source removal) .base 'a) #f)
      (check-eq? (.call (graph.schedule-source prior) .base 'a) original-base)
      (check-eq? (.call (graph.schedule-source next) .base 'a) original-base)))

(def (check-cache-publication)
    (test-case "owned staging detaches its inputs and rejects cross-callback drift"
      (def prior (graph.schedule-owned '(a b c d) []))
      (def second (cons 'b (code.need 'c identity)))
      (def first (.o reads: (begin (set-cdr! second (code.need 'd identity)) [])))
      (def next (graph.apply-schedule-revision prior
        (graph.schedule-revision prior (list (cons 'a first) second))))
      (check-equal? ((graph.schedule-reads next) 'b) '(c))
      (check-equal? ((graph.schedule-reads prior) 'b) [])
      (def earlier (.o reads: []))
      (def later (.o reads: (begin (.put! earlier 'reads '(a)) [])))
      (check-exception (graph.schedule-revision prior
        (list (cons 'a earlier) (cons 'b later))) error-object?)
      ;; The second getter forges only the first getter's issued record. Its
      ;; own replay has no edge to that receiver; the batch tail must refuse.
      (def signed #f)
      (def owner (.o reads: []))
      (def mutator (.o reads: (begin (runtime.slot-set! signed 'current? (lambda (_) #t)) [])))
      (def refused
        (caught (lambda ()
          (call-with-slot-read-observer
            (lambda (read)
              (when (and (eq? (slot-read-receiver read) owner) (eq? (slot-read-key read) 'reads))
                (set! signed read)))
            (lambda () (graph.schedule-revision prior
              (list (cons 'a owner) (cons 'b mutator))))))))
      (check (Error? refused) => #t)
      (check-equal? (Error-message refused) "unissued slot dependency")
      (check-equal? ((graph.schedule-reads prior) 'a) []))
    (test-case "ConstructionCache evaluates only the reached owners and preserves older results"
      (def provider (some (code.make-success 10)))
      (def original (graph.schedule-owned '(root consumer unrelated late outer)
        (list (cons 'late (code.need 'root identity))
              (cons 'outer (code.need 'consumer identity)))
        (list (cons 'root (some (code.make-success 1)))
              (cons 'consumer (some (code.make-success 3)))
              (cons 'unrelated provider))))
      (check-exception (.put! (graph.schedule-source original) '.code (lambda (_) #f)) error-object?)
      (set-car! (graph.schedule-order original) 'outside)
      (def calls [])
      (def refuse-outer? #f)
      (def builder (.cc cache.Builder. allow:
        (lambda (key) (set! calls (cons key calls)) (not (and refuse-outer? (eq? key 'outer))))))
      (def old (cache.start-owned original builder))
      (set! calls [])
      (def ticket (cache.revision old (list (cons 'consumer (code.need 'late (cut + <> 7))))))
      (def next (cache.refresh-revision old ticket))
      (check-equal? (reverse calls) '(consumer outer))
      (check-equal? (cache.cache-evaluated next) '(consumer outer))
      (check-equal? (cache.cache-reused next) '(root late unrelated))
      (check-equal? (.get (cache.cache-work next) inverse-buckets) 2)
      (check-equal? (.get (cache.cache-work next) inverse-edges) 1)
      (check-equal? (.get (cache.cache-work next) value-patch-writes) 2)
      (check-equal? (value next 'outer) 8)
      (check-equal? (value old 'outer) 3)
      (check-eq? (cache.cache-ref next 'unrelated) provider)
      (def cold (cache.start (cache.cache-source next)))
      (for (key '(root consumer unrelated late outer))
        (check-equal? (value next key) (value cold key)))
      (def previous-outcome (cache.cache-ref next 'outer))
      (def absent (cache.refresh-revision next
        (cache.revision next (list (cons 'consumer #f)) (list (cons 'consumer #f)))))
      (check-equal? (cache.cache-ref absent 'consumer) #f)
      (check-equal? (code.error-kind (some-value (cache.cache-ref absent 'outer))) 'missing)
      (check-eq? (cache.cache-ref next 'outer) previous-outcome)
      (check-equal? (value next 'outer) 8)
      (def unrestricted (cache.refresh next (.cc (cache.cache-source next))))
      (check-equal? (length (cache.cache-evaluated unrestricted)) 5)
      (check-equal? (graph.failure-kind (caught (cut cache.refresh-revision next ticket))) 'stale-revision)
      ;; Fail after the first replacement has been evaluated and patched.
      (set! refuse-outer? #t)
      (def failed (caught (cut cache.refresh-revision old ticket)))
      (check-equal? (cache.failure-key failed) 'outer)
      (check-equal? (value old 'consumer) 3)
      (check-equal? (value old 'outer) 3))
    (test-case "ConstructionCache preserves independent effect checks during sparse evaluation"
      (def current (.o epoch: 1))
      (def lens (.o .get: identity .set: (lambda (value _state) value)))
      (def guard (lens-check lens '(1) sources: (list current)))
      (def start (graph.schedule-owned '(a b) (list (cons 'b (code.need 'a identity)))
        (list (cons 'a (some (code.make-success 1))))))
      (def mutate? #f)
      (def builder (.cc cache.Builder. .run:
        (lambda (_key resolve) (when mutate? (.put! current 'epoch 2)) (resolve))))
      (def old (cache.start-owned start builder guards: (list guard)))
      (def ticket (cache.revision old [] (list (cons 'a (some (code.make-success 2))))))
      (set! mutate? #t)
      (def rejected (caught (cut cache.refresh-revision old ticket)))
      (set! mutate? #f)
      (check-equal? (cache.failure-key rejected) 'a)
      (check-equal? (.get current epoch) 1)
      (check-equal? (value old 'b) 1)
      (def code (.o reads: [] .evaluate: (lambda (_) (code.make-success 3))))
      (def edited (cache.revision old (list (cons 'a code))))
      (.put! code '.evaluate (lambda (_) (code.make-success 4)))
      (def stale (caught (cut cache.refresh-revision old edited)))
      (check-equal? (cache.failure-key stale) 'a)
      (check-equal? (Error-message (cache.failure-cause stale)) "stale slot dependency")
      (check-equal? (value old 'a) 1)
      (.put! builder '.run (lambda (_key resolve) (resolve)))
      (def replaced (caught (cut cache.refresh-revision old ticket)))
      (check-equal? (Error-message replaced) "stale slot dependency")
      (check-equal? (value old 'b) 1)))

(def (check-inverse-buckets)
    (test-case "reverse deletion and re-addition keep the old ordered bucket"
      (def program (code.need 'hub identity))
      (def prior (graph.schedule-owned '(hub a b c)
        (map (cut cons <> program) '(a b c))))
      (def (bucket scheduled)
        (graph.%index-ref (%schedule-reverse scheduled) 'hub))
      (def (members scheduled) (reverse-bucket-members (bucket scheduled)))
      (def first (graph.schedule-owned '(hub a b) [(cons 'a program)]))
      (def inserted (graph.apply-schedule-revision first
        (graph.schedule-revision first [(cons 'b program)])))
      (def withdrawn (graph.apply-schedule-revision inserted
        (graph.schedule-revision inserted [(cons 'b #f)])))
      (check-eq? (bucket withdrawn) (bucket first))
      (check-equal? (members inserted) '(b a))
      (check-equal? (members withdrawn) '(a))
      (def (hub-impact schedule)
        (graph.schedule-invalidate! schedule (graph.schedule-invalidation schedule) '(hub)))
      (check ((hub-impact inserted) 'b) => #t)
      (check ((hub-impact withdrawn) 'b) => #f)
      (def old (members prior))
      (def removed (graph.apply-schedule-revision prior
        (graph.schedule-revision prior (list (cons 'b #f)))))
      (def restored (graph.apply-schedule-revision removed
        (graph.schedule-revision removed (list (cons 'b program)))))
      (def removed-again (graph.apply-schedule-revision restored
        (graph.schedule-revision restored (list (cons 'b #f)))))
      (def two-removed (graph.apply-schedule-revision removed
        (graph.schedule-revision removed (list (cons 'c #f)))))
      (def one-restored (graph.apply-schedule-revision two-removed
        (graph.schedule-revision two-removed (list (cons 'b program)))))
      (check-equal? old '(c b a))
      (check-equal? (members removed) '(c a))
      (check-equal? (members restored) '(b c a))
      (check-equal? (members removed-again) '(c a))
      (check-equal? (members two-removed) '(a))
      (check-equal? (members one-restored) '(b a))
      (for (snapshot [prior removed restored removed-again two-removed one-restored])
        (def row (graph.%index-ref (%schedule-reverse snapshot) 'hub))
        (def expected (members snapshot))
        (def visited [])
        (graph.%for-each-reverse-bucket (lambda (key) (set! visited (cons key visited))) row)
        (check-equal? (reverse visited) expected)
        ;; Keep the first refusal and its exact prefix, not just a set of names.
        (for (stop expected)
          (set! visited [])
          (def cause (list 'stop stop))
          (check-eq? (caught (lambda ()
            (graph.%for-each-reverse-bucket
              (lambda (key)
                (set! visited (cons key visited))
                (when (eq? key stop) (raise cause))) row))) cause)
          (def prefix [])
          (let loop ((rest expected))
            (set! prefix (cons (car rest) prefix))
            (unless (eq? (car rest) stop) (loop (cdr rest))))
          (check-equal? visited prefix)))
      (check-eq? (members prior) old)
      (def reached (graph.schedule-invalidate! removed (graph.schedule-invalidation removed) '(hub)))
      (check-equal? (reached 'a) #t)
      (check-equal? (reached 'b) #f)
      (check-equal? (reached 'c) #t)
      (def receipt (vector 0 0 0))
      (def pending (start-affected-work (%schedule-reverse one-restored) receipt))
      (check (advance-affected-work! pending '(hub) 1) => #f)
      (check-equal? receipt '#(1 0 0))
      (check (advance-affected-work! pending '(c) 1) => #f)
      (check-equal? receipt '#(2 1 1))
      (check (hash-key? (affected-work-marked pending) 'b) => #t)
      (check (advance-affected-work! pending [] 2) => #f)
      (check-equal? receipt '#(2 1 3))
      (check (hash-key? (affected-work-marked pending) 'c) => #f)
      (check (advance-affected-work! pending [] 1) => #f)
      (check-equal? receipt '#(3 2 4))
      (check (advance-affected-work! pending []) => #t)
      (check-equal? receipt '#(4 2 4)))
    (test-case "repair traverses a masked inverse row in its admitted rank interval"
      (def names '(consumer inside provider removed outside))
      (def codes
        (map (lambda (reader) (cons reader (code.need 'consumer identity)))
          '(inside removed outside)))
      (def prior (graph.schedule-owned names codes))
      (def edits
        (list (cons 'consumer (code.need 'provider identity)) (cons 'removed (code.pure 0))))
      (def next (graph.apply-schedule-revision prior (graph.schedule-revision prior edits)))
      (check-equal? (graph.schedule-order prior) names)
      (check-equal? (graph.schedule-order next) '(provider consumer inside removed outside))
      (check-equal? (.get (graph.schedule-work next) search-buckets) 3)
      (check-equal? (.get (graph.schedule-work next) search-edges) 2)
      (check-equal? (.get (graph.schedule-work next) rank-writes) 3))
    (test-case "equal footprints retain the exact certified order and read view"
      (def source (graph.declaration '(a b) (list (cons 'b (code.need 'a identity)))))
      (def prior (graph.schedule source))
      (def next (graph.reschedule prior (graph.define source 'b (code.need 'a (cut + <> 1)))))
      (check (eq? (graph.schedule-order next) (graph.schedule-order prior)) => #t)
      (check (eq? (graph.schedule-reads next) (graph.schedule-reads prior)) => #t)
      (check-equal? (.@ (graph.schedule-work next) search-buckets) 0)
      (check-equal? (.@ (graph.schedule-work next) copied-entries) 0)))

(def graph-order-repair-test
  (test-suite "local topological repair and independent value invalidation"
    (check-owned-graph-admission)
    (check-rank-repair)
    (check-quotient-edits)
    (check-cache-publication)
    (check-inverse-buckets)))

;; Compare the exact prior and candidate bucket operation on one cold spine.
;; The explicit demand is measured separately because it enumerates live readers.
(def (reverse-bucket-study)
  (for (size '(100000 1000000))
    (def base (for/collect (_ (in-range size)) (gensym 'hub-reader)))
    (def deleted (list-ref base (quotient size 2)))
    (def (reference) (filter (lambda (owner) (not (eq? owner deleted))) base))
    (def expected (reference))
    (for (side '(reference candidate candidate reference reference candidate candidate reference))
      (defvalues (result work)
        (measure (if (eq? side 'reference) reference (cut reverse-bucket-remove base deleted)) 8 #t))
      (unless (equal? (reverse-bucket-members result) expected) (error "reverse bucket order oracle"))
      (displayln "REVERSE-BUCKET-PAIR readers=" size " side=" side " edits=8 clocks=" work))
    (defvalues (_reference-output demand-reference) (measure reference 1 #t))
    (displayln "REVERSE-BUCKET-DEMAND-REFERENCE readers=" size " clocks=" demand-reference)
    (def row (reverse-bucket-remove base deleted))
    (defvalues (output demand) (measure (cut reverse-bucket-members row) 1 #t))
    (unless (equal? output expected) (error "reverse bucket explicit demand oracle"))
    (displayln "REVERSE-BUCKET-DEMAND readers=" size " clocks=" demand)
    (def tail (list 'already-pending))
    (def retain-first? (cut eq? <> (car base)))
    (def reject-first? (lambda (owner) (not (retain-first? owner))))
    (for* ((regime '(natural collected)) (selection '(empty sparse dense)))
      (def accept? (case selection
                      ((empty) (lambda (_) #f))
                      ((sparse) retain-first?)
                      ((dense) reject-first?)))
      (def selected (filter accept? expected))
      (def width (length selected))
      (def expected-frontier (append selected tail))
      (for (side '(reference candidate candidate reference reference candidate candidate reference))
        (defvalues (result clocks)
          (measure
            (lambda ()
              (if (eq? side 'reference)
                (let (members (reverse-bucket-members row))
                  (cons (length members) (append (filter accept? members) tail)))
                (let-values (((next edges) (edited-search-frontier row accept? tail)))
                  (cons edges next))))
            1 (eq? regime 'collected)))
        (unless (and (= (car result) (1- size))
                     (equal? (cdr result) expected-frontier)
                     (eq? (list-tail (cdr result) width) tail))
          (error "edited search frontier oracle" size selection side))
        (displayln (list 'EDITED-SEARCH-FRONTIER size regime selection side (qualified-metrics clocks)))))
    (def table (make-hash-table-symbolic))
    (hash-put! table 'hub row)
    (def inverse (graph.%index table))
    (def (pause-first-reader)
      (def receipt (vector 0 0 0))
      (def pending (start-affected-work inverse receipt))
      (unless (and (not (advance-affected-work! pending '(hub) 1))
                   (equal? receipt '#(1 0 0))
                   (not (advance-affected-work! pending [] 1))
                   (equal? receipt '#(2 1 1))
                   (hash-key? (affected-work-marked pending) (car base)))
        (error "wide inverse pause scanned beyond the first reader" size receipt))
      pending)
    (defvalues (_pending pause) (measure pause-first-reader 8 #t))
    (displayln "REVERSE-BUCKET-PAUSE readers=" size " pauses=8 clocks=" pause)
    ;; Reuse the same prepared spine to qualify removal of later edges.
    (def transient (for/collect (_ (in-range 10000)) (gensym 'later-reader)))
    (def (churn)
      (let loop ((keys transient) (current row))
        (if (null? keys) current
          (let (key (car keys))
            (loop (cdr keys)
              (reverse-bucket-remove (reverse-bucket-add current key) key))))))
    (defvalues (after edit-cost) (measure churn 1 #t))
    (defvalues (ordered demand-cost) (measure (cut reverse-bucket-members after) 1 #t))
    (def edit-count (rbtree-size (reverse-bucket-edited after)))
    (unless (and (= edit-count 1) (equal? ordered expected)
                 (equal? (reverse-bucket-members row) expected))
      (error "reverse bucket churn oracle" size edit-count))
    (displayln (list 'INVERSE-CHURN size edit-count
      (qualified-metrics edit-cost) (qualified-metrics demand-cost)))))

;; Standard full scheduling versus sparse repair, with identical prepared inputs.
;; Initial declaration/order preparation remains separate from each update row.
(def (main)
  (for (size '(100000 1000000))
    (let* ((keys (list->vector (for/collect (i (in-range size))
                   (string->symbol (string-append "rank-owner-" (number->string i))))))
           (program (code.pure 0))
           (source (.cc graph.Declaration. keys: (vector->list keys)
             .code: (lambda (_) program) .base: (lambda (_) #f))))
      (let-values (((prior preparation) (measure (cut graph.schedule source) 1)))
        (let (edited (graph.define source (vector-ref keys 1)
                       (code.need (vector-ref keys (- size 2)) identity)))
          (for* ((regime '(natural collected)) (order '((full local local full) (full full local local))))
            (let (observations [])
              (for (side order)
                (let-values (((result costs)
                              (measure (lambda () (if (eq? side 'full) (graph.schedule edited)
                                                     (graph.reschedule prior edited))) 1
                                       (eq? regime 'collected))))
                  (defvalues (emitted order-costs) (measure (cut graph.schedule-order result) 1))
                  (unless (and (= (length emitted) size) (valid-order? result (vector->list keys)))
                    (error "rank update oracle"))
                  (def work (graph.schedule-work result))
                  (when (eq? side 'local)
                    (unless (and (= (.@ work owner-checks) size)
                                 (= (.@ work footprint-reads) size)
                                 (= (.@ work search-buckets) 2)
                                 (= (.@ work search-edges) 0)
                                 (= (.@ work rank-writes) 2)
                                 (= (.@ work copied-entries) 0)
                                 (= (.@ work order-materialized) 0)
                                 (= (.@ work patch-writes) 8))
                      (error "rank update work oracle")))
                  (set! observations
                    (cons (list side costs (cons 'order-query order-costs)
                                (cons 'work (.alist/sort work))) observations))))
              (display "GRAPH-RANK-PAIR ")
              (write (list size regime order (cons 'initial-order preparation) (reverse observations)))
              (newline)))))))
  (displayln "GRAPH-RANK-PAIRED-OK observations=32")
  (void))


;; Interleave the unrestricted and owned entry points on equivalent initial
;; rows. Keep staging inside the timed owned action; the cold index setup and
;; full order materialization are explicitly outside it.
(def (owned-delta-study)
  (for (size '(100000 1000000))
    (def keys (for/collect (i (in-range size))
      (string->symbol (string-append "delta-owner-" (number->string i)))))
    (def consumer (cadr keys))
    (def provider (list-ref keys (- size 2)))
    (def code (code.need provider (lambda (_) (error "benchmark evaluated a program"))))
    (def source (graph.declaration keys []))
    (defvalues (ordinary ordinary-setup) (measure (cut graph.schedule source) 1))
    (defvalues (owned owned-setup) (measure (cut graph.schedule-owned keys []) 1))
    (def edited (graph.define source consumer code))
    (def codes (list (cons consumer code)))
    (def ordinary-next #f)
    (def owned-next #f)
    (for (side '(ordinary owned owned ordinary owned ordinary ordinary owned))
      (defvalues (result clocks)
        (measure (if (eq? side 'owned)
                   (lambda () (graph.apply-schedule-revision owned (graph.schedule-revision owned codes)))
                   (cut graph.reschedule ordinary edited)) 1))
      (def work (graph.schedule-work result))
      (unless (and (= (.@ work owner-checks) (if (eq? side 'owned) 1 size))
                   (= (.@ work footprint-reads) 1)
                   (= (.@ work search-buckets) 2)
                   (= (.@ work rank-writes) 2)
                   (= (.@ work copied-entries) 0)
                   (= (.@ work order-materialized) 0)
                   (= (.@ work source-patch-writes) (if (eq? side 'owned) 1 0))
                   (equal? ((graph.schedule-reads result) consumer) (list provider)))
        (error "delta work oracle" side))
      (if (eq? side 'owned) (set! owned-next result) (set! ordinary-next result))
      (write (list 'GRAPH-OWNED-DELTA size side clocks (.alist/sort work)))
      (newline) (force-output))
    (defvalues (order order-cost) (measure (cut graph.schedule-order owned-next) 1))
    (unless (and (equal? order (graph.schedule-order ordinary-next))
                 (valid-order? owned-next keys))
      (error "owned order differs from the checked unrestricted repair"))
    (write (list 'GRAPH-OWNED-SETUP size ordinary-setup owned-setup order-cost))
    (newline) (force-output))
  (displayln "GRAPH-OWNED-PAIRED-OK observations=16"))


;; The explicit value projection and the full cold build are separate.
(def (owned-invalidation-study)
  ;; Prepared structural revision, not Module EVAL. Charge source capture once
  ;; and ticket issuance separately; both arms apply the SAME actual ticket.
  (for (size '(100000 1000000))
    (def names (list->vector (for/collect (i (in-range size))
      (string->symbol (string-append "inverse-owner-" (number->string i))))))
    (def (key i) (vector-ref names i))
    (def width 1000)
    (def expected (for/collect (i (in-range width)) (key i)))
    (def codes (for/collect (i (in-range 1 width))
      (cons (key i) (code.need (key (1- i)) identity))))
    (defvalues (prior setup)
      (measure (lambda () (graph.schedule-owned (vector->list names) codes
        [(cons (key 0) (some (code.make-success 1)))])) 1))
    (displayln (list 'GRAPH-INVERSE-SETUP size (qualified-metrics setup)
      'raw-allocation (vector-ref setup 4)))
    (def continuation (graph.schedule-invalidation prior))
    (for (round (in-range 4))
      (defvalues (ticket issued)
        (measure (lambda ()
          (graph.schedule-revision prior [(cons (key 0) (code.pure (+ round 2)))])) 1))
      (def (sample side)
        (defvalues (result clocks)
          (measure (lambda ()
            (call-with-values
              (lambda ()
                (if (eq? side 'reference)
                  (graph.apply-schedule-revision prior ticket affected?: #t)
                  (graph.%apply-schedule-revision-with-invalidation prior ticket #t continuation)))
              list)) 1))
        (unless (equal? (cadr result) expected) (error "inverse closure/order mismatch" size round side))
        (unless (equal? (caddr result)
                  (if (or (eq? side 'reference) (zero? round)) (vector width (1- width)) '#(0 0)))
          (error "inverse bucket replay mismatch" size round side (caddr result)))
        (unless (zero? (.get (graph.schedule-work (car result)) order-materialized))
          (error "inverse revision enumerated full order" size round side))
        (list (qualified-metrics clocks) (caddr result) 'raw-allocation (vector-ref clocks 4)))
      (measure-pair (if (even? round) '(reference resumed) '(resumed reference)) sample
        (lambda (rows)
          (displayln (list 'GRAPH-INVERSE-PAIR size round
            'ticket (qualified-metrics issued) 'rows rows))
          (force-output))))))

(def (owned-cache-study)
  (for (size '(100000 1000000))
    (def names (for/collect (i (in-range size))
      (string->symbol (string-append "value-owner-" (number->string i)))))
    (def consumer (cadr names))
    (def provider (list-ref names (- size 2)))
    (def outer (list-ref names (1- size)))
    (def bases (list (cons consumer (some (code.make-success 3)))
                     (cons provider (some (code.make-success 7)))))
    (def codes (list (cons outer (code.need consumer identity))))
    (def edit (list (cons consumer (code.need provider (cut + <> 1)))))
    (defvalues (scheduled schedule-cost) (measure (cut graph.schedule-owned names codes bases) 1))
    (defvalues (old cold-cost) (measure (cut cache.start-owned scheduled) 1))
    (def result #f)
    (for (iteration (in-range 4))
      (defvalues (next clocks) (measure (lambda () (cache.refresh-revision old (cache.revision old edit))) 1))
      (def work (cache.cache-work next))
      (unless (and (equal? (cache.cache-evaluated next) (list consumer outer))
                   (= (value next outer) 8) (= (value old outer) 3)
                   (eq? (cache.cache-ref next provider) (cache.cache-ref old provider))
                   (= (.get work graph owner-checks) 1)
                   (= (.get work graph order-materialized) 0)
                   (= (.get work inverse-buckets) 2)
                   (= (.get work inverse-edges) 1)
                   (= (.get work value-patch-writes) 2))
        (error "affected materialization work oracle"))
      (set! result next)
      (write (list 'GRAPH-OWNED-CACHE size iteration clocks
                  (list (.get work inverse-buckets) (.get work inverse-edges) (.get work value-patch-writes))))
      (newline) (force-output))
    (defvalues (reused projection-cost) (measure (cut cache.cache-reused result) 1))
    (unless (= (length reused) (- size 2)) (error "complete reuse output oracle"))
    (write (list 'GRAPH-OWNED-CACHE-SETUP size schedule-cost cold-cost projection-cost))
    (newline) (force-output)
    (def replacement 'value-replacement)
    (def support-codes
      [(cons replacement (code.need provider (cut + <> 1)))
       (cons outer (code.need replacement identity))])
    (def builder (.cc cache.Builder.))
    (defvalues (support-next support-clocks)
      (measure (lambda ()
        (cache.%revise-with-builder old support-codes builder added: (list replacement)
          retired: (list consumer) before?: (lambda (fresh _) (eq? fresh replacement)))) 1))
    (def support-work (cache.cache-work support-next))
    (unless (and (equal? (cache.cache-evaluated support-next) (list replacement outer))
                 (= (value support-next outer) 8) (= (value old outer) 3)
                 (not (cache.cache-ref support-next consumer))
                 (eq? (cache.cache-ref support-next provider) (cache.cache-ref old provider))
                 (= (.get support-work graph owner-checks) 2)
                 (= (.get support-work graph retirement-readers) 1)
                 (= (.get support-work graph order-materialized) 0)
                 (= (.get support-work value-patch-writes) 3))
      (error "support revision work oracle"))
    (defvalues (support-reused support-output) (measure (cut cache.cache-reused support-next) 1))
    (unless (and (= (length support-reused) (- size 2)) (not (memq consumer support-reused)))
      (error "support revision reuse output oracle"))
    (write (list 'GRAPH-OWNED-CACHE-SUPPORT size (qualified-metrics support-clocks)
      (qualified-metrics support-output) (.alist/sort (.get support-work graph))))
    (newline) (force-output))
  (displayln "GRAPH-OWNED-CACHE-OK observations=8"))

;; The oracle uses ordinary full SCC discovery from the same complete rows.
(def (row-source names rows)
  (.o keys: names
    .code: (lambda (key)
      (let (row (hash-ref rows key [])) (and (pair? row) (.o reads: row))))))
(def (same-components? keys left right)
  (and (equal? (scc.partition-groups left) (scc.partition-groups right))
       (andmap (lambda (key)
         (and (eq? ((scc.partition-owner left) key) ((scc.partition-owner right) key))
              (equal? ((scc.partition-reads left) key) ((scc.partition-reads right) key))
              (equal? (scc.partition-group-of left key) (scc.partition-group-of right key))
              (= (scc.partition-group-size left key) (scc.partition-group-size right key)))) keys)))

(def (check-component-retirement)
    (test-case "edited inverse buckets release removed insertions while masking borrowed readers"
      (def base '(a b))
      (def masked (reverse-bucket-remove base 'a))
      (def readded (reverse-bucket-add masked 'a))
      (def current
        (let loop ((remaining 10000) (row readded))
          (if (zero? remaining) row
            (let (key (gensym 'temporary-reader))
              (loop (1- remaining) (reverse-bucket-remove (reverse-bucket-add row key) key))))))
      (check-equal? (rbtree-size (reverse-bucket-edited current)) 1)
      (check-equal? (reverse-bucket-members current) '(a b))
      (check-equal? (reverse-bucket-members (reverse-bucket-remove current 'a)) '(b))
      (check-equal? (reverse-bucket-members masked) '(b))
      (check-equal? base '(a b))
      (def fresh (gensym 'first-reader))
      (def expanded (reverse-bucket-add base fresh))
      (def restored (reverse-bucket-remove expanded fresh))
      (check-eq? restored base)
      (check-equal? (reverse-bucket-members expanded) (cons fresh base)))
    (test-case "retired fresh names leave no entries in either active roster index"
      (def cold (%roster '(a b) (list->hash-table-eq '((a . 0) (b . 1)))))
      (def old (%roster-append cold '(c)))
      (def current
        (let loop ((remaining 10000) (roster old))
          (if (zero? remaining) roster
            (let (key (gensym 'temporary-owner))
              (loop (1- remaining) (%roster-retire (%roster-append roster (list key)) (list key)))))))
      (check-equal? (%roster-width current) 10003)
      (check-equal? (rbtree-size (roster-appended current)) 1)
      (check-equal? (rbtree-size (%index-changes (roster-positions current))) 1)
      (def next (%roster-append (%roster-retire current '(a c)) '(a c)))
      (check-equal? (%roster-keys next) '(b a c))
      (check-equal? (%roster-position next 'a) 10003)
      (check-equal? (%roster-position next 'c) 10004)
      (check-equal? (%roster-keys old) '(a b c))
      (check-equal? (%roster-position old 'c) 2))
    (test-case "retiring an isolated ordinal leaves the old snapshot and active SCC order intact"
      (def rows (list->hash-table-eq '((b a) (c b) (d c))))
      (def prior (scc.partition-owned (row-source '(a b c d) rows)))
      (check-exception (%retire-partition-isolates prior '(a)) error-object?)
      (check-exception (%retire-partition-isolates prior '(b)) error-object?)
      (def isolated (scc.revise-partition prior '((b))))
      (def next (%retire-partition-isolates isolated '(a)))
      (def retained (%partition-owned isolated))
      (def successor (%partition-owned next))
      (for (index [owned-partition-roster owned-partition-forward])
        (check-eq? (index retained) (index successor)))
      (check-eq? (%index-base (owned-partition-backward retained))
                 (%index-base (owned-partition-backward successor)))
      (check-equal? (scc.partition-group-size next 'a) #f)
      (check-exception ((scc.partition-owner next) 'a) UnboundKeyError?)
      (check-exception ((scc.partition-reads next) 'a) UnboundKeyError?)
      (check-equal? (scc.%partition-key-position next 'b) (scc.%partition-key-position prior 'b))
      (check-equal? (.get (scc.partition-work next) roster-materialized) 0)
      (check-equal? (scc.partition-groups prior) '((a) (b) (c) (d)))
      (check-equal? (scc.partition-groups next) '((b) (c) (d)))
      (check-exception (scc.revise-partition next '((b a)))
        (lambda (cause) (and (Error? cause) (equal? (Error-message cause) "unsupported component read"))))
      (check-exception (scc.revise-partition next '((a)))
        (lambda (cause) (and (Error? cause) (equal? (Error-message cause) "unsupported component row replacement"))))
      (def edited (scc.revise-partition next '((b d))))
      (hash-put! rows 'b '(d))
      (def rebuilt (scc.partition (row-source '(b c d) rows)))
      (check (same-components? '(b c d) edited rebuilt) => #t)
      (check-equal? (scc.%partition-representatives edited) '(b)))
    (test-case "retired fresh names leave no source or SCC overrides"
      (def (register action) (action))
      (def spec (graph.declaration '(a) []))
      (def source (graph.%capture-component-source spec register))
      (def partition (scc.partition-owned spec))
      (def update (graph.%edit-component-source source [(cons 'b (code.pure 1))]
                    [(cons 'b (some (code.make-success 2)))] register added: '(b)))
      (def expanded (vector-ref update 0))
      (def padded (%append-partition-owners partition (%component-source-roster expanded) '(b)))
      (def retired (%retire-component-source expanded '(b) register))
      (def next (%retire-partition-isolates padded '(b) (%component-source-roster retired)))
      (for (index [%owned-source-programs %owned-source-bases])
        (check-equal? (rbtree-size (%index-changes (index (%component-source-storage retired)))) 0)
        (check-equal? (rbtree-size (%index-changes (index (%component-source-storage expanded)))) 1))
      (for (index [owned-partition-owner owned-partition-members owned-partition-forward owned-partition-backward])
        (check-equal? (rbtree-size (%index-changes (index (%partition-owned next)))) 0)
        (check-equal? (rbtree-size (%index-changes (index (%partition-owned padded)))) 1))
      (check-equal? (scc.partition-groups next) '((a)))
      (check-equal? (scc.partition-groups padded) '((a) (b))))
    (test-case "source retirement drops only the retired ordinal's witnessed inputs"
      (def input (.o dependencies: []))
      (def retired-program (.o reads: (.get input dependencies)
                              .evaluate: (lambda (_) (code.make-success 0))))
      (def source (graph.declaration '(a b) [(cons 'a retired-program)] []))
      (def (register action) (action))
      (def old (graph.%capture-component-source source register))
      (def next (%retire-component-source old '(a) register))
      (check-equal? (not (%component-source-code-witnesses old)) #f)
      (check-equal? (%component-source-code-witnesses next) #f)
      (def view (graph.%component-source-view next))
      (check-equal? (.get view keys) '(b))
      (check-equal? (.get (graph.%component-source-view old) keys) '(a b))
      (check-equal? (.call view .code 'a) #f)
      (check-exception (graph.%edit-component-source next [(cons 'b (code.need 'a identity))] [] register)
        (lambda (cause) (and (graph.failure? cause) (eq? (graph.failure-key cause) 'a))))
      (.put! input 'dependencies '(b))
      (check-equal? (Error-message (caught (cut graph.%component-source-current! old)))
        "component source generation is stale")
      (check-equal? (caught (cut graph.%component-source-current! next)) #f))
    (test-case "witness expansion shares the old span and propagates invalidation"
      (def earlier (make-object))
      (def later (make-object))
      (def (register action) (action))
      (def (attach witness input) (depend-on-object! witness input) #t)
      (def old (graph.%splice-witness-tree #f 3 [(cons 2 earlier)] attach register))
      (def next (graph.%splice-witness-tree old 3 [(cons 10 later)] attach register minimum-width: 11))
      (def sibling (graph.%splice-witness-tree old 3 [] attach register minimum-width: 11))
      (check-equal? (graph.%witness-span 3 11) 12)
      (check (eq? (graph.%witness-tree-left (graph.%witness-tree-left next)) old) => #t)
      (check (graph.%witness-tree-current? next) => #t)
      (uninstantiate-object! later)
      (check (graph.%witness-tree-current? next) => #f)
      (check (graph.%witness-tree-current? old) => #t)
      (check (graph.%witness-tree-current? sibling) => #t)
      (uninstantiate-object! earlier)
      (check (graph.%witness-tree-current? old) => #f)
      (check (graph.%witness-tree-current? sibling) => #f)
      (def late (graph.%splice-witness-tree old 3 [] attach register minimum-width: 11))
      (check (graph.%witness-tree-current? late) => #f)))

(def (check-retained-component-publication)
    (test-case "retained direction skips SCC walks and a back edge still merges"
      (for (names '((a b c d outside) (outside d c b a)))
        (let* ((rows (list->hash-table-eq '((b a) (c b) (d c) (outside a))))
               (old (scc.partition-owned (row-source names rows)))
               (next (scc.revise-partition old '((d a b d) (c a)))))
          (hash-put! rows 'd '(a b d))
          (hash-put! rows 'c '(a))
          (check (same-components? names next (scc.partition (row-source names rows))) => #t)
          (let ((work (scc.partition-work next))
                (before (%partition-owned old)) (after (%partition-owned next)))
            (for (field '(forward-buckets reverse-buckets forward-edges reverse-edges
                          region-owners region-edge-visits owner-writes member-writes rebased-owners))
              (check-equal? (.ref work field) 0))
            (check-equal? (.get work rank-checks) 4)
            (check-equal? (.get work retained-direction) (if (eq? (car names) 'a) 1 2))
            (check-eq? (owned-partition-owner before) (owned-partition-owner after))
            (check-eq? (owned-partition-members before) (owned-partition-members after)))
          (check-equal? ((scc.partition-reads old) 'd) '(c))
          ;; Invalidating the retained direction must use complete SCC repair.
          (let (merged (scc.revise-partition next '((a d))))
            (hash-put! rows 'a '(d))
            (check (same-components? names merged (scc.partition (row-source names rows))) => #t)
            (check-equal? (scc.partition-group-size merged 'a) 3)
            (check-equal? (.get (scc.partition-work merged) retained-direction) #f)
            (check-equal? (scc.partition-group-size next 'a) 1))
          (check-exception (scc.revise-partition next '((absent a))) error-object?)
          (check-exception (scc.revise-partition next '((d missing))) error-object?))))
    (test-case "internal additions and external removals retain SCC maps and retire cycle evidence"
      (def names '(a b c outside))
      (def rows (list->hash-table-eq '((a b) (b c outside) (c a))))
      (def old (scc.partition-owned (row-source names rows)))
      (def next (scc.revise-partition old '((a b c) (b c))))
      (hash-put! rows 'a '(b c))
      (hash-put! rows 'b '(c))
      (check (same-components? names next (scc.partition (row-source names rows))) => #t)
      (def work (scc.partition-work next))
      (check-equal? (.get work retained-components) #t)
      (check-equal? (.get work component-checks) 2)
      (for (field '(forward-buckets reverse-buckets region-owners region-edge-visits owner-writes member-writes))
        (check-equal? (.ref work field) 0))
      (check-eq? (owned-partition-owner (%partition-owned old)) (owned-partition-owner (%partition-owned next)))
      (check-eq? (owned-partition-members (%partition-owned old)) (owned-partition-members (%partition-owned next)))
      (check-equal? ((scc.partition-reads old) 'a) '(b))
      (check-equal? ((scc.partition-reads old) 'b) '(c outside))
      ;; A true functional ring receives a chord. Its SCC survives, but its
      ;; functional-cut certificate must not survive the extra outgoing edge.
      (def ring (scc.partition-owned (row-source '(a b c)
                    (list->hash-table-eq '((a b) (b c) (c a))))))
      (def chord (scc.revise-partition ring '((a b c))))
      (check-equal? (.get (scc.partition-work chord) retained-components) #t)
      (def split (scc.revise-partition chord '((a c))))
      (check-equal? (scc.partition-groups split) '((a c) (b)))
      (check-equal? (.get (scc.partition-work split) projected-singletons) 0)
      (check-equal? (scc.partition-groups ring) '((a b c)))
      (check-equal? (scc.partition-groups chord) '((a b c))))
    (test-case "retained SCC publication recomputes outside consumers and rejects stale or denied revisions"
      (def names '(a b c consumer untouched))
      (def indices (list->hash-table-eq (map cons names (iota 5))))
      (def build
        (component-group-builder names
          (lambda (key)
            (def index (hash-ref indices key))
            (lens-of-get-set (cut vector-ref <> index)
              (lambda (value raw)
                (def next (vector-copy raw))
                (vector-set! next index value) next)))
          (make-vector 5 0) (make-vector 5 0) 8))
      (def (accept _old _new) #t)
      (def source (graph.declaration names
        (list (cons 'a (code.need 'b (lambda (_) 1)))
              (cons 'b (code.both (code.need 'c identity) (code.need 'untouched identity)
                         (lambda (_c _external) 2)))
              (cons 'c (code.need 'a (lambda (_) 3)))
              (cons 'consumer (code.need 'a (cut + <> 10)))
              (cons 'untouched (code.pure 99)))))
      (defvalues (old initial-failure) (publish-owned-feedback-graph source build accept))
      (check-equal? initial-failure #f)
      (def (read graph key)
        (vector-ref (closed-raw (group-closed (graph-cache-ref graph key))) (hash-ref indices key)))
      (check-equal? (read old 'consumer) 11)
      (def changed (code.both (code.need 'b identity) (code.need 'c identity) (lambda (_b _c) 7)))
      (def local-b (code.need 'c (lambda (_) 2)))
      (def fragments (list (revision.fragment [] [] (list (cons 'a changed) (cons 'b local-b)))))
      (def prior-certificate (.o dependency: 'untouched))
      (def next-certificate (.o dependency: 'c))
      (def publisher (publication.publication old metadata: prior-certificate))
      (def predecessor (publication.snapshot publisher))
      (def foreign (publication.snapshot (publication.publication old)))
      (def (stale-snapshot? cause)
        (and (Error? cause) (equal? (Error-message cause) "stale component revision snapshot")))
      (check-exception (publication.stage publisher fragments build accept expected: foreign)
        stale-snapshot?)
      (def pending (publication.stage publisher fragments build accept
                     expected: predecessor metadata: next-certificate))
      (def stale (publication.stage publisher fragments build accept
                   expected: predecessor metadata: next-certificate))
      (defvalues (installed failure) (publication.submit-snapshot! publisher pending))
      (check-equal? failure #f)
      ;; A producer may return after the rival has already published, even
      ;; before the producer could stage its request.
      (check-exception (publication.stage publisher fragments build accept expected: predecessor)
        stale-snapshot?)
      (check-eq? (publication.snapshot publisher) installed)
      (check-eq? (publication.snapshot-metadata predecessor) prior-certificate)
      (check-eq? (publication.snapshot-metadata installed) next-certificate)
      (def next (publication.snapshot-graph installed))
      (check-equal? (.get (scc.partition-work (graph-cache-partition next)) retained-components) #t)
      (check-equal? (cache.cache-evaluated (graph-cache-values next)) '(a consumer))
      (check-equal? (read next 'consumer) 17)
      (check-equal? (read old 'consumer) 11)
      (check-eq? (graph-cache-ref next 'untouched) (graph-cache-ref old 'untouched))
      (defvalues (cold cold-failure)
        (publish-owned-feedback-graph (graph.define (graph.define source 'a changed) 'b local-b) build accept))
      (check-equal? cold-failure #f)
      (for (key names) (check-equal? (read next key) (read cold key)))
      (defvalues (held stale-failure) (publication.submit-snapshot! publisher stale))
      (check-equal? (and stale-failure #t) #t)
      (check-eq? held installed)
      (def denied-code (code.both (code.need 'b identity) (code.need 'c identity) (lambda (_b _c) 9)))
      (def denied (publication.stage publisher
                    (list (revision.fragment [] [] (list (cons 'a denied-code))))
                    build (lambda (_old _new) #f)))
      (defvalues (refused denial) (publication.submit-snapshot! publisher denied))
      (check-equal? (and denial #t) #t)
      (check-eq? refused installed)
      (check-eq? (publication.snapshot publisher) installed)
      (check-equal? (read (publication.snapshot-graph refused) 'consumer) 17)
      ;; The deleted cross-component dependency must also leave the quotient
      ;; inverse index. A later provider edit must not rebuild its old readers.
      (def provider-edit
        (publication.stage publisher
          (list (revision.fragment [] [] (list (cons 'untouched (code.pure 100))))) build accept))
      (defvalues (final provider-failure) (publication.submit-snapshot! publisher provider-edit))
      (check-equal? provider-failure #f)
      (def final-graph (publication.snapshot-graph final))
      (check-equal? (cache.cache-evaluated (graph-cache-values final-graph)) '(untouched))
      (check-equal? (read final-graph 'untouched) 100)
      (check-equal? (read final-graph 'consumer) 17)
      (check-eq? (graph-cache-ref final-graph 'a) (graph-cache-ref next 'a))))

(def (check-component-merge-and-split)
    (test-case "deletion-only batches repair only old components with internal deletions"
      (def names '(a b c d e f outside))
      (def rows (list->hash-table-eq '((a b) (b a c) (c d) (d c e)
                                       (e f) (f e) (outside b))))
      (def prior (scc.partition-owned (row-source names rows)))
      (defvalues (next _seeds _support)
        (scc.revise-partition prior '((a) (c) (outside)) quotient?: #t))
      (for (key '(a c outside)) (hash-put! rows key []))
      (check (same-components? names next (scc.partition (row-source names rows))) => #t)
      (check-equal? (scc.partition-groups prior) '((a b) (c d) (e f) (outside)))
      (def work (scc.partition-work next))
      (check-equal? (.get work region-owners) 4)
      (check-equal? (.get work forward-buckets) 0)
      (check-equal? (.get work reverse-buckets) 0))
    (test-case "merge across a connector, split again, and retain the old owner maps"
      (def names '(isolated b bridge a tail c))
      (def rows (list->hash-table-eq '((a b) (b a bridge) (bridge c) (tail c))))
      (def old (scc.partition-owned (row-source names rows)))
      (def change (list 'c 'a))
      (def merged (scc.revise-partition old (list change)))
      (set-cdr! change '(tail))
      (hash-put! rows 'c '(a))
      (check-equal? (scc.partition-groups merged) '((isolated) (b bridge a c) (tail)))
      (check (same-components? names merged (scc.partition (row-source names rows))) => #t)
      (check-equal? (.get (scc.partition-work merged) region-owners) 4)
      (check-equal? (scc.partition-members merged 'bridge) #f)
      (set-car! (scc.partition-members merged 'b) 'tail)
      (set-car! ((scc.partition-reads merged) 'c) 'tail)
      (def split (scc.revise-partition merged '((c))))
      (hash-put! rows 'c [])
      (check (same-components? names split (scc.partition (row-source names rows))) => #t)
      (check-equal? (.get (scc.partition-work split) reverse-buckets) 0)
      (check-equal? (.get (scc.partition-work split) forward-buckets) 0)
      (check-equal? (scc.partition-groups old) '((isolated) (b a) (bridge) (tail) (c)))
      (check-equal? (scc.partition-groups merged) '((isolated) (b bridge a c) (tail)))
      (check-equal? ((scc.partition-reads old) 'c) [])
      (check-equal? ((scc.partition-reads merged) 'c) '(a))
      (check-exception (scc.revise-partition merged '((c missing))) error-object?)
      (check-exception (scc.revise-partition merged '((c) (c a))) error-object?)
      (check-equal? ((scc.partition-owner merged) 'c) 'b))
    (test-case "cut a functional component in arbitrary source order and revise its projection"
      (def names '(c a e b d))
      (def rows (list->hash-table-eq '((a b) (b c) (c d) (d e) (e a))))
      (def ring (scc.partition-owned (row-source names rows)))
      (def same (scc.revise-partition ring '((d e))))
      (defvalues (split groups support?)
        (scc.revise-partition same '((d)) quotient?: #t))
      (hash-put! rows 'd [])
      (check (same-components? names split (scc.partition (row-source names rows))) => #t)
      (check-equal? (scc.partition-groups split) '((c) (a) (e) (b) (d)))
      (check-equal? (scc.partition-groups ring) '((c a e b d)))
      (check-equal? (.get (scc.partition-work split) projected-singletons) 5)
      (check-equal? (.get (scc.partition-work split) region-edge-visits) 0)
      (check-equal? (.get (scc.partition-work split) rebased-owners) 0)
      (check-equal? (and support? groups) 'all-representatives)
      (def ordered (scc.%partition-representatives split))
      (check-equal? ordered names)
      (set-car! ordered 'other)
      (check-equal? (scc.%partition-representatives split) names)
      (check-equal? (scc.%partition-representatives ring) '(c))
      (check-equal? (scc.partition-members split 'absent) #f)
      (check-equal? (scc.partition-group-size split 'absent) #f)
      (check-exception ((scc.partition-owner split) 'absent) error-object?)
      (set-car! (scc.partition-members split 'd) 'other)
      (check-equal? (scc.partition-members split 'd) '(d))
      (def next (scc.revise-partition split '((d b))))
      (hash-put! rows 'd '(b))
      (check (same-components? names next (scc.partition (row-source names rows))) => #t)
      (check-equal? (scc.partition-members next 'b) #f)
      (check-equal? (scc.partition-members split 'b) '(b)))
    (test-case "a chord disqualifies the functional certificate"
      (def names '(c a b))
      (def rows (list->hash-table-eq '((a b) (b a c) (c a))))
      (def ring (scc.partition-owned (row-source names rows)))
      (def next (scc.revise-partition ring '((c))))
      (hash-put! rows 'c [])
      (check (same-components? names next (scc.partition (row-source names rows))) => #t)
      (check-equal? (scc.partition-groups next) '((c) (a b)))
      (check-equal? (.get (scc.partition-work next) projected-singletons) 0))
    (test-case "128 deterministic compound edits preserve cold groups, representatives and rows"
      (def names '(e a d b f c))
      (def rows (make-hash-table-eq))
      (def old (scc.partition-owned (row-source names rows)))
      (def state 1951)
      (def (choose limit)
        (set! state (modulo (+ (* 48271 state) 1) 2147483647))
        (modulo state limit))
      (for (_ (in-range 128))
        (def first (choose 6))
        (def second (modulo (+ first 1 (choose 5)) 6))
        (def patch
          (for/collect (index (list first second))
            (def key (list-ref names index))
            (def reads
              (for/collect (_ (in-range (choose 7))) (list-ref names (choose 6))))
            (hash-put! rows key reads)
            (cons key reads)))
        (def next (scc.revise-partition old patch))
        (check (same-components? names next (scc.partition (row-source names rows))) => #t)
        (for (provider names)
          (def inverse (owned-partition-backward (%partition-owned next)))
          (def actual [])
          (graph.%for-each-reverse-bucket
            (lambda (consumer) (set! actual (cons consumer actual)))
            (graph.%index-ref inverse provider []))
          (def expected (filter (lambda (consumer) (memq provider (hash-ref rows consumer []))) names))
          (check-equal? (length actual) (length expected))
          (check-equal? (filter (cut memq <> actual) names) expected))
        (set! old next))))

(def local-components-test
  (test-suite "local SCC partition against cold discovery"
    (check-component-retirement)
    (check-retained-component-publication)
    (check-component-merge-and-split)))

(def (local-owner-append-study old count)
  (def prior-roster (owned-partition-roster (%partition-owned old)))
  (for (iteration (in-range 4))
    (defvalues (next clocks)
      (measure (lambda ()
        (def roster (%roster-append prior-roster '(new)))
        (def padded (%append-partition-owners old roster '(new)))
        (defvalues (result seeds support)
          (scc.revise-partition padded '((loop new) (new pivot)) quotient?: #t))
        (unless (and (hash-key? seeds 'outsider)
                     (equal? (scc.quotient-support-retired support) '(bridge loop new)))
          (error "append quotient mismatch"))
        result) 1))
    (def work (scc.partition-work next))
    (unless (and (= 4 (.get work region-owners))
                 (= 4 (.get work quotient-reader-edges))
                 (= 4 (scc.partition-group-size next 'new))
                 (= 1 (scc.partition-group-size old 'loop))
                 (eq? ((scc.partition-owner next) 'outsider) 'outsider))
      (error "append region or snapshot mismatch" count iteration))
    (displayln (list 'APPEND-LOCAL count iteration (qualified-metrics clocks)
      (.get work region-owners) (.get work quotient-reader-edges)))))

(def (mixed-owner-study old names count)
  (def prior (scc.revise-partition old '((loop pivot))))
  (def prior-roster (owned-partition-roster (%partition-owned prior)))
  (def replacements '((pivot) (loop new) (new loop)))
  (def final-keys (append (cons 'pivot (cddr names)) '(new)))
  (def rows (list->hash-table-eq '((loop new) (new loop) (outsider loop))))
  (def (local)
    (%check-partition-retirements prior '(bridge) replacements)
    (def padded-roster (%roster-append prior-roster '(new)))
    (def padded (%append-partition-owners prior padded-roster '(new)))
    (defvalues (repaired seeds support)
      (scc.revise-partition padded (cons '(bridge) replacements) quotient?: #t))
    (unless (and (hash-key? seeds 'outsider)
                 (equal? (scc.quotient-support-added support) '(bridge loop))
                 (equal? (scc.quotient-support-retired support) '(new)))
      (error "mixed owner quotient mismatch" count))
    (%retire-partition-isolates repaired '(bridge) (%roster-retire padded-roster '(bridge))))
  (def (sample side)
    (defvalues (part clocks)
      (measure (if (eq? side 'local) local
                 (lambda () (scc.partition-owned (row-source final-keys rows)))) 1))
    (unless (and (equal? (scc.partition-group-of part 'new) '(loop new))
                 (equal? (scc.partition-group-of part 'pivot) '(pivot))
                 (not (scc.partition-group-of part 'bridge))
                 (equal? ((scc.partition-reads part) 'outsider) '(loop))
                 (= (scc.partition-group-size prior 'bridge) 3))
      (error "mixed owner cold oracle mismatch" count side))
    (let (work (scc.partition-work part))
      (when (eq? side 'local)
      (unless (and (= (.get work region-owners) 4)
                   (= (.get work quotient-reader-edges) 3)
                   (= (.get work retired-owners) 1)
                   (= (.get work roster-materialized) 0))
        (error "mixed owner local work mismatch" count work))))
    (qualified-metrics clocks))
  (measure-pair '(cold local local cold) sample
    (lambda (samples)
      (for (sample samples)
        (displayln (list 'MIXED-OWNER count (car sample) (cdr sample)))))))

(def (local-components-study)
  (for (count '(100000 1000000))
    (def names
      (append '(pivot bridge loop outsider)
        (for/collect (i (in-range (- count 4)))
          (string->symbol (string-append "scc-region-" (number->string i))))))
    (def rows (list->hash-table-eq '((pivot bridge) (bridge loop) (outsider loop))))
    (defvalues (old setup) (measure (lambda () (scc.partition-owned (row-source names rows))) 1))
    (displayln (list 'GRAPH-LOCAL-SCC-SETUP count setup))
    (def current old)
    (for (iteration (in-range 4))
      (def merge? (even? iteration))
      (def patch (if merge? '((loop pivot)) '((loop))))
      (defvalues (next clocks) (measure (lambda () (scc.revise-partition current patch)) 1))
      (def work (scc.partition-work next))
      (def counts (list (.get work region-owners) (.get work forward-buckets)
                    (.get work reverse-buckets) (.get work forward-edges)
                    (.get work reverse-edges) (.get work member-writes)))
      (unless (and (= (car counts) 3)
                   (= (scc.partition-group-size next 'loop) (if merge? 3 1))
                   (= (scc.partition-group-size current 'loop) (if merge? 1 3))
                   (eq? ((scc.partition-owner next) 'outsider) 'outsider))
        (error "local SCC work or snapshot discrepancy" count iteration counts))
      (displayln (list 'GRAPH-LOCAL-SCC count iteration clocks counts))
      (set! current next))
    (local-owner-append-study old count)
    (mixed-owner-study old names count))
  (displayln "GRAPH-LOCAL-SCC-OK observations=8"))

(def (quotient-roster-study part names count)
  (def (reference)
    (def seeds (make-hash-table-symbolic size: count))
    (for (key names) (hash-put! seeds key #t))
    (values (scc.%partition-order-keys part (hash-keys seeds))
            (map car (scc.partition-groups part))))
  (def (sample side)
    (defvalues (result clocks)
      (measure (lambda ()
        (if (eq? side 'reference)
          (let-values (((edited support) (reference))) (cons edited support))
          (let (ordered (scc.%partition-representatives part)) (cons ordered ordered))))
        1 #t))
    (unless (and (equal? names (car result)) (equal? names (cdr result)))
      (error "quotient roster disagrees with source order" count side))
    (qualified-metrics clocks))
  (measure-pair '(reference certified certified reference) sample
    (lambda (samples)
      (for (sample samples)
        (displayln (list 'GRAPH-LOCAL-QUOTIENT-ROSTER count (car sample) (cdr sample)))))))

(def (local-component-pressure-study shape)
  (for (count '(100000 1000000))
    (def names (for/collect (index (in-range count))
      (string->symbol (string-append "scc-region-" (number->string index)))))
    (def first (car names))
    (def final-key (list-ref names (1- count)))
    (def rows (make-hash-table-symbolic size: count))
    (case shape
      ((ring)
       (for ((key names) (next (cdr names))) (hash-put! rows key (list next)))
       (hash-put! rows final-key (list first)))
      ((hub)
       (for (key (cdr names)) (hash-put! rows key (list first))))
      (else (error "unknown SCC pressure shape" shape)))
    (defvalues (old setup) (measure (lambda () (scc.partition-owned (row-source names rows))) 1))
    (defvalues (next delta) (measure (lambda () (scc.revise-partition old (list (list final-key)))) 1))
    (def work (scc.partition-work next))
    ;; An ordered hub deletion retains the certified singleton maps; unlike
    ;; the ring cut, it no longer needs even a one-owner SCC repair region.
    (def expected-width (if (eq? shape 'ring) count 0))
    (unless (and (= (scc.partition-group-size old final-key) (if (eq? shape 'ring) count 1))
                 (= (scc.partition-group-size next final-key) 1)
                 (= (.get work region-owners) expected-width)
                 (= (.get work forward-buckets) 0) (= (.get work reverse-buckets) 0)
                 (= (.get work reverse-rewrite-edges) 0)
                 (= (.get work reverse-removals) 1))
      (error "invalid SCC pressure result" shape count))
    (displayln (list 'GRAPH-LOCAL-SCC-PRESSURE shape count (qualified-metrics setup) (qualified-metrics delta)
      (list 'region (.get work region-owners)
            'edges (.get work region-edge-visits)
            'reverse-rewrite-edges (.get work reverse-rewrite-edges)
            'reverse-removals (.get work reverse-removals)
            'rebased-owners (.get work rebased-owners)
            'projected-singletons (.get work projected-singletons))))
    (when (eq? shape 'ring)
      (unless (and (= (.get work projected-singletons) count)
                   (zero? (.get work region-edge-visits))
                   (zero? (.get work rebased-owners)))
        (error "functional cut rebuilt the partition" count))
      (let-values (((groups demand) (measure (cut scc.partition-groups next) 1 #t)))
        (let check-order ((remaining names) (output groups))
          (cond
           ((and (null? remaining) (null? output)) (void))
           ((and (pair? remaining) (pair? output)
                 (eq? (caar output) (car remaining)) (null? (cdar output)))
            (check-order (cdr remaining) (cdr output)))
           (else (error "functional cut demand disagrees with source order" count))))
        (displayln (list 'GRAPH-LOCAL-RING-DEMAND count (qualified-metrics demand))))
      (let-values (((quotient clocks)
                    (measure (lambda ()
                      (let-values (((part changed support?)
                                    (scc.revise-partition old (list (list final-key)) quotient?: #t)))
                        (vector part changed support?))) 1 #t)))
        (unless (and (vector-ref quotient 2) (eq? (vector-ref quotient 1) 'all-representatives))
          (error "functional cut quotient omits changed representatives" count))
        (displayln (list 'GRAPH-LOCAL-RING-QUOTIENT count (qualified-metrics clocks)))
        (quotient-roster-study (vector-ref quotient 0) names count)))
    (when (eq? shape 'hub)
      (unless (and (= (.get work retained-direction) 1)
                   (zero? (.get work owner-writes)) (zero? (.get work member-writes)))
        (error "ordered hub deletion failed to share its certified maps" count))
      (for (sample (in-range 4))
        (defvalues (repeated timing) (measure (lambda () (scc.revise-partition old (list (list final-key)))) 1))
        (def observed (scc.partition-work repeated))
        (unless (and (zero? (.get observed reverse-rewrite-edges))
                     (= (.get observed reverse-removals) 1)
                     (= (.get observed region-owners) 0)
                     (= (.get observed retained-direction) 1)
                     (zero? (.get observed owner-writes)) (zero? (.get observed member-writes)))
          (error "repeated hub update changed the physical footprint" count sample))
        (displayln (list 'GRAPH-LOCAL-HUB-REPEAT count sample (qualified-metrics timing)))))))
