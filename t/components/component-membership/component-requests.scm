      (def build owned-service.build-group)
      (def (accept _ __) #t)
      (defvalues (initial startup) (publish-owned-feedback-graph start-source build accept))
      (check-equal? startup #f)
      (def owner (publication.publication initial))
      (def before (publication.snapshot owner))
      (def split-program (code.need 'quota identity))
      (def (edit program) (list (revision.fragment [] [] (list (cons 'right program)))))
      (def split-meta (.o marker: 'split))
      (def denied (publication.stage owner (edit split-program) build (lambda (_ __) #f) metadata: split-meta))
      (defvalues (held refused) (publication.submit-snapshot! owner denied))
      (check (not (not refused)) => #t)
      (check (eq? held before) => #t)
      (def first (publication.stage owner (edit split-program) build accept metadata: split-meta))
      (defvalues (installed installed-error) (publication.submit-snapshot! owner first))
      (check-equal? installed-error #f)
      (check (eq? (publication.snapshot-metadata installed) split-meta) => #t)
      (def split (publication.snapshot-graph installed))
      (def partition (graph-cache-partition split))
      (check-equal? (scc.partition-groups partition) '((quota) (left) (right) (settlement) (stable)))
      (check-equal? (.get (scc.partition-work partition) quotient-reader-edges) 2)
      (check-equal? (evaluated split) '(right left settlement))
      (defvalues (cold-split cold-error)
        (publish-feedback-graph #f (graph.define start-source 'right split-program) build accept))
      (check-equal? cold-error #f)
      (check-equal? (owned-service.report split) (owned-service.report cold-split))
      (def second (publication.stage owner (edit (.call start-source .code 'right)) build accept))
      (defvalues (merged merged-error) (publication.submit! owner second))
      (check-equal? merged-error #f)
      (check-equal? (evaluated merged) '(left settlement))
      (check-equal? (owned-service.report merged) (owned-service.report initial))
      (check-equal? (scc.partition-groups partition) '((quota) (left) (right) (settlement) (stable)))
      (check (eq? (graph-cache-ref initial 'stable) (graph-cache-ref merged 'stable)) => #t)
      (check-equal? (owned-service.report initial) '(3 3 3 6 2))
      (check-equal? (cache.cache-ref (graph-cache-values merged) 'right) #f)
      (def fork (publication.publication merged))
      (def readdition (publication.stage fork (edit (code.pure 1)) build accept))
      (defvalues (split-again readdition-error) (publication.submit! fork readdition))
      (check-equal? readdition-error #f)
      (check-equal? (owned-service.report split-again) '(3 2 1 3 2))
      (check-equal? (owned-service.report split) '(3 3 3 6 2))
      ;; A different support set goes through complete source capture.
      (def removal (publication.stage owner (list (revision.fragment [] '(stable) [])) build accept))
      (defvalues (reconfigured removal-error) (publication.submit! owner removal))
      (check-equal? removal-error #f)
      (check-equal? (scc.partition-groups (graph-cache-partition reconfigured))
        '((quota) (left right) (settlement)))
      (check-equal? (evaluated reconfigured) '(quota left settlement))
      (check-equal? (owned-service.report merged) '(3 3 3 6 2)))
