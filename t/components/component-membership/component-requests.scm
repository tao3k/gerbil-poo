;; Real materializer counters and pointer identity distinguish reuse from equality.
(def (evaluated current) (cache.cache-evaluated (graph-cache-values current)))
;; Topology-only revisions skip unchanged inputs and independent feedback.
(def builder (.cc cache.Builder. allow: (lambda (key) (not (memq key '(quota spare stable))))))
;; Deterministic interleavings test authoritative installation separately from
;; concurrent staging. They do not certify arbitrary parallel mutable callbacks.
(def component-requests-test
  (test-suite "competing staged component requests and joint approval retry"
    (test-case "owned split and merge rebuild outside readers, retaining unrelated values and exact failure head"
