              (unless (eq? (channel-get resume 5 'timeout) 'resume) (error "snapshot reader resume timed out"))
              (vector (publication.snapshot-graph captured) (publication.snapshot-metadata captured)))))
            (channel-put result (cons 'released released))))))))
      (check (eq? (channel-get ready 5 'timeout) before) => #t)
      (def request (publication.stage owner [] component-requests.service.build-group
        (rounds.admit approvals) metadata: new-meta))
      (defvalues (winner ok) (publication.submit-snapshot! owner request))
      (channel-put resume 'resume)
      (def read-result (channel-get result 5 'timeout))
      (thread-join! reader 5)
      (check-equal? ok #f)
      (check (pair? read-result) => #t)
      (check-equal? (car read-result) 'refused)
      (check (eq? (publication.snapshot-metadata before) old-meta) => #t)
      (check (eq? (publication.snapshot-metadata winner) new-meta) => #t))
    (test-case "shared approval domain keeps independent metadata snapshots and guard refusals"
      (def approvals (component-requests.service.policies))
      (def initial (publication.current (component-requests.service.start approvals)))
      (def domain (publication.approval-domain))
      (def meta-a (.o marker: 'a)) (def meta-b (.o marker: 'b))
      (def a (publication.publication initial domain: domain metadata: meta-a))
      (def b (publication.publication initial domain: domain metadata: meta-b))
      (def before-a (publication.snapshot a)) (def before-b (publication.snapshot b))
      (def policy (.o allowed: #t))
      (def guards [(lens-check (.lens) [policy] sources: [policy])])
      (def request-a (publication.stage a [] component-requests.service.build-group
        (rounds.admit approvals) guards: guards))
      (def request-b (publication.stage b [] component-requests.service.build-group
        (rounds.admit approvals) guards: guards))
      (check (eq? (publication.revise-approval! a policy 'allowed #f) initial) => #t)
      (defvalues (held-a failed-a) (publication.submit-snapshot! a request-a))
      (defvalues (held-b failed-b) (publication.submit-snapshot! b request-b))
      (check (not (not failed-a)) => #t) (check (not (not failed-b)) => #t)
      (check (eq? held-a before-a) => #t) (check (eq? held-b before-b) => #t)
      (check (eq? (publication.snapshot-metadata held-a) meta-a) => #t)
      (check (eq? (publication.snapshot-metadata held-b) meta-b) => #t))
    (test-case "paused snapshot reader refuses policy drift with the same head"
      (def approvals (component-requests.service.policies))
      (def owner (component-requests.service.start approvals))
      (def before (publication.snapshot owner))
      (def policy (.o allowed: #t))
      (def guards [(lens-check (.lens) [policy] sources: [policy])])
      (def ready (make-channel)) (def resume (make-channel)) (def result (make-channel))
      (def reader (thread-start! (make-thread (lambda ()
        (with-catch (lambda (cause) (channel-put result (cons 'refused cause)))
          (lambda ()
            (def released (publication.call-with-snapshot owner
              (lambda (_captured)
                (def allowed (.ref policy 'allowed))
                (channel-put ready allowed)
                (unless (eq? (channel-get resume 5 'timeout) 'resume)
                  (error "policy reader resume timed out"))
                allowed)
              guards: guards))
            (channel-put result (cons 'released released))))))))
      (check-equal? (channel-get ready 5 'timeout) #t)
      (publication.revise-approval! owner policy 'allowed #f)
      (channel-put resume 'resume)
      (def read-result (channel-get result 5 'timeout))
      (thread-join! reader 5)
      (check (eq? before (publication.snapshot owner)) => #t)
      (check-equal? (.ref policy 'allowed) #f)
      (check (pair? read-result) => #t)
      (check-equal? (car read-result) 'refused))
    (test-case "snapshot reads keep source guards and multiple return values"
      (def approvals (component-requests.service.policies))
      (def owner (component-requests.service.start approvals))
      (def policy (.o permitted: #t))
      (def guards [(lens-check (.lens) [policy] sources: [policy])])
      (defvalues (graph metadata marker)
        (publication.call-with-snapshot owner (lambda (captured)
          (values (publication.snapshot-graph captured) (publication.snapshot-metadata captured) 'complete))
          guards: guards))
      (check (eq? graph (publication.current owner)) => #t)
      (check-equal? (list metadata marker) '(#f complete))
      (check-exception (publication.call-with-snapshot owner (lambda (_)
        (.putslot! policy 'permitted ($constant-slot-spec #f)) 'not-released) guards: guards) error-object?))
    (test-case "coordinator ownership and no-op publication also reject stale siblings"
      (def approvals (component-requests.service.policies))
      (def owner (component-requests.service.start approvals))
      (def other (publication.publication (publication.current owner)))
      (def request (publication.stage owner [] component-requests.service.build-group (rounds.admit approvals)
        builder: (.cc cache.Builder. allow: (lambda (_) #f))))
      (defvalues (untouched wrong) (publication.submit! other request))
      (check (eq? untouched (publication.current other)) => #t) (check (not (not wrong)) => #t)
      (defvalues (next ok) (publication.submit! owner request))
      (check-equal? ok #f) (check-equal? (evaluated next) [])
      (defvalues (held stale) (publication.submit! owner request))
      (check (eq? held next) => #t) (check (not (not stale)) => #t))))

;; Return the original suites from this lexical scope.
(values component-requests-test)
