    (test-case "owned restage resumes inverse work, drops revoked roots and retires on commit"
      (def build owned-service.build-group)
      (defvalues (initial startup)
        (publish-owned-feedback-graph (owned-service.source 3) build (lambda (_ __) #t)))
      (check-equal? startup #f)
      (def owner (publication.publication initial))
      (def before (publication.snapshot owner))
      (def first #f) (def later #f) (def work #f)
      (def (state request) (%lineage-invalidation (%request-lineage request)))
      (def (fragments quota stable?)
        (list (revision.fragment [] [] (if stable? [(cons 'stable (code.pure stable?))] [])
          (if quota [(cons 'quota (some (code.make-success quota)))] []))))
      (def (inverse candidate name)
        (.ref (cache.cache-work (graph-cache-values candidate)) name))
      (set! first (publication.stage owner (fragments 4 #f) build
        (lambda (_ candidate)
          (set! work (state first))
          (check (not (not work)) => #t)
          (check-equal? (inverse candidate 'inverse-buckets) 3)
          (check-equal? (inverse candidate 'inverse-edges) 2)
          (set! later (publication.restage owner first (fragments 5 7) build
            (lambda (_ next)
              (check (eq? work (state later)) => #t)
              (check-equal? (inverse next 'inverse-buckets) 1)
              (check-equal? (inverse next 'inverse-edges) 0)
              #f)))
          #t)))
      (defvalues (held obsolete) (publication.submit-snapshot! owner first))
      (check (not (not obsolete)) => #t)
      (check (eq? held before) => #t)
      (defvalues (denied refusal) (publication.submit-snapshot! owner later))
      (check (not (not refusal)) => #t)
      (check (eq? denied before) => #t)
      (def calls [])
      (def runner (.cc cache.Builder. allow: (lambda (key)
        (set! calls (cons key calls)) (eq? key 'stable))))
      ;; Dropping quota must not retain its old invalidation cone or candidate.
      (def final (publication.restage owner later (fragments #f 9) build
        (lambda (_ candidate)
          (check (eq? work (state final)) => #t)
          (check-equal? (inverse candidate 'inverse-buckets) 1)
          (check-equal? (inverse candidate 'inverse-edges) 0)
          #t) builder: runner))
      (defvalues (winner failure) (publication.submit-snapshot! owner final))
      (check-equal? failure #f)
      (check-equal? calls '(stable))
      (check-equal? (owned-service.report (publication.snapshot-graph winner)) '(3 3 3 6 9))
      (check-equal? (owned-service.report initial) '(3 3 3 6 2))
      (check (state final) => #f)
      (defvalues (same stale) (publication.submit-snapshot! owner first))
      (check (not (not stale)) => #t)
      (check (eq? same winner) => #t))
