;;; Persistent collection admission shares recursive binding normalization.
(export table-validation-test)
(import :std/test :std/iter
        (only-in :std/list/alist aset arem alist?)
        (only-in :std/list/list foldr)
        ../object ../mop ../number ../type ../table ../rationaldict
        (only-in ../trie SimpleTrie SimpleTrieSet Branch Leaf)
        (only-in ../object-contract-flow checked-action)
        (prefix-in ../examples/service-collection service.))

;; A public persistent alist backend exercises arbitrary keys through methods.table,
;; using Gerbil's association operations, not a new collection implementation.
(def (alist-table key value)
  (.cc methods.table Key: key Value: value .empty: []
    .validate-shape: (lambda (source)
      (unless (alist? source) (raise-type-error 'alist-table source)) source)
    .ref: (lambda (source key (missing (lambda () (error "missing key"))))
            (cond ((assoc key source) => cdr) (else (missing))))
    .acons: (lambda (key value source) (aset source key value))
    .remove: (lambda (source key) (arem source key))
    .foldl: (lambda (f seed source)
              (foldl (lambda (entry acc) (f (car entry) (cdr entry) acc)) seed source))
    .foldr: (lambda (f seed source)
              (foldr (lambda (entry acc) (f (car entry) (cdr entry) acc)) seed source))))

;; Failure payload identity is observable even when a callback raises a non-error.
(def (cause-of thunk) (try (thunk) #f (catch (cause) cause)))

;; Cover default tables, ordered dictionaries, Patricia tries, derived sets and Map.
(def table-validation-test
  (test-suite "recursive persistent table binding protocol"
    (test-case "RationalDict and Trie preserve nested Function wrappers and source identity"
      ;; One nested descriptor checks containers below each table value.
      (def payload (List (Tuple (Fun Integer <- Integer) (Map (Fun Integer <- Integer) <- String))))
      ;; The same raw callbacks must remain untouched in the original collections.
      (def raw (lambda (_) "wrong result"))
      (for (table (list (RationalDict payload) (SimpleTrie UInt payload)))
        (def nested (make-hash-table))
        (hash-put! nested "run" raw)
        (def source (.call table .<-list (list (cons 1 (list (vector raw nested))))))
        (def checked (validate table source))
        (def row (car (.call table .ref checked 1)))
        (check-exception ((vector-ref row 0) 2) TypeError?)
        (check-exception ((hash-ref (vector-ref row 1) "run") 2) TypeError?)
        (check (eq? (vector-ref (car (.call table .ref source 1)) 0) raw) => #t)
        (check-equal? (raw 2) "wrong result")
        (check (eq? checked source) => #f))
      ;; Unchanged ordinary entries preserve the backend's original identity.
      (for (table (list (RationalDict Integer) (SimpleTrie UInt Integer)))
        (def source (.call table .<-list '((1 . 7) (3 . 9))))
        (check (eq? source (validate table source)) => #t)))
    (test-case "Function keys and values both retain wrappers through the generic backend"
      (def table (alist-table (Fun Integer <- Integer) (Fun Integer <- Integer)))
      (def raw (lambda (_) "wrong result"))
      (def source (list (cons raw raw)))
      (def checked (validate-table table source))
      (def entry (car checked))
      (check-exception ((car entry) 1) TypeError?)
      (check-exception ((cdr entry) 1) TypeError?)
      (check (eq? (caar source) raw) => #t)
      (check (eq? (cdar source) raw) => #t))
    (test-case "nested recognition does not rewrap or execute normalization callbacks"
      (def calls 0)
      (def watched (.cc Integer .validate: (lambda (value)
        (set! calls (+ calls 1)) (validate Integer value))))
      (def table (RationalDict watched))
      (def source (.call table .<-list '((1 . 7) (2 . 8))))
      (check (element? table source) => #t)
      (check-equal? calls 0)
      (validate (List table) (list source))
      (check-equal? calls 2)
      ;; Post-recognition must reject a broken custom normalizer's result.
      (def broken (.cc Integer .validate: (lambda (_) "not integer")))
      (check-exception (validate (RationalDict broken) source) TypeError?)
      (check (element? table 'not-a-table) => #f))
    (test-case "key normalization may reorder trees without losing associated values"
      (def negative (.cc Rational .validate: (lambda (key) (- (validate Rational key)))))
      (def reversed-uint (.cc UInt .validate: (lambda (key) (- 100 (validate UInt key)))))
      (for (table (list (.cc (RationalDict Integer) Key: negative)
                       (SimpleTrie reversed-uint Integer)))
        (def source (.call table .<-list '((1 . 10) (3 . 30))))
        (def checked (validate table source))
        (check-equal? (.call table .list<- source) '((1 . 10) (3 . 30)))
        (check-equal? (.call table .list<- checked)
          (if (eq? (.@ table Key) negative) '((-3 . 30) (-1 . 10)) '((97 . 30) (99 . 10))))))
    (test-case "key checks still run when values are Any and normalized collisions refuse"
      ;; Normalize two distinct numeric source keys to the same backend key.
      (def absolute (.cc Integer .validate: (lambda (value) (abs (validate Integer value)))))
      (def table (.cc (RationalDict Any) Key: absolute))
      (def source (.call table .<-list '((-1 . old) (1 . other))))
      (check-exception (validate table source) TypeError?)
      (check-equal? (.call table .count source) 2)
      (check-equal? (.call table .ref source -1) 'old)
      ;; Shape admission must still run even with completely unrestricted values.
      (check-exception (validate (RationalDict Any) 'not-a-dictionary) TypeError?)
      (def rejects (.cc (RationalDict Any) Key: String))
      (check-exception (validate rejects source) TypeError?))
    (test-case "sets retain normalized elements and reject collapsed keys"
      (def absolute (.cc Integer .validate: (lambda (value) (abs (validate Integer value)))))
      (def table (alist-table absolute Unit))
      (def set (.cc Set<-Table. Table: table sexp: 'absolute-set))
      (def source (.call set .<-list '(-3 5)))
      (def checked (validate set source))
      (check (.call set .elt? checked 3) => #t)
      (check (.call set .elt? source -3) => #t)
      (check-exception (validate set (.call set .<-list '(-3 3))) TypeError?)
      ;; Trie-backed sets must also validate reconstructed keys, including Any values.
      (def trie-set (SimpleTrieSet UInt))
      (def invalid-key-set (.cc trie-set Table: (.cc (.@ trie-set Table) Key: String)))
      (check-exception (validate invalid-key-set (.call trie-set .<-list '(1 2))) TypeError?))
    (test-case "ordered child failure stops construction and consumer then permits retry"
      (def events [])
      (def failure (list 'refused-key))
      ;; The shared protocol must check each key before its value, in fold order.
      (def key (.cc Integer .validate: (lambda (value)
        (set! events (cons (list 'key value) events))
        (when (= value 2) (raise failure)) value)))
      (def value (.cc Integer .validate: (lambda (value)
        (set! events (cons (list 'value value) events)) value)))
      (def table (alist-table key value))
      (def source '((1 . 10) (2 . 20) (3 . 30)))
      (def consumed #f)
      (def run (checked-action table (lambda (_) (set! consumed #t))))
      (check (eq? (cause-of (cut run source)) failure) => #t)
      (check-equal? (reverse events) '((key 1) (value 10) (key 2)))
      (check-equal? source '((1 . 10) (2 . 20) (3 . 30)))
      (check-equal? consumed #f)
      (set! events [])
      (run '((1 . 10)))
      (check-equal? consumed #t))
    (test-case "shared key/value refusal never exposes an intermediate rebuilt table"
      (def failure (list 'refused-value))
      (def value (.cc Integer .validate: (lambda (value)
        (if (= value 20) (raise failure) (+ value 1)))))
      (def constructed 0)
      (def table (.cc (alist-table Integer value)
        .acons: (lambda (key value target)
          (set! constructed (+ 1 constructed)) (aset target key value))))
      (def source '((1 . 10) (2 . 20)))
      (check (eq? (cause-of (cut validate-table table source)) failure) => #t)
      (check-equal? constructed 0)
      (check-equal? source '((1 . 10) (2 . 20))))
    (test-case "backend errors retain order ahead of a later normalized collision"
      (def cause (list (quote insertion-refused)))
      (def absolute (.cc Integer .validate: abs))
      (def table (.cc (alist-table absolute Integer)
        .acons: (lambda (_key _value _target) (raise cause))))
      (def source (quote ((-1 . 10) (1 . 20))))
      (check (eq? (cause-of (cut validate-table table source)) cause) => #t)
      (check-equal? source (quote ((-1 . 10) (1 . 20)))))
    (test-case "derived sets retain callable element wrappers"
      (def callback (lambda (_) "invalid result"))
      (def table (alist-table (Fun Integer <- Integer) Unit))
      (def set (.cc Set<-Table. Table: table sexp: 'callback-set))
      (def source (.call set .<-list (list callback)))
      (def checked (validate set source))
      (check-exception ((caar checked) 1) TypeError?)
      (check (eq? (caar source) callback) => #t))
    (test-case "schema refinement and IO consume the same normalized ledger without revalidation"
      (def table (RationalDict (List (Tuple (Fun Integer <- Integer)))))
      (def source (.call table .<-list (list (cons 1 (list (vector (lambda (n) (+ n 1))))))))
      (def events [])
      (def run (service.approved-ledger-action table 1 7
        (lambda (value) (set! events (cons value events)))))
      (check-exception (run (.o approved: #f ledger: source)) TypeError?)
      (check-equal? events [])
      (check-equal? (call/values (cut run (.o approved: #t ledger: source)) list) '(8 1))
      (check-equal? events '(8))
      (def failure (list 'io-refused))
      (def refused (service.approved-ledger-action table 1 7 (lambda (_) (raise failure))))
      (check (eq? (cause-of (cut refused (.o approved: #t ledger: source))) failure) => #t)
      (check-equal? (.call table .count source) 1))
    (test-case "malformed Trie metadata refuses before any child validator"
      (def calls 0)
      (def value (.cc Integer .validate: (lambda (value) (set! calls (+ 1 calls)) value)))
      (def table (SimpleTrie UInt value))
      (check-exception (validate table (Branch 3 (Leaf 1) (Leaf 2))) TypeError?)
      (check-equal? calls 0))
    (test-case "checked ledger FUN actions consume normalized callbacks once and preserve values"
      (def table (RationalDict (List (Tuple (Fun Integer <- Integer)))))
      (def source (.call table .<-list (list (cons 1 (list (vector (lambda (n) (+ n 1))))))))
      (def events [])
      (def run (service.ledger-action table 1 7
        (lambda (result) (set! events (cons result events)))))
      (check-equal? (call/values (cut run source) list) '(8 1))
      (check-equal? events '(8))
      (def bad (.call table .<-list (list (cons 1 (list (vector (lambda (_) #f)))))))
      (check-exception (run bad) TypeError?)
      (check-equal? events '(8))
      (check-equal? (call/values (cut run source) list) '(8 1)))))
