;;; Persistent collection admission shares recursive binding normalization.
(export table-validation-test)
(import :std/test :std/iter
        (only-in :gerbil/runtime/mop slot-ref slot-set!) (only-in :std/error Error? Error-message ContractViolation?)
        (only-in :std/list/alist aset arem alist?)
        (only-in ./table-testing alist-table)
        ../object ../mop ../number ../type ../table ../rationaldict ../support/option
        (only-in ../fun Wrapper.)
        (only-in ../trie SimpleTrie SimpleTrieSet Branch Leaf)
        (only-in ../object-contract-flow checked-action)
        (prefix-in ../examples/service-collection service.))

;; Failure payload identity is observable even when a callback raises a non-error.
(def (cause-of thunk) (try (thunk) #f (catch (cause) cause)))

;; Match the documented Gerbil protocol refusal, excluding unrelated exceptions.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))

;; Compare public alist bindings independently of insertion order and delta code.
(def (same-bindings? left right)
  (and (= (length left) (length right))
       (foldl (lambda (entry same) (and same (equal? entry (assoc (car entry) right)))) #t left)))

;; Cover default tables, ordered dictionaries, Patricia tries, derived sets and Map.
(def table-validation-test
  (test-suite "recursive persistent table binding protocol"
    (test-case "all translation constructors protect endpoint preflight and preserve getter failures"
      (for* ((kind '(transport fold representation)) (victim '(converter source target child)))
        (def key-type (.cc UInt))
        (def source (.cc (RationalDict Integer) Key: key-type)) (def target (.cc source))
        (def keys (.cc Wrapper. Domain: key-type Codomain: key-type .ap: identity .unap: identity))
        (def changed (case victim ((converter) keys) ((source) source) ((target) target) (else key-type)))
        (def interfere? #t) (def fail? #f) (def failure (list kind victim 'endpoint-refused))
        (def values (.o (:: @ Wrapper.) Codomain: Integer .ap: identity .unap: identity
          (Domain (begin
            (when fail? (raise failure))
            (when interfere?
              (case victim
                ((converter) (.set! keys Domain String))
                ((source) (.set! source Key String))
                ((target) (.set! target Key String))
                (else (.set! key-type sexp 'changed))))
            Integer))))
        (def carrier (.cc Wrapper. Domain: source Codomain: target .ap: identity .unap: identity))
        (def folding (table-fold source Integer (lambda (_ v) v)))
        ;; Use the public constructor for each independent protected preparation.
        (def (prepare (converter values))
          (case kind
            ((transport) (table-isomorphism source target keys converter))
            ((fold) (.call folding .isomorphism target keys converter))
            (else (table-wrapper source carrier keys converter))))
        (def version (object-revision changed))
        (check-exception (prepare) (message? "object mutation during computation"))
        (check-equal? (object-revision changed) version)
        (set! interfere? #f) (set! fail? #t)
        (check (eq? (cause-of prepare) failure) => #t)
        (set! fail? #f)
        (prepare)
        ;; The incompatible endpoint refuses before a later callback getter.
        (def incompatible (.o (:: @ Wrapper.) Domain: String Codomain: Integer
          .unap: identity (.ap (raise failure))))
        (check-exception (prepare incompatible) (message? "incompatible table isomorphism types"))))
    (test-case "fresh FUN transport closes refused construction, conflict retry and callback-preserving undo"
      (def payload (Tuple (Fun Integer <- Integer) UInt))
      (def source (.cc (RationalDict payload) Key: UInt)) (def target (.cc source))
      (def keys (.cc Wrapper. Domain: UInt Codomain: UInt .ap: identity .unap: identity))
      (def interfere? #t)
      (def values (.o (:: @ Wrapper.) Codomain: payload .ap: identity .unap: identity
        (Domain (begin (when interfere? (.set! keys Domain String)) payload))))
      (def callback (validate (Fun Integer <- Integer) (lambda (n) (+ n 1))))
      (def base (.call source .<-list (list (cons 1 (vector callback 10)) (cons 9 (vector callback 90)))))
      (def next (.call source .acons 1 (vector callback 20) base))
      (def delta (.call source .diff base next)) (def consumed 0)
      (def publish (service.prepare-ledger-transport source target keys values
        (lambda (root) (set! consumed (+ consumed 1)) root)))
      (check-exception (publish (cons base delta)) (message? "object mutation during computation"))
      (check-equal? consumed 0)
      (set! interfere? #f)
      (def accepted (publish (cons base delta)))
      (check-equal? consumed 1)
      (check (eq? (vector-ref (.call target .ref accepted 1) 0) callback) => #t)
      (check-exception (callback "bad") TypeError?)
      (check-exception (publish (cons accepted delta)) table-conflict?)
      (check-equal? consumed 1)
      (def fresh (.call source .diff accepted (.call source .acons 1 (vector callback 30) accepted)))
      (def retried (publish (cons accepted fresh)))
      (check-equal? consumed 2)
      (check-equal? (vector-ref (.call target .ref retried 1) 1) 30)
      (def restored (publish (cons retried (invert-table-delta fresh))))
      (check-equal? consumed 3)
      (check (eq? (vector-ref (.call target .ref restored 9) 0) callback) => #t)
      (check-equal? (vector-ref (.call target .ref restored 1) 1) 20))
    (test-case "fold guards refuse truncated extended and malformed captured revisions"
      (def source (RationalDict Integer))
      (def folding (table-fold source Integer (lambda (_ value) value)))
      (def state (.call folding .ap (.call source .<-list '((1 . 7)))))
      (def versions (slot-ref state 'versions))
      ;; Exercise hostile representation edits through the actual public reader;
      ;; no private guard helper or constructor is exported for this control.
      (try
        (for (bad (list (cdr versions) (append versions '(0))
                       (cons 'malformed (cdr versions)) #f (cons 7 'malformed)))
          (slot-set! state 'versions bad)
          (check-exception (.call folding .get state) (message? "stale table fold state")))
        (finally (slot-set! state 'versions versions)))
      (check-equal? (.call folding .get state) 7))
    (test-case "RationalDict and Trie preserve nested Function wrappers and source identity"
      ;; One nested descriptor checks containers below each table value.
      (def payload (List (Tuple (Fun Integer <- Integer) (Map (Fun Integer <- Integer) <- String))))
      ;; The same raw callbacks must remain untouched in the original collections.
      (def raw (lambda (_) "wrong result"))
      (for (table (list (RationalDict payload) (SimpleTrie UInt payload)))
        (def nested (make-hash-table))
        (hash-put! nested "run" raw)
        (def source (.call table .<-list (list (cons 1 (list (vector raw nested))))))
        (def checked (validate table source))
        (def row (car (.call table .ref checked 1)))
        (check-exception ((vector-ref row 0) 2) TypeError?)
        (check-exception ((hash-ref (vector-ref row 1) "run") 2) TypeError?)
        (check (eq? (vector-ref (car (.call table .ref source 1)) 0) raw) => #t)
        (check-equal? (raw 2) "wrong result")
        (check (eq? checked source) => #f))
      ;; Unchanged ordinary entries preserve the backend's original identity.
      (for (table (list (RationalDict Integer) (SimpleTrie UInt Integer)))
        (def source (.call table .<-list '((1 . 7) (3 . 9))))
        (check (eq? source (validate table source)) => #t)))
    (test-case "Function keys and values both retain wrappers through the generic backend"
      (def table (alist-table (Fun Integer <- Integer) (Fun Integer <- Integer)))
      (def raw (lambda (_) "wrong result"))
      (def source (list (cons raw raw)))
      (def checked (validate-table table source))
      (def entry (car checked))
      (check-exception ((car entry) 1) TypeError?)
      (check-exception ((cdr entry) 1) TypeError?)
      (check (eq? (caar source) raw) => #t)
      (check (eq? (cdar source) raw) => #t))
    (test-case "nested recognition does not rewrap or execute normalization callbacks"
      (def calls 0)
      (def watched (.cc Integer .validate: (lambda (value)
        (set! calls (+ calls 1)) (validate Integer value))))
      (def table (RationalDict watched))
      (def source (.call table .<-list '((1 . 7) (2 . 8))))
      (check (element? table source) => #t)
      (check-equal? calls 0)
      (validate (List table) (list source))
      (check-equal? calls 2)
      ;; Post-recognition must reject a broken custom normalizer's result.
      (def broken (.cc Integer .validate: (lambda (_) "not integer")))
      (check-exception (validate (RationalDict broken) source) TypeError?)
      (check (element? table 'not-a-table) => #f))
    (test-case "key normalization may reorder trees without losing associated values"
      (def negative (.cc Rational .validate: (lambda (key) (- (validate Rational key)))))
      (def reversed-uint (.cc UInt .validate: (lambda (key) (- 100 (validate UInt key)))))
      (for (table (list (.cc (RationalDict Integer) Key: negative)
                       (SimpleTrie reversed-uint Integer)))
        (def source (.call table .<-list '((1 . 10) (3 . 30))))
        (def checked (validate table source))
        (check-equal? (.call table .list<- source) '((1 . 10) (3 . 30)))
        (check-equal? (.call table .list<- checked)
          (if (eq? (.@ table Key) negative) '((-3 . 30) (-1 . 10)) '((97 . 30) (99 . 10))))))
    (test-case "key checks still run when values are Any and normalized collisions refuse"
      ;; Normalize two distinct numeric source keys to the same backend key.
      (def absolute (.cc Integer .validate: (lambda (value) (abs (validate Integer value)))))
      (def table (.cc (RationalDict Any) Key: absolute))
      (def source (.call table .<-list '((-1 . old) (1 . other))))
      (check-exception (validate table source) TypeError?)
      (check-equal? (.call table .count source) 2)
      (check-equal? (.call table .ref source -1) 'old)
      ;; Shape admission must still run even with completely unrestricted values.
      (check-exception (validate (RationalDict Any) 'not-a-dictionary) TypeError?)
      (def rejects (.cc (RationalDict Any) Key: String))
      (check-exception (validate rejects source) TypeError?))
    (test-case "sets retain normalized elements and reject collapsed keys"
      (def absolute (.cc Integer .validate: (lambda (value) (abs (validate Integer value)))))
      (def table (alist-table absolute Unit))
      (def set (.cc Set<-Table. Table: table sexp: 'absolute-set))
      (def source (.call set .<-list '(-3 5)))
      (def checked (validate set source))
      (check (.call set .elt? checked 3) => #t)
      (check (.call set .elt? source -3) => #t)
      (check-exception (validate set (.call set .<-list '(-3 3))) TypeError?)
      ;; Trie-backed sets must also validate reconstructed keys, including Any values.
      (def trie-set (SimpleTrieSet UInt))
      (def invalid-key-set (.cc trie-set Table: (.cc (.@ trie-set Table) Key: String)))
      (check-exception (validate invalid-key-set (.call trie-set .<-list '(1 2))) TypeError?))
    (test-case "ordered child failure stops construction and consumer then permits retry"
      (def events [])
      (def failure (list 'refused-key))
      ;; The shared protocol must check each key before its value, in fold order.
      (def key (.cc Integer .validate: (lambda (value)
        (set! events (cons (list 'key value) events))
        (when (= value 2) (raise failure)) value)))
      (def value (.cc Integer .validate: (lambda (value)
        (set! events (cons (list 'value value) events)) value)))
      (def table (alist-table key value))
      (def source '((1 . 10) (2 . 20) (3 . 30)))
      (def consumed #f)
      (def run (checked-action table (lambda (_) (set! consumed #t))))
      (check (eq? (cause-of (cut run source)) failure) => #t)
      (check-equal? (reverse events) '((key 1) (value 10) (key 2)))
      (check-equal? source '((1 . 10) (2 . 20) (3 . 30)))
      (check-equal? consumed #f)
      (set! events [])
      (run '((1 . 10)))
      (check-equal? consumed #t))
    (test-case "shared key/value refusal never exposes an intermediate rebuilt table"
      (def failure (list 'refused-value))
      (def value (.cc Integer .validate: (lambda (value)
        (if (= value 20) (raise failure) (+ value 1)))))
      (def constructed 0)
      (def table (.cc (alist-table Integer value)
        .acons: (lambda (key value target)
          (set! constructed (+ 1 constructed)) (aset target key value))))
      (def source '((1 . 10) (2 . 20)))
      (check (eq? (cause-of (cut validate-table table source)) failure) => #t)
      (check-equal? constructed 0)
      (check-equal? source '((1 . 10) (2 . 20))))
    (test-case "backend errors retain order ahead of a later normalized collision"
      (def cause (list (quote insertion-refused)))
      (def absolute (.cc Integer .validate: abs))
      (def table (.cc (alist-table absolute Integer)
        .acons: (lambda (_key _value _target) (raise cause))))
      (def source (quote ((-1 . 10) (1 . 20))))
      (check (eq? (cause-of (cut validate-table table source)) cause) => #t)
      (check-equal? source (quote ((-1 . 10) (1 . 20)))))
    (test-case "derived sets retain callable element wrappers"
      (def callback (lambda (_) "invalid result"))
      (def table (alist-table (Fun Integer <- Integer) Unit))
      (def set (.cc Set<-Table. Table: table sexp: 'callback-set))
      (def source (.call set .<-list (list callback)))
      (def checked (validate set source))
      (check-exception ((caar checked) 1) TypeError?)
      (check (eq? (caar source) callback) => #t))
    (test-case "schema refinement and IO consume the same normalized ledger without revalidation"
      (def table (RationalDict (List (Tuple (Fun Integer <- Integer)))))
      (def source (.call table .<-list (list (cons 1 (list (vector (lambda (n) (+ n 1))))))))
      (def events [])
      (def run (service.approved-ledger-action table 1 7
        (lambda (value) (set! events (cons value events)))))
      (check-exception (run (.o approved: #f ledger: source)) TypeError?)
      (check-equal? events [])
      (check-equal? (call/values (cut run (.o approved: #t ledger: source)) list) '(8 1))
      (check-equal? events '(8))
      (def failure (list 'io-refused))
      (def refused (service.approved-ledger-action table 1 7 (lambda (_) (raise failure))))
      (check (eq? (cause-of (cut refused (.o approved: #t ledger: source))) failure) => #t)
      (check-equal? (.call table .count source) 1))
    (test-case "malformed Trie metadata refuses before any child validator"
      (def calls 0)
      (def value (.cc Integer .validate: (lambda (value) (set! calls (+ 1 calls)) value)))
      (def table (SimpleTrie UInt value))
      (check-exception (validate table (Branch 3 (Leaf 1) (Leaf 2))) TypeError?)
      (check-equal? calls 0))
    (test-case "checked ledger FUN actions consume normalized callbacks once and preserve values"
      (def table (RationalDict (List (Tuple (Fun Integer <- Integer)))))
      (def source (.call table .<-list (list (cons 1 (list (vector (lambda (n) (+ n 1))))))))
      (def events [])
      (def run (service.ledger-action table 1 7
        (lambda (result) (set! events (cons result events)))))
      (check-equal? (call/values (cut run source) list) '(8 1))
      (check-equal? events '(8))
      (def bad (.call table .<-list (list (cons 1 (list (vector (lambda (_) #f)))))))
      (check-exception (run bad) TypeError?)
      (check-equal? events '(8))
      (check-equal? (call/values (cut run source) list) '(8 1)))
    (test-case "portable deltas preserve false, deletion, insertion and the original snapshots"
      (def ordered (.cc (RationalDict Bool) Key: UInt))
      (def trie (SimpleTrie UInt Bool))
      (def before (.call ordered .<-list '((1 . #f) (2 . #t) (9 . #t))))
      (def after (.call ordered .<-list '((1 . #t) (3 . #f) (9 . #t))))
      (def delta (.call ordered .diff before after))
      (check-equal? (table-delta-count delta) 3)
      (for (table (list ordered trie))
        (def source (.call table .<-list (.call ordered .list<- before)))
        (def result (.call table .apply-delta source delta))
        (check-equal? (.call table .list<- result) (.call ordered .list<- after))
        (check-equal? (.call table .list<- (.call table .apply-delta result (invert-table-delta delta)))
                      (.call ordered .list<- before))
        (check-equal? (.call table .list<- source) '((1 . #f) (2 . #t) (9 . #t)))
        (check (eq? source (.call table .apply-delta source (.call table .diff source source))) => #t)))
    (test-case "conflicts preserve unrelated edits, refuse privately and allow fresh discovery"
      (def table (RationalDict Integer))
      (def base (.call table .<-list '((1 . 10) (2 . 20))))
      (def wanted (.call table .<-list '((1 . 11) (2 . 21))))
      (def delta (.call table .diff base wanted))
      ;; First edit would succeed; the second fails. No staged first edit escapes.
      (def winner (.call table .acons 2 99 (.call table .acons 7 70 base)))
      (def cause (cause-of (cut .call table .apply-delta winner delta)))
      (check (table-conflict? cause) => #t)
      (check-equal? (table-conflict-key cause) 2)
      (check-equal? (.call table .list<- winner) '((1 . 10) (2 . 99) (7 . 70)))
      (def retry (.call table .diff winner wanted))
      (check-equal? (.call table .list<- (.call table .apply-delta winner retry))
                    '((1 . 11) (2 . 21)))
      (def disjoint (.call table .acons 7 70 base))
      (check-equal? (.call table .list<- (.call table .apply-delta disjoint delta))
                    '((1 . 11) (2 . 21) (7 . 70))))
    (test-case "optional table focus composes through the existing service lens"
      (def table (RationalDict Bool))
      (def base (.call table .<-list '((1 . #f))))
      (def state (.o ledger: base sibling: 42))
      (def focus (.call Lens .compose (.lens ledger) (.call table .lens/opt 2)))
      (check (.call focus .get state) => #f)
      (def next (.call focus .set (some #f) state))
      (check (some? (.call focus .get next)) => #t)
      (check (some-value (.call focus .get next)) => #f)
      (check-equal? (.@ next sibling) 42)
      (check-equal? (.call table .list<- (.@ state ledger)) '((1 . #f)))
      (check-equal? (.call table .list<- (.@ (.call focus .set #f next) ledger)) '((1 . #f))))
    (test-case "nested callbacks retain wrappers across carriers, undo and FUN IO retry"
      (def payload (List (Tuple (Fun Integer <- Integer))))
      (def ordered (.cc (RationalDict payload) Key: UInt))
      (def trie (SimpleTrie UInt payload))
      (def before (validate ordered (.call ordered .<-list
        (list (cons 1 (list (vector (lambda (n) (+ n 1)))))))))
      ;; Admit only the new payload; existing admitted callbacks retain identity.
      (def added (validate payload (list (vector (lambda (_) "bad")))))
      (def delta (.call ordered .diff before (.call ordered .acons 2 added before)))
      (def migrated (.call trie .<-list (.call ordered .list<- before)))
      (def events [])
      (def install (service.apply-ledger-revision trie delta
        (lambda (result) (set! events (cons result events)) result)))
      (def installed (install migrated))
      (check (eq? (.call trie .ref installed 1) (.call ordered .ref before 1)) => #t)
      (check-exception ((vector-ref (car (.call trie .ref installed 2)) 0) 3) TypeError?)
      (check-equal? (length events) 1)
      (check-exception (install installed) table-conflict?)
      (check-equal? (length events) 1)
      (def undo (.call trie .apply-delta installed (invert-table-delta delta)))
      (check (eq? (.call trie .ref undo 1) (.call ordered .ref before 1)) => #t)
      (check-equal? ((vector-ref (car (.call trie .ref undo 1)) 0) 3) 4)
      (check-equal? (.call trie .count (install undo)) 2)
      (check-equal? (length events) 2))
    (test-case "FUN preparation admits proposed payloads before generating portable changes"
      (def payload (List (Tuple (Fun Integer <- Integer))))
      (def table (RationalDict payload))
      (def prepare (service.prepare-ledger-revision table (.@ table .empty)))
      (def delta (prepare (.call table .acons 1 (list (vector (lambda (_) "wrong"))) (.@ table .empty))))
      (def result (.call table .apply-delta (.@ table .empty) delta))
      (check-exception ((vector-ref (car (.call table .ref result 1)) 0) 1) TypeError?)
      (check-exception (prepare (.call table .acons 1 'bad (.@ table .empty))) TypeError?))
    (test-case "forty-eight mixed revisions agree with an independent finite alist oracle"
      (def ordered (.cc (RationalDict Bool) Key: UInt))
      (def trie (SimpleTrie UInt Bool))
      (def original (.@ ordered .empty))
      (def current original)
      (def remote (.@ trie .empty))
      (def expected [])
      (for (round (in-range 48))
        (def key (modulo round 11))
        (def next (if (= (modulo round 3) 0) (arem key expected)
                     (aset expected key (even? round))))
        (def desired (.call ordered .<-list next))
        (def delta (.call ordered .diff current desired))
        (def installed (.call ordered .apply-delta current delta))
        (def migrated (.call trie .apply-delta remote delta))
        (for (query (in-range 12))
          (def entry (assoc query next))
          (def answer (and entry (some (cdr entry))))
          (check-equal? (.call ordered .ref/opt installed query) answer)
          (check-equal? (.call trie .ref/opt migrated query) answer))
        (check-equal? (.call trie .list<- (.call trie .apply-delta migrated (invert-table-delta delta)))
                      (.call ordered .list<- current))
        (set! expected next) (set! current installed) (set! remote migrated))
      (check (.call ordered .empty? original) => #t))
    (test-case "stale descriptors, incompatible schemas and malformed carriers refuse"
      (def value (.cc Integer))
      (def table (.cc (RationalDict value) Key: UInt))
      (def base (.call table .<-list '((1 . 1))))
      (def delta (.call table .diff base (.call table .acons 1 2 base)))
      (check-exception (.call (SimpleTrie UInt String) .apply-delta #f delta) (message? "stale or incompatible table delta"))
      (check-exception (.call table .apply-delta 'bad delta) TypeError?)
      (check-exception (.call table .diff base 'bad) TypeError?)
      (.set! value sexp 'revised)
      (check-exception (.call table .apply-delta base delta) (message? "stale or incompatible table delta")))
    (test-case "late backend exceptions preserve identity, source and retry semantics"
      (def table (RationalDict Integer))
      (def base (.call table .<-list '((1 . 10) (2 . 20))))
      (def delta (.call table .diff base (.call table .<-list '((1 . 11) (2 . 21)))))
      (def failure (list 'backend-refused))
      (def trapped (.cc table .acons: (lambda (key value source)
        (if (= key 2) (raise failure) (.call table .acons key value source)))))
      (check (eq? (cause-of (cut .call trapped .apply-delta base delta)) failure) => #t)
      (check-equal? (.call table .list<- base) '((1 . 10) (2 . 20)))
      (check-equal? (.call table .list<- (.call table .apply-delta base delta)) '((1 . 11) (2 . 21))))
    (test-case "descriptor preparation precedes guards and recognizers cannot mutate active metadata"
      (def table #f)
      (def value (.cc Integer .element?: (lambda (n) (.set! table sexp 'changed) (integer? n))))
      (set! table (RationalDict value))
      (def source (.call table .acons 1 1 (.@ table .empty)))
      (def version (object-revision table))
      (check-exception (.call table .diff source source) (message? "object mutation during computation"))
      (check-equal? (object-revision table) version)
      (check-equal? (.call table .list<- source) '((1 . 1))))
    (test-case "nested table guards retain ownership and unwind after callback refusal"
      (def table #f) (def observe? #f) (def mutate? #f) (def samples [])
      (def value (.cc Integer .element?: (lambda (n)
        (when observe?
          (set! samples (cons (length (filter (cut eq? table <>) (active-object-constructions))) samples)))
        (when mutate? (.set! table sexp 'blocked))
        (integer? n))))
      (set! table (.cc (RationalDict value) Key: UInt))
      (def base (.call table .<-list '((1 . 10) (2 . 20))))
      (def folding (table-fold table Integer (lambda (_ v)
        ;; Discovery nests a complete guard inside initialization's guard.
        (.call table .diff base base) v)))
      (def outer (active-object-constructions))
      (set! observe? #t)
      (def state (.call folding .ap base))
      (check-equal? (.call folding .get state) 30)
      (check (pair? samples) => #t)
      (check (andmap positive? samples) => #t)
      (check (eq? outer (active-object-constructions)) => #t)
      (def revision (object-revision table))
      (set! mutate? #t)
      (check-exception (.call folding .ap base) (message? "object mutation during computation"))
      (check-equal? (object-revision table) revision)
      (check (eq? outer (active-object-constructions)) => #t)
      (set! mutate? #f)
      (check-equal? (.call folding .get (.call folding .ap base)) 30)
      ;; Active construction must still refuse; membership is never readiness.
      (def pending (.cc table))
      (parameterize ((active-object-constructions (cons pending outer)))
        (check-exception (instantiate-object! pending) (message? "recursive object construction")))
      (.set! table sexp 'after-guard)
      (check-equal? (object-revision table) (+ revision 1)))
    (test-case "optional focus laws hold for absence and stored false on both backends"
      (for (table (list (RationalDict Bool) (SimpleTrie UInt Bool)))
        (def source (.call table .<-list '((1 . #f) (3 . #t))))
        (for (key '(1 2 3))
          (def focus (.call table .lens/opt key))
          (check-equal? (.call table .list<- (.call focus .set (.call focus .get source) source))
                        (.call table .list<- source))
          (for (value (list #f (some #f) (some #t)))
            (check-equal? (.call focus .get (.call focus .set value source)) value)
            (for (next (list #f (some #f) (some #t)))
              (check-equal? (.call table .list<- (.call focus .set next (.call focus .set value source)))
                            (.call table .list<- (.call focus .set next source))))))))
    (test-case "explicit key/value conversion retains Function wrappers through revision and inverse"
      ;; Canonical numeric strings form precisely the UInt image.
      (def text-key (.cc String .element?: (lambda (s)
        (and (string? s) (let (n (string->number s))
          (and (element? UInt n) (equal? s (number->string n))))))))
      (def fn (Fun Integer <- Integer))
      (def tuple (Tuple fn Bool))
      (def pair (Pair Bool fn))
      (def left (.cc (RationalDict tuple) Key: UInt))
      (def right (alist-table text-key pair))
      (def keys (.cc Wrapper. Domain: UInt Codomain: text-key
        .ap: number->string .unap: string->number))
      (def values (.cc Wrapper. Domain: tuple Codomain: pair
        .ap: (lambda (v) (cons (vector-ref v 1) (vector-ref v 0)))
        .unap: (lambda (v) (vector (cdr v) (car v)))))
      (def mapping (table-isomorphism left right keys values))
      (def calls 0)
      (def raw (lambda (_) (set! calls (+ calls 1)) "invalid result"))
      (def base (validate left (.call left .<-list
        (list (cons 1 (vector raw #f)) (cons 9 (vector raw #t))))))
      (def callback (vector-ref (.call left .ref base 1) 0))
      (def next (.call left .acons 3 (validate tuple (vector raw #t)) (.call left .remove base 1)))
      (def delta (.call left .diff base next))
      (def mapped (.call mapping .ap base))
      (check (eq? (cdr (.call right .ref mapped "1")) callback) => #t)
      (check-equal? calls 0)
      (check-exception ((cdr (.call right .ref mapped "1")) 4) TypeError?)
      (check-equal? calls 1)
      (check-equal? (.call left .list<- (.call mapping .unap mapped)) (.call left .list<- base))
      (def transfer (.@ mapping Delta))
      (def staged (.call transfer .ap (cons base delta)))
      (def installed (.call right .apply-delta (car staged) (cdr staged)))
      (check-equal? (table-delta-count (cdr staged)) 2)
      (check (same-bindings? installed (.call mapping .ap next)) => #t)
      (check (eq? (cdr (.call right .ref installed "9"))
                  (vector-ref (.call left .ref base 9) 0)) => #t)
      (check (same-bindings? (.call right .apply-delta installed (invert-table-delta (cdr staged)))
                             (car staged)) => #t)
      (def recovered (.call transfer .unap staged))
      (check-equal? (.call left .list<- (.call left .apply-delta (car recovered) (cdr recovered)))
                    (.call left .list<- next))
      ;; Reader/FUN composes conversion and persistent installation before the consumer.
      (def consumed #f)
      (def action (service.transport-ledger-action mapping (lambda (v) (set! consumed v) v)))
      (check-equal? (action (cons base delta)) installed)
      (check-equal? consumed installed)
      (set! consumed #f)
      (def winner (.call left .remove base 1))
      (check-exception (action (cons winner delta)) table-conflict?)
      (check-equal? consumed #f)
      (check (same-bindings? (action (cons winner (.call left .diff winner next))) installed) => #t)
      (def focus (.call right .lens/opt "3"))
      (check-equal? (.call focus .get (.call focus .set #f installed)) #f)
      (check-equal? (.call focus .get (.call focus .set (some (cons #f callback)) installed))
                    (some (cons #f callback)))
      ;; Origin and conversion revisions remain dependencies of transported deltas.
      (.set! keys sexp 'changed-key-conversion)
      (check-exception (.call right .apply-delta (car staged) (cdr staged))
                       (message? "stale or incompatible table delta"))
      (check-exception (.call mapping .ap base) (message? "stale table isomorphism")))
    (test-case "key collisions include unchanged keys and deleted/inserted aliases"
      (def left (.cc (RationalDict Integer) Key: UInt))
      (def right (alist-table UInt Integer))
      (def values (.cc Wrapper. Domain: Integer Codomain: Integer .ap: identity .unap: identity))
      (def keys (.cc Wrapper. Domain: UInt Codomain: UInt
        .ap: (lambda (k) (modulo k 2)) .unap: identity))
      (def mapping (table-isomorphism left right keys values))
      (def base (.call left .<-list '((0 . 10))))
      (def both (.call left .acons 2 20 base))
      (def replaced (.call left .<-list '((2 . 20))))
      (for (next (list both replaced))
        (def cause (cause-of (cut .call (.@ mapping Delta) .ap
          (cons base (.call left .diff base next)))))
        (check (table-isomorphism-failure? cause) => #t)
        (check-equal? (table-isomorphism-failure-kind cause) 'collision)
        (check-equal? (table-isomorphism-failure-value cause) 0))
      (check-equal? (.call left .list<- base) '((0 . 10)))
      (def cause (cause-of (cut .call mapping .ap replaced)))
      (check-equal? (table-isomorphism-failure-kind cause) 'left-inverse))
    (test-case "stale/conflicting origins refuse before conversion and exceptions retain identity"
      (def left (.cc (RationalDict Integer) Key: UInt))
      (def right (alist-table UInt Integer))
      (def calls 0)
      (def failure (list 'conversion-failed))
      (def keys (.cc Wrapper. Domain: UInt Codomain: UInt .ap: identity .unap: identity))
      (def values (.cc Wrapper. Domain: Integer Codomain: Integer
        .ap: (lambda (_) (set! calls (+ calls 1)) (raise failure)) .unap: identity))
      (def mapping (table-isomorphism left right keys values))
      (def base (.call left .<-list '((1 . 10))))
      (def delta (.call left .diff base (.call left .acons 1 11 base)))
      (check (eq? (cause-of (cut .call mapping .ap base)) failure) => #t)
      (check-equal? calls 1)
      (check-exception (.call (.@ mapping Delta) .ap
        (cons (.call left .acons 1 12 base) delta)) table-conflict?)
      (check-equal? calls 1)
      (.set! left sexp 'revision)
      (check-exception (.call (.@ mapping Delta) .ap (cons base delta))
                       (message? "stale table isomorphism"))
      (check-equal? calls 1))
    (test-case "typed conversion refuses domain mismatch, invalid results and lost Function wrappers"
      (def left (.cc (RationalDict Integer) Key: UInt))
      (def right (alist-table UInt Integer))
      (def keys (.cc Wrapper. Domain: UInt Codomain: UInt .ap: identity .unap: identity))
      (check-exception (table-isomorphism left right keys
        (.cc Wrapper. Domain: String Codomain: Integer .ap: identity .unap: identity))
        (message? "incompatible table isomorphism types"))
      (def bad (table-isomorphism left right keys
        (.cc Wrapper. Domain: Integer Codomain: Integer .ap: number->string .unap: string->number)))
      (check-exception (.call bad .ap (.call left .<-list '((1 . 10)))) TypeError?)
      (def fn (Fun Integer <- Integer))
      (def source (.cc (RationalDict fn) Key: UInt))
      (def target (alist-table UInt fn))
      (def raw (lambda (_) "bad"))
      (def base (validate source (.call source .acons 1 raw (.@ source .empty))))
      ;; A raw procedure satisfies recognition but loses the admitted wrapper identity.
      (def lossy (table-isomorphism source target keys
        (.cc Wrapper. Domain: fn Codomain: fn .ap: (lambda (_) raw) .unap: identity)))
      (def failure (cause-of (cut .call lossy .ap base)))
      (check-equal? (table-isomorphism-failure-kind failure) 'left-inverse))
    (test-case "set tables share explicit conversion, reversible deltas and repeated revision laws"
      (def source-table (.cc (RationalDict Unit) Key: UInt))
      (def target-table (SimpleTrie UInt Unit))
      (def keys (.cc Wrapper. Domain: UInt Codomain: UInt .ap: identity .unap: identity))
      (def values (.cc Wrapper. Domain: Unit Codomain: Unit .ap: identity .unap: identity))
      (def mapping (table-isomorphism source-table target-table keys values))
      (def source (.cc Set<-Table. Table: source-table sexp: 'source-set))
      (def target (.cc Set<-Table. Table: target-table sexp: 'target-set))
      (def current (.call source .<-list '(1 3 9)))
      (for (round (in-range 24))
        (def next (.call source .<-list (if (even? round) '(2 3 9) '(1 5 9))))
        (def delta (.call source-table .diff current next))
        (def staged (.call (.@ mapping Delta) .ap (cons current delta)))
        (def installed (.call target-table .apply-delta (car staged) (cdr staged)))
        (check-equal? (.call target .list<- installed) (.call source .list<- next))
        (check-equal? (.call source .list<- (.call mapping .unap installed)) (.call source .list<- next))
        (check-equal? (.call target .list<-
          (.call target-table .apply-delta installed (invert-table-delta (cdr staged))))
          (.call source .list<- current))
        (set! current next)))
    (test-case "converter metadata mutation is guarded and failed conversion can be retried"
      (def source (.cc (RationalDict Integer) Key: UInt))
      (def target (alist-table UInt Integer))
      (def keys (.cc Wrapper. Domain: UInt Codomain: UInt .ap: identity .unap: identity))
      (def mutate? #t)
      (def values (.cc Wrapper. Domain: Integer Codomain: Integer
        .ap: (lambda (v) (when mutate? (.set! keys sexp 'mutation)) v) .unap: identity))
      (def mapping (table-isomorphism source target keys values))
      (def base (.call source .<-list '((1 . 10))))
      (def revision (object-revision keys))
      (check-exception (.call mapping .ap base) (message? "object mutation during computation"))
      (check-equal? (object-revision keys) revision)
      (set! mutate? #f)
      (check-equal? (.call mapping .ap base) '((1 . 10))))
    (test-case "incremental folds visit only edits and match an independent sum after every round"
      (for (backend (list (.cc (RationalDict Integer) Key: UInt) (SimpleTrie UInt Integer)))
        (def sealed? #f) (def admissions 0)
        ;; Complete backend recognition remains distinct from aggregate folding.
        (def table (.cc backend .element?: (lambda (root)
          (set! admissions (+ admissions 1)) (element? backend root))
          .foldl: (lambda (f seed source)
          (when sealed? (error "unexpected fold scan")) (.call backend .foldl f seed source))))
        (def calls 0)
        (def folding (table-fold table Integer (lambda (k v) (set! calls (+ calls 1)) (* k v))))
        (def current (.call table .<-list '((1 . 10) (2 . 20) (9 . 90))))
        (def state (.call folding .ap current))
        (check-equal? calls 3)
        (check-equal? (.call folding .get state) 860)
        (check (eq? (.call folding .unap state) current) => #t)
        (for (round (in-range 24))
          (def next (.call table .<-list (if (even? round) '((1 . 11) (3 . 30) (9 . 90))
                                                               '((1 . 10) (2 . 20) (9 . 90)))))
          (def delta (.call table .diff current next))
          (def before calls)
          (set! admissions 0)
          (set! sealed? #t)
          (def next-state (.call folding .apply-delta state delta))
          (check (> admissions 0) => #t)
          (check (<= (- calls before) (* 2 (table-delta-count delta))) => #t)
          (check-equal? (.call folding .get next-state)
            (.call backend .foldl (lambda (k v acc) (+ (* k v) acc)) 0 next))
          (def restored (.call folding .apply-delta next-state (invert-table-delta delta)))
          (check-equal? (.call folding .get restored) (.call folding .get state))
          (check-equal? (.call backend .list<- (.call folding .unap restored))
                        (.call backend .list<- current))
          (set! state next-state) (set! current next)
          (set! sealed? #f))))
    (test-case "shared checked Function ledgers transport count and weighted sum with inverse recovery"
      ;; The accumulator reuses the Tuple carrier and the existing arithmetic names.
      (def totals (.cc (Tuple Integer Integer) .zero: '#(0 0)
        .add: (lambda (a b) (vector (+ (vector-ref a 0) (vector-ref b 0))
                                    (+ (vector-ref a 1) (vector-ref b 1))))
        .sub: (lambda (a b) (vector (- (vector-ref a 0) (vector-ref b 0))
                                    (- (vector-ref a 1) (vector-ref b 1))))))
      (def text-key (.cc String .element?: (lambda (s)
        (and (string? s) (let (n (string->number s))
          (and (element? UInt n) (equal? s (number->string n))))))))
      (def fn (Fun Integer <- Integer))
      (def tuple (Tuple fn Integer))
      (def pair (Pair Integer fn))
      (def left (.cc (RationalDict tuple) Key: UInt))
      (def right (alist-table text-key pair))
      (def keys (.cc Wrapper. Domain: UInt Codomain: text-key .ap: number->string .unap: string->number))
      (def payloads (.cc Wrapper. Domain: tuple Codomain: pair
        .ap: (lambda (v) (cons (vector-ref v 1) (vector-ref v 0)))
        .unap: (lambda (v) (vector (cdr v) (car v)))))
      (def mapping (table-isomorphism left right keys payloads))
      (def source-fold (table-fold left totals (lambda (k v) (vector 1 (* k (vector-ref v 1))))))
      (def target-fold (table-fold right totals (lambda (k v) (vector 1 (* (string->number k) (car v))))))
      (def calls 0)
      (def raw (lambda (_) (set! calls (+ calls 1)) "bad result"))
      (def base (validate left (.call left .<-list
        (list (cons 1 (vector raw 10)) (cons 9 (vector raw 90))))))
      (def callback (vector-ref (.call left .ref base 9) 0))
      (def next (.call left .acons 3 (validate tuple (vector raw 30)) (.call left .remove base 1)))
      (def delta (.call left .diff base next))
      (def source-state (.call source-fold .ap base))
      (def target-state (.call target-fold .ap (.call mapping .ap base)))
      (def staged (.call (.@ mapping Delta) .ap (cons base delta)))
      (def changed (.call target-fold .apply-delta target-state (cdr staged)))
      (def source-changed (.call source-fold .apply-delta source-state delta))
      (check-equal? (.call source-fold .get source-changed) '#(2 900))
      (check-equal? (.call target-fold .get changed) (.call source-fold .get source-changed))
      (check-equal? calls 0)
      (check (eq? (cdr (.call right .ref (.call target-fold .unap changed) "9")) callback) => #t)
      (check-exception (callback 0) TypeError?)
      (def recovered (.call target-fold .apply-delta changed (invert-table-delta (cdr staged))))
      (check-equal? (.call target-fold .get recovered) (.call target-fold .get target-state))
      (check (same-bindings? (.call target-fold .unap recovered) (.call target-fold .unap target-state)) => #t)
      ;; Converter lineage survives even an empty update to a transported state.
      (def empty (.call right .diff (.call target-fold .unap changed) (.call target-fold .unap changed)))
      (def unchanged (.call target-fold .apply-delta changed empty))
      (.set! keys sexp 'revised-conversion)
      (check-exception (.call target-fold .get unchanged) (message? "stale table fold state")))
    (test-case "conflicts precede projection, late failures suppress IO and original states permit retry"
      (def table (.cc (RationalDict Integer) Key: UInt))
      (def calls 0)
      (def refuse? #f)
      (def failure (list 'projection-refused))
      (def folding (table-fold table Integer (lambda (k v)
        (set! calls (+ calls 1)) (when (and refuse? (= k 2)) (raise failure)) v)))
      (def base (.call table .<-list '((1 . 10) (2 . 20))))
      (def next (.call table .<-list '((1 . 11) (2 . 21))))
      (def delta (.call table .diff base next))
      (def state (.call folding .ap base))
      (def winner (.call folding .ap (.call table .acons 2 99 base)))
      ;; Force both retained states before taking the observation snapshot.
      (check-equal? (.call folding .get state) 30)
      (check-equal? (.call folding .get winner) 109)
      (let (before calls)
        (check-exception (.call folding .apply-delta winner delta) table-conflict?)
        (check-equal? calls before))
      (def consumed #f)
      (def action (service.fold-ledger-action folding state (lambda (v) (set! consumed v) v)))
      (set! refuse? #t)
      (check (eq? (cause-of (cut action delta)) failure) => #t)
      (check-equal? consumed #f)
      (check-equal? (.call folding .get state) 30)
      (check (eq? (.call folding .unap state) base) => #t)
      (set! refuse? #f)
      (def accepted (action delta))
      (check (eq? consumed accepted) => #t)
      (check-equal? (.call folding .get accepted) 32)
      (check-equal? (.call folding .get (.call folding .apply-delta accepted (invert-table-delta delta))) 30)
      (def foreign (table-fold table Integer (lambda (_ v) v)))
      (check-exception (.call foreign .get state) (message? "incompatible table fold state")))
    (test-case "aggregate result membership and metadata guards refuse without corrupting retained states"
      (def table (.cc (RationalDict Integer) Key: UInt))
      (def bad? #f)
      (def mutate? #f)
      (def totals (.cc Integer .add: (lambda (a b) (if bad? "bad aggregate" (+ a b)))))
      (def folding (table-fold table totals (lambda (_ v)
        (when mutate? (.set! totals sexp 'mutation)) v)))
      (def base (.call table .<-list '((1 . 10))))
      (def state (.call folding .ap base))
      (def delta (.call table .diff base (.call table .acons 2 20 base)))
      (set! bad? #t)
      (check-exception (.call folding .apply-delta state delta) TypeError?)
      (check-equal? (.call folding .get state) 10)
      (set! bad? #f) (set! mutate? #t)
      (def revision (object-revision totals))
      (check-exception (.call folding .apply-delta state delta) (message? "object mutation during computation"))
      (check-equal? (object-revision totals) revision)
      (set! mutate? #f)
      (check-equal? (.call folding .get (.call folding .apply-delta state delta)) 30)
      (.set! totals sexp 'revised-aggregate)
      (check-exception (.call folding .get state) (message? "stale table fold"))
      (check-exception (.call folding .ap base) (message? "stale table fold")))
    (test-case "shared isomorphism preparation checks all callbacks without invoking them"
      (def source (.cc (RationalDict Integer) Key: UInt))
      (def target (alist-table UInt Integer))
      (def calls 0)
      (def keys (.cc Wrapper. Domain: UInt Codomain: UInt
        .ap: (lambda (v) (set! calls (+ calls 1)) v) .unap: identity))
      (def values (.cc Wrapper. Domain: Integer Codomain: Integer .ap: identity .unap: identity))
      (def folding (table-fold source Integer (lambda (_ v) v)))
      (for (construct (list (cut table-isomorphism source target <> <>)
                           (cut .call folding .isomorphism target <> <>)))
        (check-exception (construct keys (.cc values Domain: String))
          (message? "incompatible table isomorphism types"))
        (for (broken (list (.cc keys .ap: #f) (.cc keys .unap: #f)))
          (check-exception (construct broken values) ContractViolation?))
        (for (broken (list (.cc values .ap: #f) (.cc values .unap: #f)))
          (check-exception (construct keys broken) ContractViolation?))
        (construct keys values))
      (check-equal? calls 0)
      (def base (.call source .<-list '((1 . 10))))
      (def bridge (.call folding .isomorphism target keys values))
      (def state (.call folding .ap base))
      (def mapped (.call bridge .ap state))
      (check-equal? (.call (.@ bridge Codomain) .get mapped) 10)
      (check (eq? (.call bridge .unap mapped) state) => #t)
      (.set! keys sexp 'revised)
      (check-exception (.call bridge .ap state) (message? "stale table fold isomorphism"))
      (check-equal? (.call folding .get state) 10))
    (test-case "paired fold transport admits roots without target initialization or repeated conversion"
      (def callback (Fun Integer <- Integer))
      (def payload (Tuple callback Integer))
      (def cooked (Pair Integer callback))
      (def source-base (.cc (RationalDict payload) Key: UInt))
      (def target-base (SimpleTrie UInt cooked))
      (def blocked? #f)
      (def projects 0) (def conversions 0) (def source-admissions 0) (def target-admissions 0) (def shapes 0)
      ;; Retain complete recognition, while refusing accidental aggregate refolds.
      (def source (.cc source-base .element?: (lambda (root)
        (set! source-admissions (+ source-admissions 1)) (element? source-base root))
        .foldl: (lambda (f seed table)
        (when blocked? (error "source snapshot scan")) (.call source-base .foldl f seed table))))
      (def target (.cc target-base
        .element?: (lambda (root)
          (set! target-admissions (+ target-admissions 1)) (element? target-base root))
        .foldl: (lambda (f seed table)
          (when blocked? (error "target snapshot scan")) (.call target-base .foldl f seed table))
        .validate-shape: (lambda (table)
          (set! shapes (+ shapes 1)) (.call target-base .validate-shape table))))
      (def keys (.cc Wrapper. Domain: UInt Codomain: UInt
        .ap: (cut bitwise-xor <> 1) .unap: (cut bitwise-xor <> 1)))
      (def values (.cc Wrapper. Domain: payload Codomain: cooked
        .ap: (lambda (v) (set! conversions (+ conversions 1)) (cons (vector-ref v 1) (vector-ref v 0)))
        .unap: (lambda (v) (vector (cdr v) (car v)))))
      (def folding (table-fold source Integer (lambda (_ v) (set! projects (+ projects 1)) (vector-ref v 1))))
      (def raw (lambda (_) "bad result"))
      (def base (validate source (.call source .<-list
        (for/collect (k (in-range 64)) (cons k (vector raw k))))))
      (def state (.call folding .ap base))
      (def bridge (.call folding .isomorphism target keys values))
      (def derived (.@ bridge Codomain))
      (check-equal? (.call folding .get state) 2016)
      (def first (.call bridge .ap state))
      (check-equal? (.call derived .get first) 2016)
      (check-equal? projects 64)
      (def row (.call source .ref base 9))
      (def focus (.call source .lens/opt 9))
      (def next (.call source .acons 100 (vector (vector-ref row 0) 100)
        (.call source .remove (.call focus .set (some (vector (vector-ref row 0) 19)) base) 1)))
      (def delta (.call source .diff base next))
      (def empty (.call source .diff base base))
      (set! projects 0) (set! conversions 0) (set! blocked? #t)
      (check (eq? (.call bridge .ap state) first) => #t)
      (check (eq? (.call bridge .unap first) state) => #t)
      (check-equal? projects 0) (check-equal? conversions 0)
      (def equivalent (.call folding .apply-delta state empty))
      (def rebound (.call bridge .ap equivalent))
      (check (eq? (.call derived .unap rebound) (.call derived .unap first)) => #t)
      (check-equal? projects 0) (check-equal? conversions 0)
      (set! source-admissions 0) (set! target-admissions 0) (set! shapes 0)
      (def changed (.call bridge .apply-delta state delta))
      (check (> source-admissions 0) => #t) (check (> target-admissions 0) => #t)
      (check (> shapes 0) => #t)
      (check-equal? (.call derived .get changed) 2125)
      (check-equal? projects 4)
      ;; Two present replacements each run the same forward roundtrip twice.
      (check-equal? conversions 4)
      (check (eq? (cdr (.call target .ref (.call derived .unap changed) 8)) (vector-ref row 0)) => #t)
      (check-exception ((cdr (.call target .ref (.call derived .unap changed) 8)) 0) TypeError?)
      (def recovered (.call bridge .unap changed))
      (check-equal? (.call folding .get recovered) 2125)
      (def restored (.call bridge .apply-delta recovered (invert-table-delta delta)))
      (check-equal? (.call derived .get restored) 2016)
      (set! blocked? #f)
      ;; An evicted but valid target uses cold inverse conversion without refolding.
      (set! projects 0)
      (def old-source (.call bridge .unap first))
      (check-equal? (.call folding .get old-source) 2016)
      (check-equal? projects 0))
    (test-case "fold transport invalidates only the dependent direction and keeps independent source aggregates"
      (def source (.cc (RationalDict Integer) Key: UInt))
      (def target (alist-table UInt Integer))
      (def projects 0)
      (def folding (table-fold source Integer (lambda (_ v) (set! projects (+ projects 1)) v)))
      (def keys (.cc Wrapper. Domain: UInt Codomain: UInt .ap: identity .unap: identity))
      (def unrelated (.cc keys))
      (def maps 0)
      (def values (.cc Wrapper. Domain: Integer Codomain: Integer
        .ap: (lambda (v) (set! maps (+ maps 1)) (- v)) .unap: -))
      (def bridge (.call folding .isomorphism target keys values))
      (def other (.call folding .isomorphism target unrelated values))
      (def state (.call folding .ap (.call source .<-list '((1 . 10)))))
      (def paired (.call bridge .ap state))
      (.call other .ap state)
      (check-equal? (.call (.@ bridge Codomain) .get paired) 10)
      ;; A second representation inherits only the first state's actual lineage.
      (def next-keys (.cc Wrapper. Domain: UInt Codomain: UInt .ap: identity .unap: identity))
      (def chain (.call (.@ bridge Codomain) .isomorphism (SimpleTrie UInt Integer) next-keys values))
      (def chained (.call chain .ap paired))
      (check-equal? (.call (.@ chain Codomain) .get chained) 10)
      (check (eq? (.call bridge .unap (.call chain .unap chained)) state) => #t)
      (.set! unrelated sexp 'other-converter)
      (check (eq? (.call bridge .ap state) paired) => #t)
      (set! projects 0)
      (.set! keys sexp 'changed-converter)
      (check-exception (.call bridge .ap state) (message? "stale table fold isomorphism"))
      (check-exception (.call (.@ bridge Codomain) .get paired) (message? "stale table fold"))
      (check-exception (.call (.@ chain Codomain) .get chained) (message? "stale table fold state"))
      (check-equal? (.call folding .get state) 10)
      (def fresh (.call folding .isomorphism target keys values))
      (def fresh-target (.call fresh .ap state))
      (check-equal? (.call (.@ fresh Codomain) .get fresh-target) 10)
      (check-equal? projects 0)
      ;; New delta origins propagate to derived AND new source states, not old ones.
      (def origin (.cc source))
      (def base (.call folding .unap state))
      (def delta (.call origin .diff base (.call origin .acons 2 20 base)))
      (def changed (.call fresh .apply-delta state delta))
      (def recovered (.call fresh .unap changed))
      (check-equal? (.call folding .get recovered) 30)
      (.set! origin sexp 'changed-origin)
      (check-exception (.call folding .get recovered) (message? "stale table fold state"))
      (check-exception (.call (.@ fresh Codomain) .get changed) (message? "stale table fold state"))
      (check-equal? (.call folding .get state) 10)
      ;; A stale cached pairing does not poison a different independently fresh input.
      (check-equal? (.call (.@ fresh Codomain) .get (.call fresh .ap state)) 10)
      ;; Empty-origin expiry can rebind from a fresh input of the same root.
      (def empty (.call origin .diff base base))
      (def held (.call fresh .apply-delta state empty))
      (def held-source (.call fresh .unap held))
      (def table (.call (.@ fresh Codomain) .unap held))
      (.set! origin sexp 'expired-empty-origin)
      (check-exception (.call folding .get held-source) (message? "stale table fold state"))
      (set! maps 0)
      (def rebound (.call fresh .ap state))
      (check (eq? (.call (.@ fresh Codomain) .unap rebound) table) => #t)
      (check-equal? maps 0))
    (test-case "failed warm conversion preserves pairing identity, consumer suppression and retry"
      (def source (.cc (RationalDict Integer) Key: UInt))
      (def target (alist-table UInt Integer))
      (def failure (list 'conversion-refused))
      (def refuse? #f) (def mutate? #f)
      (def keys (.cc Wrapper. Domain: UInt Codomain: UInt .ap: identity .unap: identity))
      (def values (.cc Wrapper. Domain: Integer Codomain: Integer
        .ap: (lambda (v)
          (when mutate? (.set! keys sexp 'mutation))
          (when (and refuse? (= v 30)) (raise failure)) (- v)) .unap: -))
      (def folding (table-fold source Integer (lambda (_ v) v)))
      (def bridge (.call folding .isomorphism target keys values))
      (def base (.call source .<-list '((1 . 10) (2 . 20))))
      (def state (.call folding .ap base))
      (def paired (.call bridge .ap state))
      (def delta (.call source .diff base (.call source .acons 2 30 base)))
      (def consumed #f)
      (def action (service.fold-ledger-action bridge state (lambda (v) (set! consumed v) v)))
      (set! refuse? #t)
      (check (eq? (cause-of (cut action delta)) failure) => #t)
      (check-equal? consumed #f)
      (check (eq? (.call bridge .ap state) paired) => #t)
      (set! refuse? #f) (set! mutate? #t)
      (check-exception (action delta) (message? "object mutation during computation"))
      (check (eq? (.call bridge .ap state) paired) => #t)
      (set! mutate? #f)
      (def accepted (action delta))
      (check (eq? consumed accepted) => #t)
      (check-equal? (.call (.@ bridge Codomain) .get accepted) 40)
      (check-equal? (.call folding .get (.call bridge .unap accepted)) 40)
      (check-equal? (.call folding .get state) 30))
    (test-case "warm key ownership keeps deleted keys until all union-domain collision checks pass"
      (def source (.cc (RationalDict Integer) Key: UInt))
      (def target (alist-table UInt Integer))
      (def keys (.cc Wrapper. Domain: UInt Codomain: UInt .ap: (cut modulo <> 2) .unap: identity))
      (def values (.cc Wrapper. Domain: Integer Codomain: Integer .ap: identity .unap: identity))
      (def folding (table-fold source Integer (lambda (_ v) v)))
      (def bridge (.call folding .isomorphism target keys values))
      (def base (.call source .<-list '((0 . 10))))
      (def state (.call folding .ap base))
      (def paired (.call bridge .ap state))
      (for (next (list (.call source .<-list '((2 . 20))) (.call source .<-list '((0 . 10) (2 . 20)))))
        (def delta (.call source .diff base next))
        (def failed (cause-of (cut .call bridge .apply-delta state delta)))
        (check-equal? (table-isomorphism-failure-kind failed) 'collision)
        (check (eq? (.call bridge .ap state) paired) => #t))
      (def valid (.call source .diff base (.call source .acons 1 20 base)))
      (check-equal? (.call (.@ bridge Codomain) .get (.call bridge .apply-delta state valid)) 30))
    (test-case "capacity example composes checked shared callbacks, optional lens revisions and FUN consumption"
      (def raw (lambda (_) "bad result"))
      (def ledger (service.make-capacity-ledger (list (cons 1 (vector raw 10)) (cons 9 (vector raw 90)))))
      (def folding (.@ ledger folding))
      (def source (.@ ledger source))
      (def bridge (.@ ledger transport))
      (def state (.@ ledger state))
      (def base (.call folding .unap state))
      (def shared (vector-ref (.call source .ref base 9) 0))
      (def focus (.call source .lens/opt 1))
      (def next (.call focus .set (some (vector shared 20)) base))
      (.call bridge .ap state)
      (def action (service.fold-ledger-action bridge state (lambda (new) (.call (.@ bridge Codomain) .get new))))
      (check-equal? (action (.call source .diff base next)) 110))
    (test-case "applying a sparse delta does not enumerate or normalize the current table"
      (def calls 0)
      (def value (.cc Integer .validate: (lambda (n) (set! calls (+ calls 1)) (validate Integer n))))
      (def table (RationalDict value))
      (def base (.call table .<-list '((1 . 10) (2 . 20) (3 . 30))))
      (def delta (.call table .diff base (.call table .acons 2 21 base)))
      (def sparse (.cc table .for-each: (lambda _ (error "unexpected scan"))
                           .validate: (lambda _ (error "unexpected normalization"))))
      (check-equal? (.call sparse .ref (.call sparse .apply-delta base delta) 2) 21)
      (check-equal? calls 0))))
