(export declarative-metadata-test)
(import :std/test :std/iter (only-in :std/values first-value)
        ../object (only-in ../mop element? validate Type) (only-in ../number Integer)
        (prefix-in ../declarative-metadata metadata.)
        (prefix-in ../multimethod multimethod.)
        (prefix-in ../dispatch-extension dispatch-extension.))
(def (caught thunk) (try (thunk) #f (catch (cause) cause)))
(def declarative-metadata-test
  (test-suite "DeclarativeMetadata native POO protocols"
    (test-case "finite logic and short circuiting"
      (for* ((a '(#f #t)) (b '(#f #t)))
        (def (meaning key) (if (eq? key 'a) a b))
        (for ((formula (list metadata.truth (metadata.atom 'a) (metadata.deny (metadata.atom 'a))
                            (metadata.both (metadata.atom 'a) (metadata.atom 'b))
                            (metadata.either (metadata.atom 'a) (metadata.atom 'b))
                            (metadata.implies (metadata.atom 'a) (metadata.atom 'b))))
              (expected (list #t a (not a) (and a b) (or a b) (or (not a) b))))
          (check-equal? (metadata.holds formula meaning) expected)))
      (def trace [])
      (def (meaning key) (set! trace (cons key trace)) (if (eq? key 'a) #f (error "must skip")))
      (check-equal? (metadata.holds (metadata.both (metadata.atom 'a) (metadata.atom 'b)) meaning) #f)
      (check-equal? trace '(a))
      (check-exception (metadata.holds (metadata.atom 'a) (lambda (_) 'not-boolean)) true))
    (test-case "native type validation and inherited derived methods"
      (def positive (metadata.predicate "positive" (lambda (x) (and (integer? x) (> x 0)))))
      (check (eq? (validate Type positive) positive) => #t)
      (check-equal? (element? positive 3) #t)
      (check-equal? (element? positive 0) #f)
      (check-exception (validate positive 0) true)
      (check-equal? (element? (metadata.typed "integer" Integer) 3) #t)
      ;; A native extension inherits .check through methods.check<-holds.
      (def formula (.cc metadata.Formula. .holds: (lambda (meaning) (meaning 'extension))))
      (check-equal? (metadata.check formula (lambda (_) #t)) #t)
      (check-equal? (metadata.failure-phase (caught (cut metadata.check formula (lambda (_) #f)))) 'logic))
    (test-case "declarations compile to existing edits without another dispatch engine"
      (def edit (dispatch-extension.register [] (lambda () 7)))
      (def declaration (metadata.of-edit "answer" edit))
      (check (eq? (metadata.compile declaration) edit) => #t)
      (check-equal? (map metadata.declaration-name (metadata.named "answer" (list edit edit))) '("answer:0" "answer:1"))
      (def generic (metadata.install (multimethod.make [] Integer (lambda (_) [])) (list declaration)))
      (check-equal? (first-value (multimethod.call generic)) 7))
    (test-case "meaning specialization shares invariant checks and invalidates changed sources"
      (def compiled 0)
      (def rule (.cc metadata.Formula. .holds:
        (begin (set! compiled (+ compiled 1)) (lambda (meaning) (meaning 'limit)))))
      (def input (metadata.predicate "positive" (lambda (n) (> n 0))))
      (def output (metadata.typed "integer" Integer))
      (def template (metadata.contract input output (lambda (_ __ ___) #f) rule))
      (def first (metadata.with-meaning template (lambda (_ args result) (= result (+ args 10)))))
      (def second (metadata.with-meaning first (lambda (_ args result) (= result (+ args 20)))))
      (def old (.o (token 'old)))
      (def state (.o (token 'current)))
      (def checked (metadata.wrap second (lambda (n) (values (+ n 20) state))))
      (defvalues (answer current) (checked 2))
      (check-equal? answer 22)
      (check (eq? current state) => #t)
      (check-equal? compiled 1)
      (check-equal? (metadata.failure-phase (caught (cut metadata.invoke second (lambda (_) (values 12 state)) 2))) 'logic)
      (for ((descriptor (list (.cc second input: (metadata.predicate "never" (lambda (_) #f)))
                             (.cc second output: (metadata.predicate "never" (lambda (_) #f)))
                             (.cc second rule: (metadata.deny metadata.truth))))
            (phase '(input output logic)))
        (defvalues (result held issue) (metadata.publish descriptor old (lambda (n) (values (+ n 20) state)) 2))
        (check-equal? result #f)
        (check (eq? held old) => #t)
        (check-equal? (metadata.failure-phase issue) phase))
      (check-equal? (metadata.failure-phase (caught (cut checked 0))) 'input)
      (check-equal? (metadata.failure-phase (caught (cut metadata.invoke second (lambda (_) (error "source")) 2))) 'source)
      (check-exception (metadata.with-meaning second 'not-a-procedure) true)
      (def custom (.cc second .wrap: (lambda (_) (lambda (arg) (values arg 'custom)))))
      (check-equal? (first-value ((metadata.wrap custom #f) 9)) 9))
    (test-case "cold specialization does not force a shared record and clears inherited checks"
      (def input (metadata.predicate "positive" (lambda (n) (> n 0))))
      (def template (metadata.contract input input (lambda (_ args result) (= result args)) (metadata.atom 'identity)))
      (def fresh (metadata.with-meaning template (.@ template meaning) #f))
      (check (eq? (.@ fresh checks) #f) => #t)
      (check-equal? (first-value (metadata.invoke fresh (lambda (n) (values n 'current)) 2)) 2)
      (def shared (metadata.with-meaning template (.@ template meaning)))
      (check (eq? (.@ shared checks) #f) => #f)
      (def cleared (metadata.with-meaning shared (lambda (_ __ ___) #f) #f))
      (check (eq? (.@ cleared checks) #f) => #t)
      (check-equal? (metadata.failure-phase (caught (cut metadata.invoke cleared (lambda (n) (values n 'current)) 2))) 'logic)
      (check-exception (metadata.with-meaning shared (.@ template meaning) 'truthy) true))
    (test-case "wrapping preserves exact state and refusal order"
      (def input (metadata.predicate "positive" (lambda (x) (> x 0))))
      (def output (metadata.typed "integer" Integer))
      (def contract (metadata.contract input output (lambda (_ args result) (= result (+ args 1))) (metadata.atom 'increment)))
      (def state (.o (token 'tentative)))
      (def old (.o (token 'old)))
      (def calls 0)
      (def (source args) (set! calls (1+ calls)) (values (1+ args) state))
      (def checked (metadata.wrap contract source))
      (defvalues (result next) (checked 2))
      (check-equal? result 3)
      (check (eq? next state) => #t)
      (defvalues (value retained issue) (metadata.publish contract old source 0))
      (check (eq? retained old) => #t)
      (check-equal? (metadata.failure-phase issue) 'input)
      (check-equal? calls 1)
      (def source-error (.o (token 'source)))
      (def failure (caught (cut metadata.invoke contract (lambda (_) (raise source-error)) 2)))
      (check-equal? (metadata.failure-phase failure) 'source)
      (check (eq? (metadata.failure-cause failure) source-error) => #t)
      (for ((execute (list (lambda (_) (values '(error business) state)) (lambda (_) (values 99 state))))
            (phase '(output logic)))
        (defvalues (value retained issue) (metadata.publish contract old execute 2))
        (check-equal? value #f)
        (check (eq? retained old) => #t)
        (check-equal? (metadata.failure-phase issue) phase))
      ;; Wrapper composition is ordinary function composition, not a new effect API.
      (def twice-checked (metadata.wrap contract checked))
      (check-equal? (first-value (twice-checked 2)) 3)
      (def nested (metadata.wrap contract (metadata.wrap contract (lambda (_) (values 99 state)))))
      (def nested-failure (caught (cut nested 2)))
      (check-equal? (metadata.failure-phase nested-failure) 'source)
      (check-equal? (metadata.failure-phase (metadata.failure-cause nested-failure)) 'logic))))
