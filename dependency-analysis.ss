;;; Finite Computation expressions; transforms receive child values only.
(export Computation. pure need read inspect deny failure map both choose
        make-success success? success-value error? error-kind error-key error-cause)
(import ./object (only-in ./mop define-type) ./support/option)
(defstruct success (value) final: #t)
(defstruct error (kind key cause) final: #t)
(def (bind result next) (if (success? result) (next (success-value result)) result))
(def (source thunk) (try (make-success (thunk)) (catch (cause) (make-error 'source #f cause))))
(define-type (Computation. @ [] reads .evaluate))
(def (pure value) (.cc Computation. reads: [] .evaluate: (lambda (_) (make-success value))))
(def (failure message) (.cc Computation. reads: [] .evaluate: (lambda (_) (make-error 'source #f message))))
(def (need key transform)
  (.cc Computation. reads: (list key)
    .evaluate: (lambda (provider)
      (def found (provider key))
      (if (some? found) (bind (some-value found) (lambda (value) (source (cut transform value))))
        (make-error 'missing key #f)))))
(def (read key observe)
  (.cc Computation. reads: (list key) .evaluate: (lambda (provider) (source (cut observe (provider key))))))
(def (inspect key observe)
  (.cc Computation. reads: (list key) .evaluate: (lambda (provider) (source (cut observe (some? (provider key)))))))
(def (deny key value)
  (.cc Computation. reads: (list key)
    .evaluate: (lambda (provider) (if (some? (provider key)) (make-error 'introduced key #f) (make-success value)))))
(def (map child transform)
  (.cc Computation. reads: (.@ child reads)
    .evaluate: (lambda (provider)
      (bind (.call child .evaluate provider) (lambda (value) (source (cut transform value)))))))
(def (both left right combine)
  (.cc Computation. reads: (append (.@ left reads) (.@ right reads))
    .evaluate: (lambda (provider)
      (bind (.call left .evaluate provider)
        (lambda (l) (bind (.call right .evaluate provider) (lambda (r) (source (cut combine l r)))))))))
(def (choose guard condition yes no)
  (.cc Computation. reads: (append (.@ guard reads) (.@ yes reads) (.@ no reads))
    .evaluate: (lambda (provider)
      (bind (.call guard .evaluate provider)
        (lambda (value) (bind (source (cut condition value))
          (lambda (selected)
            (if (boolean? selected) (.call (if selected yes no) .evaluate provider)
              (make-error 'source #f "non-Boolean condition")))))))))
