;;; GeneralizedGraph.Declaration: immutable source and checked finite DAG schedule.
(export Declaration. declaration define remove set-base revise reconfigure support schedule reschedule
        schedule? schedule-source schedule-order schedule-reads schedule-work schedule-supports?
        schedule-owned schedule-owned? schedule-revision apply-schedule-revision
        %reschedule-owned-support %schedule-support-revision %schedule-revision-retirements %schedule-same-program?
        affected-owners schedule-invalidation schedule-invalidate! %apply-schedule-revision-with-invalidation
        %schedule-replacement-invalidate!
        %index %index-project %index-ref %index-fork %index-write!
        %reverse-bucket-remove %reverse-bucket-add %for-each-reverse-bucket
        %capture-component-source %component-source-view %edit-component-source
        %component-source-current! %with-component-source
        %splice-witness-tree %witness-tree-current? %witness-tree-stamp
        %witness-tree-left %witness-tree-right %witness-tree-evidence
        failure? failure-kind failure-key)
(import :std/iter (only-in :std/list/list delete-duplicates/hash)
        (only-in :std/list/list-builder with-list-builder)
        (only-in :gerbil/runtime/thread with-lock)
        (only-in :gerbil/runtime/interface interface-instance-object)
        (only-in :gerbil/runtime/hash symbol-hash-table?)
        (only-in :gerbil/runtime/table symbolic-table-ref symbolic-table-set!)
        (only-in :std/struct/rbtree RBTree rbtree-copy rbtree-ref rbtree-put! rbtree-put
                 rbtree-remove rbtree-fold rbtree-foldr rbtree-for-each rbtree-size rbtree->list
                 in-rbtree-values)
        (only-in ./support/base %compare-symbol-identity)
        (only-in ./support/index %index %index-project %index-ref %index-fork %index-write!
                 %index? %index-base %index-changes)
        (only-in ./slot-observation %call-with-recorded-slot-reads %record-slot-reads!)
        ./object (only-in ./mop define-type) ./support/option)
(defstruct %schedule (source order reads adjacency ranks reverse supported work positions position-changes
                     rank-frontier owned) final: #t)
(def schedule? %schedule?)
(def schedule-source %schedule-source)
(def (schedule-order scheduled)
  (let (order (force (%schedule-order scheduled)))
    (if (%schedule-owned scheduled) (list-copy order) order)))
(def schedule-reads %schedule-reads)
(def schedule-work %schedule-work)
(def (schedule-supports? scheduled key)
  (and (symbol? key)
       (let (supported (%schedule-supported scheduled))
         (if supported (hash-key? supported key)
           (and (%index-ref (%schedule-ranks scheduled) key #f) #t)))))
(defstruct failure (kind key) final: #t)
(def (keys! keys)
  (unless (and (list? keys) (andmap symbol? keys)) (error "component keys must be symbols"))
  (delete-duplicates/hash keys from-end?: #t))
(def (index-keys keys (index (make-hash-table-eq)))
  (for (key keys) (hash-put! index key #t)) index)
(def (table entries (result (make-hash-table-eq)))
  (for (entry entries)
    (unless (and (pair? entry) (symbol? (car entry))) (error "invalid component binding"))
    (when (hash-key? result (car entry)) (error "duplicate component binding" (car entry)))
    (hash-put! result (car entry) (cdr entry)))
  result)
(define-type (Declaration. @ [] keys .code .base))
(def (declaration keys codes (base []))
  (def names (keys! keys))
  (def programs (table codes))
  (def values (table base))
  (.cc Declaration. keys: names .code: (cut hash-get programs <>) .base: (cut hash-get values <>)))
(def (define spec key code)
  (unless (symbol? key) (error "component key must be a symbol"))
  (.cc spec keys: (if (memq key (.@ spec keys)) (.@ spec keys) (append (.@ spec keys) (list key)))
       .code: (lambda (query) (if (eq? key query) code (.call spec .code query)))))
(def (set-base spec key value)
  (unless (symbol? key) (error "component key must be a symbol"))
  (unless (or (not value) (some? value)) (error "base must be an option"))
  (.cc spec .base: (lambda (query) (if (eq? key query) value (.call spec .base query)))))
;; Apply one checked, immutable batch over existing support. Code/base entries
;; have independent namespaces: one node may change both, but duplicate writes
;; within either list refuse. No intermediate graph is scheduled or published.
;; A #f code removes its equation; a #f base is explicit absence, not no-op.
(def (%revise spec codes bases known-index)
  (def programs (table codes))
  (def values (table bases))
  (def supported (or known-index (index-keys (.@ spec keys))))
  (unless (andmap (lambda (entry) (hash-key? supported (car entry))) (append codes bases))
    (error "revision target outside component support"))
  (unless (andmap (lambda (entry) (or (not (cdr entry)) (some? (cdr entry)))) bases)
    (error "revision base must be an optional outcome"))
  (.cc spec
    .code: (lambda (key) (if (hash-key? programs key) (hash-ref programs key) (.call spec .code key)))
    .base: (lambda (key) (if (hash-key? values key) (hash-ref values key) (.call spec .base key)))))
(def (revise spec codes (bases [])) (%revise spec codes bases #f))
;; Change finite support and code/base in one immutable batch. Removed keys lose
;; both bindings; newly supported keys never inherit latent old definitions.
;; Surviving keys keep exact identities until explicitly edited. Final dangling
;; reads are rejected by SCC/schedule validation before construction/approval.
(def (reconfigure spec keys codes (bases []))
  (unless (and (list? keys) (andmap symbol? keys)
               (= (length keys) (length (delete-duplicates/hash keys))))
    (error "distinct final component support required"))
  (def previous (index-keys (.@ spec keys)))
  (def supported (index-keys keys))
  (def kept (lambda (key) (and (hash-key? supported key) (hash-key? previous key))))
  (%revise (.cc spec keys: keys
    .code: (lambda (key) (and (kept key) (.call spec .code key)))
    .base: (lambda (key) (and (kept key) (.call spec .base key)))) codes bases supported))
(def (remove spec key)
  (.cc (set-base spec key #f) .code: (lambda (query) (if (eq? key query) #f (.call spec .code query)))))
(def (support spec keys) (.cc spec keys: (keys! keys)))
(def (work owners footprints buckets edges assignments checks copies materialized (writes 0) (source-writes 0)
           (retired-bucket-count 0) (retired-reader-count 0))
  (.o owner-checks: owners footprint-reads: footprints search-buckets: buckets
      search-edges: edges rank-writes: assignments incident-checks: checks
      copied-entries: copies order-materialized: materialized patch-writes: writes
      source-patch-writes: source-writes
      retirement-buckets: retired-bucket-count retirement-readers: retired-reader-count))

(def (read-projection index owned)
  ;; Explicitly owned snapshots never expose their authoritative row spines.
  (if owned (lambda (key)
              (let (row (%index-ref index key))
                (unless row (raise (make-failure 'unsupported key)))
                (list-copy row)))
    (lambda (key) (%index-ref index key))))
(def (materialize-order positions changes)
  ;; Merge the sorted sparse assignments into the private cold order.
  ;; Only this explicit projection constructs the complete list.
  (def updates (rbtree->list changes))
  (with-list-builder (add)
    (let loop ((index 0) (rest updates))
      (cond ((= index (vector-length positions))
             (for (entry rest) (add (cdr entry))))
            ((and (pair? rest) (= index (caar rest)))
             (when (cdar rest) (add (cdar rest)))
             (loop (1+ index) (cdr rest)))
            (else (add (vector-ref positions index)) (loop (1+ index) rest))))))
(def (indexed-schedule spec order reads supported receipt owned sparse-inverse? edgeless?
                       (implicit-empty? #f))
  (def ranks (if owned (make-hash-table-symbolic size: (hash-length supported))
                       (make-hash-table-eq)))
  (def readers (if (and owned (not sparse-inverse?))
                 (make-hash-table-symbolic size: (hash-length supported))
                 (make-hash-table-symbolic)))
  (def positions (make-vector (hash-length supported)))
  (for ((key order) (rank (in-range (vector-length positions))))
    (vector-set! positions rank key)
    (hash-put! ranks key rank)
    (unless sparse-inverse? (hash-put! readers key [])))
  (unless edgeless?
    (for (key order)
      (for (dep (hash-ref reads key))
        (hash-put! readers dep (cons key (hash-ref readers dep []))))))
  (def adjacency (if implicit-empty?
                   (%index-project supported (lambda (_) []))
                   (%index reads)))
  (make-%schedule spec (delay order)
    (if owned (read-projection adjacency owned) (lambda (key) (hash-ref reads key)))
    adjacency (%index ranks)
    (%index readers) supported receipt positions #f (vector-length positions) owned))
(def (schedule spec)
  (schedule-rows spec (.@ spec keys)
    (lambda (key)
      (def code (.call spec .code key))
      (if code (keys! (.@ code reads)) []))))
(def (schedule-rows spec keys row (owned #f) (known-support #f) (footprints #f))
  ;; The empty-capture arm supplies no row reader: all authored capture has
  ;; already finished, and every admitted owner gets the implicit empty row.
  (def implicit-empty? (not row))
  (def reads (if owned
               (if implicit-empty? (make-hash-table-symbolic)
                 (make-hash-table-symbolic size: (if known-support (hash-length known-support) (length keys))))
               (make-hash-table-eq)))
  (def states (make-hash-table-eq))
  (def supported (or known-support (make-hash-table-eq)))
  ;; Private certificate: #f means no edges, a symbol means one provider,
  ;; #t means multiple providers (or an invalid row requiring ordinary DFS).
  (def inverse-root #f)
  (unless implicit-empty?
    (for (key keys)
      (unless known-support (hash-put! supported key #t))
      (def captured (row key))
      (hash-put! reads key captured)
      (when (and owned (not (eq? inverse-root #t)) (not (null? captured)))
        (set! inverse-root
          (if (and (pair? captured) (null? (cdr captured))
                   (or (not inverse-root) (eq? inverse-root (car captured))))
            (car captured) #t)))))
  (def order
    (if (and owned (not inverse-root)) (list-copy keys)
      (with-list-builder (add)
        (def (visit key)
          (unless (hash-key? supported key) (raise (make-failure 'unsupported key)))
          (case (hash-get states key)
            ((done) (void))
            ((active) (raise (make-failure 'cycle key)))
            (else (hash-put! states key 'active)
              (for-each visit (hash-ref reads key))
              (hash-put! states key 'done) (add key))))
        (for-each visit keys))))
  (indexed-schedule spec order reads supported
    (work (length keys) (if implicit-empty? 0 (or footprints (length keys))) 0 0 0 0 0 (length keys)) owned
    (and owned (not (eq? inverse-root #t))) (and owned (not inverse-root)) implicit-empty?))

;; The owned entry captures structural rows once. Computations and their
;; evaluator bodies remain author values. The rank graph never executes them.
(defstruct %program (value row support) final: #t)
(defstruct %owned-source (keys programs bases) final: #t)
(defstruct %revision (parent source changes roots checked footprints added retired retirement-readers) final: #t)
(def (%schedule-revision-retirements ticket)
  (list-copy (%revision-retired ticket)))
(def (schedule-owned? value) (and (schedule? value) (and (%schedule-owned value) #t)))
(def (capture-program program (normalize keys!))
  (and program
       (let-values (((row support)
                     (%call-with-recorded-slot-reads
                       (lambda () (list-copy (normalize (.@ program reads)))))))
         (call-with-current-slot-reads support values)
         (%record-slot-reads! support)
         (make-%program program row support))))
(def (capture-program-batch action)
  (defvalues (result support) (%call-with-recorded-slot-reads action unique-roots?: #t))
  ;; A later author getter may invalidate an earlier accepted observation.
  ;; Validate all edited support before issuing the detached structural patch.
  (call-with-current-slot-reads support values)
  result)
(def (program-row program) (if program (%program-row program) []))
(def (owned-source-names source)
  (let (names (%owned-source-keys source))
    (if (procedure? names) (names) names)))
(def (owned-declaration source (raw? #f))
  ;; The public source view may enumerate its own defensive copy explicitly.
  ;; Building a revision must not evaluate that slot.
  (seal-object!
    (.o keys: (list-copy (owned-source-names source))
    .code: (lambda (key)
      (let (captured (and (symbol? key) (%index-ref (%owned-source-programs source) key #f)))
        (and captured
             (if raw? (%program-value captured)
               (.o reads: (list-copy (%program-row captured))
                   .evaluate: (lambda (provider)
                     (call-with-current-slot-reads (%program-support captured)
                       (lambda (_) (.call (%program-value captured) .evaluate provider)))))))))
    .base: (lambda (key) (and (symbol? key) (%index-ref (%owned-source-bases source) key #f))))))
;; Stable source positions address persistent native dependency witnesses.
;; Unchanged children stay shared. Weak reverse links release retired parents.
(defstruct %witness-tree (stamp left right evidence) final: #t)
(def (%witness-tree-current? tree)
  (or (not tree) (zero? (object-revision (%witness-tree-stamp tree)))))
(def (%splice-witness-tree old width edits attach-leaf! register)
  (def pending [])
  (def (node left right evidence)
    (def result (make-%witness-tree (make-object) left right evidence))
    (set! pending (cons result pending))
    result)
  (def (walk old first width rest)
    (cond
     ((or (null? rest) (>= (caar rest) (+ first width))) (values old rest))
     ((= width 1)
      (def evidence (cdar rest))
      (values (and evidence (node #f #f evidence)) (cdr rest)))
     (else
      (def half (quotient width 2))
      (defvalues (left next) (walk (and old (%witness-tree-left old)) first half rest))
      (defvalues (right tail) (walk (and old (%witness-tree-right old)) (+ first half) (- width half) next))
      (values (and (or left right) (node left right #f)) tail))))
  (def (attach! tree)
    (def stamp (%witness-tree-stamp tree))
    (def evidence (%witness-tree-evidence tree))
    (def left (%witness-tree-left tree))
    (def right (%witness-tree-right tree))
    (def current?
      (if evidence (attach-leaf! stamp evidence)
        (begin
          (when left (depend-on-object! stamp (%witness-tree-stamp left)))
          (when right (depend-on-object! stamp (%witness-tree-stamp right)))
          (and (%witness-tree-current? left) (%witness-tree-current? right)))))
    ;; Linking to an already dirty child cannot replay its past invalidation.
    (unless current? (uninstantiate-object! stamp)))
  (defvalues (root rest) (walk old 0 width edits))
  (unless (null? rest) (error "witness positions disagree with owned support"))
  ;; Allocate nodes before registration. The coordinator can then link them
  ;; under its lock in child-to-parent order using only native evidence.
  (when (pair? pending)
    (let (nodes (reverse pending))
      (register (lambda () (for-each attach! nodes)))))
  root)

(defstruct %component-source (storage positions authority code-witnesses base-witnesses) final: #t)
(def (component-row! reads)
  (unless (and (list? reads) (andmap symbol? reads)) (error "component reads must be symbols"))
  (delete-duplicates/hash reads table: (make-hash-table-symbolic)))
(def (capture-component-program program supported)
  (def captured (capture-program program component-row!))
  (for (key (program-row captured))
    (unless (hash-key? supported key) (raise (make-failure 'unsupported key))))
  captured)
(def (capture-source-evidence action)
  (defvalues (result reads) (%call-with-recorded-slot-reads action))
  (%record-slot-reads! reads)
  (values result (and (pair? reads) reads)))
(def (attach-source-evidence! witness reads)
  (%register-slot-dependencies! witness reads)
  #t)
(def (%component-source-current! source)
  (unless (and (zero? (object-revision (%component-source-authority source)))
               (%witness-tree-current? (%component-source-code-witnesses source))
               (%witness-tree-current? (%component-source-base-witnesses source)))
    (error "component source generation is stale")))
(def (%with-component-source source action)
  (%component-source-current! source)
  (def (protect tree active) (if tree (cons (%witness-tree-stamp tree) active) active))
  (def active (protect (%component-source-code-witnesses source)
                (protect (%component-source-base-witnesses source) (active-object-constructions))))
  (parameterize ((active-object-constructions (cons (%component-source-authority source) active)))
    (begin0 (action) (%component-source-current! source))))
(def (%component-source-view source raw?: (raw? #f))
  (owned-declaration (%component-source-storage source) raw?))
(def (%capture-component-source spec register)
  (defvalues (names key-reads) (capture-source-evidence (lambda () (list-copy (.get spec keys)))))
  (def count (length names))
  (def positions (make-hash-table-symbolic size: count))
  (for ((key names) (position (in-range count)))
    (unless (and (symbol? key) (not (hash-key? positions key)))
      (error "distinct symbolic component owners required" key))
    (hash-put! positions key position))
  (defvalues (accessors accessor-reads)
    (capture-source-evidence (lambda ()
      (def code (.get spec .code))
      (cons code (.get spec .base)))))
  (def code (car accessors))
  (def base (cdr accessors))
  (def programs (make-hash-table-symbolic))
  (def bases (make-hash-table-symbolic))
  (def code-edits [])
  (def base-edits [])
  (for ((key names) (position (in-range count)))
    (defvalues (program code-reads)
      (capture-source-evidence (lambda () (capture-component-program (code key) positions))))
    (defvalues (value base-reads) (capture-source-evidence (lambda () (base key))))
    (unless (or (not value) (some? value)) (error "component base must be an optional outcome" key))
    (when program (hash-put! programs key program))
    (when value (hash-put! bases key value))
    (when code-reads (set! code-edits (cons (cons position code-reads) code-edits)))
    (when base-reads (set! base-edits (cons (cons position base-reads) base-edits))))
  (def stamp (make-object))
  (def authority-reads (append (or key-reads []) (or accessor-reads [])))
  (when (pair? authority-reads) (register (lambda () (attach-source-evidence! stamp authority-reads))))
  (def span (max 1 count))
  (def source
    (make-%component-source (make-%owned-source names (%index programs) (%index bases)) positions stamp
      (%splice-witness-tree #f span (reverse code-edits) attach-source-evidence! register)
      (%splice-witness-tree #f span (reverse base-edits) attach-source-evidence! register)))
  (%component-source-current! source)
  source)
(def (%edit-component-source prior codes bases register)
  (%with-component-source prior
    (lambda ()
      (def positions (%component-source-positions prior))
      (def programs (table codes (make-hash-table-symbolic)))
      (def values (table bases (make-hash-table-symbolic)))
      (def code-keys (map car codes))
      (def base-keys (map car bases))
      (check-edit-targets (cut hash-key? positions <>) code-keys base-keys values)
      (def old (%component-source-storage prior))
      (def next-programs (if (null? code-keys) (%owned-source-programs old)
                           (%index-fork (%owned-source-programs old))))
      (def next-bases (if (null? base-keys) (%owned-source-bases old)
                        (%index-fork (%owned-source-bases old))))
      (def code-edits [])
      (def rows
        (for/collect (key code-keys)
          (defvalues (captured reads)
            (capture-source-evidence (lambda () (capture-component-program (hash-ref programs key) positions))))
          (set! code-edits (cons (cons (hash-ref positions key) reads) code-edits))
          (%index-write! next-programs key captured)
          (cons key (program-row captured))))
      (for (key base-keys) (%index-write! next-bases key (hash-ref values key)))
      (def (splice tree edits)
        (%splice-witness-tree tree (max 1 (hash-length positions))
          (list-sort (lambda (a b) (< (car a) (car b))) edits) attach-source-evidence! register))
      (def result
        (make-%component-source (make-%owned-source (%owned-source-keys old) next-programs next-bases)
          positions (%component-source-authority prior)
          (splice (%component-source-code-witnesses prior) code-edits)
          (splice (%component-source-base-witnesses prior)
            (map (lambda (key) (cons (hash-ref positions key) #f)) base-keys))))
      (%component-source-current! result)
      ;; Only this combined result can supply both successor code and rows.
      (vector result rows (append code-keys base-keys)))))

(def (check-edit-targets supports? code-keys base-keys bases)
  (def (check key)
    (unless (supports? key) (raise (make-failure 'unsupported key))))
  (for-each check code-keys)
  (for-each
    (lambda (key)
      (check key)
      (let (value (hash-ref bases key))
        (unless (or (not value) (some? value)) (error "revision base must be an optional outcome"))))
    base-keys))
(def (schedule-owned keys codes (bases []))
  (schedule-owned/rows keys codes bases #t))
(def (schedule-owned/rows keys codes bases implicit-allowed?)
  (def names (list-copy (keys! keys)))
  ;; Owned snapshots use stable Symbol hashing, including after GC.
  (def supported (index-keys names (make-hash-table-symbolic size: (length names))))
  (def programs (table codes))
  (def values (table bases (make-hash-table-symbolic)))
  (def code-keys (map car codes))
  (check-edit-targets (cut hash-key? supported <>) code-keys (map car bases) values)
  (def captured (make-hash-table-symbolic))
  (capture-program-batch
    (lambda ()
      (for (key code-keys)
        (hash-put! captured key (capture-program (hash-ref programs key))))))
  (def source (make-%owned-source names
    (%index captured) (%index values)))
  (def implicit-empty? (and implicit-allowed? (zero? (hash-length captured))))
  (schedule-rows (owned-declaration source) names
    (and (not implicit-empty?) (lambda (key) (program-row (hash-get captured key)))) source supported))
;; A quotient with a changed roster still needs a full schedule certificate.
;; Keep admitted program identities and capture only explicitly changed rows.
(def (%reschedule-owned-support prior keys codes)
  (unless (schedule-owned? prior) (error "support change requires an owned schedule"))
  (def names (keys! keys))
  (unless (= (length keys) (length names)) (error "duplicate component support"))
  (def supported (index-keys names (make-hash-table-symbolic size: (length names))))
  (def entries (table codes (make-hash-table-symbolic)))
  (def code-keys (map car codes))
  (check-edit-targets (cut hash-key? supported <>) code-keys [] #f)
  (def old (%schedule-owned prior))
  ;; Distinct, supported edits of this cardinality cover the successor
  ;; roster. No predecessor program can be observed from this new base.
  (def complete? (= (hash-length entries) (hash-length supported)))
  (def program-base (and complete? (make-hash-table-symbolic size: (hash-length supported))))
  (def programs (if complete? (%index program-base) (%index-fork (%owned-source-programs old))))
  (def put-program! (if complete? (cut hash-put! program-base <> <>) (cut %index-write! programs <> <>)))
  (def bases (%index-fork (%owned-source-bases old)))
  (for (key (owned-source-names old))
    (unless (hash-key? supported key)
      (unless complete? (put-program! key #f))
      (%index-write! bases key #f)))
  (capture-program-batch
    (lambda ()
      (for (key code-keys)
        (put-program! key (capture-program (hash-ref entries key))))))
  (def owned (make-%owned-source names programs bases))
  (schedule-rows (owned-declaration owned) names
    (lambda (key) (program-row (%index-ref programs key #f)))
    owned supported (length code-keys)))
(def (%schedule-same-program? old next key)
  (def previous (%schedule-owned old))
  (def current (%schedule-owned next))
  (if (and previous current)
    (eq? (%index-ref (%owned-source-programs previous) key #f)
         (%index-ref (%owned-source-programs current) key #f))
    (eq? (.call (schedule-source old) .code key) (.call (schedule-source next) .code key))))
(def (merge-support-roster old added retired before?)
  (with-list-builder (add)
    (let merge ((retained old) (fresh added))
      (cond ((null? retained) (for-each add fresh))
            ((hash-key? retired (car retained)) (merge (cdr retained) fresh))
            ((and (pair? fresh) (before? (car fresh) (car retained)))
             (add (car fresh)) (merge retained (cdr fresh)))
            (else (add (car retained)) (merge (cdr retained) fresh))))))
;; Source ordering is supplied by the admitted partition's immutable ranks.
;; The successor roster itself is derived only from validated additions and
;; retirements, and is enumerated for public keys or independent approval.
(def (%schedule-support-revision prior codes added retired before?)
  (schedule-revision-for prior codes [] added retired before?))
(def (schedule-revision prior codes (bases []))
  (schedule-revision-for prior codes bases [] [] #f))
(def (schedule-revision-for prior codes bases added retired before?)
  (unless (schedule-owned? prior) (error "revision requires an owned schedule"))
  (def old (%schedule-owned prior))
  (def checked-programs (table codes))
  (def checked-bases (table bases))
  (def added-keys (and before? (list-copy (keys! added))))
  (def retired-keys (and before? (list-copy (keys! retired))))
  (def adds (and before? (index-keys added-keys)))
  (def removes (and before? (index-keys retired-keys)))
  (def (active? key)
    (if before?
      (and (not (hash-key? removes key))
           (or (hash-key? adds key) (schedule-supports? prior key)))
      (schedule-supports? prior key)))
  (def retirement-readers 0)
  (when before?
    (unless (and (= (length added) (length added-keys)) (= (length retired) (length retired-keys)))
      (error "duplicate quotient support edit"))
    (for (key added-keys)
      (when (or (schedule-supports? prior key) (not (hash-key? checked-programs key)))
        (raise (make-failure 'unsupported key))))
    (for (key retired-keys)
      (unless (schedule-supports? prior key) (raise (make-failure 'unsupported key)))
      (%for-each-reverse-bucket
        (lambda (consumer)
          (set! retirement-readers (1+ retirement-readers))
          (when (and (active? consumer) (not (hash-key? checked-programs consumer)))
            (raise (make-failure 'unsupported key))))
        (%index-ref (%schedule-reverse prior) key []))))
  ;; No author callback runs before binding and ordering the whole request.
  ;; Do not read the caller's mutable pairs after the first capture starts.
  (def code-keys (map car codes))
  (def base-keys (map car bases))
  (check-edit-targets active? code-keys base-keys checked-bases)
  (def programs (%index-fork (%owned-source-programs old)))
  (def values (%index-fork (%owned-source-bases old)))
  (def changes [])
  (def footprints 0)
  (capture-program-batch
    (lambda ()
      (for (key code-keys)
        (def captured (capture-program (hash-ref checked-programs key)))
        (when captured (set! footprints (1+ footprints)))
        (def row (program-row captured))
        (for (dep row)
          (unless (active? dep) (raise (make-failure 'unsupported dep))))
        (unless (equal? row (or (%index-ref (%schedule-adjacency prior) key #f) []))
          (set! changes (cons (cons key row) changes)))
        (rbtree-put! (%index-changes programs) key captured))))
  (for (key base-keys)
    (rbtree-put! (%index-changes values) key (hash-ref checked-bases key)))
  (def names (%owned-source-keys old))
  (when before?
    (for (key retired-keys)
      (%index-write! programs key #f)
      (%index-write! values key #f)
      (set! changes (cons (list key) changes)))
    (let (roster (delay (merge-support-roster (owned-source-names old)
                          (list-sort before? (list-copy added-keys)) removes before?)))
      (set! names (lambda () (force roster)))))
  (make-%revision prior (make-%owned-source names programs values)
    (reverse changes) (delete-duplicates/hash (append code-keys base-keys))
    (+ (hash-length checked-programs) (hash-length checked-bases)) footprints
    (or added-keys []) (or retired-keys []) retirement-readers))
(def (apply-schedule-revision prior ticket affected?: (affected? #f))
  (%apply-schedule-revision-with-invalidation prior ticket affected? #f))
;; Only the actual revision ticket supplies roots. Reusing the old inverse is
;; exact when support identities are stable and every edited row is a root.
(def (%apply-schedule-revision-with-invalidation prior ticket affected? invalidation)
  (unless (and (%revision? ticket) (eq? prior (%revision-parent ticket)))
    (raise (make-failure 'stale-revision #f)))
  (when invalidation (require-schedule-invalidation! prior invalidation))
  (def source (%revision-source ticket))
  (def spec (owned-declaration source))
  (def changed (%revision-changes ticket))
  (def checked (%revision-checked ticket))
  (def footprints (%revision-footprints ticket))
  (def added (%revision-added ticket))
  (def retired (%revision-retired ticket))
  (def result
    (if (and (null? changed) (null? added) (null? retired))
      (retain-schedule prior spec checked footprints source checked)
      (repair-order prior spec changed footprints checked source
        (+ checked (* 2 (length retired))) added retired (%revision-retirement-readers ticket))))
  (if affected?
    (let-values (((reached counts)
                  (if (and invalidation (null? added) (null? retired))
                    (revision-invalidated-owners prior invalidation (%revision-roots ticket))
                    (let (counts (vector 0 0))
                      (values (affected-owners (%schedule-reverse result) (%revision-roots ticket) counts)
                              counts)))))
      (def ranks (%schedule-ranks result))
      (def ordered (list-sort (lambda (a b) (< (%index-ref ranks a) (%index-ref ranks b)))
                     (hash-keys reached)))
      (values result ordered counts))
    result))
(def (retain-schedule prior spec checked footprints (owned #f) (source-writes 0))
  (make-%schedule spec (%schedule-order prior) (schedule-reads prior)
    (%schedule-adjacency prior) (%schedule-ranks prior) (%schedule-reverse prior)
    (%schedule-supported prior) (work checked footprints 0 0 0 0 0 0 0 source-writes)
    (%schedule-positions prior) (%schedule-position-changes prior) (%schedule-rank-frontier prior) owned))

;;; A captured footprint is checked once per changed program. No revision hint
;;; or unchanged output authenticates it. Source acquisition still enumerates
;;; support; local order repair below does not enumerate the numeric interval.
(def (reschedule prior spec)
  (if (not (equal? (.@ spec keys) (.@ (schedule-source prior) keys)))
    (schedule spec)
    (let ((changes []) (footprints 0))
      (for (key (.@ spec keys))
        (def code (.call spec .code key))
        (unless (eq? code (.call (schedule-source prior) .code key))
          (let (row (if code (keys! (.@ code reads)) []))
            (set! footprints (1+ footprints))
            (unless (equal? row ((schedule-reads prior) key))
              (for (dep row)
                (unless (schedule-supports? prior dep) (raise (make-failure 'unsupported dep))))
              (set! changes (cons (cons key row) changes))))))
      (if (null? changes)
        (retain-schedule prior spec (length (.@ spec keys)) footprints)
        (repair-order prior spec (reverse changes) footprints (length (.@ spec keys)))))))

;; A deletion owns only its mask and the path-copied active insertions.
;; The immutable base spine stays borrowed from the prior schedule.
(defstruct reverse-bucket (base edited added next) final: #t)
(def (reverse-bucket-remove row owner)
  (if (reverse-bucket? row)
    (let* ((edited (reverse-bucket-edited row))
           (ordinal (rbtree-ref edited owner #f))
           (added (reverse-bucket-added row)))
      (make-reverse-bucket (reverse-bucket-base row)
        (rbtree-put edited owner #f)
        (if ordinal (rbtree-remove added ordinal) added)
        (reverse-bucket-next row)))
    (make-reverse-bucket row (rbtree-put (RBTree %compare-symbol-identity) owner #f) (RBTree -) 0)))
(def (reverse-bucket-add row owner)
  (if (reverse-bucket? row)
    ;; The standard forward iterator sees the newest insertion first.
    (let (ordinal (- (reverse-bucket-next row)))
      (make-reverse-bucket (reverse-bucket-base row)
        (rbtree-put (reverse-bucket-edited row) owner ordinal)
        (rbtree-put (reverse-bucket-added row) ordinal owner)
        (1+ (reverse-bucket-next row))))
    (cons owner row)))
(defalias %reverse-bucket-remove reverse-bucket-remove)
(defalias %reverse-bucket-add reverse-bucket-add)
(def (only-masked-owner edited)
  (rbtree-fold (lambda (owner _value _seed) owner) #f edited))
(def (bucket-mask edited)
  (if (= (rbtree-size edited) 1)
    (only-masked-owner edited)
    (let (mask (make-hash-table-symbolic size: (rbtree-size edited)))
      (rbtree-for-each (lambda (owner _value) (hash-put! mask owner #t)) edited)
      mask)))
(def (reverse-bucket-members row)
  (if (reverse-bucket? row)
    (let ((mask (bucket-mask (reverse-bucket-edited row)))
          (base (reverse-bucket-base row)))
      (rbtree-foldr (lambda (_ordinal owner tail) (cons owner tail))
        (if (symbol? mask)
          (filter (lambda (owner) (not (eq? mask owner))) base)
          (filter (lambda (owner) (not (hash-key? mask owner))) base))
        (reverse-bucket-added row)))
    row))
(def (%for-each-reverse-bucket visit row)
  (if (reverse-bucket? row)
    (let ((mask (bucket-mask (reverse-bucket-edited row)))
          (base (reverse-bucket-base row)))
      (rbtree-for-each (lambda (_ordinal owner) (visit owner)) (reverse-bucket-added row))
      (if (symbol? mask)
        (for-each (lambda (owner) (unless (eq? mask owner) (visit owner))) base)
        (for-each (lambda (owner) (unless (hash-key? mask owner) (visit owner))) base)))
    (for-each visit row)))

;;; Pearce/Kelly stable relabel, consumer -> provider orientation.
;;; All mutations belong to an unpublished candidate. Prior indices and values
;;; remain immutable on failure and during reentrant construction callbacks.
(def (repair-order prior spec changes footprints checked (owned #f) (source-writes 0)
                   (added []) (retired []) (retirement-readers 0))
  (def reads (%index-fork (%schedule-adjacency prior)))
  (def ranks (%index-fork (%schedule-ranks prior)))
  (def readers (%index-fork (%schedule-reverse prior)))
  (def positions (%schedule-positions prior))
  (def old-positions (%schedule-position-changes prior))
  (def position-changes #f)
  (def frontier (%schedule-rank-frontier prior))
  (def patch-writes 0)
  (def (patch! changes key value)
    (rbtree-put! changes key value)
    (set! patch-writes (1+ patch-writes)))
  (def (index-set! index key value)
    (patch! (%index-changes index) key value))
  (def (position-index!)
    (unless position-changes
      (set! position-changes (if old-positions (rbtree-copy old-positions) (RBTree -))))
    position-changes)
  (def additions [])
  (def buckets 0)
  (def edges 0)
  (def assignments 0)
  (def checks 0)
  (def (rank key) (%index-ref ranks key))
  (def (members row)
    (def index (make-hash-table-eq))
    (for (key row) (hash-put! index key #t)) index)
  ;; New representatives start isolated. Appended ranks cannot collide
  ;; with a retained rank, including any previously appended label.
  (for (key added)
    (index-set! reads key [])
    (index-set! readers key [])
    (index-set! ranks key frontier)
    (patch! (position-index!) frontier key)
    (set! frontier (1+ frontier)))
  ;; Remove every deleted edge before admitting additions: a replacement batch
  ;; must not be refused for a transient cycle absent from its final graph.
  (for (entry changes)
    (def key (car entry))
    (def old (%index-ref reads key))
    (def fresh (cdr entry))
    (def old-index (members old))
    (def new-index (members fresh))
    (index-set! reads key (filter (cut hash-key? new-index <>) old))
    (for (dep old)
      (unless (hash-key? new-index dep)
        (index-set! readers dep (reverse-bucket-remove (%index-ref readers dep []) key))))
    (for (dep fresh)
      (unless (hash-key? old-index dep) (set! additions (cons (cons key dep) additions)))))
  ;; Retired rows are in the deletion batch above. All surviving readers
  ;; of a retired provider were checked against the predecessor inverse.
  (for (key retired)
    (def label (rank key))
    (if (< label (vector-length positions))
      (patch! (position-index!) label #f)
      (let (current (position-index!))
        (set! position-changes (rbtree-remove current label))
        (set! patch-writes (1+ patch-writes))))
    (index-set! ranks key #f)
    (index-set! readers key []))
  (def (search adjacency root low high)
    (def seen (make-hash-table-eq))
    ;; The admitted DAG certifies the other bound. Deletions cannot break it,
    ;; and each prior insertion was checked before this search starts.
    (def forward? (eq? adjacency reads))
    (def complete? (if forward? (zero? low) (>= high (1- frontier))))
    ;; Partial intervals keep the former predicate and its query path.
    (def within? (lambda (dep) (<= low (rank dep) high)))
    (let loop ((pending (list root)) (found []))
      (if (null? pending) (values found seen)
        (let ((key (car pending)) (rest (cdr pending)))
          (if (hash-key? seen key) (loop rest found)
            (begin
              (hash-put! seen key #t)
              (set! buckets (1+ buckets))
              (let (row (reverse-bucket-members
                          (if forward? (%index-ref adjacency key) (%index-ref adjacency key []))))
                ;; Count boundary edges too; pruning is not free work.
                (set! edges (+ edges (length row)))
                (loop (append (if complete? row (filter within? row)) rest)
                  (cons key found)))))))))
  (for (addition (reverse additions))
    (def consumer (car addition))
    (def provider (cdr addition))
    (unless (< (rank provider) (rank consumer))
      (let ((low (rank consumer)) (high (rank provider)))
      (defvalues (forward f-index) (search reads provider low high))
      (when (hash-key? f-index consumer) (raise (make-failure 'cycle consumer)))
      (defvalues (backward b-index) (search readers consumer low high))
      (for (key backward)
        (when (hash-key? f-index key) (raise (make-failure 'cycle key))))
      (def less? (lambda (a b) (< (rank a) (rank b))))
      (def owners (append (list-sort less? forward) (list-sort less? backward)))
      (def labels (list-sort < (map rank owners)))
      ;; Every RHS is acquired before the first assignment. The old labels are
      ;; permuted, never invented, and all other ranks retain their identity.
      (for ((key owners) (label labels))
        (index-set! ranks key label)
        (patch! (position-index!) label key)
        (set! assignments (1+ assignments)))
      ;; Exact incident checks include unchanged consumers, not just outgoing
      ;; edges of owners whose labels moved. No callback runs in this interval.
      (for (key owners)
        (for (dep (%index-ref reads key))
          (set! checks (1+ checks))
          (unless (< (rank dep) (rank key)) (raise (make-failure 'rank key))))
        (%for-each-reverse-bucket
          (lambda (reader)
            (set! checks (1+ checks))
            (unless (< (rank key) (rank reader)) (raise (make-failure 'rank reader))))
          (%index-ref readers key [])))))
    (unless (< (rank provider) (rank consumer)) (raise (make-failure 'rank consumer)))
    (index-set! reads consumer (cons provider (%index-ref reads consumer)))
    (index-set! readers provider (reverse-bucket-add (%index-ref readers provider []) consumer)))
  ;; Preserve the author's exact footprint order, independently of insertion
  ;; order used for validation. Reads were captured before the pure repair.
  (for (entry changes) (index-set! reads (car entry) (cdr entry)))
  (for (key retired) (index-set! reads key #f))
  (let (order (if position-changes (delay (materialize-order positions position-changes))
                (%schedule-order prior)))
    (make-%schedule spec order (read-projection reads owned) reads ranks readers
      (and (null? added) (null? retired) (%schedule-supported prior))
      (work checked footprints buckets edges assignments checks 0 0 patch-writes source-writes
        (length retired) retirement-readers)
      positions (or position-changes old-positions) frontier owned)))

;; Frames borrow immutable index rows. The sentinel is the append point for
;; new roots, even while an older frame is partly consumed. Only this work
;; owns the frame cells and visited table.
(defstruct reverse-cursor (insertions remaining base masked?) final: #t)
(def missing-reverse-edit (gensym 'missing-reverse-edit))
(def (open-reverse-cursor row)
  (def edited (reverse-bucket-edited row))
  (def added (reverse-bucket-added row))
  (def width (rbtree-size added))
  (def masked?
    (if (= (rbtree-size edited) 1)
      (let (excluded (only-masked-owner edited)) (cut eq? excluded <>))
      (lambda (owner) (not (eq? (rbtree-ref edited owner missing-reverse-edit) missing-reverse-edit)))))
  (make-reverse-cursor (and (positive? width) (in-rbtree-values added))
    width (reverse-bucket-base row) masked?))
(def (reverse-cursor-empty? cursor)
  (and (zero? (reverse-cursor-remaining cursor)) (null? (reverse-cursor-base cursor))))
(def (reverse-cursor-pop! cursor)
  (if (positive? (reverse-cursor-remaining cursor))
    (using (source (reverse-cursor-insertions cursor) :- Iterator)
      (reverse-cursor-remaining-set! cursor (1- (reverse-cursor-remaining cursor)))
      (source.next!))
    (let (base (reverse-cursor-base cursor))
      (reverse-cursor-base-set! cursor (cdr base))
      (and (not ((reverse-cursor-masked? cursor) (car base))) (car base)))))
(defstruct affected-work (readers marked raw-marked frames tail receipt) final: #t)
(def (start-affected-work readers (receipt #f))
  (def marked (make-hash-table-symbolic))
  (def raw-readers (if (%index? readers) readers (interface-instance-object readers)))
  (def raw-marked (interface-instance-object marked))
  (unless (and (or (%index? raw-readers) (symbol-hash-table? raw-readers))
               (symbol-hash-table? raw-marked))
    (error "symbolic inverse index required"))
  (def tail (list []))
  (make-affected-work raw-readers marked raw-marked tail tail receipt))

;; Fuel counts popped occurrences, including already visited owners and
;; masked base entries. Masked entries consume work without entering the
;; logical frontier. A pause retains the cursor and every older root.
(def (advance-affected-work! work roots (fuel #f))
  (unless (and (or (not fuel) (and (fixnum? fuel) (fx>= fuel 0)))
               (list? roots) (andmap symbol? roots))
    (error "invalid inverse work extension"))
  (when (pair? roots)
    (let ((old-tail (affected-work-tail work)) (new-tail (list [])))
      (set-car! old-tail (append roots []))
      (set-cdr! old-tail new-tail)
      (affected-work-tail-set! work new-tail)))
  (def tail (affected-work-tail work))
  (def readers (affected-work-readers work))
  (def marked (affected-work-raw-marked work))
  (def receipt (affected-work-receipt work))
  (def (pop! frames)
    (let (frame (car frames))
      (if (reverse-cursor? frame)
        (let (name (reverse-cursor-pop! frame))
          (when (reverse-cursor-empty? frame) (set-car! frames []))
          (when receipt
            (when name (vector-set! receipt 1 (1+ (vector-ref receipt 1))))
            (when (> (vector-length receipt) 2)
              (vector-set! receipt 2 (1+ (vector-ref receipt 2)))))
          name)
        (begin0 (car frame) (set-car! frames (cdr frame))))))
  (let walk ((frames (affected-work-frames work)) (remaining fuel))
    (cond ((eq? frames tail) (affected-work-frames-set! work tail) #t)
          ((null? (car frames)) (walk (cdr frames) remaining))
          ((and remaining (fx= remaining 0))
           (affected-work-frames-set! work frames) #f)
          (else
           (let ((name (pop! frames)) (next (and remaining (fx- remaining 1))))
             (if (or (not name) (symbolic-table-ref marked name #f)) (walk frames next)
               (let (row (if (%index? readers) (%index-ref readers name [])
                           (symbolic-table-ref readers name [])))
                 (symbolic-table-set! marked name #t)
                 (when receipt
                   (vector-set! receipt 0 (1+ (vector-ref receipt 0)))
                   (unless (reverse-bucket? row)
                     (vector-set! receipt 1 (+ (vector-ref receipt 1) (length row)))))
                 (walk (cons (if (reverse-bucket? row) (open-reverse-cursor row) row) frames) next))))))))

(def (affected-owners readers roots (receipt #f) (removed []))
  (def work (start-affected-work readers receipt))
  (advance-affected-work! work roots)
  (when (pair? removed) (advance-affected-work! work removed))
  (affected-work-marked work))

;; One work state belongs to one admitted schedule. Its mutex protects only
;; frame updates and capture of the reached set, never a producer callback.
(defstruct %invalidation (schedule work lock roots) final: #t)
(def (schedule-invalidation scheduled)
  (def readers (%schedule-reverse scheduled))
  (make-%invalidation scheduled
    (start-affected-work (if (%index-changes readers) readers (%index-base readers)))
    (make-mutex 'schedule-invalidation) (make-hash-table-symbolic)))
(def (require-schedule-invalidation! scheduled invalidation)
  (unless (and (%invalidation? invalidation)
               (eq? (%invalidation-schedule invalidation) scheduled))
    (error "invalidation belongs to another schedule")))
(def (schedule-invalidate! scheduled invalidation roots)
  (require-schedule-invalidation! scheduled invalidation)
  (unless (and (list? roots) (andmap symbol? roots))
    (error "invalid schedule invalidation roots"))
  (with-lock (%invalidation-lock invalidation) (lambda ()
    (def state (%invalidation-work invalidation))
    (def reached (affected-work-marked state))
    (def supplied (%invalidation-roots invalidation))
    (advance-affected-work! state
      (filter (lambda (root)
                (hash-put! supplied root #t)
                (not (hash-key? reached root))) roots))
    ;; Copy the reached set only. A subsequent restage can extend its work
    ;; without racing with or changing the current candidate's lookup.
    (let (captured (hash-copy reached)) (cut hash-key? captured <>)))))

;; A restage is a complete replacement proposal, not necessarily a root union.
;; Continue only when all previous roots remain present. Dropped roots restart
;; on the SAME old inverse; previously returned membership snapshots stay fixed.
(def (revision-invalidated-owners scheduled invalidation roots)
  (require-schedule-invalidation! scheduled invalidation)
  (with-lock (%invalidation-lock invalidation) (lambda ()
    (def supplied (%invalidation-roots invalidation))
    (def next (make-hash-table-symbolic))
    (def retained 0)
    (for (root roots)
      (unless (hash-key? next root)
        (hash-put! next root #t)
        (when (hash-key? supplied root) (set! retained (1+ retained)))))
    (let* ((previous (%invalidation-work invalidation))
           (receipt (or (affected-work-receipt previous) (vector 0 0)))
           (buckets (vector-ref receipt 0))
           (edges (vector-ref receipt 1))
           (state
            (if (= retained (hash-length supplied)) previous
              (let (readers (%schedule-reverse scheduled))
                (start-affected-work
                  (if (%index-changes readers) readers (%index-base readers)) receipt))))
           (reached (affected-work-marked state)))
      (affected-work-receipt-set! state receipt)
      (%invalidation-work-set! invalidation state)
      (%invalidation-roots-set! invalidation next)
      (advance-affected-work! state (filter (lambda (root) (not (hash-key? reached root))) roots))
      (values (hash-copy reached)
        (vector (- (vector-ref receipt 0) buckets) (- (vector-ref receipt 1) edges)))))))

;; A complete replacement's predicate must not contain roots of a revoked
;; proposal. Keep the cumulative public extension operation separate.
(def (%schedule-replacement-invalidate! scheduled invalidation roots)
  (unless (and (list? roots) (andmap symbol? roots))
    (error "invalid schedule invalidation roots"))
  (defvalues (reached _) (revision-invalidated-owners scheduled invalidation roots))
  (cut hash-key? reached <>))
