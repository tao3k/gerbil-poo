;;; GeneralizedGraph.Declaration: immutable source and checked finite DAG schedule.
(export Declaration. declaration define remove set-base support schedule
        schedule? schedule-source schedule-order schedule-reads
        failure? failure-kind failure-key)
(import :std/iter (only-in :std/list/list delete-duplicates/hash)
        (only-in :std/list/list-builder with-list-builder)
        ./object (only-in ./mop define-type) ./support/option)
(defstruct %schedule (source order reads) final: #t)
(def schedule? %schedule?)
(def schedule-source %schedule-source)
(def schedule-order %schedule-order)
(def schedule-reads %schedule-reads)
(defstruct failure (kind key) final: #t)
(def (keys! keys)
  (unless (and (list? keys) (andmap symbol? keys)) (error "component keys must be symbols"))
  (delete-duplicates/hash keys from-end?: #t))
(def (table entries)
  (def result (make-hash-table-eq))
  (for (entry entries)
    (unless (and (pair? entry) (symbol? (car entry))) (error "invalid component binding"))
    (when (hash-key? result (car entry)) (error "duplicate component binding" (car entry)))
    (hash-put! result (car entry) (cdr entry)))
  result)
(define-type (Declaration. @ [] keys .code .base))
(def (declaration keys codes (base []))
  (def names (keys! keys))
  (def programs (table codes))
  (def values (table base))
  (.cc Declaration. keys: names .code: (cut hash-get programs <>) .base: (cut hash-get values <>)))
(def (define spec key code)
  (unless (symbol? key) (error "component key must be a symbol"))
  (.cc spec keys: (if (memq key (.@ spec keys)) (.@ spec keys) (append (.@ spec keys) (list key)))
       .code: (lambda (query) (if (eq? key query) code (.call spec .code query)))))
(def (set-base spec key value)
  (unless (symbol? key) (error "component key must be a symbol"))
  (unless (or (not value) (some? value)) (error "base must be an option"))
  (.cc spec .base: (lambda (query) (if (eq? key query) value (.call spec .base query)))))
(def (remove spec key)
  (.cc (set-base spec key #f) .code: (lambda (query) (if (eq? key query) #f (.call spec .code query)))))
(def (support spec keys) (.cc spec keys: (keys! keys)))
(def (schedule spec)
  (def keys (.@ spec keys))
  (def reads (make-hash-table-eq))
  (def states (make-hash-table-eq))
  (def supported (make-hash-table-eq))
  (for (key keys)
    (hash-put! supported key #t)
    (def code (.call spec .code key))
    (hash-put! reads key (if code (keys! (.@ code reads)) [])))
  (def order
    (with-list-builder (add)
      (def (visit key)
        (unless (hash-key? supported key) (raise (make-failure 'unsupported key)))
        (case (hash-get states key)
          ((done) (void))
          ((active) (raise (make-failure 'cycle key)))
          (else (hash-put! states key 'active)
            (for-each visit (hash-ref reads key))
            (hash-put! states key 'done) (add key))))
      (for-each visit keys)))
  (make-%schedule spec order (lambda (key) (hash-ref reads key))))
