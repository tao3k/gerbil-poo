;;; Bounded rejection sampling and retained source ownership through retries.
(export filter-test-cases! proposal-test-cases! delay-test-cases! resumed-delay-test-cases! composed-delay-test-cases!)
(import :std/test :std/error :std/iter
        (prefix-in :clan/poo/testing/property/generator generator.)
        (prefix-in :clan/poo/testing/property property.))

;; Revise an earlier rejected branch from a later stage. The consumer must never
;; run after that stage returns normally; all composition uses the public algebra.
(def (revising-branch stage revise consume)
  (def base (generator.make-generator (lambda (_random _size)
    (when (eq? stage 'draw) (revise)) 9) generator.integer-shrinks))
  (case stage
    ((draw) (generator.generator-map base consume))
    ((map) (generator.generator-map
      (generator.generator-map base (lambda (value) (revise) value)) consume))
    ((select) (generator.generator-bind base (lambda (value)
      (revise) (generator.generator-map (generator.generator-unit value) consume))))
    ((predicate) (generator.generator-map
      (generator.generator-filter base (lambda (_) (revise) #t) attempts: 1) consume))
    (else (error "unknown rejection stage" stage))))

;; Register ordinary cases in the aggregate :std/test suite; this is not a runner.
(def (filter-test-cases!)
  (test-case "rejected branch sources protect every stage of a later retry"
    (for (stage '(draw map select predicate))
      (def live #t) (def draws 0) (def forbidden 0)
      (def branches (generator.generator-sized (lambda (_size)
        (set! draws (1+ draws))
        (if (= draws 1)
          (generator.make-generator (lambda (_random _size) 0) (lambda (_) []) current?: (lambda () live))
          (revising-branch stage (lambda () (set! live #f))
            (lambda (value) (set! forbidden (1+ forbidden)) value))))))
      (check-exception (generator.generate (generator.generator-filter branches positive? attempts: 2)
        (generator.random-at 17) 5) generator.stale-generation?)
      (check-equal? (list draws forbidden) '(2 0))
      ;; Interrupted dynamic source scope cannot contaminate an unrelated draw.
      (check-equal? (generator.sample-value
        (generator.generate (generator.generator-unit 7) (generator.random-at 17) 5)) 7)))
  (test-case "retry source history retains every rejected branch and exact callback causes"
    (for (retired '(first second))
      (def first #t) (def second #t) (def trial 0) (def forbidden 0)
      (def branches (generator.generator-sized (lambda (_size)
        (set! trial (1+ trial))
        (case trial
          ((1) (generator.make-generator (lambda (_random _size) 0) (lambda (_) []) current?: (lambda () first)))
          ((2) (generator.make-generator (lambda (_random _size) 0) (lambda (_) []) current?: (lambda () second)))
          (else (revising-branch 'draw
            (lambda () (if (eq? retired 'first) (set! first #f) (set! second #f)))
            (lambda (value) (set! forbidden (1+ forbidden)) value)))))))
      (check-exception (generator.generate (generator.generator-filter branches positive? attempts: 3)
        (generator.random-at 3) 8) generator.stale-generation?)
      (check-equal? (list trial forbidden) '(3 0)))
    (def cause (Error "retry callback cause")) (def trial 0) (def live #t)
    (def branches (generator.generator-sized (lambda (_size)
      (set! trial (1+ trial))
      (if (= trial 1)
        (generator.make-generator (lambda (_random _size) 0) (lambda (_) []) current?: (lambda () live))
        (generator.generator-map (generator.generator-unit 2) (lambda (_) (set! live #f) (raise cause)))))))
    (check-eq? (with-catch identity (lambda () (generator.generate
      (generator.generator-filter branches positive? attempts: 2) (generator.random-at 3) 8))) cause)
    (check-equal? trial 2)
    (check-equal? (generator.sample-value
      (generator.generate (generator.generator-unit 3) (generator.random-at 3) 8)) 3))
  (test-case "accepted retries retain shrinking seed replay and retired source refusal"
    (def epoch 0) (def draws 0)
    ;; The local retry schedule resets per invocation; replay therefore repeats
    ;; the same rejection path instead of observing an application-global counter.
    (def (prepare)
      (def stamp epoch)
      (generator.generator-delay (lambda ()
        (def trial 0)
        (generator.generator-filter (generator.generator-sized (lambda (_size)
          (set! trial (1+ trial))
          (generator.make-generator (lambda (_random _size)
            (set! draws (1+ draws)) (if (= trial 1) 0 4)) generator.integer-shrinks
            current?: (if (= trial 1) (lambda () (= stamp epoch)) (lambda () #t)))))
          positive? attempts: 2))))
    (def domain (property.make-specification positive? identity))
    (def report (property.check-property (prepare) (lambda (value) (< value 2)) domain
      seed: 17 cases: 1 shrink-budget: 8))
    (check-equal? (list (property.report-status report) (property.report-original report)
      (property.report-counterexample report) (property.report-attempts report)
      (property.report-steps report) (property.report-minimal? report)) '(failed 4 2 4 1 #t))
    (check-equal? draws 2)
    (check (property.replay-counterexample report) => #f)
    (check-equal? draws 2)
    (def replayed (property.replay-property report))
    (check-equal? (list (property.report-counterexample replayed) (property.report-attempts replayed) draws) '(2 4 4))
    (set! epoch 1)
    (check (property.report-current? report) => #f)
    (check-exception (property.replay-counterexample report) Error?)
    (check-exception (property.replay-property report) Error?)
    (check-eq? (property.report-status (property.check-property (prepare) (lambda (_) #f) domain cases: 1)) 'failed))
  (test-case "nested filters keep exact local quotas and never force rejected child factories"
    (def draws 0) (def shrinks 0) (def sizes [])
    (def base (generator.make-generator (lambda (_random size)
      (set! draws (1+ draws)) (set! sizes (cons size sizes)) (modulo draws 3))
      (lambda (_) (set! shrinks (1+ shrinks)) [])))
    (def inner (generator.generator-filter base zero? attempts: 3))
    (check-exception (generator.generate (generator.generator-filter inner (lambda (_) #f) attempts: 2)
      (generator.random-at 1) 7) generator.generation-exhausted?)
    (check-equal? (list draws shrinks sizes) '(6 0 (7 7 7 7 7 7)))
    (def bad (generator.generator-filter base (lambda (_) 'not-boolean) attempts: 9))
    (check-exception (generator.generate bad (generator.random-at 1) 7) Error?)
    (check-equal? draws 7))
    (test-case "filtered shrink rejections are charged and never transformed"
      (def transformed []) (def evaluated [])
      (def filtered (generator.generator-filter
        (generator.make-generator (lambda (_random _size) 9) (lambda (_) '(0 4 2))) positive?))
      (def mapped (generator.generator-map filtered (lambda (n)
        (when (zero? n) (error "rejected proposal reached mapping"))
        (set! transformed (cons n transformed)) n)))
      (def report (property.check-property mapped (lambda (n) (set! evaluated (cons n evaluated)) #f)
        (property.make-specification positive? identity) cases: 1 shrink-budget: 1))
      (check-equal? (list (property.report-status report) (property.report-attempts report)
        (property.report-counterexample report) (property.report-minimal? report)) '(failed 1 9 #f))
      (check-equal? transformed '(9)) (check-equal? evaluated '(9)))
    (test-case "filter draw exhaustion is bounded and retains rejected source observers"
      (def draws 0)
      (def zeros (generator.make-generator (lambda (_random _size) (set! draws (1+ draws)) 0) (lambda (_) [])))
      (def domain (property.make-specification exact-integer? abs))
      (for (fuel '(0 3))
        (set! draws 0)
        (def result (property.check-property (generator.generator-filter zeros positive? attempts: fuel)
          (lambda (_) (error "exhausted generator reached property")) domain cases: 1))
        (check-equal? (property.report-status result) 'exhausted)
        (check-equal? draws fuel))
      (def epoch 0) (def selected 0)
      (def branches (generator.generator-sized (lambda (_size)
        (def n selected) (set! selected (1+ selected))
        (def stamp epoch)
        (generator.make-generator (lambda (_random _size) n) (lambda (_) [])
          current?: (if (zero? n) (lambda () (= stamp epoch)) (lambda () #t))))))
      (def report (property.check-property (generator.generator-filter branches positive?)
        (lambda (_) #f) domain cases: 1))
      (check-equal? (property.report-status report) 'failed)
      (set! epoch 1)
      (check-exception (property.replay-counterexample report) (lambda (cause) (and (Error? cause) (equal? (Error-message cause) "stale property replay")))))
)


;; Obtain a real filtered tombstone through public lazy-tree protocols. Only its
;; child owns the observer, so the consumer must admit this newly visited leaf.
(def (retained-pruned current)
  (def filtered (generator.generator-filter
    (generator.make-tree-generator (lambda (_random _size)
      (generator.make-sample 2 (lambda ()
        (list (generator.make-sample 1 (lambda () []) current)))))) even?))
  (car (for/collect (child ((generator.sample-children
    (generator.generate filtered (generator.random-at 3) 4)))) child)))

;; Ordinary tests exercise returned-proposal ownership at the exact quota edge.
(def (proposal-test-cases!)
  (test-case "terminal tombstone admission agrees between checking and inspection"
    (for* ((kind '(check inspect)) (budget '(0 1 2)))
      (def live #t) (def pulls 0) (def properties 0) (def measures 0)
      (def pruned (retained-pruned (lambda () live)))
      (def producer (generator.make-tree-generator (lambda (_random _size)
        (generator.make-sample 2 (lambda () (in-coroutine (lambda (yield)
          (set! pulls (1+ pulls)) (set! live #f) (yield pruned)
          (error "stale suffix resumed"))))))))
      (def domain (property.make-specification exact-integer?
        (lambda (value) (set! measures (1+ measures)) (abs value))))
      (case kind
        ((check)
         (let (report (property.check-property producer (lambda (_) (set! properties (1+ properties)) #f)
           domain cases: 1 shrink-budget: budget))
         (check-eq? (property.report-status report) (if (zero? budget) 'failed 'stale))
         (check-equal? (property.report-attempts report) (if (zero? budget) 0 1))
         (check-equal? (property.report-counterexample report) 2)
         (check-equal? (property.report-steps report) 0)
         (check (property.report-minimal? report) => #f)
         (check (property.report-current? report) => (zero? budget))
         (check-equal? (list properties measures) '(1 0))))
        ((inspect)
         (let (report (property.inspect-generator producer domain count: 1 depth: 1 proposal-budget: budget))
         (check-eq? (property.inspection-status report) (if (zero? budget) 'complete 'stale))
         (check-equal? (property.inspection-attempts report) (if (zero? budget) 0 1))
         (check (property.inspection-current? report) => (zero? budget))
         (check-equal? (length (property.inspection-events report)) 1)
         (check-equal? (list properties measures) '(0 1)))))
      (check-equal? pulls (if (zero? budget) 0 1))))
  (test-case "live pruning preserves exact quota EOF and confirmed smaller witnesses"
    (for (kind '(quota eof smaller))
      (def live #t) (def pulls 0) (def calls 0) (def measures 0)
      (def pruned (retained-pruned (lambda () live)))
      (def producer (generator.make-tree-generator (lambda (_random _size)
        (generator.make-sample 2 (lambda () (in-coroutine (lambda (yield)
          (set! pulls (1+ pulls)) (yield pruned) (set! pulls (1+ pulls))
          (when (eq? kind 'smaller) (yield (generator.make-sample 0 (lambda () [])))))))))))
      (def report (property.check-property producer (lambda (_) (set! calls (1+ calls)) #f)
        (property.make-specification exact-integer? (lambda (value) (set! measures (1+ measures)) (abs value)))
        cases: 1 shrink-budget: (if (eq? kind 'quota) 1 3)))
      (check-eq? (property.report-status report) 'failed)
      (check-equal? (property.report-attempts report) (if (eq? kind 'smaller) 2 1))
      (check (property.report-minimal? report) => (not (eq? kind 'quota)))
      (check-equal? (property.report-counterexample report) (if (eq? kind 'smaller) 0 2))
      (check-equal? calls (if (eq? kind 'smaller) 2 1))
      (check-equal? measures (if (eq? kind 'smaller) 2 0))
      (check-equal? pulls (if (eq? kind 'quota) 1 2))
      (set! live #f)
      (check (property.report-current? report) => #f)
      (check-exception (property.replay-counterexample report) Error?)))
  (test-case "proposal observer and iterator errors keep their causes and charges"
    (for (kind '(observer boolean iterator suffix))
      (def armed #f) (def cause (cons 'proposal kind)) (def calls 0)
      ;; Source callbacks are pure; arming happens in the iterator, not observer.
      (def (current)
        (cond ((not armed) #t) ((eq? kind 'observer) (raise cause))
          ((eq? kind 'boolean) 'invalid) (else #t)))
      (def pruned (retained-pruned current))
      (def producer (generator.make-tree-generator (lambda (_random _size)
        (generator.make-sample 2 (lambda () (in-coroutine (lambda (yield)
          (set! armed #t)
          (when (eq? kind 'iterator) (raise cause))
          (yield pruned)
          (if (eq? kind 'suffix) (raise cause) (error "refused source resumed")))))))))
      (def report (property.check-property producer (lambda (_) (set! calls (1+ calls)) #f)
        (property.make-specification exact-integer? abs) cases: 1 shrink-budget: 2))
      (check-eq? (property.report-status report) 'error)
      (check-equal? (property.report-attempts report) (if (eq? kind 'iterator) 0 1))
      (check-equal? (property.report-counterexample report) 2)
      (check-equal? calls 1)
      (if (eq? kind 'boolean) (check (Error? (property.report-cause report)) => #t)
        (check-eq? (property.report-cause report) cause))))
  (test-case "new stale leaves cannot hide behind earlier live pruned proposals"
    (for (stale? '(#f #t))
      (def first-live #t) (def second-live #t) (def pulls 0)
      (def first (retained-pruned (lambda () first-live)))
      (def second (retained-pruned (lambda () second-live)))
      (def producer (generator.make-tree-generator (lambda (_random _size)
        (generator.make-sample 2 (lambda () (in-coroutine (lambda (yield)
          (set! pulls (1+ pulls)) (yield first)
          (set! pulls (1+ pulls)) (set! second-live (not stale?)) (yield second)
          (error "quota suffix resumed"))))))))
      (def report (property.check-property producer (lambda (_) #f)
        (property.make-specification exact-integer? abs) cases: 1 shrink-budget: 2))
      (check-eq? (property.report-status report) (if stale? 'stale 'failed))
      (check-equal? (property.report-attempts report) 2)
      (check-equal? pulls 2)
      (check-equal? (property.report-counterexample report) 2)
      (check (property.report-current? report) => (not stale?))
      (set! first-live #f)
      (check (property.report-current? report) => #f))))

;; A parent reduction selects a previously unused delayed branch. Its constructor
;; belongs to the outer delay even when the retained tree is consumed later.
(def (dependent-delay depth force (current (lambda () #t)))
  (generator.generator-delay (lambda ()
    (generator.generator-bind
      (generator.make-generator (lambda (_random _size) 1) generator.integer-shrinks)
      (lambda (value) (if (positive? value) (generator.generator-unit value)
        (generator.generator-delay (lambda () (force) (generator.generator-unit value)) depth: 1)))))
    depth: depth current?: current))

;; Register controls in the same standard suite and independent library build.
(def (delay-test-cases!)
  (test-case "retained dependency shrinking cannot renew exhausted delay depth"
    (def forces 0)
    (def generation (dependent-delay 1 (lambda () (set! forces (1+ forces)))))
    (def domain (property.make-specification exact-integer? abs))
    (def report (property.check-property generation (lambda (_) #f) domain cases: 1 shrink-budget: 8))
    (check-equal? (list (property.report-status report) (property.report-counterexample report)
      (property.report-attempts report) (property.report-steps report) (property.report-minimal? report))
      '(exhausted 1 0 0 #f))
    (check (generator.generation-exhausted? (property.report-cause report)) => #t)
    (check-equal? forces 0)
    (check-eq? (property.report-status (property.replay-property report)) 'exhausted)
    (check-exception (property.replay-counterexample report) Error?)
    (let (inspection (property.inspect-generator generation domain count: 1 depth: 1 proposal-budget: 1))
      (check-eq? (property.inspection-status inspection) 'exhausted)
      (check-equal? (property.inspection-attempts inspection) 0))
    (check-equal? forces 0))
  (test-case "sufficient retained delay depth preserves reduction and both replay modes"
    (def forces 0)
    (def generation (dependent-delay 2 (lambda () (set! forces (1+ forces)))))
    (def report (property.check-property generation (lambda (_) #f)
      (property.make-specification exact-integer? abs) seed: 17 cases: 1 shrink-budget: 8))
    (check-equal? (list (property.report-status report) (property.report-counterexample report)
      (property.report-attempts report) (property.report-steps report) (property.report-minimal? report))
      '(failed 0 1 1 #t))
    (check-equal? forces 1)
    (check-equal? (property.report-counterexample (property.replay-property report)) 0)
    (check (property.replay-counterexample report) => #f)
    (check-equal? forces 2))
  (test-case "a stricter consuming delay remains owned by further retained descendants"
    (def forces 0)
    ;; Two later constructors need two credits; the consuming scope supplies one.
    (def generation (generator.generator-delay (lambda ()
      (generator.generator-bind
        (generator.make-generator (lambda (_r _s) 2) (lambda (v) (if (positive? v) (list (1- v)) [])))
        (lambda (value) (if (positive? value) (generator.generator-unit value)
          (generator.generator-delay (lambda () (set! forces (1+ forces))
            (generator.generator-delay (lambda () (set! forces (1+ forces))
              (generator.generator-unit 0)) depth: 2)) depth: 2))))) depth: 4))
    (def root (generator.generate generation (generator.random-at 17) 0))
    (def ambient (generator.generator-delay (lambda ()
      (generator.generator-unit (car (for/collect (child ((generator.sample-children root))) child)))) depth: 2))
    (def smaller (generator.sample-value (generator.generate ambient (generator.random-at 17) 0)))
    (check-equal? (generator.sample-value smaller) 1)
    (check-exception (for/collect (child ((generator.sample-children smaller))) child) generator.generation-exhausted?)
    (check-equal? forces 1))
  (test-case "delay restoration retains source and raw-cause precedence and unwinds"
    (def live #t) (def forces 0)
    (def generation (dependent-delay 1 (lambda () (set! forces (1+ forces))) (lambda () live)))
    (def root (generator.generate generation (generator.random-at 17) 0))
    (set! live #f)
    (check-exception (for/collect (child ((generator.sample-children root))) child) generator.stale-generation?)
    (check-equal? forces 0)
    (for (cause (list #f (cons 'constructor 'cause)))
      (let* ((source (dependent-delay 2 (lambda () (raise cause))))
             (tree (generator.generate source (generator.random-at 17) 0)))
        (check-eq? (with-catch values (lambda ()
          (for/collect (child ((generator.sample-children tree))) child) 'unexpected)) cause)
        (check-equal? (generator.sample-value (generator.generate
          (generator.generator-delay (lambda () (generator.generator-unit 9)) depth: 1)
          (generator.random-at 17) 0)) 9))))
  (test-case "unbounded dependency roots retain fresh independent delayed children"
    (def forces 0)
    (def generation (generator.generator-bind
      (generator.make-generator (lambda (_r _s) 1) generator.integer-shrinks)
      (lambda (value) (if (positive? value) (generator.generator-unit value)
        (generator.generator-delay (lambda () (set! forces (1+ forces))
          (generator.generator-unit 0)) depth: 1)))))
    (def root (generator.generate generation (generator.random-at 17) 0))
    (check-equal? (for/collect (child ((generator.sample-children root))) (generator.sample-value child)) '(0))
    (check-equal? forces 1)))

;; Two parent candidates suspend the official coroutine before selecting a
;; delayed branch. The source remains owned by the outer delayed producer.
(def (paused-delay force current)
  (generator.generator-delay (lambda ()
    (generator.generator-bind
      (generator.make-generator (lambda (_r _s) 3)
        (lambda (value) (if (= value 3) '(2 1) [])))
      (lambda (value) (if (= value 1)
        (generator.generator-delay (lambda () (force) (generator.generator-unit 0)) depth: 1)
        (generator.generator-unit value))))) depth: 4 current?: current))

;; Enter a caller's declared delay scope without replacing the child iterator.
(def (delay-demand depth demand)
  (generator.sample-value (generator.generate
    (generator.generator-delay (lambda () (generator.generator-unit (demand))) depth: depth)
    (generator.random-at 17) 0)))

;; Catch around the entire coroutine lifetime: the standard iterator retains
;; its first handler as well as its producer continuation across suspension.
;; Pull before asserting: a check form installs its own narrower handler.
(def (resumed-delay-test-cases!)
  (test-case "paused dependency cursor obeys each incoming tighter delay scope"
    (for (first-depth '(#f 4))
      (def forces 0)
      (def root (generator.generate (paused-delay (lambda () (set! forces (1+ forces)))
        (lambda () #t)) (generator.random-at 17) 0))
      (def cause (with-catch values (lambda ()
        (using (cursor (iter ((generator.sample-children root))) :- Iterator)
          (def first (if first-depth (delay-demand first-depth (lambda () (cursor.next!))) (cursor.next!)))
          (check-equal? (generator.sample-value first) 2)
          (delay-demand 1 (lambda () (cursor.next!)))
          'unexpected))))
      (check (generator.generation-exhausted? cause) => #t)
      (check-equal? forces 0)))
  (test-case "paused dependency cursor delegates values and EOF exactly once"
    (def forces 0)
    (def root (generator.generate (paused-delay (lambda () (set! forces (1+ forces)))
      (lambda () #t)) (generator.random-at 17) 0))
    (using (cursor (iter ((generator.sample-children root))) :- Iterator)
      (def first (cursor.next!))
      (check-equal? (generator.sample-value first) 2)
      (check-equal? (generator.sample-value (delay-demand 2 (lambda () (cursor.next!)))) 0)
      (check (eof-object? (cursor.next!)) => #t))
    (check-equal? forces 1))
  (test-case "paused dependency cursor preserves raw constructor causes"
    (for (cause (list #f (cons 'constructor 'cause)))
      (def forces 0)
      (def root (generator.generate (paused-delay (lambda () (set! forces (1+ forces)) (raise cause))
        (lambda () #t)) (generator.random-at 17) 0))
      (check-eq? (with-catch values (lambda ()
        (using (cursor (iter ((generator.sample-children root))) :- Iterator)
          (def first (cursor.next!))
          (check-equal? (generator.sample-value first) 2)
          (delay-demand 2 (lambda () (cursor.next!))) 'unexpected))) cause)
      (check-equal? forces 1)))
  (test-case "source retirement precedes resumed exhaustion and fresh scopes recover"
    (def live #t) (def forces 0)
    (def root (generator.generate (paused-delay (lambda () (set! forces (1+ forces)))
      (lambda () live)) (generator.random-at 17) 0))
    (def cause (with-catch values (lambda ()
      (using (cursor (iter ((generator.sample-children root))) :- Iterator)
        (def first (cursor.next!))
        (check-equal? (generator.sample-value first) 2)
        (set! live #f)
        (delay-demand 1 (lambda () (cursor.next!))) 'unexpected))))
    (check (generator.stale-generation? cause) => #t)
    (check-equal? forces 0)
    (check-equal? (delay-demand 1 (lambda () 9)) 9)))

;; Compose the same dependency through each callback-bearing sample boundary.
;; The policy case supplies a standard lazy Iterator, not an alternate runner.
(def (composed-delay mode force current)
  (def source (paused-delay force current))
  (case mode
    ((map) (generator.generator-map source (lambda (value) (+ value 10))))
    ((filter) (generator.generator-filter source (lambda (_) #t)))
    ((product) (generator.make-tree-generator (lambda (random size)
      (generator.sample-sequence (list (generator.generate source random size)) car min-length: 1))))
    ((function) (generator.generator-function '((probe)) (generator.generator-map source list)))
    ((policy) (generator.generator-with-shrink source (lambda (_)
      (in-coroutine (lambda (yield)
        (yield 2)
        (yield (generator.sample-value (generator.generate
          (generator.generator-delay (lambda () (force) (generator.generator-unit 0)) depth: 1)
          (generator.random-at 17) 0))))))))))

;; Observe explicit carrier shapes without widening a descriptor or redrawing it.
(def (composed-delay-value mode value)
  (case mode ((map) (- value 10))
    ((function) (car (generator.function-apply value '(probe))))
    (else value)))

;; All pulls share the enclosing handler; assertions inspect already read values.
(def (composed-delay-test-cases!)
  (test-case "outer sample composition cannot erase a resumed caller allowance"
    (for (mode '(map filter product function policy))
      (def forces 0)
      (def root (generator.generate (composed-delay mode (lambda () (set! forces (1+ forces)))
        (lambda () #t)) (generator.random-at 17) 0))
      (def cause (with-catch values (lambda ()
        (using (cursor (iter ((generator.sample-children root))) :- Iterator)
          (def first (cursor.next!))
          (check-equal? (composed-delay-value mode (generator.sample-value first)) 2)
          (delay-demand 1 (lambda () (cursor.next!))) 'unexpected))))
      (check (generator.generation-exhausted? cause) => #t)
      (check-equal? forces 0)))
  (test-case "outer sample composition preserves sufficient credits order and EOF"
    (for (mode '(map filter product function policy))
      (def forces 0)
      (def root (generator.generate (composed-delay mode (lambda () (set! forces (1+ forces)))
        (lambda () #t)) (generator.random-at 17) 0))
      (using (cursor (iter ((generator.sample-children root))) :- Iterator)
        (def first (cursor.next!))
        (check-equal? (composed-delay-value mode (generator.sample-value first)) 2)
        (def second (delay-demand 2 (lambda () (cursor.next!))))
        (check-equal? (composed-delay-value mode (generator.sample-value second)) 0)
        (check (eof-object? (cursor.next!)) => #t))
      (check-equal? forces 1)))
  (test-case "outer sample composition retains exact resumed constructor causes"
    (for* ((mode '(map filter product function policy)) (cause (list #f (cons 'force 'cause))))
      (def root (generator.generate (composed-delay mode (lambda () (raise cause))
        (lambda () #t)) (generator.random-at 17) 0))
      (check-eq? (with-catch values (lambda ()
        (using (cursor (iter ((generator.sample-children root))) :- Iterator)
          (def first (cursor.next!))
          (check-equal? (composed-delay-value mode (generator.sample-value first)) 2)
          (delay-demand 2 (lambda () (cursor.next!))) 'unexpected))) cause)))
  (test-case "outer sample composition admits sources before resumed exhaustion"
    (for (mode '(map filter product function policy))
      (def live #t) (def forces 0)
      (def root (generator.generate (composed-delay mode (lambda () (set! forces (1+ forces)))
        (lambda () live)) (generator.random-at 17) 0))
      (def cause (with-catch values (lambda ()
        (using (cursor (iter ((generator.sample-children root))) :- Iterator)
          (def first (cursor.next!))
          (check-equal? (composed-delay-value mode (generator.sample-value first)) 2)
          (set! live #f)
          (delay-demand 1 (lambda () (cursor.next!))) 'unexpected))))
      (check (generator.stale-generation? cause) => #t)
      (check-equal? forces 0)))
  (test-case "composed delay trees retain zero-budget laziness and both replay forms"
    (for (mode '(map filter product function policy))
      (def forces 0)
      (def source (composed-delay mode (lambda () (set! forces (1+ forces))) (lambda () #t)))
      (def domain (property.make-specification
        (if (eq? mode 'function) generator.function-value? exact-integer?)
        (lambda (value) (abs (composed-delay-value mode value)))))
      (def zero (property.check-property source (lambda (_) #f) domain cases: 1 shrink-budget: 0))
      (check-equal? (property.report-attempts zero) 0)
      (check-equal? forces 0)
      (def reduced (property.check-property source (lambda (_) #f) domain seed: 17 cases: 1 shrink-budget: 16))
      (check-eq? (property.report-status reduced) 'failed)
      ;; Greedy descent keeps the first leaf; it does not search abandoned siblings.
      ;; Only the replacement policy supplies descendants beneath candidate two.
      (def expected (if (eq? mode 'policy) 0 2))
      (check-equal? (composed-delay-value mode (property.report-counterexample reduced)) expected)
      (check (property.replay-counterexample reduced) => #f)
      (check-equal? (composed-delay-value mode (property.report-counterexample
        (property.replay-property reduced))) expected))))
