          current?: (lambda () (= stamp (hash-ref epochs choice 0)))))))
      (def report (property.check-property dependent
        (lambda (choice)
          (cond ((not first) (set! first choice))
                ((not (= first choice)) (hash-put! epochs first 1) (set! changed? #t))) #t)
        (property.make-specification exact-integer? abs) seed: 41 cases: 20))
      (check changed? => #t)
      (check-equal? (property.report-status report) 'stale)
      (check-exception (property.replay-property report) (message? "stale property replay")))
    (test-case "interrupted shrinking preserves confirmed progress across callback boundaries"
      (for (stage '(children iterator admission measure property observer))
        (def cause (Error (symbol->string stage)))
        (def observer-failed? #f)
        ;; Each run first confirms 9 -> 8, then fails at one later boundary.
        (def source (generator.make-generator (lambda (_random _size) 9)
          (lambda (value)
            (cond ((= value 9) [8])
                  ((eq? stage 'children) (raise cause))
                  ((eq? stage 'iterator)
                    (in-coroutine (lambda (yield) (yield 8) (raise cause))))
                  (else '(8 7))))
          current?: (lambda () (if observer-failed? (raise cause) #t))))
        ;; Admission and measure failures belong to the charged proposal, never
        ;; to a newly confirmed counterexample.
        (def domain (property.make-specification
          (lambda (value) (when (and (eq? stage 'admission) (= value 7)) (raise cause)) (exact-integer? value))
          (lambda (value) (when (and (eq? stage 'measure) (= value 7)) (raise cause)) (abs value))))
        (def report (property.check-property source
          (lambda (value)
            (when (= value 7)
              (if (eq? stage 'observer) (set! observer-failed? #t) (raise cause))) #f)
          domain cases: 1 shrink-budget: 8))
        (check-equal? (property.report-status report) 'error)
        (check (eq? (property.report-cause report) cause) => #t)
        (check-equal? (list (property.report-original report) (property.report-counterexample report)
          (property.report-attempts report) (property.report-steps report) (property.report-minimal? report))
          (list 9 8 (case stage ((children) 1) ((iterator) 2) (else 3)) 1 #f))
        (check-exception (property.replay-counterexample report) (message? "failed property report required"))
        ;; Stable sources replay the same interruption, cause and charged work.
        (unless (eq? stage 'observer)
          (let (again (property.replay-property report))
          (check-equal? (property.report-status again) 'error)
          (check (eq? (property.report-cause again) cause) => #t)
          (check-equal? (property.report-counterexample again) 8)
          (check-equal? (property.report-attempts again) (property.report-attempts report))))))
    (test-case "stale interruption retains work without promoting the pending proposal"
      (def epoch 0) (def cause (Error "retired specification"))
      (def source (generator.make-generator (lambda (_random _size) 9)
        (lambda (value) (if (= value 9) [8] '(8 7))) current?: (lambda () (= epoch 0))))
      (def report (property.check-property source
        (lambda (value) (when (= value 7) (set! epoch 1) (raise cause)) #f)
        (property.make-specification exact-integer? abs) cases: 1 shrink-budget: 8))
      (check-equal? (list (property.report-status report) (property.report-counterexample report)
        (property.report-attempts report) (property.report-steps report) (property.report-minimal? report))
        '(stale 8 3 1 #f))
      (check (eq? (property.report-cause report) cause) => #t)
      (check-exception (property.replay-property report) (message? "stale property replay")))
)

;; Normalized trace preparation, model execution and cleanup cases.
(def (trace-model-test-cases!)
    (test-case "normalized callback commands survive dependency shrinking and both replays"
      (def normalized []) (def wraps 0) (def opened 0) (def closed 0)
      ;; Both raw and repaired commands belong to this finite command language.
      (def (command? value)
        (and (vector? value) (memv (vector-length value) '(3 4))
          (memq (vector-ref value 0) '(open use))
          (exact-integer? (vector-ref value 1)) (>= (vector-ref value 1) 0)
          (procedure? (vector-ref value 2)) #t))
      ;; Normalization installs a contract-bearing callback once at preparation.
      (def (normalize raw)
        (set! wraps (1+ wraps))
        (def action (vector-ref raw 2))
        (def checked (vector (vector-ref raw 0) (vector-ref raw 1)
          (lambda (argument)
            (using (argument : :fixnum)
              (using (result (action argument) : :fixnum) result))) 'checked))
        (set! normalized (cons checked normalized)) checked)
      ;; Logical producer dependencies are independent of the actual fixture.
      (def (enabled state command)
        (def present (and (memv (vector-ref command 1) state) #t))
        (if (eq? (vector-ref command 0) 'open) (not present) present))
      ;; The oracle does not invoke the actual callback to compute its reply.
      (def (advance state command)
        (def id (vector-ref command 1))
        (if (eq? (vector-ref command 0) 'open)
          (values (cons id state) id) (values state (* id 2))))
      (def reference (model.make-model (lambda () []) enabled advance identity command? normalize))
      ;; Every observation owns a fresh fixture and checks the prepared identity.
      (def (fixture fault?)
        (lambda (use)
          (set! opened (1+ opened))
          (try (use (model.make-system [] (lambda (state command)
            (unless (memq command normalized) (error "unprepared command reached fixture"))
            (def id (vector-ref command 1))
            (if (eq? (vector-ref command 0) 'open) (values (cons id state) id)
              (values state (+ ((vector-ref command 2) id) (if (and fault? (= id 2)) 1 0))))) identity))
            (finally (set! closed (1+ closed))))))
      (def action (lambda (id) (* id 2)))
      (def commands (list (vector 'open 1 action) (vector 'open 2 action)
        (vector 'use 1 action) (vector 'use 2 action) (vector 'use 2 action)))
      (check (model.trace-report-matched? (model.check-trace reference commands (fixture #f))) => #t)
      (check-equal? wraps (length commands))
      (def mismatch (model.check-trace reference commands (fixture #t)))
      (check-equal? (model.trace-report-index mismatch) 3)
      (check (memq (model.trace-report-command mismatch) normalized) ? pair?)
      ;; Deletions reuse dependency repair; no consumer survives its producer.
      (def source (generator.make-generator (lambda (_random _size) commands)
        (cut model.shrink-trace reference <> (lambda (_) []))))
      (def report (property.check-property source
        (lambda (trace) (model.trace-report-matched? (model.check-trace reference trace (fixture #t))))
        (property.make-specification (lambda (trace) (and (list? trace) (every command? trace))) length)
        seed: 17 cases: 1 shrink-budget: 48))
      (check-equal? (property.report-status report) 'failed)
      (check-equal? (map (cut vector-ref <> 0) (property.report-counterexample report)) '(open use))
      (check-equal? (map (cut vector-ref <> 1) (property.report-counterexample report)) '(2 2))
      (check (property.replay-counterexample report) => #f)
      (check-equal? (property.report-status (property.replay-property report)) 'failed)
      (check-equal? opened closed))
    (test-case "complete normalization failure refuses before fixture effects"
      (def opened 0)
      (def cause (Error "normalization refused"))
      ;; A non-identity decoder changes the actual commands being admitted.
      (def reference (model.make-model (lambda () 0) (lambda (_state command) (<= command 3))
        (lambda (state command) (values (+ state command) command)) identity exact-integer?
        (lambda (raw) (if (< raw 0) (raise cause) (1+ raw)))))
      ;; Opening is observable and forbidden for ANY rejected complete prefix.
      (def (fixture use)
        (set! opened (1+ opened))
        (use (model.make-system 0 (lambda (state command) (values (+ state command) command)) identity)))
      (check-exception (model.check-trace reference '(0 1 9) fixture) (message? "invalid command trace"))
      (check-exception (model.check-trace reference '(0 -1) fixture) (cut eq? <> cause))
      (check-exception (model.check-trace reference '(0 invalid) fixture) (message? "invalid command trace"))
      (check-equal? opened 0)
      (check (model.trace-report-matched? (model.check-trace reference [] fixture)) => #t)
      (check-equal? opened 1))
    (test-case "block trace shrinking crosses a single-deletion barrier without orphan consumers"
      (def commands '(noise noise open use))
      ;; Opening is a producer; use cannot survive its deletion. Noise parity
      ;; exposes a fault that disappears if exactly one noise command is removed.
      (def (enabled state command) (case command
        ((open) (not (car state))) ((use) (car state)) (else #t)))
      (def (step state command)
        (values (case command ((open) (cons #t (cdr state)))
          ((noise) (cons (car state) (1+ (cdr state)))) (else state)) #t))
      (def reference (model.make-model (lambda () (cons #f 0)) enabled step identity
        (lambda (command) (and (memq command '(noise open use)) #t)) identity))
      (def opened 0) (def closed 0) (def draws 0)
      (def (fixture use)
        (set! opened (1+ opened))
        (try (use (model.make-system (cons #f 0)
          (lambda (state command)
            (let-values (((next reply) (step state command)))
              (values next (if (and (eq? command 'use) (even? (cdr state))) #f reply)))) identity))
          (finally (set! closed (1+ closed)))))
      (def (correct? trace) (model.trace-report-matched? (model.check-trace reference trace fixture)))
      (def specification (property.make-specification (cut model.valid-trace? reference <>) length))
      (def (source shrink)
        (generator.make-generator (lambda (_random _size) (set! draws (1+ draws)) commands) shrink))
      (def single (property.check-property (source (lambda (trace)
          (for/collect (index (in-range (length trace)))
            (model.repair-trace reference (append (take trace index) (drop trace (1+ index)))))))
        correct? specification cases: 1))
      (check-equal? (property.report-counterexample single) commands)
      (def report (property.check-property
        (source (cut model.shrink-trace reference <> (lambda (_) [])))
        correct? specification cases: 1 shrink-budget: 32))
      (check-equal? (property.report-counterexample report) '(open use))
      (check (property.report-minimal? report) => #t)
      (check-equal? draws 2)
      (check-eq? (property.replay-counterexample report) #f)
      (same-failure report (property.replay-property report))
      (check-equal? draws 3)
      (check-equal? opened closed)
      (for (candidate (model.shrink-trace reference commands (lambda (_) [])))
        (check (model.valid-trace? reference candidate) => #t)))
    (test-case "trace parameter proposals share repair and retain exact preparation errors"
      (def cause (Error "command shrink interrupted"))
      (def reference (model.make-model (lambda () #f)
        (lambda (opened command) (or (eq? command 'open) opened))
        (lambda (opened command) (values (or opened (eq? command 'open)) #t)) identity symbol? identity))
      (check-equal? (model.shrink-trace reference '(open use)
        (lambda (command) (if (eq? command 'open) '(skip) []))) '(() () (open) ()))
      (check-exception (model.shrink-trace reference '(open use) (lambda (_) (raise cause)))
        (lambda (found) (eq? cause found))))
    (test-case "generic model traces preserve dependencies and stop at the first wrong reply"
      (def commands '(#(open 1) #(open 2) #(use 1) #(use 2) #(use 1)))
      (def calls 0) (def closed 0)
      (def (command? value)
        (and (vector? value) (= (vector-length value) 2)
          (memq (vector-ref value 0) '(open use)) (exact-integer? (vector-ref value 1)) #t))
      (def (enabled state command)
        (case (vector-ref command 0)
          ((open) (not (memv (vector-ref command 1) state)))
          (else (and (memv (vector-ref command 1) state) #t))))
      (def (step state command)
        (values (if (eq? (vector-ref command 0) 'open) (cons (vector-ref command 1) state) state) #t))
      (def model (model.make-model (lambda () []) enabled step identity command? identity))
      (check (model.valid-trace? model commands) => #t)
      (check-equal? (model.repair-trace model '(#(open 2) #(use 1) #(use 2))) '(#(open 2) #(use 2)))
      (def report (model.check-trace model commands (lambda (use)
        (try (use (model.make-system [] (lambda (state command)
          (set! calls (1+ calls))
          (when (> calls 4) (error "executed past first mismatch"))
          (let-values (((next reply) (step state command)))
            (values next (if (equal? command #(use 2)) #f reply)))) identity))
          (finally (set! closed (1+ closed)))))))
      (check (model.trace-report-matched? report) => #f)
      (check-equal? (list (model.trace-report-phase report) (model.trace-report-index report) calls closed)
        '(result 3 4 1)))
