;;; Named contiguous registration groups; same module and standard suite collector.

;; Policy, finite choice and finite hash-domain cases, in their original order.
(def (policy-domain-test-cases!)
    (test-case "shrink policy revisions stop before the property and retain the last witness"
      (for (allowed '(#t #f))
        (let ((current #t) (calls []) (labels 0))
          (def specification (property.make-specification exact-integer? abs current?: (lambda () current)))
          (def policy (property.make-policy precondition: (lambda (value)
            (if (zero? value) (begin (set! current #f) allowed) #t))
            labels: (lambda (_) (set! labels (1+ labels)) '(root))))
          (def report (property.check-property
            (generator.make-generator (lambda (_random _size) 9) (lambda (_) '(0)))
            (lambda (value) (set! calls (cons value calls)) #f) specification policy: policy cases: 1))
          (check-eq? (property.report-status report) 'stale)
          (check-equal? calls '(9))
          (check-equal? labels 1)
          (check-equal? (property.report-counterexample report) 9)
          (check-equal? (property.report-attempts report) 1)
          (check-equal? (property.report-steps report) 0)
          (check (property.report-minimal? report) => #f)
          (check-exception (property.replay-property report) Error?))))
    (test-case "policy callback errors retain their cause after a source revision"
      (def current #t) (def cause (Error "policy interrupted")) (def calls 0)
      (def report (property.check-property
        (generator.make-generator (lambda (_random _size) 9) (lambda (_) '(0)))
        (lambda (_) (set! calls (1+ calls)) #f)
        (property.make-specification exact-integer? abs current?: (lambda () current)) cases: 1
        policy: (property.make-policy precondition: (lambda (value)
          (if (zero? value) (begin (set! current #f) (raise cause)) #t)))))
      (check-eq? (property.report-status report) 'stale)
      (check-eq? (property.report-cause report) cause)
      (check-equal? calls 1)
      (check-equal? (property.report-counterexample report) 9))
    (test-case "stable product policies retain exclusions coverage and seeded replay"
      (def calls []) (def labels 0)
      (def domain (property.make-product-specification
        (list (property.make-specification exact-integer? abs) (property.make-specification exact-integer? abs))))
      (def generation (generator.make-generator (lambda (_random _size) '(9 2))
        (lambda (_) '((0 2) (1 2)))))
      (def policy (property.make-policy precondition: (lambda (row) (> (car row) 0))
        labels: (lambda (_) (set! labels (1+ labels)) '(root))))
      (def report (property.check-property generation (lambda (row) (set! calls (cons row calls)) #f)
        domain policy: policy cases: 1))
      (check-eq? (property.report-status report) 'failed)
      (check-equal? (property.report-counterexample report) '(1 2))
      (check-equal? calls '((1 2) (9 2)))
      (check-equal? labels 1)
      (check-equal? (property.report-accepted report) 1)
      (check-equal? (property.report-discarded report) 0)
      (check-eq? (property.replay-counterexample report) #f)
      (same-failure report (property.replay-property report)))
    (test-case "finite choices capture declared positions including false and equal payloads"
      (check-exception (generator.generator-elements []) Error?)
      (check-exception (generator.generator-elements '(a . b)) Error?)
      (def choices (list #f 'read 'write 'admin))
      (def generation (generator.generator-elements choices))
      (set-car! choices 'changed) (set-cdr! choices [])
      (def draws 0)
      (def root (generator.generate generation (lambda (bound) (set! draws (1+ draws)) (1- bound)) 0))
      (check-eq? (generator.sample-value root) 'admin)
      (check-equal? (for/collect (child ((generator.sample-children root))) (generator.sample-value child))
        '(#f read write))
      (check-equal? draws 1)
      (def first (string-copy "same")) (def second (string-copy "same"))
      (def duplicate (generator.generate (generator.generator-elements (list first second)) (lambda (_) 1) 0))
      (check-eq? (generator.sample-value duplicate) second)
      (check-eq? (car (for/collect (child ((generator.sample-children duplicate))) (generator.sample-value child))) first))
    (test-case "finite choice source refusal survives retained nodes and exact callback failures"
      (def current #t)
      (def generation (generator.generator-elements '(read write admin) current?: (lambda () current)))
      (def root (generator.generate generation (lambda (_) 2) 0))
      (def child (car (for/collect (child ((generator.sample-children root))) child)))
      (set! current #f)
      (check-exception (generator.generate generation (lambda (_) (error "stale draw ran")) 0) generator.stale-generation?)
      (check-exception (for/collect (node ((generator.sample-children child))) node) generator.stale-generation?)
      (def cause (Error "finite draw"))
      (check-exception (generator.generate (generator.generator-elements '(read write))
        (lambda (_) (raise cause)) 0) (lambda (found) (eq? cause found))))
    (test-case "finite choices shrink to a declared failing boundary and replay without draws"
      (def domain (property.make-specification (lambda (value) (and (memq value '(read write admin)) #t))
        (lambda (value) (case value ((read) 0) ((write) 1) ((admin) 2)))))
      (def draws 0)
      (def generation (generator.generator-map (generator.generator-elements '(read write admin))
        (lambda (value) (set! draws (1+ draws)) value)))
      (def report (property.check-property generation (lambda (value) (eq? value 'read)) domain
        seed: 42 cases: 30 size: 0 shrink-budget: 20))
      (check-eq? (property.report-status report) 'failed)
      (check-eq? (property.report-counterexample report) 'write)
      (check (property.report-minimal? report) => #t)
      (let (before draws)
        (check-eq? (property.replay-counterexample report) #f)
        (check-equal? draws before))
      (same-failure report (property.replay-property report)))
    (test-case "finite hash domains reject collisions and detach caller key spines"
      (def draws 0)
      (def values (generator.make-generator (lambda (_random _size) (set! draws (1+ draws)) #f) (lambda (_) [])))
      (check-exception (generator.generator-hash (list (string-copy "a") (string-copy "a")) values) Error?)
      (check-exception (generator.generator-hash '(a b) values domain-limit: 1) Error?)
      (check-exception (generator.generator-hash '(a) values domain-limit: -1) Error?)
      (check-equal? draws 0)
      (let* ((keys (list 'a 'b 'c)) (generation (generator.generator-hash keys values)))
        (set-car! keys 'changed) (set-cdr! keys [])
        (let (table (generator.sample-value (generator.generate generation (lambda (_) 0) 3)))
          (check-equal? (hash-length table) 3)
          (check-equal? draws 3)
          (for (key '(a b c)) (check (hash-key? table key) => #t) (check-eq? (hash-ref table key) #f))
          (check (hash-key? table 'changed) => #f))))
    (test-case "finite hash size bounds skip absent value producers and own fresh tables"
      (for (size '(0 1 2 9))
        (let* ((draws 0) (values (generator.make-generator
                 (lambda (_random _size) (set! draws (1+ draws)) 4) generator.integer-shrinks))
               (generation (generator.generator-hash '(a b c) values))
               (left (generator.sample-value (generator.generate generation
                 (if (zero? size) (lambda (_) (error "zero size consumed randomness")) (lambda (_) 0)) size)))
               (right (generator.sample-value (generator.generate generation (lambda (_) 0) size))))
          (check-equal? (hash-length left) (min size 3))
          (check-equal? draws (* 2 (min size 3)))
          (check (eq? left right) => #f)
          (when (hash-key? left 'a) (hash-remove! left 'a) (check (hash-key? right 'a) => #t)))))
    (test-case "finite hash shrinking deletes retained entries without redrawing values"
      (def draws 0)
      (def generation (generator.generator-hash '(a b c)
        (generator.make-generator (lambda (_random _size) (set! draws (1+ draws)) 4) generator.integer-shrinks)))
      (def root (generator.generate generation (lambda (_) 0) 3))
      (def children (for/collect (child ((generator.sample-children root))) child))
      (check-equal? draws 3)
      (check (ormap (lambda (child) (let (table (generator.sample-value child))
        (and (= (hash-length table) 2) (hash-key? table 'a) (hash-key? table 'c)
          (= (hash-ref table 'a) 4) (= (hash-ref table 'c) 4)))) children) => #t)
      (check (ormap (lambda (child) (let (table (generator.sample-value child))
        (and (= (hash-length table) 3) (= (hash-ref table 'a) 0)))) children) => #t)
      (hash-put! (generator.sample-value root) 'a 99)
      (check (every (lambda (child) (let (table (generator.sample-value child))
        (or (not (hash-key? table 'a)) (not (= (hash-ref table 'a) 99))))) children) => #t))
    (test-case "finite hash source refusals and value exceptions stop without retries"
      (let* ((live #t) (draws 0) (generation (generator.generator-hash '(a b c)
          (generator.make-generator (lambda (_random _size) (set! draws (1+ draws)) (set! live #f) 4)
            generator.integer-shrinks) current?: (lambda () live))))
        (check-exception (generator.generate generation (lambda (_) 0) 3) generator.stale-generation?)
        (check-equal? draws 1))
      (let* ((cause (cons 'value 'fault)) (generation (generator.generator-hash '(a)
          (generator.make-generator (lambda (_random _size) (raise cause)) (lambda (_) [])))))
        (check-eq? (with-catch values (lambda () (generator.generate generation (lambda (_) 0) 1))) cause))
      (let* ((live #t) (generation (generator.generator-hash '(a)
          (generator.make-generator (lambda (_random _size) 4) generator.integer-shrinks)
          current?: (lambda () live)))
             (root (generator.generate generation (lambda (_) 0) 1))
             (removed (car (for/collect (child ((generator.sample-children root))) child))))
        (check-equal? (hash-length (generator.sample-value removed)) 0)
        (set! live #f)
        (check ((generator.sample-current removed)) => #f)))
)

;; Source inheritance and retained list-tree cases; registration changes no callbacks.
(def (source-list-test-cases!)
    (test-case "callback source revisions refuse before downstream generation effects"
      (for (stage '(draw map bind sized delay pack child))
        (let* ((live #t) (draws 0)
               (generation (revision-generator stage (lambda () (set! live #f)) (lambda () live)
                 (lambda (_random _size) (set! draws (1+ draws)) 1))))
          (check-exception (generator.generate generation (generator.random-at 41) 3) generator.stale-generation?)
          (check-equal? draws (if (eq? stage 'child) 1 0)))))
    (test-case "inherited sources guard maps inside selected child graphs"
      (for (stage '(bind sized delay producer))
        (let* ((live #t) (mapped 0) (guard (lambda () live))
               (child (generator.generator-map
                 (generator.make-generator (lambda (_random _size) (set! live #f) 1) (lambda (_) []))
                 (lambda (value) (set! mapped (1+ mapped)) value)))
               (generation (case stage
                 ((bind) (generator.generator-bind
                   (generator.make-generator (lambda (_random _size) 0) (lambda (_) []) current?: guard)
                   (lambda (_) child)))
                 ((sized) (generator.generator-sized (lambda (_) child) current?: guard))
                 ((delay) (generator.generator-delay (lambda () child) current?: guard))
                 (else (generator.make-tree-generator
                   (lambda (random size) (generator.generate child random size)) current?: guard)))))
          (check-exception (generator.generate generation (generator.random-at 41) 3) generator.stale-generation?)
          (check-equal? mapped 0)
          ;; Unwinding a failed stage must not poison an unrelated later draw.
          (check-equal? (generator.sample-value
            (generator.generate (generator.generator-unit 7) (generator.random-at 41) 3)) 7))))
    (test-case "inherited sources remain on separately retained lazy children"
      (def live #t)
      (def child (generator.make-generator (lambda (_random _size) 2)
        (lambda (value) (if (= value 2) [1] []))))
      (def generation (generator.make-tree-generator
        (lambda (random size) (generator.generate child random size)) current?: (lambda () live)))
      (def root (generator.generate generation (generator.random-at 41) 3))
      (def children (for/collect (node ((generator.sample-children root))) node))
      (check-equal? (map generator.sample-value children) [1])
      (set! live #f)
      (check ((generator.sample-current (car children))) => #f)
      (check-exception (for (node ((generator.sample-children (car children)))) (void)) generator.stale-generation?)
      (check-eq? (property.report-status (property.check-property
        (generator.make-tree-generator (lambda (_random _size) (car children)))
        (lambda (_) (error "stale retained child reached property"))
        (property.make-specification exact-integer? abs) cases: 1)) 'stale))
    (test-case "callback exceptions keep their identity after source revisions"
      (for (stage '(draw map bind sized delay pack child))
        (let* ((live #t) (cause (cons stage 'failure))
               (generation (revision-generator stage (lambda () (set! live #f) (raise cause))
                 (lambda () live) (lambda (_random _size) (error "unreachable child draw")))))
          (check-eq? (with-catch values (lambda ()
            (generator.generate generation (generator.random-at 41) 3))) cause))))
    (test-case "source-stable callback stages preserve seeded values and lazy children"
      (for (stage '(draw map bind sized delay pack child))
        (let* ((calls 0) (draws 0)
               (generation (revision-generator stage (lambda () (set! calls (1+ calls))) (lambda () #t)
                 (lambda (random size) (set! draws (1+ draws)) (random (1+ size))))))
          (let* ((left (generator.generate generation (generator.random-at 41) 3))
                 (right (generator.generate generation (generator.random-at 41) 3)))
            (check-equal? (generator.sample-value left) (generator.sample-value right))
            (check-equal? calls 2)
            (check-equal? draws (if (memq stage '(bind sized delay child)) 2 0))))))
    (test-case "block deletion covers middle and tail positions within length bounds"
      (check-equal? (for/collect (xs (generator.list-deletions '(a b c) 0)) xs)
        '(() (b c) (a c) (a b)))
      (check-equal? (for/collect (xs (generator.list-deletions '(a b c) 2)) xs)
        '((b c) (a c) (a b)))
      (check-equal? (generator.list-deletion-count 3 0) 4)
      (check-equal? (for/collect (xs (generator.list-deletions '(a b) 2)) xs) [])
      (check-exception (generator.list-deletion-count 2 3) Error?)
      (let* ((input (list 'a 'b 'c)) (rows (generator.list-deletions input 0)))
        (set-car! input 'changed)
        (check-equal? (for/collect (row rows) row) '(() (b c) (a c) (a b)))))
    (test-case "retained list trees shrink without drawing or replacing element identities"
      (def draws 0)
      (def element (generator.make-generator (lambda (_random _size)
        (set! draws (1+ draws)) (vector draws)) (lambda (_) [])))
      (def lists (generator.generator-list element max-length: 8))
      (let* ((root (let find ((seed 0))
                    (when (= seed 100) (error "fixture requires a nontrivial list"))
                    (def tree (generator.generate lists (generator.random-at seed) 8))
                    (if (>= (length (generator.sample-value tree)) 3) tree (find (1+ seed)))))
             (before draws)
             (original (generator.sample-value root))
             (children (for/collect (child ((generator.sample-children root))) child)))
        (check-equal? draws before)
        (check-equal? (length children) (generator.list-deletion-count (length original) 0))
        (for (child children)
          (check (< (length (generator.sample-value child)) (length original)) => #t)
          (check (every (lambda (value) (and (memq value original) #t)) (generator.sample-value child)) => #t))))
    (test-case "middle deletion retains failure and removed branch provenance"
      (def live #t)
      (def leaves (list (generator.make-sample 11 (lambda () []))
        (generator.make-sample 99 (lambda () []) (lambda () live))
        (generator.make-sample 22 (lambda () []))))
      (def tree (generator.sample-sequence leaves))
      (def middle (begin
        (set-car! leaves (generator.make-sample 77 (lambda () [])))
        (let/cc found
        (for (child ((generator.sample-children tree)))
          (when (equal? (generator.sample-value child) '(11 22)) (found child)))
        (error "missing retained middle deletion"))))
      (def domain (property.make-specification (lambda (xs) (and (list? xs) (every exact-integer? xs)))
        (lambda (xs) (+ (length xs) (apply + xs)))))
      (def report (property.check-property (generator.make-tree-generator (lambda (_random _size) tree))
        (lambda (xs) (not (and (memv 11 xs) (memv 22 xs)))) domain cases: 1 shrink-budget: 32))
      (check-eq? (property.report-status report) 'failed)
      (check-equal? (property.report-counterexample report) '(11 22))
      (same-failure report (property.replay-property report))
      (check-eq? (property.replay-counterexample report) #f)
      (set! live #f)
      (check-eq? ((generator.sample-current middle)) #f)
      (check-exception (for (child ((generator.sample-children middle))) (void)) generator.stale-generation?)
      (check-eq? (property.report-current? report) #f)
      (check-exception (property.replay-counterexample report) Error?))
)

;; Bounded diagnostics, Unicode/byte data and mapped-source refusal cases.
(def (data-inspection-test-cases!)
    (test-case "sample diagnostics own deterministic draws without children or coverage"
      (def forced 0)
      (def draws (generator.make-generator (lambda (random _) (random 8))
        (lambda (_) (set! forced (1+ forced)) (error "unused shrinker"))))
      (def inspection (property.inspect-generator draws signed-domain seed: 42 count: 6
        labels: (lambda (_) '(observed observed))))
      (check-eq? (property.inspection-status inspection) 'complete)
      (check-equal? (property.inspection-draws inspection) 6)
      (check-equal? (property.inspection-attempts inspection) 0)
      (check-equal? forced 0)
      (check-equal? (cdr (assq 'observed (property.inspection-counts inspection))) 6)
      (check-equal? (property.inspection-events inspection)
        (property.inspection-events (property.inspect-generator draws signed-domain seed: 42 count: 6)))
      (check-eq? (property.report-status (property.check-property draws (lambda (_) #t) signed-domain
        cases: 1 policy: (property.make-policy labels: (lambda (_) '(observed)) required: '((observed . 2))))) 'coverage)
      (check-equal? (property.inspection-events (property.inspect-generator draws signed-domain count: 0)) [])
      (check-exception (property.inspect-generator draws signed-domain proposal-budget: -1) Error?))
    (test-case "inspection paths explain domain refusal nondecrease and bounded descent"
      (def factories 0)
      (def draw (generator.make-generator (lambda (_random _) 10)
        (lambda (value) (set! factories (1+ factories))
          (case value ((10) '(-1 10 6)) ((6) '(0)) (else (error "depth boundary forced"))))))
      (def domain (property.make-specification (lambda (value) (and (exact-integer? value) (>= value 0))) values))
      (def result (property.inspect-generator draw domain count: 1 depth: 2 proposal-budget: 4))
      (check-eq? (property.inspection-status result) 'complete)
      (check-equal? (property.inspection-events result)
        (list (vector '(0) 'root 10) (vector '(0 0) 'outside-domain -1)
          (vector '(0 1) 'nondecreasing 10) (vector '(0 2) 'value 6) (vector '(0 2 0) 'value 0)))
      (check-equal? factories 2)
      (check-equal? (property.inspection-attempts result) 4)
      (check-eq? (property.inspection-truncated? result) #t)
      (def filtered (generator.generator-filter
        (generator.make-generator (lambda (_random _) 4) (lambda (_) '(3 2 0))) even?))
      (def pruned (property.inspect-generator filtered signed-domain count: 1 depth: 1 proposal-budget: 2))
      (check-equal? (map (cut vector-ref <> 1) (property.inspection-events pruned)) '(root pruned value))
      (check-equal? (property.inspection-attempts pruned) 2))
    (test-case "infinite diagnostic neighborhoods stop without an extra pull"
      (def pulls 0)
      (def tree (generator.make-tree-generator (lambda (_random _size)
        (generator.make-sample 4 (lambda () (in-coroutine (lambda (yield)
          (let forever () (set! pulls (1+ pulls))
            (yield (generator.make-sample 4 (lambda () (error "nondecreasing child expanded")))) (forever)))))))))
      (def result (property.inspect-generator tree signed-domain count: 1 depth: 99 proposal-budget: 3))
      (check-eq? (property.inspection-status result) 'complete)
      (check-equal? pulls 3)
      (check-equal? (property.inspection-attempts result) 3)
      (check-equal? (length (property.inspection-events result)) 4)
      (property.inspect-generator tree signed-domain count: 1 depth: 99 proposal-budget: 0)
      (check-equal? pulls 3)
      (def leaf (property.inspect-generator (generator.generator-unit 4) signed-domain count: 1 depth: 2 proposal-budget: 3))
      (check-equal? (property.inspection-attempts leaf) 0)
      (check-eq? (property.inspection-truncated? leaf) #f))
    (test-case "diagnostic interruptions preserve returned charges and original causes"
      (def cause (cons 'iterator 'interrupted))
      (def tree (generator.make-tree-generator (lambda (_random _size)
        (generator.make-sample 4 (lambda () (in-coroutine (lambda (yield)
          (yield (generator.make-sample 4 (lambda () []))) (raise cause))))))))
      (def result (property.inspect-generator tree signed-domain count: 1 depth: 2 proposal-budget: 3))
      (check-eq? (property.inspection-status result) 'error)
      (check-eq? (property.inspection-cause result) cause)
      (check-equal? (property.inspection-attempts result) 1)
      (check-equal? (length (property.inspection-events result)) 2)
      (def current #t)
      (def stale (generator.make-tree-generator (lambda (_random _size)
        (generator.make-sample 4 (lambda () (in-coroutine (lambda (yield)
          (set! current #f) (yield (generator.make-sample 0 (lambda () []))))))))
        current?: (lambda () current)))
      (def stopped (property.inspect-generator stale signed-domain count: 1 depth: 2 proposal-budget: 3))
      (check-eq? (property.inspection-status stopped) 'stale)
      (check-equal? (property.inspection-attempts stopped) 1)
      (check-equal? (length (property.inspection-events stopped)) 1)
      (check-eq? (property.inspection-current? stopped) #f)
      (def exhausted (property.inspect-generator
        (generator.generator-filter (generator.generator-unit 0) (lambda (_) #f) attempts: 1)
        signed-domain count: 3))
      (check-eq? (property.inspection-status exhausted) 'exhausted)
      (check-equal? (property.inspection-draws exhausted) 1)
      (check-equal? (property.inspection-events exhausted) []))
    (test-case "dependent data diagnostics preserve domains and later root draws"
      (def names (generator.generator-symbol (generator.generator-character lower: #\a upper: #\z)
        min-length: 1 max-length: 4))
      (def packets (generator.generator-bind names (lambda (name)
        (def width (string-length (symbol->string name)))
        (generator.generator-map (generator.generator-bytes min-length: width max-length: width)
          (lambda (bytes) (vector name bytes))))))
      (def domain (property.make-specification (lambda (value)
        (and (vector? value) (= (vector-length value) 2) (symbol? (vector-ref value 0))
          (u8vector? (vector-ref value 1))
          (= (string-length (symbol->string (vector-ref value 0))) (u8vector-length (vector-ref value 1)))))
        (lambda (value) (+ (apply + (map char->integer (string->list (symbol->string (vector-ref value 0)))))
          (apply + (u8vector->list (vector-ref value 1)))))))
      (def result (property.inspect-generator packets domain seed: 42 count: 3 depth: 2 proposal-budget: 20))
      (def roots (property.inspect-generator packets domain seed: 42 count: 3))
      (check-eq? (property.inspection-status result) 'complete)
      (check-equal? (filter (lambda (event) (eq? (vector-ref event 1) 'root)) (property.inspection-events result))
        (property.inspection-events roots))
      (check (<= (length (property.inspection-events result)) 23) => #t)
      (check (every (lambda (event) (<= (length (vector-ref event 0)) 3)) (property.inspection-events result)) => #t)
      (check-equal? (property.inspection-events result)
        (property.inspection-events (property.inspect-generator packets domain seed: 42 count: 3 depth: 2 proposal-budget: 20))))
    (test-case "Unicode scalar and byte endpoints never generate surrogate values"
      (def chars (generator.generator-character))
      (for (offset '(0 55295 55296 1112063))
        (def value (generator.sample-value (generator.generate chars (lambda (_) offset) 0)))
        (check (or (< (char->integer value) #xd800) (> (char->integer value) #xdfff)) => #t))
      (check-equal? (generator.sample-value (generator.generate chars (lambda (n) (1- n)) 0)) #\x10ffff)
      (check-equal? (generator.sample-value (generator.generate (generator.generator-byte) (lambda (n) (1- n)) 0)) 255)
      (check-exception (generator.generator-character lower: #\z upper: #\a) Error?)
      (check-exception (generator.generator-list chars min-length: 4 max-length: 3) Error?))
    (test-case "bounded strings and symbols retain alphabet and dependent spelling"
      (def alphabet (generator.generator-character lower: #\a upper: #\z))
      (def strings (generator.generator-string alphabet min-length: 2 max-length: 8))
      (def domain (property.make-specification
        (lambda (text) (and (string? text) (<= 2 (string-length text) 8)
          (every (lambda (char) (char<=? #\a char #\z)) (string->list text))))
        (lambda (text) (+ (string-length text) (apply + (map char->integer (string->list text)))))))
      (def report (property.check-property strings (lambda (_) #f) domain seed: 42 cases: 1 size: 8 shrink-budget: 80))
      (check-eq? (property.report-status report) 'failed)
      (check-equal? (property.report-counterexample report) "aa")
      (same-failure report (property.replay-property report))
      (def symbols (generator.generator-symbol alphabet min-length: 2 max-length: 8))
      ;; A spelling shrink regenerates a matching byte payload from the saved seed.
      (def packets (generator.generator-bind symbols (lambda (name)
        (def width (string-length (symbol->string name)))
        (generator.generator-map (generator.generator-bytes min-length: width max-length: width)
          (lambda (payload) (vector name payload))))))
      (def packet-domain (property.make-specification (lambda (row)
        (and (vector? row) (= (vector-length row) 2) (symbol? (vector-ref row 0))
          (u8vector? (vector-ref row 1))
          (= (string-length (symbol->string (vector-ref row 0))) (u8vector-length (vector-ref row 1)))))
        (lambda (row) (+ (apply + (map char->integer (string->list (symbol->string (vector-ref row 0)))))
          (apply + (u8vector->list (vector-ref row 1)))))))
      (def packet-report (property.check-property packets (lambda (_) #f) packet-domain
        seed: 42 cases: 1 size: 8 shrink-budget: 200))
      (check-eq? (property.report-status packet-report) 'failed)
      (same-failure packet-report (property.replay-property packet-report))
      (for (seed '(0 8 42))
        (check-equal? (symbol->string (generator.sample-value (generator.generate symbols (generator.random-at seed) 8)))
          (generator.sample-value (generator.generate strings (generator.random-at seed) 8)))))
    (test-case "fixed byte payloads shrink coordinates without losing required width"
      (def bytes (generator.generator-bytes min-length: 4 max-length: 4))
      (def domain (property.make-specification
        (lambda (value) (and (u8vector? value) (= (u8vector-length value) 4)))
        (lambda (value) (apply + (u8vector->list value)))))
      (def report (property.check-property bytes (lambda (_) #f) domain seed: 42 cases: 1 size: 0 shrink-budget: 80))
      (check-equal? (property.report-counterexample report) #u8(0 0 0 0))
      (same-failure report (property.replay-property report))
      (check-equal? (generator.sample-value (generator.generate (generator.generator-bytes) (generator.random-at 9) 0)) #u8()))
    (test-case "mapped data generators preserve stale sources and callback errors"
      (def current #t)
      (def chars (generator.make-generator (lambda (_random _size) #\a) (lambda (_) [])
        current?: (lambda () current)))
      (def tree (generator.generate (generator.generator-string chars min-length: 1) (generator.random-at 3) 0))
      (set! current #f)
      (check-exception (for (child ((generator.sample-children tree))) (void)) generator.stale-generation?)
      (def cause (cons 'character 'callback))
      (def refused (generator.make-generator (lambda (_random _size) (raise cause)) (lambda (_) [])))
      (check-eq? (with-catch values (lambda ()
        (generator.generate (generator.generator-string refused min-length: 1) (generator.random-at 3) 0))) cause))
)

