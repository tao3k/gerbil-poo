;;; Positive metalevel feedback controls a safe, nonlocal service declaration chain.
(export make-expander fragments build-service)
(import ../object ../mop ../number ../brace ../closure ../meta-prototype
        ../declaration ../recursive-declaration ../reflection
        (prefix-in ../recursive recursive.))
;; A real cyclic metadata component: typed expansion and reflection mutually
;; depend on each other, grounded by explicit seed. An unsupported cycle stays false.
;; cook selects the kernel from that least solution before self-hosted construction.
(def (make-expander seed visit)
  (close-protocol (.o
    (equations (vector (literal seed) (either (fact 0) (fact 2)) (fact 1)))
    (cook (lambda (facts)
      (.o (:: @ RecursiveDeclaration.)
        (compute-precedence-list (lambda (_ next) (next)))
        (compute-slot (lambda (_ next name)
          (def body (next))
          (if (eq? name 'level) (lambda () (+ (body) (if (closure-ref facts 2) 1 0))) body)))
        (level 7)
        (expand-recursive-declaration (inherited)
          (lambda (context form)
            (visit (.@ form name))
            (unless (closure-ref facts 2) (error "recursive metalevel not enabled"))
            (case (.@ form kind)
              ((family)
               (if (.@ context approved)
                 (.call recursive.Interaction. .bind (recursive.request 'billing)
                   (lambda (billing) (.call recursive.Interaction. .map (cut append billing <>)
                     (recursive.request 'risk))))
                 (recursive.source-error "current approval refused")))
              ((service)
               (.call recursive.Interaction. .bind (recursive.request 'limit)
                 (lambda (limit) (.call recursive.Interaction. .map
                   (lambda (revision)
                     (list (cons (.@ form name) (cdar limit))
                       (cons (make-symbol (.@ form name) '-revision) (cdar revision))))
                   (recursive.request 'revision)))))
              ((limit) (recursive.value [(cons 'limit (instance Slot type: Integer constant: (.@ context limit)))]))
              ((revision) (recursive.value [(cons 'revision (instance Slot hidden: #t constant: (.@ context revision)))]))
              (else ((inherited) context form)))))
        ;; This whole-object contribution references slots generated by later
        ;; fragments. No generated slot value is demanded during elaboration.
        (finalize-declarations (inherited)
          (lambda (context entries)
            (append ((inherited) context entries)
              [(cons 'total (instance Slot type: Integer compute:
                (lambda (self _) (+ (read-slot self 'billing) (read-slot self 'risk)))))])))))))))
;; Forward references are deliberate: the requested shared leaves appear last.
;; Each fragment owns one stable name; repeated requests reuse owned receipts.
(def fragments
  (map (lambda (entry) (cons (car entry) (declaration-form (cdr entry) (car entry) (.o))))
    '((family . family) (billing . service) (risk . service) (limit . limit) (revision . revision))))
;; Complete closure, expansion, finalization and checked construction before return.
;; A refused current approval cannot replace a caller's previously published object.
(def (build-service expander context (budget 100))
  (object<-recursive-declarations expander context fragments '(family) budget protocol: expander))
