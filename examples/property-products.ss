;;; Fixed-product generation, domain observation and source-refusal examples.
(export make-prepared-children iterator-preparation-test-cases! function-request-test-cases! diagnostic-binding-test-cases! product-test-cases! product-row-test-cases!)
(import :std/test :std/error :std/iter :std/interface
        (only-in :gerbil/runtime/gambit type-exception?)
        (prefix-in :clan/poo/testing/property/test assertion.)
        (prefix-in :clan/poo/testing/property/generator generator.)
        (prefix-in :clan/poo/testing/property property.))

;; Immutable-field seed/tree oracle, independent of the benchmark control; not a runtime
;; compatibility path. It reconstructs the former retained bind/map algebra.
(def (retained-product-reference fields)
  ;; Each field is a hidden preimage; root composition never shrinks or redraws it.
  (def (sampled field)
    (generator.make-tree-generator (lambda (random size)
      (let (tree (generator.generate field random size))
        (generator.make-sample tree (lambda () []) sources: (generator.sample-sources tree))))))
  (def roots (foldr (lambda (field tail)
    (generator.generator-bind (sampled field) (lambda (tree)
      (generator.generator-map tail (lambda (trees) (cons tree trees))))))
    (generator.generator-unit []) fields))
  (generator.make-tree-generator (lambda (random size)
    (let (root (generator.generate roots random size))
      (generator.sample-sequence (generator.sample-value root) min-length: (length fields)
        sources: (generator.sample-sources root))))))

;; Register these ordinary cases in the caller's current :std/test suite.
;; The standard runner still owns discovery, fixtures, assertions and results.
(def (product-test-cases!)
    (test-case "named dependent declarations share generation shrinking and both replay paths"
      (def domain (property.make-specification exact-integer? abs))
      (def row-domain (property.make-specification list? (lambda (_) 0)))
      (def parent (generator.make-generator (lambda (_r _s) 4)
        (lambda (n) (if (zero? n) [] (list 0 (quotient n 2) (1- n))))))
      ;; A dependent fixed-length payload is regenerated after shrinking count.
      ;; Its own coordinate shrinks remain lazy and cannot change the count.
      (def (payload count)
        (generator.generator-list (generator.generator-integer 0 9)
          min-length: count max-length: count))
      (property.define-property dependent-packet
        ((count parent domain) (bytes (payload count) row-domain))
        (and (= count (length bytes)) (< count 2)))
      (def report (dependent-packet seed: 42 cases: 1 size: 4 shrink-budget: 80))
      (def reference (property.check-property
        (generator.bind-generators ((count parent) (bytes (payload count))) (list count bytes))
        (lambda (row) (and (= (car row) (length (cadr row))) (< (car row) 2)))
        (property.make-product-specification (list domain row-domain))
        seed: 42 cases: 1 size: 4 shrink-budget: 80))
      (check-eq? (property.report-status report) 'failed)
      (check-equal? (property.report-name report) 'dependent-packet)
      (check-equal? (property.report-counterexample report) (property.report-counterexample reference))
      (check-equal? (property.report-attempts report) (property.report-attempts reference))
      (check-equal? (car (property.report-counterexample report)) 2)
      (check-equal? (length (cadr (property.report-counterexample report))) 2)
      (check (property.replay-counterexample report) => #f)
      (def replay (property.replay-property report))
      (check-equal? (property.report-original replay) (property.report-original report))
      (check-equal? (property.report-counterexample replay) (property.report-counterexample report))
      (check-equal? (property.report-attempts replay) (property.report-attempts report)))
    (test-case "dependent declarations admit options before domains and share standard test delivery"
      (def declarations 0) (def draws 0)
      (def (domain)
        (set! declarations (1+ declarations))
        (property.make-specification exact-integer? abs))
      (def field (generator.make-generator (lambda (_r _s) (set! draws (1+ draws)) 3) (lambda (_) [])))
      (property.define-property report-only
        ((options field (domain)) (arguments (generator.generator-unit options) (domain)))
        (= options arguments))
      (check-exception (report-only cases: 0) Error?)
      (check-equal? (list declarations draws) '(0 0))
      (assertion.define-property checked
        ((options field (domain)) (arguments (generator.generator-unit options) (domain)))
        (= options arguments))
      (checked seed: 7 cases: 1 size: 3)
      (check-equal? (list declarations draws) '(2 1))
      (check-eq? (property.report-status (report-only seed: 7 cases: 1 size: 3)) 'passed)
      (check-equal? (list declarations draws) '(4 2))
      (def public #f)
      (assertion.define-property self-reference
        ((value (generator.generator-unit 0) (domain)))
        (and (= value 0) (eq? self-reference public)))
      (set! public self-reference)
      (self-reference cases: 1))
    (test-case "product topology contracts reject malformed spines before drawing"
      (def draws 0)
      (def field (generator.make-generator (lambda (_random _size) (set! draws (1+ draws)) 1) (lambda (_) [])))
      (def cycle (list field)) (set-cdr! cycle cycle)
      (for (invalid (list #f (cons field 'tail) cycle (list field #f)))
        (check-exception (generator.generator-sequence invalid) Error?))
      (check-equal? draws 0))
    (test-case "captured product topology is independent of caller spine edits"
      (def fields (list (generator.generator-unit 1) (generator.generator-unit 2)))
      (def product (generator.generator-sequence fields))
      (set-car! fields (generator.generator-unit 99)) (set-cdr! fields fields)
      (check-equal? (generator.sample-value (generator.generate product (generator.random-at 41) 2)) '(1 2)))
    (test-case "checked products retain the established split schedule and root remainder"
      (for* ((width '(0 1 3 16)) (seed '(0 1 41 4294967086)) (dependent? '(#f #t)))
        (def field (if dependent?
          (generator.generator-bind (generator.generator-integer 0 16)
            (lambda (lower) (generator.generator-integer lower (+ lower 16))))
          (generator.generator-integer 0 1024)))
        (def fields (make-list width field))
        (def before (generator.random-at seed)) (def after (generator.random-at seed))
        (check-equal? (generator.sample-value (generator.generate (retained-product-reference fields) before 8))
          (generator.sample-value (generator.generate (generator.generator-sequence fields) after 8)))
        (check-equal? (before 4294967087) (after 4294967087))))
    (test-case "bind preserves split draws and refuses unused malformed seeds"
      ;; The direct SRFI-27 streams are an oracle independent of bind's preparation.
      (def (draw random) (list (random 97) (random 113)))
      (def parent (generator.make-generator (lambda (random _) (draw random)) (lambda (_) [])))
      (def actual (generator.random-at 41))
      (def expected (generator.random-at 41))
      (def parent-seed (expected 4294967087))
      (def child-seed (expected 4294967087))
      (def product (generator.generator-bind parent
        (lambda (prefix)
          (generator.generator-map parent (lambda (suffix) (append prefix suffix))))))
      (check-equal? (generator.sample-value (generator.generate product actual 0))
        (append (draw (generator.random-at parent-seed)) (draw (generator.random-at child-seed))))
      (check-equal? (actual 4294967087) (expected 4294967087))
      (for (seeds '((bad 1) (1 bad)))
        (def pending seeds)
        (def callbacks 0)
        (def constant (generator.make-generator
          (lambda (_random _size) (set! callbacks (1+ callbacks)) 1) (lambda (_) [])))
        (check-exception (generator.generate (generator.generator-bind constant (lambda (_) constant))
          (lambda (_) (begin0 (car pending) (set! pending (cdr pending)))) 0) type-exception?)
        (check-equal? pending [])
        (check-equal? callbacks (if (eq? (car seeds) 'bad) 0 1))))
    (test-case "checked retained products preserve coordinate trees and both replay receipts"
      (def fields (list (generator.generator-integer 0 16) (generator.generator-integer 0 16)))
      (def domain (property.make-specification list? (cut apply + <>)))
      ;; Compare receipts as well as values: neither callback counts nor budgets
      ;; may disappear behind an apparently equal final counterexample.
      (def (receipt constructor)
        (let (report (property.check-property (constructor fields) (lambda (row) (< (apply + row) 3))
          domain seed: 41 cases: 1 shrink-budget: 32))
          (check-eq? (property.report-status report) 'failed)
          (check (property.replay-counterexample report) => #f)
          (def again (property.replay-property report))
          (check-equal? (property.report-counterexample again) (property.report-counterexample report))
          (list (property.report-original report) (property.report-counterexample report)
            (property.report-attempts report) (property.report-steps report) (property.report-minimal? report))))
      (check-equal? (receipt generator.generator-sequence) (receipt retained-product-reference)))
    (test-case "newly discovered branch retirement suppresses the next field"
      (def live #t) (def later 0)
      (def first (generator.make-tree-generator (lambda (_random _size)
        (set! live #f) (generator.make-sample 1 (lambda () []) (lambda () live)))))
      (def last (generator.make-generator (lambda (_random _size) (set! later (1+ later)) 2) (lambda (_) [])))
      (check-exception (generator.generate (generator.generator-sequence (list first last))
        (generator.random-at 41) 2) generator.stale-generation?)
      (check-equal? later 0))
    (test-case "wide fixed products retain every field and their empty neighborhood"
      (def fields (map generator.generator-unit (iota 512)))
      (def root (generator.generate (generator.generator-sequence fields) (generator.random-at 41) 0))
      (check-equal? (generator.sample-value root) (iota 512))
      (check-equal? (for/collect (child ((generator.sample-children root))) child) []))
    (test-case "fixed products refuse obsolete later fields before randomness or drawing"
      (def live #t) (def draws 0) (def randoms 0)
      (def first (generator.make-generator (lambda (_random _size) (set! draws (1+ draws)) 8)
        generator.integer-shrinks))
      (def last (generator.make-generator (lambda (_random _size) 2) generator.integer-shrinks
        current?: (lambda () live)))
      (def product (generator.generator-sequence
        (list first (generator.generator-sequence (list first last)))))
      (set! live #f)
      (check (generator.generator-current? product) => #f)
      (check-exception (generator.generate product
        (lambda (_) (set! randoms (1+ randoms)) 0) 5) generator.stale-generation?)
      (check-equal? (list randoms draws) '(0 0))
      (def report (property.check-property product (lambda (_) #f)
        (property.make-specification list? (lambda (_) 0)) cases: 1))
      (check-eq? (property.report-status report) 'stale)
      (check-equal? (list (property.report-trial report) (property.report-attempts report) draws) '(0 0 0)))
    (test-case "fixed product ownership stops mapping after an earlier draw revises a later field"
      (def live #t) (def mapped 0) (def later 0)
      (def first (generator.generator-map
        (generator.make-generator (lambda (_random _size) (set! live #f) 8) generator.integer-shrinks)
        (lambda (value) (set! mapped (1+ mapped)) value)))
      (def last (generator.make-generator (lambda (_random _size) (set! later (1+ later)) 2)
        generator.integer-shrinks current?: (lambda () live)))
      (check-exception (generator.generate (generator.generator-sequence (list first last))
        (generator.random-at 3) 5) generator.stale-generation?)
      (check-equal? (list mapped later) '(0 0)))
    (test-case "fixed product observer causes remain exact before any field callback"
      (def cause (Error "product-source")) (def calls 0)
      (for (raising? '(#t #f))
        (def observer (if raising? (lambda () (raise cause)) (lambda () 'not-boolean)))
        (def field (generator.make-generator (lambda (_random _size) (set! calls (1+ calls)) 1)
          generator.integer-shrinks current?: observer))
        (def product (generator.generator-sequence (list (generator.generator-unit 0) field)))
        (def failure (with-catch identity (lambda () (generator.generate product (generator.random-at 1) 5))))
        (if raising? (check-eq? failure cause)
          (check-equal? (Error-message failure) "source observer must return a boolean")))
      (check-equal? calls 0))
    (test-case "finite function products share leaves while empty and unselected domains stay independent"
      (def live #t) (def draws 0) (def guard (lambda () live))
      (def field (generator.make-generator (lambda (random _size) (set! draws (1+ draws)) (list (random 16)))
        (lambda (_) []) current?: guard))
      (def function (generator.generator-function '((a) (b)) field))
      (def root (generator.generate function (generator.random-at 9) 5))
      (check-equal? (length (generator.sample-sources root)) 1)
      (check-equal? draws 2)
      (check-equal? (generator.function-table (generator.sample-value root))
        (generator.function-table (generator.sample-value (generator.generate function (generator.random-at 9) 5))))
      (set! live #f)
      (check (generator.generator-current? function) => #f)
      (check-exception (generator.function-apply (generator.sample-value root) '(a)) generator.stale-generation?)
      (check-exception (generator.generate function (generator.random-at 9) 5) generator.stale-generation?)
      (check-equal? draws 4)
      (def empty (generator.generator-function [] field))
      (check (generator.generator-current? empty) => #t)
      (check-equal? (generator.function-table (generator.sample-value
        (generator.generate empty (generator.random-at 9) 5))) [])
      (def selected (generator.generator-frequency
        (list (cons 0 field) (cons 1 (generator.generator-unit 7)))))
      (check-equal? (generator.sample-value (generator.generate selected (generator.random-at 9) 5)) 7))
    (test-case "product recognition stops when an earlier field invalidates a later source"
      (def current #t) (def visited []) (def calls 0)
      (def first (property.make-specification (lambda (_)
        (set! visited (cons 'first visited)) (set! current #f) #t) abs))
      (def second (property.make-specification (lambda (_)
        (set! visited (cons 'second visited)) #t) abs current?: (lambda () current)))
      (def report (property.check-property (generator.generator-unit '(1 2))
        (lambda (_) (set! calls (1+ calls)) #f) (property.make-product-specification (list first second)) cases: 1))
      (check-eq? (property.report-status report) 'stale)
      (check-equal? visited '(first))
      (check-equal? calls 0)
      (check-equal? (property.report-attempts report) 0))
    (test-case "product measurement stops before later fields or pending witness installation"
      (def current #t) (def visited []) (def calls 0)
      (def first (property.make-specification exact-integer? (lambda (_)
        (set! visited (cons 'first visited)) (set! current #f) 1)))
      (def second (property.make-specification exact-integer? (lambda (_)
        (set! visited (cons 'second visited)) 2) current?: (lambda () current)))
      (def report (property.check-property
        (generator.make-generator (lambda (_random _size) '(2 2)) (lambda (_) '((1 2))))
        (lambda (_) (set! calls (1+ calls)) #f) (property.make-product-specification (list first second)) cases: 1))
      (check-eq? (property.report-status report) 'stale)
      (check-equal? visited '(first))
      (check-equal? calls 1)
      (check-equal? (property.report-counterexample report) '(2 2))
      (check-equal? (property.report-attempts report) 1)
      (check-equal? (property.report-steps report) 0))
)

;; A product row is finite data of the declared width. Its admission is Boolean,
;; while an explicit invalid weight request is an error before field effects.
(def (product-row-test-cases!)
  (test-case "data list neighborhoods retain returned order across observer spine edits"
    (for (edit '(replace improper cycle))
      (def row (list 0)) (def armed #f) (def changed #f) (def calls [])
      (def result (generator.with-generation-check (lambda ()
        (when (and armed (not changed))
          (set! changed #t)
          (case edit ((replace) (set-car! row 1))
            ((improper) (set-cdr! row 'tail)) ((cycle) (set-cdr! row row)))))
        (generator.data-list-shrinks '(2 3) (lambda (value)
          (set! calls (append calls [value]))
          (if (= value 2) (begin (set! armed #t) row) [1])) 2)))
      (check changed => #t) (check-equal? calls '(2 3))
      (check-equal? result '((0 3) (2 1))))
    (def payload (cons 'shared 'payload))
    (def result (generator.data-list-shrinks '(2) (lambda (_) (list payload payload #f)) 1))
    (check-eq? (caar result) payload) (check-eq? (caadr result) payload)
    (check-equal? (caddr result) '(#f))
    (check-equal? (generator.data-list-shrinks '(2) (lambda (_) []) 1) []))
  (test-case "data list malformed neighborhoods retain their standard contract error"
    (def cycle (list 0)) (set-cdr! cycle cycle)
    (for (row (list #f (cons 0 'tail) cycle))
      (def armed #f) (def observed 0) (def calls 0)
      (check-exception (generator.with-generation-check (lambda ()
        (when armed (set! observed (1+ observed))
          ;; Repairing the producer's row cannot repair the captured admission.
          (when (pair? row) (set-cdr! row []))))
        (generator.data-list-shrinks '(2 3) (lambda (_)
          (set! calls (1+ calls)) (set! armed #t) row) 2)) contract-violation-error?)
      (check-equal? (list calls observed) '(1 1))))
  (test-case "data list shrink failures keep source and original cause precedence"
    (def live #t) (def calls 0)
    (check-exception (generator.with-sources (list (lambda () live))
      (generator.data-list-shrinks '(2 3) (lambda (_)
        (set! calls (1+ calls)) (set! live #f) '(0 . tail)) 2)) generator.stale-generation?)
    (check-equal? calls 1)
    (for* ((phase '(body observer)) (cause (list #f (cons 'original 'cause))))
      (def armed #f) (def observed 0)
      (check-eq? (with-catch values (lambda ()
        (generator.with-generation-check (lambda ()
          (when armed (set! observed (1+ observed)) (raise cause)))
          (generator.data-list-shrinks '(2) (lambda (_)
            (set! armed #t) (if (eq? phase 'body) (raise cause) '(0 . tail))) 1)))) cause)
      (check-equal? observed (if (eq? phase 'body) 0 1))))
  (test-case "generic infinite Iterator shrinking stays lazy and exactly budgeted"
    (for (budget '(0 1 3))
      (def factories 0) (def pulls 0)
      (def producer (generator.make-generator (lambda (_random _size) 2) (lambda (_)
        (set! factories (1+ factories))
        (in-coroutine (lambda (yield)
          (let loop () (set! pulls (1+ pulls)) (yield 1) (loop)))))))
      (def report (property.check-property producer (lambda (_) #f)
        (property.make-specification exact-integer? (lambda (_) 1)) cases: 1 shrink-budget: budget))
      (check-eq? (property.report-status report) 'failed)
      (check-equal? (list (property.report-counterexample report) (property.report-attempts report)
        (property.report-steps report) pulls factories) (list 2 budget 0 budget (if (zero? budget) 0 1)))
      (check (property.report-minimal? report) => #f)))
  (test-case "product rows reject malformed and unequal widths before field callbacks"
    (def accepts 0) (def measures 0) (def properties 0)
    (def field (property.make-specification
      (lambda (_) (set! accepts (1+ accepts)) #t)
      (lambda (_) (set! measures (1+ measures)) 1)))
    (def product (property.make-product-specification (list field field)))
    (def cycle (list 4 6)) (set-cdr! (cdr cycle) cycle)
    (for (bad (list #f '#(4 6) '(4 6 . tail) cycle [] '(4) '(4 6 8)))
      (check-exception (property.specification-weight product bad) Error?)
      (check-exception (property.check-counterexample bad
        (lambda (_) (set! properties (1+ properties)) #f) product) Error?))
    (check-equal? (list accepts measures properties) '(0 0 0)))
  (test-case "empty and false-containing product rows retain their distinct domains"
    (def empty (property.make-product-specification []))
    (check-equal? (property.specification-weight empty []) 0)
    (check (property.check-counterexample [] (lambda (_) #f) empty) => #f)
    (check-exception (property.specification-weight empty #f) Error?)
    (def booleans (property.make-product-specification
      (list (property.make-specification boolean? (lambda (_) 0)))))
    (check-equal? (property.specification-weight booleans '(#f)) 0)
    (check (property.check-counterexample '(#f) (lambda (_) #f) booleans) => #f)
    (check-exception (property.check-counterexample #f (lambda (_) #f) booleans) Error?))
  (test-case "product measurement consumes one captured row despite temporary spine edits"
    (for (edit (list (lambda (row) (set-car! (cdr row) 99))
                    (lambda (row) (set-cdr! row []))
                    (lambda (row) (set-cdr! row 'tail))
                    (lambda (row) (set-cdr! row row))))
      (def input (list 4 6)) (def calls [])
      (def first (property.make-specification exact-integer? (lambda (value)
        (set! calls (cons value calls)) (edit input) value)))
      (def second (property.make-specification exact-integer? (lambda (value)
        (set! calls (cons value calls)) value)))
      (check-equal? (property.specification-weight
        (property.make-product-specification (list first second)) input) 10)
      (check-equal? (reverse calls) '(4 6))))
  (test-case "product row capture preserves source refusal and exact measurement causes"
    (for (cause (list #f (cons 'product 'cause)))
      (def later 0)
      (def first (property.make-specification exact-integer? (lambda (_) (raise cause))))
      (def second (property.make-specification exact-integer?
        (lambda (_) (set! later (1+ later)) 0)))
      (check-eq? (with-catch identity (lambda () (property.specification-weight
        (property.make-product-specification (list first second)) '(4 6)))) cause)
      (check-equal? later 0))
    (def live #t) (def later 0)
    (def first (property.make-specification exact-integer? (lambda (value) (set! live #f) value)))
    (def second (property.make-specification exact-integer? (lambda (value) (set! later (1+ later)) value)))
    (check-exception (property.specification-weight
      (property.make-product-specification (list first second) current?: (lambda () live)) '(4 6)) Error?)
    (check-equal? later 0))
  (test-case "nested products preserve explicit observer order and repeated occurrences"
    (def calls [])
    (def (observe label) (lambda () (set! calls (cons label calls)) #t))
    (def plain (property.make-specification exact-integer? abs))
    (def explicit (property.make-specification exact-integer? abs current?: (observe 'field)))
    (def inner (property.make-product-specification (list plain explicit plain explicit)
      current?: (observe 'inner)))
    (def outer (property.make-product-specification (list plain inner explicit)
      current?: (observe 'outer)))
    (check-equal? calls [])
    (check (property.specification-current? outer) => #t)
    (check-equal? (reverse calls) '(outer inner field field field))))

;; Named diagnostics own only their finite symbolic directory. Generated values
;; and report authority still belong to the existing kernel and standard checks.
(def (diagnostic-binding-test-cases!)
  (test-case "diagnostic bindings precede source callbacks and own cyclic caller edits"
    (def names (list 'input)) (def armed #f)
    (def domain (property.make-specification list? length current?: (lambda ()
      (when armed (set-car! names 'retargeted) (set-cdr! names names)) #t)))
    (def report (property.check-property (generator.generator-unit '(7)) (lambda (_) #t) domain cases: 1))
    (set! armed #t)
    (def fields (property.report-diagnostics report bindings: names))
    (check-equal? (cdr (assq 'original fields)) '((input . 7)))
    (check-eq? (cdr (assq 'status fields)) 'passed))
  (test-case "prepared diagnostic bindings are reusable without retaining report authority"
    (def names (list 'left 'right))
    (def render (property.prepare-report-diagnostics names))
    (set-car! names 'changed) (set-cdr! names [])
    (def live #t)
    (def domain (property.make-specification vector? vector-length current?: (lambda () live)))
    (def passed (property.check-property (generator.generator-unit #(#f 2)) (lambda (_) #t) domain cases: 1))
    (assertion.require-passed passed diagnostics: render)
    (check-equal? (cdr (assq 'original (render passed))) '((left . #f) (right . 2)))
    (set! live #f)
    (check-eq? (cdr (assq 'status (render passed))) 'stale)
    (check-exception (assertion.require-passed passed diagnostics: render) Error?))
  (test-case "invalid diagnostic directories refuse before report source effects"
    (def reads 0)
    (def domain (property.make-specification list? length current?: (lambda () (set! reads (1+ reads)) #t)))
    (def report (property.check-property (generator.generator-unit '(1)) (lambda (_) #t) domain cases: 1))
    (set! reads 0)
    (def cyclic (list 'input)) (set-cdr! cyclic cyclic)
    (for (names (list '(same same) '(3) '(input . tail) cyclic))
      (check-exception (property.prepare-report-diagnostics names) Error?)
      (check-exception (property.report-diagnostics report bindings: names) Error?))
    (check-equal? reads 0))
  (test-case "historical failures retain causes and unmatched rows remain data"
    (def live #t) (def cause (cons 'original 'cause))
    (def domain (property.make-specification list? length current?: (lambda ()
      (unless live (raise 'must-not-observe)) #t)))
    (def failed (property.check-property (generator.generator-unit '(#f)) (lambda (_) #f) domain cases: 1 shrink-budget: 0))
    (def broken (property.check-property (generator.generator-unit '(#f)) (lambda (_) (raise cause)) domain cases: 1))
    (set! live #f)
    (check-equal? (cdr (assq 'counterexample (property.report-diagnostics failed bindings: '(input)))) '((input . #f)))
    (check-eq? (cdr (assq 'cause (property.report-diagnostics broken))) cause)
    (check-equal? (cdr (assq 'original ((property.prepare-report-diagnostics '(a b)) failed))) '(#f))
    (check-equal? (cdr (assq 'original (property.report-diagnostics failed))) '(#f))))

;; Finite call rows are protocol spines, distinct from shared argument payloads.
;; Both entrypoints use the same guarded lookup and ordinary tuple delivery.
(def (function-request-test-cases!)
  (test-case "finite direct calls capture request rows before source observation"
    (for (mutate (list (lambda (row) (set-car! row 'retargeted))
                      (lambda (row) (set-cdr! row 'improper))
                      (lambda (row) (set-cdr! row row))))
      (def arguments (list 'declared scale: 2))
      (def function (generator.function-from-table
        '(((declared scale: 2) #f 8) ((retargeted scale: 2) 99))
        current?: (lambda () (mutate arguments) #t)))
      (check-equal? (generator.function-apply function arguments) '(#f 8))))
  (test-case "finite malformed call rows refuse before table or inherited observers"
    (def cycle (list 'declared)) (set-cdr! cycle cycle)
    (def calls 0)
    (def function (generator.function-from-table '(((declared) 1))
      current?: (lambda () (set! calls (1+ calls)) (error "must not observe table"))))
    (for (row (list #f '#(declared) '(declared . tail) cycle))
      (check-exception (generator.with-generation-check (lambda ()
        (set! calls (1+ calls)) (error "must not observe caller"))
        (generator.function-apply function row)) Error?))
    (check-equal? calls 0))
  (test-case "finite unknown calls retain captured diagnostics and payload identity"
    (def payload (vector #f values)) (def arguments (list payload))
    (def function (generator.function-from-table []
      current?: (lambda () (set-car! arguments 'retargeted) #t)))
    (def failure (with-catch values (lambda () (generator.function-apply function arguments))))
    (check (Error? failure) => #t)
    (check-equal? (Error-message failure) "arguments outside finite function domain")
    (def captured (car (Error-irritants failure)))
    (check-eq? (car captured) payload)
    (check-equal? (length captured) 1)
    (set-cdr! arguments 'damaged)
    (check-eq? (car captured) payload)
    (check-eq? (vector-ref (car captured) 1) values))
  (test-case "owned finite procedure calls retain keywords values causes and stale refusal"
    (def live #t)
    (def function (generator.function-from-table '((() . ()) ((request scale: 2) #f 7))
      current?: (lambda () live)))
    (def invoke (generator.function-procedure function))
    (check-equal? (call-with-values invoke list) [])
    (check-equal? (call-with-values (cut invoke 'request scale: 2) list) '(#f 7))
    (check-equal? (generator.function-apply function '(request scale: 2)) '(#f 7))
    (for (cause (list #f (cons 'observer 'cause)))
      (def throwing (generator.function-from-table '((() 1)) current?: (lambda () (raise cause))))
      (check-eq? (with-catch values (lambda () (generator.function-apply throwing []))) cause)
      (check-eq? (with-catch values (generator.function-procedure throwing)) cause))
    (set! live #f)
    (check-exception (invoke) generator.stale-generation?)
    (check-exception (generator.function-apply function []) generator.stale-generation?)))


;; An ordinary downstream Iterable may prepare its Iterator with user effects.
;; This fixture exercises the standard interface, without replacing next! or for.
(defstruct prepared-children (prepare) final: #t)
;; The method returns the standard Iterator supplied by the application action.
(implement Iterable prepared-children
  (iter (lambda (self) (Iterator ((prepared-children-prepare self))))))

;; All consumers must own both child creation and standard Iterable conversion.
;; These cases share the generic suite and its isolated standard-library build.
(def (iterator-preparation-test-cases!)
  (test-case "iterator preparation retains execution authority before nested effects"
    (def live #t) (def effects 0) (def opens 0)
    (def nested (generator.make-generator (lambda (_r _s) (set! effects (1+ effects)) 0) (lambda (_) [])))
    (def input (generator.make-tree-generator (lambda (_r _s)
      (generator.make-sample 2 (lambda () (make-prepared-children (lambda ()
        (set! opens (1+ opens)) (set! live #f)
        (generator.generate nested (generator.random-at 1) 0) (in-list []))))))
      current?: (lambda () live)))
    (def report (property.check-property input (lambda (_) #f)
      (property.make-specification exact-integer? abs) cases: 1 shrink-budget: 1))
    (check-eq? (property.report-status report) 'stale)
    (check-equal? (list effects opens (property.report-attempts report)
      (property.report-steps report) (property.report-counterexample report)) '(0 1 0 0 2)))
  (test-case "bounded inspection owns standard iterator preparation without charging a proposal"
    (def live #t) (def effects 0) (def opens 0)
    (def nested (generator.make-generator (lambda (_r _s) (set! effects (1+ effects)) 0) (lambda (_) [])))
    (def input (generator.make-tree-generator (lambda (_r _s)
      (generator.make-sample 2 (lambda () (make-prepared-children (lambda ()
        (set! opens (1+ opens)) (set! live #f)
        (generator.generate nested (generator.random-at 1) 0) (in-list []))))))
      current?: (lambda () live)))
    (def inspected (property.inspect-generator input (property.make-specification exact-integer? abs)
      count: 1 depth: 1 proposal-budget: 1))
    (check-eq? (property.inspection-status inspected) 'stale)
    (check-equal? (list effects opens (property.inspection-draws inspected)
      (property.inspection-attempts inspected)) '(0 1 1 0)))
  (test-case "map bind and fixed products retain authority during direct iterable conversion"
    (for (compose (list (lambda (input) (generator.generator-map input (lambda (value) value)))
                       (lambda (input) (generator.generator-bind input generator.generator-unit))
                       (lambda (input) (generator.generator-sequence (list input)))))
      (def live #t) (def effects 0) (def opens 0)
      (def nested (generator.make-generator (lambda (_r _s) (set! effects (1+ effects)) 0) (lambda (_) [])))
      (def input (generator.make-tree-generator (lambda (_r _s)
        (generator.make-sample 2 (lambda () (make-prepared-children (lambda ()
          (set! opens (1+ opens)) (set! live #f)
          (generator.generate nested (generator.random-at 1) 0) (in-list []))))))
        current?: (lambda () live)))
      (def tree (generator.generate (compose input) (generator.random-at 4) 0))
      (check-exception (using (cursor (iter ((generator.sample-children tree))) :- Iterator)
        (cursor.next!)) generator.stale-generation?)
      (check-equal? (list effects opens) '(0 1))))
  (test-case "iterator preparation preserves factory priority exact causes zero demand and EOF"
    (for (mode '(zero factory conversion malformed stable))
      (def live #t) (def factories 0) (def opens 0)
      (def cause (cons 'iterator 'preparation))
      (def input (generator.make-tree-generator (lambda (_r _s)
        (generator.make-sample 2 (lambda ()
          (set! factories (1+ factories))
          (when (eq? mode 'factory) (set! live #f))
          (if (eq? mode 'malformed) 7
            (make-prepared-children (lambda ()
              (set! opens (1+ opens))
              (if (eq? mode 'conversion) (raise cause)
                (in-list (list (generator.make-sample 0 (lambda () [])))))))))))
        current?: (lambda () live)))
      (def report (property.check-property input (lambda (_) #f)
        (property.make-specification exact-integer? abs) cases: 1 shrink-budget: (if (eq? mode 'zero) 0 2)))
      (check-eq? (property.report-status report)
        (case mode ((factory) 'stale) ((conversion malformed) 'error) (else 'failed)))
      (check-equal? (list factories opens (property.report-attempts report) (property.report-steps report))
        (case mode ((zero) '(0 0 0 0)) ((factory malformed) '(1 0 0 0))
          ((conversion) '(1 1 0 0)) (else '(1 1 1 1))))
      (when (eq? mode 'conversion) (check-eq? (property.report-cause report) cause))
      (when (eq? mode 'stable)
        (check-equal? (property.report-counterexample report) 0)
        (check (property.report-minimal? report) => #t)))
    ;; A thrown false is a present callback cause, never normal EOF or stale.
    (def input (generator.make-tree-generator (lambda (_r _s)
      (generator.make-sample 1 (lambda () (make-prepared-children (lambda () (raise #f))))))))
    (def report (property.check-property input (lambda (_) #f)
      (property.make-specification exact-integer? abs) cases: 1 shrink-budget: 1))
    (check-eq? (property.report-status report) 'error)
    (check-eq? (property.report-cause report) #f)
    (check-equal? (property.report-attempts report) 0)))
