;;; ProtectedDispatch: independently installed document/channel extensions.
(export make-dispatch invoice report card bank path protected watches release-family)
(import :std/iter
        (only-in ../object .o .@ .mix)
        (only-in ../mop Object Bool)
        (only-in ../number IntegerRange)
        (only-in ../type List)
        (prefix-in ../multimethod multimethod.)
        (prefix-in ../dispatch-extension dispatch-extension.))
(def document (.o))
(def financial (.o (:: @ document)))
(def sensitive (.o (:: @ document)))
(def invoice (.mix financial sensitive))
(def report (.o (:: @ document)))
(def channel (.o))
(def card (.o (:: @ channel)))
(def bank (.o (:: @ channel)))
(def names (make-hash-table-eq))
(for (entry (list (cons document 'Document) (cons financial 'Financial) (cons sensitive 'Sensitive) (cons invoice 'Invoice) (cons report 'Report)
                   (cons channel 'Channel) (cons card 'Card) (cons bank 'Bank)))
  (hash-put! names (car entry) (cdr entry)))
(def (precedence args)
  (map (lambda (object) (multimethod.prototype-precedence object (cut hash-ref names <>))) (take args 2)))
(def (path document channel) (list (multimethod.prototype document) (multimethod.prototype channel)))
(def amount-type (IntegerRange min: 0))
(def (make-dispatch (width 0))
  (def base (multimethod.make (list Object Object amount-type) (List amount-type) precedence
               (lambda (methods args) (map (lambda (method) (apply method args)) methods)) 2))
  (def direct (multimethod.register base (path 'Invoice 'Card) (lambda (_ __ amount) (+ amount 3))))
  ;; Indexed but unrelated branches exercise sparse lookup and transaction cost.
  (for/fold (current direct) (index (in-range width))
    (multimethod.register current (path (string->symbol (string-append "External" (number->string index))) 'Bank)
                         (lambda (_ __ amount) amount))))
(def (watches)
  (list (dispatch-extension.call invoice bank 10)
        (dispatch-extension.shape '((Report Document) (Bank Channel)))))
(def (protected (width 0)) (dispatch-extension.check (make-dispatch width) (watches)))
(def (release-family view (width 0))
  ;; Different signatures and result types, staged by CyclicPublication together.
  (list (cons 'fee (protected width))
        (cons 'enabled (dispatch-extension.check
          (multimethod.register (multimethod.make [] Bool (lambda (_) [])) [] (lambda () (.@ view release))) []))))
