;;; Downstream PBT workflows use records, ordinary ports and the standard TestSuite.
(export property-workflows-test main)
(import :std/test :std/error :std/iter :std/io/tempfile
        (only-in :std/misc/process run-process) (only-in :std/misc/ports read-all-as-lines)
        (prefix-in :clan/poo/testing/property/test assertion.)
        (prefix-in :clan/poo/testing/property/generator g.)
        (prefix-in :clan/poo/testing/property p.)
        (prefix-in :clan/poo/testing/property/replay r.))
;; The same explicit domain is used before and after serializing a counterexample.
(def integer-domain (p.make-specification exact-integer? abs))
;; Portable identity names the application's format, specification and generator.
(def (ledger-codec (identity 'ledger-v1)) (r.make-codec identity values values))
;; This property intentionally exposes a small, replayable ledger error.
(def (ledger-property value) (< value 3))
;; The standard module-action loader can execute this in a fresh process.
(def (main file (identity "ledger-v1"))
  (unless (eq? (call-with-input-file file
    (lambda (port) (r.read-counterexample (ledger-codec (string->symbol identity))
      port integer-domain ledger-property))) #f) (error "expected a failing ledger witness"))
  (displayln "REPLAY-FAILED"))
;; Named syntax expands into the existing runner, preserving property identity.
(p.define-property (named-ledger value) (g.generator-unit 2) integer-domain (< value 3))
;; One workflow owns source revisions, so stale generators and retained functions agree.
;; Exercise PBT failure propagation through the official CLI and the existing
;; Just admission guard. The fixture tests this library's checks, not Gerbil recipes.
(def (check-standard-refusals)
  (def fixture (path-expand "lib/clan/poo/examples/property-refusals.ssi" (getenv "GERBIL_PATH")))
  (def timeout (car (run-process '("sh" "-c" "command -v gtimeout || command -v timeout")
    coprocess: read-all-as-lines)))
  (def exit-status #f)
  (def lines (run-process (list timeout "--signal=TERM" "--kill-after=3s" "90s" "just" "test-file" fixture)
    stderr-redirection: #t coprocess: read-all-as-lines
    check-status: (lambda (status _settings) (set! exit-status status))))
  ;; A completed refusal is guard exit 1 or gxtest exit 42, in POSIX wait format.
  ;; Timeout, spawn refusal and signal termination cannot satisfy this control.
  (check (and (memv exit-status '(#x100 #x2a00)) #t) => #t)
  (unless (= (length (filter (cut string-prefix? "CASE " <>) lines)) 8)
    (error "PBT refusal fixture did not execute all eight cases" lines))
  (check-equal? (filter (cut string-prefix? "CASE-OK " <>) lines) [])
  (check-equal? (filter (cut string=? "OK" <>) lines) [])
  (def text (string-join lines "\n"))
  (for (detail '("status . failed" "status . coverage" "status . exhausted" "status . stale"
                "status . error" "status . unsupported" "left . 4" "right . 5"
                "left . 1" "right . 2" "minimal? . #t" "seed . 42" "typed-fault" "typed-opaque" "input . 4" "limit . 3" "property-refusals.ss\"@"))
    (check (string-contains text detail) ? integer?)))
;; Ordinary suites combine the new assertion path with the existing report API.
(def property-workflows-test
  (test-suite "coverage portable replay and finite functions"
    (test-case "paused value shrink iterators refuse before the next producer effect"
      (def live #t) (def pulls 0) (def first #f)
      (def generation (g.make-generator (lambda (_random _size) 9)
        (lambda (_) (in-coroutine (lambda (yield)
          (set! pulls (1+ pulls)) (yield 8)
          (set! pulls (1+ pulls)) (yield 7)))) current?: (lambda () live)))
      (def root (g.generate generation (g.random-at 17) 3))
      ;; One exception scope owns both coroutine pulls and their continuations.
      (check-exception (using (children (iter ((g.sample-children root))) :- Iterator)
        (set! first (g.sample-value (children.next!)))
        (set! live #f) (children.next!)) g.stale-generation?)
      (check-equal? first 8)
      (check-equal? pulls 1))
    (test-case "composed shrink iterators guard every resume through the shared protocol"
      (for (kind '(map filter bind sequence function))
        (let ((live #t) (pulls 0))
          (def source (g.make-generator (lambda (_random _size) 9)
            (lambda (_) (in-coroutine (lambda (yield)
              (set! pulls (1+ pulls)) (yield 8)
              (set! pulls (1+ pulls)) (yield 7))))))
          (def guard (lambda () live))
          (def generation (case kind
            ((map) (g.generator-map source (lambda (value) value) current?: guard))
            ((filter) (g.generator-filter source positive? current?: guard))
            ((bind) (g.generator-bind source g.generator-unit current?: guard))
            ((sequence) (g.make-tree-generator (lambda (random size)
              (g.sample-sequence (list (g.generate source random size)))) current?: guard))
            (else (g.generator-function '((0)) (g.generator-map source list) current?: guard))))
          (def root (g.generate generation (g.random-at 17) 3))
          (check-exception (using (children (iter ((g.sample-children root))) :- Iterator)
            ;; Structural proposals may precede the first value-coordinate pull.
            (let/cc found
              (for (_ (in-range 8))
                (when (eq? (children.next!) #!eof) (error "missing coordinate proposal"))
                (when (= pulls 1) (found #t)))
              (error "coordinate proposal budget exceeded"))
            (set! live #f) (children.next!)) g.stale-generation?)
          (check-equal? pulls 1))))
    (test-case "rebuilt bind children retain the originally selected branch sources"
      (def epoch 0) (def selections 0)
      (def generation (g.generator-bind
        (g.make-generator (lambda (_random _size) 3)
          (lambda (value) (if (> value 0) (list (1- value)) [])))
        (lambda (value)
          (set! selections (1+ selections))
          (let (stamp epoch)
            (g.make-generator (lambda (_random _size) value) (lambda (_) [])
              current?: (lambda () (or (not (= value 3)) (= stamp epoch))))))))
      (def root (g.generate generation (g.random-at 17) 3))
      (def smaller (car (for/collect (child ((g.sample-children root))) child)))
      (check-equal? (g.sample-value smaller) 2)
      (set! epoch 1)
      (check-eq? ((g.sample-current smaller)) #f)
      (let (before selections)
        (check-exception (for/collect (child ((g.sample-children smaller))) child) g.stale-generation?)
        (check-equal? selections before))
      ;; Fresh invocation captures the new epoch; no generated value cache is reused.
      (def fresh (g.generate generation (g.random-at 17) 3))
      (check-eq? ((g.sample-current fresh)) #t))
    (test-case "iterator exceptions preserve their cause when a pull changes sources"
      (def live #t) (def cause (cons 'iterator 'interrupted))
      (def generation (g.make-generator (lambda (_random _size) 9)
        (lambda (_) (in-coroutine (lambda (_yield) (set! live #f) (raise cause))))
        current?: (lambda () live)))
      (def root (g.generate generation (g.random-at 17) 3))
      (check-eq? (with-catch values (lambda ()
        (using (children (iter ((g.sample-children root))) :- Iterator) (children.next!)))) cause))
    (test-case "portable replay enforces preconditions without generating coverage"
      (def report (p.check-property (g.generator-unit 4) ledger-property integer-domain cases: 1))
      (def output (open-output-string))
      (r.write-counterexample report (ledger-codec) output)
      (def text (get-output-string output))
      (def calls [])
      (def policy (p.make-policy precondition: (lambda (value)
        (set! calls (cons 'precondition calls)) (= value 4))
        labels: (lambda (_) (error "concrete replay must not classify a trial"))
        required: '((install . 10))))
      (for (outcome '(#f #t))
        (set! calls [])
        (check-eq? (r.read-counterexample (ledger-codec) (open-input-string text) integer-domain
          (lambda (_) (set! calls (cons 'property calls)) outcome) policy: policy) outcome)
        (check-equal? (reverse calls) '(precondition property)))
      (set! calls [])
      (check-exception (r.read-counterexample (ledger-codec) (open-input-string text) integer-domain
        (lambda (_) (set! calls (cons 'property calls)) #f)
        policy: (p.make-policy precondition: (lambda (_) #f))) Error?)
      (check-equal? calls []))
    (test-case "invalid portable policy refuses before application decoding"
      (def report (p.check-property (g.generator-unit 4) ledger-property integer-domain cases: 1))
      (def output (open-output-string))
      (r.write-counterexample report (ledger-codec) output)
      (def decodes 0)
      (def codec (r.make-codec 'ledger-v1 values (lambda (value) (set! decodes (1+ decodes)) value)))
      (check-exception (r.read-counterexample codec (open-input-string (get-output-string output))
        integer-domain ledger-property policy: #f) Error?)
      (check-equal? decodes 0))
    (test-case "in-memory precondition revisions refuse before domain and fixture effects"
      (def live #t) (def armed #f) (def domains 0) (def fixtures 0)
      (def domain (p.make-specification (lambda (value) (set! domains (1+ domains)) (exact-integer? value))
        abs current?: (lambda () live)))
      (def policy (p.make-policy precondition: (lambda (_) (when armed (set! live #f)) #t)))
      (def report (p.check-property (g.generator-unit 4)
        (lambda (_) (set! fixtures (1+ fixtures)) #f) domain cases: 1 policy: policy))
      (set! domains 0) (set! fixtures 0) (set! armed #t)
      (check-exception (p.replay-counterexample report) Error?)
      (check-equal? (list domains fixtures) '(0 0)))
    (test-case "portable precondition revisions stop codec and domain admission chains"
      (def report (p.check-property (g.generator-unit 4) ledger-property integer-domain cases: 1))
      (def output (open-output-string))
      (r.write-counterexample report (ledger-codec) output)
      (def text (get-output-string output))
      (for (changed '(domain codec))
        (let* ((domain-live #t) (codec-live #t) (domains 0) (fixtures 0)
               (domain (p.make-specification (lambda (_) (set! domains (1+ domains)) #t)
                 abs current?: (lambda () domain-live)))
               (codec (r.make-codec 'ledger-v1 values values current?: (lambda () codec-live)))
               (policy (p.make-policy precondition: (lambda (_)
                 (if (eq? changed 'domain) (set! domain-live #f) (set! codec-live #f)) #t))))
          (check-exception (r.read-counterexample codec (open-input-string text) domain
            (lambda (_) (set! fixtures (1+ fixtures)) #f) policy: policy) Error?)
          (check-equal? (list domains fixtures) '(0 0)))))
    (test-case "witness admission preserves strict Boolean refusals and original causes"
      (for (outcome '(refuse malformed throw))
        (let* ((domains 0) (fixtures 0) (cause (cons outcome 'precondition))
               (domain (p.make-specification (lambda (_) (set! domains (1+ domains)) #t) abs))
               (policy (p.make-policy precondition: (lambda (_)
                 (case outcome ((refuse) #f) ((malformed) 'truthy) (else (raise cause))))))
               (invoke (lambda () (p.check-counterexample 4
                 (lambda (_) (set! fixtures (1+ fixtures)) #f) domain policy: policy))))
          (if (eq? outcome 'throw) (check-eq? (with-catch values invoke) cause)
            (check-exception (invoke) Error?))
          (check-equal? (list domains fixtures) '(0 0)))))
    (test-case "confirmation revisions refuse before encoding and require a fresh codec"
      (def epoch 0) (def exporting? #f) (def calls 0) (def encodes 0)
      (def report (p.check-property (g.generator-unit 4) (lambda (_)
        (set! calls (1+ calls))
        (when (and exporting? (zero? epoch)) (set! epoch 1)) #f) integer-domain cases: 1))
      (def codec (r.make-codec '(ledger 1) (lambda (value) (set! encodes (1+ encodes)) value)
        values current?: (lambda () (zero? epoch))))
      (def output (open-output-string))
      (set! exporting? #t)
      (check-exception (r.write-counterexample report codec output) Error?)
      (check-equal? encodes 0)
      (check-equal? (get-output-string output) "")
      (check (p.report-current? report) => #t)
      (let (before calls)
        (check-exception (r.write-counterexample report codec output) Error?)
        (check-equal? calls before))
      ;; Only codec preparation changes: the failing integer specification is stable.
      (def fresh (r.make-codec '(ledger 2) values values current?: (lambda () (= epoch 1))))
      (r.write-counterexample report fresh output)
      (check-eq? (r.read-counterexample fresh (open-input-string (get-output-string output))
        integer-domain (lambda (_) #f)) #f))
    (test-case "stale read preflight preserves the input before decoding or property effects"
      (def report (p.check-property (g.generator-unit 4) (lambda (_) #f) integer-domain cases: 1))
      (def output (open-output-string))
      (r.write-counterexample report (ledger-codec) output)
      (def text (get-output-string output))
      (def expected (read (open-input-string text)))
      (for (changed '(domain codec))
        (let* ((decodes 0) (calls 0) (input (open-input-string text))
               (domain (p.make-specification exact-integer? abs current?: (lambda () (not (eq? changed 'domain)))))
               (codec (r.make-codec 'ledger-v1 values (lambda (value) (set! decodes (1+ decodes)) value)
                 current?: (lambda () (not (eq? changed 'codec))))))
          (check-exception (r.read-counterexample codec input domain
            (lambda (_) (set! calls (1+ calls)) #f)) Error?)
          (check-equal? (read input) expected)
          (check-equal? (list decodes calls) '(0 0)))))
    (test-case "confirmation exceptions retain their cause even after codec invalidation"
      (def live #t) (def exporting? #f) (def encodes 0) (def cause (cons 'confirmation 'interrupted))
      (def report (p.check-property (g.generator-unit 4) (lambda (_)
        (if exporting? (begin (set! live #f) (raise cause)) #f)) integer-domain cases: 1))
      (def codec (r.make-codec 'cause (lambda (value) (set! encodes (1+ encodes)) value)
        values current?: (lambda () live)))
      (def output (open-output-string))
      (set! exporting? #t)
      (check-eq? (with-catch values (lambda () (r.write-counterexample report codec output))) cause)
      (check-equal? encodes 0)
      (check-equal? (get-output-string output) ""))
    (test-case "stale codecs refuse export before invoking properties or encoders"
      (let* ((calls 0) (encodes 0)
             (report (p.check-property (g.generator-unit 4) (lambda (_) (set! calls (1+ calls)) #f) integer-domain cases: 1))
             (codec (r.make-codec 'stale (lambda (value) (set! encodes (1+ encodes)) value) values current?: (lambda () #f)))
             (output (open-output-string)))
        (set! calls 0)
        (check-exception (r.write-counterexample report codec output) Error?)
        (check-equal? (list calls encodes (get-output-string output)) '(0 0 ""))))
    (test-case "export encoder revisions refuse before writing any corpus prefix"
      (for (changed '(report codec))
        (let* ((domain-live #t) (codec-live #t)
               (domain (p.make-specification exact-integer? abs current?: (lambda () domain-live)))
               (report (p.check-property (g.generator-unit 4) (lambda (_) #f) domain cases: 1))
               (codec (r.make-codec 'revision (lambda (value)
                 (if (eq? changed 'report) (set! domain-live #f) (set! codec-live #f)) value)
                 values current?: (lambda () codec-live)))
               (output (open-output-string)))
          (check-exception (r.write-counterexample report codec output) Error?)
          (check-equal? (get-output-string output) ""))))
    (test-case "replay preflight and decoder revisions never open a property fixture"
      (def report (p.check-property (g.generator-unit 4) ledger-property integer-domain cases: 1))
      (def output (open-output-string))
      (r.write-counterexample report (ledger-codec) output)
      (def text (get-output-string output))
      (for* ((phase '(before after)) (changed '(domain codec)))
        (let* ((domain-live (not (and (eq? phase 'before) (eq? changed 'domain))))
               (codec-live (not (and (eq? phase 'before) (eq? changed 'codec))))
               (decodes 0) (fixtures 0)
               (domain (p.make-specification exact-integer? abs current?: (lambda () domain-live)))
               (codec (r.make-codec 'ledger-v1 values (lambda (value)
                 (set! decodes (1+ decodes))
                 (if (eq? changed 'domain) (set! domain-live #f) (set! codec-live #f)) value)
                 current?: (lambda () codec-live))))
          (check-exception (r.read-counterexample codec (open-input-string text) domain
            (lambda (_) (set! fixtures (1+ fixtures)) #f)) Error?)
          (check-equal? fixtures 0)
          (check-equal? decodes (if (eq? phase 'before) 0 1)))))
    (test-case "replay errors preserve causes and reject post-property codec changes"
      (def report (p.check-property (g.generator-unit 4) ledger-property integer-domain cases: 1))
      (def output (open-output-string))
      (r.write-counterexample report (ledger-codec) output)
      (def text (get-output-string output))
      (for (outcome '(return throw))
        (let* ((live #t) (cleanups 0) (cause (cons 'property 'failure))
               (codec (r.make-codec 'ledger-v1 values values current?: (lambda () live)))
               (invoke (lambda () (r.read-counterexample codec (open-input-string text) integer-domain
                 (lambda (_) (try
                   (set! live #f) (if (eq? outcome 'throw) (raise cause) #f)
                   (finally (set! cleanups (1+ cleanups)))))))))
          (if (eq? outcome 'throw)
            (check-eq? (with-catch values invoke) cause)
            (check-exception (invoke) Error?))
          (check-equal? cleanups 1))))
    (test-case "codec exceptions retain causes after invalidating their own source"
      (def report (p.check-property (g.generator-unit 4) ledger-property integer-domain cases: 1))
      (def output (open-output-string))
      (r.write-counterexample report (ledger-codec) output)
      (def text (get-output-string output))
      (for (stage '(encode decode))
        (let* ((live #t) (cause (cons stage 'fault)) (destination (open-output-string))
               ;; A failing callback is not replaced by the later stale refusal.
               (fault (lambda (_) (set! live #f) (raise cause)))
               (codec (r.make-codec 'ledger-v1 (if (eq? stage 'encode) fault values)
                 (if (eq? stage 'decode) fault values) current?: (lambda () live))))
          (check-eq? (with-catch values (lambda ()
            (if (eq? stage 'encode) (r.write-counterexample report codec destination)
              (r.read-counterexample codec (open-input-string text) integer-domain ledger-property)))) cause)
          (check-equal? (get-output-string destination) ""))))
    (test-case "mixed Unicode and byte data replay owns copies and charges byte budgets"
      (def witness (vector #\x10ffff "λ\x00;" (string->symbol "a b") (list->u8vector '(0 128 255))))
      (def domain (p.make-specification (lambda (value)
        (and (vector? value) (= (vector-length value) 4) (u8vector? (vector-ref value 3)))) (lambda (_) 0)))
      (def report (p.check-property (g.generator-unit witness) (lambda (_) #f) domain cases: 1))
      (def output (open-output-string))
      (r.write-counterexample report (r.make-codec 'data-v1 values values) output)
      (def text (get-output-string output))
      (u8vector-set! (vector-ref witness 3) 0 99)
      (check-eq? (r.read-counterexample (r.make-codec 'data-v1 values values) (open-input-string text) domain
        (lambda (value) (not (equal? value (vector #\x10ffff "λ\x00;" (string->symbol "a b") #u8(0 128 255)))))) #f)
      (def bytes-report (p.check-property (g.generator-unit #u8(1 2 3 4)) (lambda (_) #f)
        (p.make-specification u8vector? u8vector-length) cases: 1))
      (def refused (open-output-string))
      (check-exception (r.write-counterexample bytes-report (r.make-codec 'bytes values values nodes: 4) refused) Error?)
      (check-equal? (get-output-string refused) ""))
    (test-case "non-passing property checks refuse the public test entry"
      (check-standard-refusals))
    (test-case "diagnostics retain binding names cause identity and source admission"
      (def cause (cons 'original 'cause))
      (def failed (p.check-property (g.generator-unit 2) (lambda (_) (raise cause)) integer-domain cases: 1))
      (check-eq? (cdr (assq 'cause (p.report-diagnostics failed))) cause)
      (def live #t)
      (def passed (p.check-property (g.make-generator (lambda (_random _size) 2) (lambda (_) [])
        current?: (lambda () live)) positive? integer-domain cases: 1))
      (set! live #f)
      (check-eq? (p.report-status passed) 'passed)
      (check-eq? (cdr (assq 'status (p.report-diagnostics passed))) 'stale)
      (def product (p.make-product-specification (list integer-domain integer-domain)))
      (check-eq? (p.report-status (p.check-property (g.generator-unit '(1 2))
        (lambda (_) #t) product cases: 1)) 'passed)
      (check-eq? (p.report-status (p.check-property (g.generator-unit '(1 2 3))
        (lambda (_) #t) product cases: 1)) 'error)
      (check-exception (p.report-diagnostics passed bindings: '(same same)) Error?))
    (test-case "effective trials classify once and reject unmet coverage"
      (def policy (p.make-policy name: 'ledger
        labels: (lambda (value) (if (even? value) '(even even) '(odd))) required: '((even . 3))))
      (def good (p.check-property (g.generator-unit 2) ledger-property integer-domain cases: 3 policy: policy))
      (check-eq? (p.report-status good) 'passed)
      (check-equal? (p.report-labels good) '((even . 3)))
      (check-equal? (list (p.report-accepted good) (p.report-discarded good)) '(3 0))
      (check-eq? (p.report-name (named-ledger cases: 1)) 'named-ledger)
      (check-eq? (p.report-status (p.check-property (g.generator-unit 1) ledger-property integer-domain
        cases: 3 policy: policy)) 'coverage))
    (test-case "discard exhaustion never becomes successful coverage"
      (def calls 0)
      (def report (p.check-property (g.generator-unit 2)
        (lambda (_) (set! calls (1+ calls)) #t) integer-domain cases: 2
        policy: (p.make-policy precondition: (lambda (_) #f) discard-budget: 3)))
      (check-eq? (p.report-status report) 'exhausted)
      (check-equal? calls 0)
      (check-equal? (p.report-discarded report) 4)
      (check-equal? (p.report-accepted report) 0))
    (test-case "shrinks preserve preconditions without inflating labels"
      (def labels 0)
      (def report (p.check-property (g.make-generator (lambda (_random _size) 8) g.integer-shrinks)
        (lambda (_) #f) integer-domain cases: 5
        policy: (p.make-policy precondition: positive?
          labels: (lambda (_) (set! labels (1+ labels)) '(retry)) required: '((retry . 5)))))
      (check-eq? (p.report-status report) 'failed)
      (check-equal? (p.report-counterexample report) 1)
      (check-equal? labels 1)
      (check-equal? (p.report-labels report) '((retry . 1)))
      (check-eq? (p.replay-counterexample report) #f)
      (check-eq? (p.report-status (p.replay-property report)) 'failed))
    (test-case "classification errors and invalid policies retain refusal"
      (check-exception (p.make-policy required: '((retry . -1))) Error?)
      (check-eq? (p.report-status (p.check-property (g.generator-unit 1) ledger-property integer-domain
        policy: (p.make-policy labels: (lambda (_) #f)))) 'error))
    (test-case "portable data replay refuses identity before any decoder or fixture"
      (def report (p.check-property (g.generator-unit 4) ledger-property integer-domain cases: 1))
      (def output (open-output-string))
      (r.write-counterexample report (ledger-codec) output)
      (def text (get-output-string output))
      (check-eq? (r.read-counterexample (ledger-codec) (open-input-string text) integer-domain ledger-property) #f)
      (def cause (cons 'callback 'refusal))
      (check-eq? (with-catch values (lambda ()
        (r.read-counterexample (ledger-codec) (open-input-string text) integer-domain
          (lambda (_) (raise cause))))) cause)
      (def calls 0)
      (check-exception (r.read-counterexample
        (r.make-codec 'changed values (lambda (value) (set! calls (1+ calls)) value))
        (open-input-string text) integer-domain ledger-property) Error?)
      (check-equal? calls 0)
      (check-exception (r.read-counterexample (ledger-codec)
        (open-input-string (string-append text " extra")) integer-domain ledger-property) Error?))
    (test-case "codec failures are atomic before writes and stale sources refuse"
      (def report (p.check-property (g.generator-unit 4) ledger-property integer-domain cases: 1))
      (def output (open-output-string))
      (check-exception (r.write-counterexample report (r.make-codec 'bad (lambda (_) values) values) output) Error?)
      (check-equal? (get-output-string output) "")
      (check-exception (r.write-counterexample report
        (r.make-codec 'bad values values current?: (lambda () #f)) output) Error?)
      (check-exception (r.write-counterexample report
        (r.make-codec 'bad (lambda (_) '(1 2 3)) values nodes: 2) output) Error?))
    (test-case "a fresh process restores the concrete counterexample"
      (call-with-temporary-directory "property-replay-" (lambda (directory)
        (def file (path-expand "witness.scm" directory))
        (def report (p.check-property (g.generator-unit 4) ledger-property integer-domain cases: 1))
        (call-with-output-file file (cut r.write-counterexample report (ledger-codec) <>))
        (def timeout (car (run-process '("sh" "-c" "command -v gtimeout || command -v timeout") coprocess: read-all-as-lines)))
        (def lines (run-process (list timeout "--signal=TERM" "--kill-after=3s" "30s"
          (path-expand "bin/representation-main" (getenv "GERBIL_PATH")) "-:max-heap=1G,debug=q"
          "clan/poo/examples/property-workflows" "clan/poo/examples/property-workflows#main" file)
          coprocess: read-all-as-lines))
        (check (and (member "REPLAY-FAILED" lines) #t) => #t))))
    (test-case "finite function tuples shrink with repeatable multi-value calls"
      (def results (g.make-generator (lambda (_random _size) '(8 8))
        (lambda (tuple) (if (zero? (car tuple)) [] (list '(0 0) (map (cut quotient <> 2) tuple))))))
      (def functions (g.generator-function '((1) (2) (1 scale: 2)) results))
      (def tree (g.generate functions (g.random-at 42) 10))
      (def value (g.sample-value tree))
      (check-equal? (g.function-apply value '(1)) '(8 8))
      (check-equal? (call-with-values (cut (g.function-procedure value) 1 scale: 2) list) '(8 8))
      (check-exception ((g.function-procedure value) 99) Error?)
      (check-exception (g.generator-function '((1) (1)) results) Error?)
      (check-exception (g.generator-function '((1)) results domain-limit: 0) Error?)
      (def domain (p.make-specification g.function-value?
        (lambda (function) (apply + (g.function-apply function '(1))))))
      (def report (p.check-property functions (lambda (function) (< (car (g.function-apply function '(1))) 3)) domain cases: 1))
      (check-eq? (p.report-status report) 'failed)
      (check-equal? (car (g.function-apply (p.report-counterexample report) '(1))) 4)
      (check-eq? (p.replay-counterexample report) #f))
    (test-case "function counterexamples restore from finite tables without closures"
      (def generator (g.generator-function '((1) (2)) (g.generator-unit '(4 5))))
      (def domain (p.make-specification g.function-value? (lambda (_) 0)))
      (def property (lambda (function) (< (car (g.function-apply function '(1))) 3)))
      (def report (p.check-property generator property domain cases: 1))
      (def codec (r.make-codec '(function-table 1) g.function-table g.function-from-table))
      (def port (open-output-string))
      (r.write-counterexample report codec port)
      (check (r.read-counterexample codec (open-input-string (get-output-string port)) domain property) => #f)
      (check-exception (g.function-from-table '(((1) . (4)) ((1) . (5)))) Error?))
    (test-case "retained function calls and replay reject stale branch sources"
      (def live #t)
      (def functions (g.generator-function '((1)) (g.generator-unit '(2)) current?: (lambda () live)))
      (def value (g.sample-value (g.generate functions (g.random-at 1) 0)))
      (set! live #f)
      (check-exception ((g.function-procedure value) 1) g.stale-generation?))))
