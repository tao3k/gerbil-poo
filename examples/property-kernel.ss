;;; Independent-library examples: standard Gerbil plus the generic testing modules.
(export property-kernel-test)
(import :std/test :std/error :std/iter
        (prefix-in (only-in :clan/property-testing/generator make-generator generator-unit generator-map generator-bind generator-sequence) generator.)
        (prefix-in :clan/property-testing/property property.)
        (prefix-in :clan/property-testing/model model.))

;; A dependent packet exposes its generated count and its matching payload.
(defstruct packet (count payload) final: #t)
;; Domain admission is explicit; neither the kernel nor the example assumes Any.
(def (packet-valid? value)
  (and (packet? value) (exact-integer? (packet-count value)) (>= (packet-count value) 0)
    (list? (packet-payload value)) (= (packet-count value) (length (packet-payload value)))
    (every exact-integer? (packet-payload value))))
;; Count drives the tested failure; payload changes deliberately have zero cost.
(def packet-domain (property.make-specification packet-valid? packet-count))
;; Parent shrinking stays in its own nonnegative domain before dependent selection.
(def (count-shrinks count)
  (if (zero? count) [] (list 0 (quotient count 2) (1- count))))
;; Strict protocol diagnostics distinguish stale refusal from unrelated host errors.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))
;; Equal seed replay compares observable evidence, not private closure identity.
(def (same-failure left right)
  (check-equal? (property.report-status right) 'failed)
  (check-equal? (property.report-original right) (property.report-original left))
  (check-equal? (property.report-counterexample right) (property.report-counterexample left))
  (check-equal? (property.report-attempts right) (property.report-attempts left)))

;; This suite can be copied with testing/core/{generator,property,model}.ss into a
;; fresh Gerbil project and run without POO modules, descriptors or object hooks.
(def property-kernel-test
  (test-suite "independent Gerbil property kernel"
    (test-case "non-injective map retains negative preimages while shrinking"
      (def seen [])
      (def source (generator.make-generator (lambda (_random _size) -9)
        (lambda (n) (set! seen (cons n seen)) (if (zero? n) [] (list 0 (quotient n 2))))))
      (def mapped (generator.generator-map source abs))
      (def domain (property.make-specification (lambda (n) (and (exact-integer? n) (>= n 0))) abs))
      (def report (property.check-property mapped (lambda (n) (< n 2)) domain cases: 1))
      (check-equal? (property.report-status report) 'failed)
      (check-equal? (property.report-counterexample report) 2)
      (check (and (memv -9 seen) (memv -4 seen) #t) => #t)
      (check (property.replay-counterexample report) => #f)
      (same-failure report (property.replay-property report)))
    (test-case "dependent bind preserves packet length through shrinking and both replays"
      (def versions (make-hash-table-eqv)) (def selections 0) (def draws 0)
      (def counts (generator.make-generator (lambda (_random _size) 6) count-shrinks))
      ;; Each selected child captures its OWN source epoch and its parent count.
      (def (payload count)
        (set! selections (1+ selections))
        (def stamp (hash-ref versions count 0))
        (generator.generator-map
          (generator.make-generator
            (lambda (random _size) (set! draws (1+ draws))
              (for/collect (_ (in-range count)) (1+ (random 4))))
            (lambda (values) (if (every zero? values) [] (list (make-list count 0))))
            current?: (lambda () (= stamp (hash-ref versions count 0))))
          (lambda (values) (make-packet count values))))
      (def generator (generator.generator-bind counts payload))
      (def report (property.check-property generator (lambda (value) (< (packet-count value) 2))
        packet-domain seed: 41 cases: 1 shrink-budget: 96))
      (check-equal? (property.report-status report) 'failed)
      (check (packet-valid? (property.report-counterexample report)) => #t)
      (check-equal? (packet-count (property.report-counterexample report)) 2)
      (let ((before-selections selections) (before-draws draws))
        (check (property.replay-counterexample report) => #f)
        (check-equal? selections before-selections) (check-equal? draws before-draws))
      (same-failure report (property.replay-property report))
      ;; Changing only the ORIGINAL count-6 branch must also refuse replay after
      ;; the final witness has moved to a count-2 branch with unchanged metadata.
      (hash-put! versions 6 1)
      (check-exception (property.replay-property report) (message? "stale property replay"))
      (check-exception (property.replay-counterexample report) (message? "stale property replay")))
    (test-case "zero and one attempt force no unused shrink callbacks or iterator tail"
      (def started 0) (def pulled 0)
      (def generator (generator.make-generator (lambda (_random _size) 9)
        (lambda (_)
          (set! started (1+ started))
          (in-coroutine (lambda (yield)
            (set! pulled (1+ pulled)) (yield 8) (error "unused iterator tail"))))))
      (def domain (property.make-specification exact-integer? abs))
      (def zero (property.check-property generator (lambda (_) #f) domain cases: 1 shrink-budget: 0))
      (check-equal? (list (property.report-status zero) started pulled) '(failed 0 0))
      (def one (property.check-property generator (lambda (_) #f) domain cases: 1 shrink-budget: 1))
      (check-equal? (list (property.report-status one) (property.report-counterexample one)
        (property.report-attempts one) started pulled) '(failed 8 1 1 1))
      (check (property.report-minimal? one) => #f)
      (check (property.replay-counterexample one) => #f)
      (check-equal? (list started pulled) '(1 1)))
    (test-case "invalid and nondecreasing lazy proposals consume the same attempt budget"
      (def pulled 0)
      (def generator (generator.make-generator (lambda (_random _size) 9)
        (lambda (_) (in-coroutine (lambda (yield)
          (for (candidate '(#f 9 8)) (set! pulled (1+ pulled)) (yield candidate))
          (error "unobserved tail"))))))
      (def report (property.check-property generator (lambda (_) #f)
        (property.make-specification exact-integer? abs) cases: 1 shrink-budget: 2))
      (check-equal? (list (property.report-status report) (property.report-counterexample report)
        (property.report-attempts report) pulled) '(failed 9 2 2)))
    (test-case "source changes at iterator EOF cannot certify a local minimum"
      (def epoch 0)
      (def generator (generator.make-generator (lambda (_random _size) 9)
        (lambda (_) (in-coroutine (lambda (_yield) (set! epoch 1))))
        current?: (lambda () (= epoch 0))))
      (def report (property.check-property generator (lambda (_) #f)
        (property.make-specification exact-integer? abs) cases: 1 shrink-budget: 3))
      (check-equal? (property.report-status report) 'stale)
      (check-equal? (property.report-attempts report) 0)
      (check (property.report-minimal? report) => #f))
    (test-case "generator products compose through bind and map"
      (def generator (generator.generator-sequence
        (list (generator.generator-unit 2) (generator.generator-unit 3) (generator.generator-unit 5))))
      (def report (property.check-property generator (lambda (values) (= (apply + values) 10))
        (property.make-specification (lambda (values) (and (list? values) (every exact-integer? values))) length)
        seed: 83 cases: 4))
      (check-equal? (property.report-status report) 'passed))
    (test-case "visited sources from earlier successful trials remain guarded"
      (def epochs (make-hash-table-eqv)) (def first #f) (def changed? #f)
      (def choices (generator.make-generator (lambda (random _size) (1+ (random 2))) (lambda (_) [])))
      (def dependent (generator.generator-bind choices (lambda (choice)
        (def stamp (hash-ref epochs choice 0))
        (generator.make-generator (lambda (_random _size) choice) (lambda (_) [])
          current?: (lambda () (= stamp (hash-ref epochs choice 0)))))))
      (def report (property.check-property dependent
        (lambda (choice)
          (cond ((not first) (set! first choice))
                ((not (= first choice)) (hash-put! epochs first 1) (set! changed? #t))) #t)
        (property.make-specification exact-integer? abs) seed: 41 cases: 20))
      (check changed? => #t)
      (check-equal? (property.report-status report) 'stale)
      (check-exception (property.replay-property report) (message? "stale property replay")))
    (test-case "generic model traces preserve dependencies and stop at the first wrong reply"
      (def commands '(#(open 1) #(open 2) #(use 1) #(use 2) #(use 1)))
      (def calls 0) (def closed 0)
      (def (command? value)
        (and (vector? value) (= (vector-length value) 2)
          (memq (vector-ref value 0) '(open use)) (exact-integer? (vector-ref value 1)) #t))
      (def (enabled state command)
        (case (vector-ref command 0)
          ((open) (not (memv (vector-ref command 1) state)))
          (else (and (memv (vector-ref command 1) state) #t))))
      (def (step state command)
        (values (if (eq? (vector-ref command 0) 'open) (cons (vector-ref command 1) state) state) #t))
      (def model (model.make-model (lambda () []) enabled step identity command? identity))
      (check (model.valid-trace? model commands) => #t)
      (check-equal? (model.repair-trace model '(#(open 2) #(use 1) #(use 2))) '(#(open 2) #(use 2)))
      (def report (model.check-trace model commands (lambda (use)
        (try (use (model.make-system [] (lambda (state command)
          (set! calls (1+ calls))
          (when (> calls 4) (error "executed past first mismatch"))
          (let-values (((next reply) (step state command)))
            (values next (if (equal? command #(use 2)) #f reply)))) identity))
          (finally (set! closed (1+ closed)))))))
      (check (model.trace-report-matched? report) => #f)
      (check-equal? (list (model.trace-report-phase report) (model.trace-report-index report) calls closed)
        '(result 3 4 1)))))
