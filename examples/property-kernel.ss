;;; Independent-library examples: standard Gerbil plus the generic testing modules.
(export property-kernel-test)
(import (prefix-in :clan/property-testing/test assertion.) :std/test :std/error :std/iter (only-in :std/list/list take drop)
        (prefix-in :clan/property-testing/generator generator.)
        (prefix-in :clan/property-testing/property property.)
        (prefix-in :clan/property-testing/model model.))

;; A dependent packet exposes its generated count and its matching payload.
(defstruct packet (count payload) final: #t)
;; Domain admission is explicit; neither the kernel nor the example assumes Any.
(def (packet-valid? value)
  (and (packet? value) (exact-integer? (packet-count value)) (>= (packet-count value) 0)
    (list? (packet-payload value)) (= (packet-count value) (length (packet-payload value)))
    (every exact-integer? (packet-payload value))))
;; Count drives the tested failure; payload changes deliberately have zero cost.
(def packet-domain (property.make-specification packet-valid? packet-count))
;; Parent shrinking stays in its own nonnegative domain before dependent selection.
(def (count-shrinks count)
  (if (zero? count) [] (list 0 (quotient count 2) (1- count))))
;; Strict protocol diagnostics distinguish stale refusal from unrelated host errors.
(def (message? text)
  (lambda (cause) (and (Error? cause) (equal? (Error-message cause) text))))
;; Equal seed replay compares observable evidence, not private closure identity.
(def (same-failure left right)
  (check-equal? (property.report-status right) 'failed)
  (check-equal? (property.report-original right) (property.report-original left))
  (check-equal? (property.report-counterexample right) (property.report-counterexample left))
  (check-equal? (property.report-attempts right) (property.report-attempts left)))

;; A standard named property can bind later draws to earlier generated arguments.
(def signed-domain (property.make-specification exact-integer? abs))
;; Fixed domains are prepared once; dependent generation uses the existing bind tree.
(assertion.define-property balanced-arguments
  ((left (generator.make-generator (lambda (random size) (- (random (1+ (* 2 size))) size))
          generator.integer-shrinks) signed-domain)
   (right (generator.generator-unit (- left)) signed-domain))
  (= (+ left right) 0))
;; Names that coincide with implementation temporaries remain ordinary user bindings.
(assertion.define-property shadowed-arguments
  ((options (generator.generator-unit 2) signed-domain)
   (domain (generator.generator-unit (1+ options)) signed-domain)
   (report (generator.generator-unit (+ options domain)) signed-domain))
  (= report (+ options domain)))
;; This suite can be copied with testing/core/{generator,property,model,test}.ss into a
;; fresh Gerbil project and run without POO modules, descriptors or object hooks.
(def property-kernel-test
  (test-suite "independent Gerbil property kernel"
    (test-case "Unicode scalar and byte endpoints never generate surrogate values"
      (def chars (generator.generator-character))
      (for (offset '(0 55295 55296 1112063))
        (def value (generator.sample-value (generator.generate chars (lambda (_) offset) 0)))
        (check (or (< (char->integer value) #xd800) (> (char->integer value) #xdfff)) => #t))
      (check-equal? (generator.sample-value (generator.generate chars (lambda (n) (1- n)) 0)) #\x10ffff)
      (check-equal? (generator.sample-value (generator.generate (generator.generator-byte) (lambda (n) (1- n)) 0)) 255)
      (check-exception (generator.generator-character lower: #\z upper: #\a) Error?)
      (check-exception (generator.generator-list chars min-length: 4 max-length: 3) Error?))
    (test-case "bounded strings and symbols retain alphabet and dependent spelling"
      (def alphabet (generator.generator-character lower: #\a upper: #\z))
      (def strings (generator.generator-string alphabet min-length: 2 max-length: 8))
      (def domain (property.make-specification
        (lambda (text) (and (string? text) (<= 2 (string-length text) 8)
          (every (lambda (char) (char<=? #\a char #\z)) (string->list text))))
        (lambda (text) (+ (string-length text) (apply + (map char->integer (string->list text)))))))
      (def report (property.check-property strings (lambda (_) #f) domain seed: 42 cases: 1 size: 8 shrink-budget: 80))
      (check-eq? (property.report-status report) 'failed)
      (check-equal? (property.report-counterexample report) "aa")
      (same-failure report (property.replay-property report))
      (def symbols (generator.generator-symbol alphabet min-length: 2 max-length: 8))
      ;; A spelling shrink regenerates a matching byte payload from the saved seed.
      (def packets (generator.generator-bind symbols (lambda (name)
        (def width (string-length (symbol->string name)))
        (generator.generator-map (generator.generator-bytes min-length: width max-length: width)
          (lambda (payload) (vector name payload))))))
      (def packet-domain (property.make-specification (lambda (row)
        (and (vector? row) (= (vector-length row) 2) (symbol? (vector-ref row 0))
          (u8vector? (vector-ref row 1))
          (= (string-length (symbol->string (vector-ref row 0))) (u8vector-length (vector-ref row 1)))))
        (lambda (row) (+ (apply + (map char->integer (string->list (symbol->string (vector-ref row 0)))))
          (apply + (u8vector->list (vector-ref row 1)))))))
      (def packet-report (property.check-property packets (lambda (_) #f) packet-domain
        seed: 42 cases: 1 size: 8 shrink-budget: 200))
      (check-eq? (property.report-status packet-report) 'failed)
      (same-failure packet-report (property.replay-property packet-report))
      (for (seed '(0 8 42))
        (check-equal? (symbol->string (generator.sample-value (generator.generate symbols (generator.random-at seed) 8)))
          (generator.sample-value (generator.generate strings (generator.random-at seed) 8)))))
    (test-case "fixed byte payloads shrink coordinates without losing required width"
      (def bytes (generator.generator-bytes min-length: 4 max-length: 4))
      (def domain (property.make-specification
        (lambda (value) (and (u8vector? value) (= (u8vector-length value) 4)))
        (lambda (value) (apply + (u8vector->list value)))))
      (def report (property.check-property bytes (lambda (_) #f) domain seed: 42 cases: 1 size: 0 shrink-budget: 80))
      (check-equal? (property.report-counterexample report) #u8(0 0 0 0))
      (same-failure report (property.replay-property report))
      (check-equal? (generator.sample-value (generator.generate (generator.generator-bytes) (generator.random-at 9) 0)) #u8()))
    (test-case "mapped data generators preserve stale sources and callback errors"
      (def current #t)
      (def chars (generator.make-generator (lambda (_random _size) #\a) (lambda (_) [])
        current?: (lambda () current)))
      (def tree (generator.generate (generator.generator-string chars min-length: 1) (generator.random-at 3) 0))
      (set! current #f)
      (check-exception (for (child ((generator.sample-children tree))) (void)) generator.stale-generation?)
      (def cause (cons 'character 'callback))
      (def refused (generator.make-generator (lambda (_random _size) (raise cause)) (lambda (_) [])))
      (check-eq? (with-catch values (lambda ()
        (generator.generate (generator.generator-string refused min-length: 1) (generator.random-at 3) 0))) cause))
    (test-case "standard checks evaluate report and formatter exactly once"
      (def reports 0) (def formats 0)
      (assertion.check-property
        (begin (set! reports (1+ reports))
          (property.check-property (generator.generator-unit 1) positive? signed-domain cases: 1))
        diagnostics: (lambda (report) (set! formats (1+ formats)) (property.report-diagnostics report)))
      (check-equal? (list reports formats) '(1 1)))
    (test-case "named dependent arguments register ordinary standard checks"
      (balanced-arguments seed: 42 cases: 20 size: 8)
      (balanced-arguments seed: 7 cases: 5 size: 0)
      (shadowed-arguments seed: 3 cases: 2))
    (test-case "weighted choices capture their table and refuse malformed configurations"
      (def weights (list (cons 0 (generator.generator-unit 'unreachable))
                         (cons 4 (generator.generator-unit 'selected))))
      (def selected (generator.generator-frequency weights))
      (set-car! (car weights) 99)
      (for (seed '(0 7 41 83))
        (check-equal? (generator.sample-value (generator.generate selected (generator.random-at seed) 4)) 'selected))
      (for (invalid (list [] (list (cons 0 (generator.generator-unit 0)))
                            (list (cons -1 (generator.generator-unit 0)))
                            (list (cons 1/2 (generator.generator-unit 0)))))
        (check-exception (generator.generator-frequency invalid) Error?))
      (check-exception (generator.generator-choice) Error?))
    (test-case "dependent binding syntax composes sized weighted payloads"
      (def batches
        (generator.bind-generators
          ((count (generator.generator-sized generator.generator-unit))
           (payload (generator.generator-sequence (make-list count
             (generator.generator-frequency (list (cons 0 (generator.generator-unit 'wrong))
                                                 (cons 2 (generator.generator-unit 7))))))))
          (make-packet count payload)))
      (def scaled (generator.generator-resize (generator.generator-scale batches (cut + <> 2)) 3))
      (def value (generator.sample-value (generator.generate scaled (generator.random-at 7) 99)))
      (check-equal? (packet-count value) 5)
      (check-equal? (packet-payload value) '(7 7 7 7 7)))
    (test-case "filtered shrink rejections are charged and never transformed"
      (def transformed []) (def evaluated [])
      (def filtered (generator.generator-filter
        (generator.make-generator (lambda (_random _size) 9) (lambda (_) '(0 4 2))) positive?))
      (def mapped (generator.generator-map filtered (lambda (n)
        (when (zero? n) (error "rejected proposal reached mapping"))
        (set! transformed (cons n transformed)) n)))
      (def report (property.check-property mapped (lambda (n) (set! evaluated (cons n evaluated)) #f)
        (property.make-specification positive? identity) cases: 1 shrink-budget: 1))
      (check-equal? (list (property.report-status report) (property.report-attempts report)
        (property.report-counterexample report) (property.report-minimal? report)) '(failed 1 9 #f))
      (check-equal? transformed '(9)) (check-equal? evaluated '(9)))
    (test-case "filter draw exhaustion is bounded and retains rejected source observers"
      (def draws 0)
      (def zeros (generator.make-generator (lambda (_random _size) (set! draws (1+ draws)) 0) (lambda (_) [])))
      (def domain (property.make-specification exact-integer? abs))
      (for (fuel '(0 3))
        (set! draws 0)
        (def result (property.check-property (generator.generator-filter zeros positive? attempts: fuel)
          (lambda (_) (error "exhausted generator reached property")) domain cases: 1))
        (check-equal? (property.report-status result) 'exhausted)
        (check-equal? draws fuel))
      (def epoch 0) (def selected 0)
      (def branches (generator.generator-sized (lambda (_size)
        (def n selected) (set! selected (1+ selected))
        (def stamp epoch)
        (generator.make-generator (lambda (_random _size) n) (lambda (_) [])
          current?: (if (zero? n) (lambda () (= stamp epoch)) (lambda () #t))))))
      (def report (property.check-property (generator.generator-filter branches positive?)
        (lambda (_) #f) domain cases: 1))
      (check-equal? (property.report-status report) 'failed)
      (set! epoch 1)
      (check-exception (property.replay-counterexample report) (message? "stale property replay")))
    (test-case "size policies and named properties retain actual failure size and replay"
      (def sizes []) (def epoch 0)
      (def domain (property.make-specification exact-integer? abs))
      (property.define-property (below-three n)
        (generator.generator-sized generator.generator-unit) domain (< n 3))
      (def (schedule trial) (set! sizes (cons trial sizes)) trial)
      (def report (below-three cases: 5 size: schedule size-limit: 5 size-current?: (lambda () (= epoch 0))))
      (check-equal? (list (property.report-status report) (property.report-trial report)
        (property.report-trial-size report) (property.report-counterexample report)) '(failed 3 3 3))
      (check-equal? sizes '(3 2 1))
      (check (property.replay-counterexample report) => #f)
      (check-equal? sizes '(3 2 1))
      (same-failure report (property.replay-property report))
      (check-equal? sizes '(3 2 1 3 2 1))
      (set! epoch 1)
      (check-exception (property.replay-property report) (message? "stale property replay")))
    (test-case "invalid or stale size policies refuse before drawing"
      (def draws 0) (def epoch 0)
      (def source (generator.make-generator (lambda (_random _size) (set! draws (1+ draws)) 1) (lambda (_) [])))
      (def domain (property.make-specification exact-integer? abs))
      (check-equal? (property.report-status (property.check-property source (lambda (_) #t) domain
        size: (lambda (_) -1) size-limit: 5)) 'error)
      (check-equal? (property.report-status (property.check-property source (lambda (_) #t) domain
        size: (lambda (_) 6) size-limit: 5)) 'error)
      (def interrupted (property.check-property source (lambda (_) #t) domain
        cases: 2 size: (lambda (trial) (if (= trial 1) 1 (error "size interrupted"))) size-limit: 5))
      (check-equal? (list (property.report-status interrupted) (property.report-trial-size interrupted)) '(error #f))
      (set! draws 0)
      (check-equal? (property.report-status (property.check-property source (lambda (_) #t) domain
        size: (lambda (_) (set! epoch 1) 3) size-limit: 5 size-current?: (lambda () (= epoch 0)))) 'stale)
      (check-equal? draws 0))
    (test-case "recursive delay spends its own finite construction quota"
      (def forces 0) (def recursive #f)
      (set! recursive (generator.generator-delay (lambda () (set! forces (1+ forces)) recursive) depth: 3))
      (def report (property.check-property recursive (lambda (_) #t)
        (property.make-specification exact-integer? abs) cases: 1))
      (check-equal? (property.report-status report) 'exhausted)
      (check-equal? forces 3)
      (check-exception (generator.generator-delay (lambda () recursive) depth: -1) Error?))
    (test-case "shrink policy replacement remains lazy and bypasses the old policy"
      (def old 0) (def replacement 0)
      (def source (generator.make-generator (lambda (_random _size) 9)
        (lambda (_) (set! old (1+ old)) '(8))))
      (def changed (generator.generator-with-shrink source
        (lambda (_) (set! replacement (1+ replacement)) '(0))))
      (def domain (property.make-specification exact-integer? abs))
      (def zero (property.check-property changed (lambda (_) #f) domain cases: 1 shrink-budget: 0))
      (check-equal? (list old replacement) '(0 0))
      (def one (property.check-property changed (lambda (_) #f) domain cases: 1 shrink-budget: 1))
      (check-equal? (list old replacement (property.report-counterexample one)) '(0 1 0))
      (def none (property.check-property (generator.generator-no-shrink source) (lambda (_) #f) domain cases: 1))
      (check-equal? (list old (property.report-attempts none) (property.report-minimal? none)) '(0 0 #t)))
    (test-case "dependent regeneration restores independent random checkpoints"
      (def seed 71)
      (def selections 0) (def draws 0)
      (def split (generator.random-at seed))
      (split 4294967087)
      (def child-seed (split 4294967087))
      (def (expected n)
        (def random (generator.random-at child-seed))
        (cons n (for/collect (_ (in-range n)) (random 100003))))
      (def dependent
        (generator.generator-bind
          (generator.make-generator (lambda (_random _size) 3)
            (lambda (n) (if (= n 3) '(2 1) [])))
          (lambda (n) (set! selections (1+ selections)) (generator.make-generator
            (lambda (random _size) (set! draws (1+ draws))
              (cons n (for/collect (_ (in-range n)) (random 100003))))
            (lambda (_) [])))))
      (def root (generator.generate dependent (generator.random-at seed) 8))
      (check-equal? (generator.sample-value root) (expected 3))
      (for (_ (in-range 2))
        (check-equal?
          (for/collect (child ((generator.sample-children root))) (generator.sample-value child))
          (map expected '(2 1))))
      (check-equal? (generator.sample-value root) (expected 3))
      (check-equal? (list selections draws) '(5 5))
      ;; A later root owns fresh preparation and still invokes both callbacks.
      (check-equal? (generator.sample-value
        (generator.generate dependent (generator.random-at seed) 8)) (expected 3))
      (check-equal? (list selections draws) '(6 6)))
    (test-case "bound neighborhoods pull in order without forcing unused factories"
      (def selections 0) (def parent-starts 0) (def child-starts 0)
      (def (domain interrupted?)
        (generator.generator-bind
          (generator.make-generator (lambda (_random _size) 9)
            (lambda (_) (set! parent-starts (1+ parent-starts))
              (in-coroutine (lambda (yield) (yield 8)
                (when interrupted? (error "parent pull interrupted"))))))
          (lambda (n) (set! selections (1+ selections))
            (generator.make-generator (lambda (_random _size) (* n 10))
              (lambda (value) (set! child-starts (1+ child-starts)) (list (1- value)))))))
      (def root (generator.generate (domain #f) (generator.random-at 17) 4))
      (using (children (iter ((generator.sample-children root))) :- Iterator)
        (check-equal? (list selections parent-starts child-starts) '(1 0 0))
        (check-equal? (generator.sample-value (children.next!)) 80)
        (check-equal? (list selections parent-starts child-starts) '(2 1 0))
        (check-equal? (generator.sample-value (children.next!)) 89)
        (check-equal? (list selections parent-starts child-starts) '(2 1 1))
        (check-equal? (children.next!) #!eof)
        (check-equal? (children.next!) #!eof)
        (check-equal? (list selections parent-starts child-starts) '(2 1 1)))
      (def interrupted (generator.generate (domain #t) (generator.random-at 17) 4))
      (def confirmed #f)
      ;; An upstream coroutine captures dynamic handlers; keep one failure owner
      ;; around its entire traversal, exactly as the ordinary property runner does.
      (check-exception
        (using (children (iter ((generator.sample-children interrupted))) :- Iterator)
          (set! confirmed (generator.sample-value (children.next!)))
          (children.next!)) (message? "parent pull interrupted"))
      (check-equal? confirmed 80)
      (check-equal? child-starts 1))
    (test-case "non-injective map retains negative preimages while shrinking"
      (def seen [])
      (def source (generator.make-generator (lambda (_random _size) -9)
        (lambda (n) (set! seen (cons n seen)) (if (zero? n) [] (list 0 (quotient n 2))))))
      (def mapped (generator.generator-map source abs))
      (def domain (property.make-specification (lambda (n) (and (exact-integer? n) (>= n 0))) abs))
      (def report (property.check-property mapped (lambda (n) (< n 2)) domain cases: 1))
      (check-equal? (property.report-status report) 'failed)
      (check-equal? (property.report-counterexample report) 2)
      (check (and (memv -9 seen) (memv -4 seen) #t) => #t)
      (check (property.replay-counterexample report) => #f)
      (same-failure report (property.replay-property report)))
    (test-case "dependent bind preserves packet length through shrinking and both replays"
      (def versions (make-hash-table-eqv)) (def selections 0) (def draws 0)
      (def counts (generator.make-generator (lambda (_random _size) 6) count-shrinks))
      ;; Each selected child captures its OWN source epoch and its parent count.
      (def (payload count)
        (set! selections (1+ selections))
        (def stamp (hash-ref versions count 0))
        (generator.generator-map
          (generator.make-generator
            (lambda (random _size) (set! draws (1+ draws))
              (for/collect (_ (in-range count)) (1+ (random 4))))
            (lambda (values) (if (every zero? values) [] (list (make-list count 0))))
            current?: (lambda () (= stamp (hash-ref versions count 0))))
          (lambda (values) (make-packet count values))))
      (def generator (generator.generator-bind counts payload))
      (def report (property.check-property generator (lambda (value) (< (packet-count value) 2))
        packet-domain seed: 41 cases: 1 shrink-budget: 96))
      (check-equal? (property.report-status report) 'failed)
      (check (packet-valid? (property.report-counterexample report)) => #t)
      (check-equal? (packet-count (property.report-counterexample report)) 2)
      (let ((before-selections selections) (before-draws draws))
        (check (property.replay-counterexample report) => #f)
        (check-equal? selections before-selections) (check-equal? draws before-draws))
      (same-failure report (property.replay-property report))
      ;; Changing only the ORIGINAL count-6 branch must also refuse replay after
      ;; the final witness has moved to a count-2 branch with unchanged metadata.
      (hash-put! versions 6 1)
      (check-exception (property.replay-property report) (message? "stale property replay"))
      (check-exception (property.replay-counterexample report) (message? "stale property replay")))
    (test-case "zero and one attempt force no unused shrink callbacks or iterator tail"
      (def started 0) (def pulled 0)
      (def generator (generator.make-generator (lambda (_random _size) 9)
        (lambda (_)
          (set! started (1+ started))
          (in-coroutine (lambda (yield)
            (set! pulled (1+ pulled)) (yield 8) (error "unused iterator tail"))))))
      (def domain (property.make-specification exact-integer? abs))
      (def zero (property.check-property generator (lambda (_) #f) domain cases: 1 shrink-budget: 0))
      (check-equal? (list (property.report-status zero) started pulled) '(failed 0 0))
      (def one (property.check-property generator (lambda (_) #f) domain cases: 1 shrink-budget: 1))
      (check-equal? (list (property.report-status one) (property.report-counterexample one)
        (property.report-attempts one) started pulled) '(failed 8 1 1 1))
      (check (property.report-minimal? one) => #f)
      (check (property.replay-counterexample one) => #f)
      (check-equal? (list started pulled) '(1 1)))
    (test-case "invalid and nondecreasing lazy proposals consume the same attempt budget"
      (def pulled 0)
      (def generator (generator.make-generator (lambda (_random _size) 9)
        (lambda (_) (in-coroutine (lambda (yield)
          (for (candidate '(#f 9 8)) (set! pulled (1+ pulled)) (yield candidate))
          (error "unobserved tail"))))))
      (def report (property.check-property generator (lambda (_) #f)
        (property.make-specification exact-integer? abs) cases: 1 shrink-budget: 2))
      (check-equal? (list (property.report-status report) (property.report-counterexample report)
        (property.report-attempts report) pulled) '(failed 9 2 2)))
    (test-case "source changes at iterator EOF cannot certify a local minimum"
      (def epoch 0)
      (def generator (generator.make-generator (lambda (_random _size) 9)
        (lambda (_) (in-coroutine (lambda (_yield) (set! epoch 1))))
        current?: (lambda () (= epoch 0))))
      (def report (property.check-property generator (lambda (_) #f)
        (property.make-specification exact-integer? abs) cases: 1 shrink-budget: 3))
      (check-equal? (property.report-status report) 'stale)
      (check-equal? (property.report-attempts report) 0)
      (check (property.report-minimal? report) => #f))
    (test-case "generator products compose through bind and map"
      (def generator (generator.generator-sequence
        (list (generator.generator-unit 2) (generator.generator-unit 3) (generator.generator-unit 5))))
      (def report (property.check-property generator (lambda (values) (= (apply + values) 10))
        (property.make-specification (lambda (values) (and (list? values) (every exact-integer? values))) length)
        seed: 83 cases: 4))
      (check-equal? (property.report-status report) 'passed)
      (def epoch 0)
      (def source (lambda () (= epoch 0)))
      ;; Caller duplicates are normalized once before internal sharing is allowed.
      (def provided (list source source))
      (def shared (generator.make-generator (lambda (_random _size) 1) (lambda (_) []) sources: provided))
      (set-car! provided (lambda () #t))
      (def root (generator.generate (generator.generator-sequence (make-list 16 shared))
        (generator.random-at 83) 4))
      (def exported-sources (generator.sample-sources root))
      (check-equal? (length exported-sources) 1)
      (set-car! exported-sources (lambda () #t))
      ;; Empty/identical source joins share only internal lists. Public multi-leaf
      ;; inputs and exports remain detached even if their caller truncates them.
      (def provided-pair (list source (lambda () #t)))
      (def owned (generator.make-sample 1 (lambda () []) sources: provided-pair))
      (set-car! provided-pair (lambda () #t)) (set-cdr! provided-pair [])
      (def exposed (generator.proposal-sources owned))
      (check-equal? (length exposed) 2)
      (set-car! exposed (lambda () #t)) (set-cdr! exposed [])
      (set! epoch 1)
      (check ((generator.sample-current owned)) => #f)
      (def stale (property.check-property (generator.make-tree-generator (lambda (_random _size) root))
        (lambda (_) (error "stale shared source reached property"))
        (property.make-specification list? length) cases: 1))
      (check-equal? (property.report-status stale) 'stale))
    (test-case "visited sources from earlier successful trials remain guarded"
      (def epochs (make-hash-table-eqv)) (def first #f) (def changed? #f)
      (def choices (generator.make-generator (lambda (random _size) (1+ (random 2))) (lambda (_) [])))
      (def dependent (generator.generator-bind choices (lambda (choice)
        (def stamp (hash-ref epochs choice 0))
        (generator.make-generator (lambda (_random _size) choice) (lambda (_) [])
          current?: (lambda () (= stamp (hash-ref epochs choice 0)))))))
      (def report (property.check-property dependent
        (lambda (choice)
          (cond ((not first) (set! first choice))
                ((not (= first choice)) (hash-put! epochs first 1) (set! changed? #t))) #t)
        (property.make-specification exact-integer? abs) seed: 41 cases: 20))
      (check changed? => #t)
      (check-equal? (property.report-status report) 'stale)
      (check-exception (property.replay-property report) (message? "stale property replay")))
    (test-case "interrupted shrinking preserves confirmed progress across callback boundaries"
      (for (stage '(children iterator admission measure property observer))
        (def cause (Error (symbol->string stage)))
        (def observer-failed? #f)
        ;; Each run first confirms 9 -> 8, then fails at one later boundary.
        (def source (generator.make-generator (lambda (_random _size) 9)
          (lambda (value)
            (cond ((= value 9) [8])
                  ((eq? stage 'children) (raise cause))
                  ((eq? stage 'iterator)
                    (in-coroutine (lambda (yield) (yield 8) (raise cause))))
                  (else '(8 7))))
          current?: (lambda () (if observer-failed? (raise cause) #t))))
        ;; Admission and measure failures belong to the charged proposal, never
        ;; to a newly confirmed counterexample.
        (def domain (property.make-specification
          (lambda (value) (when (and (eq? stage 'admission) (= value 7)) (raise cause)) (exact-integer? value))
          (lambda (value) (when (and (eq? stage 'measure) (= value 7)) (raise cause)) (abs value))))
        (def report (property.check-property source
          (lambda (value)
            (when (= value 7)
              (if (eq? stage 'observer) (set! observer-failed? #t) (raise cause))) #f)
          domain cases: 1 shrink-budget: 8))
        (check-equal? (property.report-status report) 'error)
        (check (eq? (property.report-cause report) cause) => #t)
        (check-equal? (list (property.report-original report) (property.report-counterexample report)
          (property.report-attempts report) (property.report-steps report) (property.report-minimal? report))
          (list 9 8 (case stage ((children) 1) ((iterator) 2) (else 3)) 1 #f))
        (check-exception (property.replay-counterexample report) (message? "failed property report required"))
        ;; Stable sources replay the same interruption, cause and charged work.
        (unless (eq? stage 'observer)
          (let (again (property.replay-property report))
          (check-equal? (property.report-status again) 'error)
          (check (eq? (property.report-cause again) cause) => #t)
          (check-equal? (property.report-counterexample again) 8)
          (check-equal? (property.report-attempts again) (property.report-attempts report))))))
    (test-case "stale interruption retains work without promoting the pending proposal"
      (def epoch 0) (def cause (Error "retired specification"))
      (def source (generator.make-generator (lambda (_random _size) 9)
        (lambda (value) (if (= value 9) [8] '(8 7))) current?: (lambda () (= epoch 0))))
      (def report (property.check-property source
        (lambda (value) (when (= value 7) (set! epoch 1) (raise cause)) #f)
        (property.make-specification exact-integer? abs) cases: 1 shrink-budget: 8))
      (check-equal? (list (property.report-status report) (property.report-counterexample report)
        (property.report-attempts report) (property.report-steps report) (property.report-minimal? report))
        '(stale 8 3 1 #f))
      (check (eq? (property.report-cause report) cause) => #t)
      (check-exception (property.replay-property report) (message? "stale property replay")))
    (test-case "normalized callback commands survive dependency shrinking and both replays"
      (def normalized []) (def wraps 0) (def opened 0) (def closed 0)
      ;; Both raw and repaired commands belong to this finite command language.
      (def (command? value)
        (and (vector? value) (memv (vector-length value) '(3 4))
          (memq (vector-ref value 0) '(open use))
          (exact-integer? (vector-ref value 1)) (>= (vector-ref value 1) 0)
          (procedure? (vector-ref value 2)) #t))
      ;; Normalization installs a contract-bearing callback once at preparation.
      (def (normalize raw)
        (set! wraps (1+ wraps))
        (def action (vector-ref raw 2))
        (def checked (vector (vector-ref raw 0) (vector-ref raw 1)
          (lambda (argument)
            (using (argument : :fixnum)
              (using (result (action argument) : :fixnum) result))) 'checked))
        (set! normalized (cons checked normalized)) checked)
      ;; Logical producer dependencies are independent of the actual fixture.
      (def (enabled state command)
        (def present (and (memv (vector-ref command 1) state) #t))
        (if (eq? (vector-ref command 0) 'open) (not present) present))
      ;; The oracle does not invoke the actual callback to compute its reply.
      (def (advance state command)
        (def id (vector-ref command 1))
        (if (eq? (vector-ref command 0) 'open)
          (values (cons id state) id) (values state (* id 2))))
      (def reference (model.make-model (lambda () []) enabled advance identity command? normalize))
      ;; Every observation owns a fresh fixture and checks the prepared identity.
      (def (fixture fault?)
        (lambda (use)
          (set! opened (1+ opened))
          (try (use (model.make-system [] (lambda (state command)
            (unless (memq command normalized) (error "unprepared command reached fixture"))
            (def id (vector-ref command 1))
            (if (eq? (vector-ref command 0) 'open) (values (cons id state) id)
              (values state (+ ((vector-ref command 2) id) (if (and fault? (= id 2)) 1 0))))) identity))
            (finally (set! closed (1+ closed))))))
      (def action (lambda (id) (* id 2)))
      (def commands (list (vector 'open 1 action) (vector 'open 2 action)
        (vector 'use 1 action) (vector 'use 2 action) (vector 'use 2 action)))
      (check (model.trace-report-matched? (model.check-trace reference commands (fixture #f))) => #t)
      (check-equal? wraps (length commands))
      (def mismatch (model.check-trace reference commands (fixture #t)))
      (check-equal? (model.trace-report-index mismatch) 3)
      (check (memq (model.trace-report-command mismatch) normalized) ? pair?)
      ;; Deletions reuse dependency repair; no consumer survives its producer.
      (def source (generator.make-generator (lambda (_random _size) commands)
        (lambda (trace) (for/collect (index (in-range (length trace)))
          (model.repair-trace reference (append (take trace index) (drop trace (1+ index))))))))
      (def report (property.check-property source
        (lambda (trace) (model.trace-report-matched? (model.check-trace reference trace (fixture #t))))
        (property.make-specification (lambda (trace) (and (list? trace) (every command? trace))) length)
        seed: 17 cases: 1 shrink-budget: 48))
      (check-equal? (property.report-status report) 'failed)
      (check-equal? (map (cut vector-ref <> 0) (property.report-counterexample report)) '(open use))
      (check-equal? (map (cut vector-ref <> 1) (property.report-counterexample report)) '(2 2))
      (check (property.replay-counterexample report) => #f)
      (check-equal? (property.report-status (property.replay-property report)) 'failed)
      (check-equal? opened closed))
    (test-case "complete normalization failure refuses before fixture effects"
      (def opened 0)
      (def cause (Error "normalization refused"))
      ;; A non-identity decoder changes the actual commands being admitted.
      (def reference (model.make-model (lambda () 0) (lambda (_state command) (<= command 3))
        (lambda (state command) (values (+ state command) command)) identity exact-integer?
        (lambda (raw) (if (< raw 0) (raise cause) (1+ raw)))))
      ;; Opening is observable and forbidden for ANY rejected complete prefix.
      (def (fixture use)
        (set! opened (1+ opened))
        (use (model.make-system 0 (lambda (state command) (values (+ state command) command)) identity)))
      (check-exception (model.check-trace reference '(0 1 9) fixture) (message? "invalid command trace"))
      (check-exception (model.check-trace reference '(0 -1) fixture) (cut eq? <> cause))
      (check-exception (model.check-trace reference '(0 invalid) fixture) (message? "invalid command trace"))
      (check-equal? opened 0)
      (check (model.trace-report-matched? (model.check-trace reference [] fixture)) => #t)
      (check-equal? opened 1))
    (test-case "generic model traces preserve dependencies and stop at the first wrong reply"
      (def commands '(#(open 1) #(open 2) #(use 1) #(use 2) #(use 1)))
      (def calls 0) (def closed 0)
      (def (command? value)
        (and (vector? value) (= (vector-length value) 2)
          (memq (vector-ref value 0) '(open use)) (exact-integer? (vector-ref value 1)) #t))
      (def (enabled state command)
        (case (vector-ref command 0)
          ((open) (not (memv (vector-ref command 1) state)))
          (else (and (memv (vector-ref command 1) state) #t))))
      (def (step state command)
        (values (if (eq? (vector-ref command 0) 'open) (cons (vector-ref command 1) state) state) #t))
      (def model (model.make-model (lambda () []) enabled step identity command? identity))
      (check (model.valid-trace? model commands) => #t)
      (check-equal? (model.repair-trace model '(#(open 2) #(use 1) #(use 2))) '(#(open 2) #(use 2)))
      (def report (model.check-trace model commands (lambda (use)
        (try (use (model.make-system [] (lambda (state command)
          (set! calls (1+ calls))
          (when (> calls 4) (error "executed past first mismatch"))
          (let-values (((next reply) (step state command)))
            (values next (if (equal? command #(use 2)) #f reply)))) identity))
          (finally (set! closed (1+ closed)))))))
      (check (model.trace-report-matched? report) => #f)
      (check-equal? (list (model.trace-report-phase report) (model.trace-report-index report) calls closed)
        '(result 3 4 1)))))
