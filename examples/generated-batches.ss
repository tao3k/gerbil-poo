;;; Downstream typed batch properties use the ordinary generator and FUN protocols.
(export make-batch-domain generated-batches-test)
(import (prefix-in ../support/testing pbt.)
        (only-in ../debug property-debug-action)
        (prefix-in :clan/poo/testing/property policy.)
        (prefix-in :clan/poo/testing/property/replay corpus.)
        (prefix-in ./collection-testing collection.)
        :std/test :std/error :std/iter ../object ../mop ../type ../number ../testing/type ../testing/function ../support/option
        (prefix-in :clan/poo/testing/property/generator core.))

;; Record construction owns nested Function wrapping; the property runner does
;; not invent a second record recognizer or procedure representation.
(define-type Batch
  (Record count: [UInt] payload: [(List UInt)] route: [(Enum put remove)]
          handler: [(Function [Integer] [Integer])]))

;; Each application owns its mutable generation configuration. The derived Type
;; and sampler declare it as a source, so stale reports cannot silently rebind it.
(def (make-batch-domain)
  (def configuration (.o maximum: 5))
  (def counts (core.make-generator
    (lambda (_random size) (min size (.get configuration maximum))) core.integer-shrinks))
  (def elements (core.generator-map
    (core.make-generator (lambda (random _size) (- (1+ (random 8)))) core.integer-shrinks) abs))
  (def batches
    (core.bind-generators
      ((count counts)
       (route (core.generator-frequency
         (list (cons 3 (core.generator-unit 'put)) (cons 1 (core.generator-unit 'remove)))))
       (payload (core.generator-sequence (make-list count elements))))
      (make-instance Batch count: count payload: payload route: route handler: abs)))
  (def descriptor
    (.o self: domain inherit: [Type.]
      .element?: (lambda (value) (and (element? Batch value)
        (= (.get value count) (length (.get value payload)))
        (<= (.get value count) (.get configuration maximum))))
      .generator: (lambda () (from-generator domain batches (lambda (value) (.get value count))
        dependencies: (list Batch configuration)))))
  (values descriptor configuration))

;; One callback represents an injected application fault. Valid construction and
;; Function wrapping are checked even when the selected route is not faulty.
(def (batch-correct? batch)
  (and (= ((.@ batch handler) -7) 7) (< (.get batch count) 2)))

;; These are ordinary exported suites discovered by Gerbil's standard runner.
(def generated-batches-test
  (test-suite "composed typed batch generation"
    (test-case "bounded Record command generation composes FUN differential shrinking and retry"
      (def command (Record kind: [(Enum open use)] key: [UInt]
        handler: [(Function [Integer] [Integer])]))
      (def state (List UInt))
      (def draws 0) (def initials 0) (def opened 0) (def closed 0)
      ;; Stateful generation emits only enabled commands; Record owns wrapping.
      (def (emit kind)
        (make-instance command kind: kind key: 1 handler: (lambda (value) (1+ value))))
      ;; The oracle computes replies without invoking the actual Function field.
      (def (advance previous next)
        (values (if (eq? (.get next kind) 'open) (cons (.get next key) previous) previous)
          (1+ (.get next key))))
      (def subject (make-instance TraceGenerator Command: command State: state Result: Integer Observation: state
        initial: (lambda () (set! initials (1+ initials)) [])
        enabled?: (lambda (previous next)
          (if (eq? (.get next kind) 'open) (not (memv (.get next key) previous))
            (and (memv (.get next key) previous) #t)))
        advance: advance observe: identity
        draw: (lambda (previous _random _size)
          (set! draws (1+ draws)) (some (emit (if (null? previous) 'open 'use))))
        shrink: (lambda (_) []) measure: (lambda (_) 0)))
      (def system-type (TraceSystem state))
      ;; Each property observation owns cleanup, including the injected mismatch.
      (def (fixture use)
        (set! opened (1+ opened))
        (try (use (make-instance system-type initial: [] observe: identity
          step: (lambda (previous next)
            (values (if (eq? (.get next kind) 'open) (cons (.get next key) previous) previous)
              (+ ((.@ next handler) (.get next key)) (if (eq? (.get next kind) 'use) 1 0))))))
          (finally (set! closed (1+ closed)))))
      (def sampler (trace-generator command subject steps: 5))
      (def action (property-debug-action #f (.get sampler descriptor)
        (trace-property subject fixture) sampler: sampler))
      (def invalid (action (make-instance PropertyConfiguration seed: 7 cases: 1
        size: (lambda (_) 1/2) size-limit: 3 shrink-budget: 64)))
      (check-eq? (.get invalid status) 'error)
      (check-equal? (list draws initials opened closed) '(0 0 0 0))
      (def empty-sampler (trace-generator command subject steps: 0))
      (def empty-report ((property-debug-action #f (.get empty-sampler descriptor)
        (trace-property subject fixture) sampler: empty-sampler)
        (make-instance PropertyConfiguration seed: 7 cases: 1 size: 3)))
      (check-eq? (.get empty-report status) 'passed)
      (check-equal? draws 0)
      (def report (action (make-instance PropertyConfiguration seed: 7 cases: 1 size: 3 shrink-budget: 64)))
      (check-eq? (.get report status) 'failed)
      (check-equal? (length (.get report original)) 3)
      (check-equal? (map (cut .get <> kind) (.get report counterexample)) '(open use))
      (check-equal? draws 3)
      (check-exception ((.@ (cadr (.get report counterexample)) handler) 'invalid) TypeError?)
      (let (before draws)
        (check (replay-counterexample report) => #f)
        (check-equal? draws before)
        (check-eq? (.get (replay-property report) status) 'failed)
        (check-equal? draws (+ before 3)))
      (check-equal? opened closed))
    (test-case "Record filtered proposals refuse stale evidence and retry through FUN"
      (def epoch 0) (def draws 0) (def pulls 0) (def properties 0)
      ;; Record performs Function wrapping before either generic or typed checking.
      (def (batch count)
        (make-instance Batch count: count payload: (make-list count 0) route: 'put handler: abs))
      ;; Only the retained child depends on this epoch. The root has no such
      ;; dependency until the consumer actually visits that child proposal.
      (def (prepare retire?)
        (let (captured epoch)
          (def current (lambda () (= captured epoch)))
          (def filtered (core.generator-filter
            (core.make-tree-generator (lambda (_random _size)
              (core.make-sample (batch 4) (lambda ()
                (list (core.make-sample (batch 1) (lambda () []) current))))))
            (lambda (value) (>= (.get value count) 2))))
          (def pruned (car (for/collect (child ((core.sample-children
            (core.generate filtered (core.random-at 7) 4)))) child)))
          (core.make-tree-generator (lambda (_random _size)
            (set! draws (1+ draws))
            (core.make-sample (batch 4) (lambda () (in-coroutine (lambda (yield)
              (set! pulls (1+ pulls))
              (when retire? (set! epoch (1+ epoch))) (yield pruned)
              (set! pulls (1+ pulls))
              (yield (core.make-sample (batch 2) (lambda () []) current))
              (error "accepted child did not restart its own neighborhood")))))))))
      ;; The same predicate observes a real wrapped handler in both entry paths.
      (def (safe? value)
        (set! properties (1+ properties))
        (check-equal? ((.@ value handler) -7) 7)
        (zero? (.get value count)))
      (def domain (policy.make-specification (lambda (value) (element? Batch value))
        (lambda (value) (.get value count))))
      (def stale (policy.check-property (prepare #t) safe? domain cases: 1 shrink-budget: 1))
      (check-eq? (policy.report-status stale) 'stale)
      (check-equal? (policy.report-attempts stale) 1)
      (check-equal? (.get (policy.report-counterexample stale) count) 4)
      (check (policy.report-current? stale) => #f)
      (check-exception (policy.replay-counterexample stale) Error?)
      (check-equal? (list draws pulls properties) '(1 1 1))
      (for (mapped? '(#f #t))
        (def source (prepare #t))
        ;; Nonidentity Record reconstruction exercises real child mapping;
        ;; identity sharing retains the original tombstone delivery path.
        (def generation (if mapped?
          (core.generator-map source (lambda (value) (batch (.get value count)))) source))
        (def sampler (from-generator Batch generation (lambda (value) (.get value count))))
        (def typed ((property-debug-action #f Batch safe? sampler: sampler)
          (make-instance PropertyConfiguration seed: 7 cases: 1 size: 4 shrink-budget: 1)))
        (check-eq? (.get typed status) 'stale)
        (check-equal? (.get typed attempts) (if mapped? 0 1)))
      (check-equal? (list draws pulls properties) '(3 3 3))
      (def fresh (policy.check-property (prepare #f) safe? domain cases: 1 shrink-budget: 3))
      (check-eq? (policy.report-status fresh) 'failed)
      (check-equal? (policy.report-attempts fresh) 2)
      (check-equal? (policy.report-steps fresh) 1)
      (check (policy.report-minimal? fresh) => #t)
      (check-equal? (.get (policy.report-counterexample fresh) count) 2)
      (check-exception ((.@ (policy.report-counterexample fresh) handler) 'invalid) TypeError?)
      (let ((before draws) (visited pulls))
        (check (policy.replay-counterexample fresh) => #f)
        (check-equal? (list draws pulls) (list before visited))
        (check-eq? (policy.report-status (policy.replay-property fresh)) 'failed)
        (check-equal? (list draws pulls) (list (1+ before) (+ 2 visited))))
      (set! epoch (1+ epoch))
      (check-exception (policy.replay-counterexample fresh) Error?)
      (check-eq? (policy.report-status
        (policy.check-property (prepare #f) safe? domain cases: 1 shrink-budget: 3)) 'failed))
    (test-case "nonempty batch payloads share mandatory ownership through FUN shrinking and retry"
      (def epoch 0) (def draws 0) (def handlers 0)
      ;; Prepare one finite payload domain at a captured application revision.
      (def (prepare)
        (let (captured epoch)
          (def elements (core.make-generator (lambda (random _size)
            (set! draws (1+ draws)) (random 5)) core.integer-shrinks
            current?: (lambda () (= captured epoch))))
          (def payloads (core.generator-list elements min-length: 2 max-length: 4))
          (def functions (core.make-generator (lambda (_random _size)
            (set! handlers (1+ handlers)) abs) (lambda (_) [])))
          (from-generator Batch
            (core.generator-map (core.generator-sequence (list functions payloads))
              (lambda (row) (make-instance Batch count: (length (cadr row))
                payload: (cadr row) route: 'put handler: (car row))))
            (lambda (batch) (+ (.get batch count) (apply + (.get batch payload)))))))
      ;; The ordinary FUN action retains typed Record admission and diagnostics.
      (def (run sampler)
        ((property-debug-action #f Batch (lambda (batch)
          (check-equal? ((.@ batch handler) -7) 7)
          (check-equal? (.get batch count) (length (.get batch payload)))
          (zero? (.get batch count))) sampler: sampler)
          (make-instance PropertyConfiguration seed: 41 cases: 1 size: 8 shrink-budget: 96)))
      (def sampler (prepare))
      (def report (run sampler))
      (check-eq? (.get report status) 'failed)
      (check-equal? (.get (.get report counterexample) payload) '(0 0))
      (check-equal? (.get (.get report counterexample) count) 2)
      (check-equal? draws (.get (.get report original) count))
      (check-equal? handlers 1)
      (let (before draws)
        (check (replay-counterexample report) => #f)
        (check-equal? draws before)
        (check-eq? (.get (replay-property report) status) 'failed)
        (check-equal? draws (* 2 before)))
      (check-exception ((.@ (.get report counterexample) handler) 'invalid) TypeError?)
      (set! epoch 1)
      (let ((before draws) (prepared handlers))
        (check-eq? (.get (run sampler) status) 'stale)
        (check-exception (replay-counterexample report) Error?)
        (check-equal? (list draws handlers) (list before prepared)))
      (check-eq? (.get (run (prepare)) status) 'failed)
      (check-eq? (.get (run sampler) status) 'stale))
    (test-case "scaled typed batches reject old owners before sibling preparation"
      (def epoch 0) (def handlers 0) (def scales 0)
      ;; Explicit preparation captures one revision, never reviving old reports.
      (def (prepare)
        (let (captured epoch)
          (def counts (core.make-generator (lambda (_random size) size)
            core.integer-shrinks current?: (lambda () (= captured epoch))))
          (def scaled (core.generator-scale counts
            (lambda (size) (set! scales (1+ scales)) (quotient size 2))))
          (def functions (core.make-generator (lambda (_random _size)
            (set! handlers (1+ handlers)) abs) (lambda (_) [])))
          (def pipeline (core.generator-map (core.generator-sequence (list functions scaled))
            (lambda (row) (make-instance Batch count: (cadr row) payload: []
              route: 'put handler: (car row)))))
          (from-generator Batch pipeline (lambda (batch) (.get batch count)))))
      (def sampler (prepare))
      ;; FUN runs the ordinary typed checker; Record owns Function admission.
      (def (run sampler)
        ((property-debug-action #f Batch (lambda (batch)
          (check-equal? ((.@ batch handler) -3) 3)
          (< (.get batch count) 2)) sampler: sampler)
         (make-instance PropertyConfiguration seed: 41 cases: 1 size: 8)))
      (def report (run sampler))
      (check-eq? (.get report status) 'failed)
      (check-equal? (.get (.get report original) count) 4)
      (check-equal? (.get (.get report counterexample) count) 2)
      (check-equal? (list handlers scales) '(1 1))
      (check-exception ((.@ (.get report counterexample) handler) 'invalid) TypeError?)
      (check (replay-counterexample report) => #f)
      (check-equal? (list handlers scales) '(1 1))
      (check-eq? (.get (replay-property report) status) 'failed)
      (check-equal? (list handlers scales) '(2 2))
      (set! epoch 1)
      (check-eq? (.get (run sampler) status) 'stale)
      (check-exception (replay-counterexample report) Error?)
      (check-equal? (list handlers scales) '(2 2))
      (check-eq? (.get (run (prepare)) status) 'failed)
      (check-equal? (list handlers scales) '(3 3))
      (check-eq? (.get (run sampler) status) 'stale))
    (test-case "Record FUN replay checks retired shrink owners before reconstruction"
      (def configuration (.o epoch: 0)) (def advance? #t) (def constructions 0)
      ;; Only the rejected shrink branch owns the epoch. The root has a constant
      ;; value, but its draw can retire a source observed by an earlier run.
      (def (prepare)
        (def raw (core.make-tree-generator (lambda (_random _size)
          (when advance? (.set! configuration epoch (1+ (.get configuration epoch))))
          (core.make-sample 9 (lambda ()
            (def stamp (.get configuration epoch))
            (list (core.make-sample 0 (lambda () [])
              (lambda () (= stamp (.get configuration epoch))))))))))
        (from-generator Batch (core.generator-map raw (lambda (count)
          (set! constructions (1+ constructions))
          (make-instance Batch count: count payload: [] route: 'put handler: abs)))
          (lambda (batch) (.get batch count))))
      ;; DEBUG/FUN retains the original property runner and Record/Function
      ;; validation; source checks cannot be refreshed by opening a new core view.
      (def (run sampler)
        ((property-debug-action #f Batch (lambda (batch)
          (check-equal? ((.@ batch handler) -5) 5) (< (.get batch count) 1)) sampler: sampler)
          (make-instance PropertyConfiguration cases: 1 shrink-budget: 4)))
      (def original (run (prepare)))
      (check-eq? (.get original status) 'failed)
      (check-equal? constructions 2)
      (check (replay-counterexample original) => #f)
      (check-eq? (.get (replay-property original) status) 'stale)
      (check-equal? constructions 2)
      (check-exception (replay-counterexample original) Error?)
      (def fresh (run (prepare)))
      (check-eq? (.get fresh status) 'failed)
      (check-equal? constructions 4)
      (check-exception ((.@ (.get fresh counterexample) handler) 'wrong) TypeError?)
      (set! advance? #f)
      (check-eq? (.get (replay-property fresh) status) 'failed)
      (check-equal? constructions 6)
      (.set! configuration epoch (1+ (.get configuration epoch)))
      (check-exception (replay-property fresh) Error?))
    (test-case "rejected Record branches guard later construction through FUN retry shrinking and replay"
      (def configuration (.o epoch: 0)) (def revise? #t) (def constructions 0) (def draws 0)
      ;; Each check has a private retry schedule. Only the rejected branch declares
      ;; the mutable epoch, testing generic provenance rather than a facade guard.
      (def (prepare)
        (def stamp (.get configuration epoch))
        (def generation (core.generator-delay (lambda ()
          (def trial 0)
          (core.generator-filter (core.generator-sized (lambda (_size)
            (set! trial (1+ trial))
            (if (= trial 1)
              (core.make-generator (lambda (_random _size)
                (set! draws (1+ draws))
                (make-instance Batch count: 0 payload: [] route: 'put handler: abs)) (lambda (_) [])
                current?: (lambda () (= stamp (.get configuration epoch))))
              (core.generator-map (core.make-generator (lambda (_random _size)
                (set! draws (1+ draws)) (when revise? (.set! configuration epoch (1+ stamp))) 4)
                core.integer-shrinks)
                (lambda (count) (set! constructions (1+ constructions))
                  (make-instance Batch count: count payload: [] route: 'put handler: abs))))))
            (lambda (batch) (> (.get batch count) 0)) attempts: 2))))
        (from-generator Batch generation (lambda (batch) (.get batch count))))
      ;; The existing DEBUG/FUN action consumes the normal Record sampler and
      ;; preserves recursive Function wrapping on every admitted shrink node.
      (def (run sampler)
        ((property-debug-action #f Batch (lambda (batch)
          (check-equal? ((.@ batch handler) -7) 7) (< (.get batch count) 2)) sampler: sampler)
          (make-instance PropertyConfiguration cases: 1 seed: 17 shrink-budget: 16)))
      (def old (prepare))
      (check-eq? (.get (run old) status) 'stale)
      (check-equal? (list draws constructions) '(2 0))
      (set! revise? #f)
      (def fresh (run (prepare)))
      (check-eq? (.get fresh status) 'failed)
      (check-equal? (.get (.get fresh counterexample) count) 2)
      (check-exception ((.@ (.get fresh counterexample) handler) 'wrong) TypeError?)
      (check-equal? draws 4)
      (check (replay-counterexample fresh) => #f)
      (check-equal? draws 4)
      (check-eq? (.get (replay-property fresh) status) 'failed)
      (check-equal? draws 6)
      (.set! configuration epoch 2)
      (check-exception (replay-counterexample fresh) Error?)
      (check-exception (replay-property fresh) Error?)
      (check-eq? (.get (run old) status) 'stale)
      (check-equal? draws 6))
    (test-case "Record FUN products refuse stale field sources before drawing and explicitly reprepare"
      (def epoch 0) (def draws 0)
      ;; A generic field owns an application revision even when the Record Type
      ;; itself is unchanged. Prepare a new captured epoch only for explicit retry.
      (def (prepare)
        (def stamp epoch)
        (def fields (core.generator-sequence
          (list (core.make-generator (lambda (_random _size) (set! draws (1+ draws)) 3)
                  core.integer-shrinks)
            (core.make-generator (lambda (_random _size) abs) (lambda (_) [])
              current?: (lambda () (= stamp epoch))))))
        (from-generator Batch (core.generator-map fields (lambda (row)
          (make-instance Batch count: (car row) payload: [] route: 'put handler: (cadr row))))
          (lambda (batch) (.get batch count))))
      ;; DEBUG/FUN consumes the normal typed sampler; no second runner or source
      ;; registry is involved. A stale preflight charges no trial or shrink attempt.
      (def (run sampler)
        ((property-debug-action #f Batch (lambda (batch)
          (check-equal? ((.@ batch handler) -5) 5) #f) sampler: sampler)
          (make-instance PropertyConfiguration seed: 19 cases: 1 shrink-budget: 16)))
      (def old (prepare))
      (set! epoch 1)
      (check-eq? (.get (run old) status) 'stale)
      (check-equal? draws 0)
      (def fresh (run (prepare)))
      (check-eq? (.get fresh status) 'failed)
      (check-equal? (.get (.get fresh counterexample) count) 0)
      (check-equal? draws 1)
      (check-exception ((.@ (.get fresh counterexample) handler) 'wrong) TypeError?)
      (check (replay-counterexample fresh) => #f)
      (check-eq? (.get (replay-property fresh) status) 'failed)
      (check-equal? draws 2)
      (set! epoch 2)
      (check-exception (replay-counterexample fresh) Error?)
      (check-eq? (.get (run old) status) 'stale)
      (check-equal? draws 2))
    (test-case "Record products share domain measures preserve handlers and reprepare after refusal"
      (def configuration (.o epoch: 0)) (def revise? #t) (def later 0)
      (def handler-type (Function [Integer] [Integer]))
      (def count (make-generator UInt (lambda (_random _size) 3) core.integer-shrinks
        (lambda (value) (when revise? (.set! configuration epoch 1)) value)))
      (def handler (make-generator handler-type (lambda (_random _size) abs) (lambda (_) [])
        (lambda (_) (set! later (1+ later)) 0) dependencies: (list configuration)))
      ;; The ordinary Record constructor owns Function wrapping, while the shared
      ;; product specification owns measures and source refusal for every field.
      (def (prepare)
        (product-generator Batch (list count handler)
          (lambda (batch) (list (.get batch count) (.@ batch handler)))
          (lambda (row) (make-instance Batch count: (car row) payload: (make-list (car row) 0)
            route: 'put handler: (cadr row)))))
      ;; Run the same typed property through the existing FUN observation boundary.
      (def (run sampler)
        ((property-debug-action #f Batch batch-correct? sampler: sampler)
          (make-instance PropertyConfiguration cases: 1 shrink-budget: 32)))
      (def refused (run (prepare)))
      (check-eq? (.get refused status) 'stale)
      (check-equal? later 0)
      (set! revise? #f)
      (def retry (run (prepare)))
      (check-eq? (.get retry status) 'failed)
      (check-equal? (.get (.get retry counterexample) count) 2)
      (check-exception ((.@ (.get retry counterexample) handler) 'wrong) TypeError?)
      (check (replay-counterexample retry) => #f)
      (check-eq? (.get (replay-property retry) status) 'failed)
      (.set! configuration epoch 2)
      (check-exception (replay-property retry) Error?))
    (test-case "indexed collection traces reject revised models then reprepare through FUN"
      (def subject (collection.collection-model collection.lifecycle))
      (def revise? #t) (def steps 0) (def closed 0)
      ;; The actual indexed delta workflow owns real roots and tickets. Only its
      ;; first step injects a declaration edit; cleanup remains with the fixture.
      (def (with-system use)
        (try
          (collection.with-collection-system (lambda (system)
            (def step (.@ system step))
            (use (.cc system step: (lambda (state command)
              (defvalues (next result) (step state command))
              (set! steps (1+ steps))
              (when revise? (.set! subject observe (.@ subject observe)))
              (values next result))))))
          (finally (set! closed (1+ closed)))))
      ;; Fresh preparation is explicit. A refused run cannot refresh old stamps.
      (def (run)
        (def sampler (trace-generator collection.Command subject steps: 64))
        ((property-debug-action #f (.get sampler descriptor)
          (trace-property subject with-system) sampler: sampler)
          (make-instance PropertyConfiguration cases: 1 size: 64 shrink-budget: 8)))
      (def refused (run))
      (check-eq? (.get refused status) 'stale)
      (check-equal? (list steps closed) '(1 1))
      (check-exception (replay-property refused) Error?)
      (set! revise? #f) (set! steps 0)
      (def retried (run))
      (check-eq? (.get retried status) 'passed)
      (check-equal? steps (length (.get retried original)))
      (check (>= steps (length collection.lifecycle)) => #t)
      (check-equal? closed 2)
      (check-eq? (.get (replay-property retried) status) 'passed)
      (check-equal? closed 3))
    (test-case "call input promises share derivation across keyword rest shrinking FUN and replay"
      (def configuration (.o maximum: 8)) (def preparations 0)
      (def input (.o self: domain inherit: [Type.] .element?: (cut element? UInt <>)
        .generator: (lambda ()
          (set! preparations (1+ preparations))
          (make-generator domain
            (lambda (random _size) (+ 2 (random (.get configuration maximum))))
            core.integer-shrinks abs dependencies: (list configuration)))))
      (def signature (Function [Integer Integer] [input] optional: [input] rest: input
        keywords: (list (cons scale: input)) required-keywords: [scale:]))
      (def checked (validate signature (lambda (x (y 0) scale: scale . tail)
        (values (+ x y scale (apply + tail)) (length tail)))))
      (def arguments (FunctionArguments signature))
      (def sampler (generator arguments))
      ;; The Type factory is dormant until a selected call actually supplies it.
      (check-equal? preparations 0)
      ;; Observe both checked results without bypassing keyword/default forwarding.
      (def (property row)
        (defvalues (total extras) (apply checked row))
        (and (>= extras 0) (< total 2)))
      (def report ((property-debug-action #f arguments property sampler: sampler)
        (make-instance PropertyConfiguration seed: 9 cases: 10 size: 4 shrink-budget: 64)))
      (check-eq? (.get report status) 'failed)
      (check (element? arguments (.get report counterexample)) => #t)
      (check-equal? preparations 1)
      (check-exception (checked -1 scale: 0) TypeError?)
      (check (replay-counterexample report) => #f)
      (check-eq? (.get (replay-property report) status) 'failed)
      (check-equal? preparations 1)
      ;; The selected child contributes its own external dependency to the tree.
      (.set! configuration maximum 12)
      (check-exception (replay-property report) Error?)
      (def retry (check-property arguments property cases: 1 seed: 9 size: 4 shrink-budget: 64))
      (check-eq? (.get retry status) 'failed)
      (check-equal? preparations 2))
    (test-case "independent Record fields retain wrapped handlers through FUN shrinking and replay"
      (def draws 0)
      (def fields (core.generator-sequence
        (list (core.make-generator (lambda (_random _size) 2) core.integer-shrinks)
          (core.make-generator (lambda (_random _size) (set! draws (1+ draws)) abs)
            (lambda (_) [])))))
      (def generation (core.generator-map fields (lambda (row)
        (make-instance Batch count: (car row) payload: '(7 8) route: 'put handler: (cadr row)))))
      (def sampler (from-generator Batch generation (lambda (batch) (.get batch count))))
      (def report ((property-debug-action #f Batch (lambda (batch)
        (check-equal? ((.@ batch handler) -7) 7) #f) sampler: sampler)
        (make-instance PropertyConfiguration cases: 1 shrink-budget: 16)))
      (check-eq? (.get report status) 'failed)
      (check-equal? (.get (.get report counterexample) count) 0)
      (check-equal? (.get (.get report counterexample) payload) '(7 8))
      (check-equal? draws 1)
      (check-exception ((.@ (.get report counterexample) handler) 'wrong) TypeError?)
      (check (replay-counterexample report) => #f)
      (check-equal? draws 1)
      (check-eq? (.get (replay-property report) status) 'failed)
      (check-equal? draws 2))
    (test-case "retained dependent Record subtrees cannot refresh their original branch epoch"
      (def epoch 0) (def calls 0)
      (def generation (core.generator-bind
        (core.make-generator (lambda (_random _size) 3)
          (lambda (count) (if (> count 0) (list (1- count)) [])))
        (lambda (count)
          (let (stamp epoch)
            (core.make-generator (lambda (_random _size)
              (make-instance Batch count: count payload: (make-list count 0) route: 'put handler: abs))
              (lambda (_) []) current?: (lambda () (or (not (= count 3)) (= stamp epoch))))))))
      ;; A downstream consumer may retain a sample and lift it through the normal
      ;; typed bridge. Its origin authority must survive that separate execution.
      (def (retain-smaller)
        (def root (core.generate generation (core.random-at 17) 3))
        (car (for/collect (child ((core.sample-children root))) child)))
      (def (sampler-for tree)
        (from-generator Batch (core.make-tree-generator (lambda (_random _size) tree))
          (lambda (batch) (.get batch count))))
      (def old (retain-smaller))
      (set! epoch 1)
      (def refused ((property-debug-action #f Batch
        (lambda (_) (set! calls (1+ calls)) #f) sampler: (sampler-for old))
        (make-instance PropertyConfiguration cases: 1)))
      (check-eq? (.get refused status) 'stale)
      (check-equal? calls 0)
      (def current (retain-smaller))
      (def report ((property-debug-action #f Batch batch-correct? sampler: (sampler-for current))
        (make-instance PropertyConfiguration seed: 17 cases: 1 shrink-budget: 32)))
      (check-eq? (.get report status) 'failed)
      (check-equal? (.get (.get report counterexample) count) 2)
      (check-exception ((.@ (.get report counterexample) handler) 'invalid) TypeError?)
      (check-eq? (replay-counterexample report) #f)
      (check-equal? (.get (.get (replay-property report) counterexample) count) 2)
      (set! epoch 2)
      (check-exception (replay-property report) Error?))
    (test-case "FUN policy revisions stop shrink effects and require fresh preparation"
      (def rules (.o epoch: 0))
      (def calls [])
      (def sampler (make-generator UInt (lambda (_random _size) 9) (lambda (_) '(0)) identity))
      (def policy (policy.make-policy precondition: (lambda (value)
        (when (and (zero? value) (zero? (.get rules epoch)))
          (.putslot! rules 'epoch ($constant-slot-spec 1))) #t)))
      (def action (property-debug-action #f UInt
        (lambda (value) (set! calls (cons value calls)) #f) sampler: sampler dependencies: (list rules)))
      (def configuration (make-instance PropertyConfiguration cases: 1 policy: policy))
      (def stale (action configuration))
      (check-eq? (.get stale status) 'stale)
      (check-equal? calls '(9))
      (check-equal? (.get stale counterexample) 9)
      (check-equal? (.get stale attempts) 1)
      (check-equal? (.get stale steps) 0)
      (check-eq? (cdr (assq 'status (report-diagnostics stale))) 'stale)
      (check-exception (replay-property stale) Error?)
      ;; A new execution captures the revised rules; it does not refresh stale evidence.
      (def retried (action configuration))
      (check-eq? (.get retried status) 'failed)
      (check-equal? (.get retried counterexample) 0)
      (check-eq? (replay-counterexample retried) #f)
      (check-equal? (.get (replay-property retried) counterexample) 0)
      (check-exception (replay-property stale) Error?))
    (test-case "typed model block shrinking preserves dependencies through FUN and both replays"
      (def command (Enum noise open use))
      (def state (List command))
      (def commands '(noise noise open use))
      (def parameter-calls 0) (def opened 0) (def closed 0)
      ;; Pure state retains processed commands; producer identity is the open tag.
      (def (enabled state command) (case command
        ((open) (not (memq 'open state))) ((use) (and (memq 'open state) #t)) (else #t)))
      (def (step state command) (values (cons command state) #t))
      (def model (make-instance TraceGenerator Command: command State: state Result: Bool Observation: state
        initial: (lambda () []) enabled?: enabled advance: step observe: identity
        draw: (lambda (state _random _size) (some (list-ref commands (length state))))
        shrink: (lambda (_) (set! parameter-calls (1+ parameter-calls)) []) measure: (lambda (_) 0)))
      (def sampler (trace-generator command model steps: 4))
      (def system-type (TraceSystem state))
      (def (fixture use)
        (set! opened (1+ opened))
        (try (use (make-instance system-type initial: [] observe: identity
          step: (lambda (state command)
            (values (cons command state)
              (not (and (eq? command 'use) (even? (length (filter (cut eq? <> 'noise) state)))))))))
          (finally (set! closed (1+ closed)))))
      (def action (property-debug-action #f (.get sampler descriptor)
        (trace-property model fixture) sampler: sampler))
      (def full (action (make-instance PropertyConfiguration cases: 1 size: 4 shrink-budget: 0)))
      (check-equal? (.get full counterexample) commands)
      (check-equal? parameter-calls 0)
      (def report (action (make-instance PropertyConfiguration seed: 17 cases: 1 size: 4 shrink-budget: 32)))
      (check-eq? (.get report status) 'failed)
      (check-equal? (.get report counterexample) '(open use))
      (check (.get report minimal?) => #t)
      (check-eq? (replay-counterexample report) #f)
      (check-equal? (.get (replay-property report) counterexample) '(open use))
      (check-equal? opened closed)
      (.putslot! model 'epoch ($constant-slot-spec 1))
      (check-exception (replay-property report) Error?))
    (test-case "Enum canonical ranks preserve duplicates empty alternatives and value shrinking"
      (def descriptor (Enum read write admin write))
      (def sampler (generator descriptor))
      ;; The recursive grammar adds its existing one-node carrier cost.
      (check-equal? (.call sampler measure 'write) 2)
      (check-equal? (.call sampler shrink 'admin) '(read write))
      (check-equal? (.call sampler shrink 'write) '(read))
      (check-equal? (.call sampler shrink 'read) [])
      (check-eq? (.get (check-property (Enum) true) status) 'exhausted)
      (check-eq? (.get (check-property (Union (Enum) (Exactly #f)) not cases: 3) status) 'passed))
    (test-case "nested Enum collections simplify through FUN and retain stale replay refusal"
      (def role (Enum read write admin write))
      (def descriptor (List (Tuple role (Exactly #f))))
      (def sampler (generator descriptor))
      (def action (property-debug-action #f descriptor
        (lambda (rows) (every (lambda (row) (eq? (vector-ref row 0) 'read)) rows)) sampler: sampler))
      (def report (action (make-instance PropertyConfiguration seed: 42 cases: 30 size: 4 shrink-budget: 100)))
      (check-eq? (.get report status) 'failed)
      (check (.get report minimal?) => #t)
      (check-equal? (.get report counterexample) (list (vector 'write #f)))
      (check-eq? (replay-counterexample report) #f)
      (check-equal? (.get (replay-property report) counterexample) (.get report counterexample))
      (.putslot! role 'epoch ($constant-slot-spec 1))
      (check-exception (replay-counterexample report) Error?)
      (check-exception (replay-property report) Error?))
    (test-case "finite Map preparation refuses normalization mismatches and source revisions"
      (def integers (generator UInt))
      (def calls 0)
      (def Key (.cc Symbol .validate: (lambda (key) (set! calls (1+ calls)) 'a)))
      (def descriptor (Map Key -> UInt))
      (check-exception (map-generator descriptor '(a a) integers) Error?)
      (check-equal? calls 0)
      (check-exception (map-generator descriptor '(a) integers domain-limit: 0) Error?)
      (check-equal? calls 0)
      (check-exception (map-generator descriptor '(a b) integers) Error?)
      (check-exception (map-generator descriptor '(a) (generator Integer)) Error?)
      (let* ((configuration (.o epoch: 0)) (visited 0)
             (ChangingKey (.cc Symbol .validate: (lambda (key)
               (set! visited (1+ visited))
               (.putslot! configuration 'epoch ($constant-slot-spec 1)) key))))
        (check-exception (map-generator (Map ChangingKey -> UInt) '(a b) integers
          dependencies: (list configuration)) Error?)
        (check-equal? visited 1)))
    (test-case "finite Map validation wraps raw Functions and preserves every key"
      (def callable (Function [UInt] [(Exactly 0)]))
      (def values (make-generator callable (lambda (_random _size) (lambda (_) 7))
        (lambda (_) []) (lambda (_) 0)))
      (def descriptor (Map (Enum a b) -> callable))
      (def sampler (map-generator descriptor '(a b) values))
      (def table (core.sample-value (core.generate (generator-core sampler) (lambda (_) 0) 2)))
      (check-equal? (hash-length table) 2)
      (for-each (lambda (key)
        (check-equal? ((hash-ref table key) 0) 7)
        (check-exception ((hash-ref table key) 1) TypeError?)) '(a b))
      (def checked (validate descriptor table))
      (check-exception ((hash-ref checked 'a) 1) TypeError?))
    (test-case "Record finite Maps shrink wrapped values and replay through FUN and corpus data"
      (def configuration (.o score: 4))
      (def keys '(a b c))
      (def descriptor (Map (Enum a b c) -> Batch))
      (def Directory (Record routes: [descriptor]))
      (def draws 0)
      ;; One ordinary Record constructor restores the linked payload and Function.
      (def (cell score) (make-instance Batch count: score payload: (make-list score 0)
        route: 'put handler: (lambda (_) score)))
      ;; Explicit preparation captures fresh dependency epochs. The derived Record
      ;; sampler forwards its child Map's existing currentness hook.
      (def (prepare)
        (def cells (from-generator Batch (core.generator-map
          (core.make-generator (lambda (_random _size) (set! draws (1+ draws)) (.get configuration score))
            core.integer-shrinks) cell) (lambda (value) (.get value count)) dependencies: (list configuration)))
        (def maps (map-generator descriptor keys cells))
        (values maps (.cc (from-generator Directory (core.generator-map (generator-core maps)
          (lambda (table) (make-instance Directory routes: table)))
          (lambda (value) (.call maps measure (.get value routes))) dependencies: (list maps configuration))
          .current?: (.@ maps .current?))))
      ;; The controlled fault is an excessive aggregate, after checking all linked
      ;; Function results. Hash iteration order never defines the shrink schedule.
      (def (safe? value)
        (def table (.get value routes))
        (and (hash-fold (lambda (_key item valid) (and valid (= ((.@ item handler) 0) (.get item count)))) #t table)
          (< (hash-fold (lambda (_key item total) (+ total (.get item count))) 0 table) 2)))
      (let*-values (((maps sampler) (prepare)))
        (def report ((property-debug-action #f Directory safe? sampler: sampler)
          (make-instance PropertyConfiguration seed: 41 cases: 20 size: 3)))
        (check-eq? (.get report status) 'failed)
        (check (.get report minimal?) => #t)
        (def table (.get (.get report counterexample) routes))
        (check-equal? (hash-length table) 1)
        (def item (cdar (hash->list table)))
        (check-equal? (.get item count) 2)
        (check-exception ((.@ item handler) 'invalid) TypeError?)
        (let (before draws)
          (check-eq? (replay-counterexample report) #f)
          (check-equal? draws before)
          (check-eq? (.get (replay-property report) status) 'failed))
        ;; A bounded inspection of the empty Map invokes no value producer.
        (let* ((before draws) (diagnostic (inspect-generator maps count: 1 size: 0)))
          (check-eq? (policy.inspection-status diagnostic) 'complete)
          (check-equal? draws before))
        ;; Corpora store logical entries, never closures or hash traversal order.
        (def codec (corpus.make-codec '(directory 1)
          (lambda (value) (let (table (.get value routes))
            (map (lambda (key) (cons key (.get (hash-ref table key) count)))
              (filter (lambda (key) (hash-key? table key)) keys))))
          (lambda (rows)
            (def table (list->hash-table (map (lambda (row) (cons (car row) (cell (validate UInt (cdr row))))) rows) seed: 0))
            (unless (= (hash-length table) (length rows)) (error "duplicate stored route"))
            (make-instance Directory routes: table))))
        (def output (open-output-string))
        (write-counterexample report codec output)
        (def text (get-output-string output))
        (check-eq? (read-counterexample sampler codec (open-input-string text) safe?) #f)
        (.putslot! configuration 'score ($constant-slot-spec 8))
        (check-exception (replay-counterexample report) Error?)
        (check-exception (read-counterexample sampler codec (open-input-string text) safe?) Error?)
        (let*-values (((fresh-maps fresh) (prepare)))
          (check-eq? (read-counterexample fresh codec (open-input-string text) safe?) #f)
          (check-eq? (.get (check-property Directory safe? sampler: fresh seed: 41 cases: 20 size: 3) status) 'failed))))
    (test-case "Record dependency revisions stop construction and require explicit fresh preparation"
      (let*-values (((descriptor configuration) (make-batch-domain)))
        (def constructions 0) (def properties 0)
        ;; Fresh preparation captures current typed sources; an old sampler never
        ;; silently refreshes a source revision encountered in its selector.
        (def (prepare revise?)
          (def pipeline (core.generator-bind (generator-core (generator descriptor))
            (lambda (batch)
              (when revise? (.putslot! configuration 'maximum ($constant-slot-spec 8)))
              (core.make-generator (lambda (_random _size)
                (set! constructions (1+ constructions))
                (make-instance Batch count: (.get batch count) payload: (.get batch payload)
                  route: (.get batch route) handler: (.@ batch handler))) (lambda (_) [])))))
          (from-generator descriptor pipeline (lambda (batch) (.get batch count)) dependencies: (list configuration)))
        ;; The requested FUN action returns refusal data without opening the property.
        (def (run sampler)
          ((property-debug-action #f descriptor (lambda (batch)
            (set! properties (1+ properties)) (batch-correct? batch)) sampler: sampler)
            (make-instance PropertyConfiguration seed: 41 cases: 1 size: 3)))
        (def stale (run (prepare #t)))
        (check-eq? (.get stale status) 'stale)
        (check-equal? (list constructions properties) '(0 0))
        (check-exception (replay-property stale) Error?)
        (def fresh (run (prepare #f)))
        (check-eq? (.get fresh status) 'failed)
        (check (> (.get fresh steps) 0) => #t)
        (check-equal? (.get (.get fresh counterexample) count) 2)
        ;; Parent shrinking regenerates dependent children. Concrete replay draws
        ;; none; seed replay must repeat the entire same construction schedule.
        (let ((before constructions) (trials properties))
          (check-eq? (replay-counterexample fresh) #f)
          (check-equal? constructions before)
          (check-equal? properties (1+ trials))
          (check-eq? (.get (replay-property fresh) status) 'failed)
          (check-equal? constructions (* 2 before))
          (check-equal? properties (1+ (* 2 trials))))))
    (test-case "typed corpus policy admits wrapped Record functions without coverage callbacks"
      (let*-values (((descriptor configuration) (make-batch-domain)))
        (def sampler (generator descriptor))
        (def report ((property-debug-action #f descriptor batch-correct? sampler: sampler)
          (make-instance PropertyConfiguration seed: 41 cases: 1 size: 3)))
        ;; Store all logical fields; ordinary construction restores the known handler.
        (def codec (corpus.make-codec '(batch-policy 1)
          (lambda (batch) (list (.get batch count) (.get batch payload) (.get batch route)))
          (lambda (row) (make-instance Batch count: (car row) payload: (cadr row)
            route: (caddr row) handler: abs))))
        (def output (open-output-string))
        (write-counterexample report codec output)
        (def text (get-output-string output))
        (def calls 0)
        (def policy (policy.make-policy precondition: (lambda (batch)
          (and (= ((.@ batch handler) -7) 7) (>= (.get batch count) 2)))
          labels: (lambda (_) (error "replay must not classify coverage")) required: '((batch . 100))))
        (check-eq? (read-counterexample sampler codec (open-input-string text)
          (lambda (batch) (set! calls (1+ calls)) (batch-correct? batch)) policy: policy) #f)
        (check-equal? calls 1)
        (check-exception (read-counterexample sampler codec (open-input-string text)
          (lambda (_) (set! calls (1+ calls)) #f)
          policy: (policy.make-policy precondition: (lambda (_)
            (.putslot! configuration 'maximum ($constant-slot-spec 8)) #t))) Error?)
        (check-equal? calls 1)))
    (test-case "Record FUN handoff refuses stale confirmation before encoding and retries with a fresh codec"
      (let*-values (((descriptor configuration) (make-batch-domain)))
        (def sampler (generator descriptor))
        (def publication (.o epoch: 0))
        (def transferring? #f) (def encodes 0)
        ;; The publication epoch belongs to the codec, independently of the stable
        ;; failing batch domain. Reconfirmation can retire it before encoding.
        (def (correct? batch)
          (when (and transferring? (zero? (.get publication epoch)))
            (.putslot! publication 'epoch ($constant-slot-spec 1)))
          (batch-correct? batch))
        (def report ((property-debug-action #f descriptor correct? sampler: sampler)
          (make-instance PropertyConfiguration seed: 41 cases: 1 size: 3)))
        ;; Codec preparation captures one epoch and stores only logical data;
        ;; ordinary Record construction restores inherited Function validation.
        (def (prepare-codec)
          (def epoch (.get publication epoch))
          (corpus.make-codec (list 'batch-handoff epoch)
            (lambda (batch) (set! encodes (1+ encodes)) (list (.get batch payload) (.get batch route)))
            (lambda (row) (make-instance Batch count: (length (car row)) payload: (car row)
              route: (cadr row) handler: abs))
            current?: (lambda () (= epoch (.get publication epoch)))))
        (def retired (prepare-codec))
        (def output (open-output-string))
        (set! transferring? #t)
        (check-exception (write-counterexample report retired output) Error?)
        (check-equal? encodes 0)
        (check-equal? (get-output-string output) "")
        (def fresh (prepare-codec))
        (write-counterexample report fresh output)
        (check-equal? encodes 1)
        (def text (get-output-string output))
        (def input (open-input-string text))
        (check-exception (read-counterexample sampler retired input batch-correct?) Error?)
        (check-equal? (read input) (read (open-input-string text)))
        (check-eq? (read-counterexample sampler fresh (open-input-string text)
          (lambda (batch)
            (check-equal? (.get batch count) (length (.get batch payload)))
            (check-exception ((.@ batch handler) 'invalid) TypeError?)
            (batch-correct? batch))) #f)))
    (test-case "typed Record corpus replay brackets decoding with source revisions"
      (let*-values (((descriptor configuration) (make-batch-domain)))
        (def sampler (generator descriptor))
        (def report ((property-debug-action #f descriptor batch-correct? sampler: sampler)
          (make-instance PropertyConfiguration seed: 41 cases: 1 size: 3)))
        ;; Codecs retain logical data; the normal constructor restores Function wrapping.
        (def (decode payload) (make-instance Batch count: (length payload) payload: payload route: 'put handler: abs))
        (def codec (corpus.make-codec '(batch 1) (lambda (batch) (.get batch payload)) decode))
        (def output (open-output-string))
        (write-counterexample report codec output)
        (def text (get-output-string output))
        (check-eq? (read-counterexample sampler codec (open-input-string text) batch-correct?) #f)
        (def calls 0)
        (def stale-codec (corpus.make-codec '(batch 1) (lambda (batch) (.get batch payload))
          (lambda (payload) (.putslot! configuration 'maximum ($constant-slot-spec 8)) (decode payload))))
        (check-exception (read-counterexample sampler stale-codec (open-input-string text)
          (lambda (_) (set! calls (1+ calls)) #f)) Error?)
        (check-equal? calls 0)
        (def refused (open-output-string))
        (check-exception (write-counterexample report codec refused) Error?)
        (check-equal? (get-output-string refused) "")))
    (test-case "Record FUN shrinking removes middle payloads and retains wrapped callbacks"
      (def generation (core.generator-map
        (core.make-tree-generator (lambda (_random _size)
          (core.sample-sequence (map (lambda (value) (core.make-sample value (lambda () []))) '(11 99 22)))))
        (lambda (payload) (make-instance Batch count: (length payload) payload: payload route: 'put handler: abs))))
      (def sampler (from-generator Batch generation
        (lambda (batch) (+ (.get batch count) (apply + (.get batch payload))))))
      (def action (property-debug-action #f Batch (lambda (batch)
        (not (and (memv 11 (.get batch payload)) (memv 22 (.get batch payload))))) sampler: sampler))
      (def report (action (make-instance PropertyConfiguration seed: 42 cases: 1 shrink-budget: 32)))
      (check-eq? (.get report status) 'failed)
      (check-equal? (.get (.get report counterexample) payload) '(11 22))
      (check-equal? (.get (.get report counterexample) count) 2)
      (check-equal? ((.@ (.get report counterexample) handler) -7) 7)
      (check-eq? (replay-counterexample report) #f)
      (check-equal? (.get (.get (replay-property report) counterexample) payload) '(11 22)))
