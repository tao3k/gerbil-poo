;;; Size control retains static input ownership and the existing lazy sample tree.
(export size-test-cases! collection-source-test-cases!)
(import :std/test :std/error :std/iter
        (prefix-in :clan/poo/testing/property/generator generator.)
        (prefix-in :clan/poo/testing/property property.))

;; Wrap a known producer through ordinary static combinators. Open selection is
;; tested separately because unselected branches are not fixed participants.
(def (size-combination kind first scaled)
  (case kind
    ((scale) scaled)
    ((map) (generator.generator-map scaled identity))
    ((resize) (generator.generator-resize scaled 4))
    ((no-shrink) (generator.generator-no-shrink scaled))
    ((with-shrink) (generator.generator-with-shrink scaled generator.integer-shrinks))
    ((filter) (generator.generator-filter scaled exact-integer? attempts: 1))
    ((product) (generator.generator-sequence (list first scaled)))
    ((function) (generator.generator-function '((key))
      (generator.generator-map scaled list)))
    (else (error "unknown size combination" kind))))

;; Register these ordinary cases in the existing independent kernel suite.
(def (size-test-cases!)
  (test-case "constant size envelopes reject before observing or classifying sources"
    (def observations 0) (def classifications 0)
    (for (bounds (list (cons 1 0) (cons 20 3) (cons (expt 2 80) (1- (expt 2 80)))))
      (check-exception (property.prepare-property-check size: (car bounds) size-limit: (cdr bounds)
        size-current?: (lambda () (set! observations (1+ observations)) #t)
        classify-error: (lambda (_) (set! classifications (1+ classifications)) 'error)) Error?))
    (check-equal? (list observations classifications) '(0 0)))
  (test-case "inclusive constant size bounds retain zero defaults and independent replay"
    (def generation (generator.generator-sized generator.generator-unit))
    (def domain (property.make-specification exact-integer? abs))
    (for (bounds '((0 . 0) (0 . 4) (4 . 4) (1 . 4)))
      (def run (property.prepare-property-check cases: 2 seed: 17
        size: (car bounds) size-limit: (cdr bounds)))
      (def report (run generation (cut = <> (car bounds)) domain))
      (check-eq? (property.report-status report) 'passed)
      (check-equal? (property.report-trial-size report) (car bounds))
      (check-equal? (property.report-accepted report) 2)
      (check-eq? (property.report-status (property.replay-property report)) 'passed))
    (for (size '(0 4))
      (check-eq? (property.report-status (property.check-property generation (cut = <> size)
        domain cases: 1 size: size)) 'passed)))
  (test-case "scheduled size envelopes remain lazy and preserve runtime bound and false causes"
    (def calls 0) (def draws 0)
    (def generation (generator.make-generator (lambda (_r size) (set! draws (1+ draws)) size) (lambda (_) [])))
    (def domain (property.make-specification exact-integer? abs))
    (def run (property.prepare-property-check cases: 1 size: (lambda (_) (set! calls (1+ calls)) 2) size-limit: 1))
    (check-equal? calls 0)
    (def report (run generation (lambda (_) #t) domain))
    (check-eq? (property.report-status report) 'error)
    (check-equal? (Error-message (property.report-cause report)) "size policy exceeded its declared limit")
    (check-equal? (property.report-trial-size report) 2)
    (check-equal? (list calls draws) '(1 0))
    (def failed (property.check-property generation (lambda (_) #t) domain cases: 1
      size: (lambda (_) (raise #f)) size-limit: 1))
    (check-eq? (property.report-status failed) 'error)
    (check-eq? (property.report-cause failed) #f)
    (check-eq? (property.report-trial-size failed) #f)
    (check-equal? draws 0))
  (test-case "scaled input ownership survives every static composition before drawing"
    (for (kind '(scale map resize no-shrink with-shrink filter product function))
      (def live #t) (def draws 0) (def scales 0) (def prefixes 0) (def randoms 0)
      (def base (generator.make-generator (lambda (_random size) (set! draws (1+ draws)) size)
        generator.integer-shrinks current?: (lambda () live)))
      (def scaled (generator.generator-scale base (lambda (size) (set! scales (1+ scales)) (+ size 2))))
      (def first (generator.make-generator (lambda (_random _size) (set! prefixes (1+ prefixes)) 1)
        (lambda (_) [])))
      (def combined (size-combination kind first scaled))
      (set! live #f)
      (check (generator.generator-current? combined) => #f)
      (check-exception (generator.generate combined (lambda (_) (set! randoms (1+ randoms)) 0) 5)
        generator.stale-generation?)
      (check-equal? (list draws scales prefixes randoms) '(0 0 0 0))))
  (test-case "scale owner revision and callback causes stop before target drawing"
    (for (kind '(base owner revise cause))
      (def live #t) (def owner #t) (def draws 0) (def calls 0)
      (def cause (Error "scale callback cause"))
      (def base (generator.make-generator (lambda (_random size) (set! draws (1+ draws)) size)
        generator.integer-shrinks current?: (lambda () live)))
      (def scaled (generator.generator-scale base (lambda (size)
        (set! calls (1+ calls)) (set! live #f)
        (if (eq? kind 'cause) (raise cause) size)) current?: (lambda () owner)))
      (case kind ((base) (set! live #f)) ((owner) (set! owner #f)))
      (def failure (with-catch identity (lambda () (generator.generate scaled (generator.random-at 3) 5))))
      (if (eq? kind 'cause) (check-eq? failure cause)
        (check (generator.stale-generation? failure) => #t))
      (check-equal? draws 0)
      (check-equal? calls (if (memq kind '(base owner)) 0 1))
      (check-equal? (generator.sample-value
        (generator.generate (generator.generator-unit 7) (generator.random-at 3) 5)) 7)))
  (test-case "nested size controls preserve order seeds and retained shrinking"
    (def live #t) (def order []) (def draws 0) (def shrinks 0)
    (def base (generator.make-generator (lambda (random size)
      (set! draws (1+ draws)) (list size (random 17)))
      (lambda (row) (set! shrinks (1+ shrinks))
        (if (zero? (car row)) [] (list (list (quotient (car row) 2) (cadr row))))) current?: (lambda () live)))
    (def nested (generator.generator-resize (generator.generator-scale
      (generator.generator-scale base (lambda (size) (set! order (cons 'inner order)) (1+ size)))
      (lambda (size) (set! order (cons 'outer order)) (* 2 size))) 3))
    (def root (generator.generate nested (generator.random-at 17) 99))
    (check-equal? (car (generator.sample-value root)) 7)
    (check-equal? (reverse order) '(outer inner))
    (check-equal? draws 1)
    (check-equal? (generator.sample-value root)
      (generator.sample-value (generator.generate base (generator.random-at 17) 7)))
    (check-equal? draws 2)
    (check-equal? (for/collect (child ((generator.sample-children root))) (generator.sample-value child))
      (list (list 3 (cadr (generator.sample-value root)))))
    (check-equal? (reverse order) '(outer inner))
    (check-equal? (length (generator.sample-sources root)) 1)
    (set! live #f)
    (check ((generator.sample-current root)) => #f)
    (let (before shrinks)
      (check-exception (for/collect (child ((generator.sample-children root))) child) generator.stale-generation?)
      (check-equal? shrinks before)))
  (test-case "size admission keeps open selection and invalid-size failures distinct"
    (def calls 0) (def draws 0)
    (def base (generator.make-generator (lambda (_random size) (set! draws (1+ draws)) size)
      generator.integer-shrinks))
    (check-exception (generator.generator-scale #f identity) RuntimeException?)
    (for (invalid '(#f -1 1/2 bad))
      (check-exception (generator.generate
        (generator.generator-scale base (lambda (_) (set! calls (1+ calls)) invalid))
        (generator.random-at 1) 4) Error?))
    (check-equal? (list calls draws) '(4 0))
    (def live #t)
    (def retired (generator.make-generator (lambda (_random _size) (error "unselected draw"))
      (lambda (_) []) current?: (lambda () live)))
    (def scaled (generator.generator-scale retired (lambda (size) (set! calls (1+ calls)) size)))
    (def selected (generator.generator-sized (lambda (size)
      (if (zero? size) (generator.generator-unit 0) retired))))
    (set! live #f)
    (check (generator.generator-current? selected) => #t)
    (check-equal? (generator.sample-value (generator.generate selected (generator.random-at 1) 0)) 0)
    (def inspection (property.inspect-generator scaled
      (property.make-specification exact-integer? abs) count: 0))
    (check-eq? (property.inspection-status inspection) 'stale)
    (check-equal? (property.inspection-draws inspection) 0)
    (check-equal? calls 4)))


;; Mapped carriers reuse the same cardinality/ownership policy, not new validators.
(def (collection-generator kind element minimum)
  (case kind
    ((list) (generator.generator-list element min-length: minimum max-length: 3))
    ((string) (generator.generator-string element min-length: minimum max-length: 3))
    ((symbol) (generator.generator-symbol element min-length: minimum max-length: 3))
    (else (error "unknown collection carrier" kind))))

;; Register ordinary std/test cases alongside the existing size controls.
(def (collection-source-test-cases!)
  (test-case "prepared hash directories refuse malformed bounds and duplicate keys"
    (for (keys (list '(left . tail) '(left left) (list "same" (string-copy "same"))))
      (check-exception (generator.prepare-hash-generator keys) Error?))
    (for (limit '(-1 0 1/2 #f))
      (check-exception (generator.prepare-hash-generator '(left) domain-limit: limit) Error?))
    (def empty (generator.prepare-hash-generator [] domain-limit: 0))
    (check-equal? (hash-length (generator.sample-value
      (generator.generate (empty (generator.generator-unit #f)) (lambda (_) 0) 0))) 0))
  (test-case "prepared hash directories own topology and bind independent producers"
    (def keys (list 'left 'right))
    (def bind (generator.prepare-hash-generator keys domain-limit: 2))
    (set-car! keys 'changed) (set-cdr! keys [])
    (for (value '(#f 9))
      (def table (generator.sample-value
        (generator.generate (bind (generator.generator-unit value)) (lambda (_) 0) 2)))
      (check-equal? (hash-length table) 2)
      (check-equal? (hash-ref table 'left) value)
      (check-equal? (hash-ref table 'right) value)
      (check (hash-key? table 'changed) => #f)))
  (test-case "prepared and direct hash workflows retain shrinking replay and source refusal"
    (def live #t) (def draws 0)
    (def values (generator.make-generator
      (lambda (_random _size) (set! draws (1+ draws)) 4) generator.integer-shrinks))
    (def bind (generator.prepare-hash-generator '(left right)))
    (def domain (property.make-specification hash-table?
      (lambda (table) (+ (hash-length table)
        (hash-fold (lambda (_key value total) (+ total (abs value))) 0 table)))))
    (def direct (generator.generator-hash '(left right) values current?: (lambda () live)))
    (def prepared (bind values current?: (lambda () live)))
    (def first (property.check-property direct (lambda (_) #f) domain cases: 1 seed: 23))
    (def second (property.check-property prepared (lambda (_) #f) domain cases: 1 seed: 23))
    (check-equal? (property.report-status second) 'failed)
    (check-equal? (hash->list (property.report-counterexample first))
      (hash->list (property.report-counterexample second)))
    (check-equal? (property.report-attempts first) (property.report-attempts second))
    (check (property.replay-counterexample second) => #f)
    (check-equal? (property.report-status (property.replay-property second)) 'failed)
    (set! live #f)
    (let (before draws)
      (check-exception (generator.generate prepared (lambda (_) 0) 2) generator.stale-generation?)
      (check-exception (property.replay-counterexample second) Error?)
      (check-equal? draws before)))
  (test-case "mandatory collection sources preflight before prefix and length work"
    (for (kind '(list string symbol))
      (def live #t) (def prefixes 0) (def randoms 0) (def draws 0)
      (def element (generator.make-generator (lambda (_random _size)
        (set! draws (1+ draws)) #\a) (lambda (_) []) current?: (lambda () live)))
      (def carrier (collection-generator kind element 1))
      (def prefix (generator.make-generator (lambda (_random _size)
        (set! prefixes (1+ prefixes)) 1) (lambda (_) [])))
      (def product (generator.generator-sequence (list prefix carrier)))
      (set! live #f)
      (check (generator.generator-current? carrier) => #f)
      (check (generator.generator-current? product) => #f)
      (check-exception (generator.generate product
        (lambda (_) (set! randoms (1+ randoms)) 0) 3) generator.stale-generation?)
      (check-equal? (list prefixes draws randoms) '(0 0 0))))
  (test-case "empty selection does not acquire an unused element source"
    (for (kind '(list string symbol))
      (def draws 0)
      (def element (generator.make-generator (lambda (_random _size)
        (set! draws (1+ draws)) #\a) (lambda (_) []) current?: (lambda () #f)))
      (def carrier (collection-generator kind element 0))
      (check (generator.generator-current? carrier) => #t)
      (def root (generator.generate carrier (generator.random-at 17) 0))
      (check-equal? (generator.sample-value root)
        (case kind ((list) []) ((string) "") ((symbol) (string->symbol ""))))
      (check-equal? (generator.sample-sources root) [])
      (check-equal? draws 0)))
  (test-case "sized common sources are copied deduplicated and checked before selection"
    (def live #t) (def calls 0)
    (def owner (lambda () live))
    (def leaves (list owner owner))
    (def sized (generator.generator-sized (lambda (size)
      (set! calls (1+ calls)) (generator.generator-unit size)) sources: leaves))
    (set-car! leaves (lambda () #t))
    (def root (generator.generate sized (generator.random-at 3) 4))
    (check-equal? (generator.sample-value root) 4)
    (check-equal? (length (generator.sample-sources root)) 1)
    (set! live #f)
    (check-exception (generator.generate sized (generator.random-at 3) 4) generator.stale-generation?)
    (check-equal? calls 1)
    (check-exception (generator.generator-sized (lambda (_) (generator.generator-unit 0)) sources: '(bad)) Error?)
    (check-equal? (generator.sample-value
      (generator.generate (generator.generator-unit 9) (generator.random-at 3) 4)) 9))
  (test-case "positive minimum retains shapes sources seeds and shrinking without redrawing"
    (def live #t) (def draws 0)
    (def element (generator.make-generator (lambda (random _size)
      (set! draws (1+ draws)) (random 5)) generator.integer-shrinks current?: (lambda () live)))
    (def carrier (generator.generator-list element min-length: 1 max-length: 3))
    (def root (generator.generate carrier (generator.random-at 41) 3))
    (def values (generator.sample-value root))
    (check (<= 1 (length values) 3) => #t)
    (check-equal? draws (length values))
    (check-equal? (generator.sample-value (generator.generate carrier (generator.random-at 41) 3)) values)
    (let (before draws)
      (for (child ((generator.sample-children root)))
        (check (<= 1 (length (generator.sample-value child)) 3) => #t)
        (check-equal? (length (generator.sample-sources child)) 1))
      (check-equal? draws before))
    (set! live #f)
    (check-exception (for/collect (child ((generator.sample-children root))) child) generator.stale-generation?)))
