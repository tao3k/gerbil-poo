;;; Bounded model drawing uses the generic protocol and standard Gerbil contracts.
(export trace-fixture-test-cases! trace-owned-test-cases! trace-lazy-test-cases! trace-draw-test-cases! trace-sequence-test-cases! trace-action-test-cases!)
(import :std/test :std/error :std/iter (only-in :std/list/list take drop-right)
        (prefix-in :clan/poo/testing/property property.)
        (prefix-in :clan/poo/testing/property/generator generator.)
        (prefix-in :clan/poo/testing/property/model model.)
        (prefix-in :clan/poo/testing/property/replay replay.))

;; Register ordinary cases in the existing independent kernel suite.
(def (trace-draw-test-cases!)
  (test-case "trace limits reject reverse fractional and unbounded ranges before effects"
    (def starts 0) (def draws 0) (def accepts 0)
    (def reference (model.make-model (lambda () (set! starts (1+ starts)) 0)
      (lambda (_state _command) #t) (lambda (state _command) (values (1+ state) #f))
      identity (lambda (_) (set! accepts (1+ accepts)) #t) identity))
    ;; Every malformed budget is exercised in both dimensions, including NaN.
    (for-each (lambda (bad)
      (for-each (lambda (limits)
        (check-exception (model.draw-trace reference
          (lambda (_state _random _size) (set! draws (1+ draws)) (values #t 'step))
          (car limits) (generator.random-at 1) (cadr limits)) Error?))
        (list (list bad 4) (list 4 bad))))
      (list -1 -5 1/2 2.0 +inf.0 -inf.0 +nan.0 #f 'unbounded))
    (check-equal? (list starts draws accepts) '(0 0 0)))
  (test-case "trace callable and model contracts refuse before initialization"
    (def starts 0)
    (def reference (model.make-model (lambda () (set! starts (1+ starts)) 0)
      (lambda (_state _command) #t) (lambda (state _command) (values state #f)) identity (lambda (_) #t) identity))
    (check-exception (model.draw-trace #f (lambda (_state _random _size) (values #f #f))
      0 (generator.random-at 1) 0) Error?)
    (check-exception (model.draw-trace reference #f 0 (generator.random-at 1) 0) Error?)
    (check-exception (model.draw-trace reference (lambda (_state _random _size) (values #f #f))
      0 #f 0) Error?)
    (check-equal? starts 0))
  (test-case "natural caps preserve state order original size and zero initialization"
    (for-each (lambda (limits)
      (def starts 0) (def calls [])
      (def reference (model.make-model (lambda () (set! starts (1+ starts)) 0)
        (lambda (state command) (= state command))
        (lambda (state _command) (values (1+ state) #f)) identity exact-integer? identity))
      (def trace (model.draw-trace reference (lambda (state _random size)
        (set! calls (cons (list state size) calls)) (values #t state))
        (car limits) (generator.random-at 1) (cadr limits)))
      (check-equal? (length trace) (min (car limits) (cadr limits)))
      (check-equal? trace (iota (length trace)))
      (check-equal? (reverse calls) (map (lambda (state) (list state (cadr limits))) trace))
      (check-equal? starts 1))
      (list '(0 4) '(4 0) '(2 5) '(5 2) (list (expt 2 70) 3))))
  (test-case "early stop false commands and exact callback causes keep their boundaries"
    (def steps 0) (def normalized 0) (def cause (cons 'trace 'cause))
    (def reference (model.make-model (lambda () 0) (lambda (_state _command) #t)
      (lambda (state _command) (set! steps (1+ steps)) (values (1+ state) #f)) identity
      boolean? (lambda (raw) (set! normalized (1+ normalized)) raw)))
    (def trace (model.draw-trace reference (lambda (state _random _size)
      (if (= state 2) (values #f 'not-a-command) (values #t #f)))
      5 (generator.random-at 1) 4))
    (check-equal? trace '(#f #f))
    (check-equal? (list steps normalized) '(2 2))
    (check-eq? (with-catch identity (lambda () (model.draw-trace reference
      (lambda (_state _random _size) (raise cause)) 1 (generator.random-at 1) 1))) cause)
    (def failing (model.make-model (lambda () (raise cause)) (lambda (_state _command) #t)
      (lambda (state _command) (values state #f)) identity boolean? identity))
    (check-eq? (with-catch identity (lambda () (model.draw-trace failing
      (lambda (_state _random _size) (error "zero-cap draw")) 0 (generator.random-at 1) 4))) cause)
    (def disabled (model.make-model (lambda () 0) (lambda (_state _command) #f)
      (lambda (state _command) (set! steps (1+ steps)) (values state #f)) identity boolean? identity))
    (check-exception (model.draw-trace disabled (lambda (_state _random _size) (values #t #f))
      1 (generator.random-at 1) 1) Error?)
    (check-equal? steps 2)
    (check-exception (model.draw-trace reference (lambda (_state _random _size) (values 'maybe #f))
      1 (generator.random-at 1) 1) Error?)))


;; A cyclic spine is a finite malformed graph, not a lazy Iterator. Standard list?
;; detects it without traversing an unbounded sequence or adding a graph registry.
(def (invalid-spines)
  (let (cycle (list 'item))
    (set-cdr! cycle cycle)
    (list #f '#(item) '(item . tail) cycle)))

;; All finite sequence consumers share shape/source admission and exact failures.
(def (trace-sequence-test-cases!)
  (test-case "invalid trace spines refuse before initialization or prefix repair"
    (def starts 0) (def advances 0) (def parameters 0) (def fixtures 0)
    (def reference (model.make-model (lambda () (set! starts (1+ starts)) 0)
      (lambda (_state _command) #t)
      (lambda (state _command) (set! advances (1+ advances)) (values state #f)) identity (lambda (_) #t) identity))
    (for (invalid (invalid-spines))
      (check (model.valid-trace? reference invalid) => #f)
      (check-exception (model.repair-trace reference invalid) Error?)
      (check-exception (model.shrink-trace reference invalid
        (lambda (_) (set! parameters (1+ parameters)) [])) Error?)
      (check-exception (model.check-trace reference invalid
        (lambda (_) (set! fixtures (1+ fixtures)) (error "invalid fixture entry"))) Error?)
      (check-exception (generator.list-deletions invalid 0) Error?)
      (check-exception (generator.data-list-shrinks invalid
        (lambda (_) (set! parameters (1+ parameters)) []) 0) Error?))
    (check-equal? (list starts advances parameters fixtures) '(0 0 0 0)))
  (test-case "invalid parameter spines cannot publish prefixes or start candidate repair"
    (for (invalid (invalid-spines))
      (def starts 0) (def calls 0) (def properties 0)
      (def reference (model.make-model (lambda () (set! starts (1+ starts)) 0)
        (lambda (_state _command) #t) (lambda (state _command) (values state #f)) identity exact-integer? identity))
      ;; The callback terminates; its returned shape is what must be rejected.
      (def (shrink _) (set! calls (1+ calls)) invalid)
      (check-exception (model.shrink-trace reference '(2 4) shrink) Error?)
      (check-equal? (list starts calls) '(0 1))
      (set! calls 0)
      (def producer (generator.make-generator (lambda (_random _size) '(2 4))
        (lambda (items) (generator.data-list-shrinks items shrink 0))))
      (def report (property.check-property producer (lambda (_) (set! properties (1+ properties)) #f)
        (property.make-specification list? length) cases: 1 shrink-budget: 8))
      (check-eq? (property.report-status report) 'error)
      (check-equal? (property.report-attempts report) 0)
      (check-equal? (property.report-counterexample report) '(2 4))
      (check-equal? (list starts calls properties) '(0 1 1))))
  (test-case "parameter source revision and exact callback causes stop the next coordinate"
    (for (throws? '(#f #t))
      (def live #t) (def calls 0) (def cause (cons 'parameter 'cause))
      (def producer (generator.make-generator (lambda (_random _size) '(2 4))
        (lambda (items) (generator.data-list-shrinks items (lambda (_)
          (set! calls (1+ calls)) (set! live #f) (if throws? (raise cause) '(0))) 0))
        current?: (lambda () live)))
      (def report (property.check-property producer (lambda (_) #f)
        (property.make-specification list? length) cases: 1 shrink-budget: 8))
      (check-eq? (property.report-status report) 'stale)
      (check-equal? (list calls (property.report-attempts report) (property.report-steps report)) '(1 0 0))
      (check-equal? (property.report-counterexample report) '(2 4))
      (if throws? (check-eq? (property.report-cause report) cause)
        ;; Run-local refusal exits without fabricating an application exception.
        (check-eq? (property.report-cause report) #f))))
  (test-case "finite policy order and dependency repair retain bounded lazy iterators"
    (def calls [])
    (check-equal? (generator.data-list-shrinks '(4 6) (lambda (value)
      (set! calls (cons value calls)) (if (= value 4) '(0 2) '(0 3))) 1)
      '((6) (4) (0 6) (2 6) (4 0) (4 3)))
    (check-equal? (reverse calls) '(4 6))
    (def reference (model.make-model (lambda () 0) (lambda (_state _command) #t)
      (lambda (state _command) (values state #f)) identity boolean? identity))
    (check-equal? (model.repair-trace reference '(#f omitted #t)) '(#f #t))
    ;; Infinite Iterators remain legal for the general lazy protocol: only the
    ;; finite value-policy boundary is constrained to proper lists.
    (def producer (generator.make-generator (lambda (_random _size) 2)
      (lambda (_) (in-coroutine (lambda (yield) (let loop () (yield 0) (loop)))))))
    (def report (property.check-property producer (lambda (_) #f)
      (property.make-specification exact-integer? abs) cases: 1 shrink-budget: 5))
    (check-eq? (property.report-status report) 'failed)
    (check-equal? (property.report-attempts report) 5)
    (check-equal? (property.report-steps report) 1)
    (check-equal? (property.report-counterexample report) 0)
    (check (property.report-minimal? report) => #f)))

;; Execute one model action under ordinary producer ownership. No private model
;; access or second source ledger participates in these source-boundary controls.
(def (trace-owned-result action current)
  (with-catch identity (lambda ()
    (generator.generate (generator.make-generator (lambda (_random _size) (action))
      (lambda (_) []) current?: current) (generator.random-at 17) 3))))

;; Register source-sensitive trace checks in the standard independent TestSuite.
(def (trace-action-test-cases!)
  (test-case "draw revision stops at each model action rather than the outer return"
    (for-each (lambda (target)
      (def live #t) (def calls [])
      ;; Record callback order independently of the model's state and false payloads.
      (def (touch phase value)
        (set! calls (append calls (list phase)))
        (when (eq? phase target) (set! live #f)) value)
      (def reference (model.make-model (lambda () (touch 'initial 0))
        (lambda (_state _command) (touch 'enabled #t))
        (lambda (state _command) (touch 'advance #f) (values (1+ state) #f))
        identity (lambda (_) (touch 'accept #t)) (lambda (value) (touch 'normalize value))))
      (def result (trace-owned-result (lambda ()
        (model.draw-trace reference (lambda (_state _random _size)
          (touch 'draw #f) (values #t #f)) 3 (generator.random-at 1) 3)) (lambda () live)))
      (check (generator.stale-generation? result) => #t)
      (let (order '(initial draw accept normalize enabled advance))
        (check-equal? calls (take order (1+ (- (length order) (length (memq target order))))))))
      '(initial draw accept normalize enabled advance)))
  (test-case "admission and dependency repair stop before advancing revised commands"
    (for-each (lambda (run)
      (def live #t) (def advances 0) (def normalizes 0)
      (def reference (model.make-model (lambda () 0) (lambda (_state _command) #t)
        (lambda (state _command) (set! advances (1+ advances)) (values state #f))
        identity (lambda (_) (set! live #f) #t)
        (lambda (value) (set! normalizes (1+ normalizes)) value)))
      (check (generator.stale-generation? (trace-owned-result (lambda () (run reference '(#f #t)))
        (lambda () live))) => #t)
      (check-equal? (list advances normalizes) '(0 0)))
      (list model.valid-trace? model.repair-trace
        (lambda (reference commands) (model.shrink-trace reference commands (lambda (_) []))))))
  (test-case "reference fixture equality and teardown revisions suppress later effects"
    (for-each (lambda (target)
      (def live #t) (def active #f) (def effects []) (def closed 0)
      ;; Only differential execution participates; preparation remains pure here.
      (def (touch phase)
        (when active
          (set! effects (append effects (list phase)))
          (when (eq? phase target) (set! live #f))))
      (def reference (model.make-model (lambda () (touch 'initial) 0) (lambda (_state _command) #t)
        (lambda (state _command) (touch 'advance) (values (1+ state) #f))
        (lambda (state) (touch 'expected) state) (lambda (_) #t) identity))
      ;; Standard dynamic unwinding owns cleanup even when an inner source refuses.
      (def (fixture use)
        (set! active #t)
        (try (touch 'setup)
          (use (model.make-system 0 (lambda (state _command) (touch 'step) (values (1+ state) #f))
            (lambda (state) (touch 'actual) state)))
          (finally (set! closed (1+ closed)) (touch 'cleanup))))
      (def result (trace-owned-result (lambda ()
        (model.check-trace reference '(#f #t) fixture same?: (lambda (_phase left right)
          (touch 'equal) (equal? left right)))) (lambda () live)))
      (check (generator.stale-generation? result) => #t)
      (check-equal? closed 1)
      (check-eq? (last effects) 'cleanup)
      (unless (eq? target 'cleanup)
        (check-eq? (last (drop-right effects 1)) target)))
      '(setup initial expected actual equal advance step cleanup)))
  (test-case "model actions retain multiple values exact causes and ordinary false data"
    (def cause (cons 'model 'cause)) (def live #t) (def actual 0)
    (def reference (model.make-model (lambda () 0) (lambda (_state _command) #t)
      (lambda (state _command) (values (1+ state) #f)) identity (lambda (_) #t) identity))
    (check-equal? (model.draw-trace reference (lambda (_state _random _size) (values #t #f))
      2 (generator.random-at 4) 2) '(#f #f))
    (let (report (model.check-trace reference '(#f #t)
      (lambda (use) (use (model.make-system 0
        (lambda (state _command) (set! actual (1+ actual)) (values (1+ state) #f)) identity)))))
      (check (model.trace-report-matched? report) => #t)
      (check-equal? actual 2))
    (def broken (model.make-model (lambda () (set! live #f) (raise cause))
      (lambda (_state _command) #t) (lambda (state _command) (values state #f)) identity (lambda (_) #t) identity))
    (check-eq? (trace-owned-result (lambda () (model.repair-trace broken [])) (lambda () live)) cause))
  (test-case "run-local specification revision interrupts fixture steps and permits a fresh retry"
    (def live #t) (def steps 0) (def closed 0)
    (def reference (model.make-model (lambda () 0) (lambda (_state _command) #t)
      (lambda (state _command) (values (1+ state) #f)) identity (lambda (_) #t) identity))
    (def specification (property.make-specification list? length current?: (lambda () live)))
    ;; The generator is immutable; only the active property's domain changes.
    (def (execute revise?)
      (property.check-property (generator.generator-unit '(#f #t))
        (lambda (commands) (model.trace-report-matched? (model.check-trace reference commands
          (lambda (use) (try
            (use (model.make-system 0 (lambda (state _command)
              (set! steps (1+ steps)) (when revise? (set! live #f)) (values (1+ state) #f)) identity))
            (finally (set! closed (1+ closed)))))))) specification cases: 1))
    (let (report (execute #t))
      (check-eq? (property.report-status report) 'stale)
      (check-eq? (property.report-cause report) #f)
      (check-equal? (list steps closed) '(1 1)))
    (set! live #t)
    (check-eq? (property.report-status (execute #f)) 'passed)
    (check-equal? (list steps closed) '(3 2))))

;; A standard pure reference for counting draw/repair initialization separately.
(def (index-model (initial (lambda () 0)))
  (model.make-model initial (lambda (_state _command) #t)
    (lambda (state _command) (values (1+ state) 0)) identity exact-integer? identity))
;; State supplies deterministic commands without consuming an extra random source.
(def (index-draw state _random _size) (values #t state))

;; Lazy trace trees use the same finite sequence neighborhood and repair oracle.
(def (trace-lazy-test-cases!)
  (test-case "zero and one proposal budgets skip every unused parameter callback"
    (for (budget '(0 1))
      (let ((starts 0) (parameters 0))
        (def reference (index-model (lambda () (set! starts (1+ starts)) 0)))
        (def source (model.trace-generator reference index-draw
          (lambda (_) (set! parameters (1+ parameters)) (error "unused parameter shrink")) 8))
        (def report (property.check-property source (lambda (_) #f)
          (property.make-specification list? length) cases: 1 size: 8 shrink-budget: budget))
        (check-eq? (property.report-status report) 'failed)
        (check-equal? (property.report-attempts report) budget)
        (check-equal? (property.report-counterexample report) (if (zero? budget) (iota 8) []))
        (check (property.report-minimal? report) => #f)
        (check-equal? (list starts parameters) (list (1+ budget) 0)))))
  (test-case "lazy root draws and complete neighborhoods agree with the finite value policy"
    (def reference (index-model))
    ;; Both factories receive the same untouched PRNG and the same size.
    (def (draw _state random _size) (values #t (random 100)))
    (def source (model.trace-generator reference draw generator.integer-shrinks 4))
    (def root (generator.generate source (generator.random-at 42) 4))
    (def commands (model.draw-trace reference draw 4 (generator.random-at 42) 4))
    (check-equal? (generator.sample-value root) commands)
    (check-equal? (for/collect (child ((generator.sample-children root))) (generator.sample-value child))
      (model.shrink-trace reference commands generator.integer-shrinks)))
  (test-case "accepted repaired traces rebuild their own neighborhoods without orphan origins"
    (def commands '(open use open use))
    (def reference (model.make-model (lambda () (cons 0 #f))
      (lambda (state command) (or (eq? command 'open) (cdr state)))
      (lambda (state command) (values (cons (1+ (car state)) (or (cdr state) (eq? command 'open))) #t))
      identity symbol? identity))
    (def source (model.trace-generator reference
      (lambda (state _random _size) (values #t (list-ref commands (car state)))) (lambda (_) []) 4))
    (def root (generator.generate source (generator.random-at 1) 4))
    (def children (for/collect (child ((generator.sample-children root))) child))
    ;; The fourth raw deletion removes just the first open. Repair also drops
    ;; its orphan use; descendants must start from the remaining (open use).
    (def repaired (list-ref children 3))
    (check-equal? (generator.sample-value repaired) '(open use))
    (for (child children) (check (model.valid-trace? reference (generator.sample-value child)) => #t))
    (check-equal? (for/collect (child ((generator.sample-children repaired))) (generator.sample-value child))
      (model.shrink-trace reference '(open use) (lambda (_) []))))
  (test-case "malformed demanded parameter lists refuse after precisely charged structural proposals"
    (for (invalid (invalid-spines))
      (let ((parameters 0))
        (def reference (index-model))
        (def source (model.trace-generator reference index-draw
          (lambda (_) (set! parameters (1+ parameters)) invalid) 2))
        (def report (property.check-property source (lambda (trace) (not (equal? trace '(0 1))))
          (property.make-specification list? length) cases: 1 size: 2 shrink-budget: 8))
        (check-eq? (property.report-status report) 'error)
        (check-equal? (list (property.report-attempts report) (property.report-steps report) parameters) '(3 0 1))
        (check-equal? (property.report-counterexample report) '(0 1)))))
  (test-case "parameter exceptions retain false causes and never become false witnesses"
    (for* ((retire? '(#f #t)) (cause (list #f (cons 'parameter 'cause))))
      (let ((alive #t) (parameters 0))
        (def source (model.trace-generator (index-model) index-draw
          (lambda (_) (set! parameters (1+ parameters))
            (when retire? (set! alive #f)) (raise cause)) 2 current?: (lambda () alive)))
        (def report (property.check-property source (lambda (trace) (not (equal? trace '(0 1))))
          (property.make-specification list? length) cases: 1 size: 2 shrink-budget: 8))
        (check-eq? (property.report-status report) (if retire? 'stale 'error))
        (check-eq? (property.report-cause report) cause)
        (check-equal? (list (property.report-attempts report) (property.report-steps report) parameters) '(3 0 1))
        (check (property.report-minimal? report) => #f)
        (check-exception (property.replay-counterexample report) Error?))))
  (test-case "paused trace iterators reject old owners before repair and permit explicit fresh generation"
    (let ((epoch 0) (starts 0) (parameters 0))
      (def reference (index-model (lambda () (set! starts (1+ starts)) 0)))
      ;; Each fresh factory owns one immutable epoch; earlier trees never refresh.
      (def (prepare)
        (let (captured epoch)
          (model.trace-generator reference index-draw
            (lambda (_) (set! parameters (1+ parameters)) []) 4
            current?: (lambda () (= epoch captured)))))
      (def source (prepare))
      (def root (generator.generate source (generator.random-at 1) 4))
      (def before #f)
      ;; A coroutine retains its first pull's dynamic handler. Enclose both
      ;; pulls in one standard catch, rather than installing one only on resume.
      (def refusal (with-catch values (lambda ()
        (using (cursor (iter ((generator.sample-children root))) :- Iterator)
          (let (first (cursor.next!))
            (check-equal? (generator.sample-value first) [])
            (set! before starts) (set! epoch 1) (cursor.next!)
            (error "stale cursor unexpectedly resumed"))))))
      (check (generator.stale-generation? refusal) => #t)
      (check-equal? starts before)
      (check-equal? parameters 0)
      (check-equal? (generator.sample-value (generator.generate (prepare) (generator.random-at 1) 4)) '(0 1 2 3))
      (check-exception (generator.generate source (generator.random-at 1) 4) generator.stale-generation?)))
  (test-case "repair retirement stops before a second transition or parameter factory"
    (let ((alive #t) (repairing? #f) (transitions 0) (parameters 0))
      (def reference (model.make-model (lambda () 0) (lambda (_state _command) #t)
        (lambda (state _command)
          (when repairing? (set! transitions (1+ transitions)) (set! alive #f))
          (values (1+ state) 0)) identity integer? identity))
      (def source (model.trace-generator reference index-draw
        (lambda (_) (set! parameters 1) []) 4 current?: (lambda () alive)))
      (def report (property.check-property source (lambda (trace)
        (set! repairing? #t) (not (= (length trace) 4)))
        (property.make-specification list? length) cases: 1 size: 4 shrink-budget: 8))
      (check-eq? (property.report-status report) 'stale)
      (check-equal? (list (property.report-attempts report) transitions parameters) '(1 1 0))
      (check-equal? (property.report-counterexample report) '(0 1 2 3))))
  (test-case "trace generator contracts and standard source options precede initialization"
    (let ((starts 0))
      (def reference (index-model (lambda () (set! starts (1+ starts)) 0)))
      (check-exception (model.trace-generator #f index-draw (lambda (_) []) 0) Error?)
      (check-exception (model.trace-generator reference #f (lambda (_) []) 0) Error?)
      (check-exception (model.trace-generator reference index-draw #f 0) Error?)
      (for (invalid '(-1 1/2 2.0 #f))
        (check-exception (model.trace-generator reference index-draw (lambda (_) []) invalid) Error?))
      (check-exception (model.trace-generator reference index-draw (lambda (_) []) 0 current?: #f) Error?)
      (check-exception (model.trace-generator reference index-draw (lambda (_) []) 0 sources: '(bad)) Error?)
      (check-equal? starts 0)))
  (test-case "paired value and owned policies retain outcomes while demanded repair work stays bounded"
    (for* ((size '(1 8 128)) (order '((value tree) (tree value))))
      (for (policy order)
        (let ((starts 0) (parameters 0))
          (def reference (index-model (lambda () (set! starts (1+ starts)) 0)))
          ;; The counter is observational only; both policies see the same model,
          ;; draw callback, seed, size, property and total construction boundary.
          (def (shrink _) (set! parameters (1+ parameters)) [])
          (def source (if (eq? policy 'tree) (model.trace-generator reference index-draw shrink size)
            (generator.make-generator (lambda (random limit)
              (model.draw-trace reference index-draw size random limit))
              (cut model.shrink-trace reference <> shrink))))
          (def report (property.check-property source (lambda (_) #f)
            (property.make-specification list? length) seed: 42 cases: 1 size: size shrink-budget: 1))
          (check-eq? (property.report-status report) 'failed)
          (check-equal? (property.report-counterexample report) [])
          (check-equal? (property.report-attempts report) 1)
          (check-equal? parameters (if (eq? policy 'tree) 0 size))
          (check-equal? starts (if (eq? policy 'tree) 2 (1+ (generator.list-deletion-count size 0))))))))
  (test-case "model driven lazy traces shrink replay and freshly repair a real first difference"
    (let ((epoch 0) (fault? #t) (opened 0) (closed 0))
      (def commands '(noise open noise use))
      (def reference (model.make-model (lambda () (cons 0 #f))
        (lambda (state command) (or (not (eq? command 'use)) (cdr state)))
        (lambda (state command) (values (cons (1+ (car state)) (or (cdr state) (eq? command 'open)))
          (eq? command 'use))) identity symbol? identity))
      ;; Actual fixtures have their own transition and result implementation.
      (def (fixture use)
        (set! opened (1+ opened))
        (try (use (model.make-system (cons 0 #f)
          (lambda (state command) (values (cons (1+ (car state))
            (if (eq? command 'open) #t (cdr state))) (and (not fault?) (eq? command 'use)))) identity))
          (finally (set! closed (1+ closed)))))
      ;; Logical format identity serializes only commands, never fixtures or closures.
      (def (correct? trace) (model.trace-report-matched? (model.check-trace reference trace fixture)))
      (def domain (property.make-specification (cut model.valid-trace? reference <>) length))
      ;; Fresh factories capture a new source epoch; seed replay uses the old one.
      (def (prepare)
        (let (captured epoch)
          (model.trace-generator reference (lambda (state _random _size)
            (values #t (list-ref commands (car state)))) (lambda (_) []) 4
            current?: (lambda () (= epoch captured)))))
      (let (report (property.check-property (prepare) correct? domain cases: 1 size: 4 shrink-budget: 64))
        (check-eq? (property.report-status report) 'failed)
        (check-equal? (property.report-counterexample report) '(open use))
        (check (property.report-minimal? report) => #t)
        (check (property.replay-counterexample report) => #f)
        (check-equal? (property.report-counterexample (property.replay-property report)) '(open use))
        (let ((codec (replay.make-codec '(lazy-trace 1) values values)) (output (open-output-string)))
          (replay.write-counterexample report codec output)
          (check (replay.read-counterexample codec (open-input-string (get-output-string output)) domain correct?) => #f))
        (set! epoch 1) (set! fault? #f)
        (check-exception (property.replay-property report) Error?)
        (check-eq? (property.report-status
          (property.check-property (prepare) correct? domain cases: 2 size: 4)) 'passed)
        (check-exception (property.replay-property report) Error?))
      (check-equal? opened closed))))

;; Finite outer spines belong to preparation; payload identity and explicitly
;; declared source ownership stay with their existing application protocols.
(def (trace-owned-test-cases!)
  (test-case "finite neighborhoods isolate both phases from caller spine edits"
    (for (edit (list (lambda (row) (set-car! (cdr row) 99))
                    (lambda (row) (set-cdr! row []))
                    (lambda (row) (set-cdr! row 'improper))
                    (lambda (row) (set-cdr! row row))))
      (def input (list 4 6)) (def calls [])
      (def candidates (generator.data-list-shrinks input (lambda (value)
        (set! calls (cons value calls)) (when (= value 4) (edit input)) '(0)) 1))
      (check-equal? (reverse calls) '(4 6))
      (check-equal? candidates '((6) (4) (0 6) (4 0)))))
  (test-case "paused structural deletion retains its original finite snapshot"
    (def input (list 4 6))
    (def candidates (generator.list-deletions input 1))
    (set-car! input 99) (set-cdr! input input)
    (check-equal? (for/collect (candidate candidates) candidate) '((6) (4))))
  (test-case "model preparation snapshots before initial and each selection hook"
    (for (stage '(initial accept normalize enabled advance))
      (for (operation (list model.repair-trace model.valid-trace?))
        (def input (list 4 6)) (def seen []) (def edited? #f)
        ;; This changes the caller's cdr graph, not any command payload.
        (def (edit phase)
          (when (and (eq? stage phase) (not edited?))
            (set! edited? #t) (set-cdr! input input)))
        (def reference (model.make-model (lambda () (edit 'initial) 0)
          (lambda (_state _command) (edit 'enabled) #t)
          (lambda (state command) (edit 'advance) (set! seen (cons command seen))
            (values (+ state command) #f)) identity
          (lambda (_) (edit 'accept) #t) (lambda (value) (edit 'normalize) value)))
        (def result (operation reference input))
        (check-equal? result (if (eq? operation model.repair-trace) '(4 6) #t))
        (check-equal? (reverse seen) '(4 6)))))
  (test-case "differential preflight fixes commands before initialization edits"
    (def input (list 4 6)) (def steps []) (def opened 0) (def closed 0)
    (def reference (model.make-model (lambda () (set-cdr! input input) 0)
      (lambda (_state _command) #t) (lambda (state command) (values (+ state command) command))
      identity exact-integer? identity))
    (def report (model.check-trace reference input (lambda (use)
      (set! opened (1+ opened))
      (try (use (model.make-system 0 (lambda (state command)
        (set! steps (cons command steps)) (values (+ state command) command)) identity))
        (finally (set! closed (1+ closed)))))))
    (check (model.trace-report-matched? report) => #t)
    (check-equal? (model.trace-report-index report) 2)
    (check-equal? (list (reverse steps) opened closed) '((4 6) 1 1)))
  (test-case "finite model neighborhoods retain command order and payload identity"
    (def first (cons 'first 'payload)) (def second (cons 'second 'payload))
    (def input (list first second)) (def calls [])
    (def reference (model.make-model (lambda () 0) (lambda (_state _command) #t)
      (lambda (state _command) (values state #f)) identity pair? identity))
    (def candidates (model.shrink-trace reference input (lambda (value)
      (set! calls (cons value calls)) (when (eq? value first) (set-cdr! input [])) [])))
    (check-equal? (length candidates) 3)
    (check-eq? (car (reverse calls)) first) (check-eq? (cadr (reverse calls)) second)
    (check-eq? (car (cadr candidates)) second)
    (check-eq? (car (caddr candidates)) first))
  (test-case "snapshot copying cannot hide source retirement or original causes"
    (for (throws? '(#f #t))
      (def input (list 4 6)) (def calls 0) (def live #t) (def cause (cons 'owned 'cause))
      (def producer (generator.make-generator (lambda (_random _size) '(4 6))
        (lambda (_) (generator.data-list-shrinks input (lambda (_value)
          (set! calls (1+ calls)) (set-cdr! input input) (set! live #f)
          (if throws? (raise cause) '(0))) 1)) current?: (lambda () live)))
      (def report (property.check-property producer (lambda (_) #f)
        (property.make-specification list? length) cases: 1 shrink-budget: 8))
      (check-eq? (property.report-status report) 'stale)
      (check-equal? (list calls (property.report-attempts report)) '(1 0))
      (check-equal? (property.report-counterexample report) '(4 6))
      (check-eq? (property.report-cause report) (if throws? cause #f)))))

;; One pure reference is shared by lifetime controls; actual fixtures retain
;; their own step/observation functions and scoped cleanup responsibilities.
(def (fixture-reference)
  (model.make-model (lambda () 0) (lambda (_state _command) #t)
    (lambda (state command) (values (1+ state) command)) identity exact-integer? identity))

;; Lifecycle admission is independent of domains and applies before fixture
;; preparation. These ordinary cases also run in the isolated stdlib-only library.
(def (trace-fixture-test-cases!)
  (test-case "fixture preparation contracts precede model and fixture effects"
    (def effects 0)
    (def reference (model.make-model (lambda () (set! effects (1+ effects)) 0)
      (lambda (_state _command) #t) (lambda (state command) (values state command))
      identity exact-integer? identity))
    (check-exception (model.check-trace reference []
      (lambda (_) (set! effects (1+ effects))) prepare-system: #f) Error?)
    (check-equal? effects 0))
  (test-case "closed fixture callbacks cannot prepare raw values after success or error"
    (for (throws? '(#f #t))
      (def escape #f) (def preparations 0) (def cause (cons 'scope 'cause))
      (def result (with-catch identity (lambda ()
        (model.check-trace (fixture-reference) [] (lambda (use)
          (set! escape use)
          (if throws? (raise cause) (use 'raw)))
          prepare-system: (lambda (_raw)
            (set! preparations (1+ preparations))
            (model.make-system 0 (lambda (state command) (values state command)) identity))))))
      (if throws? (check-eq? result cause) (check (model.trace-report-matched? result) => #t))
      (def before preparations)
      (check-exception (escape 'must-not-prepare) Error?)
      (check-equal? preparations before)))
  (test-case "caught repeated fixture calls cannot deliver an earlier successful receipt"
    (def preparations 0) (def steps 0) (def closed 0)
    (check-exception (model.check-trace (fixture-reference) '(7)
      (lambda (use)
        (try (let (first (use 'first))
          (check-exception (use 'second) Error?) first)
          (finally (set! closed (1+ closed)))))
      prepare-system: (lambda (_raw)
        (set! preparations (1+ preparations))
        (model.make-system 0 (lambda (state command)
          (set! steps (1+ steps)) (values (1+ state) command)) identity))) Error?)
    (check-equal? (list preparations steps closed) '(1 1 1)))
  (test-case "caught reentry during preparation observation or steps poisons delivery"
    (for (phase '(prepare observe step))
      (def escape #f) (def preparations 0) (def steps 0) (def reentries 0) (def nested 0)
      (def child (generator.make-generator (lambda (_random _size) (set! nested (1+ nested)) 7)
        (lambda (_) [])))
      ;; Catching the attempted use must not erase the scope's use counter.
      (def (reenter target)
        (when (eq? phase target)
          (set! reentries (1+ reentries))
          (check-exception (escape 'reentrant) Error?)
          (check-exception (generator.generate child (generator.random-at 0) 0) Error?)))
      (check-exception (model.check-trace (fixture-reference) '(7)
        (lambda (use) (set! escape use) (use 'raw))
        prepare-system: (lambda (_raw)
          (set! preparations (1+ preparations)) (reenter 'prepare)
          (model.make-system 0 (lambda (state command)
            (set! steps (1+ steps)) (reenter 'step) (values (1+ state) command))
            (lambda (state) (reenter 'observe) state)))) Error?)
      (check-equal? preparations 1)
      (check-equal? steps (if (eq? phase 'step) 1 0))
      (check-equal? (list reentries nested) '(1 0))))
  (test-case "admitted preparation preserves false and object causes and closes escape"
    (for (cause (list #f (cons 'prepare 'cause)))
      (def escape #f) (def preparations 0)
      (check-eq? (with-catch identity (lambda ()
        (model.check-trace (fixture-reference) []
          (lambda (use) (set! escape use) (use 'raw))
          prepare-system: (lambda (_) (set! preparations (1+ preparations)) (raise cause))))) cause)
      (check-exception (escape 'late) Error?)
      (check-equal? preparations 1)))
  (test-case "preparation retirement skips actual observation and restores nested authority"
    (def live #t) (def preparations 0) (def observations 0)
    (def result (trace-owned-result (lambda ()
      (model.check-trace (fixture-reference) [] (lambda (use) (use 'raw))
        prepare-system: (lambda (_)
          (set! preparations (1+ preparations)) (set! live #f)
          (model.make-system 0 (lambda (state command) (values state command))
            (lambda (state) (set! observations (1+ observations)) state))))) (lambda () live)))
    (check (generator.stale-generation? result) => #t)
    (check-equal? (list preparations observations) '(1 0))
    (check-equal? (generator.sample-value
      (generator.generate (generator.generator-unit 9) (generator.random-at 0) 0)) 9))
  (test-case "missing use substituted receipts and malformed preparations cannot pass"
    (def reference (fixture-reference))
    (def actual (model.make-system 0 (lambda (state command) (values (1+ state) command)) identity))
    (def old (model.check-trace reference [] (lambda (use) (use actual))))
    (check-exception (model.check-trace reference [] (lambda (_) old)) Error?)
    (check-exception (model.check-trace reference [] (lambda (use) (use actual) old)) Error?)
    (check-exception (model.check-trace reference [] (lambda (use) (use 'raw))
      prepare-system: (lambda (_) #f)) Error?)
    (check (model.trace-report-matched? (model.check-trace reference [] (lambda (use) (use actual)))) => #t)))
